new file mode 100644
index 00000000..050a30af
--- /dev/null
+++ b/tasks/drain_header.go
@@ -0,0 +1,59 @@
+package tasks
+
+import "io"
+
+// WorktreeBindingKind names how a drain's Runtime path is bound to its Task set:
+// a pop-provisioned (managed) checkout, an adopted one, or none at all when an
+// explicit runtime override drains an unbound set.
+type WorktreeBindingKind int
+
+const (
+	WorktreeBindingNone WorktreeBindingKind = iota
+	WorktreeBindingAdopted
+	WorktreeBindingManaged
+)
+
+func (k WorktreeBindingKind) String() string {
+	switch k {
+	case WorktreeBindingManaged:
+		return "managed"
+	case WorktreeBindingAdopted:
+		return "adopted"
+	default:
+		return "none"
+	}
+}
+
+// DrainHeader is the unconditional opening of a whole-set Implement: where the
+// drain runs is always stated, not only when it surprises.
+type DrainHeader struct {
+	TaskSetID   string
+	RuntimePath string
+	BindingKind WorktreeBindingKind
+	// InvokedFrom is the invocation directory, set only when it lies outside the
+	// Runtime path's checkout.
+	InvokedFrom string
+	// DefaultBindingRecorded announces that this run just recorded a Default
+	// binding to the current checkout.
+	DefaultBindingRecorded bool
+}
+
+// RenderDrainHeader prints h before the status table.
+func RenderDrainHeader(w io.Writer, h DrainHeader) {
+	o := outputFor(w)
+	o.line(ansiBold, "Draining task set %s", h.TaskSetID)
+	o.line(ansiDim, "  runtime path: %s", h.RuntimePath)
+	o.line(ansiDim, "  worktree binding: %s", h.BindingKind)
+	if h.InvokedFrom != "" {
+		o.line(ansiDim, "  invoked from %s", h.InvokedFrom)
+	}
+	if h.DefaultBindingRecorded {
+		o.line(ansiDim, "  binding recorded to current checkout")
+	}
+}
+
+// renderCurrentCheckoutLine is the single-task file run's sibling of the Drain
+// header: a lone task has no drain, so it only states where it runs.
+func renderCurrentCheckoutLine(w io.Writer, runtimePath string) {
+	outputFor(w).line(ansiDim, "Running in current checkout %s", runtimePath)
+}
