+
+// reportDrainHeader resolves the route's outcome into the Drain header and
+// prints it to out (discarded when nil). The header runs before the executor
+// renders the status table, so it opens the drain's output.
+func reportDrainHeader(td *tasks.Deps, out io.Writer, h drainHeaderInput) error {
+	if out == nil {
+		out = io.Discard
+	}
+	runtimePath, err := tasks.ResolveRuntimePathWith(td, h.runtimePath, "")
+	if err != nil {
+		return err
+	}
+	currentRuntime, err := tasks.ResolveRuntimePathWith(td, h.projectPath, "")
+	if err != nil {
+		return err
+	}
+	header := tasks.DrainHeader{
+		TaskSetID:              h.setID,
+		RuntimePath:            runtimePath,
+		DefaultBindingRecorded: h.defaultBinding,
+	}
+	switch {
+	case !h.bound:
+		header.BindingKind = tasks.WorktreeBindingNone
+	case h.binding.Provisioned:
+		header.BindingKind = tasks.WorktreeBindingManaged
+	default:
+		header.BindingKind = tasks.WorktreeBindingAdopted
+	}
+	if currentRuntime != runtimePath {
+		header.InvokedFrom = h.invocationDir
+	}
+	tasks.RenderDrainHeader(out, header)
+	return nil
+}
