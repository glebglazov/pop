+// invocationDir is the directory `pop tasks implement` was run from, falling
+// back to its checkout when the caller did not name one.
+func invocationDir(in tasks.ResolveInput, projectPath string) string {
+	if cwd := strings.TrimSpace(in.CWD); cwd != "" {
+		return cwd
+	}
+	return projectPath
+}
