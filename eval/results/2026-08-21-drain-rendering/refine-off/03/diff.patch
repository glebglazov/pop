diff --git a/tasks/task_result_line.go b/tasks/task_result_line.go
new file mode 100644
index 00000000..e44b257f
--- /dev/null
+++ b/tasks/task_result_line.go
@@ -0,0 +1,65 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+)
+
+// taskEnding is how one task's turn in a drain ended, as its Task result line
+// names it. Blocked and Deferred are set-level statuses, not task endings, so
+// they have no value here.
+type taskEnding int
+
+const (
+	taskEndingDone taskEnding = iota
+	taskEndingFailed
+	taskEndingOutOfAgents
+	taskEndingQuotaPaused
+	taskEndingInterrupted
+)
+
+// execErrEnding names the ending an execution error stands for: an interrupt,
+// a walk that ran out of agents and left the task open, or a failure.
+func execErrEnding(execErr error) taskEnding {
+	if isInterrupted(execErr) {
+		return taskEndingInterrupted
+	}
+	if fault, exhausted := exhaustedWalkFault(execErr); exhausted && fault.leavesTaskOpen() {
+		return taskEndingOutOfAgents
+	}
+	return taskEndingFailed
+}
+
+// printTaskResultLine prints the one Task result line for a task's ending:
+// glyph, <set>/<task> and outcome word, the whole line in the ending's color.
+// preset names the agent whose quota ran out and is read only for a quota pause.
+func printTaskResultLine(w io.Writer, sel *Selection, ending taskEnding, preset string) {
+	ref := sel.TaskSetID + "/" + sel.TaskID
+	out := outputFor(w)
+	switch ending {
+	case taskEndingDone:
+		out.line(ansiGreen, "✓ %s done", ref)
+	case taskEndingFailed:
+		out.line(ansiRed, "✗ %s failed", ref)
+	case taskEndingOutOfAgents:
+		out.line(ansiRed, "✗ %s out of agents (left open)", ref)
+	case taskEndingQuotaPaused:
+		out.line(ansiYellow, "◌ %s quota-paused (%s)", ref, preset)
+	case taskEndingInterrupted:
+		out.line(ansiYellow, "◌ %s interrupted", ref)
+	}
+}
+
+// printTaskDone reports a completed task: its Task result line, the
+// implementation-commit detail beneath it, then the Attempt timing breakdown of
+// the attempts this run spent on it.
+func printTaskDone(d *Deps, w io.Writer, result *RunTaskResult) {
+	out := outputFor(w)
+	printTaskResultLine(out, result.Selection, taskEndingDone, "")
+	if result.NoOp {
+		fmt.Fprintln(out, "  No implementation commit (verified no-op)")
+	} else if result.CommitSHA != "" {
+		fmt.Fprintf(out, "  Implementation commit: %s\n", result.CommitSHA[:min(12, len(result.CommitSHA))])
+	}
+	printAttemptBreakdown(d, out, result.attemptStreams)
+}
diff --git a/tasks/task_result_line_test.go b/tasks/task_result_line_test.go
new file mode 100644
index 00000000..dabe456a
--- /dev/null
+++ b/tasks/task_result_line_test.go
@@ -0,0 +1,152 @@
+package tasks
+
+import (
+	"bytes"
+	"io"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+)
+
+// taskResultLines matches every Task result line a drain can print, whatever its
+// ending.
+var taskResultLines = regexp.MustCompile(`(?m)^[✓✗◌] \S+/\S+ (done|failed|out of agents|quota-paused|interrupted)`)
+
+func assertOneTaskResultLine(t *testing.T, out, want string) {
+	t.Helper()
+	got := taskResultLines.FindAllString(out, -1)
+	if len(got) != 1 || !strings.HasPrefix(want, got[0]) {
+		t.Fatalf("Task result lines = %q, want exactly %q:\n%s", got, want, out)
+	}
+	if !strings.Contains(out, want+"\n") {
+		t.Fatalf("output missing %q:\n%s", want, out)
+	}
+}
+
+// TestTaskResultLineDone: a completed task says so once, with the commit detail
+// beneath it; the old "Completed" line is gone rather than printed beside it.
+func TestTaskResultLineDone(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+
+	var buf bytes.Buffer
+	if _, err := RunTaskSetWith(env.deps(), nil, nil, env.runTaskSetOpts(true, agent, &buf)); err != nil {
+		t.Fatal(err)
+	}
+	out := buf.String()
+	assertOneTaskResultLine(t, out, "✓ demo/01-a done")
+	if strings.Contains(out, "Completed demo/01-a") {
+		t.Fatalf("the old success line is still printed:\n%s", out)
+	}
+	detail := out[strings.Index(out, "✓ demo/01-a done\n")+len("✓ demo/01-a done\n"):]
+	if !strings.HasPrefix(detail, "  Implementation commit: ") && !strings.HasPrefix(detail, "  No implementation commit (verified no-op)") {
+		t.Fatalf("commit detail not beneath the result line:\n%s", out)
+	}
+}
+
+// TestTaskResultLineFailed: a task that spends every retry is reported failed.
+func TestTaskResultLineFailed(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{skipSentinel: true, summary: "no good"})
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.MaxTries = 1
+	opts.MaxTriesExplicit = true
+	_, err := RunTaskSetWith(env.deps(), nil, nil, opts)
+	assertExitCode(t, err, ExitOperational)
+	assertOneTaskResultLine(t, buf.String(), "✗ demo/01-a failed")
+	assertTaskFailed(t, env.execFixture(), "01-a", 1)
+}
+
+// TestTaskResultLineOutOfAgents: a walk that every agent left on the provider's
+// side is out of agents, and the task stays open.
+func TestTaskResultLineOutOfAgents(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	installCrashingClaudeAgent(t, env.root, providerCrashMessage)
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, "", &buf)
+	opts.AgentPresets = []string{"claude"}
+	opts.AgentExplicit = true
+	opts.MaxTries = 1
+	_, err := RunTaskSetWith(env.deps(), nil, nil, opts)
+	assertExitCode(t, err, ExitOperational)
+	assertOneTaskResultLine(t, buf.String(), "✗ demo/01-a out of agents (left open)")
+	assertTaskStatus(t, env, "01-a", TaskOpen)
+}
+
+// TestTaskResultLineQuotaPaused: a quota pause names the preset that ran out.
+func TestTaskResultLineQuotaPaused(t *testing.T) {
+	installClaudeQuotaAgent(t, t.TempDir())
+	var buf bytes.Buffer
+	run, _, refresh, sel := newRunSelectedTaskRun(t,
+		[]Task{{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"}},
+		"", RunTaskSetOptions{Yes: true, AgentPreset: "claude", Output: &buf})
+	// An empty runtime path fails the recovery waiter's registration, so the
+	// pause exits at once instead of waiting for the quota to come back.
+	run.runtimePath = ""
+
+	if _, _, err := run.runSelectedTask(refresh, sel); err != nil {
+		t.Fatalf("runSelectedTask: %v", err)
+	}
+	assertOneTaskResultLine(t, buf.String(), "◌ demo/01-a quota-paused (claude)")
+}
+
+// TestTaskResultLineInterrupted: an interrupt during the retry wait is reported
+// as interrupted, not failed.
+func TestTaskResultLineInterrupted(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{skipSentinel: true, summary: "no good"})
+
+	var buf bytes.Buffer
+	run, _, refresh, sel := runFromFixture(t, env, agent, RunTaskSetOptions{Yes: true, MaxTries: 2, MaxTriesExplicit: true, Output: &buf})
+	run.d.RetryDelayWait = func(io.Writer, time.Duration) bool { return true }
+
+	_, _, err := run.runSelectedTask(refresh, sel)
+	assertExitCode(t, err, ExitInterrupted)
+	assertOneTaskResultLine(t, buf.String(), "◌ demo/01-a interrupted")
+}
+
+// TestTaskResultLineNotForBlockedSet: a set that stops Blocked ran no task, so
+// it prints no Task result line.
+func TestTaskResultLineNotForBlockedSet(t *testing.T) {
+	env, agent := setupSoleHumanBlockedFixture(t)
+
+	var buf bytes.Buffer
+	_, _ = RunTaskSetWith(env.deps(), nil, nil, env.runTaskSetOpts(true, agent, &buf))
+	if got := taskResultLines.FindAllString(buf.String(), -1); len(got) != 0 {
+		t.Fatalf("a Blocked set printed Task result lines %q:\n%s", got, buf.String())
+	}
+}
+
+// TestTaskResultLineColorsTheWholeLine: on a terminal the whole line takes the
+// ending's color; redirected output is plain (asserted by the drain tests above).
+func TestTaskResultLineColorsTheWholeLine(t *testing.T) {
+	sel := &Selection{TaskSetID: "demo", TaskID: "01-a"}
+	for _, tc := range []struct {
+		ending taskEnding
+		want   string
+	}{
+		{taskEndingDone, ansiGreen + "✓ demo/01-a done" + ansiReset},
+		{taskEndingFailed, ansiRed + "✗ demo/01-a failed" + ansiReset},
+		{taskEndingOutOfAgents, ansiRed + "✗ demo/01-a out of agents (left open)" + ansiReset},
+		{taskEndingQuotaPaused, ansiYellow + "◌ demo/01-a quota-paused (claude)" + ansiReset},
+		{taskEndingInterrupted, ansiYellow + "◌ demo/01-a interrupted" + ansiReset},
+	} {
+		var buf bytes.Buffer
+		printTaskResultLine(&output{Writer: &buf, color: true}, sel, tc.ending, "claude")
+		if buf.String() != tc.want+"\n" {
+			t.Errorf("line = %q, want %q", buf.String(), tc.want)
+		}
+	}
+}
