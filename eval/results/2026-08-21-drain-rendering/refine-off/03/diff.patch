+package tasks
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestRenderDrainHeaderColorsOnlyOnColorOutput(t *testing.T) {
+	header := DrainHeader{TaskSetID: "demo", RuntimePath: "/repo", BindingKind: WorktreeBindingManaged}
+
+	var plain bytes.Buffer
+	RenderDrainHeader(&plain, header)
+	if want := "Draining task set demo\n  runtime path: /repo\n  worktree binding: managed\n"; plain.String() != want {
+		t.Fatalf("plain header = %q, want %q", plain.String(), want)
+	}
+
+	var colored bytes.Buffer
+	RenderDrainHeader(&output{Writer: &colored, color: true}, header)
+	if !strings.Contains(colored.String(), ansiBold+"Draining task set demo"+ansiReset) {
+		t.Fatalf("colored header = %q, want a bold first line", colored.String())
+	}
+}
