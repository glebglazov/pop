+// drainHeaderInput is what the route step knows about where a drain runs.
+type drainHeaderInput struct {
+	setID          string
+	runtimePath    string
+	invocationDir  string
+	projectPath    string
+	binding        binding.Binding
+	bound          bool
+	defaultBinding bool
