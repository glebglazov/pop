@@ -0,0 +1,26 @@
+package tasks
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestTaskResultLineColorsTheWholeLine(t *testing.T) {
+	sel := &Selection{TaskSetID: "demo", TaskID: "01-a"}
+	for _, tc := range []struct {
+		ending taskEnding
+		want   string
+	}{
+		{taskEndingDone, ansiGreen + "✓ demo/01-a done" + ansiReset + "\n"},
+		{taskEndingFailed, ansiRed + "✗ demo/01-a failed" + ansiReset + "\n"},
+		{taskEndingOutOfAgents, ansiRed + "✗ demo/01-a out of agents (left open)" + ansiReset + "\n"},
+		{taskEndingQuotaPaused, ansiYellow + "◌ demo/01-a quota-paused (claude)" + ansiReset + "\n"},
+		{taskEndingInterrupted, ansiYellow + "◌ demo/01-a interrupted" + ansiReset + "\n"},
+	} {
+		var buf bytes.Buffer
+		printTaskResultLine(&output{Writer: &buf, color: true}, sel, tc.ending, "claude")
+		if got := buf.String(); got != tc.want {
+			t.Errorf("line = %q, want %q", got, tc.want)
+		}
+	}
+}
