diff --git a/tasks/task_result_line.go b/tasks/task_result_line.go
new file mode 100644
index 00000000..7b0195c5
--- /dev/null
+++ b/tasks/task_result_line.go
@@ -0,0 +1,66 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+)
+
+// taskEnding is the outcome a Task result line reports for one task of a
+// drain. Blocked and Deferred are set-level terminals and have no ending here.
+type taskEnding int
+
+const (
+	taskEndingDone taskEnding = iota
+	taskEndingFailed
+	taskEndingOutOfAgents
+	taskEndingQuotaPaused
+	taskEndingInterrupted
+)
+
+// taskEndingForExecErr classifies the exec error a task's attempts stopped on.
+// An exhausted walk that left the task Open is out of agents; every other
+// non-interrupt error is the task's failure.
+func taskEndingForExecErr(err error) taskEnding {
+	if isInterrupted(err) {
+		return taskEndingInterrupted
+	}
+	if fault, exhausted := exhaustedWalkFault(err); exhausted && fault.leavesTaskOpen() {
+		return taskEndingOutOfAgents
+	}
+	return taskEndingFailed
+}
+
+// printTaskResultLine prints the Task result line for sel's ending: a glyph,
+// the <set>/<task> reference and the outcome word, the whole line colored.
+// preset names the agent whose quota ran out and is read only for a quota
+// pause.
+func printTaskResultLine(w io.Writer, sel *Selection, ending taskEnding, preset string) {
+	ref := sel.TaskSetID + "/" + sel.TaskID
+	out := outputFor(w)
+	switch ending {
+	case taskEndingDone:
+		out.line(ansiGreen, "✓ %s done", ref)
+	case taskEndingFailed:
+		out.line(ansiRed, "✗ %s failed", ref)
+	case taskEndingOutOfAgents:
+		out.line(ansiRed, "✗ %s out of agents (left open)", ref)
+	case taskEndingQuotaPaused:
+		out.line(ansiYellow, "◌ %s quota-paused (%s)", ref, preset)
+	case taskEndingInterrupted:
+		out.line(ansiYellow, "◌ %s interrupted", ref)
+	}
+}
+
+// printTaskDone prints the green Task result line of a completed task, the
+// implementation-commit detail beneath it, then the Attempt timing breakdown
+// of every attempt the task had.
+func printTaskDone(d *Deps, w io.Writer, result *RunTaskResult) {
+	out := outputFor(w)
+	printTaskResultLine(out, result.Selection, taskEndingDone, "")
+	if result.NoOp {
+		fmt.Fprintln(out, "  No implementation commit (verified no-op)")
+	} else if result.CommitSHA != "" {
+		fmt.Fprintf(out, "  Implementation commit: %s\n", result.CommitSHA[:min(12, len(result.CommitSHA))])
+	}
+	printAttemptBreakdown(d, out, result.attemptStreams)
+}
