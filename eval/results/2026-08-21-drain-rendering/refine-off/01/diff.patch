+func TestRunTasksCmdDrainHeaderNamesInvocationOutsideBinding(t *testing.T) {
+	root, td := setupRunTaskCmdFixture(t)
+	agent := writeRunTaskFakeAgent(t, root)
+
+	resetTaskFlags()
+	taskAgentCmd = agent
+	t.Cleanup(resetTaskFlags)
+
+	wt := filepath.Join(t.TempDir(), "bound-wt")
