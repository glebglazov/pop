new file mode 100644
index 00000000..e15c18ec
--- /dev/null
+++ b/tasks/drain_header.go
@@ -0,0 +1,51 @@
+package tasks
+
+import "io"
+
+// DrainHeader is what drain routing knows about where a whole-set drain runs,
+// handed to the executor so the Drain header can state it before the status
+// table. The Task set identifier and the Runtime path come from the executor's
+// own resolution; routing supplies only what the executor cannot see.
+type DrainHeader struct {
+	// Bound is false only when an explicit runtime override drains an unbound
+	// set, so there is no Worktree binding kind to state.
+	Bound bool
+	// Managed is the Worktree binding kind: true for a pop-provisioned managed
+	// worktree, false for an adopted checkout.
+	Managed bool
+	// InvokedFrom is the checkout the command was run from. The header names it
+	// only when it differs from the Runtime path.
+	InvokedFrom string
+	// RecordedDefault is true when this run just recorded a Default binding to
+	// the current checkout.
+	RecordedDefault bool
+}
+
+func (h DrainHeader) bindingKind() string {
+	switch {
+	case !h.Bound:
+		return "no binding"
+	case h.Managed:
+		return "managed binding"
+	default:
+		return "adopted binding"
+	}
+}
+
+// render prints the Drain header lines for setID draining at runtimePath.
+func (h DrainHeader) render(w io.Writer, setID, runtimePath string) {
+	out := outputFor(w)
+	out.line(ansiBold, "Draining %s at %s (%s)", setID, runtimePath, h.bindingKind())
+	if h.InvokedFrom != "" && h.InvokedFrom != runtimePath {
+		out.line(ansiDim, "  invoked from %s", h.InvokedFrom)
+	}
+	if h.RecordedDefault {
+		out.line(ansiDim, "  binding recorded to current checkout")
+	}
+}
+
+// renderCurrentCheckoutLine is the single-task file run's sibling of the Drain
+// header: a file run has no drain and always runs where it was invoked.
+func renderCurrentCheckoutLine(w io.Writer, runtimePath string) {
+	outputFor(w).line(ansiBold, "Running in current checkout %s", runtimePath)
+}
