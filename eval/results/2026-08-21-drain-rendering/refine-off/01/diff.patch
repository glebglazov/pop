+	if err != nil {
+		t.Fatal(err)
+	}
+	invokedFrom, err := tasks.ResolveRuntimePathWith(td, root, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var stdout bytes.Buffer
+	if err := runTaskRunTasksWith(td, &stdout, io.Discard, strings.NewReader(""), "", false, false); err != nil {
+		t.Fatalf("drain: %v\n%s", err, stdout.String())
+	}
+	got := stdout.String()
+	header := "Draining demo at " + runtime + " (adopted binding)\n  invoked from " + invokedFrom + "\n"
+	if !strings.HasPrefix(got, header) {
+		t.Fatalf("output does not open with the Drain header %q:\n%s", header, got)
