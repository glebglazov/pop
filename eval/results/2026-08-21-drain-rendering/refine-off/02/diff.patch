diff --git a/tasks/task_result_line.go b/tasks/task_result_line.go
new file mode 100644
index 00000000..1227d875
--- /dev/null
+++ b/tasks/task_result_line.go
@@ -0,0 +1,65 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+)
+
+// taskEnding is how one task's run in a drain ended, as its Task result line
+// names it. Blocked and Deferred are set-level terminals, not task endings.
+type taskEnding int
+
+const (
+	endedDone taskEnding = iota
+	endedFailed
+	endedOutOfAgents
+	endedQuotaPaused
+	endedInterrupted
+)
+
+// execErrEnding names the ending an attempt walk that returned err stopped on:
+// a SIGINT teardown is interrupted, a walk exhausted by provider collapses
+// alone leaves the task open (ADR-0231), and every other error is a failure.
+func execErrEnding(err error) taskEnding {
+	if isInterrupted(err) {
+		return endedInterrupted
+	}
+	if fault, exhausted := exhaustedWalkFault(err); exhausted && fault.leavesTaskOpen() {
+		return endedOutOfAgents
+	}
+	return endedFailed
+}
+
+// printTaskResultLine prints the one colored line a task ending gets: a glyph,
+// the <set>/<task> reference and the outcome word. pausedPreset is read only
+// for endedQuotaPaused, whose line names the preset whose quota ran out.
+func printTaskResultLine(w io.Writer, sel *Selection, ending taskEnding, pausedPreset string) {
+	out := outputFor(w)
+	ref := sel.TaskSetID + "/" + sel.TaskID
+	switch ending {
+	case endedDone:
+		out.line(ansiGreen, "✓ %s done", ref)
+	case endedFailed:
+		out.line(ansiRed, "✗ %s failed", ref)
+	case endedOutOfAgents:
+		out.line(ansiRed, "✗ %s out of agents (left open)", ref)
+	case endedQuotaPaused:
+		out.line(ansiYellow, "◌ %s quota-paused (%s)", ref, pausedPreset)
+	case endedInterrupted:
+		out.line(ansiYellow, "◌ %s interrupted", ref)
+	}
+}
+
+// printTaskDone prints a completed task's green Task result line, the
+// implementation-commit detail beneath it, and the Attempt timing breakdown of
+// every attempt the task had.
+func printTaskDone(d *Deps, w io.Writer, result *RunTaskResult) {
+	out := outputFor(w)
+	printTaskResultLine(out, result.Selection, endedDone, "")
+	if result.NoOp {
+		fmt.Fprintln(out, "  No implementation commit (verified no-op)")
+	} else if result.CommitSHA != "" {
+		fmt.Fprintf(out, "  Implementation commit: %s\n", result.CommitSHA[:min(12, len(result.CommitSHA))])
+	}
+	printAttemptBreakdown(d, out, result.attemptStreams)
+}
