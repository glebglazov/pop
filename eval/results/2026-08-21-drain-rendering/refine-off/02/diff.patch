@@ -0,0 +1,57 @@
+package tasks
+
+import "io"
+
+// BindingKind names how a drain's checkout is held by its Worktree binding: a
+// managed worktree pop provisioned and owns, an adopted checkout pop never
+// deletes, or no binding at all.
+type BindingKind string
+
+const (
+	BindingManaged BindingKind = "managed"
+	BindingAdopted BindingKind = "adopted"
+	BindingNone    BindingKind = "unbound"
+)
+
+// BindingKindOf maps a binding's Provisioned bit to its kind.
+func BindingKindOf(provisioned bool) BindingKind {
+	if provisioned {
+		return BindingManaged
+	}
+	return BindingAdopted
+}
+
+// DrainHeader is where a whole-set drain runs, stated before anything else it
+// prints so the location never has to be inferred.
+type DrainHeader struct {
+	SetID       string
+	RuntimePath string
+	Binding     BindingKind
+	// InvokedFrom is the checkout implement ran in; empty when it is the
+	// Runtime path itself.
+	InvokedFrom string
+	// BoundDefault is true when this drain just recorded a Default binding to
+	// the current checkout.
+	BoundDefault bool
+}
+
+// PrintDrainHeader writes the Drain header: one line naming the set, the
+// Runtime path and the binding kind, then the invocation directory and the
+// Default binding announcement when they apply.
+func PrintDrainHeader(w io.Writer, h DrainHeader) {
+	out := outputFor(w)
+	out.line(ansiBold, "Draining %s at %s (%s binding)", h.SetID, h.RuntimePath, h.Binding)
+	if h.InvokedFrom != "" {
+		out.line(ansiDim, "  invoked from %s", h.InvokedFrom)
+	}
+	if h.BoundDefault {
+		out.line(ansiDim, "  binding recorded to current checkout")
+	}
+}
+
+// printCurrentCheckoutLine is the single-task run's sibling of the Drain
+// header: a task file run has no drain and no binding, only the checkout it
+// runs in.
+func printCurrentCheckoutLine(w io.Writer, runtimePath string) {
+	outputFor(w).line(ansiBold, "Running in current checkout %s", runtimePath)
+}
