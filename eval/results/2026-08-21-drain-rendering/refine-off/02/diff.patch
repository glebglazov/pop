+// drainHeader states where a routed drain runs. The invocation checkout is
+// compared to the Runtime path at checkout level, so running from a
+// subdirectory of the Runtime path adds no "invoked from" line.
+func drainHeader(td *tasks.Deps, setID, currentCheckout, runtimePath string, kind tasks.BindingKind, boundDefault bool) (tasks.DrainHeader, error) {
+	currentRuntime, err := tasks.ResolveRuntimePathWith(td, currentCheckout, "")
+	if err != nil {
+		return tasks.DrainHeader{}, err
+	}
+	drainRuntime, err := tasks.ResolveRuntimePathWith(td, runtimePath, "")
+	if err != nil {
+		return tasks.DrainHeader{}, err
+	}
+	header := tasks.DrainHeader{
+		SetID:        setID,
+		RuntimePath:  runtimePath,
+		Binding:      kind,
+		BoundDefault: boundDefault,
+	}
+	if drainRuntime != currentRuntime {
+		header.InvokedFrom = currentRuntime
+	}
+	return header, nil
 }
 
