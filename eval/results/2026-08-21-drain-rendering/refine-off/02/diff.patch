+	}
+}
+
+// TestResolveTaskSetRuntimeInWorktreeHeaderNamesManagedBinding asserts an
+// --in-worktree drain names its provisioned checkout as a managed binding and
+// the checkout it was invoked from.
+func TestResolveTaskSetRuntimeInWorktreeHeaderNamesManagedBinding(t *testing.T) {
+	t.Parallel()
+	root, d := setupImplementFixture(t)
+
+	var report bytes.Buffer
+	resolved, err := resolveTaskSetRuntime(d, tasks.ResolveInput{CWD: root}, "demo", true, false, RuntimeConfirmOptions{Output: &report})
+	if err != nil {
+		t.Fatalf("resolve runtime: %v", err)
+	}
+	currentRuntime, err := tasks.ResolveRuntimePathWith(d.tasksDeps(), root, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "Draining demo at " + resolved.RuntimeOverride + " (managed binding)\n  invoked from " + currentRuntime + "\n"
+	if report.String() != want {
+		t.Fatalf("header = %q, want %q", report.String(), want)
+	}
+}
