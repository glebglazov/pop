+package tasks
+
+import (
+	"fmt"
+	"io"
+)
+
+// taskResultLine is the Task result line: the one colored line a drain prints
+// for each ending of a task's run — a glyph, the <set>/<task> reference and the
+// outcome word. Blocked and Deferred are set-level statuses and have no form
+// here.
+type taskResultLine struct {
+	style   string
+	glyph   string
+	outcome string
+}
+
+var (
+	taskResultDone        = taskResultLine{style: ansiGreen, glyph: "✓", outcome: "done"}
+	taskResultFailed      = taskResultLine{style: ansiRed, glyph: "✗", outcome: "failed"}
+	taskResultOutOfAgents = taskResultLine{style: ansiRed, glyph: "✗", outcome: "out of agents (left open)"}
+	taskResultInterrupted = taskResultLine{style: ansiYellow, glyph: "◌", outcome: "interrupted"}
+)
+
+func taskResultQuotaPaused(preset string) taskResultLine {
+	return taskResultLine{style: ansiYellow, glyph: "◌", outcome: fmt.Sprintf("quota-paused (%s)", preset)}
+}
+
+// taskResultForExecError names the ending an attempt walk's error stands for:
+// an interrupt, a walk that ran out of agents and left the task Open, and
+// otherwise a failure.
+func taskResultForExecError(err error) taskResultLine {
+	if isInterrupted(err) {
+		return taskResultInterrupted
+	}
+	if fault, exhausted := exhaustedWalkFault(err); exhausted && fault.leavesTaskOpen() {
+		return taskResultOutOfAgents
+	}
+	return taskResultFailed
+}
+
+func (l taskResultLine) print(w io.Writer, sel *Selection) {
+	outputFor(w).line(l.style, "%s %s/%s %s", l.glyph, sel.TaskSetID, sel.TaskID, l.outcome)
+}
+
+// printTaskDone writes the done Task result line, then its detail: the
+// implementation commit (or the verified no-op) and the Attempt timing
+// breakdown of every attempt the task had.
+func printTaskDone(d *Deps, w io.Writer, result *RunTaskResult) {
+	out := outputFor(w)
+	taskResultDone.print(out, result.Selection)
+	if result.NoOp {
+		fmt.Fprintln(out, "  No implementation commit (verified no-op)")
+	} else if result.CommitSHA != "" {
+		fmt.Fprintf(out, "  Implementation commit: %s\n", result.CommitSHA[:min(12, len(result.CommitSHA))])
+	}
+	printAttemptBreakdown(d, out, result.attemptStreams)
+}
