+// DrainHeader is what a whole-set drain states about where it runs before its
+// status table: always the set, the Runtime path and the Worktree binding kind;
+// the invocation directory only when it differs from the Runtime path; and a
+// Default binding only on the drain that just recorded it.
+type DrainHeader struct {
+	TaskSetID   string
+	RuntimePath string
+	// BindingKind is "managed" or "adopted", from the binding's Provisioned bit,
+	// or "unbound" when an explicit runtime override drains a set with no binding.
+	BindingKind  string
+	InvokedFrom  string
+	BoundDefault bool
+}
+
+// RenderDrainHeader writes the Drain header.
+func RenderDrainHeader(w io.Writer, h DrainHeader) {
+	out := outputFor(w)
+	out.line(ansiCyan, "Draining %s at %s (%s)", h.TaskSetID, h.RuntimePath, h.BindingKind)
+	if h.InvokedFrom != "" {
+		out.line(ansiDim, "  invoked from %s", h.InvokedFrom)
+	}
+	if h.BoundDefault {
+		out.line(ansiDim, "  binding recorded to current checkout")
+	}
+}
+
+// RenderCurrentCheckoutRun writes the single-task file run's sibling of the
+// Drain header: such a run has no drain and always runs where it was invoked.
+func RenderCurrentCheckoutRun(w io.Writer, taskSetID, taskID, runtimePath string) {
+	outputFor(w).line(ansiCyan, "Running %s/%s in current checkout %s", taskSetID, taskID, runtimePath)
+}
