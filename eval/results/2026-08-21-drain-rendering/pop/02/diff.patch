@@ -0,0 +1,66 @@
+package tasks
+
+import (
+	"bytes"
+	"io"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// TestDrainInterruptedAttemptPrintsInterruptedResultLine: an interrupt that
+// tears down a task's run ends it with the yellow interrupted line, and the task
+// stays open.
+func TestDrainInterruptedAttemptPrintsInterruptedResultLine(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, skipSentinel: true})
+
+	d := env.deps()
+	d.RetryDelayWait = func(io.Writer, time.Duration) bool { return true }
+	loadConfig := func(string) (*config.Config, error) {
+		return &config.Config{Work: &config.WorkConfig{
+			Implement: &config.ImplementConfig{AttemptRetryDelays: []string{"1m"}},
+		}}, nil
+	}
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.MaxTries = 2
+
+	_, err := RunTaskSetWith(d, nil, loadConfig, opts)
+	assertExitCode(t, err, ExitInterrupted)
+	out := buf.String()
+	if strings.Count(out, "◌ demo/01-a interrupted") != 1 {
+		t.Fatalf("want exactly one interrupted Task result line:\n%s", out)
+	}
+	if strings.Contains(out, "demo/01-a failed") {
+		t.Fatalf("an interrupt is not a failure:\n%s", out)
+	}
+	assertTaskStatus(t, env, "01-a", TaskOpen)
+}
+
+// TestDrainDoneTaskPrintsCommitDetailBeneathResultLine: a task that completes
+// ends with one done line, and its implementation-commit detail is the line
+// right beneath it.
+func TestDrainDoneTaskPrintsCommitDetailBeneathResultLine(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+
+	var buf bytes.Buffer
+	if _, err := RunTaskSetWith(env.deps(), nil, nil, env.runTaskSetOpts(true, agent, &buf)); err != nil {
+		t.Fatal(err)
+	}
+	_, after, found := strings.Cut(buf.String(), "✓ demo/01-a done\n")
+	if !found {
+		t.Fatalf("missing the done Task result line:\n%s", buf.String())
+	}
+	if !strings.HasPrefix(after, "  Implementation commit: ") && !strings.HasPrefix(after, "  No implementation commit (verified no-op)") {
+		t.Fatalf("commit detail is not beneath the done line:\n%s", buf.String())
+	}
+}
