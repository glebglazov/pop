+// reportDrainHeader writes the Drain header for a resolved route. It compares
+// checkout roots, so invoking from a subdirectory of the Runtime path does not
+// count as invoking from elsewhere.
+func reportDrainHeader(td *tasks.Deps, out io.Writer, setID, projectPath, runtimePath string, b binding.Binding, boundDefault bool) error {
+	if out == nil {
+		return nil
+	}
+	invokedRuntime, err := tasks.ResolveRuntimePathWith(td, projectPath, "")
+	if err != nil {
+		return err
+	}
+	drainRuntime, err := tasks.ResolveRuntimePathWith(td, runtimePath, "")
+	if err != nil {
+		return err
+	}
+	header := tasks.DrainHeader{
+		TaskSetID:    setID,
+		RuntimePath:  drainRuntime,
+		BindingKind:  bindingKind(b),
+		BoundDefault: boundDefault,
+	}
+	if invokedRuntime != drainRuntime {
+		header.InvokedFrom = invokedRuntime
+	}
+	tasks.RenderDrainHeader(out, header)
+	return nil
+}
+
+func bindingKind(b binding.Binding) string {
+	switch {
+	case strings.TrimSpace(b.RuntimePath) == "":
+		return "unbound"
+	case b.Provisioned:
+		return "managed"
+	default:
+		return "adopted"
+	}
+}
