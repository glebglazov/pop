new file mode 100644
index 00000000..dbbf6d11
--- /dev/null
+++ b/tasks/drain_header.go
@@ -0,0 +1,51 @@
+package tasks
+
+import "io"
+
+// BindingKind names the Worktree binding a drain runs under, as the Drain header
+// states it.
+type BindingKind string
+
+const (
+	// BindingManaged is a provisioned binding: pop owns the checkout's teardown.
+	BindingManaged BindingKind = "managed"
+	// BindingAdopted is a binding to a checkout pop never deletes.
+	BindingAdopted BindingKind = "adopted"
+	// BindingNone is a drain routed by an explicit runtime override with no
+	// binding recorded.
+	BindingNone BindingKind = "unbound"
+)
+
+// DrainPlacement is what whole-set routing decided about where a drain runs. The
+// executor resolves the set and Runtime path itself; these are the facts only
+// routing knows, carried so the Drain header can state them.
+type DrainPlacement struct {
+	Binding BindingKind
+	// InvokedFrom is the root of the checkout implement was invoked from. The
+	// header names it only when it differs from the Runtime path.
+	InvokedFrom string
+	// DefaultBindingRecorded reports that routing has just recorded a Default
+	// binding to the current checkout.
+	DefaultBindingRecorded bool
+}
+
+// printDrainHeader writes the Drain header: the set, the Runtime path and the
+// binding kind on one line, then the invocation checkout when the drain runs
+// elsewhere, then the Default binding announcement when routing just recorded
+// one.
+func printDrainHeader(w io.Writer, setID, runtimePath string, p DrainPlacement) {
+	out := outputFor(w)
+	out.line(ansiBold, "Draining %s in %s (%s binding)", setID, runtimePath, p.Binding)
+	if p.InvokedFrom != "" && p.InvokedFrom != runtimePath {
+		out.line(ansiDim, "  invoked from %s", p.InvokedFrom)
+	}
+	if p.DefaultBindingRecorded {
+		out.line(ansiDim, "  binding recorded to current checkout")
+	}
+}
+
+// printCurrentCheckoutLine is the single-task file run's sibling of the Drain
+// header: a task file run has no drain and always runs in the current checkout.
+func printCurrentCheckoutLine(w io.Writer, setID, taskID, runtimePath string) {
+	outputFor(w).line(ansiBold, "Running %s/%s in the current checkout %s", setID, taskID, runtimePath)
+}
