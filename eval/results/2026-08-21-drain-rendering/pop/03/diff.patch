+++ b/tasks/implement/drain_header_test.go
@@ -0,0 +1,145 @@
+package implement
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/tasks"
+	"github.com/glebglazov/pop/tasks/binding"
+)
+
+// writeHeaderFakeAgent writes an agent that ticks every acceptance box of the
+// task it is handed and reports completion, so a drain runs to Done.
+func writeHeaderFakeAgent(t *testing.T) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "fake-agent.sh")
+	script := "#!/bin/sh\nTASK=$(cat \"$(printf '%s' \"$*\" | sed -n 's|.*Read the file \\([^ ]*\\) in full:.*|\\1|p' | head -1)\" | sed -n 's|^You are implementing the task at: ||p' | head -1)\n" +
+		"if [ -n \"$TASK\" ] && [ -f \"$TASK\" ]; then sed -i '' 's/- \\[ \\]/- [x]/g' \"$TASK\" 2>/dev/null || sed -i 's/- \\[ \\]/- [x]/g' \"$TASK\"; fi\n" +
+		"printf 'SUMMARY_START\\nheader test\\nSUMMARY_END\\nTASK_COMPLETE\\n'\n"
+	if err := os.WriteFile(path, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+// drainHeaderOutput drains the demo set invoked from root and returns the
+// drain's redirected (non-TTY) output.
+func drainHeaderOutput(t *testing.T, d *Deps, root string, inWorktree bool) string {
+	t.Helper()
+	var out bytes.Buffer
+	_, err := RunWholeSetWith(d, WholeSetOptions{
+		ResolveInput:    tasks.ResolveInput{CWD: root},
+		TaskSetOverride: "demo",
+		InWorktree:      inWorktree,
+		AgentCmd:        writeHeaderFakeAgent(t),
+		Yes:             true,
+		ConfirmIn:       strings.NewReader(""),
+		ConfirmOut:      io.Discard,
+		Output:          &out,
+	})
+	if err != nil {
+		t.Fatalf("drain: %v\n%s", err, out.String())
+	}
+	if strings.Contains(out.String(), "\033[") {
+		t.Fatalf("redirected drain output carries ANSI escapes:\n%q", out.String())
+	}
+	return out.String()
+}
+
+func resolvedCheckout(t *testing.T, d *Deps, path string) string {
+	t.Helper()
+	p, err := tasks.ResolveRuntimePathWith(d.tasksDeps(), path, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// assertDrainOpensWith asserts the drain output begins with exactly the header
+// lines, ahead of the status table, and carries no retired location line.
+func assertDrainOpensWith(t *testing.T, out string, header ...string) {
+	t.Helper()
+	lines := strings.Split(out, "\n")
+	if len(lines) <= len(header) {
+		t.Fatalf("output too short for header %q:\n%s", header, out)
+	}
+	for i, want := range header {
+		if lines[i] != want {
+			t.Fatalf("line %d = %q, want %q\noutput:\n%s", i, lines[i], want, out)
+		}
+	}
+	if next := lines[len(header)]; strings.HasPrefix(next, "  ") {
+		t.Fatalf("unexpected extra header line %q\noutput:\n%s", next, out)
+	}
+	if strings.Contains(out, "draining at bound checkout") {
+		t.Fatalf("retired location line still printed:\n%s", out)
+	}
+}
+
+func TestDrainHeaderRecordsDefaultBindingInCurrentCheckout(t *testing.T) {
+	t.Parallel()
+	root, d := setupImplementFixture(t)
+
+	out := drainHeaderOutput(t, d, root, false)
+
+	assertDrainOpensWith(t, out,
+		"Draining demo in "+resolvedCheckout(t, d, root)+" (adopted binding)",
+		"  binding recorded to current checkout",
+	)
+}
+
+func TestDrainHeaderNamesInvocationCheckoutWhenBoundElsewhere(t *testing.T) {
+	t.Parallel()
+	root, d := setupImplementFixture(t)
+	wt := filepath.Join(t.TempDir(), "bound-wt")
+	if out, err := exec.Command("git", "-C", root, "worktree", "add", "-b", "bound", wt, "HEAD").CombinedOutput(); err != nil {
+		t.Fatalf("worktree add: %v\n%s", err, out)
+	}
+	id, err := tasks.ResolveRepositoryIdentity(d.tasksDeps(), root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := binding.Put(d.tasksDeps(), binding.Key(id, "demo"), binding.Adopt(d.tasksDeps(), wt, "bound", "")); err != nil {
+		t.Fatal(err)
+	}
+
+	out := drainHeaderOutput(t, d, root, false)
+
+	assertDrainOpensWith(t, out,
+		"Draining demo in "+resolvedCheckout(t, d, wt)+" (adopted binding)",
+		"  invoked from "+resolvedCheckout(t, d, root),
+	)
+}
+
+func TestDrainHeaderFromInsideBoundCheckoutStatesOnlyTheDrain(t *testing.T) {
+	t.Parallel()
+	root, d := setupImplementFixture(t)
+	b := seedImplementManagedBinding(t, d.tasksDeps(), root, "demo")
+
+	out := drainHeaderOutput(t, d, b.RuntimePath, false)
+
+	assertDrainOpensWith(t, out,
+		"Draining demo in "+resolvedCheckout(t, d, b.RuntimePath)+" (managed binding)",
+	)
+}
+
+func TestDrainHeaderNamesManagedBindingForInWorktree(t *testing.T) {
+	t.Parallel()
+	root, d := setupImplementFixture(t)
+
+	out := drainHeaderOutput(t, d, root, true)
+
+	_, b, ok, err := binding.GetForSet(d.tasksDeps(), root, "demo")
+	if err != nil || !ok {
+		t.Fatalf("binding ok=%v err=%v, want the provisioned binding", ok, err)
+	}
+	assertDrainOpensWith(t, out,
+		"Draining demo in "+resolvedCheckout(t, d, b.RuntimePath)+" (managed binding)",
+		"  invoked from "+resolvedCheckout(t, d, root),
+	)
+}
