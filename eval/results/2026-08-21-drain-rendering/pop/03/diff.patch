diff --git a/tasks/task_result_line.go b/tasks/task_result_line.go
new file mode 100644
index 00000000..1c6d7dd8
--- /dev/null
+++ b/tasks/task_result_line.go
@@ -0,0 +1,55 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+)
+
+// taskEnding is the outcome a Task result line states: the glyph and color the
+// whole line takes, and the outcome word after the `<set>/<task>` reference.
+type taskEnding struct {
+	glyph   string
+	style   string
+	outcome string
+}
+
+var (
+	taskEndingDone        = taskEnding{"✓", ansiGreen, "done"}
+	taskEndingFailed      = taskEnding{"✗", ansiRed, "failed"}
+	taskEndingOutOfAgents = taskEnding{"✗", ansiRed, "out of agents (left open)"}
+	taskEndingInterrupted = taskEnding{"◌", ansiYellow, "interrupted"}
+)
+
+func taskEndingQuotaPaused(preset string) taskEnding {
+	return taskEnding{"◌", ansiYellow, fmt.Sprintf("quota-paused (%s)", preset)}
+}
+
+// taskEndingForExecErr maps the error a task's attempts stopped on to its
+// ending: an interrupt and a walk that left the task Open are not failures.
+func taskEndingForExecErr(err error) taskEnding {
+	if isInterrupted(err) {
+		return taskEndingInterrupted
+	}
+	if fault, exhausted := exhaustedWalkFault(err); exhausted && fault.leavesTaskOpen() {
+		return taskEndingOutOfAgents
+	}
+	return taskEndingFailed
+}
+
+// printTaskResultLine writes the Task result line for sel.
+func printTaskResultLine(w io.Writer, sel *Selection, ending taskEnding) {
+	outputFor(w).line(ending.style, "%s %s/%s %s", ending.glyph, sel.TaskSetID, sel.TaskID, ending.outcome)
+}
+
+// printTaskDone writes the green Task result line of a completed task, the
+// implementation-commit detail beneath it, and then the task's attempt timing.
+func printTaskDone(d *Deps, w io.Writer, result *RunTaskResult) {
+	out := outputFor(w)
+	printTaskResultLine(out, result.Selection, taskEndingDone)
+	if result.NoOp {
+		fmt.Fprintln(out, "  No implementation commit (verified no-op)")
+	} else if result.CommitSHA != "" {
+		fmt.Fprintf(out, "  Implementation commit: %s\n", result.CommitSHA[:min(12, len(result.CommitSHA))])
+	}
+	printAttemptBreakdown(d, out, result.AttemptStreams)
+}
