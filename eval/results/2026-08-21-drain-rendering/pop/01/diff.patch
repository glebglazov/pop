+package tasks
+
+import "io"
+
+// DrainHeader is the Drain header: the unconditional opening lines of a
+// whole-set Implement, stating where the drain runs before the status table.
+// Drain routing fills it; the drain output layer owns how it looks.
+type DrainHeader struct {
+	SetID       string
+	RuntimePath string
+	// Bound reports a Worktree binding behind the drain; it is false only when
+	// routing resolved an explicit runtime override for an unbound set.
+	// Provisioned is that binding's bit: managed when pop created the checkout.
+	Bound       bool
+	Provisioned bool
+	// InvokedFrom is the invocation directory, set only when it lies outside
+	// the Runtime path.
+	InvokedFrom string
+	// RecordedDefaultBinding reports that this run just recorded a Default
+	// binding to the current checkout.
+	RecordedDefaultBinding bool
+}
+
+func (h DrainHeader) bindingKind() string {
+	switch {
+	case !h.Bound:
+		return "none"
+	case h.Provisioned:
+		return "managed"
+	default:
+		return "adopted"
+	}
+}
+
+// Print writes the header to w, colored only when w is a terminal.
+func (h DrainHeader) Print(w io.Writer) {
+	out := outputFor(w)
+	out.line(ansiBold, "Draining %s", h.SetID)
+	out.line(ansiDim, "  runtime path: %s", h.RuntimePath)
+	out.line(ansiDim, "  binding: %s", h.bindingKind())
+	if h.InvokedFrom != "" {
+		out.line(ansiDim, "  invoked from %s", h.InvokedFrom)
+	}
+	if h.RecordedDefaultBinding {
+		out.line(ansiYellow, "  binding recorded to current checkout")
+	}
+}
+
+// printCurrentCheckoutLine is the single-task sibling of the Drain header: a
+// task file run has no drain routing, so it always runs where it was invoked.
+func printCurrentCheckoutLine(w io.Writer, runtimePath string) {
+	outputFor(w).line(ansiDim, "Running in current checkout %s", runtimePath)
+}
