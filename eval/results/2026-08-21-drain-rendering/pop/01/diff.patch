diff --git a/tasks/task_result_line.go b/tasks/task_result_line.go
new file mode 100644
index 00000000..4f6881de
--- /dev/null
+++ b/tasks/task_result_line.go
@@ -0,0 +1,60 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+)
+
+// taskEnding is how one task's run in a drain ended, as its Task result line
+// says it: the glyph and the color tell done, stopped and paused apart at a
+// glance, and the outcome word says which. Blocked and Deferred are set-level
+// endings and never take this form.
+type taskEnding struct {
+	style   string
+	glyph   string
+	outcome string
+}
+
+var (
+	taskEndingDone        = taskEnding{style: ansiGreen, glyph: "✓", outcome: "done"}
+	taskEndingFailed      = taskEnding{style: ansiRed, glyph: "✗", outcome: "failed"}
+	taskEndingOutOfAgents = taskEnding{style: ansiRed, glyph: "✗", outcome: "out of agents (left open)"}
+	taskEndingInterrupted = taskEnding{style: ansiYellow, glyph: "◌", outcome: "interrupted"}
+)
+
+func taskEndingQuotaPaused(preset string) taskEnding {
+	return taskEnding{style: ansiYellow, glyph: "◌", outcome: fmt.Sprintf("quota-paused (%s)", preset)}
+}
+
+// taskEndingForExecErr names the ending an attempt walk that returned an error
+// stopped on. An interrupt and a walk that left the task Open stop the drain
+// without failing the task; every other error is a failure.
+func taskEndingForExecErr(err error) taskEnding {
+	if isInterrupted(err) {
+		return taskEndingInterrupted
+	}
+	if fault, exhausted := exhaustedWalkFault(err); exhausted && fault.leavesTaskOpen() {
+		return taskEndingOutOfAgents
+	}
+	return taskEndingFailed
+}
+
+// printTaskResultLine prints the one stdout line that closes a task's run. It
+// writes nothing to the Work journal.
+func printTaskResultLine(w io.Writer, sel *Selection, ending taskEnding) {
+	outputFor(w).line(ending.style, "%s %s/%s %s", ending.glyph, sel.TaskSetID, sel.TaskID, ending.outcome)
+}
+
+// printTaskDone closes a completed task: its green result line, the
+// implementation commit beneath it, then the timing of every attempt the task
+// had.
+func printTaskDone(d *Deps, w io.Writer, result *RunTaskResult) {
+	out := outputFor(w)
+	printTaskResultLine(out, result.Selection, taskEndingDone)
+	if result.NoOp {
+		fmt.Fprintln(out, "  No implementation commit (verified no-op)")
+	} else if result.CommitSHA != "" {
+		fmt.Fprintf(out, "  Implementation commit: %s\n", result.CommitSHA[:min(12, len(result.CommitSHA))])
+	}
+	printAttemptBreakdown(d, out, result.attemptStreams)
+}
