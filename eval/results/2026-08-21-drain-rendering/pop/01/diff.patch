+package tasks
+
+import (
+	"bytes"
+	"testing"
+)
+
+// On a terminal the whole Task result line takes its outcome's color.
+func TestTaskResultLineColorsTheWholeLine(t *testing.T) {
+	sel := &Selection{TaskSetID: "demo", TaskID: "01-a"}
+	for _, tc := range []struct {
+		outcome taskOutcome
+		want    string
+	}{
+		{outcomeDone, ansiGreen + "✓ demo/01-a done" + ansiReset + "\n"},
+		{outcomeFailed, ansiRed + "✗ demo/01-a failed" + ansiReset + "\n"},
+		{outcomeOutOfAgents, ansiRed + "✗ demo/01-a out of agents (left open)" + ansiReset + "\n"},
+		{outcomeQuotaPaused, ansiYellow + "◌ demo/01-a quota-paused (claude)" + ansiReset + "\n"},
+		{outcomeInterrupted, ansiYellow + "◌ demo/01-a interrupted" + ansiReset + "\n"},
+	} {
+		var buf bytes.Buffer
+		printTaskResultLine(&output{Writer: &buf, color: true}, sel, tc.outcome, "claude")
+		if got := buf.String(); got != tc.want {
+			t.Errorf("outcome %d = %q, want %q", tc.outcome, got, tc.want)
+		}
+	}
+}
