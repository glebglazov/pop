new file mode 100644
index 00000000..83139791
--- /dev/null
+++ b/tasks/drain_header.go
@@ -0,0 +1,42 @@
+package tasks
+
+import "io"
+
+// DrainHeader is the unconditional opening of a whole-set Implement, printed
+// before the status table so where a drain runs is always stated, not only when
+// it surprises. Drain routing fills it; the executor's output layer renders it.
+type DrainHeader struct {
+	TaskSetID   string
+	RuntimePath string
+	// BindingKind is "managed" or "adopted"; empty when the drain runs at an
+	// explicit runtime override with no Worktree binding.
+	BindingKind string
+	// InvokedFrom is the invocation checkout, set only when it differs from
+	// RuntimePath.
+	InvokedFrom string
+	// BoundDefault reports this run just recorded a Default binding to the
+	// current checkout.
+	BoundDefault bool
+}
+
+// Print writes the header lines to w, styled only on a color-capable terminal.
+func (h DrainHeader) Print(w io.Writer) {
+	o := outputFor(w)
+	kind := "no binding"
+	if h.BindingKind != "" {
+		kind = h.BindingKind + " binding"
+	}
+	o.line(ansiBold, "Draining %s at %s (%s)", h.TaskSetID, h.RuntimePath, kind)
+	if h.InvokedFrom != "" {
+		o.line(ansiDim, "  invoked from %s", h.InvokedFrom)
+	}
+	if h.BoundDefault {
+		o.line(ansiDim, "  binding recorded to current checkout")
+	}
+}
+
+// printCurrentCheckoutLine is the single-task sibling of DrainHeader: a file run
+// has no drain, so it states only the checkout it runs in.
+func printCurrentCheckoutLine(w io.Writer, taskSetID, taskID, runtimePath string) {
+	outputFor(w).line(ansiBold, "Running %s/%s in current checkout %s", taskSetID, taskID, runtimePath)
+}
