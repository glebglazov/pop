+// drainHeader describes where a routed drain runs: the set, its Runtime path,
+// the binding kind, and the invocation checkout when it is not the Runtime
+// path. b is the zero Binding when the drain runs at an unbound runtime
+// override.
+func drainHeader(td *tasks.Deps, setID, currentCheckout, runtimePath string, b binding.Binding) (tasks.DrainHeader, error) {
+	currentRuntime, err := tasks.ResolveRuntimePathWith(td, currentCheckout, "")
+	if err != nil {
+		return tasks.DrainHeader{}, err
+	}
+	drainRuntime, err := tasks.ResolveRuntimePathWith(td, runtimePath, "")
+	if err != nil {
+		return tasks.DrainHeader{}, err
+	}
+	header := tasks.DrainHeader{TaskSetID: setID, RuntimePath: drainRuntime}
+	switch {
+	case b.RuntimePath == "":
+	case b.Provisioned:
+		header.BindingKind = "managed"
+	default:
+		header.BindingKind = "adopted"
+	}
+	if drainRuntime != currentRuntime {
+		header.InvokedFrom = currentRuntime
+	}
+	return header, nil
 }
 
