+		t.Fatalf("missing current-checkout line:\n%s", out)
+	}
+	if table := strings.Index(out, "STATUS"); table < line {
+		t.Fatalf("current-checkout line must precede the status table:\n%s", out)
+	}
+	if strings.Contains(out, "Draining ") || strings.Contains(out, "\033[") {
+		t.Fatalf("single-task run printed a Drain header or ANSI:\n%s", out)
+	}
+}
