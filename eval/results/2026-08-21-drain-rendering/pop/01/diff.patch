diff --git a/tasks/task_result_line.go b/tasks/task_result_line.go
new file mode 100644
index 00000000..f590dcdc
--- /dev/null
+++ b/tasks/task_result_line.go
@@ -0,0 +1,46 @@
+package tasks
+
+import "io"
+
+// taskOutcome is how one task's turn in a drain ended, as the Task result line
+// names it.
+type taskOutcome int
+
+const (
+	outcomeDone taskOutcome = iota
+	outcomeFailed
+	outcomeOutOfAgents
+	outcomeQuotaPaused
+	outcomeInterrupted
+)
+
+// printTaskResultLine writes the Task result line: the one line the drain
+// prints at every per-task ending, colored only when w is a terminal. preset
+// names the agent whose quota ran out and is read only for outcomeQuotaPaused.
+func printTaskResultLine(w io.Writer, sel *Selection, outcome taskOutcome, preset string) {
+	ref := sel.TaskSetID + "/" + sel.TaskID
+	out := outputFor(w)
+	switch outcome {
+	case outcomeDone:
+		out.line(ansiGreen, "✓ %s done", ref)
+	case outcomeFailed:
+		out.line(ansiRed, "✗ %s failed", ref)
+	case outcomeOutOfAgents:
+		out.line(ansiRed, "✗ %s out of agents (left open)", ref)
+	case outcomeQuotaPaused:
+		out.line(ansiYellow, "◌ %s quota-paused (%s)", ref, preset)
+	case outcomeInterrupted:
+		out.line(ansiYellow, "◌ %s interrupted", ref)
+	}
+}
+
+// execErrOutcome classifies the error that ended a task's attempts.
+func execErrOutcome(execErr error) taskOutcome {
+	if isInterrupted(execErr) {
+		return outcomeInterrupted
+	}
+	if fault, exhausted := exhaustedWalkFault(execErr); exhausted && fault.leavesTaskOpen() {
+		return outcomeOutOfAgents
+	}
+	return outcomeFailed
+}
