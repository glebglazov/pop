+		t.Fatalf("binding = %+v, want %+v (adopted, just recorded)", got, want)
+	}
+
+	_, recordedDefault, err = resolveTaskSetRuntime(d, tasks.ResolveInput{CWD: root}, "demo", false, false, RuntimeConfirmOptions{})
+	if err != nil {
+		t.Fatalf("second resolve: %v", err)
+	}
+	if recordedDefault {
