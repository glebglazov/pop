diff --git a/tasks/drain_lines.go b/tasks/drain_lines.go
new file mode 100644
index 00000000..a74d8ab8
--- /dev/null
+++ b/tasks/drain_lines.go
@@ -0,0 +1,112 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+	"path/filepath"
+	"strings"
+)
+
+// CheckoutBinding is the Worktree binding a whole-set drain runs under, as the
+// caller's BindCheckout hook reports it once binding is settled. The Drain
+// header reads it; the executor cannot look it up itself, because the binding
+// store sits in a package that imports this one.
+type CheckoutBinding struct {
+	Bound bool
+	// Provisioned is the binding's managed bit: the checkout lives under the
+	// managed-worktree root. False on a bound set means an adopted binding.
+	Provisioned bool
+	// RecordedByThis reports that this run just recorded a Default binding to
+	// the current checkout.
+	RecordedByThis bool
+}
+
+func (b CheckoutBinding) kind() string {
+	switch {
+	case !b.Bound:
+		return "no binding"
+	case b.Provisioned:
+		return "managed binding"
+	default:
+		return "adopted binding"
+	}
+}
+
+// printDrainHeader prints the Drain header: the unconditional opening lines of
+// a whole-set drain naming the set, its Runtime path and its binding kind.
+// invokedFrom is empty when the invocation directory is inside the Runtime
+// path; otherwise it names that directory.
+func printDrainHeader(w io.Writer, setID, runtimePath, invokedFrom string, b CheckoutBinding) {
+	out := outputFor(w)
+	out.line(ansiBold, "Draining %s in %s (%s)", setID, runtimePath, b.kind())
+	if invokedFrom != "" {
+		out.line(ansiDim, "  invoked from %s", invokedFrom)
+	}
+	if b.RecordedByThis {
+		out.line(ansiDim, "  binding recorded to current checkout")
+	}
+}
+
+// printCurrentCheckoutLine is the single-task sibling of the Drain header: a
+// task file run has no drain and always runs where it was invoked.
+func printCurrentCheckoutLine(w io.Writer, runtimePath string) {
+	outputFor(w).line(ansiBold, "Running in current checkout %s", runtimePath)
+}
+
+// invocationOutsideRuntime returns the invocation directory when it lies
+// outside runtimePath, or "" when the drain runs where it was invoked (the
+// Runtime path itself or a directory beneath it).
+func invocationOutsideRuntime(d *Deps, cwd, runtimePath string) string {
+	if cwd == "" {
+		var err error
+		if cwd, err = d.FS.Getwd(); err != nil {
+			return ""
+		}
+	}
+	cwd, err := canonicalAbsPath(d, cwd)
+	if err != nil {
+		return ""
+	}
+	rel, err := filepath.Rel(runtimePath, cwd)
+	if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return ""
+	}
+	return cwd
+}
+
+// taskEnding is one per-task outcome a Task result line reports.
+type taskEnding struct {
+	style string
+	glyph string
+	word  string
+}
+
+var (
+	taskEndedDone        = taskEnding{ansiGreen, "✓", "done"}
+	taskEndedFailed      = taskEnding{ansiRed, "✗", "failed"}
+	taskEndedOutOfAgents = taskEnding{ansiRed, "✗", "out of agents (left open)"}
+	taskEndedInterrupted = taskEnding{ansiYellow, "◌", "interrupted"}
+)
+
+func taskEndedQuotaPaused(preset string) taskEnding {
+	return taskEnding{ansiYellow, "◌", fmt.Sprintf("quota-paused (%s)", preset)}
+}
+
+// printTaskResultLine prints the Task result line: the one line a drain prints
+// at each per-task ending, colored whole by its outcome.
+func printTaskResultLine(w io.Writer, sel *Selection, e taskEnding) {
+	outputFor(w).line(e.style, "%s %s/%s %s", e.glyph, sel.TaskSetID, sel.TaskID, e.word)
+}
+
+// printTaskDone prints the done Task result line with the implementation-commit
+// detail and the attempt breakdown beneath it.
+func printTaskDone(d *Deps, w io.Writer, result *RunTaskResult) {
+	out := outputFor(w)
+	printTaskResultLine(out, result.Selection, taskEndedDone)
+	if result.NoOp {
+		fmt.Fprintln(out, "  No implementation commit (verified no-op)")
+	} else if result.CommitSHA != "" {
+		fmt.Fprintf(out, "  Implementation commit: %s\n", result.CommitSHA[:min(12, len(result.CommitSHA))])
+	}
+	printAttemptBreakdown(d, out, result.attemptStreams)
+}
