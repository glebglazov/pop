@@ -0,0 +1,126 @@
+package tasks
+
+import (
+	"bytes"
+	"io"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func singleOpenTaskFixture(t *testing.T) *runTaskSetFixture {
+	t.Helper()
+	return setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+}
+
+// A whole-set drain invoked from inside its bound checkout opens with a Drain
+// header naming the set, the Runtime path and the binding kind, before the
+// status table — with no invoked-from line, and no ANSI on redirected output.
+func TestDrainHeaderOpensDrainFromInsideBinding(t *testing.T) {
+	env := singleOpenTaskFixture(t)
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.BindCheckout = func(setID, projectPath, runtimePath string) (CheckoutBinding, error) {
+		return CheckoutBinding{Bound: true, Provisioned: true}, nil
+	}
+	if _, err := RunTaskSetWith(env.deps(), nil, nil, opts); err != nil {
+		t.Fatalf("run: %v", err)
+	}
+
+	out := buf.String()
+	runtimePath, err := ResolveRuntimePathWith(env.deps(), env.root, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	header := "Draining demo in " + runtimePath + " (managed binding)"
+	at := strings.Index(out, header)
+	if at < 0 {
+		t.Fatalf("output missing Drain header %q:\n%s", header, out)
+	}
+	if status := strings.Index(out, "STATUS"); status < at {
+		t.Fatalf("the Drain header must precede the status table:\n%s", out)
+	}
+	if strings.Contains(out, "invoked from") || strings.Contains(out, "binding recorded") {
+		t.Fatalf("a drain from inside its binding that recorded nothing prints no follow-up lines:\n%s", out)
+	}
+	if strings.Contains(out, "\033[") {
+		t.Fatalf("redirected output contains ANSI:\n%q", out)
+	}
+}
+
+// Invoked from outside the Runtime path, the header names the invocation
+// directory; a run that just recorded its binding announces it.
+func TestDrainHeaderNamesInvocationAndRecordedBinding(t *testing.T) {
+	env := singleOpenTaskFixture(t)
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+	wt := filepath.Join(t.TempDir(), "bound-wt")
+	runGit(t, env.root, "worktree", "add", "-b", "bound", wt, "HEAD")
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.RuntimeOverride = wt
+	opts.BindCheckout = func(setID, projectPath, runtimePath string) (CheckoutBinding, error) {
+		return CheckoutBinding{Bound: true, RecordedByThis: true}, nil
+	}
+	if _, err := RunTaskSetWith(env.deps(), nil, nil, opts); err != nil {
+		t.Fatalf("run: %v", err)
+	}
+
+	out := buf.String()
+	runtimePath, err := ResolveRuntimePathWith(env.deps(), env.root, wt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	invokedFrom, err := canonicalAbsPath(env.deps(), env.root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{
+		"Draining demo in " + runtimePath + " (adopted binding)",
+		"  invoked from " + invokedFrom,
+		"  binding recorded to current checkout",
+	} {
+		if !strings.Contains(out, want) {
+			t.Fatalf("output missing %q:\n%s", want, out)
+		}
+	}
+}
+
+// A task that fails after all retries ends on one red Task result line.
+func TestTaskResultLineFailed(t *testing.T) {
+	env := singleOpenTaskFixture(t)
+	agent := writeSequentialFakeAgent(t, env.root, []fakeAgentStep{{skipSentinel: true}})
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.MaxTries = 1
+	_, err := RunTaskSetWith(env.deps(), nil, nil, opts)
+	assertExitCode(t, err, ExitOperational)
+
+	if got := strings.Count(buf.String(), "✗ demo/01-a failed"); got != 1 {
+		t.Fatalf("want one failed Task result line, got %d:\n%s", got, buf.String())
+	}
+}
+
+// A quota pause ends the task on the yellow form naming the preset.
+func TestTaskResultLineQuotaPaused(t *testing.T) {
+	installClaudeQuotaAgent(t, t.TempDir())
+	var buf bytes.Buffer
+	run, _, refresh, sel := newRunSelectedTaskRun(t,
+		[]Task{{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"}},
+		"", RunTaskSetOptions{Yes: true, AgentPreset: "claude", Output: &buf, ConfirmOut: io.Discard})
+	// An empty runtime path fails the recovery-waiter registration, so the
+	// branch exits instead of waiting out the cooldown.
+	run.runtimePath = ""
+
+	if _, _, err := run.runSelectedTask(refresh, sel); err != nil {
+		t.Fatalf("runSelectedTask: %v", err)
+	}
+	if got := strings.Count(buf.String(), "◌ demo/01-a quota-paused (claude)"); got != 1 {
+		t.Fatalf("want one quota-paused Task result line, got %d:\n%s", got, buf.String())
+	}
+}
