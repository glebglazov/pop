+package tasks
+
+import (
+	"bytes"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// A whole-set drain opens on its Drain header, before the status table, and a
+// completed task ends on one green Task result line with its implementation
+// commit beneath — plain text when the output is redirected.
+func TestRunTaskSetPrintsDrainHeaderAndDoneResultLine(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.DrainHeader = &DrainHeader{Binding: BindingAdopted, InvokedFrom: "/elsewhere", DefaultBindingRecorded: true}
+	if _, err := RunTaskSetWith(env.deps(), nil, nil, opts); err != nil {
+		t.Fatal(err)
+	}
+	out := buf.String()
+
+	header := strings.Index(out, "Draining demo at ")
+	table := strings.Index(out, "STATUS")
+	if header == -1 || table == -1 || header > table {
+		t.Fatalf("Drain header not before the status table:\n%s", out)
+	}
+	for _, want := range []string{"(adopted worktree binding)", "  invoked from /elsewhere", "  binding recorded to current checkout"} {
+		if !strings.Contains(out[:table], want) {
+			t.Fatalf("Drain header missing %q:\n%s", want, out)
+		}
+	}
+	if n := strings.Count(out, "✓ demo/01-a done"); n != 1 {
+		t.Fatalf("done result lines = %d, want 1:\n%s", n, out)
+	}
+	if strings.Contains(out, "Completed demo/01-a") {
+		t.Fatalf("the old completion line is still printed:\n%s", out)
+	}
+	if !strings.Contains(out, "✓ demo/01-a done\n  No implementation commit (verified no-op)\n") {
+		t.Fatalf("implementation commit detail not beneath the result line:\n%s", out)
+	}
+	if strings.Contains(out, "\033[") {
+		t.Fatalf("redirected output contains ANSI:\n%q", out)
+	}
+}
