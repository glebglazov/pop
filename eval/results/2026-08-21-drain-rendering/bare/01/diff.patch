+// A single-task file run has no drain, so it states the current checkout in
+// place of a Drain header.
+func TestRunTaskPrintsCurrentCheckoutLine(t *testing.T) {
+	env := setupExecutorFixture(t, false)
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "done work"})
+
+	var buf bytes.Buffer
+	opts := env.runOpts(true, agent)
+	opts.Output = &buf
+	if _, err := RunTaskWith(env.deps(), nil, nil, opts); err != nil {
+		t.Fatal(err)
+	}
+	out := buf.String()
+	if !strings.Contains(out, "Running demo/01-a in the current checkout ") {
+		t.Fatalf("missing current-checkout line:\n%s", out)
+	}
+	if strings.Contains(out, "Draining ") {
+		t.Fatalf("single-task run printed a Drain header:\n%s", out)
+	}
+}
