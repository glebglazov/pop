+
+// lockedBuffer lets a drain running on another goroutine write output the test
+// reads once that drain has stopped.
+type lockedBuffer struct {
+	mu  sync.Mutex
+	buf bytes.Buffer
+}
+
+func (b *lockedBuffer) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.Write(p)
+}
+
+func (b *lockedBuffer) String() string {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.String()
+}
+
+func TestRunTaskSetQuotaPausePrintsQuotaPausedResultLine(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	installClaudeQuotaAgent(t, env.root)
+	out := &lockedBuffer{}
+	opts := env.runTaskSetOpts(true, "", nil)
+	opts.Output = out
+	opts.AgentPreset = "claude"
+
+	d := env.deps()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, _ = RunTaskSetWith(d, nil, nil, opts)
+	}()
+	waitForRecoveryWaiter(t, d, "demo")
+	if err := DeregisterRecoveryWaiter(d, "demo"); err != nil {
+		t.Fatalf("deregister recovery waiter: %v", err)
+	}
+	select {
+	case <-done:
+	case <-time.After(hangGuard):
+		t.Fatal("drain did not exit after waiter deregistration")
+	}
+
+	if n := strings.Count(out.String(), "◌ demo/01-a quota-paused (claude)"); n != 1 {
+		t.Fatalf("quota-paused result lines = %d, want 1:\n%s", n, out.String())
+	}
+}
