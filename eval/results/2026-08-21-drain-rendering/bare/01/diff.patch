diff --git a/tasks/task_result_line.go b/tasks/task_result_line.go
new file mode 100644
index 00000000..0e0a763f
--- /dev/null
+++ b/tasks/task_result_line.go
@@ -0,0 +1,51 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+)
+
+// taskResult is how one task's turn in a whole-set drain ended. Blocked and
+// Deferred are not among them: those are set-level terminals the terminal
+// switch and the end-of-run summary report.
+type taskResult int
+
+const (
+	taskResultDone taskResult = iota
+	taskResultFailed
+	taskResultOutOfAgents
+	taskResultQuotaPaused
+	taskResultInterrupted
+)
+
+// printTaskResultLine prints the Task result line: one glyph, the task
+// reference and the outcome word, the whole line in the outcome's color.
+// preset names the agent whose quota ran out and is read only for a quota
+// pause.
+func printTaskResultLine(w io.Writer, sel *Selection, result taskResult, preset string) {
+	glyph, style, word := "✓", ansiGreen, "done"
+	switch result {
+	case taskResultFailed:
+		glyph, style, word = "✗", ansiRed, "failed"
+	case taskResultOutOfAgents:
+		glyph, style, word = "✗", ansiRed, "out of agents (left open)"
+	case taskResultQuotaPaused:
+		glyph, style, word = "◌", ansiYellow, fmt.Sprintf("quota-paused (%s)", preset)
+	case taskResultInterrupted:
+		glyph, style, word = "◌", ansiYellow, "interrupted"
+	}
+	outputFor(w).line(style, "%s %s/%s %s", glyph, sel.TaskSetID, sel.TaskID, word)
+}
+
+// execErrTaskResult classifies the error a task's attempts ended on: an
+// interrupt, an agent list that ran out on provider collapses alone and so
+// left the task Open (ADR-0231), or a failure.
+func execErrTaskResult(err error) taskResult {
+	if isInterrupted(err) {
+		return taskResultInterrupted
+	}
+	if fault, exhausted := exhaustedWalkFault(err); exhausted && fault.leavesTaskOpen() {
+		return taskResultOutOfAgents
+	}
+	return taskResultFailed
+}
