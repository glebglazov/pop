@@ -0,0 +1,136 @@
+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// TestDrainHeaderOpensWholeSetDrain: a drain invoked from inside its checkout
+// opens with the set, the Runtime path and the binding kind, before the status
+// table, and announces the Default binding its routing just recorded. The
+// output is redirected, so the lines print without color.
+func TestDrainHeaderOpensWholeSetDrain(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.BindCheckout = func(setID, projectPath, runtimePath string) (DrainBinding, error) {
+		return DrainBinding{Bound: true, DefaultRecorded: true}, nil
+	}
+	if _, err := RunTaskSetWith(env.deps(), nil, nil, opts); err != nil {
+		t.Fatalf("run failed: %v", err)
+	}
+
+	runtimePath, err := ResolveRuntimePathWith(env.deps(), env.root, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	out := buf.String()
+	want := "Draining demo at " + runtimePath + " (adopted worktree binding)\n  binding recorded to current checkout\n"
+	if !strings.HasPrefix(out, want) {
+		t.Fatalf("output must open with the Drain header %q:\n%s", want, out)
+	}
+	if strings.Contains(out, "invoked from") {
+		t.Fatalf("a drain invoked from its Runtime path must not name the invocation directory:\n%s", out)
+	}
+	if strings.Contains(out, "\033[") {
+		t.Fatalf("redirected output must carry no color:\n%q", out)
+	}
+	if strings.Count(out, "✓ demo/01-a done") != 1 {
+		t.Fatalf("output wants exactly one done Task result line:\n%s", out)
+	}
+}
+
+// TestDrainHeaderNamesInvocationDirectoryWhenItDiffers: invoked from elsewhere
+// than the Runtime path, the header adds where the drain was invoked from.
+func TestDrainHeaderNamesInvocationDirectoryWhenItDiffers(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+	sub := filepath.Join(env.root, "sub")
+	if err := os.MkdirAll(sub, 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.CWD = sub
+	opts.BindCheckout = func(setID, projectPath, runtimePath string) (DrainBinding, error) {
+		return DrainBinding{Bound: true, Provisioned: true}, nil
+	}
+	if _, err := RunTaskSetWith(env.deps(), nil, nil, opts); err != nil {
+		t.Fatalf("run failed: %v", err)
+	}
+
+	runtimePath, err := ResolveRuntimePathWith(env.deps(), env.root, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	canonSub, err := filepath.EvalSymlinks(sub)
+	if err != nil {
+		t.Fatal(err)
+	}
+	out := buf.String()
+	want := "Draining demo at " + runtimePath + " (managed worktree binding)\n  invoked from " + canonSub + "\n"
+	if !strings.HasPrefix(out, want) {
+		t.Fatalf("output must open with the Drain header %q:\n%s", want, out)
+	}
+	if strings.Contains(out, "binding recorded") {
+		t.Fatalf("no Default binding was recorded, so none may be announced:\n%s", out)
+	}
+}
+
+// TestTaskResultLineForms pins each Task result line's glyph and outcome word,
+// and that color appears only when the writer is a terminal.
+func TestTaskResultLineForms(t *testing.T) {
+	sel := &Selection{TaskSetID: "demo", TaskID: "01-a"}
+	for _, tt := range []struct {
+		outcome taskOutcome
+		style   string
+		want    string
+	}{
+		{taskOutcomeDone, ansiGreen, "✓ demo/01-a done"},
+		{taskOutcomeFailed, ansiRed, "✗ demo/01-a failed"},
+		{taskOutcomeOutOfAgents, ansiRed, "✗ demo/01-a out of agents (left open)"},
+		{taskOutcomeQuotaPaused, ansiYellow, "◌ demo/01-a quota-paused (claude)"},
+		{taskOutcomeInterrupted, ansiYellow, "◌ demo/01-a interrupted"},
+	} {
+		var plain bytes.Buffer
+		printTaskResultLine(&plain, sel, tt.outcome, "claude")
+		if got := plain.String(); got != tt.want+"\n" {
+			t.Fatalf("plain line = %q, want %q", got, tt.want)
+		}
+		var tty bytes.Buffer
+		printTaskResultLine(&output{Writer: &tty, color: true}, sel, tt.outcome, "claude")
+		if got := tty.String(); got != tt.style+tt.want+ansiReset+"\n" {
+			t.Fatalf("terminal line = %q, want the whole line colored", got)
+		}
+	}
+}
+
+// TestExecErrOutcomeReadsTheEnding: an interrupt reads as interrupted, a walk
+// that left the task Open as out of agents, and every other exec error as a
+// failure.
+func TestExecErrOutcomeReadsTheEnding(t *testing.T) {
+	sel := &Selection{TaskSetID: "demo", TaskID: "01-a"}
+	for _, tt := range []struct {
+		err  error
+		want taskOutcome
+	}{
+		{taskExitErr(sel, ExitInterrupted, "interrupted"), taskOutcomeInterrupted},
+		{&exhaustedWalkError{fault: faultProvider, err: exitErr(ExitOperational, "left open")}, taskOutcomeOutOfAgents},
+		{&exhaustedWalkError{fault: faultContract, err: exitErr(ExitOperational, "failed")}, taskOutcomeFailed},
+		{exitErr(ExitOperational, "boom"), taskOutcomeFailed},
+	} {
+		if got := execErrOutcome(tt.err); got != tt.want {
+			t.Fatalf("execErrOutcome(%v) = %d, want %d", tt.err, got, tt.want)
+		}
+	}
+}
