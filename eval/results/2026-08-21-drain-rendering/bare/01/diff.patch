diff --git a/tasks/task_result_line.go b/tasks/task_result_line.go
new file mode 100644
index 00000000..ea73b55d
--- /dev/null
+++ b/tasks/task_result_line.go
@@ -0,0 +1,66 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+)
+
+// taskOutcome is how one task's turn in a whole-set drain ended, as its Task
+// result line names it. Blocked and Deferred are set-level terminals, so they
+// have no outcome here.
+type taskOutcome int
+
+const (
+	taskOutcomeDone taskOutcome = iota
+	taskOutcomeFailed
+	taskOutcomeOutOfAgents
+	taskOutcomeQuotaPaused
+	taskOutcomeInterrupted
+)
+
+// printTaskResultLine writes the one Task result line a per-task ending gets:
+// a glyph, the <set>/<task> reference and the outcome word, the whole line
+// colored by the outcome. preset names the agent preset a quota pause waits on
+// and is ignored for every other outcome.
+func printTaskResultLine(w io.Writer, sel *Selection, outcome taskOutcome, preset string) {
+	glyph, word, style := "✓", "done", ansiGreen
+	switch outcome {
+	case taskOutcomeFailed:
+		glyph, word, style = "✗", "failed", ansiRed
+	case taskOutcomeOutOfAgents:
+		glyph, word, style = "✗", "out of agents (left open)", ansiRed
+	case taskOutcomeQuotaPaused:
+		glyph, word, style = "◌", fmt.Sprintf("quota-paused (%s)", preset), ansiYellow
+	case taskOutcomeInterrupted:
+		glyph, word, style = "◌", "interrupted", ansiYellow
+	}
+	outputFor(w).line(style, "%s %s/%s %s", glyph, sel.TaskSetID, sel.TaskID, word)
+}
+
+// execErrOutcome reads the outcome a task's exec error stands for: an
+// interrupt, an agent list that ran out on provider collapses alone and so left
+// the task Open (ADR-0231), or otherwise a failure.
+func execErrOutcome(err error) taskOutcome {
+	if isInterrupted(err) {
+		return taskOutcomeInterrupted
+	}
+	if fault, exhausted := exhaustedWalkFault(err); exhausted && fault.leavesTaskOpen() {
+		return taskOutcomeOutOfAgents
+	}
+	return taskOutcomeFailed
+}
+
+// printTaskDone writes a completed task's green Task result line with the
+// implementation-commit detail and the attempt timing beneath it.
+func printTaskDone(d *Deps, w io.Writer, result *RunTaskResult) {
+	printTaskResultLine(w, result.Selection, taskOutcomeDone, "")
+	out := outputFor(w)
+	if result.NoOp {
+		fmt.Fprintln(out, "  No implementation commit (verified no-op)")
+	} else if result.CommitSHA != "" {
+		fmt.Fprintf(out, "  Implementation commit: %s\n", result.CommitSHA[:min(12, len(result.CommitSHA))])
+	}
+	// Every attempt the task had, including those an earlier agent in the
+	// fallback list spent before handing the turn on.
+	printAttemptBreakdown(d, out, result.attemptStreams)
+}
