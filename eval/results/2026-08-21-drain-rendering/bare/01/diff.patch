diff --git a/tasks/drain_header.go b/tasks/drain_header.go
new file mode 100644
index 00000000..1b812386
--- /dev/null
+++ b/tasks/drain_header.go
@@ -0,0 +1,49 @@
+package tasks
+
+import "io"
+
+// DrainBinding is the Worktree binding a whole-set drain runs under, as its
+// Drain header names it. The BindCheckout hook reports it, because the binding
+// store sits in a package above this one.
+type DrainBinding struct {
+	Bound       bool
+	Provisioned bool
+	// DefaultRecorded is true when this run's routing just recorded a Default
+	// binding to the current checkout.
+	DefaultRecorded bool
+}
+
+// kind is the Worktree binding kind the Drain header names: managed for a
+// checkout under the managed-worktree root, adopted for any other bound one.
+func (b DrainBinding) kind() string {
+	switch {
+	case !b.Bound:
+		return "no worktree binding"
+	case b.Provisioned:
+		return "managed worktree binding"
+	default:
+		return "adopted worktree binding"
+	}
+}
+
+// printDrainHeader writes the Drain header: the unconditional opening lines of a
+// whole-set Implement, so where a drain runs is always stated rather than only
+// when it surprises. invokedFrom is the canonical invocation directory; it is
+// named only when it differs from the Runtime path.
+func printDrainHeader(w io.Writer, taskSetID, runtimePath, invokedFrom string, b DrainBinding) {
+	out := outputFor(w)
+	out.line(ansiBold, "Draining %s at %s (%s)", taskSetID, runtimePath, b.kind())
+	if invokedFrom != "" && invokedFrom != runtimePath {
+		out.line(ansiDim, "  invoked from %s", invokedFrom)
+	}
+	if b.DefaultRecorded {
+		out.line(ansiCyan, "  binding recorded to current checkout")
+	}
+}
+
+// printCurrentCheckoutLine is the Drain header's sibling for a single-task file
+// run: it has no drain and no routing, so it states only that it runs in the
+// current checkout.
+func printCurrentCheckoutLine(w io.Writer, sel *Selection, runtimePath string) {
+	outputFor(w).line(ansiBold, "Running %s/%s in the current checkout %s", sel.TaskSetID, sel.TaskID, runtimePath)
+}
