diff --git a/tasks/drain_header.go b/tasks/drain_header.go
new file mode 100644
index 00000000..f3cb6fe1
--- /dev/null
+++ b/tasks/drain_header.go
@@ -0,0 +1,51 @@
+package tasks
+
+import "io"
+
+// WorktreeBindingKind names what the Worktree binding a drain runs under is:
+// managed when pop provisioned the checkout, adopted when pop merely recorded
+// one that already existed. The zero value is a drain with no binding at all —
+// a runtime-path override onto a checkout nothing binds.
+type WorktreeBindingKind string
+
+const (
+	BindingNone    WorktreeBindingKind = ""
+	BindingManaged WorktreeBindingKind = "managed"
+	BindingAdopted WorktreeBindingKind = "adopted"
+)
+
+// DrainHeader is the routing half of a whole-set Implement's Drain header: the
+// facts only drain routing knows, handed to the executor so it can state where
+// the drain runs before the status table. The set and the Runtime path come
+// from the executor's own resolution.
+type DrainHeader struct {
+	Binding WorktreeBindingKind
+	// InvokedFrom is the invocation checkout, set only when it differs from the
+	// Runtime path.
+	InvokedFrom string
+	// DefaultBindingRecorded is set when this run recorded a Default binding to
+	// the current checkout.
+	DefaultBindingRecorded bool
+}
+
+func (h DrainHeader) render(w io.Writer, taskSetID, runtimePath string) {
+	out := outputFor(w)
+	binding := "no worktree binding"
+	if h.Binding != BindingNone {
+		binding = string(h.Binding) + " worktree binding"
+	}
+	out.line(ansiBold, "Draining %s at %s (%s)", taskSetID, runtimePath, binding)
+	if h.InvokedFrom != "" {
+		out.line(ansiDim, "  invoked from %s", h.InvokedFrom)
+	}
+	if h.DefaultBindingRecorded {
+		out.line(ansiCyan, "  binding recorded to current checkout")
+	}
+}
+
+// printCurrentCheckoutLine is the single-task file run's sibling of the Drain
+// header: that run has no drain and no routing, so it always runs where it was
+// invoked.
+func printCurrentCheckoutLine(w io.Writer, taskSetID, taskID, runtimePath string) {
+	outputFor(w).line(ansiBold, "Running %s/%s in the current checkout %s", taskSetID, taskID, runtimePath)
+}
