+// describeDrain returns the Drain header hook whole-set implement passes to the
+// executor. It reads the binding the drain runs under after BindCheckout, so an
+// adoption made there is named too; boundDefault is routing's report that it
+// just recorded a Default binding. The invocation directory is reported only
+// when its checkout is not the Runtime path — a subdirectory of the Runtime
+// path is still inside it.
+func describeDrain(d *Deps, cwd string, boundDefault bool) func(setID, projectPath, runtimePath string) (tasks.DrainHeader, error) {
+	return func(setID, projectPath, runtimePath string) (tasks.DrainHeader, error) {
+		td := d.tasksDeps()
+		header := tasks.DrainHeader{BoundDefault: boundDefault}
+		_, b, bound, err := binding.GetForSet(td, projectPath, setID)
+		if err != nil {
+			return header, err
+		}
+		if bound {
+			header.BindingKind = "adopted"
+			if b.Provisioned {
+				header.BindingKind = "managed"
+			}
+		}
+		if cwd == "" {
+			if cwd, err = td.FS.Getwd(); err != nil {
+				return header, err
+			}
+		}
+		// A directory outside every git checkout cannot be inside the Runtime path.
+		if invokedIn, err := tasks.ResolveRuntimePathWith(td, cwd, ""); err != nil || invokedIn != runtimePath {
+			header.InvokedFrom = cwd
+		}
+		return header, nil
+	}
+}
