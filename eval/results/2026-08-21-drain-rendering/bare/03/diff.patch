+	resetTaskFlags()
+	taskAgentCmd = agent
+	t.Cleanup(resetTaskFlags)
+
+	var stdout bytes.Buffer
+	if err := runTaskRunTasksWith(td, &stdout, io.Discard, strings.NewReader("n\n"), "demo", false, false); err != nil {
+		t.Fatalf("drain: %v", err)
+	}
+	out := stdout.String()
+	header := "Draining demo in " + wtRuntime + " (adopted binding)\n  invoked from " + cmdLayerDeps().WorkDir() + "\n\n"
+	if !strings.HasPrefix(out, header) {
+		t.Fatalf("output must open with the Drain header %q:\n%s", header, out)
+	}
+	if strings.Contains(out, "draining at bound checkout") {
+		t.Fatalf("the old location line is folded into the Drain header:\n%s", out)
+	}
+}
