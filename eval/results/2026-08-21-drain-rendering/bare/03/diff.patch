diff --git a/tasks/task_result_line.go b/tasks/task_result_line.go
new file mode 100644
index 00000000..e74c600a
--- /dev/null
+++ b/tasks/task_result_line.go
@@ -0,0 +1,67 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+)
+
+// taskResultOutcome is how one task's turn in a drain ended, as its Task result
+// line names it. Blocked and Deferred are set-level terminals and have no
+// outcome here.
+type taskResultOutcome int
+
+const (
+	taskResultDone taskResultOutcome = iota
+	taskResultFailed
+	taskResultOutOfAgents
+	taskResultQuotaPaused
+	taskResultInterrupted
+)
+
+// printTaskResultLine writes the Task result line: a glyph, the <set>/<task>
+// reference and the outcome word, the whole line colored by outcome. preset is
+// read only for a quota pause, which names the agent preset it waits on.
+func printTaskResultLine(w io.Writer, sel *Selection, outcome taskResultOutcome, preset string) {
+	ref := sel.TaskSetID + "/" + sel.TaskID
+	out := outputFor(w)
+	switch outcome {
+	case taskResultDone:
+		out.line(ansiGreen, "✓ %s done", ref)
+	case taskResultFailed:
+		out.line(ansiRed, "✗ %s failed", ref)
+	case taskResultOutOfAgents:
+		out.line(ansiRed, "✗ %s out of agents (left open)", ref)
+	case taskResultQuotaPaused:
+		out.line(ansiYellow, "◌ %s quota-paused (%s)", ref, preset)
+	case taskResultInterrupted:
+		out.line(ansiYellow, "◌ %s interrupted", ref)
+	}
+}
+
+// taskResultForExecErr reads which ending an attempt-execution error is: an
+// interrupt, an Agent fallback walk that ran out on provider collapses and left
+// the task open, or a failure.
+func taskResultForExecErr(err error) taskResultOutcome {
+	if isInterrupted(err) {
+		return taskResultInterrupted
+	}
+	if fault, exhausted := exhaustedWalkFault(err); exhausted && fault.leavesTaskOpen() {
+		return taskResultOutOfAgents
+	}
+	return taskResultFailed
+}
+
+// printTaskDone writes a completed task's green Task result line with its
+// implementation-commit detail and attempt timing beneath it.
+func printTaskDone(d *Deps, w io.Writer, result *RunTaskResult) {
+	printTaskResultLine(w, result.Selection, taskResultDone, "")
+	out := outputFor(w)
+	if result.NoOp {
+		fmt.Fprintln(out, "  No implementation commit (verified no-op)")
+	} else if result.CommitSHA != "" {
+		fmt.Fprintf(out, "  Implementation commit: %s\n", result.CommitSHA[:min(12, len(result.CommitSHA))])
+	}
+	// Every attempt the task had, including those an earlier agent in the
+	// fallback list spent before handing the turn on.
+	printAttemptBreakdown(d, w, result.attemptStreams)
+}
