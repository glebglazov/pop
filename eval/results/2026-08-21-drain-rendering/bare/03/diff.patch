+// TestRunTasksCmdDrainHeaderInBoundCheckout drains an unbound set from its own
+// checkout: the Drain header opens the output naming the set, the Runtime path
+// and the binding kind, announces the Default binding the drain just recorded,
+// and has no "invoked from" line, since the drain runs where it was invoked.
+func TestRunTasksCmdDrainHeaderInBoundCheckout(t *testing.T) {
+	root, td := setupRunTaskCmdFixture(t)
+	agent := writeRunTaskFakeAgent(t, root)
+
+	resetTaskFlags()
+	taskAgentCmd = agent
+	t.Cleanup(resetTaskFlags)
+
+	var stdout bytes.Buffer
+	if err := runTaskRunTasksWith(td, &stdout, io.Discard, strings.NewReader("n\n"), "demo", false, false); err != nil {
+		t.Fatalf("drain: %v", err)
+	}
+	out := stdout.String()
+	runtime, err := tasks.ResolveRuntimePathWith(td, root, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	header := "Draining demo in " + runtime + " (adopted binding)\n  binding recorded to current checkout\n"
+	if !strings.HasPrefix(out, header) {
+		t.Fatalf("output must open with the Drain header %q:\n%s", header, out)
+	}
+	if strings.Contains(out, "invoked from") {
+		t.Fatalf("a drain in its own checkout must not report where it was invoked from:\n%s", out)
+	}
+	if strings.Contains(out, "\033[") {
+		t.Fatalf("redirected output contains ANSI:\n%q", out)
+	}
+}
