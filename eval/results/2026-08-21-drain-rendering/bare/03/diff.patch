new file mode 100644
index 00000000..9725e10a
--- /dev/null
+++ b/tasks/drain_header.go
@@ -0,0 +1,43 @@
+package tasks
+
+import "io"
+
+// DrainHeader carries what the Drain header states about a drain's Worktree
+// binding that the executor cannot learn itself: routing to the checkout ran
+// before the executor started, in the caller that owns the binding model.
+type DrainHeader struct {
+	// BindingKind names the set's Worktree binding once the drain has bound its
+	// checkout: "managed" or "adopted", or "" when the set is unbound.
+	BindingKind string
+	// InvokedFrom is the invocation directory when it lies outside the Runtime
+	// path, and "" when the drain runs in the checkout it was invoked from.
+	InvokedFrom string
+	// BoundDefault reports that this run just recorded a Default binding to the
+	// current checkout.
+	BoundDefault bool
+}
+
+// printDrainHeader writes the Drain header: the opening lines of a whole-set
+// drain, before the status table, stating where the drain runs every time
+// rather than only when it would surprise.
+func printDrainHeader(w io.Writer, setID, runtimePath string, h DrainHeader) {
+	out := outputFor(w)
+	kind := "unbound"
+	if h.BindingKind != "" {
+		kind = h.BindingKind + " binding"
+	}
+	out.line(ansiBold, "Draining %s in %s (%s)", setID, runtimePath, kind)
+	if h.InvokedFrom != "" {
+		out.line(ansiDim, "  invoked from %s", h.InvokedFrom)
+	}
+	if h.BoundDefault {
+		out.line(ansiDim, "  binding recorded to current checkout")
+	}
+}
+
+// printCurrentCheckoutLine is the single-task run's sibling of the Drain
+// header: a task file run has no drain and no binding routing, so it only says
+// which checkout it runs in.
+func printCurrentCheckoutLine(w io.Writer, setID, taskID, runtimePath string) {
+	outputFor(w).line(ansiBold, "Running %s/%s in current checkout %s", setID, taskID, runtimePath)
+}
