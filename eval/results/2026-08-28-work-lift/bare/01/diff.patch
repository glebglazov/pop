+package work_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// localityStubKind answers the two locality passes with fixed containers of its
+// own, by id: neighbourhood for the checkout pass, repository for the repository
+// pass. A nil list answers nothing.
+type localityStubKind struct {
+	stubKind
+	neighbourhood, repository []string
+}
+
+func (k localityStubKind) answer(ids []string) (work.Attribution, bool) {
+	att := work.Attribution{}
+	for _, id := range ids {
+		att.Containers = append(att.Containers, work.AttributedContainer{
+			Ref:       ref.WorkRef{Kind: ref.Kind(k.id), ContainerID: id},
+			CursorKey: string(k.id) + ":" + id,
+		})
+	}
+	return att, len(ids) > 0
+}
+
+func (k localityStubKind) AttributePaneNeighbourhood(work.PaneFacts) (work.Attribution, bool) {
+	return k.answer(k.neighbourhood)
+}
+
+func (k localityStubKind) AttributePaneRepository(work.PaneFacts) (work.Attribution, bool) {
+	return k.answer(k.repository)
+}
+
+func localityContainers(kind work.KindID, ids ...string) []work.Container {
+	var out []work.Container
+	for _, id := range ids {
+		out = append(out, work.Container{ID: id, CursorKey: string(kind) + ":" + id})
+	}
+	return out
+}
+
+func attributedKeys(att *work.Attribution) []string {
+	if att == nil {
+		return nil
+	}
+	var keys []string
+	for _, c := range att.Containers {
+		keys = append(keys, c.CursorKey)
+	}
+	return keys
+}
+
+// The repository pass is the one place the ladder is not first-hit: every kind
+// with work in the repository contributes, in kind precedence order whatever order
+// the kinds were wired in, and each kind's answer keeps its own order (ADR-0241
+// decision 2). A first-hit pass would have dropped the Maps.
+func TestRepositoryPassMergesEveryAnsweringKindInPrecedenceOrder(t *testing.T) {
+	maps := localityStubKind{
+		stubKind:   stubKind{id: ref.KindMap, containers: localityContainers(ref.KindMap, "m1")},
+		repository: []string{"m1"},
+	}
+	sets := localityStubKind{
+		stubKind:   stubKind{id: ref.KindTaskSet, containers: localityContainers(ref.KindTaskSet, "s1", "s2", "s3")},
+		repository: []string{"s3", "s1"},
+	}
+
+	snap, err := work.BuildSnapshotForPane([]work.Kind{maps, sets}, work.PaneFacts{RepoCommonDir: "/repo/.git"},
+		work.BuildOptions{Ordering: work.OrderByKindPrecedence, LiftPane: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	want := []string{"task-set:s3", "task-set:s1", "map:m1"}
+	if got := attributedKeys(snap.Attribution); !slices.Equal(got, want) {
+		t.Fatalf("attributed %v, want both kinds' answers, task sets first: %v", got, want)
+	}
+	if got, wantRows := rowKeys(snap), []string{"task-set:s3", "task-set:s1", "map:m1", "task-set:s2"}; !slices.Equal(got, wantRows) {
+		t.Fatalf("rows = %v, want %v", got, wantRows)
+	}
+}
+
+// The passes above it stay first-hit, and any kind's checkout answer outranks every
+// kind's repository answer: the Map's neighbourhood answer stands alone, and the
+// task sets' repository answer is never asked for.
+func TestACheckoutAnswerFromAnyKindOutranksTheRepositoryPass(t *testing.T) {
+	maps := localityStubKind{
+		stubKind:      stubKind{id: ref.KindMap, containers: localityContainers(ref.KindMap, "m1")},
+		neighbourhood: []string{"m1"},
+	}
+	sets := localityStubKind{
+		stubKind:   stubKind{id: ref.KindTaskSet, containers: localityContainers(ref.KindTaskSet, "s1")},
+		repository: []string{"s1"},
+	}
+
+	snap, err := work.BuildSnapshotForPane([]work.Kind{sets, maps}, work.PaneFacts{RepoCommonDir: "/repo/.git"},
+		work.BuildOptions{Ordering: work.OrderByKindPrecedence, LiftPane: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if got, want := attributedKeys(snap.Attribution), []string{"map:m1"}; !slices.Equal(got, want) {
+		t.Fatalf("attributed %v, want only the checkout answer %v", got, want)
+	}
+}
