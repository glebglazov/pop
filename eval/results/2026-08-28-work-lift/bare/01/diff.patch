@@ -0,0 +1,89 @@
+package work_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// localityKind is a stub kind answering the two locality passes with whatever the
+// test hands it, so the ladder's arity is asserted without either real kind.
+type localityKind struct {
+	stubKind
+	neighbourhood []string
+	repository    []string
+}
+
+func (k localityKind) answer(ids []string) (work.Attribution, bool) {
+	var att work.Attribution
+	for _, id := range ids {
+		att.Containers = append(att.Containers, work.AttributedContainer{
+			Ref:       ref.WorkRef{Kind: k.id, ContainerID: id},
+			CursorKey: string(k.id) + ":" + id,
+		})
+	}
+	return att, len(att.Containers) > 0
+}
+
+func (k localityKind) AttributePaneNeighbourhood(work.PaneFacts) (work.Attribution, bool) {
+	return k.answer(k.neighbourhood)
+}
+
+func (k localityKind) AttributePaneRepository(work.PaneFacts) (work.Attribution, bool) {
+	return k.answer(k.repository)
+}
+
+func attributedRefs(att *work.Attribution) []string {
+	if att == nil {
+		return nil
+	}
+	var refs []string
+	for _, c := range att.Containers {
+		refs = append(refs, c.Ref.String())
+	}
+	return refs
+}
+
+var inRepo = work.PaneFacts{PaneID: "%1", Directory: "/repo/feature", RepoCommonDir: "/repo/.git"}
+
+// The repository pass concatenates every answering kind, in kind precedence order
+// whatever order the kinds were wired in — where the two passes above it would
+// have stopped at the first kind.
+func TestTheRepositoryPassMergesEveryAnsweringKind(t *testing.T) {
+	sets := localityKind{stubKind: stubKind{id: ref.KindTaskSet}, repository: []string{"s1", "s2"}}
+	maps := localityKind{stubKind: stubKind{id: ref.KindMap}, repository: []string{"m1"}}
+
+	got := attributedRefs(work.AttributePane([]work.Kind{maps, sets}, inRepo))
+
+	want := []string{"task-set:s1", "task-set:s2", "map:m1"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("attribution = %v, want %v — both kinds, Task sets first", got, want)
+	}
+}
+
+// A neighbourhood answer from any kind outranks a repository answer from every
+// kind: the repository pass is reached only when the passes above are silent.
+func TestANeighbourhoodAnswerBeatsTheRepositoryPass(t *testing.T) {
+	sets := localityKind{stubKind: stubKind{id: ref.KindTaskSet}, repository: []string{"s1"}}
+	maps := localityKind{stubKind: stubKind{id: ref.KindMap}, neighbourhood: []string{"m1"}, repository: []string{"m1", "m2"}}
+
+	got := attributedRefs(work.AttributePane([]work.Kind{sets, maps}, inRepo))
+
+	if want := []string{"map:m1"}; !slices.Equal(got, want) {
+		t.Fatalf("attribution = %v, want %v — the neighbourhood answer alone", got, want)
+	}
+}
+
+// A pane standing in no repository reaches no repository pass, however much work
+// the kinds hold.
+func TestAPaneOutsideAnyRepositoryAttributesToNothing(t *testing.T) {
+	sets := localityKind{stubKind: stubKind{id: ref.KindTaskSet}, repository: []string{"s1"}}
+	facts := inRepo
+	facts.RepoCommonDir = ""
+
+	if att := work.AttributePane([]work.Kind{sets}, facts); att != nil {
+		t.Fatalf("attribution = %v, want none outside a repository", attributedRefs(att))
+	}
+}
