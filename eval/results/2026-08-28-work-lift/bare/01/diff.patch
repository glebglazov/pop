+// The pane's repository is resolved once, at launch: the pane's directory is never
+// re-read, so a dashboard left open over many rebuilds forks git there no more than
+// its launch did — the rebuild re-derives the answer from the carried fact.
+func TestThePanesRepositoryIsResolvedOnceAtLaunch(t *testing.T) {
+	f := newPaneRepoFixture(t, 1)
+	d, cfg, stems := f.d, f.cfg, f.stems
+	sibling := siblingWorktree(t, f.repo)
+	f.standIn(sibling)
+	git := &dirCountingGit{inner: d.Tasks.Git}
+	d.Tasks.Git = git
+
+	m := openFromPane(t, d, cfg)
+	atLaunch := git.callsUnder(sibling)
+	if atLaunch != 1 {
+		t.Fatalf("git calls in the pane's directory at launch = %d, want exactly one", atLaunch)
+	}
+	for range 5 {
+		m = rebuild(t, m)
+	}
+	if got := git.callsUnder(sibling); got != atLaunch {
+		t.Fatalf("git calls in the pane's directory after five rebuilds = %d, want %d — a rebuild must not ask again", got, atLaunch)
+	}
+	if got := liftedBlock(t, m); !slices.Equal(got, []string{stems[2], stems[1], stems[0]}) {
+		t.Fatalf("lifted %v after rebuilds, want the repository's sets still", got)
+	}
+}
+
+// dirCountingGit is a real git seam that records the directory each subprocess
+// ran in, so a test can say how often one place was asked about.
+type dirCountingGit struct {
+	inner deps.Git
+	mu    sync.Mutex
+	dirs  []string
+}
+
+func (g *dirCountingGit) Command(args ...string) (string, error) {
+	return g.inner.Command(args...)
+}
+
+func (g *dirCountingGit) CommandInDir(dir string, args ...string) (string, error) {
+	g.mu.Lock()
+	g.dirs = append(g.dirs, dir)
+	g.mu.Unlock()
+	return g.inner.CommandInDir(dir, args...)
+}
+
+func (g *dirCountingGit) callsUnder(root string) int {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	n := 0
+	for _, dir := range g.dirs {
+		if dir == root || strings.HasPrefix(dir, root+string(filepath.Separator)) {
+			n++
+		}
+	}
+	return n
+}
