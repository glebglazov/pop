+// The ladder's third pass (ADR-0241): a shell standing anywhere in a repository
+// lifts that repository's Task sets when no pass above it knew the pane. Every test
+// here drives the whole path — a fake tmux pane with a real directory in a real
+// repository, LaunchPaneFacts' one git call, and the snapshot build into a model —
+// because the pass is only right if the launch-time repository and the kind's
+// Task storage name the same repository.
+
+// siblingWorktree adds one more worktree of repo, bound to nothing: the feature
+// worktree a human opens beside the trunk a set is bound to.
+func siblingWorktree(t *testing.T, repo string) string {
+	t.Helper()
+	sibling := filepath.Join(t.TempDir(), "feature-wt")
+	runGit(t, repo, "worktree", "add", "-b", "wt/feature", sibling)
+	return sibling
+}
+
+// The reported case: a set bound to one checkout, and a shell in a sibling
+// worktree that is inside no binding. The repository pass answers with every set
+// in the repository's Task storage, bound or not, in the active sort's order.
