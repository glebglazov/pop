+// The pane's repository is one git question asked at launch, never during a
+// build: a dashboard left open over many rebuilds forks exactly what a build with
+// no pane behind it forks, no more (ADR-0241 decision 5).
+func TestTheRepositoryIsResolvedOnceAtLaunch(t *testing.T) {
+	d, cfg, _, checkout := boundCheckoutFixture(t)
+	d.Tmux.(*queuetest.RecordingTmux).Fake.PaneCwd["%7"] = siblingWorktree(t, repoOfCheckout(t, checkout))
+	counter := &countingGit{inner: d.Tasks.Git}
+	td := *d.Tasks
+	td.Git = counter
+	d.Tasks = &td
+
+	launch := LaunchPaneFacts(d.Tmux, d.Tasks)
+	if got := len(counter.forks()); got != 1 {
+		t.Fatalf("launch forked %d gits, want the one repository question: %v", got, counter.forks())
+	}
+	if launch.RepoCommonDir == "" {
+		t.Fatal("launch resolved no repository for a pane standing in one")
+	}
+
+	before := len(counter.forks())
+	if _, err := BuildPageSnapshot(d, cfg, PageWork, launch); err != nil {
+		t.Fatal(err)
+	}
+	withPane := len(counter.forks()) - before
+	before = len(counter.forks())
+	unliftedOrder(t, d, cfg)
+	paneless := len(counter.forks()) - before
+	if withPane != paneless {
+		t.Fatalf("a build carrying the pane forked %d gits, a paneless build %d — attribution must fork nothing", withPane, paneless)
+	}
+
+	m := openFromPane(t, d, cfg)
+	before = len(counter.forks())
+	const rebuilds = 5
+	for i := 0; i < rebuilds; i++ {
+		m = rebuild(t, m)
+	}
+	if got, want := len(counter.forks())-before, rebuilds*paneless; got != want {
+		t.Fatalf("%d rebuilds forked %d gits, want %d — the paneless cost of each", rebuilds, got, want)
+	}
+	if len(liftedBlock(t, m)) == 0 {
+		t.Fatal("nothing lifted after the rebuilds: the fixture must exercise the repository pass")
+	}
+}
+
+// repoOfCheckout is the main worktree of the repository checkout belongs to.
+func repoOfCheckout(t *testing.T, checkout string) string {
+	t.Helper()
+	common := strings.TrimSpace(runGitOutput(t, checkout, "rev-parse", "--path-format=absolute", "--git-common-dir"))
+	return filepath.Dir(common)
+}
