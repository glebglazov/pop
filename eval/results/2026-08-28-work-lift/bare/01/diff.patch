+)
+
+// The repository pass (ADR-0241): an ordinary shell standing anywhere in a
+// repository, in a checkout no set is bound to. Every test here drives the whole
+// path — a real repository and worktree, the launch's one git question, the
+// kind-side pass during the build and the model's rows — because the pass only
+// works if the pane's repository and the Task storage's agree as plain strings.
+
+// siblingWorktree adds a linked worktree of repo that nothing is bound to: the
+// feature checkout beside the trunk that the neighbourhood pass cannot see.
+func siblingWorktree(t *testing.T, repo string) string {
+	t.Helper()
+	sibling := filepath.Join(t.TempDir(), "feature-wt")
+	runGit(t, repo, "worktree", "add", "-b", "wt/feature", sibling)
+	return sibling
+}
+
+// A shell in a sibling worktree of the checkout a set is bound to lifts that set —
+// and every other set of the repository, bound or not, in the sort's order. Before
+// the repository pass this shell lifted nothing.
