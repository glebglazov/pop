+package work_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// locatedKind is a stub kind that answers the two locality passes from fixed
+// lists, so a test can decide which passes have anything to say.
+type locatedKind struct {
+	stubKind
+	neighbourhood, repository []string
+}
+
+func (k locatedKind) answer(ids []string) (work.Attribution, bool) {
+	att := work.Attribution{}
+	for _, id := range ids {
+		att.Containers = append(att.Containers, work.AttributedContainer{
+			Ref:       ref.WorkRef{Kind: k.id, ContainerID: id},
+			CursorKey: string(k.id) + ":" + id,
+		})
+	}
+	return att, len(att.Containers) > 0
+}
+
+func (k locatedKind) AttributePaneNeighbourhood(work.PaneFacts) (work.Attribution, bool) {
+	return k.answer(k.neighbourhood)
+}
+
+func (k locatedKind) AttributePaneRepository(work.PaneFacts) (work.Attribution, bool) {
+	return k.answer(k.repository)
+}
+
+func attributedKeys(att *work.Attribution) []string {
+	if att == nil {
+		return nil
+	}
+	var keys []string
+	for _, c := range att.Containers {
+		keys = append(keys, c.CursorKey)
+	}
+	return keys
+}
+
+var inRepo = work.PaneFacts{PaneID: "%1", Directory: "/src/app-feature", RepoCommonDir: "/src/app/.git"}
+
+// The repository pass alone concatenates: both kinds holding work in the
+// repository answer, in kind precedence order whatever order they are wired in.
+func TestTheRepositoryPassMergesEveryAnsweringKind(t *testing.T) {
+	maps := locatedKind{stubKind: stubKind{id: ref.KindMap}, repository: []string{"m1"}}
+	sets := locatedKind{stubKind: stubKind{id: ref.KindTaskSet}, repository: []string{"s2", "s1"}}
+
+	got := attributedKeys(work.AttributePane([]work.Kind{maps, sets}, inRepo))
+	want := []string{"task-set:s2", "task-set:s1", "map:m1"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("attributed %v, want %v — every kind's repository answer, sets before maps", got, want)
+	}
+}
+
+// Any kind's neighbourhood answer outranks every kind's repository answer, and the
+// neighbourhood pass stays first-hit.
+func TestANeighbourhoodAnswerSilencesTheRepositoryPass(t *testing.T) {
+	maps := locatedKind{stubKind: stubKind{id: ref.KindMap}, neighbourhood: []string{"m1"}, repository: []string{"m1", "m2"}}
+	sets := locatedKind{stubKind: stubKind{id: ref.KindTaskSet}, repository: []string{"s1"}}
+
+	got := attributedKeys(work.AttributePane([]work.Kind{sets, maps}, inRepo))
+	if want := []string{"map:m1"}; !slices.Equal(got, want) {
+		t.Fatalf("attributed %v, want %v — a checkout beats a mere repository", got, want)
+	}
+}
+
+func TestNoRepositoryAnswerAttributesNothing(t *testing.T) {
+	sets := locatedKind{stubKind: stubKind{id: ref.KindTaskSet}}
+	if att := work.AttributePane([]work.Kind{sets}, inRepo); att != nil {
+		t.Fatalf("attributed %v, want nil", attributedKeys(att))
+	}
+}
