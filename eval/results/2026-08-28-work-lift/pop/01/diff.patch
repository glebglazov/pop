index 00000000..9b535d19
--- /dev/null
+++ b/dashboard/pane_repository_test.go
@@ -0,0 +1,183 @@
+package dashboard
+
+import (
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/queuetest"
+	tmuxmod "github.com/glebglazov/pop/internal/tmux"
+	"github.com/glebglazov/pop/tasks/binding"
+	"github.com/glebglazov/pop/tasks/drain"
+)
+
+// The ladder's repository pass (ADR-0241): a shell standing anywhere in a
+// repository lifts that repository's Task sets once no checkout rung answered.
+// Every test drives the whole path — a fake pane with a real directory, a real
+// git common directory resolved at launch, real bindings — because the pass is
+// only right if the launch and the kind agree about which repository is which.
+
+// siblingWorktreeFixture is the reported case: four registered sets in one
+// repository, one of them bound to its trunk, and the caller in an untagged shell
+// in a sibling feature worktree no set is bound to.
+func siblingWorktreeFixture(t *testing.T) (d *drain.Deps, cfg *config.Config, rt *queuetest.RecordingTmux, bound string, sibling string) {
+	t.Helper()
+	repo, setID, _ := queuetest.SetupSpawnRepo(t, "2026-01-01-done-1", []queuetest.SpawnTask{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "done"},
+	})
+	d, cfg, _, rt = dashboardLaunchFixture(t, repo, setID)
+	stems := registerDoneSets(t, repo, 3)
+	d.ViewPreset, _ = config.ShippedWorkViewPreset("all")
+	d.ViewPreset.Lift = true
+	repoKey, err := drain.ResolveRepoKey(d, repo)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bound = stems[1]
+	if err := binding.Put(d.Tasks, drain.SetScopedKey(repoKey, bound), binding.Binding{RuntimePath: repo}); err != nil {
+		t.Fatal(err)
+	}
+	sibling = filepath.Join(t.TempDir(), "feature-wt")
+	runGit(t, repo, "worktree", "add", "-b", "feature", sibling)
+	inPane(rt.Fake, "editor", "%7")
+	rt.Fake.PaneCwd = map[string]string{"%7": sibling}
+	return d, cfg, rt, bound, sibling
+}
+
+// A shell in a sibling worktree lifts every set in the repository, the bound one
+// and the ones bound nowhere alike, in the order the sort already gives them.
+func TestAShellInASiblingWorktreeLiftsTheRepositorysSets(t *testing.T) {
+	d, cfg, _, bound, _ := siblingWorktreeFixture(t)
+	baseline := unliftedOrder(t, d, cfg)
+
+	m := openFromPane(t, d, cfg)
+
+	got := liftedBlock(t, m)
+	if !slices.Contains(got, bound) {
+		t.Fatalf("lifted %v, want the set bound to the trunk %q among them", got, bound)
+	}
+	if !slices.Equal(got, baseline) {
+		t.Fatalf("lifted %v, want every set in the repository, bound or not, in sorted order %v", got, baseline)
+	}
+	if m.flash.Text() != "" {
+		t.Fatalf("status = %q, want silence: the lift says it", m.flash.Text())
+	}
+}
+
+// A shell in a checkout a set is bound to keeps today's answer: the bound set
+// alone, not the repository's other sets, though the pane's repository is known.
+func TestABoundCheckoutOutranksTheRepositoryPass(t *testing.T) {
+	d, cfg, stems, _ := boundCheckoutFixture(t, 1)
+	baseline := unliftedOrder(t, d, cfg)
+
+	if facts := LaunchPaneFacts(d.Tmux, d.Tasks); facts.RepoCommonDir == "" {
+		t.Fatal("the launch resolved no repository for a pane inside one — the test would pass for the wrong reason")
+	}
+	m := openFromPane(t, d, cfg)
+
+	if got := liftedBlock(t, m); !slices.Equal(got, []string{stems[1]}) {
+		t.Fatalf("lifted %v, want only the set bound to the pane's checkout %q", got, stems[1])
+	}
+	if got, want := rowIDs(m), wantLiftedFirst(baseline, stems[1]); !slices.Equal(got, want) {
+		t.Fatalf("rows = %v, want %v", got, want)
+	}
+}
+
+// A pane pop opened for a set is that set's, whatever else lives in the
+// repository it stands in.
+func TestATaggedPaneInTheRepositoryKeepsTheTagAnswer(t *testing.T) {
+	d, cfg, rt, _, _ := siblingWorktreeFixture(t)
+	baseline := unliftedOrder(t, d, cfg)
+	stem := baseline[len(baseline)-1]
+	tagPane(rt.Fake, "%7", tmuxmod.TagSet, stem)
+
+	m := openFromPane(t, d, cfg)
+
+	if got := liftedBlock(t, m); !slices.Equal(got, []string{stem}) {
+		t.Fatalf("lifted %v, want the tagged set %q alone", got, stem)
+	}
+}
+
+// Outside any repository, and in a repository pop holds no work for, the pass is
+// silent: nothing lifts and nothing is said.
+func TestAPaneWithNoWorkInItsRepositoryLiftsNothing(t *testing.T) {
+	unknown := t.TempDir()
+	queuetest.InitGitRepo(t, unknown)
+	for name, dir := range map[string]string{
+		"outside any repository": t.TempDir(),
+		"in an unknown one":      unknown,
+	} {
+		t.Run(name, func(t *testing.T) {
+			d, cfg, rt, _, _ := siblingWorktreeFixture(t)
+			rt.Fake.PaneCwd["%7"] = dir
+
+			m := openFromPane(t, d, cfg)
+
+			if got := liftedBlock(t, m); len(got) != 0 {
+				t.Fatalf("lifted %v, want nothing", got)
+			}
+			if m.flash.Text() != "" {
+				t.Fatalf("status = %q, want silence", m.flash.Text())
+			}
+		})
+	}
+}
+
+// The pane's repository is one fork at launch. Rebuilds carry it and ask git
+// nothing more about it, however long the dashboard stays open.
+func TestRebuildsResolveThePanesRepositoryNoSecondTime(t *testing.T) {
+	d, cfg, _, bound, _ := siblingWorktreeFixture(t)
+	counter := &countingGit{inner: d.Tasks.Git}
+	td := *d.Tasks
+	td.Git = counter
+	d.Tasks = &td
+	pd := *d.Project
+	pd.Git = counter
+	d.Project = &pd
+	resolves := func() int {
+		n := 0
+		for _, call := range counter.forks() {
+			if call == "rev-parse --git-common-dir" {
+				n++
+			}
+		}
+		return n
+	}
+
+	m := openFromPane(t, d, cfg)
+	atLaunch := resolves()
+	if atLaunch != 1 {
+		t.Fatalf("resolved the pane's repository %d times at launch, want one fork", atLaunch)
+	}
+	for range 5 {
+		m = rebuild(t, m)
+	}
+
+	if got := resolves(); got != atLaunch {
+		t.Fatalf("resolved a repository %d times after five polls, want the launch's %d", got, atLaunch)
+	}
+	if got := liftedBlock(t, m); !slices.Contains(got, bound) {
+		t.Fatalf("lifted %v, want %q — the carried fact still attributes", got, bound)
+	}
+}
+
+// The preset stays absolute under the repository pass: a hidden set is not lifted
+// and the view is not widened to show it.
+func TestTheRepositoryPassLiftsNoRowThePresetHides(t *testing.T) {
+	d, cfg, _, _, _ := siblingWorktreeFixture(t)
+	d.ViewPreset = config.WorkViewPreset{
+		Name: "_hide-done",
+		Lift: true,
+		Hide: &config.WorkViewPresetFilter{Status: []string{"done"}},
+	}
+
+	m := openFromPane(t, d, cfg)
+
+	if len(m.snap.Containers) != 0 {
+		t.Fatalf("rows = %v, want none — the lift must not widen the preset", rowIDs(m))
+	}
+	if m.flash.Text() != "" {
+		t.Fatalf("status = %q, want silence about a row nobody can see", m.flash.Text())
+	}
+}
