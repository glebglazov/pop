+package work_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// ladderKind is a kind that answers each pass of the ladder with a fixed list of
+// container ids, or not at all when the list is empty. The repository pass answers
+// only for the repository it holds work in, which is the one fact that pass reads.
+type ladderKind struct {
+	stubKind
+	tag, neighbourhood, repository []string
+	repo                           string
+}
+
+func (k ladderKind) answer(ids []string) (work.Attribution, bool) {
+	att := work.Attribution{}
+	for _, id := range ids {
+		att.Containers = append(att.Containers, work.AttributedContainer{
+			Ref:       ref.WorkRef{Kind: k.id, ContainerID: id},
+			CursorKey: string(k.id) + ":" + id,
+		})
+	}
+	return att, len(ids) > 0
+}
+
+func (k ladderKind) AttributePane(work.PaneFacts) (work.Attribution, bool) {
+	return k.answer(k.tag)
+}
+
+func (k ladderKind) AttributePaneNeighbourhood(work.PaneFacts) (work.Attribution, bool) {
+	return k.answer(k.neighbourhood)
+}
+
+func (k ladderKind) AttributePaneRepository(facts work.PaneFacts) (work.Attribution, bool) {
+	if facts.RepoCommonDir == "" || facts.RepoCommonDir != k.repo {
+		return work.Attribution{}, false
+	}
+	return k.answer(k.repository)
+}
+
+func attributedRefs(att *work.Attribution) []string {
+	if att == nil {
+		return nil
+	}
+	var got []string
+	for _, c := range att.Containers {
+		got = append(got, c.CursorKey)
+	}
+	return got
+}
+
+const ladderRepo = "/src/pop/.git"
+
+// The repository pass means "the work of mine that lives here", which is plural
+// across kinds: two kinds with work in the pane's repository both answer, in kind
+// precedence order, where a first-hit pass would have silenced the second
+// (ADR-0241 decision 2).
+func TestTheRepositoryPassMergesEveryKindWithWorkThere(t *testing.T) {
+	kinds := []work.Kind{
+		ladderKind{stubKind: stubKind{id: ref.KindMap}, repo: ladderRepo, repository: []string{"chart"}},
+		ladderKind{stubKind: stubKind{id: ref.KindTaskSet}, repo: ladderRepo, repository: []string{"set-a", "set-b"}},
+	}
+
+	got := attributedRefs(work.AttributePane(kinds, work.PaneFacts{PaneID: "%1", RepoCommonDir: ladderRepo}))
+
+	want := []string{"task-set:set-a", "task-set:set-b", "map:chart"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("attribution = %v, want both kinds' work in precedence order %v", got, want)
+	}
+}
+
+// The repository pass never competes with a better answer: any kind's checkout
+// answer and any kind's tag answer outrank every kind's repository answer.
+func TestTheRepositoryPassIsReachedOnlyWhenTheRungsAboveAreSilent(t *testing.T) {
+	facts := work.PaneFacts{PaneID: "%1", RepoCommonDir: ladderRepo}
+	for _, tc := range []struct {
+		name  string
+		kinds []work.Kind
+		want  []string
+	}{
+		{
+			name: "a checkout answer",
+			kinds: []work.Kind{
+				ladderKind{stubKind: stubKind{id: ref.KindTaskSet}, repo: ladderRepo, repository: []string{"set-a", "set-b"}},
+				ladderKind{stubKind: stubKind{id: ref.KindMap}, neighbourhood: []string{"chart"}, repo: ladderRepo, repository: []string{"chart"}},
+			},
+			want: []string{"map:chart"},
+		},
+		{
+			name: "a tag answer",
+			kinds: []work.Kind{
+				ladderKind{stubKind: stubKind{id: ref.KindTaskSet}, tag: []string{"set-b"}, neighbourhood: []string{"set-a"}, repo: ladderRepo, repository: []string{"set-a", "set-b"}},
+			},
+			want: []string{"task-set:set-b"},
+		},
+	} {
+		if got := attributedRefs(work.AttributePane(tc.kinds, facts)); !slices.Equal(got, tc.want) {
+			t.Errorf("%s: attribution = %v, want %v", tc.name, got, tc.want)
+		}
+	}
+}
+
+// A pane outside any repository, or in one no kind holds work in, is attributed to
+// nothing at all.
+func TestARepositoryWithNoWorkHereAttributesNothing(t *testing.T) {
+	kinds := []work.Kind{
+		ladderKind{stubKind: stubKind{id: ref.KindTaskSet}, repo: ladderRepo, repository: []string{"set-a"}},
+	}
+	for _, repo := range []string{"", "/src/other/.git"} {
+		if att := work.AttributePane(kinds, work.PaneFacts{PaneID: "%1", RepoCommonDir: repo}); att != nil {
+			t.Errorf("RepoCommonDir %q: attribution = %v, want none", repo, attributedRefs(att))
+		}
+	}
+}
