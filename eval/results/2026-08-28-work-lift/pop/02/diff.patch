@@ -0,0 +1,62 @@
+package wayfinder
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// liftedMaps builds one lifting snapshot from the pane's facts and returns the
+// ids of the rows it lifted, top first.
+func liftedMaps(t *testing.T, k *MapKind, facts work.PaneFacts) []string {
+	t.Helper()
+	snap, err := work.BuildSnapshotForPane([]work.Kind{k}, facts, work.BuildOptions{Ordering: work.OrderByKindPrecedence, Lift: true})
+	if err != nil {
+		t.Fatalf("BuildSnapshotForPane: %v", err)
+	}
+	var lifted []string
+	for _, c := range snap.Containers {
+		if c.Lifted {
+			lifted = append(lifted, c.ID)
+		}
+	}
+	return lifted
+}
+
+// A shell pop never opened, standing in a checkout no Map knows, still stands in
+// the repository the Maps are rooted in. It lifts every Map of that repository
+// the preset shows, in the order the rows already sort; the abandoned, archived
+// and broken ones the preset hides lift nothing (ADR-0241 decision 3).
+func TestPaneInTheRepositoryLiftsItsLiveMaps(t *testing.T) {
+	k, _ := mapKindFixture(t)
+	got := liftedMaps(t, k, work.PaneFacts{
+		PaneID:        "%7",
+		Session:       "editor",
+		Directory:     "/repo/feature-worktree",
+		RepoCommonDir: "/repo/.git",
+	})
+	if want := []string{"2026-07-02-arrived", "2026-07-01-active"}; !slices.Equal(got, want) {
+		t.Fatalf("lifted %v, want %v", got, want)
+	}
+
+	if got := liftedMaps(t, k, work.PaneFacts{PaneID: "%7", Directory: "/elsewhere", RepoCommonDir: "/elsewhere/.git"}); got != nil {
+		t.Fatalf("a pane in another repository lifted %v, want nothing", got)
+	}
+}
+
+// The stamp is the stronger pass: a pane in a Map's own session is that Map,
+// and the repository it also stands in does not add the Map's siblings.
+func TestMapSessionPaneIsNotOvertakenByItsRepository(t *testing.T) {
+	k, _ := mapKindFixture(t)
+	att, rows := attributeMap(t, k, work.PaneFacts{
+		PaneID:        "%5",
+		Session:       "some-session-name",
+		WorkKind:      string(ref.KindMap),
+		WorkID:        "2026-07-01-active",
+		Directory:     "/repo/main",
+		RepoCommonDir: "/repo/.git",
+	})
+	assertAttributes(t, att, rows, "2026-07-01-active")
+}
