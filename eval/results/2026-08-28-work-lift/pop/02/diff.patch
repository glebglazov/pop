index 00000000..d60136aa
--- /dev/null
+++ b/dashboard/pane_repository_test.go
@@ -0,0 +1,133 @@
+package dashboard
+
+import (
+	"path/filepath"
+	"slices"
+	"sync/atomic"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/deps"
+	"github.com/glebglazov/pop/internal/queuetest"
+	tmuxmod "github.com/glebglazov/pop/internal/tmux"
+	"github.com/glebglazov/pop/tasks/drain"
+)
+
+// The ladder's repository pass (ADR-0241): a shell standing anywhere in a
+// repository, in a checkout no set is bound to, lifts that repository's sets. The
+// fixture binds one set to one worktree and puts the shell in a second, sibling
+// worktree of the same repository — the reported case, where the checkout rung is
+// right to stay silent and the human still means "the work that lives here".
+
+// siblingWorktreeFixture is boundCheckoutFixture with the shell moved to a sibling
+// worktree of the bound checkout.
+func siblingWorktreeFixture(t *testing.T, bind ...int) (*drain.Deps, *config.Config, []string, string) {
+	t.Helper()
+	d, cfg, stems, checkout := boundCheckoutFixture(t, bind...)
+	repo := runGitOutput(t, checkout, "rev-parse", "--path-format=absolute", "--git-common-dir")
+	sibling := filepath.Join(t.TempDir(), "feature-wt")
+	runGit(t, filepath.Dir(repo), "worktree", "add", "-q", "-b", "wt/feature", sibling)
+	d.Tmux.(*queuetest.RecordingTmux).Fake.PaneCwd["%7"] = sibling
+	return d, cfg, stems, sibling
+}
+
+// A shell in a sibling worktree lifts every set of the repository — the one bound
+// next door and the ones bound nowhere — in the order the page already has them.
+func TestASiblingWorktreeOfABoundCheckoutLiftsTheRepositorysSets(t *testing.T) {
+	d, cfg, stems, _ := siblingWorktreeFixture(t, 1)
+	baseline := unliftedOrder(t, d, cfg)
+
+	m := openFromPane(t, d, cfg)
+
+	got := liftedBlock(t, m)
+	if !slices.Contains(got, stems[1]) {
+		t.Fatalf("lifted %v, want the set bound to the sibling checkout (%q) among them", got, stems[1])
+	}
+	if !slices.Equal(got, baseline) {
+		t.Fatalf("lifted %v, want every set of the repository, bound or not, in sort order %v", got, baseline)
+	}
+	if m.flash.Text() != "" {
+		t.Fatalf("status = %q, want silence", m.flash.Text())
+	}
+}
+
+// A pane pop opened for a set is that set's, wherever it stands: the tag answers
+// first and the repository pass is never reached.
+func TestATaggedPaneInTheRepositoryGetsTheTagAnswer(t *testing.T) {
+	d, cfg, stems, _ := siblingWorktreeFixture(t, 1)
+	tagPane(d.Tmux.(*queuetest.RecordingTmux).Fake, "%7", tmuxmod.TagSet, stems[2])
+
+	m := openFromPane(t, d, cfg)
+
+	if got := liftedBlock(t, m); !slices.Equal(got, []string{stems[2]}) {
+		t.Fatalf("lifted %v, want only the tagged set %q", got, stems[2])
+	}
+}
+
+// The pane's repository is git's answer, and it is asked once: a dashboard left
+// open rebuilds every two seconds, and none of those rebuilds asks git again.
+func TestThePanesRepositoryIsResolvedOnceAtLaunch(t *testing.T) {
+	d, cfg, _, sibling := siblingWorktreeFixture(t)
+	probe := &paneRepoProbe{inner: d.Tasks.Git, dir: sibling}
+	d.Tasks.Git = probe
+
+	m := openFromPane(t, d, cfg)
+	atLaunch := probe.asked.Load()
+	if atLaunch != 1 {
+		t.Fatalf("asked git for the pane's repository %d times at launch, want once", atLaunch)
+	}
+	lifted := liftedBlock(t, m)
+	for range 5 {
+		m = rebuild(t, m)
+	}
+
+	if got := probe.asked.Load(); got != atLaunch {
+		t.Fatalf("asked git for the pane's repository %d times over five polls, want the launch's %d", got, atLaunch)
+	}
+	if got := liftedBlock(t, m); len(got) == 0 || !slices.Equal(got, lifted) {
+		t.Fatalf("lifted %v after the polls, want the launch's %v — the carried fact still attributes", got, lifted)
+	}
+}
+
+// paneRepoProbe counts the git calls that ask which repository the pane's own
+// directory is in, and passes every call through to a real git.
+type paneRepoProbe struct {
+	inner deps.Git
+	dir   string
+	asked atomic.Int32
+}
+
+func (g *paneRepoProbe) Command(args ...string) (string, error) {
+	return g.inner.Command(args...)
+}
+
+func (g *paneRepoProbe) CommandInDir(dir string, args ...string) (string, error) {
+	if dir == g.dir && slices.Contains(args, "--git-common-dir") {
+		g.asked.Add(1)
+	}
+	return g.inner.CommandInDir(dir, args...)
+}
+
+// The preset is absolute under the repository pass as under every other: a set it
+// hides is attributed but not lifted, and the view is not widened to show it.
+func TestARepositoryLiftNeverWidensThePreset(t *testing.T) {
+	d, cfg, _, _ := siblingWorktreeFixture(t, 1)
+	d.ViewPreset = config.WorkViewPreset{
+		Name:  "_hide-done",
+		Label: "in flight",
+		Lift:  true,
+		Hide:  &config.WorkViewPresetFilter{Status: []string{"done"}},
+	}
+
+	m := openFromPane(t, d, cfg)
+
+	if m.snap.Attribution == nil {
+		t.Fatal("attribution = none, want the repository's sets — the fixture is not reaching the pass")
+	}
+	if len(m.snap.Containers) != 0 {
+		t.Fatalf("rows = %v, want none — the lift must not widen the preset", rowIDs(m))
+	}
+	if m.flash.Text() != "" {
+		t.Fatalf("status = %q, want silence about rows nobody can see", m.flash.Text())
+	}
+}
