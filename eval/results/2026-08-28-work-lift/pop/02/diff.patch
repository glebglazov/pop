--- /dev/null
+++ b/work/attribute_test.go
@@ -0,0 +1,71 @@
+package work_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// localityKind is a kind that answers only the ladder's locality passes, with
+// fixed answers, so a test can set what each pass says per kind. It embeds the
+// seam only to satisfy it: the ladder asks a kind for its ID and its answers,
+// and nothing else.
+type localityKind struct {
+	work.Kind
+	id                      work.KindID
+	neighbourhood, repoWork []string
+}
+
+func (k localityKind) ID() work.KindID { return k.id }
+
+func (k localityKind) AttributePaneNeighbourhood(work.PaneFacts) (work.Attribution, bool) {
+	return k.answer(k.neighbourhood)
+}
+
+func (k localityKind) AttributePaneRepository(work.PaneFacts) (work.Attribution, bool) {
+	return k.answer(k.repoWork)
+}
+
+func (k localityKind) answer(ids []string) (work.Attribution, bool) {
+	att := work.Attribution{}
+	for _, id := range ids {
+		att.Containers = append(att.Containers, work.AttributedContainer{
+			Ref: ref.WorkRef{Kind: k.id, ContainerID: id},
+		})
+	}
+	return att, len(ids) > 0
+}
+
+func attributedRefs(att *work.Attribution) []string {
+	if att == nil {
+		return nil
+	}
+	var refs []string
+	for _, c := range att.Containers {
+		refs = append(refs, string(c.Ref.Kind)+":"+c.Ref.ContainerID)
+	}
+	return refs
+}
+
+// The repository pass is the one pass that merges: every kind with work in the
+// repository answers, in kind precedence order, however the kinds were wired.
+// The passes above it stay first-hit, so a checkout answer from one kind still
+// silences every kind's repository answer (ADR-0241 decisions 1 and 2).
+func TestTheRepositoryPassMergesEveryAnsweringKind(t *testing.T) {
+	facts := work.PaneFacts{Directory: "/repo/sibling", RepoCommonDir: "/repo/.git"}
+	maps := localityKind{id: ref.KindMap, repoWork: []string{"m1"}}
+	sets := localityKind{id: ref.KindTaskSet, repoWork: []string{"s1", "s2"}}
+
+	got := attributedRefs(work.AttributePane([]work.Kind{maps, sets}, facts))
+	if want := []string{"task-set:s1", "task-set:s2", "map:m1"}; !slices.Equal(got, want) {
+		t.Fatalf("attributed %v, want %v — both kinds, task sets first", got, want)
+	}
+
+	maps.neighbourhood = []string{"m-here"}
+	got = attributedRefs(work.AttributePane([]work.Kind{maps, sets}, facts))
+	if want := []string{"map:m-here"}; !slices.Equal(got, want) {
+		t.Fatalf("attributed %v, want %v — a checkout answer outranks every repository answer", got, want)
+	}
+}
