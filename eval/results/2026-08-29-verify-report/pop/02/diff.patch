+package tasks
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"time"
+)
+
+// verifyProse is the Verify report's body, which no surface may print: each
+// carries a pointer to the document and nothing else (ADR-0245).
+const verifyProse = "SECRET-VERIFY-PROSE"
+
+// seedVerifyReport files one Verify report for the fixture set, as the
+// Verifier would have written it against workSHA, and returns its path.
+func seedVerifyReport(t *testing.T, d *Deps, m *Manifest, workSHA string) string {
+	t.Helper()
+	at := time.Date(2026, 8, 17, 9, 30, 0, 0, time.UTC)
+	body := verifyReport.render(at, "demo", workSHA, "bbb222^..HEAD", "", "criterion 2 unmet\n\n"+verifyProse,
+		reportFact{Field: "Verdict", Value: string(VerdictFixable)})
+	path, err := verifyReport.write(d, m.Dir, at, body)
+	if err != nil {
+		t.Fatalf("write verify report: %v", err)
+	}
+	return path
+}
+
+// TestVerifyPointerReachesTheHumanSurfaces drives every surface a human reads
+// with both reports on disk: the gate preamble and paging entry, the detail
+// view and the artifact list all point at the Verify report, ahead of the
+// Refine report, and none of them prints what it says.
+func TestVerifyPointerReachesTheHumanSurfaces(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	refinePath := seedRefineReport(t, d, m)
+	verifyPath := seedVerifyReport(t, d, m, "def456def456")
+
+	gate, action := hitlGateOutput(t, d, m, "5\n")
+	if action != hitlGateReadVerify {
+		t.Fatalf("expected the verify entry at key 5, got action %d", action)
+	}
+	if _, action := hitlGateOutput(t, d, m, "6\n"); action != hitlGateReadRefine {
+		t.Fatalf("expected the refine entry at key 6, got action %d", action)
+	}
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+
+	for _, s := range []struct {
+		surface string
+		text    string
+		wants   []string
+	}{
+		{"HITL gate", gate, []string{"🔎 Verify of def456def456 (bbb222^..HEAD), written 2026-08-17 09:30Z: " + verifyPath, "Read the verify report"}},
+		{"detail view", detail.String(), []string{"VERIFY REPORT", verifyPath, "def456def456 (bbb222^..HEAD)", "newest: verify"}},
+	} {
+		for _, want := range s.wants {
+			if !strings.Contains(s.text, want) {
+				t.Fatalf("%s missing %q:\n%s", s.surface, want, s.text)
+			}
+		}
+		if strings.Contains(s.text, verifyProse) {
+			t.Fatalf("%s inlined the verify report:\n%s", s.surface, s.text)
+		}
+	}
+	if strings.Index(gate, verifyPath) > strings.Index(gate, refinePath) {
+		t.Fatalf("the gate ranked the refine report above the verify report:\n%s", gate)
+	}
+
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil {
+		t.Fatalf("Artifacts: %v", err)
+	}
+	if len(artifacts) < 2 || artifacts[0].Path != verifyPath || artifacts[1].Path != refinePath {
+		t.Fatalf("expected the verify report above the refine report, got %+v", artifacts)
+	}
+}
+
+// TestVerifyPointerStaysOutOfAgentPrompts: an agent sent to fix the set already
+// has the findings in its task body, so no attended prompt names the report.
+func TestVerifyPointerStaysOutOfAgentPrompts(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	path := seedVerifyReport(t, d, m, "def456def456")
+
+	for name, prompt := range attendedPrompts(d, m) {
+		if strings.Contains(prompt, path) || strings.Contains(prompt, verifyProse) || strings.Contains(strings.ToLower(prompt), "verify report") {
+			t.Fatalf("%s carries the verify report:\n%s", name, prompt)
+		}
+	}
+}
+
+// TestNeverVerifiedSetShowsNoVerifyReport: a set with no Verify report renders
+// no preamble line, no menu entry and no detail section.
+func TestNeverVerifiedSetShowsNoVerifyReport(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	seedRefineReport(t, d, m)
+
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": detail.String()} {
+		if strings.Contains(strings.ToLower(text), "verify report") || strings.Contains(text, "🔎") {
+			t.Fatalf("%s mentions a verify report the set does not have:\n%s", surface, text)
+		}
+	}
+}
+
+// TestVerifyReportStalenessLeavesStatusAlone: a report written against a commit
+// the checkout has moved past answers why, never whether — the set's status
+// and its Verified-at badge read exactly as they did before it existed.
+func TestVerifyReportStalenessLeavesStatusAlone(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	row := &Row{ID: "demo", Status: StatusDone, Progress: "2/2", VerifyMark: VerifyMarkVerified}
+
+	header := func() string {
+		var detail bytes.Buffer
+		RenderTaskSetDetail(d, &detail, "demo", row, m)
+		return strings.SplitN(detail.String(), "\n", 2)[0]
+	}
+	before, badge := header(), DeriveVerifiedAtBadge(*row)
+	seedVerifyReport(t, d, m, "0ld0ld0ld0ld")
+	if after := header(); after != before {
+		t.Fatalf("a stale report moved the set's header: %q → %q", before, after)
+	}
+	if got := DeriveVerifiedAtBadge(*row); got != badge {
+		t.Fatalf("a stale report moved the badge: %+v → %+v", badge, got)
+	}
+}
