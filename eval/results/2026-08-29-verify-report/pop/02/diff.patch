+// only evidence a human has; an empty one falls back to the findings that say
+// so.
+func verifierReportBody(raw, findings string) string {
+	lines := strings.Split(strings.TrimSpace(raw), "\n")
+	for i, line := range lines {
+		value, ok := verdictLabelValue(line)
+		if !ok {
+			continue
+		}
+		if _, ok := canonicalVerdict(value); !ok {
+			break
+		}
+		body := strings.TrimSpace(strings.Join(append(append([]string{}, lines[:i]...), lines[i+1:]...), "\n"))
+		if body == "" {
+			return strings.TrimSpace(findings)
+		}
+		return body
+	}
+	if body := strings.TrimSpace(raw); body != "" {
+		return body
+	}
+	return strings.TrimSpace(findings)
+}
