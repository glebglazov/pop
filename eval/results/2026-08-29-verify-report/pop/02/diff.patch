+// verifyReportsOf reads every Verify report the set holds, oldest first.
+func verifyReportsOf(t *testing.T, defPath string) []string {
+	t.Helper()
+	paths, err := filepath.Glob(filepath.Join(defPath, "demo", ArtifactTypeVerify, "verify-*.md"))
+	if err != nil {
+		t.Fatalf("glob: %v", err)
+	}
+	var docs []string
+	for _, path := range paths {
+		body, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatalf("read %s: %v", path, err)
+		}
+		docs = append(docs, string(body))
+	}
+	return docs
+}
+
+func runVerifyReply(t *testing.T, d *Deps, defPath, reply string, gotPrompt *string) *VerifyResult {
+	t.Helper()
+	res, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{},
+		runVerifier: func(prompt string) (string, error) {
+			if gotPrompt != nil {
+				*gotPrompt = prompt
+			}
+			return reply, nil
+		},
+	})
+	if err != nil {
+		t.Fatalf("verifyResolvedSet: %v", err)
+	}
+	return res
+}
+
+// TestVerifierWritesReportOnEveryVerdict: each invocation leaves one report in
+// the set's own directory, whatever it decided — the verdict in the header, the
+// prose after the verdict line as the body, and no copy of the verdict line.
+func TestVerifierWritesReportOnEveryVerdict(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		verdict Verdict
+		reply   string
+		prose   string
+	}{
+		{VerdictPass, "VERDICT: PASS\nFINDINGS: criterion 1 met — TestA drives the whole path.\n", "criterion 1 met — TestA drives the whole path."},
+		{VerdictFixable, "VERDICT: FIXABLE\nSUMMARY: wire the flag\nFINDINGS: criterion 2 unmet: the flag is never read.\n", "criterion 2 unmet: the flag is never read."},
+		{VerdictNeedsHuman, "**VERDICT:** NEEDS-HUMAN\n\nFINDINGS: the spec contradicts itself on retries.\n", "the spec contradicts itself on retries."},
+	} {
+		t.Run(string(tc.verdict), func(t *testing.T) {
+			t.Parallel()
+			d, defPath := setupVerifyFixture(t, stubGit("abc123abc123\n", "", ""))
+			res := runVerifyReply(t, d, defPath, tc.reply, nil)
+			if res.Verdict != tc.verdict {
+				t.Fatalf("verdict = %q, want %q", res.Verdict, tc.verdict)
+			}
+			docs := verifyReportsOf(t, defPath)
+			if len(docs) != 1 {
+				t.Fatalf("reports = %d, want 1", len(docs))
+			}
+			doc := docs[0]
+			if got := reportHeaderField(doc, "Verdict"); got != string(tc.verdict) {
+				t.Fatalf("Verdict header = %q, want %q in:\n%s", got, tc.verdict, doc)
+			}
+			if got := reportHeaderField(doc, "Work SHA"); got != ShortSHA("abc123abc123") {
+				t.Fatalf("Work SHA header = %q in:\n%s", got, doc)
+			}
+			if !strings.HasPrefix(doc, "# Verify report — demo\n") || !strings.Contains(doc, tc.prose) {
+				t.Fatalf("report missing title or prose:\n%s", doc)
+			}
+			if strings.Contains(doc, "VERDICT") {
+				t.Fatalf("report kept the verdict line:\n%s", doc)
+			}
+		})
+	}
+}
+
+// TestVerifierReportKeepsUnparsableReply: a reply with no verdict still parks
+// NEEDS-HUMAN as before, and the report keeps the Verifier's raw words.
+func TestVerifierReportKeepsUnparsableReply(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	res := runVerifyReply(t, d, defPath, "the code looks alright\nmostly", nil)
+	if res.Verdict != VerdictNeedsHuman || !strings.Contains(res.Findings, "could not be parsed") {
+		t.Fatalf("result = %+v, want NEEDS-HUMAN with the unparsed explanation", res)
+	}
+	docs := verifyReportsOf(t, defPath)
+	if len(docs) != 1 || !strings.Contains(docs[0], "the code looks alright\nmostly") {
+		t.Fatalf("report lost the raw reply: %q", docs)
+	}
+
+	d, defPath = setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	runVerifyReply(t, d, defPath, "", nil)
+	docs = verifyReportsOf(t, defPath)
+	if len(docs) != 1 || !strings.Contains(docs[0], "produced no output") {
+		t.Fatalf("empty reply report = %q, want the no-output explanation", docs)
+	}
+}
+
+// TestVerifierReportsAccumulateAndOutliveTheCache: a verify-remediate-verify lap
+// leaves one report per invocation, the second Verifier is never shown the
+// first's prose, and invalidating the verdict cache deletes no report.
+func TestVerifierReportsAccumulateAndOutliveTheCache(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	runVerifyReply(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: the retry loop never backs off.\n", nil)
+	var second string
+	runVerifyReply(t, d, defPath, "VERDICT: PASS\nFINDINGS: the backoff doubles; TestRetry proves it.\n", &second)
+	if strings.Contains(second, "never backs off") {
+		t.Fatalf("Verifier prompt carried its previous report:\n%s", second)
+	}
+
+	s, err := openDrainStore(d)
+	if err != nil {
+		t.Fatalf("open store: %v", err)
+	}
+	if err := s.InvalidateVerifyVerdicts("/repo/.git", "demo"); err != nil {
+		t.Fatalf("invalidate: %v", err)
+	}
+	if v := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1"); v != nil {
+		t.Fatalf("verdict cache survived invalidation: %+v", v)
+	}
+	docs := verifyReportsOf(t, defPath)
+	if len(docs) != 2 || !strings.Contains(docs[0], "never backs off") || !strings.Contains(docs[1], "TestRetry proves it") {
+		t.Fatalf("reports after invalidation = %q, want both laps in order", docs)
+	}
+}
+
+// TestCachedVerdictWritesNoReport: the drain reading a verdict back from the
+// cache invokes no agent, so it leaves no report.
+func TestCachedVerdictWritesNoReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	seedVerdict(t, d, store.VerifyVerdict{Repo: "/repo/.git", SetID: "demo", WorkSHA: "sha1", Verdict: "FIXABLE", Findings: "cached"})
+	opts := verifyCoreOptions{Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		runVerifier: func(string) (string, error) { t.Fatal("cache hit must not invoke the Verifier"); return "", nil }}
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	if _, err := ensureVerifyVerdict(d, nil, opts, m, "sha1"); err != nil {
+		t.Fatalf("ensureVerifyVerdict: %v", err)
+	}
+	if docs := verifyReportsOf(t, defPath); len(docs) != 0 {
+		t.Fatalf("cache hit wrote reports: %q", docs)
+	}
+}
+
+// TestAcceptWritesHumanAuthoredReport: a human PASS over a Verifier's FIXABLE
+// files a report beside the Verifier's — same directory, stamp and header —
+// that carries the rationale, names the overridden verdict, says a human wrote
+// it, and is what the latest-report readers now return. No agent runs.
+func TestAcceptWritesHumanAuthoredReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	runVerifyReply(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: the retry loop never backs off.\n", nil)
+	opts := verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{}, Accept: true, AcceptNote: "the fixed delay is the upstream contract",
+		runVerifier: func(string) (string, error) { t.Fatal("accept must not invoke the Verifier"); return "", nil },
+	}
+	if _, err := verifyResolvedSet(d, nil, opts); err != nil {
+		t.Fatalf("accept: %v", err)
+	}
+
+	docs := verifyReportsOf(t, defPath)
+	if len(docs) != 2 {
+		t.Fatalf("reports = %d, want the Verifier's and the Accept's", len(docs))
+	}
+	verifier, accepted := docs[0], docs[1]
+	if !strings.HasPrefix(accepted, "# Verify report — demo\n") {
+		t.Fatalf("accept report title:\n%s", accepted)
+	}
+	for field, want := range map[string]string{
+		"Verdict":     "PASS",
+		"Overrode":    "FIXABLE",
+		"Accepted by": "human",
+		"Work SHA":    reportHeaderField(verifier, "Work SHA"),
+		"Verified":    reportHeaderField(accepted, "Verified"),
+	} {
+		if got := reportHeaderField(accepted, field); got != want || got == "" {
+			t.Fatalf("%s header = %q, want %q in:\n%s", field, got, want, accepted)
+		}
+	}
+	if !strings.Contains(accepted, "Human-authored") || !strings.Contains(accepted, "the fixed delay is the upstream contract") {
+		t.Fatalf("accept report missing authorship or rationale:\n%s", accepted)
+	}
+	if reportHeaderField(verifier, "Accepted by") != "" {
+		t.Fatalf("Verifier's report claims a human author:\n%s", verifier)
+	}
+
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	p, ok := verifyReport.latestPointer(d, m)
+	if !ok {
+		t.Fatal("no latest Verify report")
+	}
+	latest, err := os.ReadFile(p.Path)
+	if err != nil || string(latest) != accepted {
+		t.Fatalf("latest report = %q (%v), want the Accept's", latest, err)
+	}
+}
