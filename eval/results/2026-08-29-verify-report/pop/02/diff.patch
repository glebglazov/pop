diff --git a/tasks/report.go b/tasks/report.go
new file mode 100644
index 00000000..a0dd116c
--- /dev/null
+++ b/tasks/report.go
@@ -0,0 +1,310 @@
+package tasks
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// reportFileTimeLayout spells the instant in a report's name. The instant is in
+// the file name rather than only in the document, because "the latest" is
+// resolved by timestamp and a directory listing must be able to answer that
+// without opening every file.
+const reportFileTimeLayout = "20060102T150405Z"
+
+// passReport is the kind of report one pass publishes about a set: the prose
+// its agent wrote, under a header of facts, filed in the set's own directory
+// with the instant in its name. Every pass's reports share these mechanics and
+// differ only in the words below (ADR-0214, ADR-0245).
+type passReport struct {
+	// Type names the report family three times over: it is the Artifact type,
+	// the set's sub-directory the reports accumulate in, and the file-name
+	// prefix before the instant.
+	Type string
+	// Title opens the document, followed by the set ID.
+	Title string
+	// WrittenField and AuthorField label the header bullets for the instant
+	// the report was written and the agent that wrote it.
+	WrittenField string
+	AuthorField  string
+	// Label opens the pointer's one-line Summary.
+	Label string
+}
+
+// refineReport is the Refine pass's report. Its directory sits under the
+// Task-set directory, which lives in pop's Work store rather than in the
+// repository, so no report can ever be staged into a commit (ADR-0214).
+var refineReport = passReport{
+	Type:         ArtifactTypeRefine,
+	Title:        "Refine report",
+	WrittenField: "Refined",
+	AuthorField:  "Refiner",
+	Label:        "Refine",
+}
+
+// verifyReport is the Verifier's report: the prose that follows its verdict
+// line, one document per invocation, so a verify-remediate-verify lap leaves
+// every judgment behind rather than the last one. It outlives the verdict
+// cache on purpose — the cache is deleted on invalidation, the reports are the
+// record (ADR-0245).
+var verifyReport = passReport{
+	Type:         ArtifactTypeVerify,
+	Title:        "Verify report",
+	WrittenField: "Verified",
+	AuthorField:  "Verifier",
+	Label:        "Verify",
+}
+
+// publishedReports is every pass report a set can hold, for the readers that
+// list them all rather than asking one pass for its own.
+var publishedReports = []passReport{verifyReport, refineReport}
+
+// reportFact is one header bullet a pass stamps beyond the facts every report
+// carries, such as the verdict a Verify report justifies.
+type reportFact struct {
+	Field string
+	Value string
+}
+
+// reportDocument is one report on disk: where it is, when it was written, and
+// what it says.
+type reportDocument struct {
+	Path string
+	At   time.Time
+	Body string
+}
+
+func (r passReport) dir(setDir string) string {
+	return filepath.Join(setDir, r.Type)
+}
+
+func (r passReport) fileName(at time.Time) string {
+	return r.Type + "-" + at.Format(reportFileTimeLayout) + ".md"
+}
+
+// fileInstant reads a report's name back as the instant it was written, and
+// false for anything else in the directory. It is the only parser of the name,
+// so the Artifact listing orders by the same instant "latest" is resolved by.
+func (r passReport) fileInstant(name string) (time.Time, bool) {
+	stamp, ok := strings.CutPrefix(name, r.Type+"-")
+	if !ok {
+		return time.Time{}, false
+	}
+	stamp, ok = strings.CutSuffix(stamp, ".md")
+	if !ok {
+		return time.Time{}, false
+	}
+	at, err := time.Parse(reportFileTimeLayout, stamp)
+	if err != nil {
+		return time.Time{}, false
+	}
+	return at, true
+}
+
+// latest returns the set's current report — the one with the newest timestamp
+// in its name — and false when the pass has never written one. Every earlier
+// document stays where it is; superseding is a matter of which one the readers
+// take, not of deleting the ones before it (ADR-0214).
+func (r passReport) latest(d *Deps, setDir string) (reportDocument, bool) {
+	dir := r.dir(setDir)
+	entries, err := d.FS.ReadDir(dir)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	var found reportDocument
+	ok := false
+	for _, entry := range entries {
+		at, isReport := r.fileInstant(entry.Name())
+		if entry.IsDir() || !isReport {
+			continue
+		}
+		if ok && !at.After(found.At) {
+			continue
+		}
+		found, ok = reportDocument{Path: filepath.Join(dir, entry.Name()), At: at}, true
+	}
+	if !ok {
+		return reportDocument{}, false
+	}
+	body, err := d.FS.ReadFile(found.Path)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	found.Body = strings.TrimSpace(string(body))
+	return found, true
+}
+
+// write files a new report under the set's directory for this pass and returns
+// its path. A name already taken (two reports inside one second) advances the
+// instant rather than overwriting: retention is the whole point of the
+// directory, and the names are also the ordering.
+func (r passReport) write(d *Deps, setDir string, at time.Time, body string) (string, error) {
+	dir := r.dir(setDir)
+	if err := d.FS.MkdirAll(dir, 0o755); err != nil {
+		return "", exitErr(ExitOperational, "create %s directory: %v", r.Type, err)
+	}
+	at = at.UTC().Truncate(time.Second)
+	taken := map[string]bool{}
+	if entries, err := d.FS.ReadDir(dir); err == nil {
+		for _, entry := range entries {
+			taken[entry.Name()] = true
+		}
+	}
+	name := r.fileName(at)
+	for taken[name] {
+		at = at.Add(time.Second)
+		name = r.fileName(at)
+	}
+	path := filepath.Join(dir, name)
+	if err := d.FS.WriteFile(path, []byte(ensureTrailingNewline(body)), 0o644); err != nil {
+		return "", exitErr(ExitOperational, "write %s report: %v", r.Type, err)
+	}
+	return path, nil
+}
+
+// render wraps an agent's prose in the four facts a reader needs to know what
+// the report describes: which set, at which commits, by whom and when. They
+// ride the document rather than a side-car because the document leaves pop the
+// moment a human pipes it somewhere.
+//
+// The Work SHA line is the report's own answer to which tree it describes: a
+// reader who wants the state the report was written against checks out the SHA
+// and applies nothing else. It is stamped here rather than asked of the agent,
+// because pop read it before the pass began and the agent would only be copying
+// it back.
+func (r passReport) render(at time.Time, setID, workSHA, commitRange, agent, body string, facts ...reportFact) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "# %s — %s\n\n", r.Title, setID)
+	fmt.Fprintf(&b, "- %s: %s\n", r.WrittenField, at.UTC().Format(time.RFC3339))
+	if commitRange != "" {
+		fmt.Fprintf(&b, "- Commit range: %s\n", commitRange)
+	}
+	if workSHA != "" {
+		fmt.Fprintf(&b, "- Work SHA: %s\n", ShortSHA(workSHA))
+	}
+	if strings.TrimSpace(agent) != "" {
+		fmt.Fprintf(&b, "- %s: %s\n", r.AuthorField, strings.TrimSpace(agent))
+	}
+	for _, fact := range facts {
+		fmt.Fprintf(&b, "- %s: %s\n", fact.Field, fact.Value)
+	}
+	fmt.Fprintf(&b, "\n%s", ensureTrailingNewline(strings.TrimSpace(body)))
+	return b.String()
+}
+
+func ensureTrailingNewline(s string) string {
+	if strings.HasSuffix(s, "\n") {
+		return s
+	}
+	return s + "\n"
+}
+
+// reportHeaderField reads one of the "- Field: value" facts render stamps at the
+// top of every report. The header is the document's own record of what it
+// describes, so reading it back beats keeping a side-car that a document copied
+// out of pop would leave behind.
+func reportHeaderField(body, field string) string {
+	prefix := "- " + field + ": "
+	inHeader := false
+	for _, line := range strings.Split(body, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "- ") {
+			// The header is the report's first bullet list; anything after it is
+			// the agent's prose, which may say anything at all.
+			if inHeader {
+				return ""
+			}
+			continue
+		}
+		inHeader = true
+		if rest, ok := strings.CutPrefix(line, prefix); ok {
+			return strings.TrimSpace(rest)
+		}
+	}
+	return ""
+}
+
+// ReportPointer is a set's current report as the surfaces that point at it
+// carry it: where the document is and which commit it was written against,
+// never what it says (ADR-0240, narrowed by ADR-0217).
+type ReportPointer struct {
+	// Label names the pass that wrote the report, as the Summary opens with it.
+	Label string
+	// Path is the absolute path of the latest report.
+	Path string
+	// WorkSHA is the short work SHA the report was written against, empty when
+	// the document records none.
+	WorkSHA string
+	// CommitRange is the range the agent read, empty when the document records
+	// none.
+	CommitRange string
+	// Written is the instant in the report's name, in UTC to the minute.
+	Written string
+}
+
+// latestPointer resolves the pointer to the pass's current report for a set,
+// and false when the pass has never written one.
+func (r passReport) latestPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ReportPointer{}, false
+	}
+	doc, ok := r.latest(d, m.Dir)
+	if !ok {
+		return ReportPointer{}, false
+	}
+	return ReportPointer{
+		Label:       r.Label,
+		Path:        doc.Path,
+		WorkSHA:     reportHeaderField(doc.Body, "Work SHA"),
+		CommitRange: reportHeaderField(doc.Body, "Commit range"),
+		Written:     doc.At.UTC().Format("2006-01-02 15:04Z"),
+	}, true
+}
+
+// CommitPhrase names the commit the document was written against, in the one
+// form every surface prints it. Empty when the report recorded neither a work
+// SHA nor a range — an old or hand-edited document still shows its path.
+func (p ReportPointer) CommitPhrase() string {
+	switch {
+	case p.WorkSHA != "" && p.CommitRange != "":
+		return fmt.Sprintf("%s (%s)", p.WorkSHA, p.CommitRange)
+	case p.WorkSHA != "":
+		return p.WorkSHA
+	default:
+		return p.CommitRange
+	}
+}
+
+// Summary is the single line the gate preamble and the detail view print:
+// which pass, the commit it described, when, and where to read it.
+func (p ReportPointer) Summary() string {
+	var b strings.Builder
+	b.WriteString(p.Label)
+	if phrase := p.CommitPhrase(); phrase != "" {
+		fmt.Fprintf(&b, " of %s", phrase)
+	}
+	if p.Written != "" {
+		fmt.Fprintf(&b, ", written %s", p.Written)
+	}
+	fmt.Fprintf(&b, ": %s", p.Path)
+	return b.String()
+}
+
+// StaleAgainst reports whether the checkout has moved past the commit this
+// report was written against. Unknown on either side is not staleness: a
+// document recording no work SHA, or a checkout whose HEAD pop cannot read, says
+// nothing about whether the report still describes today's files.
+func (p ReportPointer) StaleAgainst(workSHA string) bool {
+	written, current := p.WorkSHA, ShortSHA(workSHA)
+	if written == "" || current == "" {
+		return false
+	}
+	// Either side may be the shorter abbreviation — a hand-edited header, or a
+	// document written when the shortening differed — so a common prefix counts
+	// as the same commit.
+	return !strings.HasPrefix(current, written) && !strings.HasPrefix(written, current)
+}
