+// body is the human's rationale — so a reader puzzled by a green set over red
+// findings finds the answer under the same "latest report" as any other.
+func writeAcceptedVerifyReport(d *Deps, m *Manifest, setID, workSHA, commitRange string, overridden *store.VerifyVerdict, note string) error {
+	overrode := "none recorded at this work SHA"
+	if overridden != nil {
+		overrode = overridden.Verdict
+		if overridden.HumanAuthored {
+			overrode += " (human-authored)"
+		}
+	}
+	rationale := note
+	if rationale == "" {
+		rationale = "(The human gave no rationale.)"
+	}
+	body := fmt.Sprintf("Human-authored: a human accepted this set as PASS over the Verifier's judgment. No Verifier ran for this report.\n\n## Rationale\n\n%s", rationale)
