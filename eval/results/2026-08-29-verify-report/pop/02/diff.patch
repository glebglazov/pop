+	doc := verifyReport.render(at, setID, workSHA, commitRange, "", body,
+		reportFact{Field: "Verdict", Value: string(VerdictPass)},
+		reportFact{Field: "Overrode", Value: overrode},
+		reportFact{Field: "Accepted by", Value: "human"},
+	)
+	_, err := verifyReport.write(d, m.Dir, at, doc)
+	return err
