--- /dev/null
+++ b/tasks/report.go
@@ -0,0 +1,277 @@
+package tasks
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// reportFileTimeLayout spells the instant in a report's file name. The instant
+// is in the name rather than only in the document, because "the latest" is
+// resolved by timestamp and a directory listing must be able to answer that
+// without opening every file.
+const reportFileTimeLayout = "20060102T150405Z"
+
+// reportPass names the pass that writes a report and everything that differs
+// between one pass's reports and another's: where they are filed, what they are
+// called, and how their header labels its facts. The mechanics — rendering,
+// filing, picking the latest and reading the header back — are the same for
+// every pass, so they take the pass as a parameter rather than belonging to one.
+type reportPass struct {
+	// Name is the pass as a human reads it: the report's title, and the word a
+	// pointer's summary line opens with.
+	Name string
+	// Dir is the sub-directory of a set's folder where the pass's reports
+	// accumulate. It sits under the Task-set directory, which lives in pop's
+	// Work store rather than in the repository, so no report can ever be staged
+	// into a commit (ADR-0214). It doubles as the file-name prefix.
+	Dir string
+	// WrittenField and AgentField label the header facts for when the report
+	// was written and which agent wrote it.
+	WrittenField string
+	AgentField   string
+}
+
+// reportDocument is one report on disk: where it is, when it was written, and
+// what it says.
+type reportDocument struct {
+	Path string
+	At   time.Time
+	Body string
+}
+
+func (p reportPass) fileName(at time.Time) string {
+	return p.Dir + "-" + at.Format(reportFileTimeLayout) + ".md"
+}
+
+// fileInstant reads a report's name back as the instant it was written, and
+// false for anything else in the directory.
+func (p reportPass) fileInstant(name string) (time.Time, bool) {
+	stamp, ok := strings.CutPrefix(name, p.Dir+"-")
+	if !ok {
+		return time.Time{}, false
+	}
+	stamp, ok = strings.CutSuffix(stamp, ".md")
+	if !ok {
+		return time.Time{}, false
+	}
+	at, err := time.Parse(reportFileTimeLayout, stamp)
+	if err != nil {
+		return time.Time{}, false
+	}
+	return at, true
+}
+
+// latestReport returns the set's current report for the pass — the one with
+// the newest timestamp in its name — and false when the pass has never written
+// one. Every earlier document stays where it is; superseding is a matter of
+// which one the readers take, not of deleting the ones before it (ADR-0214).
+func latestReport(d *Deps, setDir string, pass reportPass) (reportDocument, bool) {
+	dir := filepath.Join(setDir, pass.Dir)
+	entries, err := d.FS.ReadDir(dir)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	var found reportDocument
+	ok := false
+	for _, entry := range entries {
+		at, isReport := pass.fileInstant(entry.Name())
+		if entry.IsDir() || !isReport {
+			continue
+		}
+		if ok && !at.After(found.At) {
+			continue
+		}
+		found, ok = reportDocument{Path: filepath.Join(dir, entry.Name()), At: at}, true
+	}
+	if !ok {
+		return reportDocument{}, false
+	}
+	body, err := d.FS.ReadFile(found.Path)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	found.Body = strings.TrimSpace(string(body))
+	return found, true
+}
+
+// writeReport files a new report under the pass's directory in the set and
+// returns its path. A name already taken (two reports inside one second)
+// advances the instant rather than overwriting: retention is the whole point of
+// the directory, and the names are also the ordering.
+func writeReport(d *Deps, setDir string, pass reportPass, at time.Time, body string) (string, error) {
+	dir := filepath.Join(setDir, pass.Dir)
+	if err := d.FS.MkdirAll(dir, 0o755); err != nil {
+		return "", exitErr(ExitOperational, "create %s directory: %v", pass.Dir, err)
+	}
+	at = at.UTC().Truncate(time.Second)
+	taken := map[string]bool{}
+	if entries, err := d.FS.ReadDir(dir); err == nil {
+		for _, entry := range entries {
+			taken[entry.Name()] = true
+		}
+	}
+	name := pass.fileName(at)
+	for taken[name] {
+		at = at.Add(time.Second)
+		name = pass.fileName(at)
+	}
+	path := filepath.Join(dir, name)
+	if err := d.FS.WriteFile(path, []byte(ensureTrailingNewline(body)), 0o644); err != nil {
+		return "", exitErr(ExitOperational, "write %s report: %v", pass.Dir, err)
+	}
+	return path, nil
+}
+
+// reportFact is one "- Label: value" line a pass adds to the header beyond the
+// facts every report carries.
+type reportFact struct {
+	Label string
+	Value string
+}
+
+// renderReport wraps an agent's prose in the four facts a reader needs to know
+// what the report describes: which set, at which commits, by whom and when.
+// A pass whose report needs more facts than these — the verdict a Verify report
+// justifies — passes them after the body, and they close the header in order.
+// They ride the document rather than a side-car because the document leaves pop
+// the moment a human pipes it somewhere.
+//
+// The Work SHA line is the report's own answer to which tree it describes. It
+// is stamped here rather than asked of the agent, because pop read it before
+// the pass began and the agent would only be copying it back.
+func renderReport(pass reportPass, at time.Time, setID, workSHA, commitRange, agent, body string, facts ...reportFact) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "# %s report — %s\n\n", pass.Name, setID)
+	fmt.Fprintf(&b, "- %s: %s\n", pass.WrittenField, at.UTC().Format(time.RFC3339))
+	if commitRange != "" {
+		fmt.Fprintf(&b, "- Commit range: %s\n", commitRange)
+	}
+	if workSHA != "" {
+		fmt.Fprintf(&b, "- Work SHA: %s\n", ShortSHA(workSHA))
+	}
+	if strings.TrimSpace(agent) != "" {
+		fmt.Fprintf(&b, "- %s: %s\n", pass.AgentField, strings.TrimSpace(agent))
+	}
+	for _, fact := range facts {
+		if strings.TrimSpace(fact.Value) != "" {
+			fmt.Fprintf(&b, "- %s: %s\n", fact.Label, strings.TrimSpace(fact.Value))
+		}
+	}
+	fmt.Fprintf(&b, "\n%s", ensureTrailingNewline(strings.TrimSpace(body)))
+	return b.String()
+}
+
+func ensureTrailingNewline(s string) string {
+	if strings.HasSuffix(s, "\n") {
+		return s
+	}
+	return s + "\n"
+}
+
+// reportHeaderField reads one of the "- Field: value" facts renderReport stamps
+// at the top of every report. The header is the document's own record of what
+// it describes, so reading it back beats keeping a side-car that a document
+// copied out of pop would leave behind.
+func reportHeaderField(body, field string) string {
+	prefix := "- " + field + ": "
+	inHeader := false
+	for _, line := range strings.Split(body, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "- ") {
+			// The header is the report's first bullet list; anything after it is
+			// the agent's prose, which may say anything at all.
+			if inHeader {
+				return ""
+			}
+			continue
+		}
+		inHeader = true
+		if rest, ok := strings.CutPrefix(line, prefix); ok {
+			return strings.TrimSpace(rest)
+		}
+	}
+	return ""
+}
+
+// ReportPointer is a set's current report as the surfaces carry it: where the
+// document is and which commit it was written against, never what it says
+// (ADR-0240, narrowed by ADR-0217).
+type ReportPointer struct {
+	pass reportPass
+	// Path is the absolute path of the latest report.
+	Path string
+	// WorkSHA is the short work SHA the report was written against, empty when
+	// the document records none.
+	WorkSHA string
+	// CommitRange is the range the agent read, empty when the document records
+	// none.
+	CommitRange string
+	// Written is the instant in the report's name, in UTC to the minute
+	// ("2006-01-02 15:04Z").
+	Written string
+}
+
+// latestReportPointer resolves the pointer to a set's latest report for the
+// pass, and false when the pass has never written one.
+func latestReportPointer(d *Deps, m *Manifest, pass reportPass) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ReportPointer{}, false
+	}
+	doc, ok := latestReport(d, m.Dir, pass)
+	if !ok {
+		return ReportPointer{}, false
+	}
+	p := ReportPointer{pass: pass, Path: doc.Path, Written: doc.At.UTC().Format("2006-01-02 15:04Z")}
+	p.WorkSHA = reportHeaderField(doc.Body, "Work SHA")
+	p.CommitRange = reportHeaderField(doc.Body, "Commit range")
+	return p, true
+}
+
+// CommitPhrase names the commit the document was written against, in the one
+// form every surface prints it. Empty when the report recorded neither a work
+// SHA nor a range — an old or hand-edited document still shows its path.
+func (p ReportPointer) CommitPhrase() string {
+	switch {
+	case p.WorkSHA != "" && p.CommitRange != "":
+		return fmt.Sprintf("%s (%s)", p.WorkSHA, p.CommitRange)
+	case p.WorkSHA != "":
+		return p.WorkSHA
+	default:
+		return p.CommitRange
+	}
+}
+
+// Summary is the single line a gate preamble uses: which pass, the commit it
+// described, when, and where to read it.
+func (p ReportPointer) Summary() string {
+	var b strings.Builder
+	b.WriteString(p.pass.Name)
+	if phrase := p.CommitPhrase(); phrase != "" {
+		fmt.Fprintf(&b, " of %s", phrase)
+	}
+	if p.Written != "" {
+		fmt.Fprintf(&b, ", written %s", p.Written)
+	}
+	fmt.Fprintf(&b, ": %s", p.Path)
+	return b.String()
+}
+
+// StaleAgainst reports whether the checkout has moved past the commit this
+// report was written against. Unknown on either side is not staleness: a
+// document recording no work SHA, or a checkout whose HEAD pop cannot read, says
+// nothing about whether the report still describes today's files.
+func (p ReportPointer) StaleAgainst(workSHA string) bool {
+	written, current := p.WorkSHA, ShortSHA(workSHA)
+	if written == "" || current == "" {
+		return false
+	}
+	// Either side may be the shorter abbreviation — a hand-edited header, or a
+	// document written when the shortening differed — so a common prefix counts
+	// as the same commit.
+	return !strings.HasPrefix(current, written) && !strings.HasPrefix(written, current)
+}
