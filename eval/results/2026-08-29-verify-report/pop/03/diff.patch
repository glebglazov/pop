+package tasks
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// verifyPass is verification as a report writer: its reports are Verify
+// reports, filed under the set's verify/ directory and stamped "Verified" and
+// "Verifier" (ADR-0245).
+//
+// The directory is a log, not the verdict cache. verify_verdicts is keyed by
+// work SHA and deleted on Verification invalidation; nothing ever deletes a
+// report, so a verify-remediate-verify lap leaves every lap's reasoning behind.
+// No Verifier prompt reads this directory: the verdict gates a drain, and a
+// judge handed its own earlier judgment anchors the enum.
+var verifyPass = reportPass{
+	Name:         "Verify",
+	Dir:          VerifyDirName,
+	WrittenField: "Verified",
+	AgentField:   "Verifier",
+}
+
+// splitVerifierReply returns the Verify report the Verifier wrote after its
+// verdict line. The `VERDICT:` line comes first so the agent commits to the
+// enum before it begins justifying it; that line is pop's channel, so it is
+// lifted off and the prose that remains is the document a human reads.
+//
+// It finds the verdict line the way ParseVerdict does. A reply ParseVerdict
+// cannot read — empty, with no verdict line, or naming no known verdict — is
+// filed as the same text the findings carry for it, which keeps the raw reply
+// whole: the report of a run that could not be understood is the reply itself.
+func splitVerifierReply(raw string) string {
+	lines := strings.Split(strings.TrimSpace(raw), "\n")
+	for i, line := range lines {
+		value, ok := verdictLabelValue(line)
+		if !ok {
+			continue
+		}
+		if _, ok := canonicalVerdict(value); !ok {
+			break
+		}
+		return strings.TrimSpace(strings.Join(append(append([]string{}, lines[:i]...), lines[i+1:]...), "\n"))
+	}
+	return unparsedFindings(raw)
+}
+
+// writeVerifyReport files one Verifier invocation's reply as a Verify report
+// and returns its path. Only a real invocation reaches it: a cached verdict was
+// already reported by the run that produced it, and a verdict pop stores
+// without asking an agent has no reply to file.
+func writeVerifyReport(d *Deps, m *Manifest, setID, workSHA, commitRange, agent string, verdict Verdict, raw string) (string, error) {
+	at := d.Now().UTC()
+	doc := renderReport(verifyPass, at, setID, workSHA, commitRange, agent, splitVerifierReply(raw),
+		reportFact{Label: "Verdict", Value: string(verdict)})
+	return writeReport(d, m.Dir, verifyPass, at, doc)
+}
+
+// acceptedReportAuthor is the "Authored by" fact of a report a human's Accept
+// left: the line that tells it apart from a Verifier's at a glance.
+const acceptedReportAuthor = "human (Accept, no Verifier ran)"
+
+// writeAcceptedVerifyReport files the Verify report of an Accept (ADR-0103) and
+// returns its path. No agent ran, so pop renders the document itself: the
+// human's note, and the verdict recorded at the work SHA that the PASS
+// overrides, if any. It files under the same directory and header as a
+// Verifier's report, so the readers of the latest report take it the same way.
+func writeAcceptedVerifyReport(d *Deps, m *Manifest, setID, workSHA, note string, overridden *store.VerifyVerdict) (string, error) {
+	at := d.Now().UTC()
+	overrode := ""
+	if overridden != nil {
+		overrode = overridden.Verdict
+	}
+	var body strings.Builder
+	body.WriteString("## Accepted by a human\n\n")
+	if overrode != "" {
+		fmt.Fprintf(&body, "No Verifier ran. A human recorded this PASS over the %s verdict recorded at this work SHA.\n\n", overrode)
+	} else {
+		body.WriteString("No Verifier ran. A human recorded this PASS; no verdict was recorded at this work SHA to override.\n\n")
+	}
+	body.WriteString("## Human note\n\n")
+	if strings.TrimSpace(note) != "" {
+		body.WriteString(strings.TrimSpace(note))
+	} else {
+		body.WriteString("(none given)")
+	}
+	doc := renderReport(verifyPass, at, setID, workSHA, "", "", body.String(),
+		reportFact{Label: "Verdict", Value: string(VerdictPass)},
+		reportFact{Label: "Overrode", Value: overrode},
+		reportFact{Label: "Authored by", Value: acceptedReportAuthor})
+	return writeReport(d, m.Dir, verifyPass, at, doc)
+}
diff --git a/tasks/verify_report_surfaces_test.go b/tasks/verify_report_surfaces_test.go
new file mode 100644
index 00000000..08b4a1f8
--- /dev/null
+++ b/tasks/verify_report_surfaces_test.go
@@ -0,0 +1,132 @@
+package tasks
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"time"
+)
+
+// verifyProse is the Verify report's body, which no surface may print: each
+// carries a pointer to the document and nothing else (ADR-0245).
+const verifyProse = "SECRET-VERIFY-PROSE"
+
+// seedVerifyReport files one Verify report for the fixture set, written against
+// a commit the checkout (HEAD sha1) has since moved past, and returns its path.
+func seedVerifyReport(t *testing.T, d *Deps, m *Manifest) string {
+	t.Helper()
+	at := time.Date(2026, 8, 17, 9, 30, 0, 0, time.UTC)
+	body := renderReport(verifyPass, at, "demo", "fee456fee456", "bbb222^..HEAD", "claude", "## Findings\n\n"+verifyProse,
+		reportFact{Label: "Verdict", Value: "FIXABLE"})
+	path, err := writeReport(d, m.Dir, verifyPass, at, body)
+	if err != nil {
+		t.Fatalf("writeReport: %v", err)
+	}
+	return path
+}
+
+// TestVerifyReportReachesTheHumanSurfaces drives every surface a human reads the
+// Verify report from: the gate preamble and its paging entry, the detail view and
+// the artifact list, where it ranks above the Refine report.
+func TestVerifyReportReachesTheHumanSurfaces(t *testing.T) {
+	d, m := hitlFixture(t)
+	refinePath := seedRefineReport(t, d, m)
+	path := seedVerifyReport(t, d, m)
+
+	// Re-verify is not offered, so the verify entry takes key 5 and refine key 6.
+	gate, action := hitlGateOutput(t, d, m, "5\n")
+	if action != hitlGateReadVerify {
+		t.Fatalf("expected the verify entry at key 5, got action %d", action)
+	}
+	if _, action := hitlGateOutput(t, d, m, "6\n"); action != hitlGateReadRefine {
+		t.Fatalf("expected the refine entry at key 6, got action %d", action)
+	}
+
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+
+	for _, s := range []struct {
+		surface string
+		text    string
+		wants   []string
+	}{
+		{"HITL gate", gate, []string{"🔎 Verify of fee456fee456 (bbb222^..HEAD), written 2026-08-17 09:30Z: " + path, "Read the verify report"}},
+		{"detail view", detail.String(), []string{"VERIFY REPORT", path, "fee456fee456"}},
+	} {
+		for _, want := range s.wants {
+			if !strings.Contains(s.text, want) {
+				t.Fatalf("%s missing %q:\n%s", s.surface, want, s.text)
+			}
+		}
+		if strings.Contains(s.text, verifyProse) {
+			t.Fatalf("%s inlined the verify report:\n%s", s.surface, s.text)
+		}
+	}
+	if strings.Index(gate, path) > strings.Index(gate, refinePath) {
+		t.Fatalf("gate points at the refine report before the verify report:\n%s", gate)
+	}
+
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil {
+		t.Fatalf("Artifacts: %v", err)
+	}
+	if len(artifacts) < 2 || artifacts[0].Type != ArtifactTypeVerify || artifacts[0].Path != path || artifacts[1].Type != ArtifactTypeRefine {
+		t.Fatalf("expected the verify report first, then the refine report: %+v", artifacts)
+	}
+
+	runner := &fakeAttendedRunner{}
+	d.Runner = runner
+	t.Setenv("PAGER", "mypager")
+	pageReportDocument(d, strings.NewReader(""), "/rt", &bytes.Buffer{}, latestGateReports(d, m).verify)
+	if runner.attendedCalls != 1 || runner.name != "mypager" || strings.Join(runner.args, " ") != path {
+		t.Fatalf("expected one pager launch over the document, got %d: %s %v", runner.attendedCalls, runner.name, runner.args)
+	}
+}
+
+// TestVerifyReportStaysOutOfAgentPrompts: an agent sent to fix the set already
+// has the findings in its task body, so no prompt an agent reads points at the
+// report.
+func TestVerifyReportStaysOutOfAgentPrompts(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	path := seedVerifyReport(t, d, m)
+
+	for surface, text := range attendedPrompts(d, m) {
+		if strings.Contains(text, path) || strings.Contains(text, verifyProse) || strings.Contains(strings.ToLower(text), "verify report") {
+			t.Fatalf("%s carries the verify report:\n%s", surface, text)
+		}
+	}
+}
+
+// TestVerifyReportAnswersWhyNeverWhether: a set never verified shows no trace of
+// a report, and a report older than HEAD neither moves the set's status line nor
+// calls itself out of date — staleness stays the Verified-at badge's question.
+func TestVerifyReportAnswersWhyNeverWhether(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	row := &Row{ID: "demo", Status: StatusAwaitingApproval, Progress: "1/2"}
+
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	var before bytes.Buffer
+	RenderTaskSetDetail(d, &before, "demo", row, m)
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": before.String()} {
+		if strings.Contains(strings.ToLower(text), "verify report") {
+			t.Fatalf("%s mentions a verify report the set does not have:\n%s", surface, text)
+		}
+	}
+
+	seedVerifyReport(t, d, m)
+	var after bytes.Buffer
+	RenderTaskSetDetail(d, &after, "demo", row, m)
+	if firstLine(after.String()) != firstLine(before.String()) {
+		t.Fatalf("the report moved the set's status line:\nbefore %q\nafter  %q", firstLine(before.String()), firstLine(after.String()))
+	}
+	if strings.Contains(strings.ToLower(after.String()), "out of date") {
+		t.Fatalf("the detail view judged the report stale:\n%s", after.String())
+	}
+}
+
+func firstLine(s string) string {
+	line, _, _ := strings.Cut(s, "\n")
+	return line
+}
diff --git a/tasks/verify_report_test.go b/tasks/verify_report_test.go
new file mode 100644
index 00000000..da8ef561
--- /dev/null
+++ b/tasks/verify_report_test.go
@@ -0,0 +1,275 @@
+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// verifyReports returns the bodies of the set's Verify reports, oldest first.
+func verifyReports(t *testing.T, defPath string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(filepath.Join(defPath, "demo", VerifyDirName))
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		t.Fatalf("read verify dir: %v", err)
+	}
+	var bodies []string
+	for _, entry := range entries {
+		if _, ok := verifyPass.fileInstant(entry.Name()); !ok {
+			t.Fatalf("unexpected file in verify dir: %s", entry.Name())
+		}
+		body, err := os.ReadFile(filepath.Join(defPath, "demo", VerifyDirName, entry.Name()))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		bodies = append(bodies, string(body))
+	}
+	return bodies
+}
+
+func runVerifyWithReply(t *testing.T, d *Deps, defPath, reply string, prompts *[]string) *VerifyResult {
+	t.Helper()
+	res, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{},
+		runVerifier: func(prompt string) (string, error) {
+			if prompts != nil {
+				*prompts = append(*prompts, prompt)
+			}
+			return reply, nil
+		},
+	})
+	if err != nil {
+		t.Fatalf("verifyResolvedSet: %v", err)
+	}
+	return res
+}
+
+// TestVerifierInvocationFilesItsReplyAsAReport: every verdict — PASS included —
+// leaves the Verifier's reasoning on disk, with the verdict line lifted into the
+// header and the prose after it as the body. A reply pop cannot read keeps its
+// raw text and still parks the set on NEEDS-HUMAN (ADR-0245).
+func TestVerifierInvocationFilesItsReplyAsAReport(t *testing.T) {
+	t.Parallel()
+	cases := []struct {
+		name    string
+		reply   string
+		verdict Verdict
+		want    []string
+	}{
+		{
+			name:    "pass states what was checked",
+			reply:   "VERDICT: PASS\nFINDINGS: checked 01-a's criterion against verify.go; it is met because the parser runs first.",
+			verdict: VerdictPass,
+			want:    []string{"FINDINGS: checked 01-a's criterion against verify.go; it is met because the parser runs first."},
+		},
+		{
+			name:    "fixable",
+			reply:   "**VERDICT: FIXABLE**\nSUMMARY: wire the flag\nFINDINGS: the flag is never read.",
+			verdict: VerdictFixable,
+			want:    []string{"SUMMARY: wire the flag", "FINDINGS: the flag is never read."},
+		},
+		{
+			name:    "needs human",
+			reply:   "VERDICT: NEEDS-HUMAN\nFINDINGS: the spec contradicts itself.",
+			verdict: VerdictNeedsHuman,
+			want:    []string{"FINDINGS: the spec contradicts itself."},
+		},
+		{
+			name:    "malformed keeps the raw reply",
+			reply:   "I looked around and it seems fine to me.",
+			verdict: VerdictNeedsHuman,
+			want:    []string{"could not be parsed", "I looked around and it seems fine to me."},
+		},
+		{
+			name:    "absent reply",
+			reply:   "",
+			verdict: VerdictNeedsHuman,
+			want:    []string{"The Verifier produced no output"},
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			d, defPath := setupVerifyFixture(t, stubGit("abc123abc123ffff\n", "", ""))
+			res := runVerifyWithReply(t, d, defPath, tc.reply, nil)
+			if res.Verdict != tc.verdict {
+				t.Fatalf("verdict = %s, want %s", res.Verdict, tc.verdict)
+			}
+			reports := verifyReports(t, defPath)
+			if len(reports) != 1 {
+				t.Fatalf("reports = %d, want 1", len(reports))
+			}
+			doc := reports[0]
+			if got := reportHeaderField(doc, "Verdict"); got != string(tc.verdict) {
+				t.Fatalf("header Verdict = %q, want %q\n%s", got, tc.verdict, doc)
+			}
+			if got := reportHeaderField(doc, "Work SHA"); got != "abc123abc123" {
+				t.Fatalf("header Work SHA = %q\n%s", got, doc)
+			}
+			if !strings.HasPrefix(doc, "# Verify report — demo\n") {
+				t.Fatalf("report title:\n%s", doc)
+			}
+			for _, want := range tc.want {
+				if !strings.Contains(doc, want) {
+					t.Fatalf("report missing %q:\n%s", want, doc)
+				}
+			}
+			if tc.verdict == VerdictPass || tc.verdict == VerdictFixable {
+				if strings.Contains(doc, "VERDICT") {
+					t.Fatalf("verdict line was not lifted off the body:\n%s", doc)
+				}
+			}
+		})
+	}
+}
+
+// TestVerifyLapLeavesEveryReportAndNoneReachesTheVerifier: each invocation is
+// its own document, so a re-verify adds to the trail rather than rewriting it,
+// and the next Verifier is never shown what the last one wrote.
+func TestVerifyLapLeavesEveryReportAndNoneReachesTheVerifier(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	var prompts []string
+	runVerifyWithReply(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: first-lap-marker is missing.", &prompts)
+	runVerifyWithReply(t, d, defPath, "VERDICT: PASS\nFINDINGS: second-lap-marker checked.", &prompts)
+
+	reports := verifyReports(t, defPath)
+	if len(reports) != 2 {
+		t.Fatalf("reports = %d, want 2", len(reports))
+	}
+	if !strings.Contains(reports[0], "first-lap-marker") || !strings.Contains(reports[1], "second-lap-marker") {
+		t.Fatalf("lap trail out of order:\n%s\n---\n%s", reports[0], reports[1])
+	}
+	for _, leaked := range []string{"first-lap-marker", "# Verify report —", filepath.Join("demo", VerifyDirName)} {
+		if strings.Contains(prompts[1], leaked) {
+			t.Fatalf("second Verifier prompt carries the previous report (%q)", leaked)
+		}
+	}
+}
+
+// TestCachedVerdictWritesNoVerifyReport: a verdict read back from the cache
+// invokes no agent, so it files nothing.
+func TestCachedVerdictWritesNoVerifyReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	seedVerdict(t, d, store.VerifyVerdict{Repo: "/repo/.git", SetID: "demo", WorkSHA: "sha1", Verdict: "PASS"})
+	opts := verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		runVerifier: func(string) (string, error) { t.Fatal("cache hit must not invoke the Verifier"); return "", nil },
+	}
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	if _, err := ensureVerifyVerdict(d, nil, opts, m, "sha1"); err != nil {
+		t.Fatalf("ensureVerifyVerdict: %v", err)
+	}
+	if reports := verifyReports(t, defPath); len(reports) != 0 {
+		t.Fatalf("cache hit wrote %d reports", len(reports))
+	}
+}
+
+// TestVerifyReportsSurviveInvalidation: invalidation empties the verdict cache
+// and leaves the reports, which are the durable record the cache never was.
+func TestVerifyReportsSurviveInvalidation(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	runVerifyWithReply(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: the flag is never read.", nil)
+
+	invalidateVerifyVerdicts(d, "/repo/.git", "demo")
+
+	if v := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1"); v != nil {
+		t.Fatalf("verdict survived invalidation: %+v", v)
+	}
+	reports := verifyReports(t, defPath)
+	if len(reports) != 1 || !strings.Contains(reports[0], "the flag is never read.") {
+		t.Fatalf("report did not survive invalidation: %v", reports)
+	}
+}
+
+// TestAcceptFilesAHumanAuthoredVerifyReport: a human PASS over a non-PASS
+// judgment leaves a report of its own, beside the Verifier's, carrying the note
+// and the verdict it overrode. No agent runs, and the latest-report pointer
+// takes it like any other (ADR-0245).
+func TestAcceptFilesAHumanAuthoredVerifyReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("abc123abc123ffff\n", "", ""))
+	runVerifyWithReply(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: the retry is unbounded.", nil)
+
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{}, Accept: true, AcceptNote: "the unbounded retry is the documented contract",
+		runVerifier: func(string) (string, error) { t.Fatal("accept must not invoke the Verifier"); return "", nil },
+	}); err != nil {
+		t.Fatalf("accept: %v", err)
+	}
+
+	reports := verifyReports(t, defPath)
+	if len(reports) != 2 {
+		t.Fatalf("reports = %d, want the Verifier's and the Accept's", len(reports))
+	}
+	verifier, accepted := reports[0], reports[1]
+	for field, want := range map[string]string{
+		"Verdict":     "PASS",
+		"Overrode":    "FIXABLE",
+		"Authored by": acceptedReportAuthor,
+		"Work SHA":    "abc123abc123",
+	} {
+		if got := reportHeaderField(accepted, field); got != want {
+			t.Fatalf("accepted header %s = %q, want %q\n%s", field, got, want, accepted)
+		}
+	}
+	if reportHeaderField(accepted, "Verified") == "" || reportHeaderField(accepted, "Verifier") != "" {
+		t.Fatalf("accepted header names a Verifier or no instant:\n%s", accepted)
+	}
+	if !strings.HasPrefix(accepted, "# Verify report — demo\n") || !strings.Contains(accepted, "the unbounded retry is the documented contract") {
+		t.Fatalf("accepted report:\n%s", accepted)
+	}
+	if reportHeaderField(verifier, "Authored by") != "" {
+		t.Fatalf("Verifier report reads as human-authored:\n%s", verifier)
+	}
+
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{Repo: "/repo/.git", DefPath: defPath, SetID: "demo"})
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	p, ok := latestReportPointer(d, m, verifyPass)
+	if !ok {
+		t.Fatal("no latest Verify report")
+	}
+	body, err := os.ReadFile(p.Path)
+	if err != nil || string(body) != accepted {
+		t.Fatalf("latest report is not the Accept's (%v):\n%s", err, body)
+	}
+}
+
+// TestAcceptWithNoRecordedVerdictSaysSo: an Accept at a work SHA with nothing
+// recorded still files its report, and claims to override nothing.
+func TestAcceptWithNoRecordedVerdictSaysSo(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{}, Accept: true, AcceptNote: "reviewed by hand",
+	}); err != nil {
+		t.Fatalf("accept: %v", err)
+	}
+	reports := verifyReports(t, defPath)
+	if len(reports) != 1 {
+		t.Fatalf("reports = %d, want 1", len(reports))
+	}
+	if got := reportHeaderField(reports[0], "Overrode"); got != "" {
+		t.Fatalf("Overrode = %q, want none\n%s", got, reports[0])
+	}
+	if !strings.Contains(reports[0], "no verdict was recorded") || !strings.Contains(reports[0], "reviewed by hand") {
+		t.Fatalf("report:\n%s", reports[0])
+	}
+}
