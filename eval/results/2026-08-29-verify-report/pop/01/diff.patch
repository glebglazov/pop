+package tasks
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// reportPass is one pass that publishes a report, spelled as the few words that
+// differ between passes. Everything else about a report — the header of facts,
+// the timestamped filename, the directory it accumulates in, "the latest" as the
+// newest instant, the pointer every surface carries — is the same mechanism
+// whichever pass wrote it (ADR-0245), so it lives here, parameterised by this.
+type reportPass struct {
+	// label heads the document and leads the pointer's summary line: "Refine".
+	label string
+	// dir is the sub-directory of the set's folder the reports accumulate in.
+	// It sits under the Task-set directory, which lives in pop's Work store
+	// rather than in the repository, so no report can ever be staged into a
+	// commit (ADR-0214).
+	dir string
+	// filePrefix starts every report's name, ahead of the instant.
+	filePrefix string
+	// writtenField is the header fact recording when the pass ran: "Refined".
+	writtenField string
+	// authorField is the header fact naming the agent that ran it: "Refiner".
+	authorField string
+}
+
+// reportFileTimeLayout spells the instant in a report's name. The instant is in
+// the file name rather than only in the document, because "the latest" is
+// resolved by timestamp and a directory listing must be able to answer that
+// without opening every file.
+const reportFileTimeLayout = "20060102T150405Z"
+
+// reportDocument is one report on disk: where it is, when it was written, and
+// what it says.
+type reportDocument struct {
+	Path string
+	At   time.Time
+	Body string
+}
+
+// fileInstant reads a report's name back as the instant it was written, and
+// false for anything else in the directory.
+func (p reportPass) fileInstant(name string) (time.Time, bool) {
+	stamp, ok := strings.CutPrefix(name, p.filePrefix)
+	if !ok {
+		return time.Time{}, false
+	}
+	stamp, ok = strings.CutSuffix(stamp, ".md")
+	if !ok {
+		return time.Time{}, false
+	}
+	at, err := time.Parse(reportFileTimeLayout, stamp)
+	if err != nil {
+		return time.Time{}, false
+	}
+	return at, true
+}
+
+// latest returns the set's current report — the one with the newest timestamp
+// in its name — and false when the pass has never written one. Every earlier
+// document stays where it is; superseding is a matter of which one the readers
+// take, not of deleting the ones before it (ADR-0214).
+func (p reportPass) latest(d *Deps, setDir string) (reportDocument, bool) {
+	dir := filepath.Join(setDir, p.dir)
+	entries, err := d.FS.ReadDir(dir)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	var found reportDocument
+	ok := false
+	for _, entry := range entries {
+		at, isReport := p.fileInstant(entry.Name())
+		if entry.IsDir() || !isReport {
+			continue
+		}
+		if ok && !at.After(found.At) {
+			continue
+		}
+		found, ok = reportDocument{Path: filepath.Join(dir, entry.Name()), At: at}, true
+	}
+	if !ok {
+		return reportDocument{}, false
+	}
+	body, err := d.FS.ReadFile(found.Path)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	found.Body = strings.TrimSpace(string(body))
+	return found, true
+}
+
+// write files a new report under the pass's directory and returns its path. A
+// name already taken (two reports inside one second) advances the instant rather
+// than overwriting: retention is the whole point of the directory, and the names
+// are also the ordering.
+func (p reportPass) write(d *Deps, setDir string, at time.Time, body string) (string, error) {
+	dir := filepath.Join(setDir, p.dir)
+	noun := strings.ToLower(p.label)
+	if err := d.FS.MkdirAll(dir, 0o755); err != nil {
+		return "", exitErr(ExitOperational, "create %s directory: %v", noun, err)
+	}
+	at = at.UTC().Truncate(time.Second)
+	taken := map[string]bool{}
+	if entries, err := d.FS.ReadDir(dir); err == nil {
+		for _, entry := range entries {
+			taken[entry.Name()] = true
+		}
+	}
+	name := p.filePrefix + at.Format(reportFileTimeLayout) + ".md"
+	for taken[name] {
+		at = at.Add(time.Second)
+		name = p.filePrefix + at.Format(reportFileTimeLayout) + ".md"
+	}
+	path := filepath.Join(dir, name)
+	if err := d.FS.WriteFile(path, []byte(ensureTrailingNewline(body)), 0o644); err != nil {
+		return "", exitErr(ExitOperational, "write %s report: %v", noun, err)
+	}
+	return path, nil
+}
+
+// reportFact is one "- Field: value" line a pass adds to the header beyond the
+// four every report carries — the verdict a Verify report records, say.
+type reportFact struct {
+	Field string
+	Value string
+}
+
+// render wraps an agent's prose in the four facts a reader needs to know what
+// the pass looked at: which set, at which commits, by whom and when, then any
+// facts of the pass's own. They ride the document rather than a side-car
+// because the document leaves pop the moment a human pipes it somewhere.
+//
+// The Work SHA line is the report's own answer to which tree it describes. It
+// is stamped here rather than asked of the agent, because pop read it before the
+// pass began and the agent would only be copying it back.
+func (p reportPass) render(at time.Time, setID, workSHA, commitRange, agent, body string, facts ...reportFact) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "# %s report — %s\n\n", p.label, setID)
+	fmt.Fprintf(&b, "- %s: %s\n", p.writtenField, at.UTC().Format(time.RFC3339))
+	if commitRange != "" {
+		fmt.Fprintf(&b, "- Commit range: %s\n", commitRange)
+	}
+	if workSHA != "" {
+		fmt.Fprintf(&b, "- Work SHA: %s\n", ShortSHA(workSHA))
+	}
+	if strings.TrimSpace(agent) != "" {
+		fmt.Fprintf(&b, "- %s: %s\n", p.authorField, strings.TrimSpace(agent))
+	}
+	for _, fact := range facts {
+		fmt.Fprintf(&b, "- %s: %s\n", fact.Field, fact.Value)
+	}
+	fmt.Fprintf(&b, "\n%s", ensureTrailingNewline(strings.TrimSpace(body)))
+	return b.String()
+}
+
+func ensureTrailingNewline(s string) string {
+	if strings.HasSuffix(s, "\n") {
+		return s
+	}
+	return s + "\n"
+}
+
+// reportHeaderField reads one of the "- Field: value" facts render stamps at the
+// top of every report. The header is the document's own record of what it
+// describes, so reading it back beats keeping a side-car that a document copied
+// out of pop would leave behind.
+func reportHeaderField(body, field string) string {
+	prefix := "- " + field + ": "
+	inHeader := false
+	for _, line := range strings.Split(body, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "- ") {
+			// The header is the report's first bullet list; anything after it is
+			// the agent's prose, which may say anything at all.
+			if inHeader {
+				return ""
+			}
+			continue
+		}
+		inHeader = true
+		if rest, ok := strings.CutPrefix(line, prefix); ok {
+			return strings.TrimSpace(rest)
+		}
+	}
+	return ""
+}
+
+// ReportPointer is a set's current report as the surfaces carry it: where the
+// document is and which commit it was written against, never what it says
+// (ADR-0240, narrowed by ADR-0217).
+type ReportPointer struct {
+	pass reportPass
+	// Path is the absolute path of the latest report.
+	Path string
+	// WorkSHA is the short work SHA the report was written against, empty when
+	// the document records none.
+	WorkSHA string
+	// CommitRange is the range the agent read, empty when the document records
+	// none.
+	CommitRange string
+	// Written is the instant in the report's name, to the minute in UTC.
+	Written string
+}
+
+// latestPointer resolves the pointer for a set, and false when the pass has
+// never written a report for it.
+func (p reportPass) latestPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ReportPointer{}, false
+	}
+	doc, ok := p.latest(d, m.Dir)
+	if !ok {
+		return ReportPointer{}, false
+	}
+	ptr := ReportPointer{pass: p, Path: doc.Path, Written: doc.At.UTC().Format("2006-01-02 15:04Z")}
+	ptr.WorkSHA = reportHeaderField(doc.Body, "Work SHA")
+	ptr.CommitRange = reportHeaderField(doc.Body, "Commit range")
+	return ptr, true
+}
+
+// CommitPhrase names the commit the document was written against, in the one
+// form every surface prints it. Empty when the report recorded neither a work
+// SHA nor a range — an old or hand-edited document still shows its path.
+func (p ReportPointer) CommitPhrase() string {
+	switch {
+	case p.WorkSHA != "" && p.CommitRange != "":
+		return fmt.Sprintf("%s (%s)", p.WorkSHA, p.CommitRange)
+	case p.WorkSHA != "":
+		return p.WorkSHA
+	default:
+		return p.CommitRange
+	}
+}
+
+// Summary is the single line the gate preamble uses: which pass, the commit it
+// looked at, when, and where to read it.
+func (p ReportPointer) Summary() string {
+	var b strings.Builder
+	b.WriteString(p.pass.label)
+	if phrase := p.CommitPhrase(); phrase != "" {
+		fmt.Fprintf(&b, " of %s", phrase)
+	}
+	if p.Written != "" {
+		fmt.Fprintf(&b, ", written %s", p.Written)
+	}
+	fmt.Fprintf(&b, ": %s", p.Path)
+	return b.String()
+}
+
+// StaleAgainst reports whether the checkout has moved past the commit this
+// report was written against. Unknown on either side is not staleness: a
+// document recording no work SHA, or a checkout whose HEAD pop cannot read, says
+// nothing about whether the report still describes today's files.
+func (p ReportPointer) StaleAgainst(workSHA string) bool {
+	written, current := p.WorkSHA, ShortSHA(workSHA)
+	if written == "" || current == "" {
+		return false
+	}
+	// Either side may be the shorter abbreviation — a hand-edited header, or a
+	// document written when the shortening differed — so a common prefix counts
+	// as the same commit.
+	return !strings.HasPrefix(current, written) && !strings.HasPrefix(written, current)
+}
