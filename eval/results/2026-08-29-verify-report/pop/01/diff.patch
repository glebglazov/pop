diff --git a/tasks/verify_report_test.go b/tasks/verify_report_test.go
new file mode 100644
index 00000000..36dafe79
--- /dev/null
+++ b/tasks/verify_report_test.go
@@ -0,0 +1,243 @@
+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// verifyReportsOf returns the bodies of every Verify report filed for the demo
+// set, oldest first by the instant in the name.
+func verifyReportsOf(t *testing.T, defPath string) []string {
+	t.Helper()
+	dir := filepath.Join(defPath, "demo", VerifyDirName)
+	entries, err := os.ReadDir(dir)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		t.Fatalf("read verify dir: %v", err)
+	}
+	var names []string
+	for _, entry := range entries {
+		if _, ok := verifyReport.fileInstant(entry.Name()); !ok {
+			t.Fatalf("unexpected file %q in the verify dir", entry.Name())
+		}
+		names = append(names, entry.Name())
+	}
+	sort.Strings(names)
+	var bodies []string
+	for _, name := range names {
+		body, err := os.ReadFile(filepath.Join(dir, name))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		bodies = append(bodies, string(body))
+	}
+	return bodies
+}
+
+func runStubVerifier(t *testing.T, d *Deps, defPath, raw string, seen *string) {
+	t.Helper()
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{},
+		runVerifier: func(prompt string) (string, error) {
+			if seen != nil {
+				*seen = prompt
+			}
+			return raw, nil
+		},
+	}); err != nil {
+		t.Fatalf("verifyResolvedSet: %v", err)
+	}
+}
+
+// TestVerifierInvocationWritesReport: every verdict the Verifier renders — PASS
+// included — and every reply it cannot be understood in leaves one Verify report
+// whose body is the reply without its verdict line (ADR-0245).
+func TestVerifierInvocationWritesReport(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name        string
+		raw         string
+		wantVerdict Verdict
+		wantBody    []string
+	}{
+		{name: "pass", raw: "VERDICT: PASS\nFINDINGS: checked criterion 1 against verify.go; it is met", wantVerdict: VerdictPass, wantBody: []string{"FINDINGS: checked criterion 1 against verify.go; it is met"}},
+		{name: "fixable", raw: "VERDICT: FIXABLE\nSUMMARY: widget never renders\nFINDINGS: criterion 2 unmet", wantVerdict: VerdictFixable, wantBody: []string{"SUMMARY: widget never renders", "FINDINGS: criterion 2 unmet"}},
+		{name: "needs human", raw: "VERDICT: NEEDS-HUMAN\nFINDINGS: the spec contradicts itself", wantVerdict: VerdictNeedsHuman, wantBody: []string{"FINDINGS: the spec contradicts itself"}},
+		{name: "malformed", raw: "the code looks alright", wantVerdict: VerdictNeedsHuman, wantBody: []string{"could not be parsed", "the code looks alright"}},
+		{name: "unknown token", raw: "VERDICT: MAYBE\nFINDINGS: unsure", wantVerdict: VerdictNeedsHuman, wantBody: []string{"could not be parsed", "VERDICT: MAYBE\nFINDINGS: unsure"}},
+		{name: "absent", raw: "", wantVerdict: VerdictNeedsHuman, wantBody: []string{"produced no output"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+			runStubVerifier(t, d, defPath, tt.raw, nil)
+
+			stored := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1")
+			if stored == nil || stored.Verdict != string(tt.wantVerdict) {
+				t.Fatalf("stored verdict = %+v, want %s", stored, tt.wantVerdict)
+			}
+			reports := verifyReportsOf(t, defPath)
+			if len(reports) != 1 {
+				t.Fatalf("reports = %d, want 1", len(reports))
+			}
+			report := reports[0]
+			if !strings.HasPrefix(report, "# Verify report — demo\n") {
+				t.Fatalf("report does not open with its heading:\n%s", report)
+			}
+			if got := reportHeaderField(report, "Verdict"); got != string(tt.wantVerdict) {
+				t.Fatalf("header verdict = %q, want %s", got, tt.wantVerdict)
+			}
+			if got := reportHeaderField(report, "Work SHA"); got != "sha1" {
+				t.Fatalf("header work SHA = %q, want sha1", got)
+			}
+			for _, want := range tt.wantBody {
+				if !strings.Contains(report, want) {
+					t.Fatalf("report missing %q:\n%s", want, report)
+				}
+			}
+			if strings.Contains(report, "VERDICT: "+string(tt.wantVerdict)) {
+				t.Fatalf("report kept the verdict line:\n%s", report)
+			}
+		})
+	}
+}
+
+// TestVerifyReportsAccumulatePerInvocation: a verify-remediate-verify lap leaves
+// every lap's document, not one rewritten answer.
+func TestVerifyReportsAccumulatePerInvocation(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	runStubVerifier(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: first lap", nil)
+	runStubVerifier(t, d, defPath, "VERDICT: PASS\nFINDINGS: second lap", nil)
+
+	reports := verifyReportsOf(t, defPath)
+	if len(reports) != 2 {
+		t.Fatalf("reports = %d, want 2", len(reports))
+	}
+	if !strings.Contains(reports[0], "first lap") || !strings.Contains(reports[1], "second lap") {
+		t.Fatalf("reports out of order or lost:\n%s\n---\n%s", reports[0], reports[1])
+	}
+}
+
+// TestCachedVerdictWritesNoReport: a verdict read back from the cache invokes no
+// agent, so it adds nothing to the report trail.
+func TestCachedVerdictWritesNoReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	seedVerdict(t, d, store.VerifyVerdict{Repo: "/repo/.git", SetID: "demo", WorkSHA: "sha1", Verdict: "FIXABLE", Findings: "cached"})
+	opts := verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		runVerifier: func(string) (string, error) {
+			t.Fatal("a cache hit invoked the Verifier")
+			return "", nil
+		},
+	}
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	if _, err := ensureVerifyVerdict(d, nil, opts, m, "sha1"); err != nil {
+		t.Fatalf("ensureVerifyVerdict: %v", err)
+	}
+	if reports := verifyReportsOf(t, defPath); len(reports) != 0 {
+		t.Fatalf("a cache hit wrote %d report(s)", len(reports))
+	}
+}
+
+// TestVerifyReportsSurviveInvalidation: invalidation deletes the verdict cache
+// and leaves the reports, which are the durable record the cache never was.
+func TestVerifyReportsSurviveInvalidation(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	runStubVerifier(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: criterion 2 unmet", nil)
+
+	invalidateVerifyVerdicts(d, "/repo/.git", "demo")
+	_ = d.CloseStore()
+
+	if stored := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1"); stored != nil {
+		t.Fatalf("verdict survived invalidation: %+v", stored)
+	}
+	reports := verifyReportsOf(t, defPath)
+	if len(reports) != 1 || !strings.Contains(reports[0], "criterion 2 unmet") {
+		t.Fatalf("reports after invalidation = %q, want the one FIXABLE report", reports)
+	}
+}
+
+// TestVerifierPromptCarriesNoPreviousReport: the Verifier is never shown its own
+// earlier judgment, so a prior FIXABLE cannot anchor the next verdict (ADR-0245).
+func TestVerifierPromptCarriesNoPreviousReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	runStubVerifier(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: the anchoring-sentinel finding", nil)
+
+	var prompt string
+	runStubVerifier(t, d, defPath, "VERDICT: PASS\nFINDINGS: all met", &prompt)
+	if prompt == "" {
+		t.Fatal("the second run captured no prompt")
+	}
+	if strings.Contains(prompt, "anchoring-sentinel") || strings.Contains(prompt, VerifyDirName+string(filepath.Separator)) {
+		t.Fatalf("the Verifier prompt carries a previous report:\n%s", prompt)
+	}
+}
+
+// TestAcceptWritesHumanAuthoredReport: a human PASS over a non-PASS judgment
+// files a Verify report beside the Verifier's — same directory, stamp and
+// header — that carries the human's rationale, names the verdict it overrode,
+// says a human wrote it, and is the one the latest-report readers now find.
+func TestAcceptWritesHumanAuthoredReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	runStubVerifier(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: the retry looks flaky", nil)
+
+	opts := verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{}, Accept: true, AcceptNote: "the retry is intentional",
+		runVerifier: func(string) (string, error) {
+			t.Fatal("an Accept invoked the Verifier")
+			return "", nil
+		},
+	}
+	if _, err := verifyResolvedSet(d, nil, opts); err != nil {
+		t.Fatalf("verifyResolvedSet accept: %v", err)
+	}
+
+	reports := verifyReportsOf(t, defPath)
+	if len(reports) != 2 {
+		t.Fatalf("reports = %d, want the Verifier's and the Accept's", len(reports))
+	}
+	verifier, accepted := reports[0], reports[1]
+	for _, want := range []string{"# Verify report — demo", "- Verdict: PASS", "- Overrides: FIXABLE", "- Authored by: " + acceptReportAuthor, "the retry is intentional"} {
+		if !strings.Contains(accepted, want) {
+			t.Fatalf("accept report missing %q:\n%s", want, accepted)
+		}
+	}
+	if reportHeaderField(verifier, "Authored by") != "" || reportHeaderField(accepted, "Verifier") != "" {
+		t.Fatalf("a reader cannot tell the authors apart:\n%s\n---\n%s", verifier, accepted)
+	}
+	if got, want := reportHeaderField(accepted, "Work SHA"), reportHeaderField(verifier, "Work SHA"); got == "" || got != want {
+		t.Fatalf("accept Work SHA = %q, want the Verifier's header shape %q", got, want)
+	}
+
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	ptr, ok := verifyReport.latestPointer(d, m)
+	if !ok {
+		t.Fatal("no latest Verify report")
+	}
+	body, err := os.ReadFile(ptr.Path)
+	if err != nil || string(body) != accepted {
+		t.Fatalf("latest report = %s (%v), want the Accept's", ptr.Path, err)
+	}
+}
