+// splitVerifierReply lifts the verdict line off the Verifier's reply and returns
+// the prose around it as the Verify report's body, the way splitRefinerReply
+// lifts COMMIT-SUBJECT:. The verdict line is pop's channel, and the header
+// already records the verdict, so the document keeps only the reasons.
+//
+// It finds the same line ParseVerdict reads. A reply ParseVerdict cannot read
+// gets the same unparsedFindings text the verdict row records, with the raw
+// reply in it, so the report never holds less than the cache.
+func splitVerifierReply(raw string) string {
+	lines := strings.Split(strings.TrimSpace(raw), "\n")
+	for i, line := range lines {
+		value, ok := verdictLabelValue(line)
+		if !ok {
+			continue
+		}
+		if _, ok := canonicalVerdict(value); !ok {
+			break
+		}
+		body := strings.TrimSpace(strings.Join(append(append([]string{}, lines[:i]...), lines[i+1:]...), "\n"))
+		if body == "" {
+			return "The Verifier gave no reasons for this verdict."
+		}
+		return body
+	}
+	return unparsedFindings(raw)
+}
+
