+package tasks
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"time"
+)
+
+// verifyProse is the Verify report's body, which no surface may print: every
+// surface carries a pointer to the document and nothing of what it says.
+const verifyProse = "SECRET-VERIFY-PROSE"
+
+// seedVerifyReport files one Verify report for the fixture set, as the Verifier
+// would have written it, and returns its path.
+func seedVerifyReport(t *testing.T, d *Deps, m *Manifest) string {
+	t.Helper()
+	at := time.Date(2026, 8, 17, 9, 30, 0, 0, time.UTC)
+	body := verifyReport.render(at, "demo", "abc123abc123", "aaa111^..HEAD", "claude", "01-a: "+verifyProse,
+		reportFact{Field: "Verdict", Value: string(VerdictFixable)})
+	path, err := verifyReport.write(d, m.Dir, at, body)
+	if err != nil {
+		t.Fatalf("verifyReport.write: %v", err)
+	}
+	return path
+}
+
+func hitlGateOutputWithVerify(t *testing.T, d *Deps, m *Manifest, input string) (string, hitlGateAction) {
+	t.Helper()
+	var out strings.Builder
+	in := strings.NewReader(input)
+	verify, hasVerify := verifyReport.latestPointer(d, m)
+	refine, hasRefine := refineReport.latestPointer(d, m)
+	action, err := promptHITLGateAction(&out, in, d, nil, "/rt", newPromptReader(in), "demo", m, &m.Tasks[1],
+		"## Acceptance criteria\n\n- [ ] ok\n", nil, false, verify, hasVerify, refine, hasRefine)
+	if err != nil {
+		t.Fatalf("promptHITLGateAction: %v", err)
+	}
+	return out.String(), action
+}
+
+func taskSetDetail(d *Deps, m *Manifest) string {
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+	return detail.String()
+}
+
+// TestVerifyPointerReachesEveryHumanSurface drives the gate preamble, the
+// gate's paging entry, the detail view and the artifact list: each names the
+// latest Verify report and the commit it judged, and none prints its prose.
+func TestVerifyPointerReachesEveryHumanSurface(t *testing.T) {
+	d, m := hitlFixture(t)
+	refinePath := seedRefineReport(t, d, m)
+	path := seedVerifyReport(t, d, m)
+
+	gate, _ := hitlGateOutputWithVerify(t, d, m, "0\n")
+	detail := taskSetDetail(d, m)
+	commit := ShortSHA("abc123abc123") + " (aaa111^..HEAD)"
+	for _, s := range []struct {
+		surface string
+		text    string
+		wants   []string
+	}{
+		{"HITL gate", gate, []string{"Verify of " + commit + ", written 2026-08-17 09:30Z: " + path, "Read the verify report"}},
+		{"detail view", detail, []string{"VERIFY REPORT", path, commit, "newest: verify, written 2026-08-17 09:30Z"}},
+	} {
+		for _, want := range s.wants {
+			if !strings.Contains(s.text, want) {
+				t.Fatalf("%s missing %q:\n%s", s.surface, want, s.text)
+			}
+		}
+		if strings.Contains(s.text, verifyProse) {
+			t.Fatalf("%s inlined the verify report:\n%s", s.surface, s.text)
+		}
+	}
+	// A verdict outranks a polish note: the verify line and entry come first.
+	if strings.Index(gate, path) > strings.Index(gate, refinePath) {
+		t.Fatalf("the gate put the refine pointer above the verify pointer:\n%s", gate)
+	}
+
+	// Re-verify is not offered here, so verify takes key 5 and refine key 6.
+	if _, action := hitlGateOutputWithVerify(t, d, m, "5\n"); action != hitlGateReadVerify {
+		t.Fatalf("expected the verify entry at key 5, got action %d", action)
+	}
+	if _, action := hitlGateOutputWithVerify(t, d, m, "6\n"); action != hitlGateReadRefine {
+		t.Fatalf("expected the refine entry at key 6, got action %d", action)
+	}
+	runner := &fakeAttendedRunner{}
+	d.Runner = runner
+	t.Setenv("PAGER", "mypager")
+	verify, _ := verifyReport.latestPointer(d, m)
+	pageReportDocument(d, strings.NewReader(""), "/rt", &bytes.Buffer{}, verify)
+	if runner.attendedCalls != 1 || runner.name != "mypager" || strings.Join(runner.args, " ") != path {
+		t.Fatalf("expected one pager launch over the verify report, got %d: %s %v", runner.attendedCalls, runner.name, runner.args)
+	}
+
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil {
+		t.Fatalf("Artifacts: %v", err)
+	}
+	if len(artifacts) < 2 || artifacts[0].Path != path || artifacts[1].Path != refinePath {
+		t.Fatalf("expected the verify report ranked above the refine report, got %+v", artifacts)
+	}
+}
+
+// TestVerifyPointerStaysOutOfAgentPrompts pins that an agent sent to fix
+// something is never handed the report: its findings are already in its task
+// body, and a second copy invites it to treat the report as the spec.
+func TestVerifyPointerStaysOutOfAgentPrompts(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	path := seedVerifyReport(t, d, m)
+
+	prompts := attendedPrompts(d, m)
+	prompts["verifier prompt"] = buildVerifierPrompt(d, m, "sha1", workDiffView{Range: "aaa111^..HEAD", Stat: " a.go | 1 +"}, "", "")
+	for surface, text := range prompts {
+		for _, unwanted := range []string{path, VerifyDirName + "/verify-", verifyProse} {
+			if strings.Contains(text, unwanted) {
+				t.Fatalf("%s carries the verify report (%q):\n%s", surface, unwanted, text)
+			}
+		}
+	}
+}
+
+// TestNeverVerifiedSetShowsNoVerifyPointer pins the empty state: a set with no
+// Verify report says nothing about one on the gate, the detail view or the
+// artifact list.
+func TestNeverVerifiedSetShowsNoVerifyPointer(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+
+	gate, _ := hitlGateOutputWithVerify(t, d, m, "0\n")
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": taskSetDetail(d, m)} {
+		if strings.Contains(strings.ToLower(text), "verify report") {
+			t.Fatalf("%s mentions a verify report the set does not have:\n%s", surface, text)
+		}
+	}
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil {
+		t.Fatalf("Artifacts: %v", err)
+	}
+	for _, artifact := range artifacts {
+		if artifact.Type == ArtifactTypeVerify {
+			t.Fatalf("artifact list carries a verify report the set does not have: %+v", artifact)
+		}
+	}
+}
+
+// TestVerifyReportStalenessNeverReachesStatus pins that the report answers why,
+// never whether: a report older than HEAD leaves the set's status line as it
+// was, and no surface calls it out of date — that is the Verified-at badge's
+// question alone.
+func TestVerifyReportStalenessNeverReachesStatus(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	before := strings.SplitN(taskSetDetail(d, m), "\n", 2)[0]
+
+	// The fixture checkout's HEAD is sha1; the report judged abc123abc123.
+	seedVerifyReport(t, d, m)
+	detail := taskSetDetail(d, m)
+	gate, _ := hitlGateOutputWithVerify(t, d, m, "0\n")
+
+	if after := strings.SplitN(detail, "\n", 2)[0]; after != before {
+		t.Fatalf("a stale verify report moved the status line: %q -> %q", before, after)
+	}
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": detail} {
+		// The set's directory is named after this test, so it is cut out first.
+		lower := strings.ToLower(strings.ReplaceAll(text, m.Dir, ""))
+		if strings.Contains(lower, "out of date") || strings.Contains(lower, "stale") {
+			t.Fatalf("%s gave the verify report a staleness answer:\n%s", surface, text)
+		}
+	}
+}
