diff --git a/tasks/verify_report.go b/tasks/verify_report.go
new file mode 100644
index 00000000..d516875d
--- /dev/null
+++ b/tasks/verify_report.go
@@ -0,0 +1,99 @@
+package tasks
+
+import (
+	"strings"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// verifyReports is the Verify report: the Verifier's reasoning under the set's
+// verify/ directory, one document per invocation, headed by when it was
+// verified, by which Verifier, and the verdict the prose justifies (ADR-0245).
+//
+// It is deliberately not the verdict cache. verify_verdicts is keyed by work SHA
+// and deleted on invalidation; these documents stay, so a
+// verify-remediate-verify lap leaves every judgment behind it. The Verifier is
+// never shown them: the verdict gates a drain, and a judge reading its own
+// earlier answer anchors on it.
+var verifyReports = reportKind{
+	artifactType: ArtifactTypeVerify,
+	dir:          VerifyDirName,
+	filePrefix:   "verify-",
+	title:        "Verify report",
+	writtenField: "Verified",
+	authorField:  "Verifier",
+	label:        "Verify",
+}
+
+// latestVerifyPointer resolves the pointer to a set's newest Verify report for
+// the human surfaces, and false when the set has never been verified. It answers
+// why verification judged as it did, never whether the set is still verified:
+// that is the Verified-at badge's question, so no surface derives staleness or
+// status from it. The agent prompts never carry it — a Remediation agent already
+// has the findings in its task body, and a second copy reads as the spec.
+var latestVerifyPointer = verifyReports.latestPointer
+
+// writeVerifyReport files the report for one Verifier invocation and returns
+// its path. The verdict is the one ParseVerdict already read from raw, so the
+// header states exactly what the cache row records.
+func writeVerifyReport(d *Deps, m *Manifest, setID, workSHA, commitRange, agent string, verdict Verdict, raw string) (string, error) {
+	at := d.Now().UTC()
+	doc := verifyReports.render(at, setID, workSHA, commitRange, agent, splitVerifierReply(raw), reportFact{Field: "Verdict", Value: string(verdict)})
+	return verifyReports.write(d, m.Dir, at, doc)
+}
+
+// acceptedVerifyAuthor stands in the Verifier field of a report no agent wrote.
+const acceptedVerifyAuthor = "human (Accept)"
+
+// writeAcceptedVerifyReport files the report for an Accept (ADR-0103) and
+// returns its path. No agent ran, so pop writes the prose: the human's
+// rationale and the judgment it overrode, whose findings it repeats because they
+// are what a later reader of a green set will ask about. overridden is nil when
+// no verdict was recorded at workSHA.
+func writeAcceptedVerifyReport(d *Deps, m *Manifest, setID, workSHA, commitRange, note string, overridden *store.VerifyVerdict) (string, error) {
+	at := d.Now().UTC()
+	overrode := "none recorded at this work SHA"
+	if overridden != nil {
+		overrode = overridden.Verdict
+	}
+	var b strings.Builder
+	b.WriteString("## Accepted by a human\n\n")
+	b.WriteString("A human recorded this PASS themselves, over the Verifier's judgment. No Verifier ran for it.\n\n")
+	b.WriteString("## Rationale\n\n")
+	if note == "" {
+		b.WriteString("The human gave no rationale.\n")
+	} else {
+		b.WriteString(note + "\n")
+	}
+	if overridden != nil && strings.TrimSpace(overridden.Findings) != "" {
+		b.WriteString("\n## Overridden findings\n\n")
+		b.WriteString(strings.TrimSpace(overridden.Findings) + "\n")
+	}
+	doc := verifyReports.render(at, setID, workSHA, commitRange, acceptedVerifyAuthor, b.String(),
+		reportFact{Field: "Verdict", Value: string(VerdictPass)},
+		reportFact{Field: "Overrode", Value: overrode})
+	return verifyReports.write(d, m.Dir, at, doc)
+}
+
+// splitVerifierReply lifts the VERDICT line off the Verifier's reply and returns
+// the prose that remains as the report body, the way splitRefinerReply lifts
+// COMMIT-SUBJECT. The verdict line is pop's channel — the header restates it —
+// while everything else is the Verifier's account of what it checked.
+//
+// A reply ParseVerdict cannot read keeps all of its text, framed as
+// unparsedFindings frames it, so the report still says why the set went to a
+// human and loses nothing the agent wrote.
+func splitVerifierReply(raw string) string {
+	lines := strings.Split(strings.TrimSpace(raw), "\n")
+	for i, line := range lines {
+		value, ok := verdictLabelValue(line)
+		if !ok {
+			continue
+		}
+		if _, ok := canonicalVerdict(value); !ok {
+			break
+		}
+		return strings.TrimSpace(strings.Join(append(append([]string{}, lines[:i]...), lines[i+1:]...), "\n"))
+	}
+	return unparsedFindings(raw)
+}
diff --git a/tasks/verify_report_surfaces_test.go b/tasks/verify_report_surfaces_test.go
new file mode 100644
index 00000000..a8ade209
--- /dev/null
+++ b/tasks/verify_report_surfaces_test.go
@@ -0,0 +1,111 @@
+package tasks
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+// verifyProse is the Verifier's reasoning, which no surface may print: every
+// human surface carries a pointer to the report and nothing else (ADR-0245).
+const verifyProse = "SECRET-VERIFY-PROSE"
+
+// seedVerifyReport files one Verify report for the fixture set, written against
+// a commit other than the fixture checkout's HEAD (sha1), and returns its path.
+func seedVerifyReport(t *testing.T, d *Deps, m *Manifest) string {
+	t.Helper()
+	path, err := writeVerifyReport(d, m, "demo", "abc123abc123", "aaa111^..HEAD", "claude", VerdictFixable,
+		"VERDICT: FIXABLE\nFINDINGS: "+verifyProse+"\n")
+	if err != nil {
+		t.Fatalf("writeVerifyReport: %v", err)
+	}
+	return path
+}
+
+// TestVerifyPointerReachesEveryHumanSurface drives the gate, the detail view and
+// the artifact list for a set with both reports: each points at the Verify report
+// ahead of the Refine report, none prints its prose, and none calls the report
+// stale although HEAD has moved past it — staleness is the badge's question.
+func TestVerifyPointerReachesEveryHumanSurface(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	refinePath := seedRefineReport(t, d, m)
+	path := seedVerifyReport(t, d, m)
+
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+
+	for _, s := range []struct {
+		surface string
+		text    string
+		wants   []string
+	}{
+		{"HITL gate", gate, []string{path, "abc123abc123 (aaa111^..HEAD)", "Read the verify report"}},
+		{"detail view", detail.String(), []string{"VERIFY REPORT", path, "abc123abc123 (aaa111^..HEAD)"}},
+	} {
+		for _, want := range s.wants {
+			if !strings.Contains(s.text, want) {
+				t.Fatalf("%s missing %q:\n%s", s.surface, want, s.text)
+			}
+		}
+		lower := strings.ToLower(s.text)
+		if strings.Contains(s.text, verifyProse) || strings.Contains(lower, "stale") || strings.Contains(lower, "out of date") {
+			t.Fatalf("%s inlined the verify report or judged its staleness:\n%s", s.surface, s.text)
+		}
+	}
+	if strings.Index(gate, path) > strings.Index(gate, refinePath) {
+		t.Fatalf("the gate ranks the refine report above the verify report:\n%s", gate)
+	}
+
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil {
+		t.Fatalf("Artifacts: %v", err)
+	}
+	if len(artifacts) < 2 || artifacts[0].Path != path || artifacts[1].Path != refinePath {
+		t.Fatalf("artifacts = %+v, want the verify report first, then the refine report", artifacts)
+	}
+}
+
+// TestHITLGateReadVerifyEntryPagesAndSpawnsNoAgent pins the gate's verify entry:
+// it takes the first free key ahead of the refine entry, and taking it runs the
+// human's pager over the document — no agent, and no change to the set.
+func TestHITLGateReadVerifyEntryPagesAndSpawnsNoAgent(t *testing.T) {
+	d, m := hitlFixture(t)
+	seedRefineReport(t, d, m)
+	path := seedVerifyReport(t, d, m)
+
+	if _, action := hitlGateOutput(t, d, m, "5\n"); action != hitlGateReadVerify {
+		t.Fatalf("expected the verify entry at key 5, got action %d", action)
+	}
+	if _, action := hitlGateOutput(t, d, m, "6\n"); action != hitlGateReadRefine {
+		t.Fatalf("expected the refine entry at key 6, got action %d", action)
+	}
+
+	runner := &fakeAttendedRunner{}
+	d.Runner = runner
+	t.Setenv("PAGER", "mypager -X")
+	var out bytes.Buffer
+	pageReportDocument(d, strings.NewReader(""), "/rt", &out, latestGateReports(d, m).Verify)
+
+	if runner.attendedCalls != 1 {
+		t.Fatalf("expected exactly one attended launch (the pager), got %d", runner.attendedCalls)
+	}
+	if runner.name != "mypager" || strings.Join(runner.args, " ") != "-X "+path {
+		t.Fatalf("expected the pager over the document, got %s %v", runner.name, runner.args)
+	}
+}
+
+// TestVerifyPointerStaysOutOfAgentPrompts: an agent sent to fix the set already
+// has the findings in its task body, so no attended prompt names the report.
+func TestVerifyPointerStaysOutOfAgentPrompts(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	path := seedVerifyReport(t, d, m)
+
+	for surface, prompt := range attendedPrompts(d, m) {
+		if strings.Contains(prompt, path) || strings.Contains(strings.ToLower(prompt), "verify report") || strings.Contains(prompt, verifyProse) {
+			t.Fatalf("%s carries the verify report:\n%s", surface, prompt)
+		}
+	}
+}
diff --git a/tasks/verify_report_test.go b/tasks/verify_report_test.go
new file mode 100644
index 00000000..be119c4c
--- /dev/null
+++ b/tasks/verify_report_test.go
@@ -0,0 +1,195 @@
+package tasks
+
+import (
+	"bytes"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// verifyReportBodies returns every Verify report filed for the set, oldest
+// first.
+func verifyReportBodies(t *testing.T, d *Deps, m *Manifest) []string {
+	t.Helper()
+	dir := filepath.Join(m.Dir, VerifyDirName)
+	entries, err := d.FS.ReadDir(dir)
+	if err != nil {
+		return nil
+	}
+	var bodies []string
+	for _, entry := range entries {
+		if _, ok := verifyReports.fileInstant(entry.Name()); !ok {
+			continue
+		}
+		body, err := d.FS.ReadFile(filepath.Join(dir, entry.Name()))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		bodies = append(bodies, string(body))
+	}
+	return bodies
+}
+
+func drainVerifyWith(t *testing.T, d *Deps, m *Manifest, run func(string) (string, error)) *store.VerifyVerdict {
+	t.Helper()
+	_, verdict, err := drainVerifyPhase(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", RuntimePath: "/rt", SetID: "demo", Output: &bytes.Buffer{},
+		runVerifier: run,
+	}, m, StatusDone)
+	if err != nil {
+		t.Fatalf("drainVerifyPhase: %v", err)
+	}
+	return verdict
+}
+
+// TestVerifierInvocationWritesReportForEveryVerdict: each verdict, PASS
+// included, leaves the Verifier's prose on disk with the verdict line lifted
+// into the header.
+func TestVerifierInvocationWritesReportForEveryVerdict(t *testing.T) {
+	t.Parallel()
+	for _, verdict := range []Verdict{VerdictPass, VerdictFixable, VerdictNeedsHuman} {
+		t.Run(string(verdict), func(t *testing.T) {
+			t.Parallel()
+			d, m := setupDrainVerifyFixture(t, stubGit("sha1sha1sha1sha1\n", "", ""), doneAFKSet(), nil)
+			drainVerifyWith(t, d, m, func(string) (string, error) {
+				return "VERDICT: " + string(verdict) + "\nFINDINGS: criterion 1 checked against the diff\n", nil
+			})
+
+			bodies := verifyReportBodies(t, d, m)
+			if len(bodies) != 1 {
+				t.Fatalf("reports = %d, want 1", len(bodies))
+			}
+			body := bodies[0]
+			if got := reportHeaderField(body, "Verdict"); got != string(verdict) {
+				t.Fatalf("header verdict = %q, want %s\n%s", got, verdict, body)
+			}
+			if got := reportHeaderField(body, "Work SHA"); got != "sha1sha1sha1" {
+				t.Fatalf("header work SHA = %q\n%s", got, body)
+			}
+			if !strings.Contains(body, "FINDINGS: criterion 1 checked against the diff") {
+				t.Fatalf("report lost the Verifier's prose:\n%s", body)
+			}
+			if strings.Contains(body, "VERDICT:") {
+				t.Fatalf("verdict line left in the report body:\n%s", body)
+			}
+		})
+	}
+}
+
+// TestMalformedVerifierReplyReportKeepsRawText: a reply with no readable
+// verdict still parks as NEEDS-HUMAN, and its report keeps what the agent wrote.
+func TestMalformedVerifierReplyReportKeepsRawText(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), doneAFKSet(), nil)
+	v := drainVerifyWith(t, d, m, func(string) (string, error) {
+		return "I looked at everything and it seems mostly fine.", nil
+	})
+	if Verdict(v.Verdict) != VerdictNeedsHuman {
+		t.Fatalf("verdict = %s, want NEEDS-HUMAN", v.Verdict)
+	}
+	bodies := verifyReportBodies(t, d, m)
+	if len(bodies) != 1 || !strings.Contains(bodies[0], "I looked at everything and it seems mostly fine.") {
+		t.Fatalf("report did not keep the raw reply: %q", bodies)
+	}
+	if got := reportHeaderField(bodies[0], "Verdict"); got != string(VerdictNeedsHuman) {
+		t.Fatalf("header verdict = %q, want NEEDS-HUMAN", got)
+	}
+}
+
+// TestCachedVerdictWritesNoReport: a verdict read back from the cache invokes
+// no agent and so files no report.
+func TestCachedVerdictWritesNoReport(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), doneAFKSet(), nil)
+	seedVerdict(t, d, store.VerifyVerdict{Repo: "/repo/.git", SetID: "demo", WorkSHA: "sha1", Verdict: "FIXABLE", Findings: "cached"})
+	drainVerifyWith(t, d, m, func(string) (string, error) {
+		t.Fatal("Verifier invoked despite a cached verdict")
+		return "", nil
+	})
+	if bodies := verifyReportBodies(t, d, m); len(bodies) != 0 {
+		t.Fatalf("cached verdict filed %d reports, want 0", len(bodies))
+	}
+}
+
+// TestVerifyReportsSurviveInvalidationAndStayOutOfThePrompt: a
+// verify-invalidate-verify lap leaves both reports on disk while the cache
+// loses the first verdict, and the second Verifier is never shown the first
+// report.
+func TestVerifyReportsSurviveInvalidationAndStayOutOfThePrompt(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), doneAFKSet(), nil)
+	drainVerifyWith(t, d, m, func(string) (string, error) {
+		return "VERDICT: FIXABLE\nFINDINGS: the first lap's distinctive finding\n", nil
+	})
+
+	s, err := openDrainStore(d)
+	if err != nil {
+		t.Fatalf("open store: %v", err)
+	}
+	if err := s.InvalidateVerifyVerdicts("/repo/.git", "demo"); err != nil {
+		t.Fatalf("InvalidateVerifyVerdicts: %v", err)
+	}
+	_ = d.CloseStore()
+	if stored := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1"); stored != nil {
+		t.Fatalf("cached verdict survived invalidation: %+v", stored)
+	}
+
+	var secondPrompt string
+	drainVerifyWith(t, d, m, func(prompt string) (string, error) {
+		secondPrompt = prompt
+		return "VERDICT: PASS\nFINDINGS: criterion 1 is met by the fix\n", nil
+	})
+	if strings.Contains(secondPrompt, "the first lap's distinctive finding") || strings.Contains(secondPrompt, "Verify report —") {
+		t.Fatalf("Verifier prompt carries a previous report:\n%s", secondPrompt)
+	}
+
+	bodies := verifyReportBodies(t, d, m)
+	if len(bodies) != 2 {
+		t.Fatalf("reports = %d, want one per invocation (2)", len(bodies))
+	}
+	if !strings.Contains(bodies[0], "the first lap's distinctive finding") || !strings.Contains(bodies[1], "criterion 1 is met by the fix") {
+		t.Fatalf("lap trail out of order or incomplete:\n%s\n---\n%s", bodies[0], bodies[1])
+	}
+}
+
+// TestAcceptWritesHumanAuthoredReport: a human PASS over the Verifier's FIXABLE
+// files a report with no agent run — the human's rationale, the verdict it
+// overrode, and a header that says a human wrote it — and the latest-report
+// reader takes it over the Verifier's report before it.
+func TestAcceptWritesHumanAuthoredReport(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1sha1sha1sha1\n", "", ""), doneAFKSet(), nil)
+	drainVerifyWith(t, d, m, func(string) (string, error) {
+		return "VERDICT: FIXABLE\nFINDINGS: the retry loop looks unbounded\n", nil
+	})
+
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: filepath.Dir(m.Dir), RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{}, Accept: true, AcceptNote: "the retry is bounded by the caller's timeout",
+		runVerifier: func(string) (string, error) { t.Fatal("accept must not invoke the Verifier"); return "", nil },
+	}); err != nil {
+		t.Fatalf("accept: %v", err)
+	}
+
+	if bodies := verifyReportBodies(t, d, m); len(bodies) != 2 {
+		t.Fatalf("reports = %d, want the Verifier's and the human's", len(bodies))
+	}
+	pointer, ok := verifyReports.latestPointer(d, m)
+	if !ok || pointer.WorkSHA != "sha1sha1sha1" {
+		t.Fatalf("latest pointer = %+v, %v", pointer, ok)
+	}
+	latest, _ := verifyReports.latest(d, m.Dir)
+	body := latest.Body
+	for field, want := range map[string]string{"Verifier": acceptedVerifyAuthor, "Verdict": "PASS", "Overrode": "FIXABLE"} {
+		if got := reportHeaderField(body, field); got != want {
+			t.Fatalf("header %s = %q, want %q\n%s", field, got, want, body)
+		}
+	}
+	for _, want := range []string{"the retry is bounded by the caller's timeout", "the retry loop looks unbounded"} {
+		if !strings.Contains(body, want) {
+			t.Fatalf("report missing %q:\n%s", want, body)
+		}
+	}
+}
