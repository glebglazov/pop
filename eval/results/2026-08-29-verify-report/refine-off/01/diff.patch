+)
+
+// verifyReport is the Verifier's report (ADR-0245). Like Refine's, it files
+// under the Task-set directory in pop's Work store, one document per Verifier
+// invocation. It is not the verdict cache: the cache is keyed by work SHA and
+// deleted on invalidation, while these documents stay as the lap-by-lap record
+// of why each verdict was given.
+var verifyReport = reportPass{
+	label:        "Verify",
+	dir:          VerifyDirName,
+	artifactType: ArtifactTypeVerify,
+	writtenField: "Verified",
+	agentField:   "Verifier",
+}
+
+// VerifyReportSectionTitle is shared by the CLI and dashboard detail surfaces
+// so both name the pointer block the same.
+const VerifyReportSectionTitle = "Verify report"
+
+// LatestVerifyReport is the pointer to the set's latest Verify report, for the
+// human-facing surfaces outside this package; false for a set never verified.
+// It answers why the set was judged as it was, never whether that judgment
+// still holds — staleness is the Verified-at badge's question, so the pointer
+// carries no out-of-date flag.
+func LatestVerifyReport(d *Deps, m *Manifest) (ReportPointer, bool) {
+	return latestReportPointer(d, m, verifyReport)
+}
+
+// splitVerifierReply lifts the `VERDICT:` line off the Verifier's reply and
+// returns the prose that remains as the report body — the same move
+// splitRefinerReply makes for `COMMIT-SUBJECT:`. The verdict line comes first so
+// the agent commits to the enum before it justifies it; pop stamps the verdict
+// into the report's header instead. A reply with no parseable verdict keeps its
+// raw text, framed as ParseVerdict frames it, so a NEEDS-HUMAN parked on a
+// malformed reply still shows what the Verifier actually said.
+func splitVerifierReply(raw string) string {
+	lines := strings.Split(strings.TrimSpace(raw), "\n")
+	_, i, ok := findVerdictLine(lines)
+	if !ok {
+		return unparsedFindings(raw)
+	}
+	body := strings.TrimSpace(strings.Join(append(append([]string{}, lines[:i]...), lines[i+1:]...), "\n"))
+	if body == "" {
+		return "The Verifier gave its verdict without stating what it checked."
+	}
+	return body
+}
+
+// writeVerifyReport files the report of one Verifier invocation and returns its
+// path. Only a reply from an agent reaches here: a verdict read back from the
+// cache, or one pop stood in for without invoking the Verifier, has no new
+// reasoning to record.
+func writeVerifyReport(d *Deps, m *Manifest, setID, workSHA, commitRange string, verdict Verdict, raw string) (string, error) {
+	at := d.Now().UTC()
+	doc := verifyReport.render(at, setID, workSHA, commitRange, "", splitVerifierReply(raw), reportFact{Field: "Verdict", Value: string(verdict)})
+	return verifyReport.write(d, m.Dir, at, doc)
+}
+
+// acceptedVerdictAuthor stands in the Verifier header bullet of a report a
+// human's Accept wrote, so a reader scanning the set's reports tells it apart
+// from an agent's at the header.
+const acceptedVerdictAuthor = "human (Accept)"
+
+// writeAcceptedVerdictReport files the report of a human Accept (ADR-0103): a
+// PASS the human recorded over the Verifier's judgment. No agent ran, so pop
+// writes the prose itself — the human's rationale and the verdict it overrode —
+// under the same directory, stamp and header as a Verifier's report, so the
+// latest-report readers take it like any other.
+func writeAcceptedVerdictReport(d *Deps, opts verifyCoreOptions, m *Manifest, workSHA string, overridden *store.VerifyVerdict, note string) (string, error) {
+	at := d.Now().UTC()
+	overrides := "none recorded"
+	if overridden != nil && overridden.Verdict != "" {
+		overrides = overridden.Verdict
+	}
+	var body strings.Builder
+	fmt.Fprintf(&body, "A human accepted this set as PASS without running the Verifier, overriding the recorded verdict: %s.\n\n", overrides)
+	body.WriteString("## Human rationale\n\n")
+	if note == "" {
+		body.WriteString("The human gave no rationale.\n")
+	} else {
+		body.WriteString(note + "\n")
+	}
+	work := verifyWorkDiff(d, opts.RuntimePath, opts.SetID, m)
+	doc := verifyReport.render(at, opts.SetID, workSHA, work.Range, acceptedVerdictAuthor, body.String(),
+		reportFact{Field: "Verdict", Value: string(VerdictPass)},
+		reportFact{Field: "Overrides", Value: overrides})
+	return verifyReport.write(d, m.Dir, at, doc)
+}
diff --git a/tasks/verify_report_surfaces_test.go b/tasks/verify_report_surfaces_test.go
new file mode 100644
index 00000000..58a03c2d
--- /dev/null
+++ b/tasks/verify_report_surfaces_test.go
@@ -0,0 +1,118 @@
+package tasks
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"time"
+)
+
+// verifyProse is the Verify report's body: no surface may print it, only point
+// at the document that holds it (ADR-0245).
+const verifyProse = "SECRET-VERIFY-PROSE"
+
+// seedVerifyReport files one Verify report for the fixture set, written against
+// a commit other than the fixture checkout's HEAD (sha1), and returns its path.
+func seedVerifyReport(t *testing.T, d *Deps, m *Manifest) string {
+	t.Helper()
+	at := time.Date(2026, 8, 17, 9, 30, 0, 0, time.UTC)
+	body := verifyReport.render(at, "demo", "def456def456", "bbb222^..HEAD", "claude", "## Criteria\n\n"+verifyProse,
+		reportFact{Field: "Verdict", Value: string(VerdictFixable)})
+	path, err := verifyReport.write(d, m.Dir, at, body)
+	if err != nil {
+		t.Fatalf("verifyReport.write: %v", err)
+	}
+	return path
+}
+
+// TestVerifyPointerReachesTheHumanSurfaces drives every surface a human reads a
+// verified set on: the gate's preamble and paging entry, the detail view and the
+// artifact list. Each carries the pointer ahead of the Refine report's, none
+// carries the body, and none calls a report older than HEAD out of date.
+func TestVerifyPointerReachesTheHumanSurfaces(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	verifyPath := seedVerifyReport(t, d, m)
+	refinePath := seedRefineReport(t, d, m)
+
+	// Re-verify is not offered here, so the verify entry takes key 5 and the
+	// refine entry key 6.
+	gate, action := hitlGateOutput(t, d, m, "5\n")
+	if action != hitlGateReadVerify {
+		t.Fatalf("expected the verify entry at key 5, got action %d", action)
+	}
+	if _, action := hitlGateOutput(t, d, m, "6\n"); action != hitlGateReadRefine {
+		t.Fatalf("expected the refine entry at key 6, got action %d", action)
+	}
+	for _, want := range []string{"Verify of " + ShortSHA("def456def456") + " (bbb222^..HEAD), written 2026-08-17 09:30Z: " + verifyPath, "Read the verify report (no agent runs)"} {
+		if !strings.Contains(gate, want) {
+			t.Fatalf("gate missing %q:\n%s", want, gate)
+		}
+	}
+	if strings.Index(gate, verifyPath) > strings.Index(gate, refinePath) {
+		t.Fatalf("gate points at the refine report before the verify report:\n%s", gate)
+	}
+
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+	for _, want := range []string{"VERIFY REPORT", verifyPath, ShortSHA("def456def456") + " (bbb222^..HEAD)", "newest: verify"} {
+		if !strings.Contains(detail.String(), want) {
+			t.Fatalf("detail view missing %q:\n%s", want, detail.String())
+		}
+	}
+
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(artifacts) < 2 || artifacts[0].Path != verifyPath || artifacts[1].Path != refinePath {
+		t.Fatalf("artifacts = %+v, want the verify report first, then the refine report", artifacts)
+	}
+
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": detail.String()} {
+		if strings.Contains(text, verifyProse) {
+			t.Fatalf("%s inlined the verify report:\n%s", surface, text)
+		}
+		if strings.Contains(strings.ToLower(text), "out of date") {
+			t.Fatalf("%s judged the verify report's staleness:\n%s", surface, text)
+		}
+	}
+}
+
+// TestVerifyPointerStaysOutOfAgentPrompts pins that an agent is never pointed at
+// the report: the findings it must act on already ride its task body.
+func TestVerifyPointerStaysOutOfAgentPrompts(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	path := seedVerifyReport(t, d, m)
+
+	prompts := attendedPrompts(d, m)
+	prompts["verifier prompt"] = buildVerifierPrompt(d, m, "sha1", workDiffView{Range: "aaa111^..HEAD", Stat: " a.go | 1 +"}, "", "")
+	for surface, text := range prompts {
+		for _, unwanted := range []string{path, ShortSHA("def456def456"), verifyProse} {
+			if strings.Contains(text, unwanted) {
+				t.Fatalf("%s carries the verify report (%q):\n%s", surface, unwanted, text)
+			}
+		}
+	}
+}
+
+// TestNeverVerifiedSetShowsNoVerifyReport pins the empty state: a set with no
+// Verify report renders no pointer, entry or section anywhere.
+func TestNeverVerifiedSetShowsNoVerifyReport(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": detail.String()} {
+		if strings.Contains(strings.ToLower(text), "verify report") {
+			t.Fatalf("%s mentions a verify report the set does not have:\n%s", surface, text)
+		}
+	}
+	if _, ok := LatestVerifyReport(d, m); ok {
+		t.Fatal("never-verified set resolved a verify report")
+	}
+}
diff --git a/tasks/verify_report_test.go b/tasks/verify_report_test.go
new file mode 100644
index 00000000..542b4e9c
--- /dev/null
+++ b/tasks/verify_report_test.go
@@ -0,0 +1,198 @@
+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// verifyOnce runs `pop tasks verify` for the fixture's set with the Verifier
+// stubbed to reply raw, returning the prompt it was handed.
+func verifyOnce(t *testing.T, d *Deps, defPath, raw string) string {
+	t.Helper()
+	var prompt string
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output:      &bytes.Buffer{},
+		runVerifier: func(p string) (string, error) { prompt = p; return raw, nil },
+	}); err != nil {
+		t.Fatalf("verifyResolvedSet: %v", err)
+	}
+	return prompt
+}
+
+// verifyReports reads every Verify report filed for the fixture's set, oldest
+// first.
+func verifyReports(t *testing.T, defPath string) []string {
+	t.Helper()
+	dir := filepath.Join(defPath, "demo", VerifyDirName)
+	entries, err := os.ReadDir(dir)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		t.Fatalf("read %s: %v", dir, err)
+	}
+	var docs []string
+	for _, entry := range entries {
+		body, err := os.ReadFile(filepath.Join(dir, entry.Name()))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		docs = append(docs, string(body))
+	}
+	return docs
+}
+
+// TestVerifierWritesAReportOnEveryVerdict: each Verifier invocation files one
+// document whose header stamps the verdict and whose body is the reply's prose
+// with the verdict line lifted off — PASS included, since a green set that
+// records nothing is the case the report exists for (ADR-0245).
+func TestVerifierWritesAReportOnEveryVerdict(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		verdict Verdict
+		prose   string
+	}{
+		{VerdictPass, "FINDINGS: ran go test ./...; criterion 1 is met because the parser handles empty input."},
+		{VerdictFixable, "SUMMARY: tests fail\nFINDINGS: criterion 2 is unmet: TestX fails."},
+		{VerdictNeedsHuman, "FINDINGS: the spec contradicts itself on retention."},
+	} {
+		t.Run(string(tc.verdict), func(t *testing.T) {
+			t.Parallel()
+			d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+			verifyOnce(t, d, defPath, "VERDICT: "+string(tc.verdict)+"\n"+tc.prose+"\n")
+
+			docs := verifyReports(t, defPath)
+			if len(docs) != 1 {
+				t.Fatalf("reports = %d, want 1", len(docs))
+			}
+			doc := docs[0]
+			if got := reportHeaderField(doc, "Verdict"); got != string(tc.verdict) {
+				t.Fatalf("Verdict header = %q, want %s:\n%s", got, tc.verdict, doc)
+			}
+			if got := reportHeaderField(doc, "Work SHA"); got != "sha1" {
+				t.Fatalf("Work SHA header = %q:\n%s", got, doc)
+			}
+			if !strings.Contains(doc, tc.prose) {
+				t.Fatalf("report lost the Verifier's prose:\n%s", doc)
+			}
+			if strings.Contains(doc, "VERDICT:") {
+				t.Fatalf("report kept the verdict line:\n%s", doc)
+			}
+		})
+	}
+}
+
+// TestVerifierReportKeepsAMalformedReply: a reply pop cannot parse still parks
+// NEEDS-HUMAN, and its raw text survives in the report for the human who must
+// read it.
+func TestVerifierReportKeepsAMalformedReply(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	verifyOnce(t, d, defPath, "the code looks alright")
+
+	docs := verifyReports(t, defPath)
+	if len(docs) != 1 {
+		t.Fatalf("reports = %d, want 1", len(docs))
+	}
+	if got := reportHeaderField(docs[0], "Verdict"); got != string(VerdictNeedsHuman) {
+		t.Fatalf("Verdict header = %q, want NEEDS-HUMAN", got)
+	}
+	if !strings.Contains(docs[0], "could not be parsed") || !strings.Contains(docs[0], "the code looks alright") {
+		t.Fatalf("report lost the raw reply:\n%s", docs[0])
+	}
+}
+
+// TestVerifierReportsAccumulateAndOutliveTheCache: a verify-remediate-verify
+// lap leaves one document per invocation, the next Verifier is shown none of
+// them, and invalidation deletes the cached verdict while the reports stay.
+func TestVerifierReportsAccumulateAndOutliveTheCache(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	verifyOnce(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: first-lap-finding\n")
+	prompt := verifyOnce(t, d, defPath, "VERDICT: PASS\nFINDINGS: second-lap-reasons\n")
+
+	if strings.Contains(prompt, "first-lap-finding") || strings.Contains(prompt, VerifyDirName+"-") {
+		t.Fatalf("the Verifier was shown a previous report:\n%s", prompt)
+	}
+	invalidateVerifyVerdicts(d, "/repo/.git", "demo")
+	if stored := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1"); stored != nil {
+		t.Fatalf("cached verdict survived invalidation: %+v", stored)
+	}
+	docs := verifyReports(t, defPath)
+	if len(docs) != 2 {
+		t.Fatalf("reports = %d, want 2 after invalidation", len(docs))
+	}
+	if !strings.Contains(docs[0], "first-lap-finding") || !strings.Contains(docs[1], "second-lap-reasons") {
+		t.Fatalf("lap trail out of order or incomplete:\n%s\n---\n%s", docs[0], docs[1])
+	}
+}
+
+// TestCachedVerdictWritesNoVerifyReport: a verdict read back from the cache
+// invokes no agent, so it has no new reasoning to file.
+func TestCachedVerdictWritesNoVerifyReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	verifyOnce(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: x\n")
+
+	opts := verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		runVerifier: func(string) (string, error) { t.Fatal("a cache hit must not invoke the Verifier"); return "", nil },
+	}
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	if _, err := ensureVerifyVerdict(d, nil, opts, m, "sha1"); err != nil {
+		t.Fatalf("ensureVerifyVerdict: %v", err)
+	}
+	if docs := verifyReports(t, defPath); len(docs) != 1 {
+		t.Fatalf("reports = %d, want only the invoked run's 1", len(docs))
+	}
+}
+
+// TestAcceptWritesAHumanAuthoredReport: a human Accept over a non-PASS
+// judgment files a report pop writes itself — no agent runs — carrying the
+// rationale and the overridden verdict, marked human-authored in the header,
+// and it becomes the set's latest Verify report.
+func TestAcceptWritesAHumanAuthoredReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	verifyOnce(t, d, defPath, "VERDICT: NEEDS-HUMAN\nFINDINGS: the retry policy needs a human call\n")
+
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{}, Accept: true, AcceptNote: "the retry policy is intentional",
+		runVerifier: func(string) (string, error) { t.Fatal("accept must not invoke the Verifier"); return "", nil },
+	}); err != nil {
+		t.Fatalf("verifyResolvedSet accept: %v", err)
+	}
+
+	if docs := verifyReports(t, defPath); len(docs) != 2 {
+		t.Fatalf("reports = %d, want the Verifier's and the Accept's", len(docs))
+	}
+	latest, ok := verifyReport.latest(d, filepath.Join(defPath, "demo"))
+	if !ok {
+		t.Fatal("no latest Verify report")
+	}
+	doc := latest.Body
+	for field, want := range map[string]string{
+		"Verdict":   string(VerdictPass),
+		"Overrides": string(VerdictNeedsHuman),
+		"Verifier":  acceptedVerdictAuthor,
+		"Work SHA":  "sha1",
+	} {
+		if got := reportHeaderField(doc, field); got != want {
+			t.Fatalf("%s header = %q, want %q:\n%s", field, got, want, doc)
+		}
+	}
+	if reportHeaderField(doc, "Verified") == "" {
+		t.Fatalf("report lacks the written stamp:\n%s", doc)
+	}
+	if !strings.Contains(doc, "the retry policy is intentional") {
+		t.Fatalf("report lost the human's rationale:\n%s", doc)
+	}
+}
