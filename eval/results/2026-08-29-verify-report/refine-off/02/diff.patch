new file mode 100644
index 00000000..a5cd564f
--- /dev/null
+++ b/tasks/report.go
@@ -0,0 +1,205 @@
+package tasks
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// reportKind is one pass that publishes a timestamped report into a set's
+// folder. Every report shares its mechanics — the header of facts, the
+// instant in the file name, latest-by-timestamp with every earlier document
+// kept — and differs only in the words below, so a second pass (ADR-0245)
+// takes a kind of its own rather than a copy of Refine's.
+type reportKind struct {
+	// Name is the artifact type, the sub-directory of the set's folder the
+	// reports accumulate in, and the file-name prefix before the instant.
+	Name string
+	// Title opens the document heading and the pointer's summary line.
+	Title string
+	// WrittenField and AgentField label the header facts for when the report
+	// was written and which agent wrote it.
+	WrittenField string
+	AgentField   string
+}
+
+// refineReport is the Refine report (ADR-0214). Its directory sits under the
+// Task-set directory, which lives in pop's Work store rather than in the
+// repository, so no report can ever be staged into a commit.
+var refineReport = reportKind{
+	Name:         ArtifactTypeRefine,
+	Title:        "Refine",
+	WrittenField: "Refined",
+	AgentField:   "Refiner",
+}
+
+// verifyReport is the Verify report (ADR-0245): the Verifier's reasons, one
+// document per invocation. It outlives the verdict cache on purpose — the
+// cache row is deleted on invalidation, and these documents are the record.
+var verifyReport = reportKind{
+	Name:         ArtifactTypeVerify,
+	Title:        "Verify",
+	WrittenField: "Verified",
+	AgentField:   "Verifier",
+}
+
+// reportFileTimeLayout spells the instant in a report's name. The instant is in
+// the file name rather than only in the document, because "the latest" is
+// resolved by timestamp and a directory listing must be able to answer that
+// without opening every file.
+const reportFileTimeLayout = "20060102T150405Z"
+
+// reportDocument is one report on disk: where it is, when it was written, and
+// what it says.
+type reportDocument struct {
+	Path string
+	At   time.Time
+	Body string
+}
+
+func (k reportKind) dir(setDir string) string {
+	return filepath.Join(setDir, k.Name)
+}
+
+func (k reportKind) fileName(at time.Time) string {
+	return k.Name + "-" + at.Format(reportFileTimeLayout) + ".md"
+}
+
+// FileInstant reads a report's name back as the instant it was written, and
+// false for anything else in the directory. Artifacts uses it so a report's
+// own timestamp is its ordering key instead of a second copy of the filename
+// contract.
+func (k reportKind) FileInstant(name string) (time.Time, bool) {
+	stamp, ok := strings.CutPrefix(name, k.Name+"-")
+	if !ok {
+		return time.Time{}, false
+	}
+	stamp, ok = strings.CutSuffix(stamp, ".md")
+	if !ok {
+		return time.Time{}, false
+	}
+	at, err := time.Parse(reportFileTimeLayout, stamp)
+	if err != nil {
+		return time.Time{}, false
+	}
+	return at, true
+}
+
+// latest returns the set's current report — the one with the newest timestamp
+// in its name — and false when the pass has never written one. Every earlier
+// document stays where it is; superseding is a matter of which one the readers
+// take, not of deleting the ones before it (ADR-0214).
+func (k reportKind) latest(d *Deps, setDir string) (reportDocument, bool) {
+	dir := k.dir(setDir)
+	entries, err := d.FS.ReadDir(dir)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	var found reportDocument
+	ok := false
+	for _, entry := range entries {
+		at, isReport := k.FileInstant(entry.Name())
+		if entry.IsDir() || !isReport {
+			continue
+		}
+		if ok && !at.After(found.At) {
+			continue
+		}
+		found, ok = reportDocument{Path: filepath.Join(dir, entry.Name()), At: at}, true
+	}
+	if !ok {
+		return reportDocument{}, false
+	}
+	body, err := d.FS.ReadFile(found.Path)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	found.Body = strings.TrimSpace(string(body))
+	return found, true
+}
+
+// write files a new report under the kind's directory and returns its path. A
+// name already taken (two reports inside one second) advances the instant
+// rather than overwriting: retention is the whole point of the directory, and
+// the names are also the ordering.
+func (k reportKind) write(d *Deps, setDir string, at time.Time, body string) (string, error) {
+	dir := k.dir(setDir)
+	if err := d.FS.MkdirAll(dir, 0o755); err != nil {
+		return "", exitErr(ExitOperational, "create %s directory: %v", k.Name, err)
+	}
+	at = at.UTC().Truncate(time.Second)
+	taken := map[string]bool{}
+	if entries, err := d.FS.ReadDir(dir); err == nil {
+		for _, entry := range entries {
+			taken[entry.Name()] = true
+		}
+	}
+	name := k.fileName(at)
+	for taken[name] {
+		at = at.Add(time.Second)
+		name = k.fileName(at)
+	}
+	path := filepath.Join(dir, name)
+	if err := d.FS.WriteFile(path, []byte(ensureTrailingNewline(body)), 0o644); err != nil {
+		return "", exitErr(ExitOperational, "write %s report: %v", k.Name, err)
+	}
+	return path, nil
+}
+
+// render wraps an agent's prose in the four facts a reader needs to know what
+// the pass looked at: which set, at which commits, by whom and when. They ride
+// the document rather than a side-car because the document leaves pop the
+// moment a human pipes it somewhere.
+//
+// The Work SHA line is the report's own answer to which tree it describes. It
+// is stamped here rather than asked of the agent, because pop read it before
+// the pass began and the agent would only be copying it back.
+func (k reportKind) render(at time.Time, setID, workSHA, commitRange, agent, body string) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "# %s report — %s\n\n", k.Title, setID)
+	fmt.Fprintf(&b, "- %s: %s\n", k.WrittenField, at.UTC().Format(time.RFC3339))
+	if commitRange != "" {
+		fmt.Fprintf(&b, "- Commit range: %s\n", commitRange)
+	}
+	if workSHA != "" {
+		fmt.Fprintf(&b, "- Work SHA: %s\n", ShortSHA(workSHA))
+	}
+	if strings.TrimSpace(agent) != "" {
+		fmt.Fprintf(&b, "- %s: %s\n", k.AgentField, strings.TrimSpace(agent))
+	}
+	fmt.Fprintf(&b, "\n%s", ensureTrailingNewline(strings.TrimSpace(body)))
+	return b.String()
+}
+
+func ensureTrailingNewline(s string) string {
+	if strings.HasSuffix(s, "\n") {
+		return s
+	}
+	return s + "\n"
+}
+
+// reportHeaderField reads one of the "- Field: value" facts render stamps at
+// the top of every report. The header is the document's own record of what it
+// describes, so reading it back beats keeping a side-car that a document copied
+// out of pop would leave behind.
+func reportHeaderField(body, field string) string {
+	prefix := "- " + field + ": "
+	inHeader := false
+	for _, line := range strings.Split(body, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "- ") {
+			// The header is the report's first bullet list; anything after it is
+			// the agent's prose, which may say anything at all.
+			if inHeader {
+				return ""
+			}
+			continue
+		}
+		inHeader = true
+		if rest, ok := strings.CutPrefix(line, prefix); ok {
+			return strings.TrimSpace(rest)
+		}
+	}
+	return ""
+}
