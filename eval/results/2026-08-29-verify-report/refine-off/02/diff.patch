+func verifierReportBody(raw string) string {
+	lines := strings.Split(strings.TrimSpace(raw), "\n")
+	for i, line := range lines {
+		value, ok := verdictLabelValue(line)
+		if !ok {
+			continue
+		}
+		if _, ok := canonicalVerdict(value); !ok {
+			break
+		}
+		var kept []string
+		for j, line := range lines {
+			if j == i {
+				continue
+			}
+			if _, ok := commitSubjectLabelValue(line); ok {
+				continue
+			}
+			kept = append(kept, line)
+		}
+		return strings.TrimSpace(strings.Join(kept, "\n"))
+	}
+	return unparsedFindings(raw)
+}
+
+// acceptedReportAuthor fills the Verify report's Verifier header fact on an
+// Accept, so a reader scanning the header tells it from an agent's report.
+const acceptedReportAuthor = "human (Accept)"
+
+// acceptedReportBody is the Verify report of an Accept: the human's rationale
+// and the verdict their PASS replaced. No agent ran, so pop writes the prose.
+func acceptedReportBody(note string, overridden *store.VerifyVerdict) string {
+	var b strings.Builder
+	b.WriteString("A human accepted this set and recorded a PASS. No Verifier ran; pop wrote this report.\n\n")
+	b.WriteString("## Rationale\n\n")
+	if note == "" {
+		b.WriteString("The human gave no note.\n\n")
+	} else {
+		b.WriteString(note + "\n\n")
+	}
+	b.WriteString("## Overridden verdict\n\n")
+	if overridden == nil {
+		b.WriteString("No verdict was recorded at this work SHA.\n")
+		return b.String()
+	}
+	fmt.Fprintf(&b, "- Verdict: %s\n", overridden.Verdict)
+	if overridden.HumanAuthored {
+		fmt.Fprintf(&b, "- Author: %s\n", acceptedReportAuthor)
+	}
+	if summary := strings.TrimSpace(overridden.Summary); summary != "" {
+		fmt.Fprintf(&b, "- Summary: %s\n", summary)
+	}
+	if findings := strings.TrimSpace(overridden.Findings); findings != "" {
+		b.WriteString("\n" + findings + "\n")
+	}
+	return b.String()
+}
+
 // unparsedFindings is the findings text for a malformed or absent response, so
 // the human is told the Verifier could not be understood rather than seeing a
 // bare NEEDS-HUMAN.
