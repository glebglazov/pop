@@ -0,0 +1,141 @@
+package tasks
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"time"
+)
+
+// verifyProse is the Verify report's body, which no surface may print: each
+// carries a pointer to the document and nothing else (ADR-0245).
+const verifyProse = "SECRET-VERIFY-PROSE"
+
+// seedVerifyReport files one Verify report for the fixture set, as the
+// Verifier would have written it against an older commit, and returns its path.
+func seedVerifyReport(t *testing.T, d *Deps, m *Manifest) string {
+	t.Helper()
+	at := time.Date(2026, 8, 17, 9, 0, 0, 0, time.UTC)
+	body := verifyReport.render(at, "demo", "fed987fed987", "bbb222^..HEAD", "codex", "## Criteria\n\n"+verifyProse)
+	path, err := verifyReport.write(d, m.Dir, at, body)
+	if err != nil {
+		t.Fatalf("write verify report: %v", err)
+	}
+	return path
+}
+
+// TestVerifyPointerReachesHumanSurfacesOnly drives every surface a human reads
+// and every prompt an agent is handed: the first carry the pointer above any
+// Refine pointer, the second carry nothing of it.
+func TestVerifyPointerReachesHumanSurfacesOnly(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	refinePath := seedRefineReport(t, d, m)
+	path := seedVerifyReport(t, d, m)
+
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+
+	for _, s := range []struct {
+		surface string
+		text    string
+		wants   []string
+	}{
+		{"HITL gate", gate, []string{path, "fed987f", "bbb222^..HEAD", "Read the verify report"}},
+		{"detail view", detail.String(), []string{path, "fed987f", "bbb222^..HEAD"}},
+	} {
+		for _, want := range s.wants {
+			if !strings.Contains(s.text, want) {
+				t.Fatalf("%s missing %q:\n%s", s.surface, want, s.text)
+			}
+		}
+		if strings.Contains(s.text, verifyProse) {
+			t.Fatalf("%s inlined the verify report:\n%s", s.surface, s.text)
+		}
+	}
+	if strings.Index(gate, path) > strings.Index(gate, refinePath) {
+		t.Fatalf("gate pointed at the refine report before the verify report:\n%s", gate)
+	}
+
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil {
+		t.Fatalf("Artifacts: %v", err)
+	}
+	if len(artifacts) < 2 || artifacts[0].Path != path || artifacts[1].Path != refinePath {
+		t.Fatalf("expected the verify report first, then the refine report: %+v", artifacts)
+	}
+
+	for name, prompt := range attendedPrompts(d, m) {
+		if strings.Contains(prompt, path) || strings.Contains(prompt, verifyProse) {
+			t.Fatalf("%s carries the verify report:\n%s", name, prompt)
+		}
+	}
+}
+
+// TestHITLGateReadVerifyEntryTakesTheNextKey pins the gate's verify entry: it
+// comes before the refine entry and resolves to its own read action.
+func TestHITLGateReadVerifyEntryTakesTheNextKey(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	seedRefineReport(t, d, m)
+	seedVerifyReport(t, d, m)
+
+	// Re-verify is not offered here, so the verify entry takes key 5.
+	if _, action := hitlGateOutput(t, d, m, "5\n"); action != hitlGateReadVerify {
+		t.Fatalf("expected the verify entry at key 5, got action %d", action)
+	}
+	if _, action := hitlGateOutput(t, d, m, "6\n"); action != hitlGateReadRefine {
+		t.Fatalf("expected the refine entry at key 6, got action %d", action)
+	}
+}
+
+// TestNeverVerifiedSetShowsNoVerifyPointer pins the empty rule: no report, no
+// line, no menu entry, no artifact row.
+func TestNeverVerifiedSetShowsNoVerifyPointer(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	seedRefineReport(t, d, m)
+
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": detail.String()} {
+		lower := strings.ToLower(text)
+		if strings.Contains(lower, "verify report") || strings.Contains(lower, "📝 verify") {
+			t.Fatalf("%s mentions a verify report the set does not have:\n%s", surface, text)
+		}
+	}
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil {
+		t.Fatalf("Artifacts: %v", err)
+	}
+	for _, a := range artifacts {
+		if a.Type == ArtifactTypeVerify {
+			t.Fatalf("unexpected verify artifact: %+v", a)
+		}
+	}
+}
+
+// TestStaleVerifyReportLeavesStatusAlone pins that the report answers why,
+// never whether: a report written against a commit the checkout has moved past
+// changes neither the set's status line nor gains a staleness note of its own.
+func TestStaleVerifyReportLeavesStatusAlone(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	row := &Row{ID: "demo", Status: StatusAwaitingApproval, Progress: "1/2 done"}
+
+	var before bytes.Buffer
+	RenderTaskSetDetail(d, &before, "demo", row, m)
+	seedVerifyReport(t, d, m)
+	var after bytes.Buffer
+	RenderTaskSetDetail(d, &after, "demo", row, m)
+
+	header := func(s string) string { return strings.SplitN(s, "\n", 2)[0] }
+	if header(before.String()) != header(after.String()) {
+		t.Fatalf("status line moved: %q → %q", header(before.String()), header(after.String()))
+	}
+	if strings.Contains(strings.ToLower(after.String()), "out of date") {
+		t.Fatalf("detail view judged the report's staleness:\n%s", after.String())
+	}
+}
