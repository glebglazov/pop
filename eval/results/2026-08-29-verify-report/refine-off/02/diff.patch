@@ -0,0 +1,237 @@
+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// verifyDemo runs one real Verifier invocation for the fixture set through the
+// path `pop tasks verify` takes, with reply standing in for the agent's answer
+// and the prompt it was shown handed back.
+func verifyDemo(t *testing.T, d *Deps, defPath, reply string) string {
+	t.Helper()
+	var prompt string
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{},
+		runVerifier: func(p string) (string, error) {
+			prompt = p
+			return reply, nil
+		},
+	}); err != nil {
+		t.Fatalf("verifyResolvedSet: %v", err)
+	}
+	return prompt
+}
+
+// verifyReportBodies returns every Verify report filed for the fixture set,
+// oldest first.
+func verifyReportBodies(t *testing.T, defPath string) []string {
+	t.Helper()
+	dir := filepath.Join(defPath, "demo", ArtifactTypeVerify)
+	entries, err := os.ReadDir(dir)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		t.Fatalf("read reports: %v", err)
+	}
+	var names []string
+	for _, entry := range entries {
+		if _, ok := verifyReport.FileInstant(entry.Name()); !ok {
+			t.Fatalf("unexpected file %q in the Verify report directory", entry.Name())
+		}
+		names = append(names, entry.Name())
+	}
+	sort.Strings(names)
+	var bodies []string
+	for _, name := range names {
+		body, err := os.ReadFile(filepath.Join(dir, name))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		bodies = append(bodies, string(body))
+	}
+	return bodies
+}
+
+// TestVerifierInvocationFilesOneReportPerVerdict: a verify-remediate-verify lap
+// leaves one stamped document per invocation, PASS included, each carrying the
+// Verifier's prose without the verdict line or the commit subject meant for pop.
+func TestVerifierInvocationFilesOneReportPerVerdict(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1abcdef\n", "", ""))
+
+	verifyDemo(t, d, defPath, "VERDICT: FIXABLE\nSUMMARY: wire the flag\nCOMMIT-SUBJECT: fix: wire the flag\nFINDINGS: criterion 2 is unmet — the flag is never read\n")
+	verifyDemo(t, d, defPath, "VERDICT: NEEDS-HUMAN\nFINDINGS: the spec contradicts itself on retries\n")
+	verifyDemo(t, d, defPath, "VERDICT: PASS\nFINDINGS: ran the suite; criterion 1 is met because the flag is read in main\n")
+
+	reports := verifyReportBodies(t, defPath)
+	if len(reports) != 3 {
+		t.Fatalf("want 3 reports, one per invocation, got %d", len(reports))
+	}
+	wantProse := []string{
+		"criterion 2 is unmet — the flag is never read",
+		"the spec contradicts itself on retries",
+		"criterion 1 is met because the flag is read in main",
+	}
+	for i, report := range reports {
+		if !strings.HasPrefix(report, "# Verify report — demo\n") {
+			t.Errorf("report %d heading:\n%s", i, report)
+		}
+		if got := reportHeaderField(report, "Work SHA"); got != ShortSHA("sha1abcdef") {
+			t.Errorf("report %d Work SHA = %q", i, got)
+		}
+		if !strings.Contains(report, wantProse[i]) {
+			t.Errorf("report %d lacks the Verifier's reasons %q:\n%s", i, wantProse[i], report)
+		}
+		if strings.Contains(report, "VERDICT:") || strings.Contains(report, "COMMIT-SUBJECT:") {
+			t.Errorf("report %d carries a line meant for pop:\n%s", i, report)
+		}
+	}
+	if stored := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1abcdef"); stored == nil || stored.Verdict != "PASS" {
+		t.Fatalf("stored verdict = %+v, want PASS", stored)
+	}
+}
+
+// TestVerifierMalformedReplyKeepsRawTextInReport: a reply pop cannot read still
+// parks the set on NEEDS-HUMAN, and its report keeps the raw text a human needs.
+func TestVerifierMalformedReplyKeepsRawTextInReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+
+	verifyDemo(t, d, defPath, "I looked around and it seems fine to me.\n")
+	verifyDemo(t, d, defPath, "")
+
+	if stored := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1"); stored == nil || stored.Verdict != "NEEDS-HUMAN" {
+		t.Fatalf("stored verdict = %+v, want NEEDS-HUMAN", stored)
+	}
+	reports := verifyReportBodies(t, defPath)
+	if len(reports) != 2 {
+		t.Fatalf("want 2 reports, got %d", len(reports))
+	}
+	if !strings.Contains(reports[0], "Raw response:\nI looked around and it seems fine to me.") {
+		t.Errorf("malformed reply report lost the raw text:\n%s", reports[0])
+	}
+	if !strings.Contains(reports[1], "The Verifier produced no output") {
+		t.Errorf("absent reply report does not say so:\n%s", reports[1])
+	}
+}
+
+// TestCachedVerdictWritesNoReport: the drain's cache-first read serves a stored
+// verdict without an agent, and only a real invocation files a report.
+func TestCachedVerdictWritesNoReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	seedVerdict(t, d, store.VerifyVerdict{Repo: "/repo/.git", SetID: "demo", WorkSHA: "sha1", Verdict: "PASS"})
+
+	opts := verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		runVerifier: func(string) (string, error) {
+			t.Fatalf("a cached verdict invoked the Verifier")
+			return "", nil
+		},
+	}
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	if _, err := ensureVerifyVerdict(d, nil, opts, m, "sha1"); err != nil {
+		t.Fatalf("ensureVerifyVerdict: %v", err)
+	}
+	if reports := verifyReportBodies(t, defPath); len(reports) != 0 {
+		t.Fatalf("cache hit filed %d reports", len(reports))
+	}
+}
+
+// TestVerifyReportsSurviveInvalidation: invalidation deletes the verdict cache
+// and leaves the reports, which are the record the cache never was (ADR-0245).
+func TestVerifyReportsSurviveInvalidation(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	verifyDemo(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: criterion 2 is unmet\n")
+
+	s, err := openDrainStore(d)
+	if err != nil {
+		t.Fatalf("open store: %v", err)
+	}
+	if err := s.CaptureNoteThenInvalidate("/repo/.git", "demo"); err != nil {
+		t.Fatalf("invalidate: %v", err)
+	}
+	_ = d.CloseStore()
+
+	if stored := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1"); stored != nil {
+		t.Fatalf("verdict survived invalidation: %+v", stored)
+	}
+	if reports := verifyReportBodies(t, defPath); len(reports) != 1 || !strings.Contains(reports[0], "criterion 2 is unmet") {
+		t.Fatalf("reports after invalidation = %q", reports)
+	}
+}
+
+// TestVerifierPromptCarriesNoPreviousReport: the Verifier judges each tree fresh
+// and is never shown its own earlier reasons, which would anchor the verdict.
+func TestVerifierPromptCarriesNoPreviousReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	verifyDemo(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: the distinctive-earlier-finding\n")
+
+	prompt := verifyDemo(t, d, defPath, "VERDICT: PASS\nFINDINGS: all met\n")
+	if strings.Contains(prompt, "distinctive-earlier-finding") || strings.Contains(prompt, "Verify report — demo") {
+		t.Fatalf("the Verifier prompt carries a previous report:\n%s", prompt)
+	}
+}
+
+// TestAcceptFilesHumanAuthoredReport: a human PASS over a non-PASS verdict files
+// a Verify report beside the Verifier's own — same directory, stamp and header —
+// carrying the human's rationale and the verdict it overrode, marked as the
+// human's, with no agent run. Being the newest, it is the one readers take.
+func TestAcceptFilesHumanAuthoredReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1abcdef\n", "", ""))
+	verifyDemo(t, d, defPath, "VERDICT: NEEDS-HUMAN\nSUMMARY: retries look unbounded\nFINDINGS: the retry loop has no cap\n")
+
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{}, Accept: true, AcceptNote: "the cap lives in the caller",
+		runVerifier: func(string) (string, error) { t.Fatal("accept must not invoke the Verifier"); return "", nil },
+	}); err != nil {
+		t.Fatalf("accept: %v", err)
+	}
+
+	reports := verifyReportBodies(t, defPath)
+	if len(reports) != 2 {
+		t.Fatalf("want the Verifier's report and the Accept's, got %d", len(reports))
+	}
+	accepted := reports[1]
+	if !strings.HasPrefix(accepted, "# Verify report — demo\n") {
+		t.Errorf("heading:\n%s", accepted)
+	}
+	if reportHeaderField(accepted, "Verified") == "" {
+		t.Errorf("accepted report has no Verified stamp:\n%s", accepted)
+	}
+	for _, field := range []string{"Commit range", "Work SHA"} {
+		if got, want := reportHeaderField(accepted, field), reportHeaderField(reports[0], field); got != want {
+			t.Errorf("header %q = %q, want %q as on the Verifier's report", field, got, want)
+		}
+	}
+	if got := reportHeaderField(accepted, "Verifier"); got != acceptedReportAuthor {
+		t.Errorf("Verifier header = %q, want %q", got, acceptedReportAuthor)
+	}
+	for _, want := range []string{"No Verifier ran", "the cap lives in the caller", "- Verdict: NEEDS-HUMAN", "retries look unbounded", "the retry loop has no cap"} {
+		if !strings.Contains(accepted, want) {
+			t.Errorf("accepted report lacks %q:\n%s", want, accepted)
+		}
+	}
+
+	setDir := filepath.Join(defPath, "demo")
+	latest, ok := verifyReport.latest(d, setDir)
+	if !ok || latest.Body != strings.TrimSpace(accepted) {
+		t.Fatalf("latest report is not the Accept's:\n%s", latest.Body)
+	}
+}
