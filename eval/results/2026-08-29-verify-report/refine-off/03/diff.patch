+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// verifyReportFiles reads every Verify report the set holds, oldest first.
+func verifyReportFiles(t *testing.T, setDir string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(verifyReport.dir(setDir))
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		t.Fatalf("read verify reports: %v", err)
+	}
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Name())
+	}
+	sort.Strings(names)
+	var bodies []string
+	for _, name := range names {
+		body, err := os.ReadFile(filepath.Join(verifyReport.dir(setDir), name))
+		if err != nil {
+			t.Fatalf("read %s: %v", name, err)
+		}
+		bodies = append(bodies, string(body))
+	}
+	return bodies
+}
+
+// TestVerifierWritesOneReportPerInvocation: every Verifier invocation, whatever
+// its verdict, leaves its own stamped document whose body is the reply without
+// the verdict line — and the verdict still parses as it always has. The later
+// invocation's prompt carries none of the earlier report.
+func TestVerifierWritesOneReportPerInvocation(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("abc123abc123\n", "", ""))
+	replies := []string{
+		"VERDICT: FIXABLE\nSUMMARY: wire the flag\nFINDINGS: criterion 2 unmet: the flag is never read\n",
+		"VERDICT: NEEDS-HUMAN\nFINDINGS: the retry policy needs a human call\n",
+		"VERDICT: PASS\nFINDINGS: read cmd/flag.go; criterion 1 met because the flag is parsed, criterion 2 met because it is read\n",
+	}
+	var prompts []string
+	for _, reply := range replies {
+		if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+			Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+			runVerifier: func(prompt string) (string, error) {
+				prompts = append(prompts, prompt)
+				return reply, nil
+			},
+		}); err != nil {
+			t.Fatalf("verifyResolvedSet: %v", err)
+		}
+	}
+	if stored := readStoredVerdict(t, d, "/repo/.git", "demo", "abc123abc123"); stored == nil || stored.Verdict != "PASS" {
+		t.Fatalf("stored verdict = %+v, want the last run's PASS", stored)
+	}
+
+	reports := verifyReportFiles(t, filepath.Join(defPath, "demo"))
+	if len(reports) != len(replies) {
+		t.Fatalf("got %d reports, want one per invocation (%d)", len(reports), len(replies))
+	}
+	for i, want := range []struct{ verdict, prose string }{
+		{"FIXABLE", "criterion 2 unmet: the flag is never read"},
+		{"NEEDS-HUMAN", "the retry policy needs a human call"},
+		{"PASS", "criterion 1 met because the flag is parsed"},
+	} {
+		report := reports[i]
+		if got := reportHeaderField(report, "Verdict"); got != want.verdict {
+			t.Fatalf("report %d verdict = %q, want %q:\n%s", i, got, want.verdict, report)
+		}
+		if got := reportHeaderField(report, "Work SHA"); got != "abc123abc123" {
+			t.Fatalf("report %d work SHA = %q:\n%s", i, got, report)
+		}
+		if !strings.Contains(report, want.prose) || strings.Contains(report, "VERDICT:") {
+			t.Fatalf("report %d should carry the prose without the verdict line:\n%s", i, report)
+		}
+	}
+	for _, prompt := range prompts[1:] {
+		if strings.Contains(prompt, "the flag is never read") || strings.Contains(prompt, "Verify report —") {
+			t.Fatalf("a later Verifier prompt carries an earlier report:\n%s", prompt)
+		}
+	}
+}
+
+// TestVerifierReportKeepsMalformedReply: a reply with no readable verdict still
+// parks NEEDS-HUMAN, and its report keeps the raw text a human must judge.
+func TestVerifierReportKeepsMalformedReply(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	res, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		runVerifier: func(string) (string, error) { return "I looked around and it seems mostly fine", nil },
+	})
+	if err != nil {
+		t.Fatalf("verifyResolvedSet: %v", err)
+	}
+	if res.Verdict != VerdictNeedsHuman {
+		t.Fatalf("verdict = %s, want NEEDS-HUMAN", res.Verdict)
+	}
+	reports := verifyReportFiles(t, filepath.Join(defPath, "demo"))
+	if len(reports) != 1 || !strings.Contains(reports[0], "I looked around and it seems mostly fine") || reportHeaderField(reports[0], "Verdict") != "NEEDS-HUMAN" {
+		t.Fatalf("malformed reply's report lost its raw text: %q", reports)
+	}
+}
+
+// TestVerifyReportOnlyFromAnInvocation: a verdict the drain reads back from the
+// cache invokes no agent and so writes no report.
+func TestVerifyReportOnlyFromAnInvocation(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	opts := verifyCoreOptions{Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo"}
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	opts.runVerifier = func(string) (string, error) { return "VERDICT: FIXABLE\nFINDINGS: criterion 2 unmet\n", nil }
+	if _, err := ensureVerifyVerdict(d, nil, opts, m, "sha1"); err != nil {
+		t.Fatalf("first ensureVerifyVerdict: %v", err)
+	}
+	opts.runVerifier = func(string) (string, error) { t.Fatal("a cached verdict must not invoke the Verifier"); return "", nil }
+	if _, err := ensureVerifyVerdict(d, nil, opts, m, "sha1"); err != nil {
+		t.Fatalf("cached ensureVerifyVerdict: %v", err)
+	}
+	if reports := verifyReportFiles(t, m.Dir); len(reports) != 1 {
+		t.Fatalf("got %d reports, want only the invocation's one", len(reports))
+	}
+}
+
+// TestVerifyReportSurvivesInvalidation: invalidation deletes the cached verdict
+// but never the reports — they are the record the cache was not.
+func TestVerifyReportSurvivesInvalidation(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("sha1\n", "", ""))
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		runVerifier: func(string) (string, error) { return "VERDICT: FIXABLE\nFINDINGS: criterion 2 unmet\n", nil },
+	}); err != nil {
+		t.Fatalf("verifyResolvedSet: %v", err)
+	}
+	invalidateVerifyVerdicts(d, "/repo/.git", "demo")
+	if stored := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1"); stored != nil {
+		t.Fatalf("cached verdict survived invalidation: %+v", stored)
+	}
+	if reports := verifyReportFiles(t, filepath.Join(defPath, "demo")); len(reports) != 1 || !strings.Contains(reports[0], "criterion 2 unmet") {
+		t.Fatalf("report did not survive invalidation: %q", reports)
+	}
+}
+
+// TestAcceptWritesHumanAuthoredReport: an Accept over the Verifier's FIXABLE
+// leaves a pop-rendered report that carries the human's rationale, names the
+// overridden verdict, says a human wrote it, and becomes the set's latest
+// report — all without invoking an agent.
+func TestAcceptWritesHumanAuthoredReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("shaACC\n", "", ""))
+	opts := verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo", Output: &bytes.Buffer{},
+		runVerifier: func(string) (string, error) {
+			return "VERDICT: FIXABLE\nFINDINGS: the retry loop never gives up\n", nil
+		},
+	}
+	if _, err := verifyResolvedSet(d, nil, opts); err != nil {
+		t.Fatalf("verify: %v", err)
+	}
+	opts.Accept, opts.AcceptNote = true, "the retry loop is bounded by the caller's context"
+	opts.runVerifier = func(string) (string, error) { t.Fatal("accept must not invoke the Verifier"); return "", nil }
+	if _, err := verifyResolvedSet(d, nil, opts); err != nil {
+		t.Fatalf("accept: %v", err)
+	}
+
+	setDir := filepath.Join(defPath, "demo")
+	reports := verifyReportFiles(t, setDir)
+	if len(reports) != 2 {
+		t.Fatalf("got %d reports, want the Verifier's and the Accept's", len(reports))
+	}
+	accepted := reports[1]
+	for field, want := range map[string]string{
+		"Verdict":     "PASS",
+		"Overrode":    "FIXABLE",
+		"Authored by": humanAuthor,
+		"Work SHA":    "shaACC",
+		"Verifier":    "",
+	} {
+		if got := reportHeaderField(accepted, field); got != want {
+			t.Fatalf("accepted report %s = %q, want %q:\n%s", field, got, want, accepted)
+		}
+	}
+	for _, want := range []string{"the retry loop is bounded by the caller's context", "the retry loop never gives up"} {
+		if !strings.Contains(accepted, want) {
+			t.Fatalf("accepted report missing %q:\n%s", want, accepted)
+		}
+	}
+	if reportHeaderField(reports[0], "Authored by") != "" {
+		t.Fatalf("the Verifier's report claims a human author:\n%s", reports[0])
+	}
+
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	pointer, ok := verifyReport.latestPointer(d, m)
+	if !ok {
+		t.Fatal("no latest Verify report")
+	}
+	latest, err := os.ReadFile(pointer.Path)
+	if err != nil || string(latest) != accepted {
+		t.Fatalf("latest report = %q (%v), want the Accept's", latest, err)
+	}
+}
+
+// TestAcceptWithNoPriorVerdictSaysSo: an Accept with nothing recorded at the
+// SHA still files its report, and names no verdict it did not override.
+func TestAcceptWithNoPriorVerdictSaysSo(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("shaNEW\n", "", ""))
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{}, Accept: true,
+	}); err != nil {
+		t.Fatalf("accept: %v", err)
+	}
+	reports := verifyReportFiles(t, filepath.Join(defPath, "demo"))
+	if len(reports) != 1 || reportHeaderField(reports[0], "Overrode") != "none recorded at this work SHA" || !strings.Contains(reports[0], "no note") {
+		t.Fatalf("accept with no prior verdict: %q", reports)
+	}
+}
