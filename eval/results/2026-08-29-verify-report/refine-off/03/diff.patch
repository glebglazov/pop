@@ -0,0 +1,147 @@
+package tasks
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"time"
+)
+
+// verifyProse is the Verifier's reasoning: no surface may print it, only point
+// at the document that holds it (ADR-0245).
+const verifyProse = "SECRET-VERIFY-PROSE"
+
+// seedVerifyReport files one Verify report for the fixture set, as a Verifier
+// invocation against workSHA would have written it, and returns its path.
+func seedVerifyReport(t *testing.T, d *Deps, m *Manifest, workSHA string) string {
+	t.Helper()
+	at := time.Date(2026, 8, 17, 9, 30, 0, 0, time.UTC)
+	doc := verifyReport.render(at, "demo", workSHA, "bbb222^..HEAD", "claude", verifyProse, reportFact{Label: "Verdict", Value: string(VerdictFixable)})
+	path, err := verifyReport.write(d, m.Dir, at, doc)
+	if err != nil {
+		t.Fatalf("write verify report: %v", err)
+	}
+	return path
+}
+
+// TestVerifyReportReachesTheHumanSurfaces drives every surface a human reads:
+// the gate's preamble and paging entry, the detail view and the Artifact list
+// each carry the pointer, and none carries the reasoning itself.
+func TestVerifyReportReachesTheHumanSurfaces(t *testing.T) {
+	d, m := hitlFixture(t)
+	refinePath := seedRefineReport(t, d, m)
+	verifyPath := seedVerifyReport(t, d, m, "def456def456")
+
+	gate, action := hitlGateOutput(t, d, m, "5\n")
+	if action != hitlGateReadVerify {
+		t.Fatalf("expected the verify entry at key 5, got action %d", action)
+	}
+	if _, refineAction := hitlGateOutput(t, d, m, "6\n"); refineAction != hitlGateReadRefine {
+		t.Fatalf("expected the refine entry at key 6, got action %d", refineAction)
+	}
+	verifyLine := strings.Index(gate, "Verify of def456def456 (bbb222^..HEAD), written 2026-08-17 09:30Z: "+verifyPath)
+	refineLine := strings.Index(gate, "Refine of abc123a")
+	if verifyLine < 0 || refineLine < 0 || verifyLine > refineLine {
+		t.Fatalf("gate preamble should name the verify report above the refine report:\n%s", gate)
+	}
+	if !strings.Contains(gate, "Read the verify report (no agent runs)") {
+		t.Fatalf("gate missing the verify paging entry:\n%s", gate)
+	}
+
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+	for _, want := range []string{"VERIFY REPORT", verifyPath, "def456def456"} {
+		if !strings.Contains(detail.String(), want) {
+			t.Fatalf("detail view missing %q:\n%s", want, detail.String())
+		}
+	}
+
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil {
+		t.Fatalf("Artifacts: %v", err)
+	}
+	if len(artifacts) < 2 || artifacts[0].Path != verifyPath || artifacts[1].Path != refinePath {
+		t.Fatalf("expected the verify report ranked above the refine report, got %+v", artifacts)
+	}
+
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": detail.String()} {
+		if strings.Contains(text, verifyProse) {
+			t.Fatalf("%s inlined the verify report:\n%s", surface, text)
+		}
+	}
+
+	runner := &fakeAttendedRunner{}
+	d.Runner = runner
+	t.Setenv("PAGER", "mypager")
+	var out bytes.Buffer
+	pageReportDocument(d, strings.NewReader(""), "/rt", &out, latestGateReports(d, m).verify)
+	if runner.attendedCalls != 1 || runner.name != "mypager" || strings.Join(runner.args, " ") != verifyPath {
+		t.Fatalf("expected the pager over the verify report, got %d calls of %s %v", runner.attendedCalls, runner.name, runner.args)
+	}
+}
+
+// TestVerifyReportStaysOutOfAgentPrompts: an agent sent to fix something has the
+// findings in its task body already, so no agent-facing prompt points at the
+// report (ADR-0245).
+func TestVerifyReportStaysOutOfAgentPrompts(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	path := seedVerifyReport(t, d, m, "def456def456")
+
+	for name, prompt := range map[string]string{
+		"hitl":          BuildHITLAssistancePrompt(d, "demo", m, m.Tasks[1], "/rt"),
+		"failed":        BuildFailedAssistancePrompt(d, "demo", m, m.Tasks[0], "/rt"),
+		"verify-failed": BuildVerifyFailedAssistancePrompt(d, "demo", m, "def456def456", "criterion 2 unmet", "/rt"),
+		"interrupt":     BuildInterruptAssistancePrompt(d, "demo", m, m.Tasks[0], "/rt"),
+		"assist":        BuildAssistPrompt(d, "demo", m, StatusVerifyFailed, "/rt", "criterion 2 unmet"),
+	} {
+		if strings.Contains(prompt, path) || strings.Contains(prompt, verifyProse) || strings.Contains(strings.ToLower(prompt), "verify report") {
+			t.Fatalf("%s prompt carries the verify report:\n%s", name, prompt)
+		}
+	}
+}
+
+// TestNeverVerifiedSetShowsNoVerifyReport pins the empty rule: a set with no
+// Verify report renders nothing about one on any human surface.
+func TestNeverVerifiedSetShowsNoVerifyReport(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": detail.String()} {
+		if strings.Contains(strings.ToLower(text), "verify report") || strings.Contains(text, "🔎") {
+			t.Fatalf("%s mentions a verify report the set does not have:\n%s", surface, text)
+		}
+	}
+	if artifacts, err := Artifacts(d, m.Dir); err != nil || len(artifacts) != 0 {
+		t.Fatalf("expected no artifacts, got %+v (%v)", artifacts, err)
+	}
+}
+
+// TestVerifyReportAgeIsNotStatus: a report written against a commit the
+// checkout has moved past changes neither the set's status nor its badge —
+// those stay the Verified-at badge's answer (ADR-0245).
+func TestVerifyReportAgeIsNotStatus(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	row := &Row{ID: "demo", Status: StatusAwaitingApproval, Progress: "1/2"}
+
+	var before bytes.Buffer
+	RenderTaskSetDetail(d, &before, "demo", row, m)
+	seedVerifyReport(t, d, m, "0ld0ld0ld0ld")
+	var after bytes.Buffer
+	RenderTaskSetDetail(d, &after, "demo", row, m)
+
+	header := func(s string) string { return strings.SplitN(s, "\n", 2)[0] }
+	if header(before.String()) != header(after.String()) {
+		t.Fatalf("a stale report moved the set's status:\nbefore: %s\nafter:  %s", header(before.String()), header(after.String()))
+	}
+	for _, word := range []string{"stale", "out of date", "drift"} {
+		if strings.Contains(strings.ToLower(after.String()), word) {
+			t.Fatalf("detail view judged the report's age (%q):\n%s", word, after.String())
+		}
+	}
+}
