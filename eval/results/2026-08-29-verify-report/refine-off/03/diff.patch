diff --git a/tasks/verify_report.go b/tasks/verify_report.go
new file mode 100644
index 00000000..976bec1f
--- /dev/null
+++ b/tasks/verify_report.go
@@ -0,0 +1,108 @@
+package tasks
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// verifyDirName is the sub-directory of a set's folder where Verify reports
+// accumulate.
+const verifyDirName = "verify"
+
+// verifyReport is the Verifier's report (ADR-0245): its reasoning behind each
+// verdict, one document per invocation.
+var verifyReport = reportPass{
+	artifactType: ArtifactTypeVerify,
+	dirName:      verifyDirName,
+	noun:         "Verify",
+	writtenLabel: "Verified",
+	agentLabel:   "Verifier",
+}
+
+// writeVerifyReport files the report for one Verifier invocation. It is called
+// only where an agent actually answered: a verdict read back from the cache, or
+// one pop stood in for without a Verifier, has no reasoning to record.
+//
+// The report is never shown to a later Verifier. The verdict gates a drain, and
+// a judge that reads its own earlier answer anchors on it (ADR-0245).
+func writeVerifyReport(d *Deps, m *Manifest, setID, workSHA, commitRange, agent string, verdict Verdict, raw string) error {
+	at := d.Now().UTC()
+	doc := verifyReport.render(at, setID, workSHA, commitRange, agent, verifierReportBody(raw), reportFact{Label: "Verdict", Value: string(verdict)})
+	_, err := verifyReport.write(d, m.Dir, at, doc)
+	return err
+}
+
+// verifierReportBody lifts the verdict line off the front of a Verifier's reply
+// and keeps the prose that justifies it, the way splitRefinerReply lifts the
+// commit subject: the verdict is pop's channel and already sits in the header,
+// while the rest is what a human reads. It finds the verdict line by the same
+// rule ParseVerdict does — the first line that opens with the label — so the
+// report and the cached verdict never disagree about which line was the
+// verdict. A reply ParseVerdict could not read keeps its whole text, through the
+// same findings the cache records for it.
+func verifierReportBody(raw string) string {
+	lines := strings.Split(strings.TrimSpace(raw), "\n")
+	for i, line := range lines {
+		value, ok := verdictLabelValue(line)
+		if !ok {
+			continue
+		}
+		if _, ok := canonicalVerdict(value); !ok {
+			break
+		}
+		return strings.TrimSpace(strings.Join(append(append([]string{}, lines[:i]...), lines[i+1:]...), "\n"))
+	}
+	return unparsedFindings(raw)
+}
+
+// humanAuthor is the "Authored by" fact of an Accepted verdict's report. A
+// Verifier-authored report carries a "Verifier" line instead, so a reader
+// scanning the set's reports tells the two apart from the header alone.
+const humanAuthor = "a human (Accept, ADR-0103)"
+
+// writeAcceptedVerifyReport files the report for an Accept: a human recording a
+// PASS over the Verifier's judgment. No agent ran, so pop renders the whole
+// document from the human's note and the verdict it replaced — overridden is the
+// row that stood at the work SHA before the Accept, nil when there was none.
+func writeAcceptedVerifyReport(d *Deps, m *Manifest, setID, workSHA, commitRange string, overridden *store.VerifyVerdict, note string) error {
+	at := d.Now().UTC()
+	doc := verifyReport.render(at, setID, workSHA, commitRange, "", acceptedReportBody(overridden, note),
+		reportFact{Label: "Verdict", Value: string(VerdictPass)},
+		reportFact{Label: "Authored by", Value: humanAuthor},
+		reportFact{Label: "Overrode", Value: overriddenVerdictName(overridden)},
+	)
+	_, err := verifyReport.write(d, m.Dir, at, doc)
+	return err
+}
+
+func overriddenVerdictName(overridden *store.VerifyVerdict) string {
+	if overridden == nil || strings.TrimSpace(overridden.Verdict) == "" {
+		return "none recorded at this work SHA"
+	}
+	return overridden.Verdict
+}
+
+// acceptedReportBody answers the question an Accepted set raises — why is this
+// green when the findings said otherwise? — with the human's rationale and the
+// findings it set aside.
+func acceptedReportBody(overridden *store.VerifyVerdict, note string) string {
+	var b strings.Builder
+	b.WriteString("## Accepted by a human\n\n")
+	if overridden != nil && strings.TrimSpace(overridden.Verdict) != "" {
+		fmt.Fprintf(&b, "A human recorded this PASS over the Verifier's %s judgment. No Verifier ran.\n\n", overridden.Verdict)
+	} else {
+		b.WriteString("A human recorded this PASS. No Verifier ran, and no earlier verdict was recorded at this work SHA.\n\n")
+	}
+	b.WriteString("### Rationale\n\n")
+	if note = strings.TrimSpace(note); note != "" {
+		b.WriteString(note + "\n")
+	} else {
+		b.WriteString("(The human gave no note.)\n")
+	}
+	if overridden != nil && strings.TrimSpace(overridden.Findings) != "" {
+		fmt.Fprintf(&b, "\n### Overridden findings\n\n%s\n", strings.TrimSpace(overridden.Findings))
+	}
+	return b.String()
+}
