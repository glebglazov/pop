new file mode 100644
index 00000000..1fabd07a
--- /dev/null
+++ b/tasks/report.go
@@ -0,0 +1,222 @@
+package tasks
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// reportFileTimeLayout spells the instant in a report's file name. The instant
+// is in the name rather than only in the document, because "the latest" is
+// resolved by timestamp and a directory listing must be able to answer that
+// without opening every file.
+const reportFileTimeLayout = "20060102T150405Z"
+
+// reportKind is one pass's published report: Refine's and verification's share
+// every mechanic — a header of facts, one timestamped file per pass under the
+// set's own subdirectory, the newest superseding the rest — and differ only in
+// the words below (ADR-0245). The directory sits under the Task-set directory,
+// which lives in pop's Work store rather than in the repository, so no report
+// can ever be staged into a commit (ADR-0214).
+type reportKind struct {
+	// Dir is the set's subdirectory the reports accumulate in, and FilePrefix
+	// the start of each report's name in it.
+	Dir        string
+	FilePrefix string
+	// Title heads the document; Noun opens the pointer's one-line summary.
+	Title string
+	Noun  string
+	// WrittenField and AuthorField name the header's when and by-whom facts.
+	WrittenField string
+	AuthorField  string
+}
+
+// refineReports is where Refine reports are filed (ADR-0240).
+var refineReports = reportKind{
+	Dir:          RefineDirName,
+	FilePrefix:   "refine-",
+	Title:        "Refine report",
+	Noun:         "Refine",
+	WrittenField: "Refined",
+	AuthorField:  "Refiner",
+}
+
+// verifyReports is where Verify reports are filed (ADR-0245).
+var verifyReports = reportKind{
+	Dir:          VerifyDirName,
+	FilePrefix:   "verify-",
+	Title:        "Verify report",
+	Noun:         "Verify",
+	WrittenField: "Verified",
+	AuthorField:  "Verifier",
+}
+
+// reportDocument is one report on disk: where it is, when it was written, and
+// what it says.
+type reportDocument struct {
+	Path string
+	At   time.Time
+	Body string
+}
+
+// reportFact is one "- Field: value" line of a report's header.
+type reportFact struct {
+	Field string
+	Value string
+}
+
+// reportHeader is the facts a reader needs to know what a report describes:
+// which set, at which commits, by whom and when, plus any the pass adds of its
+// own. They ride the document rather than a side-car because the document
+// leaves pop the moment a human pipes it somewhere.
+type reportHeader struct {
+	At          time.Time
+	SetID       string
+	WorkSHA     string
+	CommitRange string
+	Author      string
+	Facts       []reportFact
+}
+
+// render wraps a pass's prose in its header. The Work SHA line is the report's
+// own answer to which tree it describes; it is stamped by pop rather than asked
+// of the agent, because pop read it before the pass began and the agent would
+// only be copying it back.
+func (k reportKind) render(h reportHeader, body string) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "# %s — %s\n\n", k.Title, h.SetID)
+	fmt.Fprintf(&b, "- %s: %s\n", k.WrittenField, h.At.UTC().Format(time.RFC3339))
+	if h.CommitRange != "" {
+		fmt.Fprintf(&b, "- Commit range: %s\n", h.CommitRange)
+	}
+	if h.WorkSHA != "" {
+		fmt.Fprintf(&b, "- Work SHA: %s\n", ShortSHA(h.WorkSHA))
+	}
+	if author := strings.TrimSpace(h.Author); author != "" {
+		fmt.Fprintf(&b, "- %s: %s\n", k.AuthorField, author)
+	}
+	for _, fact := range h.Facts {
+		if value := strings.TrimSpace(fact.Value); value != "" {
+			fmt.Fprintf(&b, "- %s: %s\n", fact.Field, value)
+		}
+	}
+	fmt.Fprintf(&b, "\n%s", ensureTrailingNewline(strings.TrimSpace(body)))
+	return b.String()
+}
+
+// write files a new report under the set's directory for this kind and returns
+// its path. A name already taken (two reports inside one second) advances the
+// instant rather than overwriting: retention is the whole point of the
+// directory, and the names are also the ordering.
+func (k reportKind) write(d *Deps, setDir string, at time.Time, body string) (string, error) {
+	noun := strings.ToLower(k.Title)
+	dir := filepath.Join(setDir, k.Dir)
+	if err := d.FS.MkdirAll(dir, 0o755); err != nil {
+		return "", exitErr(ExitOperational, "create %s directory: %v", k.Dir, err)
+	}
+	at = at.UTC().Truncate(time.Second)
+	taken := map[string]bool{}
+	if entries, err := d.FS.ReadDir(dir); err == nil {
+		for _, entry := range entries {
+			taken[entry.Name()] = true
+		}
+	}
+	name := k.fileName(at)
+	for taken[name] {
+		at = at.Add(time.Second)
+		name = k.fileName(at)
+	}
+	path := filepath.Join(dir, name)
+	if err := d.FS.WriteFile(path, []byte(ensureTrailingNewline(body)), 0o644); err != nil {
+		return "", exitErr(ExitOperational, "write %s: %v", noun, err)
+	}
+	return path, nil
+}
+
+func (k reportKind) fileName(at time.Time) string {
+	return k.FilePrefix + at.Format(reportFileTimeLayout) + ".md"
+}
+
+// fileInstant reads a report's name back as the instant it was written, and
+// false for anything else in the directory.
+func (k reportKind) fileInstant(name string) (time.Time, bool) {
+	stamp, ok := strings.CutPrefix(name, k.FilePrefix)
+	if !ok {
+		return time.Time{}, false
+	}
+	stamp, ok = strings.CutSuffix(stamp, ".md")
+	if !ok {
+		return time.Time{}, false
+	}
+	at, err := time.Parse(reportFileTimeLayout, stamp)
+	if err != nil {
+		return time.Time{}, false
+	}
+	return at, true
+}
+
+// latest returns the set's current report of this kind — the one with the
+// newest timestamp in its name — and false when the set has none. Every earlier
+// document stays where it is; superseding is a matter of which one the readers
+// take, not of deleting the ones before it (ADR-0214).
+func (k reportKind) latest(d *Deps, setDir string) (reportDocument, bool) {
+	dir := filepath.Join(setDir, k.Dir)
+	entries, err := d.FS.ReadDir(dir)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	var found reportDocument
+	ok := false
+	for _, entry := range entries {
+		at, isReport := k.fileInstant(entry.Name())
+		if entry.IsDir() || !isReport {
+			continue
+		}
+		if ok && !at.After(found.At) {
+			continue
+		}
+		found, ok = reportDocument{Path: filepath.Join(dir, entry.Name()), At: at}, true
+	}
+	if !ok {
+		return reportDocument{}, false
+	}
+	body, err := d.FS.ReadFile(found.Path)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	found.Body = strings.TrimSpace(string(body))
+	return found, true
+}
+
+// reportHeaderField reads one of the "- Field: value" facts render stamps at the
+// top of every report. The header is the document's own record of what it
+// describes, so reading it back beats keeping a side-car that a document copied
+// out of pop would leave behind.
+func reportHeaderField(body, field string) string {
+	prefix := "- " + field + ": "
+	inHeader := false
+	for _, line := range strings.Split(body, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "- ") {
+			// The header is the report's first bullet list; anything after it is
+			// the pass's prose, which may say anything at all.
+			if inHeader {
+				return ""
+			}
+			continue
+		}
+		inHeader = true
+		if rest, ok := strings.CutPrefix(line, prefix); ok {
+			return strings.TrimSpace(rest)
+		}
+	}
+	return ""
+}
+
+func ensureTrailingNewline(s string) string {
+	if strings.HasSuffix(s, "\n") {
+		return s
+	}
+	return s + "\n"
+}
diff --git a/tasks/report_pointer.go b/tasks/report_pointer.go
new file mode 100644
index 00000000..a732d1d2
--- /dev/null
+++ b/tasks/report_pointer.go
@@ -0,0 +1,90 @@
+package tasks
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ReportPointer is a set's current report of one kind as the surfaces a human
+// reads carry it: where the document is and which commit it was written
+// against, never what it says (ADR-0240, ADR-0245, narrowed by ADR-0217).
+type ReportPointer struct {
+	// Path is the absolute path of the latest report.
+	Path string
+	// WorkSHA is the short work SHA the report was written against, empty when
+	// the document records none.
+	WorkSHA string
+	// CommitRange is the range the pass read, empty when the document records
+	// none.
+	CommitRange string
+	// Written is the instant in the report's name, RFC3339 in UTC.
+	Written string
+
+	kind reportKind
+}
+
+// latestPointer resolves the pointer for a set, and false when the set has no
+// report of this kind.
+func (k reportKind) latestPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ReportPointer{}, false
+	}
+	doc, ok := k.latest(d, m.Dir)
+	if !ok {
+		return ReportPointer{}, false
+	}
+	return ReportPointer{
+		Path:        doc.Path,
+		Written:     doc.At.UTC().Format("2006-01-02 15:04Z"),
+		WorkSHA:     reportHeaderField(doc.Body, "Work SHA"),
+		CommitRange: reportHeaderField(doc.Body, "Commit range"),
+		kind:        k,
+	}, true
+}
+
+// CommitPhrase names the commit the document was written against, in the one
+// form every surface prints it. Empty when the report recorded neither a work
+// SHA nor a range — an old or hand-edited document still shows its path.
+func (p ReportPointer) CommitPhrase() string {
+	switch {
+	case p.WorkSHA != "" && p.CommitRange != "":
+		return fmt.Sprintf("%s (%s)", p.WorkSHA, p.CommitRange)
+	case p.WorkSHA != "":
+		return p.WorkSHA
+	default:
+		return p.CommitRange
+	}
+}
+
+// Summary is the single line the gate preamble uses: which pass, the commit it
+// read, when, and where to read it.
+func (p ReportPointer) Summary() string {
+	var b strings.Builder
+	b.WriteString(p.kind.Noun)
+	if phrase := p.CommitPhrase(); phrase != "" {
+		fmt.Fprintf(&b, " of %s", phrase)
+	}
+	if p.Written != "" {
+		fmt.Fprintf(&b, ", written %s", p.Written)
+	}
+	fmt.Fprintf(&b, ": %s", p.Path)
+	return b.String()
+}
+
+// StaleAgainst reports whether the checkout has moved past the commit this
+// report was written against. Unknown on either side is not staleness: a
+// document recording no work SHA, or a checkout whose HEAD pop cannot read, says
+// nothing about whether the report still describes today's files.
+func (p ReportPointer) StaleAgainst(workSHA string) bool {
+	written, current := p.WorkSHA, ShortSHA(workSHA)
+	if written == "" || current == "" {
+		return false
+	}
+	// Either side may be the shorter abbreviation — a hand-edited header, or a
+	// document written when the shortening differed — so a common prefix counts
+	// as the same commit.
+	return !strings.HasPrefix(current, written) && !strings.HasPrefix(written, current)
+}
