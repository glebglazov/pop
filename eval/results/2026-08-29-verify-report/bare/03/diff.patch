diff --git a/tasks/verify_report.go b/tasks/verify_report.go
new file mode 100644
index 00000000..7c5b65d6
--- /dev/null
+++ b/tasks/verify_report.go
@@ -0,0 +1,100 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// noVerifierAccount is the Verify report's body when a Verifier rendered its
+// verdict and nothing else, so the document says so rather than looking cut off.
+const noVerifierAccount = "The Verifier gave no account of its verdict beyond the verdict line."
+
+// splitVerifierReply lifts the `VERDICT:` line off a Verifier's reply, the way
+// splitRefinerReply lifts `COMMIT-SUBJECT:`, and returns everything else as the
+// Verify report's body (ADR-0245). The verdict itself is still ParseVerdict's to
+// read; this only decides what a human reads. A reply with no recognisable
+// verdict keeps all of its text, prefaced by the account ParseVerdict gives of
+// why it parked the set, so a malformed answer is never lost.
+func splitVerifierReply(raw string) string {
+	lines := strings.Split(strings.TrimSpace(raw), "\n")
+	for i, line := range lines {
+		value, ok := verdictLabelValue(line)
+		if !ok {
+			continue
+		}
+		if _, ok := canonicalVerdict(value); !ok {
+			break
+		}
+		body := strings.TrimSpace(strings.Join(append(append([]string{}, lines[:i]...), lines[i+1:]...), "\n"))
+		if body == "" {
+			return noVerifierAccount
+		}
+		return body
+	}
+	return unparsedFindings(raw)
+}
+
+// recordVerifierReport files the Verify report of one real Verifier invocation:
+// the reply's prose under the header of facts every report carries, plus the
+// verdict it reached. It is best-effort — the verdict is already paid for and
+// is what the drain gates on, so a report that cannot be written costs a
+// warning, never the verdict.
+func recordVerifierReport(d *Deps, out io.Writer, m *Manifest, setID, workSHA, commitRange, agent string, verdict Verdict, raw string) {
+	writeVerifyReport(d, out, m, reportHeader{
+		SetID:       setID,
+		WorkSHA:     workSHA,
+		CommitRange: commitRange,
+		Author:      agent,
+		Facts:       []reportFact{{Field: "Verdict", Value: string(verdict)}},
+	}, splitVerifierReply(raw))
+}
+
+// humanVerifyAuthor is the author a human-authored Verify report records, in
+// place of the agent a Verifier-authored one names.
+const humanVerifyAuthor = "human (Accepted verdict — no Verifier ran)"
+
+// recordAcceptedReport files the Verify report of an Accepted verdict (ADR-0103):
+// a human recording PASS over the Verifier's judgment. No agent ran, so pop
+// renders the document from the human's note and the verdict it overrode; the
+// header's author and the opening line both say a human wrote it, so a reader
+// scanning the set's reports tells it apart from a Verifier's at a glance.
+func recordAcceptedReport(d *Deps, out io.Writer, m *Manifest, setID, workSHA, commitRange, note string, overridden *store.VerifyVerdict) {
+	overriddenVerdict := "none recorded at this work SHA"
+	if overridden != nil && strings.TrimSpace(overridden.Verdict) != "" {
+		overriddenVerdict = overridden.Verdict
+	}
+	var b strings.Builder
+	fmt.Fprintf(&b, "**Human-authored.** A human recorded this PASS themselves; no Verifier ran. It overrides the verdict %s.\n", overriddenVerdict)
+	b.WriteString("\n## Human rationale\n\n")
+	if note = strings.TrimSpace(note); note != "" {
+		b.WriteString(note + "\n")
+	} else {
+		b.WriteString("(the human gave no rationale)\n")
+	}
+	if overridden != nil && strings.TrimSpace(overridden.Findings) != "" {
+		fmt.Fprintf(&b, "\n## Findings of the overridden %s verdict\n\n%s\n", overridden.Verdict, strings.TrimSpace(overridden.Findings))
+	}
+	writeVerifyReport(d, out, m, reportHeader{
+		SetID:       setID,
+		WorkSHA:     workSHA,
+		CommitRange: commitRange,
+		Author:      humanVerifyAuthor,
+		Facts: []reportFact{
+			{Field: "Verdict", Value: string(VerdictPass)},
+			{Field: "Overrides", Value: overriddenVerdict},
+		},
+	}, b.String())
+}
+
+func writeVerifyReport(d *Deps, out io.Writer, m *Manifest, h reportHeader, body string) {
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return
+	}
+	h.At = d.Now().UTC()
+	if _, err := verifyReports.write(d, m.Dir, h.At, verifyReports.render(h, body)); err != nil && out != nil {
+		fmt.Fprintf(outputFor(out), "Could not write the verify report: %v\n", err)
+	}
+}
