+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// verifyReportBodies returns every Verify report filed for the set, oldest
+// first, as their bodies.
+func verifyReportBodies(t *testing.T, m *Manifest) []string {
+	t.Helper()
+	dir := filepath.Join(m.Dir, VerifyDirName)
+	entries, err := os.ReadDir(dir)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		t.Fatalf("read verify dir: %v", err)
+	}
+	var bodies []string
+	for _, entry := range entries {
+		data, err := os.ReadFile(filepath.Join(dir, entry.Name()))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		bodies = append(bodies, string(data))
+	}
+	return bodies
+}
+
+// TestVerifierInvocationWritesOneReportPerVerdict drives the drain's verify
+// phase through every verdict: each real invocation files its own report under
+// the set's verify/ directory, the verdict line lifted off and the prose kept,
+// and the verdicts themselves parse as they always have.
+func TestVerifierInvocationWritesOneReportPerVerdict(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), doneAFKSet(), nil)
+	replies := []struct {
+		raw     string
+		verdict Verdict
+		prose   string
+	}{
+		{"VERDICT: FIXABLE\nSUMMARY: cap retries\nFINDINGS: retries are unbounded\n", VerdictFixable, "retries are unbounded"},
+		{"VERDICT: NEEDS-HUMAN\nFINDINGS: the spec contradicts itself\n", VerdictNeedsHuman, "the spec contradicts itself"},
+		{"VERDICT: PASS\nFINDINGS: checked the retry cap; criterion 1 is met by retry.go\n", VerdictPass, "criterion 1 is met by retry.go"},
+	}
+	for i, reply := range replies {
+		// A fresh work SHA per lap, as a remediation commit would leave, so the
+		// cache does not answer for the Verifier; PASS comes last because it
+		// immunizes every lap after it.
+		d.Git = stubGit("sha"+string(rune('a'+i))+"\n", "", "")
+		_, v, err := drainVerifyPhase(d, nil, verifyCoreOptions{
+			Repo: "/repo/.git", RuntimePath: "/rt", SetID: "demo", Output: &bytes.Buffer{},
+			runVerifier: func(string) (string, error) { return reply.raw, nil },
+		}, m, StatusDone)
+		if err != nil {
+			t.Fatalf("drainVerifyPhase: %v", err)
+		}
+		if Verdict(v.Verdict) != reply.verdict {
+			t.Fatalf("verdict = %s, want %s", v.Verdict, reply.verdict)
+		}
+	}
+
+	bodies := verifyReportBodies(t, m)
+	if len(bodies) != len(replies) {
+		t.Fatalf("got %d reports, want one per invocation (%d)", len(bodies), len(replies))
+	}
+	for i, body := range bodies {
+		want := replies[i]
+		for _, line := range []string{"# Verify report — demo", "- Verdict: " + string(want.verdict), want.prose} {
+			if !strings.Contains(body, line) {
+				t.Fatalf("report %d missing %q:\n%s", i, line, body)
+			}
+		}
+		if strings.Contains(body, "VERDICT:") {
+			t.Fatalf("report %d kept the verdict line:\n%s", i, body)
+		}
+	}
+}
+
+// TestVerifierMalformedReplyKeepsItsRawText pins the malformed path: the verdict
+// is still the NEEDS-HUMAN it always was, and the report keeps what the agent
+// actually said.
+func TestVerifierMalformedReplyKeepsItsRawText(t *testing.T) {
+	t.Parallel()
+	for _, raw := range []string{"I looked around and it seems fine.", "VERDICT: MAYBE\nunsure", ""} {
+		d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), doneAFKSet(), nil)
+		_, v, err := drainVerifyPhase(d, nil, verifyCoreOptions{
+			Repo: "/repo/.git", RuntimePath: "/rt", SetID: "demo", Output: &bytes.Buffer{},
+			runVerifier: func(string) (string, error) { return raw, nil },
+		}, m, StatusDone)
+		if err != nil {
+			t.Fatalf("drainVerifyPhase: %v", err)
+		}
+		wantVerdict, wantFindings, _ := ParseVerdict(raw)
+		if Verdict(v.Verdict) != wantVerdict || v.Findings != wantFindings || wantVerdict != VerdictNeedsHuman {
+			t.Fatalf("verdict/findings = %s/%q, want %s/%q", v.Verdict, v.Findings, wantVerdict, wantFindings)
+		}
+		bodies := verifyReportBodies(t, m)
+		if len(bodies) != 1 {
+			t.Fatalf("got %d reports, want 1", len(bodies))
+		}
+		if !strings.Contains(bodies[0], strings.TrimSpace(wantFindings)) {
+			t.Fatalf("report lost the raw reply %q:\n%s", raw, bodies[0])
+		}
+	}
+}
+
+// TestCachedVerdictWritesNoReportAndReportsOutliveInvalidation pins the
+// cache/report divergence: a verdict read back from the cache invokes no agent
+// and files nothing, and invalidating the cache deletes the row but not the
+// document.
+func TestCachedVerdictWritesNoReportAndReportsOutliveInvalidation(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), doneAFKSet(), nil)
+	opts := verifyCoreOptions{
+		Repo: "/repo/.git", RuntimePath: "/rt", SetID: "demo", Output: &bytes.Buffer{},
+		runVerifier: func(string) (string, error) { return "VERDICT: FIXABLE\nFINDINGS: x\n", nil },
+	}
+	if _, _, err := drainVerifyPhase(d, nil, opts, m, StatusDone); err != nil {
+		t.Fatalf("first verify: %v", err)
+	}
+	opts.runVerifier = func(string) (string, error) {
+		t.Fatal("Verifier re-invoked despite a cached verdict")
+		return "", nil
+	}
+	if _, _, err := drainVerifyPhase(d, nil, opts, m, StatusDone); err != nil {
+		t.Fatalf("cached verify: %v", err)
+	}
+	if n := len(verifyReportBodies(t, m)); n != 1 {
+		t.Fatalf("got %d reports after a cache hit, want 1", n)
+	}
+
+	invalidateVerifyVerdicts(d, "/repo/.git", "demo")
+	if stored := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1"); stored != nil {
+		t.Fatalf("invalidation kept the cached verdict: %+v", stored)
+	}
+	if n := len(verifyReportBodies(t, m)); n != 1 {
+		t.Fatalf("invalidation removed the report: %d left", n)
+	}
+}
+
+// TestVerifierPromptCarriesNoPreviousReport pins that the Verifier never reads
+// its own homework: a set with a report on file builds the same prompt as one
+// without.
+func TestVerifierPromptCarriesNoPreviousReport(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	work := workDiffView{Range: "root000..HEAD", Stat: " a.go | 1 +"}
+	before := buildVerifierPrompt(d, m, "sha1", work, "", "")
+	path := seedVerifyReport(t, d, m)
+	after := buildVerifierPrompt(d, m, "sha1", work, "", "")
+	if before != after || strings.Contains(after, verifyProse) || strings.Contains(after, path) {
+		t.Fatalf("the Verifier prompt carries its previous report:\n%s", after)
+	}
+}
+
+// TestAcceptWritesAHumanAuthoredReport drives `pop tasks verify --accept` over
+// a FIXABLE verdict: no agent runs, and the set's latest report says a human
+// wrote it, why, and which verdict it overrode.
+func TestAcceptWritesAHumanAuthoredReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("shaACC\n", "", ""))
+	seedVerdict(t, d, store.VerifyVerdict{Repo: "/repo/.git", SetID: "demo", WorkSHA: "shaACC", Verdict: "FIXABLE", Findings: "retries are unbounded"})
+
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{}, Accept: true, AcceptNote: "unbounded is intended here",
+		runVerifier: func(string) (string, error) { t.Fatal("accept must not invoke the Verifier"); return "", nil },
+	}); err != nil {
+		t.Fatalf("accept: %v", err)
+	}
+
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{SetID: "demo", DefPath: defPath})
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	p, ok := verifyReports.latestPointer(d, m)
+	if !ok || p.WorkSHA != "shaACC" {
+		t.Fatalf("latest verify report = %+v, %v; want the accepted one at shaACC", p, ok)
+	}
+	data, err := os.ReadFile(p.Path)
+	if err != nil {
+		t.Fatalf("read report: %v", err)
+	}
+	body := string(data)
+	for _, want := range []string{
+		"- Verifier: " + humanVerifyAuthor,
+		"- Verdict: PASS",
+		"- Overrides: FIXABLE",
+		"**Human-authored.**",
+		"unbounded is intended here",
+		"retries are unbounded",
+	} {
+		if !strings.Contains(body, want) {
+			t.Fatalf("accepted report missing %q:\n%s", want, body)
+		}
+	}
+}
+
+// verifyProse is the one string no surface may print: a Verify report's body.
+const verifyProse = "SECRET-VERIFY-PROSE"
+
+func seedVerifyReport(t *testing.T, d *Deps, m *Manifest) string {
+	t.Helper()
+	at := time.Date(2026, 8, 17, 9, 0, 0, 0, time.UTC)
+	body := verifyReports.render(reportHeader{At: at, SetID: "demo", WorkSHA: "def456def456", CommitRange: "aaa111^..HEAD", Author: "codex",
+		Facts: []reportFact{{Field: "Verdict", Value: "FIXABLE"}}}, verifyProse)
+	path, err := verifyReports.write(d, m.Dir, at, body)
+	if err != nil {
+		t.Fatalf("write verify report: %v", err)
+	}
+	return path
+}
+
+// TestVerifyPointerReachesHumanSurfacesOnly drives every surface the Verify
+// report reaches: the gate's preamble and paging entry ahead of Refine's, the
+// detail view and the Artifact list — and none of the attended agent prompts.
+func TestVerifyPointerReachesHumanSurfacesOnly(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	refinePath := seedRefineReport(t, d, m)
+	verifyPath := seedVerifyReport(t, d, m)
+
+	gate, action := hitlGateOutput(t, d, m, "5\n")
+	if action != hitlGateReadVerify {
+		t.Fatalf("expected the verify entry at key 5 ahead of refine, got action %d", action)
+	}
+	for _, want := range []string{verifyPath, "Verify of def456def456 (aaa111^..HEAD)", "Read the verify report"} {
+		if !strings.Contains(gate, want) {
+			t.Fatalf("HITL gate missing %q:\n%s", want, gate)
+		}
+	}
+	if strings.Index(gate, verifyPath) > strings.Index(gate, refinePath) {
+		t.Fatalf("the verify pointer must lead the refine pointer:\n%s", gate)
+	}
+
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+	for _, want := range []string{"VERIFY REPORT", verifyPath, "newest: verify"} {
+		if !strings.Contains(detail.String(), want) {
+			t.Fatalf("detail view missing %q:\n%s", want, detail.String())
+		}
+	}
+
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil {
+		t.Fatalf("Artifacts: %v", err)
+	}
+	if len(artifacts) < 2 || artifacts[0].Path != verifyPath || artifacts[1].Path != refinePath {
+		t.Fatalf("artifact order = %+v, want the verify report above the refine report", artifacts)
+	}
+
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": detail.String()} {
+		if strings.Contains(text, verifyProse) {
+			t.Fatalf("%s inlined the verify report:\n%s", surface, text)
+		}
+	}
+	for surface, text := range attendedPrompts(d, m) {
+		if strings.Contains(text, verifyPath) || strings.Contains(strings.ToLower(text), "verify report") {
+			t.Fatalf("%s carries the verify pointer:\n%s", surface, text)
+		}
+	}
+}
+
+// TestNeverVerifiedSetRendersNoVerifyPointer pins the empty rule on every human
+// surface.
+func TestNeverVerifiedSetRendersNoVerifyPointer(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+	for surface, text := range map[string]string{"HITL gate": gate, "detail view": detail.String()} {
+		if strings.Contains(strings.ToLower(text), "verify report") {
+			t.Fatalf("%s mentions a verify report the set does not have:\n%s", surface, text)
+		}
+	}
+}
