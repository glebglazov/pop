+// TestVerifierWritesAReportOnEveryVerdict: each verdict, PASS included, leaves a
+// document whose header records the verdict and commit and whose body is the
+// reply with the verdict line lifted off.
+func TestVerifierWritesAReportOnEveryVerdict(t *testing.T) {
+	t.Parallel()
+	for _, verdict := range []Verdict{VerdictPass, VerdictFixable, VerdictNeedsHuman} {
+		t.Run(string(verdict), func(t *testing.T) {
+			t.Parallel()
+			d, defPath := setupVerifyFixture(t, stubGit("shaV\n", "", ""))
+			runVerifyWithReply(t, d, defPath, "VERDICT: "+string(verdict)+"\nFINDINGS: checked criterion 1 because "+verifyProse+"\n", nil)
+
+			reports := verifyReports(t, filepath.Join(defPath, "demo"))
+			if len(reports) != 1 {
+				t.Fatalf("expected one report, got %d", len(reports))
+			}
+			doc := reports[0]
+			for _, want := range []string{"# Verify report — demo", "- Verdict: " + string(verdict), "- Work SHA: shaV", "FINDINGS: checked criterion 1 because " + verifyProse} {
+				if !strings.Contains(doc, want) {
+					t.Fatalf("report missing %q:\n%s", want, doc)
+				}
+			}
+			if strings.Contains(doc, "VERDICT:") {
+				t.Fatalf("the verdict line must be lifted off the report body:\n%s", doc)
+			}
+			if got := readStoredVerdict(t, d, "/repo/.git", "demo", "shaV"); got == nil || got.Verdict != string(verdict) {
+				t.Fatalf("verdict must still parse as %s, got %+v", verdict, got)
+			}
+		})
+	}
+}
