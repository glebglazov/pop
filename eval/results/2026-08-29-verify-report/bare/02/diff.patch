+// TestAcceptWritesAHumanAuthoredReport: a human PASS over a FIXABLE leaves a
+// report carrying the note and the overridden verdict, says a human wrote it,
+// runs no agent, and is what the latest-report readers then find.
+func TestAcceptWritesAHumanAuthoredReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("shaH\n", "", ""))
+	runVerifyWithReply(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: the widget gap\n", nil)
