+// TestCachedVerdictWritesNoReport: a verdict served from the cache invokes no
+// agent and so leaves no document behind.
+func TestCachedVerdictWritesNoReport(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("shaC\n", "", ""), doneAFKSet(), nil)
+	seedVerdict(t, d, store.VerifyVerdict{Repo: "/repo/.git", SetID: "demo", WorkSHA: "shaC", Verdict: "FIXABLE", Findings: "x"})
+
+	if _, err := ensureVerifyVerdict(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", RuntimePath: "/rt", SetID: "demo", Output: &bytes.Buffer{},
+		runVerifier: func(string) (string, error) { t.Fatal("a cached verdict must not invoke the Verifier"); return "", nil },
+	}, m, "shaC"); err != nil {
+		t.Fatalf("ensureVerifyVerdict: %v", err)
+	}
+	if reports := verifyReports(t, m.Dir); len(reports) != 0 {
+		t.Fatalf("a cached verdict must write no report, got %d", len(reports))
+	}
+}
