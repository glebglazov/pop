+// TestEachInvocationFilesItsOwnReport: a second invocation adds a document
+// rather than rewriting the first, and the Verifier's prompt never carries the
+// report its predecessor wrote.
+func TestEachInvocationFilesItsOwnReport(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("shaL\n", "", ""))
+	runVerifyWithReply(t, d, defPath, "VERDICT: FIXABLE\nFINDINGS: "+verifyProse+"\n", nil)
+	var second string
+	runVerifyWithReply(t, d, defPath, "VERDICT: PASS\nFINDINGS: all met\n", &second)
+
+	if got := len(verifyReports(t, filepath.Join(defPath, "demo"))); got != 2 {
+		t.Fatalf("expected two reports after two invocations, got %d", got)
+	}
+	if strings.Contains(second, verifyProse) || strings.Contains(second, VerifyDirName+"/verify-") {
+		t.Fatalf("the Verifier prompt must carry no previous report:\n%s", second)
+	}
+}
