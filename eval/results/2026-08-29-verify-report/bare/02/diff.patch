+// TestMalformedReplyKeepsItsVerdictAndRawText: a reply without a verdict line
+// still parks as NEEDS-HUMAN, and its report keeps every word of it.
+func TestMalformedReplyKeepsItsVerdictAndRawText(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("shaM\n", "", ""))
+	runVerifyWithReply(t, d, defPath, "I looked around and "+verifyProse+" seemed fine.", nil)
+
+	if got := readStoredVerdict(t, d, "/repo/.git", "demo", "shaM"); got == nil || got.Verdict != string(VerdictNeedsHuman) {
+		t.Fatalf("malformed reply must resolve to NEEDS-HUMAN, got %+v", got)
+	}
+	reports := verifyReports(t, filepath.Join(defPath, "demo"))
+	if len(reports) != 1 || !strings.Contains(reports[0], "I looked around and "+verifyProse+" seemed fine.") {
+		t.Fatalf("report must keep the raw reply, got %q", reports)
+	}
+}
