+package tasks
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// reportKind is one pass that publishes a report into a set's folder: Refine and
+// verification today (ADR-0240, ADR-0245). The mechanics are the same for every
+// kind — a timestamped document per run under the set's own sub-directory, the
+// newest one being current, its header of facts read back from the document
+// itself — so a kind is only the names that keep one pass's documents apart
+// from another's.
+type reportKind struct {
+	// Label opens the document's heading ("<Label> report — <set>") and the
+	// pointer's one-line summary.
+	Label string
+	// Dir is the sub-directory of the set's folder the documents accumulate in.
+	// It sits under the Task-set directory, which lives in pop's Work store
+	// rather than in the repository, so no report can ever be staged into a
+	// commit (ADR-0214).
+	Dir string
+	// FilePrefix and the shared reportFileTimeLayout spell a document's name.
+	FilePrefix string
+	// ArtifactType is the type the set's Artifact list files the documents under.
+	ArtifactType string
+}
+
+// reportFileTimeLayout is the instant in every report's name. It is in the file
+// name rather than only in the document, because "the latest" is resolved by
+// timestamp and a directory listing must be able to answer that without opening
+// every file.
+const reportFileTimeLayout = "20060102T150405Z"
+
+// reportDocument is one report on disk: where it is, when it was written, and
+// what it says.
+type reportDocument struct {
+	Path string
+	At   time.Time
+	Body string
+}
+
+// reportFact is one "- Name: value" line of a report's header. A fact with an
+// empty value is left out of the document rather than printed blank.
+type reportFact struct {
+	Name  string
+	Value string
+}
+
+// FileInstant reads a report's name back as the instant it was written, and
+// false for anything else in the directory.
+func (k reportKind) FileInstant(name string) (time.Time, bool) {
+	stamp, ok := strings.CutPrefix(name, k.FilePrefix)
+	if !ok {
+		return time.Time{}, false
+	}
+	stamp, ok = strings.CutSuffix(stamp, ".md")
+	if !ok {
+		return time.Time{}, false
+	}
+	at, err := time.Parse(reportFileTimeLayout, stamp)
+	if err != nil {
+		return time.Time{}, false
+	}
+	return at, true
+}
+
+// fileName spells the document written at the instant.
+func (k reportKind) fileName(at time.Time) string {
+	return k.FilePrefix + at.Format(reportFileTimeLayout) + ".md"
+}
+
+// noun is the kind as operator messages name it ("refine", "verify").
+func (k reportKind) noun() string {
+	return strings.ToLower(k.Label)
+}
+
+// render wraps a pass's prose in the facts a reader needs to know what the
+// document describes. They ride the document rather than a side-car because the
+// document leaves pop the moment a human pipes it somewhere.
+func (k reportKind) render(setID string, facts []reportFact, body string) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "# %s report — %s\n\n", k.Label, setID)
+	for _, f := range facts {
+		if value := strings.TrimSpace(f.Value); value != "" {
+			fmt.Fprintf(&b, "- %s: %s\n", f.Name, value)
+		}
+	}
+	fmt.Fprintf(&b, "\n%s", ensureTrailingNewline(strings.TrimSpace(body)))
+	return b.String()
+}
+
+// write files a new document under the set's directory for the kind and
+// returns its path. A name already taken (two reports inside one second)
+// advances the instant rather than overwriting: retention is the whole point of
+// the directory, and the names are also the ordering.
+func (k reportKind) write(d *Deps, setDir string, at time.Time, body string) (string, error) {
+	dir := filepath.Join(setDir, k.Dir)
+	if err := d.FS.MkdirAll(dir, 0o755); err != nil {
+		return "", exitErr(ExitOperational, "create %s directory: %v", k.Dir, err)
+	}
+	at = at.UTC().Truncate(time.Second)
+	taken := map[string]bool{}
+	if entries, err := d.FS.ReadDir(dir); err == nil {
+		for _, entry := range entries {
+			taken[entry.Name()] = true
+		}
+	}
+	name := k.fileName(at)
+	for taken[name] {
+		at = at.Add(time.Second)
+		name = k.fileName(at)
+	}
+	path := filepath.Join(dir, name)
+	if err := d.FS.WriteFile(path, []byte(ensureTrailingNewline(body)), 0o644); err != nil {
+		return "", exitErr(ExitOperational, "write %s report: %v", k.noun(), err)
+	}
+	return path, nil
+}
+
+// latest returns the set's current document of the kind — the one with the
+// newest timestamp in its name — and false when the set has none. Every earlier
+// document stays where it is; superseding is a matter of which one the readers
+// take, not of deleting the ones before it (ADR-0214).
+func (k reportKind) latest(d *Deps, setDir string) (reportDocument, bool) {
+	dir := filepath.Join(setDir, k.Dir)
+	entries, err := d.FS.ReadDir(dir)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	var found reportDocument
+	ok := false
+	for _, entry := range entries {
+		at, isReport := k.FileInstant(entry.Name())
+		if entry.IsDir() || !isReport {
+			continue
+		}
+		if ok && !at.After(found.At) {
+			continue
+		}
+		found, ok = reportDocument{Path: filepath.Join(dir, entry.Name()), At: at}, true
+	}
+	if !ok {
+		return reportDocument{}, false
+	}
+	body, err := d.FS.ReadFile(found.Path)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	found.Body = strings.TrimSpace(string(body))
+	return found, true
+}
+
+// listed is every document of the kind in the set's folder as Artifact rows,
+// each dated by the instant in its own name. A missing directory lists nothing.
+func (k reportKind) listed(d *Deps, setDir string) ([]Artifact, error) {
+	dir := filepath.Join(setDir, k.Dir)
+	entries, err := d.FS.ReadDir(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	var artifacts []Artifact
+	for _, entry := range entries {
+		at, ok := k.FileInstant(entry.Name())
+		if entry.IsDir() || !ok {
+			continue
+		}
+		artifacts = append(artifacts, Artifact{
+			Type: k.ArtifactType,
+			Name: entry.Name(),
+			Path: filepath.Join(dir, entry.Name()),
+			At:   at,
+		})
+	}
+	return artifacts, nil
+}
+
+// reportHeaderField reads one of the "- Field: value" facts render stamps at the
+// top of every report. The header is the document's own record of what it
+// describes, so reading it back beats keeping a side-car that a document copied
+// out of pop would leave behind.
+func reportHeaderField(body, field string) string {
+	prefix := "- " + field + ": "
+	inHeader := false
+	for _, line := range strings.Split(body, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "- ") {
+			// The header is the report's first bullet list; anything after it is
+			// the pass's prose, which may say anything at all.
+			if inHeader {
+				return ""
+			}
+			continue
+		}
+		inHeader = true
+		if rest, ok := strings.CutPrefix(line, prefix); ok {
+			return strings.TrimSpace(rest)
+		}
+	}
+	return ""
+}
+
+func ensureTrailingNewline(s string) string {
+	if strings.HasSuffix(s, "\n") {
+		return s
+	}
+	return s + "\n"
+}
