+// verifyProse is the one string no agent-facing prompt may carry: the body of a
+// Verify report (ADR-0245).
+const verifyProse = "SECRET-VERIFY-PROSE"
+
+// verifyReports lists the set's Verify reports, oldest first, with their bodies.
+func verifyReports(t *testing.T, setDir string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(filepath.Join(setDir, VerifyDirName))
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		t.Fatalf("read verify dir: %v", err)
+	}
+	var bodies []string
+	for _, entry := range entries {
+		data, err := os.ReadFile(filepath.Join(setDir, VerifyDirName, entry.Name()))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		bodies = append(bodies, string(data))
+	}
+	return bodies
+}
+
+func runVerifyWithReply(t *testing.T, d *Deps, defPath, reply string, gotPrompt *string) {
+	t.Helper()
+	if _, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{},
+		runVerifier: func(prompt string) (string, error) {
+			if gotPrompt != nil {
+				*gotPrompt = prompt
+			}
+			return reply, nil
+		},
+	}); err != nil {
+		t.Fatalf("verifyResolvedSet: %v", err)
+	}
+}
