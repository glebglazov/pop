diff --git a/tasks/verify_report.go b/tasks/verify_report.go
new file mode 100644
index 00000000..5849b108
--- /dev/null
+++ b/tasks/verify_report.go
@@ -0,0 +1,109 @@
+package tasks
+
+import (
+	"io"
+	"strings"
+	"time"
+)
+
+// verifyReport is the Verify report's place among the reports a set's folder
+// accumulates (ADR-0245): one document per Verifier invocation — and per human
+// Accept — under <set>/verify/, the newest current. Unlike the verdict cache it
+// is never deleted by Verification invalidation, so a verify→remediate→verify
+// lap leaves its whole trail.
+var verifyReport = reportKind{
+	Label:        "Verify",
+	Dir:          VerifyDirName,
+	FilePrefix:   "verify-",
+	ArtifactType: ArtifactTypeVerify,
+}
+
+// latestVerifyPointer resolves the pointer to a set's current Verify report,
+// and false when the set has never been verified.
+func latestVerifyPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	return latestReportPointer(d, verifyReport, m)
+}
+
+// splitVerifierReply lifts the machine-read VERDICT line off the Verifier's
+// reply and returns the prose that stays, which becomes the report body. The
+// line removed is the one ParseVerdict reads, so the report and the cached
+// verdict never disagree about which line was the enum. A reply with no verdict
+// line is returned whole: a malformed answer is exactly the one a human must be
+// able to read in full.
+func splitVerifierReply(raw string) string {
+	lines := strings.Split(strings.TrimSpace(raw), "\n")
+	for i, line := range lines {
+		if _, ok := verdictLabelValue(line); !ok {
+			continue
+		}
+		return strings.TrimSpace(strings.Join(append(append([]string{}, lines[:i]...), lines[i+1:]...), "\n"))
+	}
+	return strings.TrimSpace(raw)
+}
+
+// verifyReportFacts is the header every Verify report carries, whoever wrote
+// it: when, which verdict, and against which commits. The author fact differs
+// by path and is appended by the caller.
+func verifyReportFacts(at time.Time, verdict, workSHA, commitRange string) []reportFact {
+	return []reportFact{
+		{Name: "Verified", Value: at.UTC().Format(time.RFC3339)},
+		{Name: "Verdict", Value: verdict},
+		{Name: reportFactCommitRange, Value: commitRange},
+		{Name: reportFactWorkSHA, Value: ShortSHA(workSHA)},
+	}
+}
+
+// renderVerifierReport is the document one Verifier invocation leaves: its
+// reply with the verdict line lifted off. A reply that says nothing past the
+// verdict still gets a document, carrying the findings pop parsed from it, so
+// every invocation is on record.
+func renderVerifierReport(at time.Time, setID, workSHA, commitRange, agent string, verdict Verdict, findings, raw string) string {
+	body := splitVerifierReply(raw)
+	if body == "" {
+		body = strings.TrimSpace(findings)
+	}
+	if body == "" {
+		body = "The Verifier gave no reasons beyond its verdict."
+	}
+	facts := append(verifyReportFacts(at, string(verdict), workSHA, commitRange),
+		reportFact{Name: "Verifier", Value: agent})
+	return verifyReport.render(setID, facts, body)
+}
+
+// renderAcceptedReport is the document a human Accept leaves (ADR-0103,
+// ADR-0245): no agent ran, so pop writes it from the human's own note and the
+// verdict it overrode. The author fact says so plainly, because this is the
+// report a later reader is most likely to find puzzling.
+func renderAcceptedReport(at time.Time, setID, workSHA, commitRange, overridden, note string) string {
+	if overridden == "" {
+		overridden = "no non-PASS verdict recorded at this commit"
+	}
+	facts := append(verifyReportFacts(at, string(VerdictPass)+" (human-authored)", workSHA, commitRange),
+		reportFact{Name: "Overrode", Value: overridden},
+		reportFact{Name: "Author", Value: "a human (Accept); no Verifier ran"})
+	var b strings.Builder
+	b.WriteString("## Why a human accepted this set\n\n")
+	if note = strings.TrimSpace(note); note != "" {
+		b.WriteString(note)
+	} else {
+		b.WriteString("The human recorded no rationale.")
+	}
+	return verifyReport.render(setID, facts, b.String())
+}
+
+// fileVerifyReport writes one Verify report for the set. The verdict is already
+// in the cache by the time this runs, and it is what gates the drain, so a
+// report that cannot be written is a warning rather than a failed verification.
+func fileVerifyReport(d *Deps, out io.Writer, m *Manifest, setID string, at time.Time, doc string) string {
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ""
+	}
+	path, err := verifyReport.write(d, m.Dir, at, doc)
+	if err != nil {
+		if out != nil {
+			outputFor(out).line(ansiYellow, "   warning: write verify report for %s: %v", setID, err)
+		}
+		return ""
+	}
+	return path
+}
