+// TestVerifyPointerReachesOnlyHumanSurfaces drives every surface the Verify
+// pointer is meant for — the gate's preamble and paging entry, the detail view
+// and the Artifact list — and every agent prompt it must stay out of.
+func TestVerifyPointerReachesOnlyHumanSurfaces(t *testing.T) {
+	d, m := hitlFixture(t)
+	seedRefineReport(t, d, m)
+	path := seedVerifyReport(t, d, m)
+
+	var gate strings.Builder
+	in := strings.NewReader("5\n")
+	refine, hasRefine := latestRefinePointer(d, m)
+	verify, hasVerify := LatestVerifyPointer(d, m)
+	action, err := promptHITLGateAction(&gate, in, d, nil, "/rt", newPromptReader(in), "demo", m, &m.Tasks[1],
+		"## Acceptance criteria\n\n- [ ] ok\n", nil, false, refine, hasRefine, verify, hasVerify)
+	if err != nil {
+		t.Fatalf("promptHITLGateAction: %v", err)
+	}
+	if action != hitlGateReadVerify {
+		t.Fatalf("expected the verify entry at key 5, above refine; got action %d", action)
+	}
+
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, &detail, "demo", nil, m)
+
+	for _, s := range []struct {
+		surface string
+		text    string
+		wants   []string
+	}{
+		{"HITL gate", gate.String(), []string{"Verify of def456def456 (aaa111^..HEAD)", path, "Read the verify report"}},
+		{"detail view", detail.String(), []string{"VERIFY REPORT", "of def456def456 (aaa111^..HEAD)", path}},
+	} {
+		for _, want := range s.wants {
+			if !strings.Contains(s.text, want) {
+				t.Fatalf("%s missing %q:\n%s", s.surface, want, s.text)
+			}
+		}
+		if strings.Contains(s.text, verifyProse) {
+			t.Fatalf("%s inlined the verify report:\n%s", s.surface, s.text)
+		}
+	}
+
+	runner := &fakeAttendedRunner{}
+	d.Runner = runner
+	t.Setenv("PAGER", "mypager")
+	pageReportDocument(d, strings.NewReader(""), "/rt", &bytes.Buffer{}, verify)
+	if runner.attendedCalls != 1 || strings.Join(runner.args, " ") != path {
+		t.Fatalf("expected the pager over the verify report, got %s %v", runner.name, runner.args)
+	}
+
+	artifacts, err := Artifacts(d, m.Dir)
+	if err != nil || len(artifacts) < 2 || artifacts[0].Type != ArtifactTypeVerify || artifacts[1].Type != ArtifactTypeRefine {
+		t.Fatalf("the verify report must rank above the refine report: %+v, %v", artifacts, err)
+	}
+
+	// The Verifier's reply contract names the report it is writing, so for the
+	// agent prompts the pointer is the path and the prose, not the phrase.
+	prompts := attendedPrompts(d, m)
+	prompts["implementer prompt"] = BuildAgentPrompt(filepath.Join(m.Dir, m.Tasks[0].File), "/rt", "")
+	prompts["verifier prompt"] = buildVerifierPrompt(d, m, "sha1", workDiffView{Range: "aaa111^..HEAD", Stat: " a.go | 1 +"}, "", "")
+	for surface, text := range prompts {
+		if strings.Contains(text, path) || strings.Contains(text, verifyProse) || strings.Contains(text, "Verify of") {
+			t.Fatalf("%s carries the verify pointer:\n%s", surface, text)
+		}
+	}
+}
