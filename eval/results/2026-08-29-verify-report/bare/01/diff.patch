diff --git a/tasks/report.go b/tasks/report.go
new file mode 100644
index 00000000..44aa87f8
--- /dev/null
+++ b/tasks/report.go
@@ -0,0 +1,310 @@
+package tasks
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// reportPass names the pass that wrote a report — Refine or verification — and
+// everything about the report that differs between them. The mechanics do not:
+// both passes file a timestamped document under their own sub-directory of the
+// set's folder, the newest one is the current report, and a pointer to it reads
+// its facts back out of the document's own header (ADR-0245). A field here is a
+// difference between the roles; anything the two would share is not one.
+type reportPass struct {
+	// Name is the sub-directory under the set's folder, the file-name prefix
+	// before the instant, and the Artifact type the reports list under.
+	Name string
+	// Title heads every document: "<Title> — <set id>".
+	Title string
+	// WrittenLabel is the header fact carrying the instant the report was
+	// written ("Refined", "Verified").
+	WrittenLabel string
+	// SummaryLabel opens the one-line pointer the human-facing surfaces print.
+	SummaryLabel string
+}
+
+// refinePass is the Refine report's place in the shared machinery (ADR-0240).
+// Every value here is part of what a reader already sees — the directory, the
+// file names, the header — so none of it may move.
+var refinePass = reportPass{
+	Name:         RefineDirName,
+	Title:        "Refine report",
+	WrittenLabel: "Refined",
+	SummaryLabel: "Refine",
+}
+
+// verifyPass is the Verify report's (ADR-0245): the Verifier's reasoning, or a
+// human's when they accepted a verdict over it.
+var verifyPass = reportPass{
+	Name:         VerifyDirName,
+	Title:        "Verify report",
+	WrittenLabel: "Verified",
+	SummaryLabel: "Verify report",
+}
+
+// reportFileTimeLayout spells the instant in a report's name. The instant is in
+// the file name rather than only in the document, because "the latest" is
+// resolved by timestamp and a directory listing must be able to answer that
+// without opening every file.
+const reportFileTimeLayout = "20060102T150405Z"
+
+// dir is where the pass files its reports for one set. It sits under the
+// Task-set directory, which lives in pop's Work store rather than in the
+// repository, so no report can ever be staged into a commit (ADR-0214).
+func (p reportPass) dir(setDir string) string {
+	return filepath.Join(setDir, p.Name)
+}
+
+func (p reportPass) fileName(at time.Time) string {
+	return p.Name + "-" + at.Format(reportFileTimeLayout) + ".md"
+}
+
+// fileInstant reads a report's name back as the instant it was written, and
+// false for anything else in the directory.
+func (p reportPass) fileInstant(name string) (time.Time, bool) {
+	stamp, ok := strings.CutPrefix(name, p.Name+"-")
+	if !ok {
+		return time.Time{}, false
+	}
+	stamp, ok = strings.CutSuffix(stamp, ".md")
+	if !ok {
+		return time.Time{}, false
+	}
+	at, err := time.Parse(reportFileTimeLayout, stamp)
+	if err != nil {
+		return time.Time{}, false
+	}
+	return at, true
+}
+
+// reportDocument is one report on disk: where it is, when it was written, and
+// what it says.
+type reportDocument struct {
+	Path string
+	At   time.Time
+	Body string
+}
+
+// reportHeader is the facts a document is stamped with: which set, at which
+// commits and when — the shared ones — then the pass's own, in order.
+type reportHeader struct {
+	SetID       string
+	At          time.Time
+	CommitRange string
+	WorkSHA     string
+	Facts       []reportFact
+}
+
+// reportFact is one "- Label: value" line of a header. A fact with no value is
+// left out, so a pass need not know in advance which of its facts it has.
+type reportFact struct {
+	Label string
+	Value string
+}
+
+// renderReportDocument wraps a report's prose in the facts a reader needs to
+// know what it describes. They ride the document rather than a side-car
+// because the document leaves pop the moment a human pipes it somewhere.
+//
+// The Work SHA line is the report's own answer to which tree it describes. It
+// is stamped by pop rather than asked of the agent, because pop read it before
+// the pass began and the agent would only be copying it back.
+func renderReportDocument(pass reportPass, h reportHeader, body string) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "# %s — %s\n\n", pass.Title, h.SetID)
+	fmt.Fprintf(&b, "- %s: %s\n", pass.WrittenLabel, h.At.UTC().Format(time.RFC3339))
+	if h.CommitRange != "" {
+		fmt.Fprintf(&b, "- Commit range: %s\n", h.CommitRange)
+	}
+	if h.WorkSHA != "" {
+		fmt.Fprintf(&b, "- Work SHA: %s\n", ShortSHA(h.WorkSHA))
+	}
+	for _, fact := range h.Facts {
+		if value := strings.TrimSpace(fact.Value); value != "" {
+			fmt.Fprintf(&b, "- %s: %s\n", fact.Label, value)
+		}
+	}
+	fmt.Fprintf(&b, "\n%s", ensureTrailingNewline(strings.TrimSpace(body)))
+	return b.String()
+}
+
+// writeReportDocument files a new report under the pass's directory and returns
+// its path. A name already taken (two reports inside one second) advances the
+// instant rather than overwriting: retention is the whole point of the
+// directory, and the names are also the ordering.
+func writeReportDocument(d *Deps, pass reportPass, setDir string, at time.Time, body string) (string, error) {
+	dir := pass.dir(setDir)
+	if err := d.FS.MkdirAll(dir, 0o755); err != nil {
+		return "", exitErr(ExitOperational, "create %s directory: %v", pass.Name, err)
+	}
+	at = at.UTC().Truncate(time.Second)
+	taken := map[string]bool{}
+	if entries, err := d.FS.ReadDir(dir); err == nil {
+		for _, entry := range entries {
+			taken[entry.Name()] = true
+		}
+	}
+	name := pass.fileName(at)
+	for taken[name] {
+		at = at.Add(time.Second)
+		name = pass.fileName(at)
+	}
+	path := filepath.Join(dir, name)
+	if err := d.FS.WriteFile(path, []byte(ensureTrailingNewline(body)), 0o644); err != nil {
+		return "", exitErr(ExitOperational, "write %s report: %v", pass.Name, err)
+	}
+	return path, nil
+}
+
+// latestReportDocument returns the set's current report for the pass — the one
+// with the newest timestamp in its name — and false when the pass has never
+// written one. Every earlier document stays where it is; superseding is a
+// matter of which one the readers take, not of deleting the ones before it
+// (ADR-0214).
+func latestReportDocument(d *Deps, pass reportPass, setDir string) (reportDocument, bool) {
+	dir := pass.dir(setDir)
+	entries, err := d.FS.ReadDir(dir)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	var found reportDocument
+	ok := false
+	for _, entry := range entries {
+		at, isReport := pass.fileInstant(entry.Name())
+		if entry.IsDir() || !isReport {
+			continue
+		}
+		if ok && !at.After(found.At) {
+			continue
+		}
+		found, ok = reportDocument{Path: filepath.Join(dir, entry.Name()), At: at}, true
+	}
+	if !ok {
+		return reportDocument{}, false
+	}
+	body, err := d.FS.ReadFile(found.Path)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	found.Body = strings.TrimSpace(string(body))
+	return found, true
+}
+
+// reportHeaderField reads one of the "- Field: value" facts renderReportDocument
+// stamps at the top of every report. The header is the document's own record
+// of what it describes, so reading it back beats keeping a side-car that a
+// document copied out of pop would leave behind.
+func reportHeaderField(body, field string) string {
+	prefix := "- " + field + ": "
+	inHeader := false
+	for _, line := range strings.Split(body, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "- ") {
+			// The header is the report's first bullet list; anything after it is
+			// the author's prose, which may say anything at all.
+			if inHeader {
+				return ""
+			}
+			continue
+		}
+		inHeader = true
+		if rest, ok := strings.CutPrefix(line, prefix); ok {
+			return strings.TrimSpace(rest)
+		}
+	}
+	return ""
+}
+
+// ReportPointer is a set's current report as the human-facing surfaces carry
+// it: where the document is and which commit it was written against, never
+// what it says (ADR-0240, ADR-0245).
+type ReportPointer struct {
+	pass reportPass
+	// Path is the absolute path of the latest report.
+	Path string
+	// WorkSHA is the short work SHA the report was written against, empty when
+	// the document records none.
+	WorkSHA string
+	// CommitRange is the range the pass read, empty when the document records
+	// none.
+	CommitRange string
+	// Written is the instant in the report's name, RFC3339 in UTC.
+	Written string
+}
+
+// latestReportPointer resolves the pointer to a set's current report for the
+// pass, and false when the pass has never written one for the set.
+func latestReportPointer(d *Deps, pass reportPass, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ReportPointer{}, false
+	}
+	doc, ok := latestReportDocument(d, pass, m.Dir)
+	if !ok {
+		return ReportPointer{}, false
+	}
+	p := ReportPointer{pass: pass, Path: doc.Path, Written: doc.At.UTC().Format("2006-01-02 15:04Z")}
+	p.WorkSHA = reportHeaderField(doc.Body, "Work SHA")
+	p.CommitRange = reportHeaderField(doc.Body, "Commit range")
+	return p, true
+}
+
+// CommitPhrase names the commit the document was written against, in the one
+// form every surface prints it. Empty when the report recorded neither a work
+// SHA nor a range — an old or hand-edited document still shows its path.
+func (p ReportPointer) CommitPhrase() string {
+	switch {
+	case p.WorkSHA != "" && p.CommitRange != "":
+		return fmt.Sprintf("%s (%s)", p.WorkSHA, p.CommitRange)
+	case p.WorkSHA != "":
+		return p.WorkSHA
+	default:
+		return p.CommitRange
+	}
+}
+
+// Summary is the single line a gate preamble uses: the commit the pass read,
+// when, and where to read it.
+func (p ReportPointer) Summary() string {
+	var b strings.Builder
+	b.WriteString(p.pass.SummaryLabel)
+	if phrase := p.CommitPhrase(); phrase != "" {
+		fmt.Fprintf(&b, " of %s", phrase)
+	}
+	if p.Written != "" {
+		fmt.Fprintf(&b, ", written %s", p.Written)
+	}
+	fmt.Fprintf(&b, ": %s", p.Path)
+	return b.String()
+}
+
+// StaleAgainst reports whether the checkout has moved past the commit this
+// report was written against. Unknown on either side is not staleness: a
+// document recording no work SHA, or a checkout whose HEAD pop cannot read, says
+// nothing about whether the report still describes today's files.
+//
+// Only the Refine report asks it. Whether a Verify report's judgment still holds
+// at HEAD is the Verified-at SHA badge's question, and a second answer here
+// would be a second derivation of the Verification mark (ADR-0245).
+func (p ReportPointer) StaleAgainst(workSHA string) bool {
+	written, current := p.WorkSHA, ShortSHA(workSHA)
+	if written == "" || current == "" {
+		return false
+	}
+	// Either side may be the shorter abbreviation — a hand-edited header, or a
+	// document written when the shortening differed — so a common prefix counts
+	// as the same commit.
+	return !strings.HasPrefix(current, written) && !strings.HasPrefix(written, current)
+}
+
+func ensureTrailingNewline(s string) string {
+	if strings.HasSuffix(s, "\n") {
+		return s
+	}
+	return s + "\n"
+}
