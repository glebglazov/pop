+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// verifyProse stands for the Verifier's reasons: the report's body, which no
+// pointer surface may print.
+const verifyProse = "SECRET-VERIFY-PROSE"
+
+func verifyReports(t *testing.T, m *Manifest) []string {
+	t.Helper()
+	entries, err := os.ReadDir(filepath.Join(m.Dir, VerifyDirName))
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		t.Fatalf("read verify dir: %v", err)
+	}
+	var bodies []string
+	for _, entry := range entries {
+		data, err := os.ReadFile(filepath.Join(m.Dir, VerifyDirName, entry.Name()))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		bodies = append(bodies, string(data))
+	}
+	return bodies
+}
+
+func verifyWith(t *testing.T, d *Deps, m *Manifest, reply string) *store.VerifyVerdict {
+	t.Helper()
+	v, err := runAndStoreVerdict(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", RuntimePath: "/rt", SetID: "demo", Output: &bytes.Buffer{},
+		runVerifier: func(string) (string, error) { return reply, nil },
+	}, m, "sha1", "")
+	if err != nil {
+		t.Fatalf("runAndStoreVerdict: %v", err)
+	}
+	return v
+}
+
+// TestEveryVerifierInvocationFilesItsOwnReport drives a verify-remediate-verify
+// lap: each invocation leaves a document, PASS included, and each document is
+// the prose after the verdict line under a header naming the verdict.
+func TestEveryVerifierInvocationFilesItsOwnReport(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), doneAFKSet(), nil)
+
+	verifyWith(t, d, m, "VERDICT: FIXABLE\nFINDINGS: the name lies\n")
+	verifyWith(t, d, m, "VERDICT: NEEDS-HUMAN\nFINDINGS: the spec contradicts itself\n")
+	v := verifyWith(t, d, m, "VERDICT: PASS\nFINDINGS: checked the tests; every criterion is met\n")
+	if v.Verdict != "PASS" {
+		t.Fatalf("verdict = %q, want PASS", v.Verdict)
+	}
+
+	reports := verifyReports(t, m)
+	if len(reports) != 3 {
+		t.Fatalf("want one report per invocation, got %d", len(reports))
+	}
+	for i, want := range []string{"FIXABLE", "NEEDS-HUMAN", "PASS"} {
+		if !strings.Contains(reports[i], "- Verdict: "+want+"\n") || !strings.Contains(reports[i], "- Work SHA: sha1\n") {
+			t.Fatalf("report %d lacks its header:\n%s", i, reports[i])
+		}
+		if strings.Contains(reports[i], "VERDICT:") {
+			t.Fatalf("report %d kept the verdict line:\n%s", i, reports[i])
+		}
+	}
+	if !strings.Contains(reports[2], "every criterion is met") {
+		t.Fatalf("the PASS report lost its reasons:\n%s", reports[2])
+	}
+
+	p, ok := LatestVerifyPointer(d, m)
+	if !ok || filepath.Base(p.Path) != "verify-20260817T180002Z.md" || p.WorkSHA != "sha1" {
+		t.Fatalf("latest pointer = %+v, %v", p, ok)
+	}
+}
+
+// TestMalformedVerifierReplyKeepsItsRawText pins that a reply pop cannot parse
+// still parks the set as it always has, and its report still says what the
+// agent wrote.
+func TestMalformedVerifierReplyKeepsItsRawText(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), doneAFKSet(), nil)
+
+	v := verifyWith(t, d, m, "Looks fine to me, "+verifyProse)
+	if v.Verdict != string(VerdictNeedsHuman) {
+		t.Fatalf("verdict = %q, want NEEDS-HUMAN", v.Verdict)
+	}
+	reports := verifyReports(t, m)
+	if len(reports) != 1 || !strings.Contains(reports[0], "could not be parsed") || !strings.Contains(reports[0], verifyProse) {
+		t.Fatalf("report lost the raw reply: %v", reports)
+	}
+}
+
+// TestCachedVerdictWritesNoReport pins that only a real invocation files one:
+// the drain reading a verdict back from the cache runs no agent and writes
+// nothing.
+func TestCachedVerdictWritesNoReport(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), doneAFKSet(), nil)
+	seedVerdict(t, d, store.VerifyVerdict{Repo: "/repo/.git", SetID: "demo", WorkSHA: "sha1", Verdict: "FIXABLE", Findings: "x"})
+
+	if _, _, err := drainVerifyPhase(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", RuntimePath: "/rt", SetID: "demo", Output: &bytes.Buffer{},
+		runVerifier: func(string) (string, error) { t.Fatal("Verifier invoked despite a cached verdict"); return "", nil },
+	}, m, StatusDone); err != nil {
+		t.Fatalf("drainVerifyPhase: %v", err)
+	}
+	if reports := verifyReports(t, m); len(reports) != 0 {
+		t.Fatalf("a cached verdict wrote a report: %v", reports)
+	}
+}
+
+// TestVerifyReportOutlivesInvalidation pins the deliberate divergence: the
+// cache row is deleted on invalidation, the report stays, and the next
+// Verifier is not shown it.
+func TestVerifyReportOutlivesInvalidation(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), doneAFKSet(), nil)
+	verifyWith(t, d, m, "VERDICT: FIXABLE\nFINDINGS: "+verifyProse+"\n")
+
+	invalidateVerifyVerdicts(d, "/repo/.git", "demo")
+	_ = d.CloseStore()
+
+	if stored := readStoredVerdict(t, d, "/repo/.git", "demo", "sha1"); stored != nil {
+		t.Fatalf("invalidation left the cached verdict: %+v", stored)
+	}
+	if _, ok := LatestVerifyPointer(d, m); !ok {
+		t.Fatal("invalidation deleted the verify report")
+	}
+	prompt := buildVerifierPrompt(d, m, "sha1", workDiffView{Range: "aaa111^..HEAD", Stat: " a.go | 1 +"}, "", "")
+	if strings.Contains(prompt, verifyProse) || strings.Contains(prompt, VerifyDirName+"/verify-") {
+		t.Fatalf("the Verifier was shown its previous report:\n%s", prompt)
+	}
+}
