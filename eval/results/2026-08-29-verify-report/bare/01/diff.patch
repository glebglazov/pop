index 00000000..ff8c4cdc
--- /dev/null
+++ b/tasks/pass_report.go
@@ -0,0 +1,320 @@
+package tasks
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// reportPass names the pass that writes a set's reports — Refine or
+// verification — and everything that differs between their documents. The
+// mechanics are one shape (ADR-0245): a document with a header of facts, filed
+// under the set's own sub-directory with the instant in its name, superseded by
+// whichever is newest. The roles are not the same, so each pass keeps its own
+// directory, title and labels.
+type reportPass struct {
+	// Dir is the sub-directory of a set's folder where the pass's reports
+	// accumulate. It sits under the Task-set directory, which lives in pop's
+	// Work store rather than in the repository, so no report can ever be
+	// staged into a commit (ADR-0214).
+	Dir string
+	// FilePrefix begins every report's name, ahead of the instant.
+	FilePrefix string
+	// Noun names the pass on the one-line surfaces: "Refine of <commit>".
+	Noun string
+	// Title heads the document: "<Title> — <set>".
+	Title string
+	// WrittenLabel is the header fact carrying the instant the pass ran.
+	WrittenLabel string
+	// ArtifactType is the pass's reports' type in the set's Artifact list.
+	ArtifactType string
+}
+
+var (
+	refineReport = reportPass{
+		Dir:          RefineDirName,
+		FilePrefix:   "refine-",
+		Noun:         "Refine",
+		Title:        "Refine report",
+		WrittenLabel: "Refined",
+		ArtifactType: ArtifactTypeRefine,
+	}
+	verifyReport = reportPass{
+		Dir:          VerifyDirName,
+		FilePrefix:   "verify-",
+		Noun:         "Verify",
+		Title:        "Verify report",
+		WrittenLabel: "Verified",
+		ArtifactType: ArtifactTypeVerify,
+	}
+)
+
+// reportPasses is every pass that files reports, in the order the Artifact
+// list ranks them.
+var reportPasses = []reportPass{verifyReport, refineReport}
+
+// reportFileTimeLayout spells the instant in a report's name. The instant is in
+// the file name rather than only in the document, because "the latest" is
+// resolved by timestamp and a directory listing must be able to answer that
+// without opening every file.
+const reportFileTimeLayout = "20060102T150405Z"
+
+// The header facts every pointer reads back out of a report.
+const (
+	reportFactCommitRange = "Commit range"
+	reportFactWorkSHA     = "Work SHA"
+)
+
+// reportDocument is one report on disk: where it is, when it was written, and
+// what it says.
+type reportDocument struct {
+	Path string
+	At   time.Time
+	Body string
+}
+
+// reportFact is one "- Label: value" line of a report's header.
+type reportFact struct {
+	Label string
+	Value string
+}
+
+// reportHeader is what a pass knows about the report it is filing: when, at
+// which commits, and who wrote it. Author is labelled by the caller because a
+// Verify report is not always the Verifier's — a human's Accept writes one too.
+type reportHeader struct {
+	At          time.Time
+	SetID       string
+	CommitRange string
+	WorkSHA     string
+	AuthorLabel string
+	Author      string
+	// Extra are the pass's own facts, stamped after the shared ones.
+	Extra []reportFact
+}
+
+// render wraps a report's prose in the facts a reader needs to know what it
+// describes: which set, at which commits, by whom and when. They ride the
+// document rather than a side-car because the document leaves pop the moment a
+// human pipes it somewhere. A fact with no value is left out.
+func (p reportPass) render(h reportHeader, body string) string {
+	facts := []reportFact{
+		{p.WrittenLabel, h.At.UTC().Format(time.RFC3339)},
+		{reportFactCommitRange, h.CommitRange},
+	}
+	if h.WorkSHA != "" {
+		facts = append(facts, reportFact{reportFactWorkSHA, ShortSHA(h.WorkSHA)})
+	}
+	facts = append(facts, reportFact{h.AuthorLabel, strings.TrimSpace(h.Author)})
+	facts = append(facts, h.Extra...)
+
+	var b strings.Builder
+	fmt.Fprintf(&b, "# %s — %s\n\n", p.Title, h.SetID)
+	for _, f := range facts {
+		if f.Value != "" {
+			fmt.Fprintf(&b, "- %s: %s\n", f.Label, f.Value)
+		}
+	}
+	fmt.Fprintf(&b, "\n%s", ensureTrailingNewline(strings.TrimSpace(body)))
+	return b.String()
+}
+
+// fileInstant reads a report's name back as the instant it was written, and
+// false for anything else in the directory.
+func (p reportPass) fileInstant(name string) (time.Time, bool) {
+	stamp, ok := strings.CutPrefix(name, p.FilePrefix)
+	if !ok {
+		return time.Time{}, false
+	}
+	stamp, ok = strings.CutSuffix(stamp, ".md")
+	if !ok {
+		return time.Time{}, false
+	}
+	at, err := time.Parse(reportFileTimeLayout, stamp)
+	if err != nil {
+		return time.Time{}, false
+	}
+	return at, true
+}
+
+// write files a new report under the pass's directory and returns its path. A
+// name already taken (two reports inside one second) advances the instant
+// rather than overwriting: retention is the whole point of the directory, and
+// the names are also the ordering.
+func (p reportPass) write(d *Deps, setDir string, at time.Time, body string) (string, error) {
+	dir := filepath.Join(setDir, p.Dir)
+	if err := d.FS.MkdirAll(dir, 0o755); err != nil {
+		return "", exitErr(ExitOperational, "create %s directory: %v", p.Dir, err)
+	}
+	at = at.UTC().Truncate(time.Second)
+	taken := map[string]bool{}
+	if entries, err := d.FS.ReadDir(dir); err == nil {
+		for _, entry := range entries {
+			taken[entry.Name()] = true
+		}
+	}
+	name := p.FilePrefix + at.Format(reportFileTimeLayout) + ".md"
+	for taken[name] {
+		at = at.Add(time.Second)
+		name = p.FilePrefix + at.Format(reportFileTimeLayout) + ".md"
+	}
+	path := filepath.Join(dir, name)
+	if err := d.FS.WriteFile(path, []byte(ensureTrailingNewline(body)), 0o644); err != nil {
+		return "", exitErr(ExitOperational, "write %s report: %v", p.Dir, err)
+	}
+	return path, nil
+}
+
+// latest returns the set's current report — the one with the newest timestamp
+// in its name — and false when the pass has never written one. Every earlier
+// document stays where it is; superseding is a matter of which one the readers
+// take, not of deleting the ones before it (ADR-0214).
+func (p reportPass) latest(d *Deps, setDir string) (reportDocument, bool) {
+	dir := filepath.Join(setDir, p.Dir)
+	entries, err := d.FS.ReadDir(dir)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	var found reportDocument
+	ok := false
+	for _, entry := range entries {
+		at, isReport := p.fileInstant(entry.Name())
+		if entry.IsDir() || !isReport {
+			continue
+		}
+		if ok && !at.After(found.At) {
+			continue
+		}
+		found, ok = reportDocument{Path: filepath.Join(dir, entry.Name()), At: at}, true
+	}
+	if !ok {
+		return reportDocument{}, false
+	}
+	body, err := d.FS.ReadFile(found.Path)
+	if err != nil {
+		return reportDocument{}, false
+	}
+	found.Body = strings.TrimSpace(string(body))
+	return found, true
+}
+
+// latestPointer resolves the pointer to a set's current report, and false when
+// the pass has never written one for it.
+func (p reportPass) latestPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ReportPointer{}, false
+	}
+	doc, ok := p.latest(d, m.Dir)
+	if !ok {
+		return ReportPointer{}, false
+	}
+	return ReportPointer{
+		Noun:        p.Noun,
+		Path:        doc.Path,
+		Written:     doc.At.UTC().Format("2006-01-02 15:04Z"),
+		WorkSHA:     reportHeaderField(doc.Body, reportFactWorkSHA),
+		CommitRange: reportHeaderField(doc.Body, reportFactCommitRange),
+	}, true
+}
+
+// reportHeaderField reads one of the "- Field: value" facts render stamps at
+// the top of every report. The header is the document's own record of what it
+// describes, so reading it back beats keeping a side-car that a document copied
+// out of pop would leave behind.
+func reportHeaderField(body, field string) string {
+	prefix := "- " + field + ": "
+	inHeader := false
+	for _, line := range strings.Split(body, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "- ") {
+			// The header is the report's first bullet list; anything after it is
+			// the author's prose, which may say anything at all.
+			if inHeader {
+				return ""
+			}
+			continue
+		}
+		inHeader = true
+		if rest, ok := strings.CutPrefix(line, prefix); ok {
+			return strings.TrimSpace(rest)
+		}
+	}
+	return ""
+}
+
+// ReportPointer is a set's current report as a surface carries it: where the
+// document is and which commit it was written against, never what it says
+// (ADR-0240, ADR-0245).
+type ReportPointer struct {
+	// Noun names the pass that wrote the report.
+	Noun string
+	// Path is the absolute path of the latest report.
+	Path string
+	// WorkSHA is the short work SHA the report was written against, empty when
+	// the document records none.
+	WorkSHA string
+	// CommitRange is the range the pass read, empty when the document records
+	// none.
+	CommitRange string
+	// Written is the instant in the report's name, RFC3339 in UTC.
+	Written string
+}
+
+// CommitPhrase names the commit the document was written against, in the one
+// form every surface prints it. Empty when the report recorded neither a work
+// SHA nor a range — an old or hand-edited document still shows its path.
+func (p ReportPointer) CommitPhrase() string {
+	switch {
+	case p.WorkSHA != "" && p.CommitRange != "":
+		return fmt.Sprintf("%s (%s)", p.WorkSHA, p.CommitRange)
+	case p.WorkSHA != "":
+		return p.WorkSHA
+	default:
+		return p.CommitRange
+	}
+}
+
+// Summary is the single line the gate preamble uses: the commit the pass read,
+// when, and where to read it.
+func (p ReportPointer) Summary() string {
+	var b strings.Builder
+	b.WriteString(p.Noun)
+	if phrase := p.CommitPhrase(); phrase != "" {
+		fmt.Fprintf(&b, " of %s", phrase)
+	}
+	if p.Written != "" {
+		fmt.Fprintf(&b, ", written %s", p.Written)
+	}
+	fmt.Fprintf(&b, ": %s", p.Path)
+	return b.String()
+}
+
+// DetailBody is the pointer as a detail view's section carries it: the commit
+// the report was written against and when, then where to read it.
+func (p ReportPointer) DetailBody() string {
+	var b strings.Builder
+	if phrase := p.CommitPhrase(); phrase != "" {
+		fmt.Fprintf(&b, "of %s, ", phrase)
+	}
+	fmt.Fprintf(&b, "written %s\n%s", p.Written, p.Path)
+	return b.String()
+}
+
+// StaleAgainst reports whether the checkout has moved past the commit this
+// report was written against. Unknown on either side is not staleness: a
+// document recording no work SHA, or a checkout whose HEAD pop cannot read, says
+// nothing about whether the report still describes today's files.
+func (p ReportPointer) StaleAgainst(workSHA string) bool {
+	written, current := p.WorkSHA, ShortSHA(workSHA)
+	if written == "" || current == "" {
+		return false
+	}
+	// Either side may be the shorter abbreviation — a hand-edited header, or a
+	// document written when the shortening differed — so a common prefix counts
+	// as the same commit.
+	return !strings.HasPrefix(current, written) && !strings.HasPrefix(written, current)
+}
