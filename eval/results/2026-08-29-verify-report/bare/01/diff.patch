+// seedVerifyReport files one Verify report the way a Verifier invocation does.
+func seedVerifyReport(t *testing.T, d *Deps, m *Manifest) string {
+	t.Helper()
+	fileVerifierReport(d, nil, m, "demo", "def456def456", "aaa111^..HEAD", "claude", VerdictFixable, "VERDICT: FIXABLE\nFINDINGS: "+verifyProse+"\n")
+	p, ok := LatestVerifyPointer(d, m)
+	if !ok {
+		t.Fatal("expected a verify report")
+	}
+	return p.Path
+}
