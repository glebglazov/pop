+// TestAcceptFilesAHumanAuthoredReport pins the Accepted verdict's report: pop
+// renders it with no agent, it carries the human's note and the verdict it
+// overrode, and the latest-report readers take it like any other.
+func TestAcceptFilesAHumanAuthoredReport(t *testing.T) {
+	d, defPath := setupVerifyFixture(t, stubGit("shaACC\n", "", ""))
+	seedVerdict(t, d, store.VerifyVerdict{Repo: "/repo/.git", SetID: "demo", WorkSHA: "shaACC", Verdict: "FIXABLE", Findings: "x"})
+
+	opts := verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output: &bytes.Buffer{}, Accept: true, AcceptNote: "the flake is known",
+		runVerifier: func(string) (string, error) { t.Fatal("an Accept must not run the Verifier"); return "", nil },
+	}
+	if _, err := verifyResolvedSet(d, nil, opts); err != nil {
+		t.Fatalf("accept: %v", err)
+	}
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	p, ok := LatestVerifyPointer(d, m)
+	if !ok || p.WorkSHA != "shaACC" {
+		t.Fatalf("latest pointer = %+v, %v", p, ok)
+	}
+	reports := verifyReports(t, m)
+	if len(reports) != 1 {
+		t.Fatalf("want one report, got %d", len(reports))
+	}
+	for _, want := range []string{"# Verify report — demo", "- Author: human", "- Verdict: PASS (human-authored)", "- Overrode: FIXABLE", "the flake is known"} {
+		if !strings.Contains(reports[0], want) {
+			t.Fatalf("accept report missing %q:\n%s", want, reports[0])
+		}
+	}
+}
