+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// verifyReports lists the set's Verify reports oldest-first, as their bodies.
+func verifyReports(t *testing.T, setDir string) []string {
+	t.Helper()
+	dir := filepath.Join(setDir, VerifyDirName)
+	entries, err := os.ReadDir(dir)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		t.Fatalf("read verify reports: %v", err)
+	}
+	var bodies []string
+	for _, entry := range entries {
+		data, err := os.ReadFile(filepath.Join(dir, entry.Name()))
+		if err != nil {
+			t.Fatalf("read %s: %v", entry.Name(), err)
+		}
+		bodies = append(bodies, string(data))
+	}
+	return bodies
+}
+
+func runVerifyReply(t *testing.T, d *Deps, defPath, reply string) *VerifyResult {
+	t.Helper()
+	res, err := verifyResolvedSet(d, nil, verifyCoreOptions{
+		Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		Output:      &bytes.Buffer{},
+		runVerifier: func(string) (string, error) { return reply, nil },
+	})
+	if err != nil {
+		t.Fatalf("verifyResolvedSet: %v", err)
+	}
+	return res
+}
+
+// TestVerifierInvocationWritesOneReportPerVerdict drives a verify → verify lap
+// across all three verdicts: every invocation files its own document, the
+// verdict line is lifted off the reply, and the prose after it is the body.
+func TestVerifierInvocationWritesOneReportPerVerdict(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("abc123abc123\n", "", ""))
+	setDir := filepath.Join(defPath, "demo")
+
+	replies := []struct {
+		verdict Verdict
+		reply   string
+		prose   string
+	}{
+		{VerdictFixable, "VERDICT: FIXABLE\nSUMMARY: rename the helper\nFINDINGS: 01-a: the helper name lies", "FINDINGS: 01-a: the helper name lies"},
+		{VerdictNeedsHuman, "VERDICT: NEEDS-HUMAN\nFINDINGS: the retry policy needs a human call", "the retry policy needs a human call"},
+		{VerdictPass, "VERDICT: PASS\nFINDINGS: ran `make test`; 01-a's criterion is met by the renamed helper", "01-a's criterion is met"},
+	}
+	for _, r := range replies {
+		if res := runVerifyReply(t, d, defPath, r.reply); res.Verdict != r.verdict {
+			t.Fatalf("verdict = %s, want %s", res.Verdict, r.verdict)
+		}
+	}
+
+	reports := verifyReports(t, setDir)
+	if len(reports) != len(replies) {
+		t.Fatalf("got %d reports, want one per invocation (%d)", len(reports), len(replies))
+	}
+	for i, r := range replies {
+		body := reports[i]
+		for _, want := range []string{"# Verify report — demo", "- Work SHA: abc123abc123", "- Verdict: " + string(r.verdict), "- Authored by: the Verifier", r.prose} {
+			if !strings.Contains(body, want) {
+				t.Fatalf("report %d missing %q:\n%s", i, want, body)
+			}
+		}
+		if strings.Contains(body, "VERDICT:") {
+			t.Fatalf("report %d kept the verdict line:\n%s", i, body)
+		}
+	}
+
+	m := LoadManifest(d, "demo", filepath.Join(setDir, "index.json"))
+	p, ok := latestVerifyPointer(d, m)
+	if !ok || !strings.Contains(p.Summary(), "Verify report of abc123abc123") {
+		t.Fatalf("latest pointer = %+v (ok=%v)", p, ok)
+	}
+	data, _ := os.ReadFile(p.Path)
+	if !strings.Contains(string(data), "- Verdict: PASS") {
+		t.Fatalf("latest pointer is not the newest report:\n%s", data)
+	}
+}
+
+// TestMalformedVerifierReplyKeepsItsRawText pins the reply pop cannot read: the
+// verdict is the NEEDS-HUMAN it always was, and the report still holds every
+// word the Verifier wrote.
+func TestMalformedVerifierReplyKeepsItsRawText(t *testing.T) {
+	t.Parallel()
+	for name, reply := range map[string]string{
+		"no verdict line": "I looked around and it seemed fine-ish.",
+		"unknown verdict": "VERDICT: MAYBE\nthe tests were flaky",
+		"empty":           "",
+	} {
+		d, defPath := setupVerifyFixture(t, stubGit("abc123abc123\n", "", ""))
+		res := runVerifyReply(t, d, defPath, reply)
+		if res.Verdict != VerdictNeedsHuman {
+			t.Fatalf("%s: verdict = %s, want NEEDS-HUMAN", name, res.Verdict)
+		}
+		reports := verifyReports(t, filepath.Join(defPath, "demo"))
+		if len(reports) != 1 {
+			t.Fatalf("%s: got %d reports, want 1", name, len(reports))
+		}
+		if !strings.Contains(reports[0], strings.TrimSpace(unparsedFindings(reply))) {
+			t.Fatalf("%s: report lost the raw reply:\n%s", name, reports[0])
+		}
+	}
+}
+
+// TestCachedVerdictWritesNoReportAndReportsOutliveInvalidation pins the
+// divergence ADR-0245 makes on purpose: the cache is served without a new
+// report, and invalidating it deletes the rows but never the reports.
+func TestCachedVerdictWritesNoReportAndReportsOutliveInvalidation(t *testing.T) {
+	t.Parallel()
+	d, defPath := setupVerifyFixture(t, stubGit("abc123abc123\n", "", ""))
+	setDir := filepath.Join(defPath, "demo")
+	runVerifyReply(t, d, defPath, "VERDICT: PASS\nFINDINGS: checked everything")
+
+	opts := verifyCoreOptions{Repo: "/repo/.git", DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+		runVerifier: func(string) (string, error) { t.Fatal("a cached verdict must not invoke the Verifier"); return "", nil }}
+	m, err := loadVerifiableManifest(d, opts)
+	if err != nil {
+		t.Fatalf("load manifest: %v", err)
+	}
+	if _, err := ensureVerifyVerdict(d, nil, opts, m, "abc123abc123"); err != nil {
+		t.Fatalf("ensureVerifyVerdict: %v", err)
+	}
+	if n := len(verifyReports(t, setDir)); n != 1 {
+		t.Fatalf("a cache hit wrote a report: %d reports", n)
+	}
+
+	invalidateVerifyVerdicts(d, "/repo/.git", "demo")
+	if v := readStoredVerdict(t, d, "/repo/.git", "demo", "abc123abc123"); v != nil {
+		t.Fatalf("invalidation kept the cached verdict: %+v", v)
+	}
+	if n := len(verifyReports(t, setDir)); n != 1 {
+		t.Fatalf("invalidation touched the reports: %d left", n)
+	}
+}
+
+// TestVerifierPromptCarriesNoPreviousReport pins the decision that the judge
+// never reads its own homework (ADR-0245).
+func TestVerifierPromptCarriesNoPreviousReport(t *testing.T) {
+	t.Parallel()
