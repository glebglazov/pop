+	for surface, text := range prompts {
+		if strings.Contains(text, path) || strings.Contains(strings.ToLower(text), "verify report") {
+			t.Fatalf("%s carries the verify pointer:\n%s", surface, text)
+		}
+	}
+}
+
+// TestHITLGateReadVerifyEntryPages pins the gate's verify entry: the next free
+// key, the read action, and the human's pager over the document.
+func TestHITLGateReadVerifyEntryPages(t *testing.T) {
+	d, m := hitlFixture(t)
+	path := seedVerifyReport(t, d, m)
+
+	// Re-verify is not offered here, so the verify entry takes key 5.
+	if _, action := hitlGateOutput(t, d, m, "5\n"); action != hitlGateReadVerify {
+		t.Fatalf("expected the verify entry at key 5, got action %d", action)
+	}
+	runner := &fakeAttendedRunner{}
+	d.Runner = runner
+	t.Setenv("PAGER", "mypager")
+	pageReportDocument(d, strings.NewReader(""), "/rt", &bytes.Buffer{}, latestGateReports(d, m).Verify)
+	if runner.attendedCalls != 1 || runner.name != "mypager" || strings.Join(runner.args, " ") != path {
+		t.Fatalf("expected the pager over the document, got %s %v (%d calls)", runner.name, runner.args, runner.attendedCalls)
+	}
+}
+
+// TestFailedRowPointsAtTheReportBesideItsFindings pins the one-line status
+// detail: the first findings line stays, and the report's path sits beside it.
+// An unverified row carries no report and its detail is unchanged.
+func TestFailedRowPointsAtTheReportBesideItsFindings(t *testing.T) {
+	t.Parallel()
+	row := Row{ID: "demo", Status: StatusVerifyFailed, Progress: "1/1", VerifyFindings: "01-a: naming\nmore", VerifyReport: "/sets/demo/verify/verify-20260816T120000Z.md"}
+	got := rowStatusDetail(outputFor(&bytes.Buffer{}), row)
+	if !strings.Contains(got, "findings: 01-a: naming — report: /sets/demo/verify/verify-20260816T120000Z.md") {
+		t.Fatalf("detail = %q", got)
+	}
+	row.VerifyReport = ""
+	if got := rowStatusDetail(outputFor(&bytes.Buffer{}), row); strings.Contains(got, "report:") {
+		t.Fatalf("a row with no report names one: %q", got)
+	}
+}
+
+// TestAcceptedReportWithoutAPriorJudgmentSaysSo covers an Accept with nothing
+// recorded at the commit: the report still files, and says there was nothing
+// to override rather than naming a verdict that never existed.
+func TestAcceptedReportWithoutAPriorJudgmentSaysSo(t *testing.T) {
+	t.Parallel()
+	body := renderAcceptedVerifyReport(newTestDeps(t).Now(), "demo", "abc123abc123", "", nil, "")
+	if strings.Contains(body, "- Overrode:") || !strings.Contains(body, "no Verifier judgment recorded") {
+		t.Fatalf("report = %s", body)
+	}
+	body = renderAcceptedVerifyReport(newTestDeps(t).Now(), "demo", "abc123abc123", "", &store.VerifyVerdict{Verdict: "NEEDS-HUMAN"}, "ok")
+	if !strings.Contains(body, "- Overrode: NEEDS-HUMAN") {
+		t.Fatalf("report = %s", body)
+	}
+}
