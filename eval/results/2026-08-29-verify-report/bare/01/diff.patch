index 00000000..a628866b
--- /dev/null
+++ b/tasks/verify_report.go
@@ -0,0 +1,122 @@
+package tasks
+
+import (
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/store"
+)
+
+// splitVerifierReply separates the Verifier's machine-read verdict line from
+// the prose that justifies it, which becomes the Verify report (ADR-0245). It
+// is splitRefinerReply's shape: the line pop reads is lifted out and every other
+// line is kept, so text the Verifier wrote before its verdict is not lost.
+//
+// The line lifted is the one ParseVerdict reads, so the report and the verdict
+// never disagree about which line was the answer. A reply ParseVerdict cannot
+// read — empty, with no verdict line, or naming an unknown verdict — is kept
+// whole, under the same explanation the stored findings carry, so the report
+// still holds every word the Verifier wrote.
+func splitVerifierReply(raw string) string {
+	lines := strings.Split(strings.TrimSpace(raw), "\n")
+	for i, line := range lines {
+		value, ok := verdictLabelValue(line)
+		if !ok {
+			continue
+		}
+		if _, ok := canonicalVerdict(value); !ok {
+			break
+		}
+		body := strings.TrimSpace(strings.Join(append(append([]string{}, lines[:i]...), lines[i+1:]...), "\n"))
+		if body == "" {
+			return "_The Verifier gave its verdict and wrote nothing after it._"
+		}
+		return body
+	}
+	return unparsedFindings(raw)
+}
+
+// verifyReportAuthorLabel is the header fact that tells a reader who judged:
+// the Verifier, or a human who accepted the set over it.
+const verifyReportAuthorLabel = "Authored by"
+
+// renderVerifyReport wraps a Verifier's prose in the shared report header,
+// plus the verdict it justifies and the agent that wrote it.
+func renderVerifyReport(at time.Time, setID, workSHA, commitRange string, verdict Verdict, agent, body string) string {
+	author := "the Verifier"
+	if agent = strings.TrimSpace(agent); agent != "" {
+		author += " (" + agent + ")"
+	}
+	return renderReportDocument(verifyPass, reportHeader{
+		SetID:       setID,
+		At:          at,
+		CommitRange: commitRange,
+		WorkSHA:     workSHA,
+		Facts: []reportFact{
+			{Label: "Verdict", Value: string(verdict)},
+			{Label: verifyReportAuthorLabel, Value: author},
+		},
+	}, body)
+}
+
+// renderAcceptedVerifyReport is the report of an Accepted verdict (ADR-0103):
+// a human recorded a PASS over the Verifier's judgment. No agent ran, so pop
+// writes the prose itself from the human's note and the verdict it overrode —
+// the set a later reader is most likely to wonder about ("why is this green?")
+// then answers the question itself.
+func renderAcceptedVerifyReport(at time.Time, setID, workSHA, commitRange string, overridden *store.VerifyVerdict, note string) string {
+	overrode := ""
+	if overridden != nil {
+		overrode = overridden.Verdict
+	}
+	var b strings.Builder
+	b.WriteString("## Accepted by a human\n\n")
+	if overrode != "" {
+		b.WriteString("A human recorded this PASS over the Verifier's " + overrode + " judgment. No Verifier ran for this report; the reasons below are the human's own.\n")
+	} else {
+		b.WriteString("A human recorded this PASS with no Verifier judgment recorded at this commit to override. No Verifier ran for this report; the reasons below are the human's own.\n")
+	}
+	b.WriteString("\n## Rationale\n\n")
+	if note = strings.TrimSpace(note); note != "" {
+		b.WriteString(note + "\n")
+	} else {
+		b.WriteString("_The human recorded no rationale._\n")
+	}
+	if overridden != nil && strings.TrimSpace(overridden.Findings) != "" {
+		b.WriteString("\n## The overridden findings\n\n")
+		b.WriteString(strings.TrimSpace(overridden.Findings) + "\n")
+	}
+	return renderReportDocument(verifyPass, reportHeader{
+		SetID:       setID,
+		At:          at,
+		CommitRange: commitRange,
+		WorkSHA:     workSHA,
+		Facts: []reportFact{
+			{Label: "Verdict", Value: string(VerdictPass)},
+			{Label: "Overrode", Value: overrode},
+			{Label: verifyReportAuthorLabel, Value: "a human (Accepted verdict)"},
+		},
+	}, b.String())
+}
+
+// verifyReportBesideFindings is the report path a status row prints beside the
+// first line of its findings, and empty when the row shows no findings — the
+// report then has nothing on the row to stand beside.
+func verifyReportBesideFindings(d *Deps, m *Manifest, findings string) string {
+	if strings.TrimSpace(findings) == "" {
+		return ""
+	}
+	p, ok := latestVerifyPointer(d, m)
+	if !ok {
+		return ""
+	}
+	return p.Path
+}
+
+// latestVerifyPointer resolves the pointer to a set's current Verify report,
+// and false when the set has never been verified. It says why the set was
+// judged as it was; whether that judgment still holds at HEAD is the
+// Verified-at SHA badge's question, never this pointer's (ADR-0245).
+func latestVerifyPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	return latestReportPointer(d, verifyPass, m)
+}
