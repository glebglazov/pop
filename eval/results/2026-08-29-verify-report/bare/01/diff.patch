diff --git a/tasks/verify_report.go b/tasks/verify_report.go
new file mode 100644
index 00000000..5cb6d06f
--- /dev/null
+++ b/tasks/verify_report.go
@@ -0,0 +1,131 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+	"strings"
+)
+
+// verifyReportAuthor is how the header of an Accepted verdict's report names
+// its author, so a reader scanning the set's reports tells it from a
+// Verifier's without opening the body.
+const verifyReportAuthor = "human (Accepted verdict — no Verifier ran)"
+
+// VerifyReportSectionTitle is shared by the CLI and dashboard detail surfaces
+// so both name the Verify pointer's section alike.
+const VerifyReportSectionTitle = "Verify report"
+
+// verifyFactVerdict is the header fact a Verify report records its verdict in,
+// which an Accept reads back when the cached row is gone.
+const verifyFactVerdict = "Verdict"
+
+// verifierReportBody is the report a Verifier's reply becomes: everything after
+// its leading VERDICT line, which is lifted off the front the way
+// splitRefinerReply lifts COMMIT-SUBJECT (ADR-0245) — the verdict is already a
+// header fact, and the prose after it is the Verifier's why.
+//
+// A reply that does not open with a recognised verdict line is kept whole, so
+// nothing the agent wrote is lost: one whose verdict sits further down still
+// parsed and reads as written, and one that parsed to no verdict at all gets
+// the same account of the failure its findings carry, raw text included.
+func verifierReportBody(raw string) string {
+	trimmed := strings.TrimSpace(raw)
+	if !verdictCleanlyParsed(trimmed) {
+		return unparsedFindings(raw)
+	}
+	first, rest, _ := strings.Cut(trimmed, "\n")
+	if value, ok := verdictLabelValue(first); ok {
+		if _, ok := canonicalVerdict(value); ok {
+			if body := strings.TrimSpace(rest); body != "" {
+				return body
+			}
+			return "The Verifier gave no reasons after its verdict line."
+		}
+	}
+	return trimmed
+}
+
+// fileVerifierReport writes the Verify report for one Verifier invocation. It is
+// called only where an agent actually answered: a verdict read back from the
+// cache, or the range-undetermined verdict pop stands in with, invokes nobody
+// and so writes nothing.
+func fileVerifierReport(d *Deps, out io.Writer, m *Manifest, setID, workSHA, commitRange, agent string, verdict Verdict, raw string) {
+	fileVerifyReport(d, out, m, reportHeader{
+		At:          d.Now().UTC(),
+		SetID:       setID,
+		CommitRange: commitRange,
+		WorkSHA:     workSHA,
+		AuthorLabel: "Verifier",
+		Author:      agent,
+		Extra:       []reportFact{{verifyFactVerdict, string(verdict)}},
+	}, verifierReportBody(raw))
+}
+
+// fileAcceptedReport writes the Verify report for an Accepted verdict (ADR-0103,
+// ADR-0245). No agent ran, so pop renders it: the human's rationale and the
+// judgment it overrode, which is the answer a reader of a green set whose
+// findings said otherwise is looking for.
+func fileAcceptedReport(d *Deps, out io.Writer, m *Manifest, setID, workSHA, commitRange string, overrode Verdict, note string) {
+	extra := []reportFact{{verifyFactVerdict, string(VerdictPass) + " (human-authored)"}}
+	overrodePhrase := "No earlier verdict was on record for this set."
+	if overrode != "" {
+		extra = append(extra, reportFact{"Overrode", string(overrode)})
+		overrodePhrase = fmt.Sprintf("It overrides the %s judgment recorded before it.", overrode)
+	}
+	rationale := strings.TrimSpace(note)
+	if rationale == "" {
+		rationale = "The human recorded no note."
+	}
+	var body strings.Builder
+	fmt.Fprintf(&body, "## Accepted by a human\n\n")
+	fmt.Fprintf(&body, "A human recorded this PASS with `pop tasks verify %s --accept`; no Verifier ran. %s\n\n", setID, overrodePhrase)
+	fmt.Fprintf(&body, "## The human's rationale\n\n%s\n", rationale)
+	fileVerifyReport(d, out, m, reportHeader{
+		At:          d.Now().UTC(),
+		SetID:       setID,
+		CommitRange: commitRange,
+		WorkSHA:     workSHA,
+		AuthorLabel: "Author",
+		Author:      verifyReportAuthor,
+		Extra:       extra,
+	}, body.String())
+}
+
+// fileVerifyReport files one Verify report under the set's verify/ directory.
+// It is best-effort: the verdict is what gates the drain, so a report that cannot
+// be written costs a warning rather than the verdict it explains.
+func fileVerifyReport(d *Deps, out io.Writer, m *Manifest, h reportHeader, body string) {
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return
+	}
+	if _, err := verifyReport.write(d, m.Dir, h.At, verifyReport.render(h, body)); err != nil && out != nil {
+		outputFor(out).line(ansiYellow, "   warning: write verify report for %s: %v", h.SetID, err)
+	}
+}
+
+// overriddenVerdict names the judgment an Accept replaces: the verdict cached at
+// the work SHA, or — when invalidation has since deleted it — the verdict the
+// set's latest Verify report records. Empty when neither says.
+func overriddenVerdict(d *Deps, m *Manifest, repo, setID, workSHA string) Verdict {
+	if recorded := latestVerdict(d, repo, setID, workSHA); recorded != nil {
+		return Verdict(recorded.Verdict)
+	}
+	if m == nil || d == nil || d.FS == nil {
+		return ""
+	}
+	if doc, ok := verifyReport.latest(d, m.Dir); ok {
+		value, _, _ := strings.Cut(reportHeaderField(doc.Body, verifyFactVerdict), " ")
+		if v, ok := canonicalVerdict(value); ok {
+			return v
+		}
+	}
+	return ""
+}
+
+// LatestVerifyPointer resolves the pointer to a set's current Verify report, and
+// false when the set has never been verified. It answers why verification judged
+// as it did, never whether that judgment still holds: staleness stays the
+// Verified-at badge's question (ADR-0245), so no surface asks this pointer.
+func LatestVerifyPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	return verifyReport.latestPointer(d, m)
+}
