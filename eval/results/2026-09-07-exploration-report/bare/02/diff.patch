+
+	"github.com/glebglazov/pop/config"
+)
+
+// exploreBody is the report the scripted Explorer writes. Its marker line must
+// never reach a builder's prompt: the report travels as a path.
+const exploreBody = "The tree is the fixture's HEAD.\n\n## Where things live\n\n- tasks/explore.go owns the pass.\n\nSECRET-MAP-BODY"
+
+func interrelatedSet() []Task {
+	return []Task{
+		{ID: "01-a", File: "01-a.md", Title: "Shape the seam", Type: "AFK", Status: "open"},
+		{ID: "02-b", File: "02-b.md", Title: "Build on the seam", Type: "AFK", Status: "open", BlockedBy: []string{"01-a"}},
+	}
+}
+
+// setupExploreDrainFixture is a registered, interrelated set carrying the given
+// set-level keys.
+func setupExploreDrainFixture(t *testing.T, setKeys map[string]any) *runTaskSetFixture {
+	t.Helper()
+	env := setupRunTaskSetFixture(t, "demo", interrelatedSet())
+	writeManifestWithSetKeys(t, filepath.Join(env.tasksDir, "demo"), interrelatedSet(), setKeys)
+	return env
+}
+
+func (e *runTaskSetFixture) setDir() string { return filepath.Join(e.tasksDir, "demo") }
+
+func exploreDisabledConfig() *config.Config {
+	off := false
+	return &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Enabled: &off}}}
+}
+
+// drainOnce drains the fixture's set with the given Explorer and config, and
+// reports the run, the Explorer calls and the prompts the builder saw.
+func drainOnce(t *testing.T, env *runTaskSetFixture, cfg *config.Config, skip bool, explore func(string) (string, string, error)) (*RunTaskSetResult, error, []string) {
+	t.Helper()
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.SkipExplore = skip
+	opts.exploreRunner = explore
+	result, err := RunTaskSetWith(env.deps(), nil, func(string) (*config.Config, error) { return cfg, nil }, opts)
+	return result, err, fakeAgentPrompts(agent)
+}
+
+// TestDrainExploresADeclaredSetOnceAtItsHead drives a whole drain both ways: a
+// declared set with no report is explored before any task is selected and its
+// builders are handed the report's path; a declared set whose report is already
+// there drains with nothing spent on exploring. Absent configuration explores.
+func TestDrainExploresADeclaredSetOnceAtItsHead(t *testing.T) {
+	t.Parallel()
+
+	t.Run("declared with no report", func(t *testing.T) {
+		t.Parallel()
+		env := setupExploreDrainFixture(t, map[string]any{"explore": true})
+		calls := 0
+		var agentPromptsAtExplore int
+		var agent string
+		result, err, prompts := func() (*RunTaskSetResult, error, []string) {
+			agent = writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+			var buf bytes.Buffer
+			opts := env.runTaskSetOpts(true, agent, &buf)
+			opts.TaskSetOverride = "demo"
+			opts.exploreRunner = func(prompt string) (string, string, error) {
+				calls++
+				agentPromptsAtExplore = len(fakeAgentPrompts(agent))
+				if !strings.Contains(prompt, "### 01-a") || !strings.Contains(prompt, "### 02-b") {
+					t.Errorf("explorer prompt lacks the set's task bodies:\n%s", prompt)
+				}
+				return exploreBody, "claude", nil
+			}
+			res, runErr := RunTaskSetWith(env.deps(), nil, nil, opts)
+			return res, runErr, fakeAgentPrompts(agent)
+		}()
+		if err != nil {
+			t.Fatalf("drain: %v", err)
+		}
+		if calls != 1 || agentPromptsAtExplore != 0 {
+			t.Fatalf("explorer ran %d time(s), after %d task attempt(s); want once, before any", calls, agentPromptsAtExplore)
+		}
+		if !result.TaskSetDone || len(prompts) != 2 {
+			t.Fatalf("result = %+v with %d prompts, want both tasks drained", result, len(prompts))
+		}
+		report := filepath.Join(env.setDir(), ExplorationFileName)
+		if body, err := os.ReadFile(report); err != nil || !strings.Contains(string(body), "SECRET-MAP-BODY") {
+			t.Fatalf("report not written: %v %q", err, body)
+		}
+		for _, p := range prompts {
+			if !strings.Contains(p, report) || strings.Contains(p, "SECRET-MAP-BODY") {
+				t.Fatalf("builder prompt must name the report by path and never inline it:\n%s", p)
+			}
+		}
+	})
+
+	t.Run("declared with a report already there", func(t *testing.T) {
+		t.Parallel()
+		env := setupExploreDrainFixture(t, map[string]any{"explore": true})
+		if err := os.WriteFile(filepath.Join(env.setDir(), ExplorationFileName), []byte("# Exploration report — demo\n\nan earlier map\n"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		result, err, prompts := drainOnce(t, env, nil, false, func(string) (string, string, error) {
+			t.Error("a set with a report must spend nothing on exploring")
+			return "", "", nil
+		})
+		if err != nil || !result.TaskSetDone || len(prompts) != 2 {
+			t.Fatalf("drain = %+v, %v with %d prompts", result, err, len(prompts))
+		}
+		runs, _ := listSetRuns(env.deps(), env.setDir())
+		for _, run := range runs {
+			if run.meta.Phase == "explore" {
+				t.Fatalf("an explore run was filed for a set that had its report: %+v", run.meta)
+			}
+		}
+	})
+}
+
+// TestDrainDoesNotExploreUnasked: a set that never declared exploration is
+// untouched, and configuration switched off stops every drain from exploring
+// while the hand-run verb still works.
+func TestDrainDoesNotExploreUnasked(t *testing.T) {
+	t.Parallel()
+	never := func(t *testing.T) func(string) (string, string, error) {
+		return func(string) (string, string, error) {
+			t.Error("the drain explored a set it must not")
+			return "", "", nil
+		}
+	}
+
+	t.Run("undeclared", func(t *testing.T) {
+		t.Parallel()
+		env := setupRunTaskSetFixture(t, "demo", interrelatedSet())
+		result, err, _ := drainOnce(t, env, nil, false, never(t))
+		if err != nil || !result.TaskSetDone {
+			t.Fatalf("drain = %+v, %v", result, err)
+		}
+	})
+
+	t.Run("config off", func(t *testing.T) {
+		t.Parallel()
+		env := setupExploreDrainFixture(t, map[string]any{"explore": true})
+		result, err, _ := drainOnce(t, env, exploreDisabledConfig(), false, never(t))
+		if err != nil || !result.TaskSetDone {
+			t.Fatalf("drain = %+v, %v", result, err)
+		}
+		if _, err := os.Stat(filepath.Join(env.setDir(), ExplorationFileName)); !os.IsNotExist(err) {
+			t.Fatalf("config off still wrote a report: %v", err)
+		}
+		// The hand run is the human asking, and config does not gate it.
+		opts := exploreCoreOptions{DefPath: env.tasksDir, RuntimePath: env.root, SetID: "demo",
+			runExplorer: func(string) (string, string, error) { return exploreBody, "claude", nil }}
+		if _, err := exploreResolvedSet(env.deps(), exploreDisabledConfig(), opts); err != nil {
+			t.Fatalf("hand-run explore with config off: %v", err)
+		}
+	})
+}
+
+// TestExplorerPrecedence: the set's explorer object overrides configuration,
+// and CLI flags win over it.
+func TestExplorerPrecedence(t *testing.T) {
+	t.Parallel()
+	m := &Manifest{Unknown: map[string]json.RawMessage{"explorer": json.RawMessage(`{"agents":["codex"],"effort":"light"}`)}}
+	cfg := &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Agents: config.AgentEntries{{Cmd: "pi"}}, Effort: "heavy"}}}
+
+	sel, err := resolveExplorer(nil, "", m, cfg)
+	if err != nil || strings.Join(sel.Agents, ",") != "codex" || sel.Effort != "light" {
+		t.Fatalf("explorer object over config = %+v, %v; want codex at light", sel, err)
+	}
+	sel, err = resolveExplorer([]string{"claude"}, "heavy", m, cfg)
+	if err != nil || strings.Join(sel.Agents, ",") != "claude" || sel.Effort != "heavy" {
+		t.Fatalf("CLI over explorer object = %+v, %v; want claude at heavy", sel, err)
+	}
+	sel, err = resolveExplorer(nil, "", &Manifest{}, cfg)
+	if err != nil || strings.Join(sel.Agents, ",") != "pi" || sel.Effort != "heavy" {
+		t.Fatalf("config alone = %+v, %v; want pi at heavy", sel, err)
+	}
+	sel, err = resolveExplorer(nil, "", &Manifest{}, nil)
+	if err != nil || sel.Effort != DefaultExploreEffort {
+		t.Fatalf("nothing configured = %+v, %v; want the default effort", sel, err)
+	}
+}
+
+// failingExplorer stands in for an Explorer whose every attempt died: it files
+// the Captured run each attempt files, through the role the walk uses, and
+// gives up.
+func failingExplorer(t *testing.T, env *runTaskSetFixture) func(string) (string, string, error) {
+	return func(string) (string, string, error) {
+		invocation, err := ResolveAgentInvocationWithMode("claude", "", "prompt", env.root, AgentOutputAuto)
+		if err != nil {
+			t.Fatalf("resolve invocation: %v", err)
+		}
+		rec := newStreamRecorder(io.Discard, fakeClock(time.Date(2026, 9, 1, 12, 0, 0, 0, time.UTC), 100*time.Millisecond))
+		explorerRole(env.deps(), io.Discard, env.setDir(), "demo", "sha1").persist(rec, invocation, 3, streamOutcomeFailed, "exit 1", 1)
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report")
+	}
+}
+
+func setRow(t *testing.T, env *runTaskSetFixture) Row {
+	t.Helper()
+	refresh, err := RefreshWith(env.deps(), env.tasksDir, DefaultStatePathWith(env.deps()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	row := findRow(refresh, "demo")
+	if row == nil {
+		t.Fatal("no row for demo")
+	}
+	return *row
+}
+
+func parkRecords(t *testing.T, env *runTaskSetFixture) int {
+	t.Helper()
+	data, _ := os.ReadFile(filepath.Join(env.setDir(), ProgressFileName))
+	return strings.Count(string(data), "[set] "+string(StatusExploreFailed))
+}
+
+// TestAFailedExploreParksTheSetUntilAWayOut drives the park: a declared set
+// whose pass gives up reads EXPLORE-FAILED (not BLOCKED), automatic selection
+// passes over it, one set-level Progress record says why, and the skip flag
+// drains it once without exploring and without parking again.
+func TestAFailedExploreParksTheSetUntilAWayOut(t *testing.T) {
+	t.Parallel()
+	env := setupExploreDrainFixture(t, map[string]any{"explore": true})
+
+	result, err, prompts := drainOnce(t, env, nil, false, failingExplorer(t, env))
+	if err == nil || !result.TaskSetExploreFailed || len(prompts) != 0 {
+		t.Fatalf("drain = %+v, %v with %d task prompts; want a park before any task", result, err, len(prompts))
+	}
+	if n := parkRecords(t, env); n != 1 {
+		t.Fatalf("park records = %d, want exactly one", n)
+	}
+	data, _ := os.ReadFile(filepath.Join(env.setDir(), ProgressFileName))
+	if !strings.Contains(string(data), "phase explore: ") || !strings.Contains(string(data), "produced no report") {
+		t.Fatalf("park record does not name the phase and the reason:\n%s", data)
+	}
+
+	row := setRow(t, env)
+	if row.Status != StatusExploreFailed || row.ExploreMark != ExploreMarkUnexplored || row.UnexploredReason != UnexploredFailed {
+		t.Fatalf("row = %s / %s (%s), want EXPLORE-FAILED, unexplored: failed", row.Status, row.ExploreMark, row.UnexploredReason)
+	}
+	refresh, _ := RefreshWith(env.deps(), env.tasksDir, DefaultStatePathWith(env.deps()))
+	if id, _, err := SelectTaskSet(refresh, ""); err == nil {
+		t.Fatalf("automatic selection picked %q, a parked set", id)
+	}
+
+	result, err, prompts = drainOnce(t, env, nil, true, func(string) (string, string, error) {
+		t.Error("--skip-explore must not explore")
+		return "", "", nil
+	})
+	if err != nil || !result.TaskSetDone || len(prompts) != 2 {
+		t.Fatalf("skip-explore drain = %+v, %v with %d prompts", result, err, len(prompts))
+	}
+	if n := parkRecords(t, env); n != 1 {
+		t.Fatalf("park records after the skip drain = %d, want still one", n)
+	}
+}
+
+// TestTheParkClearsByHandOrByRetraction: a successful hand run clears the park,
+// and so does the author retracting the declaration.
+func TestTheParkClearsByHandOrByRetraction(t *testing.T) {
+	t.Parallel()
+	park := func(t *testing.T) *runTaskSetFixture {
+		env := setupExploreDrainFixture(t, map[string]any{"explore": true})
+		if _, err, _ := drainOnce(t, env, nil, false, failingExplorer(t, env)); err == nil {
+			t.Fatal("expected the drain to park")
+		}
+		if row := setRow(t, env); row.Status != StatusExploreFailed {
+			t.Fatalf("status = %s, want the park", row.Status)
+		}
+		return env
+	}
+
+	t.Run("hand run", func(t *testing.T) {
+		t.Parallel()
+		env := park(t)
+		opts := exploreCoreOptions{DefPath: env.tasksDir, RuntimePath: env.root, SetID: "demo",
+			runExplorer: func(string) (string, string, error) { return exploreBody, "claude", nil }}
+		if _, err := exploreResolvedSet(env.deps(), nil, opts); err != nil {
+			t.Fatal(err)
+		}
+		if row := setRow(t, env); row.Status != StatusReady || row.ExploreMark != ExploreMarkExplored {
+			t.Fatalf("row = %s / %s, want READY and explored", row.Status, row.ExploreMark)
+		}
+	})
+
+	t.Run("retraction", func(t *testing.T) {
+		t.Parallel()
+		env := park(t)
+		writeManifestWithSetKeys(t, env.setDir(), interrelatedSet(), map[string]any{"explore": false})
+		if row := setRow(t, env); row.Status != StatusReady || row.ExploreMark != ExploreMarkNone {
+			t.Fatalf("row = %s / %q, want READY with no mark", row.Status, row.ExploreMark)
+		}
+	})
+}
