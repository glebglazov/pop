+
+// setupExploreFixture is a set nobody has built yet, at a fixed instant, over a
+// stub git whose HEAD the report must record.
+func setupExploreFixture(t *testing.T, setKeys map[string]any) (*Deps, string, string) {
+	t.Helper()
+	d := newTestDeps(t)
+	d.Clock = deps.FixedClock{Instant: time.Date(2026, 9, 1, 12, 0, 0, 0, time.UTC)}
+	d.Git = stubGit("abc123abc123\n", "", "")
+	root := t.TempDir()
+	defPath := filepath.Join(root, "tasks")
+	tasks := []Task{
+		{ID: "01-a", File: "01-a.md", Title: "Shape the seam", Type: "AFK", Status: "open"},
+		{ID: "02-b", File: "02-b.md", Title: "Build on the seam", Type: "AFK", Status: "open", BlockedBy: []string{"01-a"}},
+	}
+	setupManifest(t, defPath, "demo", tasks)
+	if setKeys != nil {
+		writeManifestWithSetKeys(t, filepath.Join(defPath, "demo"), tasks, setKeys)
+	}
+	return d, defPath, filepath.Join(defPath, "demo")
+}
+
+func exploreOpts(defPath string, out *bytes.Buffer) exploreCoreOptions {
+	opts := exploreCoreOptions{DefPath: defPath, RuntimePath: "/rt", SetID: "demo", Agents: []string{"claude"}}
+	if out != nil {
+		opts.Output = out
+	}
+	return opts
+}
+
+// TestHandExploreWritesTheReportAndFilesItsOwnRun drives the whole pass through
+// the real agent walk: the Explorer's reply lands flat in the set directory as
+// the Exploration report, headed by the tree it was observed at, and the
+// invocation is a Captured run of its own phase that spend counts as explore.
+// The set never declared exploration — a hand run asks nothing of the key.
+func TestHandExploreWritesTheReportAndFilesItsOwnRun(t *testing.T) {
+	t.Parallel()
+	d, defPath, setDir := setupExploreFixture(t, nil)
+	runner := &scriptedRefineRunner{runs: []scriptedRefineRun{
+		{output: claudeRefineStream(`The tree is abc123a.\n\n## Where things live\n\n- tasks/explore.go owns the pass.`)},
+	}}
+	d.Git = stubGit("abc123abc123\n", "", "")
+	d.LookPath = func(string) (string, error) { return "/bin/claude", nil }
+	d.Runner = &probeNeutralRunner{inner: runner}
+
+	var out bytes.Buffer
+	res, err := exploreResolvedSet(d, nil, exploreOpts(defPath, &out))
+	if err != nil {
+		t.Fatalf("explore: %v\n%s", err, out.String())
+	}
+	if res.Path != filepath.Join(setDir, ExplorationFileName) {
+		t.Fatalf("report path = %q, want it flat in the set directory", res.Path)
+	}
+	body, err := os.ReadFile(res.Path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{"# Exploration report — demo", "- Work SHA: abc123a", "- Explorer: claude", "tasks/explore.go owns the pass."} {
+		if !strings.Contains(string(body), want) {
+			t.Fatalf("report is missing %q:\n%s", want, body)
+		}
+	}
+
+	runs, err := listSetRuns(d, setDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(runs) != 1 || runs[0].meta.Phase != "explore" || runs[0].meta.TaskFile != "" {
+		t.Fatalf("captured runs = %+v, want one set-level explore run", runs)
+	}
+	m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+	breakdown, err := buildSpendSetBreakdown(d, "demo", m, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if breakdown.ExploreRunCount != 1 || breakdown.ImplementRunCount != 0 {
+		t.Fatalf("buckets = explore %d / implement %d, want the run counted as explore", breakdown.ExploreRunCount, breakdown.ImplementRunCount)
+	}
+}
+
+// TestExplorerPromptCarriesTheSetAndAsksForTheCodeAsFound pins what reaches the
+// Explorer: the listing, every task body and the spec, the one-page,
+// path-or-symbol contract and the tree — and nothing about prior art.
+func TestExplorerPromptCarriesTheSetAndAsksForTheCodeAsFound(t *testing.T) {
+	t.Parallel()
+	d, defPath, setDir := setupExploreFixture(t, nil)
+	d.Git = stubGit("abc123abc123\n", "", "")
+	if err := os.WriteFile(filepath.Join(setDir, SpecFileName), []byte("# Spec\n\nOne seam, two tasks.\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	var got string
+	opts := exploreOpts(defPath, nil)
+	opts.runExplorer = func(prompt string) (string, string, error) {
+		got = prompt
+		return "## Where things live", "claude", nil
+	}
+	if _, err := exploreResolvedSet(d, nil, opts); err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{
+		"01-a [AFK open] Shape the seam", "02-b [AFK open] Build on the seam",
+		"### 01-a", "### 02-b", "One seam, two tasks.",
+		"Every claim names a path or a symbol", "about one page", "commit abc123a",
+	} {
+		if !strings.Contains(got, want) {
+			t.Fatalf("explorer prompt is missing %q:\n%s", want, got)
+		}
+	}
+	if strings.Contains(strings.ToLower(got), "prior art") {
+		t.Fatalf("explorer prompt asks about prior art:\n%s", got)
+	}
+}
+
+// TestHandExploreOverwritesAReportAndAFailedPassLeavesItAlone: a hand run is
+// the human re-opening the question, so a finished pass replaces the report,
+// while one that fails writes nothing over it.
+func TestHandExploreOverwritesAReportAndAFailedPassLeavesItAlone(t *testing.T) {
+	t.Parallel()
+	d, defPath, setDir := setupExploreFixture(t, map[string]any{"explore": true})
+	path := filepath.Join(setDir, ExplorationFileName)
+	if err := os.WriteFile(path, []byte("old map\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	failing := exploreOpts(defPath, nil)
+	failing.runExplorer = func(string) (string, string, error) { return "half a map", "claude", errInterruptedForTest() }
+	if _, err := exploreResolvedSet(d, nil, failing); err == nil {
+		t.Fatal("an interrupted pass reported success")
+	}
+	if body, _ := os.ReadFile(path); string(body) != "old map\n" {
+		t.Fatalf("a failed pass touched the report: %q", body)
+	}
+
+	fresh := exploreOpts(defPath, nil)
+	fresh.runExplorer = func(string) (string, string, error) { return "new map", "claude", nil }
+	if _, err := exploreResolvedSet(d, nil, fresh); err != nil {
+		t.Fatal(err)
+	}
+	if body, _ := os.ReadFile(path); !strings.Contains(string(body), "new map") || strings.Contains(string(body), "old map") {
+		t.Fatalf("a finished pass did not replace the report: %q", body)
+	}
+}
+
+func errInterruptedForTest() error {
+	return exitErr(ExitInterrupted, "interrupted")
+}
