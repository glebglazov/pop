+// exploreKeysGuide teaches the Explore phase's two set-level keys (ADR-0262).
+// The key names and the report's filename are the constants the manifest
+// accessors and the orphan check read, so a renamed key renames itself here.
+func exploreKeysGuide() string {
+	return fmt.Sprintf(`- `+"`%[1]s`"+` — optional boolean, and opt-**in**, the reverse of
+  `+"`verify`"+` and `+"`refine`"+`: absent or `+"`false`"+` means the set
+  never explores. Write `+"`true`"+` and the drain writes an Exploration report
+  (%[3]s — the code as found, about a page) before the set's first task,
+  and every builder is handed it. Set it when two or more AFK tasks touch the
+  same seam and a later one depends on how an earlier one shapes it. Never set
+  it for a set's size, or because the area is unfamiliar. A declared set whose
+  pass cannot produce the report parks rather than building blind; a hand-run
+  `+"`pop tasks explore`"+` runs on any set regardless of this key.
+- `+"`%[2]s`"+` — optional
+  `+"`{\"agents\": [...], \"effort\": \"...\"}`"+` object steering *how*
+  the set is explored, exactly as `+"`verifier`"+` / `+"`refiner`"+` do: it
+  overrides the configured agent list and effort, CLI flags still win over it,
+  and it steers only — participation stays the `+"`%[1]s`"+` key's business.
+`, manifestExploreKey, manifestExplorerKey, ExplorationFileName)
+}
+
