+package setkind
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/tasks"
+)
+
+// TestContainerCarriesTheRowsExploreMark: the Task-set container takes the
+// Explore mark the refresh resolved — it derives nothing again — and the detail
+// view's Exploration section points at the report by path and tree.
+func TestContainerCarriesTheRowsExploreMark(t *testing.T) {
+	rows := []tasks.Row{{
+		ID:                 "demo",
+		Status:             tasks.StatusReady,
+		ExploreMark:        tasks.ExploreMarkExplored,
+		ExplorationPointer: tasks.ReportPointer{Label: "Exploration", Path: "/def/demo/exploration.md", WorkSHA: "abc1234"},
+	}}
+	d := testDeps(t, rows)
+	d.Refresh = func(string) (*tasks.RefreshResult, error) {
+		return &tasks.RefreshResult{Rows: rows, Manifests: map[string]*tasks.Manifest{"demo": {Valid: true, Dir: "/def/demo"}}}, nil
+	}
+	scan := scanFixture{Name: "pop", ProjectPath: "/repo/main", RuntimePath: "/repo/main", DefinitionPath: "/def", RepoKey: "repo-key"}
+	got, err := rowsForStatic(d, &config.Config{}, staticForScan(scan, "main", false))
+	if err != nil || len(got) != 1 {
+		t.Fatalf("containers = %+v, %v", got, err)
+	}
+	c := got[0]
+	if c.ExploreMark != tasks.ExploreMarkExplored {
+		t.Fatalf("container mark = %q, want explored", c.ExploreMark)
+	}
+	if len(c.DetailSections) == 0 || c.DetailSections[0].Title != tasks.ExploreSectionTitle {
+		t.Fatalf("detail sections = %+v, want the Exploration section first", c.DetailSections)
+	}
+	body := c.DetailSections[0].Body
+	if !strings.Contains(body, "/def/demo/exploration.md") || !strings.Contains(body, "tree: abc1234") {
+		t.Fatalf("section does not point at the report and its tree:\n%s", body)
+	}
+	if !strings.Contains(tasks.WorkRowStatusCell(c), "explored") {
+		t.Fatalf("status cell = %q, want the mark beside the status", tasks.WorkRowStatusCell(c))
+	}
+}
