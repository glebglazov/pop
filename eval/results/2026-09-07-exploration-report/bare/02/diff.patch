+	if err := os.WriteFile(filepath.Join(setDir, ExplorationFileName), []byte("# Exploration report\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	example := strings.TrimSuffix(strings.TrimSpace(fencedBlock(t, guide, "json", 0)), "}")
+	manifest := example + ",\n  \"" + manifestExploreKey + "\": true,\n  \"" + manifestExplorerKey + "\": {\"agents\": [\"codex\"], \"effort\": \"light\"}\n}\n"
+	manifestPath := filepath.Join(setDir, ManifestFileName)
+	if err := os.WriteFile(manifestPath, []byte(manifest), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	m := LoadManifest(&Deps{FS: deps.NewRealFileSystem()}, "2026-08-03-demo", manifestPath)
+	if !m.Valid {
+		t.Fatalf("a set carrying the explore keys and its report does not validate: %v", m.Errors)
