--- /dev/null
+++ b/tasks/explore.go
@@ -0,0 +1,398 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/prompt"
+	"github.com/glebglazov/pop/project"
+)
+
+// DefaultExploreEffort is the model-strength tier the Explorer runs at when
+// neither a CLI flag, the set's `explorer` object nor [work.explore].effort
+// names one (ADR-0262). Recording where code lives is reading, not judging, so
+// it defaults below the Verifier and the Refiner.
+const DefaultExploreEffort = "standard"
+
+// explorationReport is the Exploration report's document shape on the shared
+// pass-report machinery (ADR-0245): the header of facts and its read-back. It
+// is flat — one `exploration.md` beside the spec — so it borrows nothing of
+// the timestamped filing or the newest-by-timestamp scan the two families that
+// rerun use (ADR-0262 decision 1).
+var explorationReport = passReport{
+	ArtifactType: ArtifactTypeExploration,
+	Title:        "Exploration report",
+	WrittenLabel: "Explored",
+	AgentLabel:   "Explorer",
+	Noun:         "explore",
+	PointerLabel: "Exploration",
+}
+
+// ExploreOptions configures a `pop tasks explore <set>` run.
+type ExploreOptions struct {
+	ResolveInput ResolveInput
+	// TaskSetID is the bare Task-set identifier to explore.
+	TaskSetID string
+	// Agents is the ordered CLI Explorer fallback list (`--agent`, repeatable).
+	// Empty ⇒ the set's `explorer` object, then [work.explore].agents, then
+	// [work.implement].agents.
+	Agents []string
+	// Effort is the CLI Explorer effort override (`--effort`). Empty ⇒ the set's
+	// `explorer` object, then config, then DefaultExploreEffort.
+	Effort string
+	// Timeout bounds one Explorer attempt. Zero uses DefaultAttemptTimeout.
+	Timeout time.Duration
+	// Output receives the live agent stream and the run's chrome.
+	Output io.Writer
+	// Wait is the `--wait` / `--no-wait` tri-state for admission to the checkout
+	// (ADR-0239).
+	Wait AdmissionWaitChoice
+	// ConfirmIn is the invocation's input, read only to resolve Wait.
+	ConfirmIn io.Reader
+}
+
+// ExploreResult is the outcome of one explore pass.
+type ExploreResult struct {
+	SetID   string
+	WorkSHA string
+	// Path is the Exploration report written.
+	Path string
+	// Body is the document itself.
+	Body string
+}
+
+// exploreCoreOptions carries the already-resolved inputs to the core explore
+// routine, so the drain and tests drive it without real path resolution. The
+// runExplorer seam replaces the real agent spawn in tests.
+type exploreCoreOptions struct {
+	DefPath     string
+	RuntimePath string
+	SetID       string
+	Agents      []string
+	Effort      string
+	Timeout     time.Duration
+	Output      io.Writer
+	// runExplorer returns the Explorer's report and the agent that wrote it.
+	runExplorer func(prompt string) (string, string, error)
+	probeMemo   *agentAvailabilityProbeMemo
+	admission   AdmissionPolicy
+	// checkoutHeld says the caller already holds this checkout for this set —
+	// the drain's own explore step — so the pass takes nothing of its own.
+	checkoutHeld bool
+}
+
+// ExploreTaskSet explores a set using default dependencies.
+func ExploreTaskSet(opts ExploreOptions) (*ExploreResult, error) {
+	return ExploreTaskSetWith(defaultDeps, project.DefaultDeps(), config.Load, opts)
+}
+
+// ExploreTaskSetWith is `pop tasks explore <set>` (ADR-0262): it hands a fresh
+// Explorer the set's manifest listing, its task bodies and its spec, and writes
+// what comes back as the set's Exploration report. A hand run is the human
+// re-opening the question, so it runs on any set whatever its `explore` key
+// says, and it overwrites a report already there.
+func ExploreTaskSetWith(d *Deps, pd *project.Deps, loadConfig func(string) (*config.Config, error), opts ExploreOptions) (*ExploreResult, error) {
+	resolved, err := ResolvePathsWith(d, pd, loadConfig, opts.ResolveInput)
+	if err != nil {
+		return nil, err
+	}
+	runtimePath, err := ResolveRuntimePathWith(d, resolved.ProjectPath, opts.ResolveInput.RuntimeOverride)
+	if err != nil {
+		return nil, err
+	}
+	cfg, _ := loadConfig(d.defaultConfigPath())
+	return exploreResolvedSet(d, cfg, exploreCoreOptions{
+		DefPath:     resolved.DefinitionPath,
+		RuntimePath: runtimePath,
+		SetID:       strings.TrimSpace(opts.TaskSetID),
+		Agents:      opts.Agents,
+		Effort:      opts.Effort,
+		Timeout:     opts.Timeout,
+		Output:      opts.Output,
+		admission:   opts.Wait.Policy(opts.ConfirmIn),
+	})
+}
+
+// exploreResolvedSet is the resolved-path core both the hand run and the drain
+// go through. It writes the report only from a pass that finished: a failed or
+// interrupted pass leaves whatever report was there untouched, and on a set
+// that declared exploration it leaves the one Progress record that says why
+// (ADR-0262 decision 6).
+func exploreResolvedSet(d *Deps, cfg *config.Config, opts exploreCoreOptions) (*ExploreResult, error) {
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{SetID: opts.SetID, DefPath: opts.DefPath})
+	if err != nil {
+		return nil, err
+	}
+	// The Explorer reads the checkout it describes, so a drain rewriting files
+	// under it would have it record a tree that never existed (ADR-0238).
+	if !opts.checkoutHeld {
+		hold, err := AcquireTreeStable(d, opts.RuntimePath, opts.SetID, opts.Output, opts.admission)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = hold.Release() }()
+	}
+	workSHA := verifyWorkSHA(d, opts.RuntimePath)
+	body, agent, err := runExplorer(d, cfg, opts, m, workSHA)
+	if err != nil {
+		recordExploreFailure(d, opts.Output, m, err)
+		return nil, err
+	}
+	at := d.Now().UTC()
+	doc := explorationReport.renderDocument(at, opts.SetID, workSHA, "", agent, body)
+	path := explorationPath(m)
+	if err := WriteAtomicWith(d, path, []byte(ensureTrailingNewline(doc)), 0o644); err != nil {
+		writeErr := exitErr(ExitOperational, "write exploration report: %v", err)
+		recordExploreFailure(d, opts.Output, m, writeErr)
+		return nil, writeErr
+	}
+	printExploreWritten(opts.Output, opts.SetID, path)
+	return &ExploreResult{SetID: opts.SetID, WorkSHA: workSHA, Path: path, Body: doc}, nil
+}
+
+// explorationPath is where a set's Exploration report lives: flat, beside the
+// spec and the progress record.
+func explorationPath(m *Manifest) string {
+	return filepath.Join(m.Dir, ExplorationFileName)
+}
+
+// hasExplorationReport reports whether the set has its report. Presence is the
+// whole rule — absent means write it, present means reuse it — and nothing
+// compares the tree the report records to the checkout (ADR-0262 decision 3).
+func hasExplorationReport(d *Deps, m *Manifest) bool {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return false
+	}
+	info, err := d.FS.Stat(explorationPath(m))
+	return err == nil && !info.IsDir()
+}
+
+// explorationPromptPath is the report as an implement attempt is handed it: its
+// path when the set has one, and nothing at all when it does not.
+func explorationPromptPath(d *Deps, m *Manifest) string {
+	if !hasExplorationReport(d, m) {
+		return ""
+	}
+	return explorationPath(m)
+}
+
+// explorationBlockView is the report as the Assist prompt names it: the path and
+// the tree its header records, never its body.
+type explorationBlockView struct {
+	HasReport bool
+	Path      string
+	Tree      string
+}
+
+// explorationBlock resolves that view for a set, and the empty view — which
+// renders nothing — for a set with no report.
+func explorationBlock(d *Deps, m *Manifest) explorationBlockView {
+	p, ok := explorationPointer(d, m)
+	if !ok {
+		return explorationBlockView{}
+	}
+	return explorationBlockView{HasReport: true, Path: p.Path, Tree: p.WorkSHA}
+}
+
+// recordExploreFailure appends the set-level Progress record a declared set's
+// failed pass leaves behind, so why the set stopped is readable without opening
+// a Captured run. A set that never declared exploration is not parked by a
+// failed hand run, so it gets no record either.
+func recordExploreFailure(d *Deps, out io.Writer, m *Manifest, cause error) {
+	if !m.ExploreDeclared() {
+		return
+	}
+	reason := "interrupted"
+	if !isInterrupted(cause) {
+		reason = strings.TrimSpace(cause.Error())
+	}
+	summary := fmt.Sprintf("phase %s: %s\nThe set waits rather than building without a shared map. Ways out: pop tasks explore %s; pop tasks implement %s --skip-explore; or set \"%s\": false.",
+		spendPhaseExplore, reason, m.Stem, m.Stem, manifestExploreKey)
+	if err := AppendSetProgress(d, m.Dir, string(StatusExploreFailed), summary); err != nil && out != nil {
+		fmt.Fprintf(out, "warning: record explore failure for %s: %v\n", m.Stem, err)
+	}
+}
+
+// runExplorer builds the prompt and invokes the Explorer, returning the report
+// and the agent that wrote it.
+func runExplorer(d *Deps, cfg *config.Config, opts exploreCoreOptions, m *Manifest, workSHA string) (string, string, error) {
+	text := buildExplorerPrompt(d, m, workSHA)
+	run := opts.runExplorer
+	if run == nil {
+		sel, err := resolveExplorer(opts.Agents, opts.Effort, m, cfg)
+		if err != nil {
+			return "", "", err
+		}
+		run = func(prompt string) (string, string, error) {
+			return runConfiguredExplorer(d, cfg, sel, m.Dir, opts.SetID, workSHA, opts.RuntimePath, prompt, opts.Output, opts.Timeout, opts.probeMemo)
+		}
+	}
+	body, agent, err := run(text)
+	if err != nil {
+		return "", "", err
+	}
+	if strings.TrimSpace(body) == "" {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", opts.SetID)
+	}
+	return body, agent, nil
+}
+
+// resolveExplorer applies the Explorer precedence chain (ADR-0262), highest
+// first: CLI flags → the set's `explorer` object → [work.explore] →
+// [work.implement].agents / DefaultExploreEffort. It is the Refiner's chain with
+// the Explorer's keys, including the refusal an override of `agents = []`
+// earns (ADR-0202 decision 6).
+func resolveExplorer(cliAgents []string, cliEffort string, m *Manifest, cfg *config.Config) (verifierSelection, error) {
+	agents := nonEmptyStrings(cliAgents)
+	effort := strings.TrimSpace(cliEffort)
+
+	if over := m.ExplorerOverride(); over != nil {
+		if len(agents) == 0 {
+			agents = nonEmptyStrings(over.Agents)
+		}
+		if effort == "" {
+			effort = strings.TrimSpace(over.Effort)
+		}
+	}
+	if e := cfg.ExploreSettings(); e != nil && effort == "" {
+		effort = strings.TrimSpace(e.Effort)
+	}
+	if len(agents) == 0 {
+		resolved, err := ResolveAgentGroupPresets(cfg.ExploreAgentList(), cfg)
+		if err != nil {
+			return verifierSelection{}, err
+		}
+		agents = resolved
+	}
+	if effort == "" {
+		effort = DefaultExploreEffort
+	}
+	return verifierSelection{Agents: agents, Effort: effort}, nil
+}
+
+// runConfiguredExplorer walks the resolved Explorer agent list through the
+// shared fallback walk at the standard per-phase cap, so one flake cannot park
+// a declared set (ADR-0262 decision 5).
+func runConfiguredExplorer(d *Deps, cfg *config.Config, sel verifierSelection, taskSetDir, setID, workSHA, runtimePath, prompt string, out io.Writer, timeout time.Duration, probeMemo *agentAvailabilityProbeMemo) (string, string, error) {
+	if timeout <= 0 {
+		timeout = DefaultAttemptTimeout
+	}
+	quotaRetryAfter, err := resolveAgentQuotaRetryAfter(cfg)
+	if err != nil {
+		return "", "", exitErr(ExitSetup, "%v", err)
+	}
+	walked, err := runAgentFallbackWalk(d, agentFallbackWalk{
+		role:            explorerRole(d, out, taskSetDir, setID, workSHA),
+		sel:             sel,
+		setID:           setID,
+		runtimePath:     runtimePath,
+		prompt:          prompt,
+		out:             out,
+		errOut:          out,
+		timeout:         timeout,
+		maxTries:        config.DefaultTaskMaxTries,
+		retryDelays:     append([]time.Duration(nil), config.DefaultTaskAttemptRetryDelays...),
+		quotaRetryAfter: quotaRetryAfter,
+		cfg:             cfg,
+		probeMemo:       probeMemo,
+	})
+	if err != nil {
+		return "", "", err
+	}
+	// Prose from an attempt that died is half a map, and builders handed half a
+	// map are the inconsistency the pass exists to prevent.
+	if strings.TrimSpace(walked.Answer) != "" && !walked.AnswerRetryEligible {
+		return walked.Answer, walked.Agent, nil
+	}
+	if len(walked.Unavailable) == 0 {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report")
+	}
+	return "", "", exitErr(ExitSetup, "%s", formatHumanHealingExhaustionMessage(walked.Unavailable))
+}
+
+// explorerRole is what the shared fallback walk calls the Explorer: its name in
+// the operator's output, the Captured run each invocation is filed as under the
+// `explore` phase, and the Refiner's retry rule — a report has no format to
+// parse, so any prose from a run that reached its own ending is the answer.
+//
+// It is the one role that runs under the read-only agent posture (ADR-0221):
+// the Explorer's whole output is its reply, which pop writes as the report, so
+// it has no edit to make and the posture withholds the tools for one.
+func explorerRole(d *Deps, errOut io.Writer, taskSetDir, setID, workSHA string) agentRole {
+	return agentRole{
+		Noun:   "Explorer agent",
+		Gerund: "Exploring",
+		Phase:  spendPhaseExplore,
+		Persist: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int) {
+			_ = persistExploreRun(d, errOut, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode)
+		},
+		PersistAnswer: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int, _ string) {
+			_ = persistExploreRun(d, errOut, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode)
+		},
+		PersistSkipped: func(rec *streamRecorder, invocation *AgentInvocation, model string, try int, reason string, exitCode int) {
+			_ = persistExploreRun(d, errOut, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, model, try, streamOutcomeModelSkipped, reason, exitCode)
+		},
+		RetryEligible: refineAttemptRetryEligible,
+		ReadOnly:      true,
+	}
+}
+
+// printExploreWritten tells the operator where the report went and how to read
+// it.
+func printExploreWritten(w io.Writer, setID, path string) {
+	if w == nil {
+		return
+	}
+	out := outputFor(w)
+	out.line(ansiBold, "━━ Exploration for %s", setID)
+	out.line(ansiDim, "   Document: %s", path)
+	out.line(ansiDim, "   Read it: pop tasks artifacts %s --show %s", setID, ExplorationFileName)
+}
+
+// buildExplorerPrompt assembles the Explorer's prompt: pop's role framing and
+// output expectation around the set's own material — its manifest listing,
+// every task body, and its spec when there is one. It deliberately asks for
+// nothing about prior art; that check stays in the builder's frame, where its
+// trigger is (ADR-0262 decision 7).
+func buildExplorerPrompt(d *Deps, m *Manifest, workSHA string) string {
+	view := explorerPromptView{
+		TaskSet: m.Stem,
+		WorkSHA: ShortSHA(workSHA),
+		Tasks:   gateTaskRows(m),
+	}
+	for _, task := range m.Tasks {
+		view.Bodies = append(view.Bodies, explorerTaskBody{
+			ID:   task.ID,
+			Body: readTaskBody(d, filepath.Join(m.Dir, task.File)),
+		})
+	}
+	if spec, ok := readSpec(d, m); ok {
+		view.SpecRecorded = true
+		view.Spec = spec
+	}
+	return prompt.MustRender(promptTemplates, "explorer.tmpl.md", view)
+}
+
+// explorerPromptView is what the Explorer's template renders against.
+type explorerPromptView struct {
+	TaskSet      string
+	WorkSHA      string
+	SpecRecorded bool
+	Spec         string
+	Tasks        []taskRow
+	Bodies       []explorerTaskBody
+}
+
+// explorerTaskBody is one task's body as the Explorer reads it: inlined whole,
+// because the tasks are what decides which area of the code is worth mapping.
+type explorerTaskBody struct {
+	ID   string
+	Body taskBodyRow
+}
diff --git a/tasks/explore_mark.go b/tasks/explore_mark.go
new file mode 100644
index 00000000..68c9d423
--- /dev/null
+++ b/tasks/explore_mark.go
@@ -0,0 +1,201 @@
+package tasks
+
+import (
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/work"
+)
+
+// ExploreMark is whether a set that declared `"explore": true` got its
+// Exploration report, carried beside its status the way the Verification and
+// Refine marks are (ADR-0262). A set that never asked carries none.
+//
+// It answers one question — explored, yes or no — and the reason a set is not
+// rides beside it as an UnexploredReason rather than as a value inside it.
+// ResolveExploreMark is the one place that derives both.
+type ExploreMark = work.ExploreMark
+
+const (
+	// ExploreMarkNone is the absent mark: the set never declared exploration.
+	ExploreMarkNone ExploreMark = ""
+	// ExploreMarkExplored is a declared set whose report is on disk.
+	ExploreMarkExplored ExploreMark = "explored"
+	// ExploreMarkUnexplored is a declared set with no report.
+	ExploreMarkUnexplored ExploreMark = "unexplored"
+)
+
+// UnexploredReason is why an unexplored set has no report — the detail beside
+// the mark, never a second mark.
+type UnexploredReason = work.UnexploredReason
+
+const (
+	// UnexploredReasonNone is the absent reason: the set is explored, or it
+	// carries no mark.
+	UnexploredReasonNone UnexploredReason = ""
+	// UnexploredNotYetRun is a declared set no Explore pass has run for.
+	UnexploredNotYetRun UnexploredReason = "not-yet-run"
+	// UnexploredFailed is a declared set whose pass ran and wrote no report. On a
+	// set that still has agent work to do it is also the status, EXPLORE-FAILED.
+	UnexploredFailed UnexploredReason = "failed"
+)
+
+// ExploreResolution is what the read-side resolution answers for one set: the
+// mark, the reason beside an unexplored one, and — for an explored set — the
+// report as a pointer, never its body.
+type ExploreResolution struct {
+	Mark   ExploreMark
+	Reason UnexploredReason
+	// Pointer is the report's path and the tree its header records, set only
+	// when Mark is ExploreMarkExplored.
+	Pointer ReportPointer
+}
+
+// ResolveExploreMark is the single read-side Explore mark resolution
+// (ADR-0262). The status overlay, the sign-off gate, the Assist prompt and
+// every status surface read this answer, so none of them can disagree about a
+// set.
+//
+// It stores nothing. The report on disk says explored; otherwise a Captured run
+// of phase `explore` says a pass ran and failed to write one, and no such run
+// says none has run yet. That is the whole of the park's derivation — no store
+// column and no table — and nothing here compares the tree the report records
+// to the checkout.
+func ResolveExploreMark(d *Deps, m *Manifest) ExploreResolution {
+	if !m.ExploreDeclared() {
+		return ExploreResolution{}
+	}
+	if pointer, ok := explorationPointer(d, m); ok {
+		return ExploreResolution{Mark: ExploreMarkExplored, Pointer: pointer}
+	}
+	if hasExploreRun(d, m) {
+		return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredFailed}
+	}
+	return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredNotYetRun}
+}
+
+// explorationPointer reads the set's report as the surfaces carry it: where it
+// is and which commit its header records.
+func explorationPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if !hasExplorationReport(d, m) {
+		return ReportPointer{}, false
+	}
+	if d == nil {
+		d = defaultDeps
+	}
+	p := ReportPointer{Label: explorationReport.PointerLabel, Path: explorationPath(m)}
+	body, err := d.FS.ReadFile(p.Path)
+	if err != nil {
+		return p, true
+	}
+	p.WorkSHA = reportHeaderField(string(body), "Work SHA")
+	if at, err := time.Parse(time.RFC3339, reportHeaderField(string(body), explorationReport.WrittenLabel)); err == nil {
+		p.Written = at.UTC().Format("2006-01-02 15:04Z")
+	}
+	return p, true
+}
+
+// hasExploreRun reports whether any Captured run of phase `explore` exists for
+// the set. It reads the index halves only, like the Refine mark's lookup.
+func hasExploreRun(d *Deps, m *Manifest) bool {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return false
+	}
+	metas, err := listCapturedRunMetas(d, m.Dir)
+	if err != nil {
+		return false
+	}
+	for _, meta := range metas {
+		if meta.Phase == spendPhaseExplore {
+			return true
+		}
+	}
+	return false
+}
+
+// exploreMarkPhrase is the mark as a human reads it, in the one wording every
+// surface uses, with the reason as detail after the mark. Empty for a set that
+// carries no mark.
+func exploreMarkPhrase(res ExploreResolution) string {
+	switch res.Mark {
+	case ExploreMarkExplored:
+		return "explored"
+	case ExploreMarkUnexplored:
+		return "unexplored: " + unexploredReasonPhrase(res.Reason)
+	}
+	return ""
+}
+
+func unexploredReasonPhrase(reason UnexploredReason) string {
+	if reason == UnexploredFailed {
+		return "the pass failed"
+	}
+	return "not yet run"
+}
+
+// exploreMarkSegment is the STATUS-cell token the mark contributes: the mark,
+// then its reason in brackets, so the reason reads as detail beside it.
+func exploreMarkSegment(mark ExploreMark, reason UnexploredReason) (work.StatusSegment, bool) {
+	switch mark {
+	case ExploreMarkExplored:
+		return work.StatusSegment{Text: string(mark), Tone: work.TonePlain}, true
+	case ExploreMarkUnexplored:
+		return work.StatusSegment{Text: fmt.Sprintf("%s (%s)", mark, unexploredReasonPhrase(reason)), Tone: work.ToneWarn}, true
+	}
+	return work.StatusSegment{}, false
+}
+
+// ExploreSectionTitle heads the detail-view section the Explore mark renders as.
+const ExploreSectionTitle = "Exploration"
+
+// ExploreSection is a row's already-resolved Explore mark as a detail-view
+// section: the mark, and for an explored set its report as a pointer — the path
+// and the tree its header records, never the body (ADR-0262). False for a set
+// that carries no mark.
+func ExploreSection(row Row) (work.Section, bool) {
+	res := ExploreResolution{Mark: row.ExploreMark, Reason: row.UnexploredReason, Pointer: row.ExplorationPointer}
+	phrase := exploreMarkPhrase(res)
+	if phrase == "" {
+		return work.Section{}, false
+	}
+	lines := []string{phrase}
+	if res.Mark == ExploreMarkExplored {
+		lines = append(lines, res.Pointer.Path)
+		if res.Pointer.WorkSHA != "" {
+			lines = append(lines, "tree: "+res.Pointer.WorkSHA)
+		}
+	} else {
+		lines = append(lines, "run: pop tasks explore "+row.ID)
+	}
+	return work.Section{Title: ExploreSectionTitle, Body: strings.Join(lines, "\n")}, true
+}
+
+// applyExploreResolutions resolves every row's Explore mark once per refresh and
+// lets the one answer that is also a status become it: a declared set whose pass
+// failed, and that still has agent work to start, reads EXPLORE-FAILED instead of
+// READY, so neither automatic selection nor the Work daemon re-picks it and
+// re-explores it in a loop (ADR-0262 decision 6). A set at any other status keeps
+// it, mark beside. It reports whether any status changed, so the caller can
+// restore the display order.
+func applyExploreResolutions(d *Deps, result *RefreshResult) bool {
+	if result == nil {
+		return false
+	}
+	changed := false
+	for i := range result.Rows {
+		row := &result.Rows[i]
+		m := result.Manifests[row.ID]
+		res := ResolveExploreMark(d, m)
+		row.ExploreMark, row.UnexploredReason, row.ExplorationPointer = res.Mark, res.Reason, res.Pointer
+		if row.Status == StatusReady && res.Reason == UnexploredFailed {
+			row.Status = StatusExploreFailed
+			row.Progress = BuildProgress(m, StatusExploreFailed)
+			changed = true
+		}
+	}
+	return changed
+}
diff --git a/tasks/explore_phase.go b/tasks/explore_phase.go
new file mode 100644
index 00000000..c6672a69
--- /dev/null
+++ b/tasks/explore_phase.go
@@ -0,0 +1,79 @@
+package tasks
+
+// exploreDirective is what explorePhase hands back to the drain: carry on into
+// the first task selection, or stop the run with the result and error it
+// produced — the human's interrupt, or the park.
+type exploreDirective int
+
+const (
+	// exploreProceed enters the task loop: the step did not apply, the set
+	// already had its report, or the pass just wrote one.
+	exploreProceed exploreDirective = iota
+	// exploreReturn ends the run here.
+	exploreReturn
+)
+
+// explorePhase runs the drain's Explore step (ADR-0262) at the head of the
+// drain, before the loop selects its first task. A set that declared
+// `"explore": true` and has no Exploration report gets one written by a fresh
+// Explorer, so every builder in the set works from one picture of the code.
+//
+// Presence is the whole rule. A set that already has a report reuses it and
+// spends nothing; nothing reads back the tree the report records to decide it
+// has gone stale, because an implement attempt commits and a freshness rule
+// would regenerate the map per task.
+//
+// It is the one agent phase that gates. A pass that cannot produce the report
+// after the standard per-phase cap parks the set at EXPLORE-FAILED rather than
+// letting builders start from separate maps — the inconsistency the phase
+// exists to prevent. Like refinement it declines a human-completed set.
+func (r *implementRun) explorePhase() (exploreDirective, error) {
+	cfg := r.plan.cfg
+	// [work.explore].enabled gates only the drain, and defaults on: what
+	// triggers a pass is the set's own declaration (ADR-0262).
+	if r.opts.SkipExplore || !cfg.ExploreEnabled() {
+		return exploreProceed, nil
+	}
+	refresh, err := RefreshWith(r.d, r.resolved.DefinitionPath, r.statePath)
+	if err != nil {
+		return exploreReturn, exitErr(ExitOperational, "refresh before exploring: %v", err)
+	}
+	m := refresh.Manifests[r.taskSetID]
+	if m == nil || !m.Valid || !m.ExploreDeclared() || m.HumanCompleted {
+		return exploreProceed, nil
+	}
+	if hasExplorationReport(r.d, m) {
+		return exploreProceed, nil
+	}
+	// A set with no task an agent could start on has nothing to build against a
+	// map yet; the loop takes it to its gate or its terminal status instead.
+	if !hasEligibleTask(m) {
+		return exploreProceed, nil
+	}
+
+	_, err = exploreResolvedSet(r.d, cfg, exploreCoreOptions{
+		DefPath:     r.resolved.DefinitionPath,
+		RuntimePath: r.runtimePath,
+		SetID:       r.taskSetID,
+		Agents:      r.opts.ExploreAgents,
+		Effort:      r.opts.ExploreEffort,
+		Timeout:     r.timeout,
+		Output:      r.out,
+		runExplorer: r.opts.exploreRunner,
+		probeMemo:   r.agentProbeMemo,
+		// The drain already holds this checkout for this set (ADR-0238).
+		checkoutHeld: true,
+	})
+	if err == nil {
+		return exploreProceed, nil
+	}
+	if isInterrupted(err) {
+		return exploreReturn, err
+	}
+	r.result.TaskSetExploreFailed = true
+	out := outputFor(r.out)
+	out.line(ansiRed, "━━ Exploration failed for %s — the set parks at %s", r.taskSetID, StatusExploreFailed)
+	out.line(ansiDim, "   %v", err)
+	out.line(ansiDim, "   Ways out: pop tasks explore %s · pop tasks implement %s --skip-explore · \"%s\": false", r.taskSetID, r.taskSetID, manifestExploreKey)
+	return exploreReturn, exitErr(ExitNoRunnable, "Task set %q parked at %s: %v", r.taskSetID, StatusExploreFailed, err)
+}
