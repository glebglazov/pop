@@ -0,0 +1,97 @@
+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/work"
+)
+
+// exploreSurfaces renders one set through every human surface the Explore mark
+// rides: the `pop tasks status` table and per-set detail, the STATUS cell the
+// dashboard row and `pop work status` share, the detail-view section, and the
+// sign-off gate's preamble.
+type exploreSurfaces struct {
+	table, detail, cell, section, gate string
+}
+
+func renderExploreSurfaces(t *testing.T, env *runTaskSetFixture) exploreSurfaces {
+	t.Helper()
+	d := env.deps()
+	refresh, err := RefreshWith(d, env.tasksDir, DefaultStatePathWith(d))
+	if err != nil {
+		t.Fatal(err)
+	}
+	row := findRow(refresh, "demo")
+	m := refresh.Manifests["demo"]
+	var table, detail bytes.Buffer
+	Render(&table, refresh)
+	RenderTaskSetDetail(d, nil, &detail, "demo", row, m)
+	container := work.Container{RawStatus: row.Status, ExploreMark: row.ExploreMark, ExploreReason: row.UnexploredReason}
+	section, _ := ExploreSection(*row)
+	return exploreSurfaces{
+		table:   table.String(),
+		detail:  detail.String(),
+		cell:    WorkRowStatusCell(container),
+		section: section.Title + "\n" + section.Body,
+		gate:    strings.Join(gateExplorePreamble(ResolveExploreMark(d, m)), "\n"),
+	}
+}
+
+// TestExploreMarkRidesEverySurface: a declared set with no report carries the
+// unexplored mark with its reason beside it on every surface; once its report
+// exists each surface carries the report as a pointer — path and tree — and
+// never its body; a set that never asked carries nothing anywhere.
+func TestExploreMarkRidesEverySurface(t *testing.T) {
+	t.Parallel()
+
+	t.Run("declared, not yet run", func(t *testing.T) {
+		t.Parallel()
+		got := renderExploreSurfaces(t, setupExploreDrainFixture(t, map[string]any{"explore": true}))
+		for name, text := range map[string]string{"table": got.table, "detail": got.detail, "section": got.section, "gate": got.gate} {
+			if !strings.Contains(text, "unexplored: not yet run") {
+				t.Errorf("%s lacks the mark and its reason:\n%s", name, text)
+			}
+		}
+		if got.cell != "READY · unexplored (not yet run)" {
+			t.Errorf("status cell = %q", got.cell)
+		}
+	})
+
+	t.Run("declared and explored", func(t *testing.T) {
+		t.Parallel()
+		env := setupExploreDrainFixture(t, map[string]any{"explore": true})
+		path := filepath.Join(env.setDir(), ExplorationFileName)
+		doc := "# Exploration report — demo\n\n- Explored: 2026-09-01T12:00:00Z\n- Work SHA: abc1234\n- Explorer: claude\n\nSECRET-MAP-BODY\n"
+		if err := os.WriteFile(path, []byte(doc), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		got := renderExploreSurfaces(t, env)
+		for name, text := range map[string]string{"detail": got.detail, "section": got.section, "gate": got.gate} {
+			if !strings.Contains(text, path) || !strings.Contains(text, "abc1234") {
+				t.Errorf("%s does not point at the report and its tree:\n%s", name, text)
+			}
+		}
+		for name, text := range map[string]string{"table": got.table, "detail": got.detail, "section": got.section, "gate": got.gate, "cell": got.cell} {
+			if strings.Contains(text, "SECRET-MAP-BODY") {
+				t.Errorf("%s carries the report's body:\n%s", name, text)
+			}
+		}
+		if got.cell != "READY · explored" {
+			t.Errorf("status cell = %q", got.cell)
+		}
+	})
+
+	t.Run("never asked", func(t *testing.T) {
+		t.Parallel()
+		got := renderExploreSurfaces(t, setupRunTaskSetFixture(t, "demo", interrelatedSet()))
+		for name, text := range map[string]string{"table": got.table, "detail": got.detail, "cell": got.cell, "section": got.section, "gate": got.gate} {
+			if strings.Contains(text, "explored") {
+				t.Errorf("%s carries a mark for a set that never asked:\n%s", name, text)
+			}
+		}
+	})
+}
