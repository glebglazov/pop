@@ -0,0 +1,137 @@
+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// exploredHITLFixture is a set waiting at its sign-off gate that asked to be
+// explored, with or without its Exploration report on disk.
+func exploredHITLFixture(t *testing.T, withReport bool) (*Deps, *Manifest, string) {
+	t.Helper()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "done"},
+		{ID: "02-hitl", File: "02-hitl.md", Title: "Sign off", Type: "HITL", Status: "open"},
+	}, map[string]any{ManifestExploreKey: true})
+	path := filepath.Join(m.Dir, ExplorationFileName)
+	if withReport {
+		doc := exploreReport.renderDocument(d.Now(), "demo", "c0ffee1c0ffee1", "", "claude", "## Where things live\nTHE-REPORT-BODY")
+		if err := os.WriteFile(path, []byte(doc), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return d, m, path
+}
+
+// TestSignOffGateNamesTheExplorationReport: the gate's preamble names the
+// report beside the refine report's line — path and recorded tree, never the
+// body — and a paging entry opens it without running an agent.
+func TestSignOffGateNamesTheExplorationReport(t *testing.T) {
+	t.Parallel()
+	d, m, path := exploredHITLFixture(t, true)
+
+	// Re-verify, refine and verify entries are not offered here, so the
+	// exploration entry takes key 5.
+	gate, action := hitlGateOutput(t, d, m, "5\n")
+	if action != hitlGateReadExplore {
+		t.Fatalf("key 5 = %v, want the exploration report's paging entry:\n%s", action, gate)
+	}
+	for _, want := range []string{"🧭 Explored · Exploration of c0ffee1", path, "Read the exploration report (no agent runs)"} {
+		if !strings.Contains(gate, want) {
+			t.Fatalf("gate missing %q:\n%s", want, gate)
+		}
+	}
+	if strings.Contains(gate, "THE-REPORT-BODY") {
+		t.Fatalf("gate printed the report's body:\n%s", gate)
+	}
+}
+
+// TestTaskStatusRendersTheExploreMark covers `pop tasks status` both ways: the
+// table's detail column carries the mark and its reason for a set that asked
+// and has no report, and the per-set detail points at a report that exists.
+func TestTaskStatusRendersTheExploreMark(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no report yet", func(t *testing.T) {
+		t.Parallel()
+		d, m, _ := exploredHITLFixture(t, false)
+		status, explore := deriveExploredStatus(d, m)
+		row := buildTaskSetRow(d, RegisteredTaskSet{ID: "demo"}, m, 0)
+		if row.Status != status || row.Explore != explore {
+			t.Fatalf("row = %q/%+v, want the one resolution %q/%+v", row.Status, row.Explore, status, explore)
+		}
+		// The table's DETAILS cell, before the renderer fits it to a column.
+		if detail := rowDetail(outputFor(&bytes.Buffer{}), row); !strings.HasSuffix(detail, " — Not explored: not yet run") {
+			t.Fatalf("status table detail = %q, want the mark and its reason beside the status's own", detail)
+		}
+	})
+
+	t.Run("report written", func(t *testing.T) {
+		t.Parallel()
+		d, m, path := exploredHITLFixture(t, true)
+		row := buildTaskSetRow(d, RegisteredTaskSet{ID: "demo"}, m, 0)
+		var detail bytes.Buffer
+		RenderTaskSetDetail(d, nil, &detail, "demo", &row, m)
+		for _, want := range []string{"🧭 Explored", path, "c0ffee1"} {
+			if !strings.Contains(detail.String(), want) {
+				t.Fatalf("per-set detail missing %q:\n%s", want, detail.String())
+			}
+		}
+		if strings.Contains(detail.String(), "THE-REPORT-BODY") {
+			t.Fatalf("per-set detail printed the report's body:\n%s", detail.String())
+		}
+	})
+}
+
+// TestASetThatNeverAskedCarriesNoExploreMark: no gate line, no table detail, no
+// per-set line and no Assist block for a set without the directive.
+func TestASetThatNeverAskedCarriesNoExploreMark(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	row := buildTaskSetRow(d, RegisteredTaskSet{ID: "demo"}, m, 0)
+	var table, detail bytes.Buffer
+	Render(&table, &RefreshResult{Rows: []Row{row}})
+	RenderTaskSetDetail(d, nil, &detail, "demo", &row, m)
+	assist := BuildAssistPrompt(d, nil, "demo", m, row.Status, "/rt", "")
+	for surface, text := range map[string]string{
+		"gate": gate, "status table": table.String(), "per-set detail": detail.String(), "assist prompt": assist,
+	} {
+		lower := strings.ToLower(text)
+		if strings.Contains(lower, "exploration") || strings.Contains(lower, "explored") || strings.Contains(text, "🧭") {
+			t.Fatalf("%s mentions exploration for a set that never asked:\n%s", surface, text)
+		}
+	}
+}
+
+// TestBuilderFrameKeepsThePriorArtBlockWithAReport: naming the report changes
+// the edit boundary and adds the correction duty, and leaves the prior-art check
+// byte for byte as it reads on a set with no report (ADR-0262 decision 7).
+func TestBuilderFrameKeepsThePriorArtBlockWithAReport(t *testing.T) {
+	t.Parallel()
+	block := func(prompt string) string {
+		start := strings.Index(prompt, "## Before you hand-write mechanism")
+		if start < 0 {
+			t.Fatalf("prompt has no prior-art block:\n%s", prompt)
+		}
+		rest := prompt[start:]
+		end := strings.Index(rest, "This attempt is a single non-interactive session.")
+		if end < 0 {
+			t.Fatalf("prior-art block does not end where it should:\n%s", rest)
+		}
+		return rest[:end]
+	}
+	without := BuildAgentPrompt("/w/tasks/demo/01-a.md", "/rt", "", "")
+	with := BuildAgentPrompt("/w/tasks/demo/01-a.md", "/rt", "", "/w/tasks/demo/"+ExplorationFileName)
+	if block(with) != block(without) {
+		t.Fatalf("the prior-art block moved:\nwith a report:\n%s\nwithout:\n%s", block(with), block(without))
+	}
+	// The boundary names the report as the exception beside the task file, and
+	// a set without one is told nothing about it.
+	if !strings.Contains(with, "Outside it you\nedit two files: the task file above") || strings.Contains(without, ExplorationFileName) {
+		t.Fatalf("edit boundary does not name the report as the exception:\n%s", with)
+	}
+}
diff --git a/tasks/explore_test.go b/tasks/explore_test.go
new file mode 100644
index 00000000..eb7085c4
--- /dev/null
+++ b/tasks/explore_test.go
@@ -0,0 +1,292 @@
+package tasks
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/deps"
+)
+
+// exploreConfig is a [work.explore] group as a test states it.
+func exploreConfig(enabled bool, agents []string, effort string) *config.Config {
+	return &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{
+		Enabled: &enabled,
+		Agents:  config.AgentEntriesFromCommands(agents...),
+		Effort:  effort,
+	}}}
+}
+
+// promptCapturingRunner is the scripted agent runner with one addition: it reads
+// back the prompt file each invocation was handed, so a test asserts on what
+// the agent actually received rather than on a builder called beside the run.
+type promptCapturingRunner struct {
+	inner   *scriptedRefineRunner
+	prompts []string
+}
+
+var spilledPromptPath = regexp.MustCompile(`\S*pop-agent-prompt-\S*\.md`)
+
+func (r *promptCapturingRunner) Run(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (int, error) {
+	proc, err := r.Start(ctx, dir, stdout, stderr, name, args...)
+	if err != nil {
+		return 1, err
+	}
+	return proc.Wait()
+}
+
+func (r *promptCapturingRunner) Start(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (*ManagedProcess, error) {
+	for _, arg := range args {
+		if path := spilledPromptPath.FindString(arg); path != "" {
+			if data, err := os.ReadFile(path); err == nil {
+				r.prompts = append(r.prompts, string(data))
+			}
+		}
+	}
+	return r.inner.Start(ctx, dir, stdout, stderr, name, args...)
+}
+
+// exploreFixture is a "demo" set of two interrelated AFK tasks and a spec, with
+// a scripted Explorer standing in for the agent process. Everything between the
+// command core and that process — the fallback walk, the Captured run, the
+// report write — is the real path.
+func exploreFixture(t *testing.T, setKeys map[string]any, runs ...scriptedRefineRun) (*Deps, *promptCapturingRunner, string, string) {
+	t.Helper()
+	runner := &promptCapturingRunner{inner: &scriptedRefineRunner{runs: runs}}
+	d := newTestDeps(t)
+	d.Clock = deps.FixedClock{Instant: time.Date(2026, 8, 16, 12, 0, 0, 0, time.UTC)}
+	d.Git = stubGit("abc123abc123\n", "", "")
+	d.LookPath = func(string) (string, error) { return "/bin/claude", nil }
+	d.Runner = &probeNeutralRunner{inner: runner}
+
+	defPath := filepath.Join(t.TempDir(), "tasks")
+	setDir := filepath.Join(defPath, "demo")
+	writeTaskMD(t, setDir, "01-seam.md", "## What to build\n\nGive the drain loop a head step.\n\n## Acceptance criteria\n\n- [ ] the step runs first\n")
+	writeTaskMD(t, setDir, "02-reader.md", "## What to build\n\nHand every builder the report.\n\n## Acceptance criteria\n\n- [ ] the prompt names it\n")
+	writeTaskMD(t, setDir, SpecFileName, "# Explore once\n\nInterrelated sets share one map.\n")
+	writeManifestWithSetKeys(t, setDir, []Task{
+		{ID: "01-seam", File: "01-seam.md", Title: "Head step", Type: "AFK", Status: TaskOpen},
+		{ID: "02-reader", File: "02-reader.md", Title: "Builder reads it", Type: "AFK", Status: TaskOpen, BlockedBy: []string{"01-seam"}},
+	}, setKeys)
+	return d, runner, defPath, setDir
+}
+
+func exploreCore(defPath string, out io.Writer) exploreCoreOptions {
+	return exploreCoreOptions{
+		DefPath:     defPath,
+		RuntimePath: "/rt",
+		SetID:       "demo",
+		Agents:      []string{"claude"},
+		Timeout:     time.Minute,
+		Output:      out,
+	}
+}
+
+func exploreRuns(t *testing.T, d *Deps, setDir string) []capturedRunMeta {
+	t.Helper()
+	runs, err := listSetRuns(d, setDir)
+	if err != nil {
+		t.Fatalf("listSetRuns: %v", err)
+	}
+	var metas []capturedRunMeta
+	for _, run := range runs {
+		if run.meta.Phase == spendPhaseExplore {
+			metas = append(metas, run.meta)
+		}
+	}
+	return metas
+}
+
+// TestHandExploreWritesTheReportFromTheWholeSet drives `pop tasks explore`'s
+// core end to end on a set whose author said `"explore": false`: a hand run is a
+// human asking, so it runs anyway. It asserts what the Explorer was handed, what
+// landed on disk, the Captured run it filed under its own phase, and that a
+// second pass replaces the first report rather than appending to it.
+func TestHandExploreWritesTheReportFromTheWholeSet(t *testing.T) {
+	t.Parallel()
+	d, runner, defPath, setDir := exploreFixture(t, map[string]any{ManifestExploreKey: false},
+		scriptedRefineRun{output: claudeRefineStream("## Where things live\\n- `tasks/run_tasks.go` owns `implementRun.loop`.\\nObserved at abc123 on master.")},
+		scriptedRefineRun{output: claudeRefineStream("## Where things live\\n- `tasks/explore.go` owns the pass now.")},
+	)
+
+	var out bytes.Buffer
+	res, err := exploreResolvedSet(d, nil, exploreCore(defPath, &out))
+	if err != nil {
+		t.Fatalf("explore: %v", err)
+	}
+
+	if len(runner.prompts) != 1 {
+		t.Fatalf("Explorer prompts = %d, want the one invocation's", len(runner.prompts))
+	}
+	prompt := runner.prompts[0]
+	for _, want := range []string{
+		"independent Explorer",
+		"Change nothing",
+		// The manifest listing and every task body.
+		"### 01-seam [AFK] (open): Head step",
+		"### 02-reader [AFK] (open): Builder reads it",
+		"Blocked by: 01-seam",
+		"Give the drain loop a head step.",
+		"Hand every builder the report.",
+		// The spec.
+		"Interrelated sets share one map.",
+		// What to record, and its discipline.
+		"**Where things live**",
+		"**Which seam owns what**",
+		"**Which invariants hold**",
+		"**The test shape**",
+		"read in ranges",
+		"Every claim names a path or a symbol",
+		"about one page",
+		"State in prose the tree you observed",
+	} {
+		if !strings.Contains(prompt, want) {
+			t.Fatalf("Explorer prompt missing %q:\n%s", want, prompt)
+		}
+	}
+	// The prior-art check is the implement frame's, and stays there (ADR-0262
+	// decision 7): the Explorer is asked for nothing about it.
+	for _, forbidden := range []string{"prior art", "prior-art", "hand-write", "Before you hand-write mechanism"} {
+		if strings.Contains(strings.ToLower(prompt), strings.ToLower(forbidden)) {
+			t.Fatalf("Explorer prompt asks about prior art (%q):\n%s", forbidden, prompt)
+		}
+	}
+
+	wantPath := filepath.Join(setDir, ExplorationFileName)
+	if res.Path != wantPath {
+		t.Fatalf("report path = %q, want it flat in the set directory at %q", res.Path, wantPath)
+	}
+	body, err := os.ReadFile(wantPath)
+	if err != nil {
+		t.Fatalf("read report: %v", err)
+	}
+	for _, want := range []string{
+		"# Exploration report — demo",
+		"- Explored: 2026-08-16T12:00:00Z",
+		"- Work SHA: abc123ab",
+		"- Explorer: claude",
+		"`tasks/run_tasks.go` owns `implementRun.loop`",
+		"## Where things live",
+	} {
+		if !strings.Contains(string(body), want) {
+			t.Fatalf("report missing %q:\n%s", want, body)
+		}
+	}
+	if strings.Contains(string(body), "Prior art") {
+		t.Fatalf("report carries a prior-art section:\n%s", body)
+	}
+	if m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName)); !m.Valid {
+		t.Fatalf("an explored set reads malformed: %v", m.Errors)
+	}
+
+	runs := exploreRuns(t, d, setDir)
+	if len(runs) != 1 || runs[0].Verdict != exploreOutcomeExplored || runs[0].TaskFile != "" || runs[0].WorkSHA != "abc123abc123" {
+		t.Fatalf("explore runs = %+v, want one set-level run recording the report it produced", runs)
+	}
+	m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+	breakdown, err := buildSpendSetBreakdown(d, "demo", m, loadRateTableForSpend(d), nil)
+	if err != nil {
+		t.Fatalf("spend: %v", err)
+	}
+	if breakdown.ExploreRunCount != 1 || breakdown.ImplementRunCount != 0 || len(breakdown.Rows) != 1 || breakdown.Rows[0].TaskID != "explore" {
+		t.Fatalf("spend = explore %d / implement %d rows %+v, want the run in its own bucket and row",
+			breakdown.ExploreRunCount, breakdown.ImplementRunCount, breakdown.Rows)
+	}
+
+	// A second hand run rewrites the report in place.
+	if _, err := exploreResolvedSet(d, nil, exploreCore(defPath, io.Discard)); err != nil {
+		t.Fatalf("second explore: %v", err)
+	}
+	body, err = os.ReadFile(wantPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(body), "`tasks/explore.go` owns the pass now.") || strings.Contains(string(body), "implementRun.loop") {
+		t.Fatalf("second pass did not replace the report:\n%s", body)
+	}
+	if strings.Count(string(body), "# Exploration report") != 1 {
+		t.Fatalf("second pass appended rather than replaced:\n%s", body)
+	}
+}
+
+// TestExploreThatGivesUpWritesNothingAndKeepsTheReport: a pass whose every
+// attempt fails is retried up to the standard per-phase cap, files each attempt
+// as an explore run that produced nothing, returns an error, and leaves the
+// report already on disk exactly as it was.
+func TestExploreThatGivesUpWritesNothingAndKeepsTheReport(t *testing.T) {
+	t.Parallel()
+	failed := scriptedRefineRun{output: claudeRefineStream("## Where things li"), exitCode: 2}
+	d, runner, defPath, setDir := exploreFixture(t, map[string]any{ManifestExploreKey: true}, failed, failed, failed)
+	previous := "# Exploration report — demo\n\nthe earlier map\n"
+	if err := os.WriteFile(filepath.Join(setDir, ExplorationFileName), []byte(previous), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := exploreResolvedSet(d, nil, exploreCore(defPath, io.Discard)); err == nil {
+		t.Fatal("an Explorer that only ever failed reported success")
+	}
+	if runner.inner.calls != 3 {
+		t.Fatalf("Explorer invocations = %d, want the standard cap of 3", runner.inner.calls)
+	}
+	body, err := os.ReadFile(filepath.Join(setDir, ExplorationFileName))
+	if err != nil || string(body) != previous {
+		t.Fatalf("report after a failed pass = %q, %v; want the earlier one untouched", body, err)
+	}
+	runs := exploreRuns(t, d, setDir)
+	if len(runs) != 3 {
+		t.Fatalf("explore runs = %d, want every failed attempt filed", len(runs))
+	}
+	for _, run := range runs {
+		if run.Verdict != "" {
+			t.Fatalf("a failed attempt filed outcome %q, want none", run.Verdict)
+		}
+	}
+}
+
+// TestResolveExplorerPrecedence: CLI flags beat the set's `explorer` object,
+// which beats [work.explore], which beats the implement list and the default
+// effort.
+func TestResolveExplorerPrecedence(t *testing.T) {
+	t.Parallel()
+	m := &Manifest{}
+	cfg := exploreConfig(true, []string{"codex"}, "heavy")
+
+	withObject := &Manifest{}
+	if err := parseManifestJSON([]byte(`{"tasks": [], "explorer": {"agents": ["pi"], "effort": "light"}}`), withObject); err != nil {
+		t.Fatal(err)
+	}
+
+	for name, tc := range map[string]struct {
+		cliAgents  []string
+		cliEffort  string
+		m          *Manifest
+		wantAgents string
+		wantEffort string
+	}{
+		"cli wins":              {cliAgents: []string{"claude"}, cliEffort: "standard", m: withObject, wantAgents: "claude", wantEffort: "standard"},
+		"object beats config":   {m: withObject, wantAgents: "pi", wantEffort: "light"},
+		"config beats defaults": {m: m, wantAgents: "codex", wantEffort: "heavy"},
+	} {
+		sel, err := resolveExplorer(tc.cliAgents, tc.cliEffort, tc.m, cfg)
+		if err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		if got := strings.Join(sel.Agents, ","); got != tc.wantAgents || sel.Effort != tc.wantEffort {
+			t.Fatalf("%s: selection = %v/%s, want %s/%s", name, sel.Agents, sel.Effort, tc.wantAgents, tc.wantEffort)
+		}
+	}
+	sel, err := resolveExplorer(nil, "", m, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if sel.Effort != DefaultExploreEffort || len(sel.Agents) == 0 {
+		t.Fatalf("unconfigured selection = %+v, want the default effort and the implement fallback", sel)
+	}
+}
diff --git a/tasks/gate_menu.go b/tasks/gate_menu.go
index bb2ea1af..439afbb5 100644
--- a/tasks/gate_menu.go
+++ b/tasks/gate_menu.go
@@ -162,6 +162,20 @@ func gateRefineEntryDetails(refine gateRefineState) []string {
 	return details
 }
 
+// gateExplorePreamble names the set's Exploration report beside the refine
+// report: the mark, and the pointer — path and the tree it records — when there
+// is a report (ADR-0262). A set that never asked to be explored adds no line.
+func gateExplorePreamble(explore ExploreResolution) []string {
+	phrase := ExploreMarkPhrase(explore.Mark, explore.Reason)
+	if phrase == "" {
+		return nil
+	}
+	if explore.HasReport {
+		return []string{"🧭 " + phrase + " · " + explore.Pointer.Summary()}
+	}
+	return []string{"🧭 " + phrase}
+}
+
 // gateVerifyPreamble tells the same human that a Verify report of the set
 // exists, and against which commit — the pointer only, on the same terms as the
 // refine one above it (ADR-0245). It answers why verification judged as it did,
diff --git a/tasks/gates.go b/tasks/gates.go
index 7e014493..8a25b75b 100644
--- a/tasks/gates.go
+++ b/tasks/gates.go
@@ -103,6 +103,7 @@ const (
 	hitlGateReverify
 	hitlGateReadRefine
 	hitlGateReadVerify
+	hitlGateReadExplore
