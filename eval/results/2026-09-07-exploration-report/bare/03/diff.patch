+// TestLoadWorkExploreSettings pins the [work.explore] group (ADR-0262): the one
+// agent phase that is on when nothing configures it, off only when a human says
+// so, and an omitted agents list left empty so resolution falls through to
+// [work.implement].agents.
+func TestLoadWorkExploreSettings(t *testing.T) {
+	load := func(t *testing.T, body string) *Config {
+		t.Helper()
+		path := filepath.Join(t.TempDir(), "config.toml")
+		if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		cfg, err := LoadWith(isolatedDeps(t), path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return cfg
+	}
+
+	absent := load(t, "\n")
+	if !absent.ExploreEnabled() {
+		t.Fatal("an undeclared [work.explore] must explore: the step defaults on")
+	}
+	if len(absent.ExploreAgents()) != 0 || !absent.ExploreAgentList().FallsThrough() {
+		t.Fatalf("explore agents = %v, want none so resolution falls through", absent.ExploreAgents())
+	}
+	var nilCfg *Config
+	if !nilCfg.ExploreEnabled() {
+		t.Fatal("a nil config must explore: the step defaults on")
+	}
+
+	declared := load(t, `
+[work.explore]
+effort = "heavy"
+agents = ["codex", "claude"]
+`)
+	if !declared.ExploreEnabled() {
+		t.Fatal("a [work.explore] group that leaves enabled unsaid must still explore")
+	}
+	if got := declared.ExploreSettings().Effort; got != "heavy" {
+		t.Fatalf("explore effort = %q, want heavy", got)
+	}
+	if got := strings.Join(declared.ExploreAgents(), ","); got != "codex,claude" {
+		t.Fatalf("explore agents = %q, want codex,claude", got)
+	}
+
+	if load(t, "[work.explore]\nenabled = false\n").ExploreEnabled() {
+		t.Fatal("enabled = false must switch the explore step off")
+	}
+}
