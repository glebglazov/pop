diff --git a/tasks/explore.go b/tasks/explore.go
new file mode 100644
index 00000000..2caf3756
--- /dev/null
+++ b/tasks/explore.go
@@ -0,0 +1,394 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/prompt"
+	"github.com/glebglazov/pop/project"
+)
+
+// DefaultExploreEffort is the model-strength tier the Explore phase runs at when
+// neither a CLI flag, the set's `explorer` object nor [work.explore].effort names
+// one (ADR-0262). Recording the code as found is reading and mapping rather than
+// judging work against a standard, so it defaults below verify and refine.
+const DefaultExploreEffort = DefaultTaskEffort
+
+// exploreOutcomeExplored is what an Explorer invocation files in its Captured
+// run's outcome slot when it ran to its own ending and answered with prose pop
+// takes as the report. It is the one fact that tells a set whose report a human
+// later deleted (absent, so explore again) from a set whose pass never produced
+// one (absent, so park): see exploreParked.
+const exploreOutcomeExplored = "explored"
+
+// exploreReport is the Exploration report's header machinery, borrowed from the
+// shared pass-report value (ADR-0245). Only the document render and the header
+// read-back are used: the report is flat — one `exploration.md` the pass
+// rewrites — so the timestamped filing and the newest-by-timestamp scan stay
+// with the two families that rerun (ADR-0262 decision 1).
+var exploreReport = passReport{
+	ArtifactType: ArtifactTypeExplore,
+	Title:        "Exploration report",
+	WrittenLabel: "Explored",
+	AgentLabel:   "Explorer",
+	Noun:         "explore",
+	PointerLabel: "Exploration",
+}
+
+// ExploreOptions configures a `pop tasks explore <set>` run.
+type ExploreOptions struct {
+	ResolveInput ResolveInput
+	// TaskSetID is the bare Task-set identifier to explore.
+	TaskSetID string
+	// Agents is the ordered CLI Explorer fallback list (`--agent`, repeatable).
+	// Empty ⇒ the set's `explorer` object, then [work.explore].agents, then
+	// [work.implement].agents.
+	Agents []string
+	// Effort is the CLI Explorer effort override (`--effort`). Empty ⇒ the set's
+	// `explorer` object, then config, then DefaultExploreEffort.
+	Effort string
+	// Timeout bounds each Explorer attempt. Zero uses DefaultAttemptTimeout.
+	Timeout time.Duration
+	// Output receives the live agent stream and the run's chrome.
+	Output io.Writer
+	// Wait is the `--wait` / `--no-wait` tri-state for admission to the checkout
+	// (ADR-0239). The unset default waits at a terminal and refuses elsewhere.
+	Wait AdmissionWaitChoice
+	// ConfirmIn is the invocation's input, read only to tell a human at a
+	// terminal from a script when resolving Wait.
+	ConfirmIn io.Reader
+}
+
+// ExploreResult is the outcome of one explore pass.
+type ExploreResult struct {
+	SetID string
+	// WorkSHA is the commit the report describes, read before the Explorer ran.
+	WorkSHA string
+	// Path is the Exploration report written.
+	Path string
+	// Body is the document itself.
+	Body string
+}
+
+// exploreCoreOptions carries the already-resolved inputs to the core explore
+// routine, so the drain and tests drive it without real path resolution. The
+// runExplorer seam replaces the real agent spawn in tests.
+type exploreCoreOptions struct {
+	DefPath     string
+	RuntimePath string
+	SetID       string
+	Agents      []string
+	Effort      string
+	Timeout     time.Duration
+	Output      io.Writer
+	// runExplorer returns the Explorer's report and the agent that wrote it.
+	runExplorer func(prompt string) (string, string, error)
+	probeMemo   *agentAvailabilityProbeMemo
+	// admission is the policy the standalone pass acquires the checkout under
+	// (ADR-0238/0239).
+	admission AdmissionPolicy
+	// checkoutHeld says the caller is already inside a claim on this checkout —
+	// the drain's own explore step, which runs under the drain's running Drain
+	// row — so the pass takes nothing.
+	checkoutHeld bool
+}
+
+// ExploreTaskSet explores a set using default dependencies.
+func ExploreTaskSet(opts ExploreOptions) (*ExploreResult, error) {
+	return ExploreTaskSetWith(defaultDeps, project.DefaultDeps(), config.Load, opts)
+}
+
+// ExploreTaskSetWith is `pop tasks explore <set>` (ADR-0262): a fresh Explorer
+// is handed the set's tasks and its spec and records the code as found in the
+// area they touch, which pop writes as the set's Exploration report.
+//
+// A hand run is the human re-opening the question, so it runs on any set
+// whatever its `explore` key says, and it rewrites a report already there.
+func ExploreTaskSetWith(d *Deps, pd *project.Deps, loadConfig func(string) (*config.Config, error), opts ExploreOptions) (*ExploreResult, error) {
+	resolved, err := ResolvePathsWith(d, pd, loadConfig, opts.ResolveInput)
+	if err != nil {
+		return nil, err
+	}
+	runtimePath, err := ResolveRuntimePathWith(d, resolved.ProjectPath, opts.ResolveInput.RuntimeOverride)
+	if err != nil {
+		return nil, err
+	}
+	cfg, _ := loadConfig(d.defaultConfigPath())
+	return exploreResolvedSet(d, cfg, exploreCoreOptions{
+		DefPath:     resolved.DefinitionPath,
+		RuntimePath: runtimePath,
+		SetID:       strings.TrimSpace(opts.TaskSetID),
+		Agents:      opts.Agents,
+		Effort:      opts.Effort,
+		Timeout:     opts.Timeout,
+		Output:      opts.Output,
+		admission:   opts.Wait.Policy(opts.ConfirmIn),
+	})
+}
+
+// exploreResolvedSet is the resolved-path core of the Explore phase, shared by
+// the hand-run verb and the drain's own step. It writes the report only when an
+// Explorer answered in full: an interrupted, failed or exhausted pass returns
+// its error and leaves any report already on disk exactly as it was.
+func exploreResolvedSet(d *Deps, cfg *config.Config, opts exploreCoreOptions) (*ExploreResult, error) {
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{SetID: opts.SetID, DefPath: opts.DefPath})
+	if err != nil {
+		return nil, err
+	}
+	// The Explorer reads the checkout it describes, so a drain rewriting those
+	// files underneath it would have it map a state that never existed
+	// (ADR-0238). The hold ends when the report is written.
+	if !opts.checkoutHeld {
+		hold, err := AcquireTreeStable(d, opts.RuntimePath, opts.SetID, opts.Output, opts.admission)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = hold.Release() }()
+	}
+	// Read before the Explorer runs: it is the tree the report describes.
+	workSHA := verifyWorkSHA(d, opts.RuntimePath)
+	body, agent, err := runExplorer(d, cfg, opts, m, workSHA)
+	if err != nil {
+		return nil, err
+	}
+	doc := exploreReport.renderDocument(d.Now().UTC(), opts.SetID, workSHA, "", agent, body)
+	path := explorationPath(m.Dir)
+	// Atomic, so a reader — or a drain about to hand the path to a builder —
+	// sees the previous report or the new one, never half of either.
+	if err := WriteAtomicWith(d, path, []byte(ensureTrailingNewline(doc)), 0o644); err != nil {
+		return nil, exitErr(ExitOperational, "write exploration report: %v", err)
+	}
+	printExploreWritten(opts.Output, opts.SetID, path)
+	return &ExploreResult{SetID: opts.SetID, WorkSHA: workSHA, Path: path, Body: doc}, nil
+}
+
+// explorationPath is where a set's Exploration report lives: flat in the set
+// directory, beside the spec and the progress record.
+func explorationPath(setDir string) string {
+	return filepath.Join(setDir, ExplorationFileName)
+}
+
+// hasExplorationReport reports whether the set's Exploration report exists.
+// Presence is the whole question: nothing compares the tree the report records
+// to the checkout (ADR-0262 decision 3), so absent means explore and present
+// means reuse.
+func hasExplorationReport(d *Deps, m *Manifest) bool {
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return false
+	}
+	_, err := d.FS.Stat(explorationPath(m.Dir))
+	return err == nil
+}
+
+// explorationReportPath is the report as a builder is handed it: its path when
+// the set has one, and empty when it has none, so an attempt on an unexplored
+// set is told nothing at all.
+func explorationReportPath(d *Deps, m *Manifest) string {
+	if !hasExplorationReport(d, m) {
+		return ""
+	}
+	return explorationPath(m.Dir)
+}
+
+// runExplorer builds the prompt and invokes the Explorer, returning the report
+// and the agent that wrote it.
+func runExplorer(d *Deps, cfg *config.Config, opts exploreCoreOptions, m *Manifest, workSHA string) (string, string, error) {
+	text := buildExplorerPrompt(d, m)
+	run := opts.runExplorer
+	if run == nil {
+		sel, err := resolveExplorer(opts.Agents, opts.Effort, m, cfg)
+		if err != nil {
+			return "", "", err
+		}
+		run = func(prompt string) (string, string, error) {
+			return runConfiguredExplorer(d, cfg, sel, m.Dir, opts.SetID, workSHA, opts.RuntimePath, prompt, opts.Output, opts.Timeout, opts.probeMemo)
+		}
+	}
+	body, agent, err := run(text)
+	if err != nil {
+		return "", "", err
+	}
+	if strings.TrimSpace(body) == "" {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", opts.SetID)
+	}
+	return body, agent, nil
+}
+
+// resolveExplorer applies the Explorer precedence chain (ADR-0262), highest
+// first: CLI flags → the set's `explorer` object → [work.explore] →
+// [work.implement].agents / DefaultExploreEffort. It is the Refiner's chain with
+// the phase's own keys, and like it the fallthrough to the implement list is
+// disabled by an override of `agents = []`.
+func resolveExplorer(cliAgents []string, cliEffort string, m *Manifest, cfg *config.Config) (verifierSelection, error) {
+	agents := nonEmptyStrings(cliAgents)
+	effort := strings.TrimSpace(cliEffort)
+
+	if over := m.ExplorerOverride(); over != nil {
+		if len(agents) == 0 {
+			agents = nonEmptyStrings(over.Agents)
+		}
+		if effort == "" {
+			effort = strings.TrimSpace(over.Effort)
+		}
+	}
+	if e := cfg.ExploreSettings(); e != nil && effort == "" {
+		effort = strings.TrimSpace(e.Effort)
+	}
+	if len(agents) == 0 {
+		resolved, err := ResolveAgentGroupPresets(cfg.ExploreAgentList(), cfg)
+		if err != nil {
+			return verifierSelection{}, err
+		}
+		agents = resolved
+	}
+	if effort == "" {
+		effort = DefaultExploreEffort
+	}
+	return verifierSelection{Agents: agents, Effort: effort}, nil
+}
+
+// runConfiguredExplorer walks the resolved Explorer agent list through the
+// shared fallback walk, each preset retried up to the standard per-phase cap so
+// one flake cannot park a set that asked to be explored (ADR-0262 decision 5).
+func runConfiguredExplorer(d *Deps, cfg *config.Config, sel verifierSelection, taskSetDir, setID, workSHA, runtimePath, prompt string, out io.Writer, timeout time.Duration, probeMemo *agentAvailabilityProbeMemo) (string, string, error) {
+	if timeout <= 0 {
+		timeout = DefaultAttemptTimeout
+	}
+	quotaRetryAfter, err := resolveAgentQuotaRetryAfter(cfg)
+	if err != nil {
+		return "", "", exitErr(ExitSetup, "%v", err)
+	}
+	walked, err := runAgentFallbackWalk(d, agentFallbackWalk{
+		role:            explorerRole(d, out, taskSetDir, setID, workSHA),
+		sel:             sel,
+		setID:           setID,
+		runtimePath:     runtimePath,
+		prompt:          prompt,
+		out:             out,
+		errOut:          out,
+		timeout:         timeout,
+		maxTries:        config.DefaultTaskMaxTries,
+		retryDelays:     append([]time.Duration(nil), config.DefaultTaskAttemptRetryDelays...),
+		quotaRetryAfter: quotaRetryAfter,
+		cfg:             cfg,
+		probeMemo:       probeMemo,
+	})
+	if err != nil {
+		return "", "", err
+	}
+	// Prose from an attempt that timed out or died is half a map, and a builder
+	// handed half a map builds against it as if it were whole.
+	if strings.TrimSpace(walked.Answer) != "" && !walked.AnswerRetryEligible {
+		return walked.Answer, walked.Agent, nil
+	}
+	if len(walked.Unavailable) == 0 {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report")
+	}
+	return "", "", exitErr(ExitSetup, "%s", formatHumanHealingExhaustionMessage(walked.Unavailable))
+}
+
+// explorerRole is what the shared fallback walk calls the Explorer: its name in
+// the operator's output, the Captured run each invocation is filed as under the
+// `explore` phase, and the Refiner's retry rule — a report has no format to
+// parse, so a run that reached its own ending with prose is the Explorer
+// answering. Its runs are filed like every other set-level phase's, so
+// `pop tasks spend` counts what exploring cost.
+func explorerRole(d *Deps, errOut io.Writer, taskSetDir, setID, workSHA string) agentRole {
+	return agentRole{
+		Noun:   "Explorer agent",
+		Gerund: "Exploring",
+		Phase:  spendPhaseExplore,
+		Persist: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int) {
+			_ = persistExploreRun(d, errOut, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, try, outcome, reason, exitCode, "")
+		},
+		PersistAnswer: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int, answer string) {
+			_ = persistExploreRun(d, errOut, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, try, outcome, reason, exitCode, exploreRunOutcome(outcome, answer))
+		},
+		PersistSkipped: func(rec *streamRecorder, invocation *AgentInvocation, model string, try int, reason string, exitCode int) {
+			_ = persistSkippedExploreRun(d, errOut, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, model, try, reason, exitCode)
+		},
+		RetryEligible: refineAttemptRetryEligible,
+	}
+}
+
+// exploreRunOutcome is what one Explorer invocation files in its run's outcome
+// slot: explored when the run reached its own clean ending with prose — the
+// answer pop writes as the report — and nothing otherwise.
+func exploreRunOutcome(streamOutcome, answer string) string {
+	if streamOutcome != streamOutcomeCompleted || strings.TrimSpace(answer) == "" {
+		return ""
+	}
+	return exploreOutcomeExplored
+}
+
+// printExploreWritten tells the operator where the report went. Like Refine's
+// it says nothing about what the report says: the document is the output.
+func printExploreWritten(w io.Writer, setID, path string) {
+	if w == nil {
+		return
+	}
+	out := outputFor(w)
+	out.line(ansiBold, "━━ Exploration for %s", setID)
+	out.line(ansiDim, "   Document: %s", path)
+	out.line(ansiDim, "   Read it: pop tasks artifacts %s --show %s", setID, ExplorationFileName)
+}
+
+// buildExplorerPrompt assembles the Explorer's prompt: pop's role framing and
+// output expectation around the set's own manifest listing, every task body and
+// the spec when one exists. It carries no changeset — nothing has been built
+// yet — and asks for nothing beyond the code as found: the check for composed
+// forms a builder is about to hand-write stays in the implement frame, where the
+// mechanism is knowable (ADR-0262 decision 7).
+func buildExplorerPrompt(d *Deps, m *Manifest) string {
+	view := explorerPromptView{TaskSet: m.Stem, Tasks: explorerTaskRows(d, m)}
+	if spec, ok := readSpec(d, m); ok {
+		view.SpecRecorded = true
+		view.Spec = spec
+	}
+	return prompt.MustRender(promptTemplates, "explorer.tmpl.md", view)
+}
+
+// explorerPromptView is what the Explorer's template renders against; like the
+// other roles' views, each optional section is a named boolean beside its text.
+type explorerPromptView struct {
+	TaskSet      string
+	SpecRecorded bool
+	Spec         string
+	Tasks        []explorerTaskRow
+}
+
+// explorerTaskRow is one manifest entry and its body. Every task is listed,
+// done ones included: a resumed set's finished work shaped the area the open
+// tasks will touch.
+type explorerTaskRow struct {
+	ID         string
+	Type       string
+	Status     TaskStatus
+	Title      string
+	BlockedBy  string
+	Readable   bool
+	Unreadable bool
+	Body       string
+	Error      string
+}
+
+func explorerTaskRows(d *Deps, m *Manifest) []explorerTaskRow {
+	rows := make([]explorerTaskRow, 0, len(m.Tasks))
+	for _, task := range m.Tasks {
+		row := explorerTaskRow{ID: task.ID, Type: task.Type, Status: task.Status, Title: task.Title, BlockedBy: strings.Join(task.BlockedBy, ", ")}
+		body, err := d.FS.ReadFile(filepath.Join(m.Dir, task.File))
+		if err != nil {
+			row.Unreadable = true
+			row.Error = fmt.Sprintf("%v", err)
+		} else {
+			row.Readable = true
+			row.Body = strings.TrimSpace(string(body))
+		}
+		rows = append(rows, row)
+	}
+	return rows
+}
diff --git a/tasks/explore_mark.go b/tasks/explore_mark.go
new file mode 100644
index 00000000..a35f2924
--- /dev/null
+++ b/tasks/explore_mark.go
@@ -0,0 +1,209 @@
+package tasks
+
+import (
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/work"
+)
+
+// ExploreMark is whether a Task set that declared `"explore": true` has its
+// Exploration report, carried beside the set's status and its Verification mark
+// rather than inside either (ADR-0262). A set that never asked carries none.
+//
+// It is an alias of work.ExploreMark so a Work container can carry it without
+// `work` importing this package. ResolveExploreMark is the one place that
+// derives it.
+type ExploreMark = work.ExploreMark
+
+const (
+	// ExploreMarkNone is the absent mark: the set never asked to be explored.
+	ExploreMarkNone ExploreMark = ""
+	// ExploreMarkExplored is a set that asked and has its report.
+	ExploreMarkExplored ExploreMark = "explored"
+	// ExploreMarkUnexplored is a set that asked and has no report; the reason
+	// rides beside it.
+	ExploreMarkUnexplored ExploreMark = "unexplored"
+)
+
+// UnexploredReason is why an unexplored set has no report — detail beside the
+// mark, never a second mark.
+type UnexploredReason = work.UnexploredReason
+
+const (
+	// UnexploredReasonNone is the absent reason: the set is explored, or carries
+	// no mark at all.
+	UnexploredReasonNone UnexploredReason = ""
+	// UnexploredNotYetRun is a set no pass has concluded on: none has run, the
+	// last one was interrupted, or the report a pass wrote has since been
+	// removed. The next drain explores it.
+	UnexploredNotYetRun UnexploredReason = "not-yet-run"
+	// UnexploredPassFailed is a set whose last pass gave up without a report. It
+	// is what parks the set at EXPLORE-FAILED.
+	UnexploredPassFailed UnexploredReason = "pass-failed"
+)
+
+// ExploreResolution is what the read-side resolution answers for one set: the
+// mark, the reason beside it, and the report as a pointer when there is one.
+type ExploreResolution struct {
+	Mark   ExploreMark
+	Reason UnexploredReason
+	// Pointer is the report as the surfaces carry it — its path and the tree its
+	// header records, never its body. Set only when HasReport.
+	Pointer   ReportPointer
+	HasReport bool
+}
+
+// ResolveExploreMark is the single read-side Explore mark resolution (ADR-0262
+// decision 6). Every surface — the status rows, the dashboard, the sign-off
+// gate, the Assist prompt — reads this answer, and the park is derived from it,
+// so no surface can disagree with another about a set.
+//
+// It stores nothing. The report's presence is the first fact; for a set without
+// one, the set's latest Captured run of phase `explore` is the second: a run
+// that answered (its outcome slot says explored) or was interrupted concluded
+// nothing about the set, while any other ending is a pass that gave up. The
+// recorded tree is never compared to the checkout — present means reuse.
+func ResolveExploreMark(d *Deps, m *Manifest) ExploreResolution {
+	if d == nil {
+		d = defaultDeps
+	}
+	if m == nil || !m.ExploreRequested() {
+		return ExploreResolution{}
+	}
+	if pointer, ok := explorationPointer(d, m); ok {
+		return ExploreResolution{Mark: ExploreMarkExplored, Pointer: pointer, HasReport: true}
+	}
+	run, ok := latestExploreRun(d, m)
+	if !ok || run.Verdict == exploreOutcomeExplored || run.Outcome == streamOutcomeInterrupted {
+		return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredNotYetRun}
+	}
+	return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredPassFailed}
+}
+
+// deriveExploredStatus is a set's manifest-derived status with the
+// EXPLORE-FAILED park applied, beside the resolution the park came from. It is
+// the one place a status meets the Explore mark, so the status row, the per-set
+// detail and an Assist session cannot disagree about whether a set is parked.
+func deriveExploredStatus(d *Deps, m *Manifest) (TaskSetStatus, ExploreResolution) {
+	status := DeriveStatus(m)
+	explore := ResolveExploreMark(d, m)
+	if exploreParked(status, explore) {
+		status = StatusExploreFailed
+	}
+	return status, explore
+}
+
+// exploreParked reports whether a set with buildable work stays parked at
+// EXPLORE-FAILED instead of reading READY. Only a READY set parks: a set whose
+// AFK work is finished, failed or held at a human gate is already stopped for
+// its own reason, and exploring it would map code nobody is about to build.
+func exploreParked(base TaskSetStatus, res ExploreResolution) bool {
+	return base == StatusReady && res.Reason == UnexploredPassFailed
+}
+
+// latestExploreRun is the set's most recent Captured run of phase `explore`,
+// read from the index halves alone. A run directory pop cannot read reads as no
+// run, which is a set never explored — the direction that explores again rather
+// than parking.
+func latestExploreRun(d *Deps, m *Manifest) (capturedRunMeta, bool) {
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return capturedRunMeta{}, false
+	}
+	metas, err := listCapturedRunMetas(d, m.Dir)
+	if err != nil {
+		return capturedRunMeta{}, false
+	}
+	var latest capturedRunMeta
+	found := false
+	for _, meta := range metas {
+		if meta.Phase == spendPhaseExplore {
+			latest, found = meta, true
+		}
+	}
+	return latest, found
+}
+
+// explorationPointer reads the flat report back as the shared pointer: its path,
+// the work SHA its header records and when it was written. The SHA is shown to a
+// human, who can judge how old it is; nothing compares it to anything.
+func explorationPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ReportPointer{}, false
+	}
+	path := explorationPath(m.Dir)
+	body, err := d.FS.ReadFile(path)
+	if err != nil {
+		return ReportPointer{}, false
+	}
+	text := string(body)
+	p := ReportPointer{Label: exploreReport.PointerLabel, Path: path, WorkSHA: reportHeaderField(text, "Work SHA")}
+	if at, err := time.Parse(time.RFC3339, reportHeaderField(text, exploreReport.WrittenLabel)); err == nil {
+		p.Written = at.UTC().Format("2006-01-02 15:04Z")
+	}
+	return p, true
+}
+
+// ExploreMarkPhrase is the mark as a human reads it, in the one wording every
+// surface uses: empty for a set that never asked, and the reason spelled out
+// beside an unexplored mark.
+func ExploreMarkPhrase(mark ExploreMark, reason UnexploredReason) string {
+	switch {
+	case mark == ExploreMarkExplored:
+		return "Explored"
+	case mark != ExploreMarkUnexplored:
+		return ""
+	case reason == UnexploredPassFailed:
+		return "Not explored: the pass failed"
+	}
+	return "Not explored: not yet run"
+}
+
+// ExploreSectionTitle names the detail-view section the mark and the report's
+// pointer ride in.
+const ExploreSectionTitle = "Exploration"
+
+// DetailBody is the resolution as a detail surface shows it: the mark with its
+// reason, then — when there is a report — its path and the tree it records.
+// Empty for a set that never asked.
+func (r ExploreResolution) DetailBody() string {
+	phrase := ExploreMarkPhrase(r.Mark, r.Reason)
+	if phrase == "" {
+		return ""
+	}
+	lines := []string{phrase}
+	if r.HasReport {
+		lines = append(lines, "report: "+r.Pointer.Path)
+		if r.Pointer.WorkSHA != "" {
+			lines = append(lines, "written against: "+r.Pointer.WorkSHA)
+		}
+	}
+	return strings.Join(lines, "\n")
+}
+
+// exploreParkReason is the one-line why a parked row carries, naming the three
+// ways out (ADR-0262 decision 6).
+func exploreParkReason(setID string) string {
+	return "exploration failed; explore by hand (pop tasks explore " + setID +
+		"), drain once unexplored (pop tasks implement " + setID +
+		" --skip-explore), or retract \"explore\": true"
+}
+
+// explorationBlockView is the resolution as an attended prompt renders it: the
+// report's path and recorded commit when there is one, or the mark's phrase for
+// a set that asked and has none. The zero value renders nothing.
+type explorationBlockView struct {
+	Phrase    string
+	HasReport bool
+	Path      string
+	Commit    string
+}
+
+func explorationBlock(r ExploreResolution) explorationBlockView {
+	view := explorationBlockView{Phrase: ExploreMarkPhrase(r.Mark, r.Reason), HasReport: r.HasReport}
+	if r.HasReport {
+		view.Path = r.Pointer.Path
+		view.Commit = r.Pointer.CommitPhrase()
+	}
+	return view
+}
diff --git a/tasks/explore_phase.go b/tasks/explore_phase.go
new file mode 100644
index 00000000..b329d60d
--- /dev/null
+++ b/tasks/explore_phase.go
@@ -0,0 +1,122 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// exploreDirective is what explorePhase hands back to the drain loop: carry on
+// to task selection, or end the run with the result and error it produced.
+type exploreDirective int
+
+const (
+	// exploreProceed goes on to task selection: the step did not apply, the set
+	// already had its report, or the pass just wrote it.
+	exploreProceed exploreDirective = iota
+	// exploreReturn ends the run: the human interrupted the pass, or the pass
+	// gave up and the set parked at EXPLORE-FAILED.
+	exploreReturn
+)
+
+// explorePhase runs the drain's Explore step (ADR-0262) at the head of the
+// loop, before any task is selected. A set that declared `"explore": true`, has
+// AFK work to build and has no Exploration report gets one; a set that already
+// has a report reuses it whatever commit it records, and a set that never asked
+// is untouched.
+//
+// It is the one agent phase that gates. Proceeding unexplored on a set whose
+// author said its tasks are interrelated delivers exactly the inconsistency the
+// phase exists to prevent, so a pass that gives up — after the standard
+// per-phase retry cap — parks the set rather than letting the drain build blind.
+// The park is not written anywhere: it is derived from the explore run the pass
+// filed and the report's absence (ResolveExploreMark), and the one set-level
+// progress record appended here says why in words.
+//
+// The step declines for a human-completed set, as Refine does, and when
+// [work.explore].enabled is false or the run was started with --skip-explore.
+func (r *implementRun) explorePhase(currentRefresh *RefreshResult) (exploreDirective, error) {
+	m := currentRefresh.Manifests[r.taskSetID]
+	if !exploreStepWanted(r.plan.cfg, m, r.opts.SkipExplore) || hasExplorationReport(r.d, m) {
+		return exploreProceed, nil
+	}
+	_, err := exploreResolvedSet(r.d, r.plan.cfg, exploreCoreOptions{
+		DefPath:     r.resolved.DefinitionPath,
+		RuntimePath: r.runtimePath,
+		SetID:       r.taskSetID,
+		Agents:      r.opts.ExploreAgents,
+		Effort:      r.opts.ExploreEffort,
+		Timeout:     r.timeout,
+		Output:      r.out,
+		runExplorer: r.opts.exploreRunner,
+		probeMemo:   r.agentProbeMemo,
+		// The drain already holds this checkout for this set (ADR-0238).
+		checkoutHeld: true,
+	})
+	if err == nil {
+		return exploreProceed, nil
+	}
+	if isInterrupted(err) {
+		// The human stopped the pass; that concludes nothing about the set, so it
+		// neither parks nor records anything beyond the run itself.
+		return exploreReturn, err
+	}
+	return exploreReturn, r.parkUnexplored(m, err)
+}
+
+// exploreStepWanted is the drain's participation rule: config is the machine's
+// gate and defaults on, the set's own declaration is the trigger, and only a
+// set with AFK work still to build is worth mapping.
+func exploreStepWanted(cfg *config.Config, m *Manifest, skip bool) bool {
+	if skip || !cfg.ExploreEnabled() || m == nil || !m.Valid {
+		return false
+	}
+	if !m.ExploreRequested() || m.HumanCompleted {
+		return false
+	}
+	return hasEligibleTask(m)
+}
+
+// parkUnexplored is what a pass that gave up leaves behind: an explore run the
+// park derives from, one set-level progress record naming the phase and the
+// reason, the parked row rendered, and the run's EXPLORE-FAILED exit.
+func (r *implementRun) parkUnexplored(m *Manifest, cause error) error {
+	d := r.d
+	// A walk whose every preset was skipped before it was invoked — cooling,
+	// missing, logged out — filed no run, and a park derived from runs would then
+	// not see the pass at all: the daemon would pick the set again on its next
+	// tick. File the give-up itself so the derivation has its fact.
+	if ResolveExploreMark(d, m).Reason != UnexploredPassFailed {
+		rec := newStreamRecorder(io.Discard, time.Now)
+		persistExploreRun(d, r.out, m.Dir, r.taskSetID, verifyWorkSHA(d, r.runtimePath), rec, "", "", 0, streamOutcomeAgentUnusable, firstLine(cause.Error()), 0, "")
+	}
+	reason := firstLine(cause.Error())
+	summary := fmt.Sprintf("Explore phase gave up without an Exploration report: %s\nWays out: %s", reason, exploreParkReason(r.taskSetID))
+	if err := AppendSetProgress(d, m.Dir, string(StatusExploreFailed), summary); err != nil {
+		outputFor(r.out).line(ansiYellow, "warning: record explore failure for %s: %v", r.taskSetID, err)
+	}
+
+	r.result.TaskSetExploreFailed = true
+	if refresh, err := RefreshWith(d, r.resolved.DefinitionPath, r.statePath); err == nil {
+		r.result.Refresh = refresh
+		if !r.opts.Yes {
+			fmt.Fprintln(r.out)
+			Render(r.out, refresh)
+		}
+	}
+	if r.opts.Yes {
+		printTaskSetSummary(r.out, r.result)
+	}
+	return exitErr(ExitNoRunnable, "Task set %q exploration failed — parked at %s: %s", r.taskSetID, StatusExploreFailed, reason)
+}
+
+// firstLine is an error's first line, which is what a progress record and a
+// run's reason carry: the rest of a multi-line agent diagnostic belongs to the
+// captured run, not to a one-line why.
+func firstLine(text string) string {
+	line, _, _ := strings.Cut(strings.TrimSpace(text), "\n")
+	return strings.TrimSpace(line)
+}
