+package tasks
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// interrelatedSet is two AFK tasks where the second builds on how the first
+// shapes the code — the set an author marks `"explore": true`.
+func interrelatedSet() []Task {
+	return []Task{
+		{ID: "01-a", File: "01-a.md", Title: "Shape the seam", Type: "AFK", Status: "open"},
+		{ID: "02-b", File: "02-b.md", Title: "Build on it", Type: "AFK", Status: "open", BlockedBy: []string{"01-a"}},
+	}
+}
+
+// exploreDrain is one whole drain of the "demo" set with a recording Explorer:
+// what it was asked, and how many tasks had run when it was.
+type exploreDrain struct {
+	env      *runTaskSetFixture
+	agent    string
+	setDir   string
+	explores int
+	// tasksBeforeExplore is how many implement prompts the builder had seen when
+	// the Explorer was invoked.
+	tasksBeforeExplore []int
+}
+
+func newExploreDrain(t *testing.T, setKeys map[string]any) *exploreDrain {
+	t.Helper()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", interrelatedSet(), setKeys)
+	// The drain names paths by their canonical form, so the set directory is
+	// resolved the same way before a prompt is searched for it.
+	setDir, err := filepath.EvalSymlinks(filepath.Join(env.tasksDir, "demo"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &exploreDrain{
+		env:    env,
+		agent:  writeFakeAgent(t, env.root, fakeAgentConfig{changeFile: "work.txt", changeData: "x\n", checkTask: true, summary: "done"}),
+		setDir: setDir,
+	}
+}
+
+// run drains the set under cfg with an Explorer that answers body, or fails
+// with explorerErr when it is set.
+func (x *exploreDrain) run(t *testing.T, cfg *config.Config, skip bool, body string, explorerErr error) (*RunTaskSetResult, error) {
+	t.Helper()
+	var buf bytes.Buffer
+	opts := x.env.runTaskSetOpts(true, x.agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.SkipExplore = skip
+	opts.exploreRunner = func(string) (string, string, error) {
+		x.explores++
+		x.tasksBeforeExplore = append(x.tasksBeforeExplore, len(fakeAgentPrompts(x.agent)))
+		if explorerErr != nil {
+			return "", "", explorerErr
+		}
+		return body, "claude", nil
+	}
+	return RunTaskSetWith(x.env.deps(), nil, func(string) (*config.Config, error) { return cfg, nil }, opts)
+}
+
+func (x *exploreDrain) row(t *testing.T) Row {
+	t.Helper()
+	refresh, err := RefreshWith(x.env.deps(), x.env.tasksDir, DefaultStatePathWith(x.env.d))
+	if err != nil {
+		t.Fatal(err)
+	}
+	row := findRow(refresh, "demo")
+	if row == nil {
+		t.Fatal("demo set has no status row")
+	}
+	return *row
+}
+
+func (x *exploreDrain) progress(t *testing.T) string {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(x.setDir, ProgressFileName))
+	if err != nil && !os.IsNotExist(err) {
+		t.Fatal(err)
+	}
+	return string(data)
+}
+
+func (x *exploreDrain) writeReport(t *testing.T, body string) {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(x.setDir, ExplorationFileName), []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+const exploredMap = "## Where things live\n- `tasks/run_tasks.go` owns the drain loop."
+
+// TestDrainExploresADeclaredSetBeforeItsFirstTask drives a whole drain of a set
+// that asked to be explored and has no report: the Explorer runs once, before
+// any task, its report lands beside the spec, and every builder after it is
+// handed the report's path — never its body, however long it is.
+func TestDrainExploresADeclaredSetBeforeItsFirstTask(t *testing.T) {
+	t.Parallel()
+	x := newExploreDrain(t, map[string]any{ManifestExploreKey: true})
+	long := exploredMap + "\n" + strings.Repeat("- `tasks/explore.go` says more than any prompt should carry.\n", 400)
+
+	result, err := x.run(t, &config.Config{}, false, long, nil)
+	if err != nil {
+		t.Fatalf("drain: %v", err)
+	}
+	if !result.TaskSetDone {
+		t.Fatalf("result = %+v, want the set drained to DONE", result)
+	}
+	if x.explores != 1 || x.tasksBeforeExplore[0] != 0 {
+		t.Fatalf("explores = %d with %v tasks already run, want one pass before the first task", x.explores, x.tasksBeforeExplore)
+	}
+	report := filepath.Join(x.setDir, ExplorationFileName)
+	body, err := os.ReadFile(report)
+	if err != nil || !strings.Contains(string(body), "`tasks/run_tasks.go` owns the drain loop.") {
+		t.Fatalf("report = %q, %v; want the Explorer's answer on disk", body, err)
+	}
+
+	prompts := fakeAgentPrompts(x.agent)
+	if len(prompts) != 2 {
+		t.Fatalf("builder prompts = %d, want one per task", len(prompts))
+	}
+	for i, prompt := range prompts {
+		if !strings.Contains(prompt, "## This set's Exploration report\n\n"+report+"\n") {
+			t.Fatalf("prompt %d does not name the report's path:\n%s", i+1, prompt)
+		}
+		if strings.Contains(prompt, "owns the drain loop") || strings.Contains(prompt, "says more than any prompt") {
+			t.Fatalf("prompt %d inlined the report's body:\n%s", i+1, prompt)
+		}
+		if !strings.Contains(prompt, "change nothing else in the report") {
+			t.Fatalf("prompt %d does not state the correction duty:\n%s", i+1, prompt)
+		}
+	}
+	if row := x.row(t); row.Explore.Mark != ExploreMarkExplored {
+		t.Fatalf("row mark = %q, want explored", row.Explore.Mark)
+	}
+}
+
+// TestDrainReusesAReportAlreadyThere: a declared set whose report exists is
+// not explored again, whatever commit the report says it describes — nothing
+// compares that to the checkout (ADR-0262 decision 3).
+func TestDrainReusesAReportAlreadyThere(t *testing.T) {
+	t.Parallel()
+	x := newExploreDrain(t, map[string]any{ManifestExploreKey: true})
+	x.writeReport(t, "# Exploration report — demo\n\n- Work SHA: deadbee\n\n"+exploredMap+"\n")
+
+	if _, err := x.run(t, &config.Config{}, false, "a second map", nil); err != nil {
+		t.Fatalf("drain: %v", err)
+	}
+	if x.explores != 0 {
+		t.Fatalf("explores = %d, want the existing report reused", x.explores)
+	}
+	for i, prompt := range fakeAgentPrompts(x.agent) {
+		if !strings.Contains(prompt, filepath.Join(x.setDir, ExplorationFileName)) {
+			t.Fatalf("prompt %d does not name the reused report:\n%s", i+1, prompt)
+		}
+	}
+}
+
+// TestDrainLeavesASetThatNeverAskedUnexplored: no `explore` key, no pass, and
+// a builder prompt with no report in it at all.
+func TestDrainLeavesASetThatNeverAskedUnexplored(t *testing.T) {
+	t.Parallel()
+	x := newExploreDrain(t, nil)
+	if _, err := x.run(t, &config.Config{}, false, exploredMap, nil); err != nil {
+		t.Fatalf("drain: %v", err)
+	}
+	if x.explores != 0 {
+		t.Fatalf("explores = %d, want none for a set that never asked", x.explores)
+	}
+	for i, prompt := range fakeAgentPrompts(x.agent) {
+		if strings.Contains(prompt, "Exploration report") {
+			t.Fatalf("prompt %d mentions a report the set does not have:\n%s", i+1, prompt)
+		}
+	}
+	if row := x.row(t); row.Explore.Mark != ExploreMarkNone || row.Explore.Reason != UnexploredReasonNone {
+		t.Fatalf("row carries mark %q/%q, want none for a set that never asked", row.Explore.Mark, row.Explore.Reason)
+	}
+}
+
+// TestExploreConfigOffSkipsTheDrainStepNotTheVerb: [work.explore].enabled =
+// false drains a declared set without exploring it, and a hand run still writes
+// the report.
+func TestExploreConfigOffSkipsTheDrainStepNotTheVerb(t *testing.T) {
+	t.Parallel()
+	x := newExploreDrain(t, map[string]any{ManifestExploreKey: true})
+	off := exploreConfig(false, nil, "")
+	if _, err := x.run(t, off, false, exploredMap, nil); err != nil {
+		t.Fatalf("drain: %v", err)
+	}
+	if x.explores != 0 {
+		t.Fatalf("explores = %d with the step switched off", x.explores)
+	}
+
+	d := x.env.deps()
+	res, err := exploreResolvedSet(d, off, exploreCoreOptions{
+		DefPath: x.env.tasksDir, RuntimePath: x.env.root, SetID: "demo",
+		runExplorer: func(string) (string, string, error) { return exploredMap, "claude", nil },
+	})
+	if err != nil {
+		t.Fatalf("hand explore with the step off: %v", err)
+	}
+	if _, err := os.Stat(res.Path); err != nil {
+		t.Fatalf("hand explore wrote no report: %v", err)
+	}
+}
+
+// TestExploreStepDeclinesWhatItShouldNotMap pins the participation rule apart
+// from a drain: the human-completed decline Refine also makes, the skip flag,
+// the config gate, and a set with nothing left to build.
+func TestExploreStepDeclinesWhatItShouldNotMap(t *testing.T) {
+	t.Parallel()
+	declared := func(humanCompleted bool, status TaskStatus) *Manifest {
+		m := &Manifest{}
+		if err := parseManifestJSON([]byte(`{"tasks": [], "explore": true}`), m); err != nil {
+			t.Fatal(err)
+		}
+		m.Valid = true
+		m.HumanCompleted = humanCompleted
+		m.Tasks = []Task{{ID: "01-a", File: "01-a.md", Type: "AFK", Status: status}}
+		return m
+	}
+	on := &config.Config{}
+	if !exploreStepWanted(on, declared(false, TaskOpen), false) {
+		t.Fatal("a declared set with work to build must be explored")
+	}
+	for name, wanted := range map[string]bool{
+		"human-completed":  exploreStepWanted(on, declared(true, TaskOpen), false),
+		"skip flag":        exploreStepWanted(on, declared(false, TaskOpen), true),
+		"config off":       exploreStepWanted(exploreConfig(false, nil, ""), declared(false, TaskOpen), false),
+		"nothing to build": exploreStepWanted(on, declared(false, TaskDone), false),
+	} {
+		if wanted {
+			t.Fatalf("%s: the explore step ran", name)
+		}
+	}
+}
+
+// TestASetThatCannotBeExploredParks drives a drain whose Explorer gives up: no
+// task runs, the set reads EXPLORE-FAILED rather than BLOCKED, one set-level
+// progress record says why, nothing picks it automatically — and each of the
+// three ways out releases it.
+func TestASetThatCannotBeExploredParks(t *testing.T) {
+	t.Parallel()
+	park := func(t *testing.T) *exploreDrain {
+		t.Helper()
+		x := newExploreDrain(t, map[string]any{ManifestExploreKey: true})
+		result, err := x.run(t, &config.Config{}, false, "", errors.New("the Explorer produced no report\nsecond line of the diagnostic"))
+		if err == nil || !strings.Contains(err.Error(), string(StatusExploreFailed)) {
+			t.Fatalf("drain err = %v, want the EXPLORE-FAILED exit", err)
+		}
+		if result == nil || !result.TaskSetExploreFailed {
+			t.Fatalf("result = %+v, want TaskSetExploreFailed", result)
+		}
+		if n := len(fakeAgentPrompts(x.agent)); n != 0 {
+			t.Fatalf("builder ran %d tasks on a set that could not be explored", n)
+		}
+		if _, err := os.Stat(filepath.Join(x.setDir, ExplorationFileName)); !os.IsNotExist(err) {
+			t.Fatalf("a failed pass left a report behind: %v", err)
+		}
+		return x
+	}
+
+	t.Run("parks with one record and is never picked automatically", func(t *testing.T) {
+		t.Parallel()
+		x := park(t)
+		row := x.row(t)
+		if row.Status != StatusExploreFailed || row.Status == StatusBlocked {
+			t.Fatalf("row status = %q, want EXPLORE-FAILED", row.Status)
+		}
+		if row.Explore.Mark != ExploreMarkUnexplored || row.Explore.Reason != UnexploredPassFailed {
+			t.Fatalf("row mark = %q/%q, want unexplored because the pass failed", row.Explore.Mark, row.Explore.Reason)
+		}
+		progress := x.progress(t)
+		if got := strings.Count(progress, "[set] "+string(StatusExploreFailed)); got != 1 {
+			t.Fatalf("progress has %d EXPLORE-FAILED records, want exactly one:\n%s", got, progress)
+		}
+		for _, want := range []string{"Explore phase gave up", "the Explorer produced no report", "--skip-explore"} {
+			if !strings.Contains(progress, want) {
+				t.Fatalf("progress record does not name %q:\n%s", want, progress)
+			}
+		}
+		if strings.Contains(progress, "second line of the diagnostic") {
+			t.Fatalf("progress record carries the whole diagnostic rather than its reason:\n%s", progress)
+		}
+
+		refresh, err := RefreshWith(x.env.deps(), x.env.tasksDir, DefaultStatePathWith(x.env.d))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if id, _, err := SelectTaskSet(refresh, ""); err == nil {
+			t.Fatalf("automatic selection picked %q, want the parked set passed over", id)
+		}
+		if _, _, err := SelectTaskSet(refresh, "demo"); err == nil || !strings.Contains(err.Error(), "pop tasks explore demo") {
+			t.Fatalf("explicit selection = %v, want a refusal naming the ways out", err)
+		}
+
+		// A second drain without the flag is refused before it explores again.
+		if _, err := x.run(t, &config.Config{}, false, exploredMap, nil); err == nil || x.explores != 1 {
+			t.Fatalf("re-drain err = %v after %d passes, want a refusal and no second pass", err, x.explores)
+		}
+	})
+
+	t.Run("a hand run clears the park", func(t *testing.T) {
+		t.Parallel()
+		x := park(t)
+		if _, err := exploreResolvedSet(x.env.deps(), nil, exploreCoreOptions{
+			DefPath: x.env.tasksDir, RuntimePath: x.env.root, SetID: "demo",
+			runExplorer: func(string) (string, string, error) { return exploredMap, "claude", nil },
+		}); err != nil {
+			t.Fatalf("hand explore: %v", err)
+		}
+		if row := x.row(t); row.Status != StatusReady || row.Explore.Mark != ExploreMarkExplored {
+			t.Fatalf("row = %q/%q after a hand run, want READY and explored", row.Status, row.Explore.Mark)
+		}
+	})
+
+	t.Run("retracting the declaration clears the park", func(t *testing.T) {
+		t.Parallel()
+		x := park(t)
+		writeManifestWithSetKeys(t, x.setDir, interrelatedSet(), map[string]any{ManifestExploreKey: false})
+		if row := x.row(t); row.Status != StatusReady || row.Explore.Mark != ExploreMarkNone {
+			t.Fatalf("row = %q/%q after retracting, want READY and no mark", row.Status, row.Explore.Mark)
+		}
+	})
+
+	t.Run("the skip flag drains it once without exploring or parking", func(t *testing.T) {
+		t.Parallel()
+		x := park(t)
+		result, err := x.run(t, &config.Config{}, true, exploredMap, nil)
+		if err != nil {
+			t.Fatalf("skip drain: %v", err)
+		}
+		if !result.TaskSetDone || x.explores != 1 {
+			t.Fatalf("result = %+v after %d passes, want DONE with no second pass", result, x.explores)
+		}
+		if got := strings.Count(x.progress(t), "[set] "+string(StatusExploreFailed)); got != 1 {
+			t.Fatalf("progress has %d EXPLORE-FAILED records after the skip drain, want the original one only", got)
+		}
+	})
+}
