+// The Task-set kind's own Artifact list reaches the detail view with the
+// Exploration report as a row of its own type, between the spec and the
+// progress record — what was decided, what exists, what happened (ADR-0262) —
+// whatever the three files' modification times say.
+func TestArtifactViewListsTheExplorationReportBetweenSpecAndProgress(t *testing.T) {
+	root := t.TempDir()
+	row := genericDetailRow()
+	row.DefPath = root
+	setDir := filepath.Join(root, row.ID)
+	if err := os.MkdirAll(setDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	base := time.Date(2026, 8, 17, 12, 0, 0, 0, time.UTC)
+	for i, name := range []string{tasks.ProgressFileName, tasks.ExplorationFileName, tasks.SpecFileName} {
+		path := filepath.Join(setDir, name)
+		if err := os.WriteFile(path, []byte(name+"\n"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		at := base.Add(time.Duration(i) * time.Hour)
+		if err := os.Chtimes(path, at, at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	listed, err := setkind.New(&setkind.Deps{Tasks: tasks.DefaultDeps()}).Artifacts(work.Container{ID: row.ID, DefPath: root})
+	if err != nil {
+		t.Fatal(err)
+	}
+	kind := &artifactDetailKind{id: ref.KindTaskSet, artifacts: listed}
+	m := openArtifactDetail(t, artifactDetailDashboard(kind, row))
+	updated, _ := m.update(tea.KeyPressMsg{Code: 'v', Text: "v"})
+	view := updated.(QueueDashboard).View().Content
+
+	explore := strings.Index(view, detailArtifactLine(work.Artifact{Type: tasks.ArtifactTypeExplore, Name: tasks.ExplorationFileName, At: base.Add(time.Hour)}))
+	spec := strings.Index(view, "  "+tasks.SpecFileName)
+	progress := strings.Index(view, "  "+tasks.ProgressFileName)
+	if explore < 0 || spec < 0 || progress < 0 || !(spec < explore && explore < progress) {
+		t.Fatalf("Artifact view does not list spec → explore → progress:\n%s", view)
+	}
+}
