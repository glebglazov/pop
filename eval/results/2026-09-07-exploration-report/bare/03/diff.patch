new file mode 100644
index 00000000..22dd2e48
--- /dev/null
+++ b/cmd/tasks_explore_test.go
@@ -0,0 +1,54 @@
+package cmd
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/tasks"
+)
+
+// TestTaskExploreIsWiredToThePass: `pop tasks explore` is a registered verb with
+// its own flags, and its wiring reaches the pass — an unknown set is refused by
+// the pass's own set resolution, and a malformed timeout before anything runs.
+func TestTaskExploreIsWiredToThePass(t *testing.T) {
+	root, _, td := setupCmdRepoTest(t)
+	resetTaskFlags()
+	t.Cleanup(resetTaskFlags)
+	taskDefPath = cmdTasksDir(t, td, root)
+	setDir := filepath.Join(taskDefPath, "demo")
+	if err := os.MkdirAll(setDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(setDir, tasks.ManifestFileName), []byte(`{"tasks":[]}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd, _, err := taskCmd.Find([]string{"explore"})
+	if err != nil || cmd != taskExploreCmd {
+		t.Fatalf("pop tasks explore resolves to %v (%v), want the explore verb", cmd, err)
+	}
+	for _, flag := range []string{"agent", "effort", "timeout", "wait", "no-wait"} {
+		if taskExploreCmd.Flags().Lookup(flag) == nil {
+			t.Fatalf("pop tasks explore has no --%s flag", flag)
+		}
+	}
+	for _, flag := range []string{"skip-explore", "explore-agent", "explore-effort"} {
+		if taskImplementCmd.Flags().Lookup(flag) == nil {
+			t.Fatalf("pop tasks implement has no --%s flag", flag)
+		}
+	}
+
+	taskExploreTimeout = "45m"
+	err = runTaskExploreWith(td, &bytes.Buffer{}, "nope")
+	if err == nil || !strings.Contains(err.Error(), `tasks explore`) || !strings.Contains(err.Error(), `"nope"`) {
+		t.Fatalf("unknown set = %v, want the pass's refusal naming it", err)
+	}
+
+	taskExploreTimeout = "soon"
+	if err := runTaskExploreWith(td, &bytes.Buffer{}, "demo"); err == nil || !strings.Contains(err.Error(), "invalid --timeout") {
+		t.Fatalf("bad timeout = %v, want a refusal before anything runs", err)
+	}
+}
