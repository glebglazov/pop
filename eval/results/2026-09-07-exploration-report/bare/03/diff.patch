+
+	// The pass gave up: an explore run that produced no report, and no report.
+	runsDir := filepath.Join(setDir, "streams", "runs")
+	if err := os.MkdirAll(runsDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	meta := `{"run_id":"r1","phase":"explore","task_set_id":"` + setID + `","task_id":"","task_file":"",` +
+		`"start_time":"2026-08-16T12:00:00Z","end_time":"2026-08-16T12:01:00Z","outcome":"failed","agent":"claude","attempt":3}`
+	if err := os.WriteFile(filepath.Join(runsDir, "r1.meta.json"), []byte(meta), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if dispatchable() {
+		t.Fatal("the daemon would dispatch a set parked at EXPLORE-FAILED")
+	}
+}
