+// TestContainersCarryTheRowsExploreResolution: the Work row and its detail view
+// render the Explore mark the status row resolved, rather than deriving it
+// again (ADR-0262). A set that asked and has no report says "unexplored" beside
+// its status with the reason in the detail view; a set with a report shows its
+// path and the tree it records in the detail view, never the body; a set that
+// never asked carries nothing on either surface.
+func TestContainersCarryTheRowsExploreResolution(t *testing.T) {
+	ready := &tasks.Manifest{Valid: true, Tasks: []tasks.Task{{ID: "01-a", File: "01-a.md", Type: "AFK", Status: "open"}}}
+	report := "/def/explored/" + tasks.ExplorationFileName
+	d := testDeps(t, nil)
+	d.Tasks = workDataDeps(t)
+	d.Refresh = func(string) (*tasks.RefreshResult, error) {
+		return &tasks.RefreshResult{
+			Rows: []tasks.Row{
+				{ID: "asked", Status: tasks.StatusReady, Explore: tasks.ExploreResolution{
+					Mark: tasks.ExploreMarkUnexplored, Reason: tasks.UnexploredNotYetRun}},
+				{ID: "explored", Status: tasks.StatusReady, Explore: tasks.ExploreResolution{
+					Mark: tasks.ExploreMarkExplored, HasReport: true,
+					Pointer: tasks.ReportPointer{Label: "Exploration", Path: report, WorkSHA: "c0ffee1"}}},
+				{ID: "never", Status: tasks.StatusReady},
+			},
+			Manifests: map[string]*tasks.Manifest{"asked": ready, "explored": ready, "never": ready},
+		}, nil
+	}
+
+	got, err := rowsForStatic(d, &config.Config{}, verdictFixtureGroup())
+	if err != nil {
+		t.Fatal(err)
+	}
+	section := func(c *work.Container) string {
+		for _, s := range c.DetailSections {
+			if s.Title == tasks.ExploreSectionTitle {
+				return s.Body
+			}
+		}
+		return ""
+	}
+
+	asked := containerByID(got, "asked")
+	if asked.ExploreMark != tasks.ExploreMarkUnexplored || asked.ExploreReason != tasks.UnexploredNotYetRun {
+		t.Fatalf("asked container = %q/%q, want the row's unexplored/not-yet-run", asked.ExploreMark, asked.ExploreReason)
+	}
+	if cell := tasks.WorkRowStatusCell(*asked); !strings.Contains(cell, "unexplored") || strings.Contains(cell, "not yet run") {
+		t.Fatalf("asked status cell = %q, want the mark beside the status and the reason kept out of it", cell)
+	}
+	if body := section(asked); body != "Not explored: not yet run" {
+		t.Fatalf("asked detail section = %q, want the mark with its reason", body)
+	}
+
+	explored := containerByID(got, "explored")
+	if cell := tasks.WorkRowStatusCell(*explored); strings.Contains(cell, "explored") {
+		t.Fatalf("explored status cell = %q, want nothing to act on beside the status", cell)
+	}
+	if body := section(explored); !strings.Contains(body, "report: "+report) || !strings.Contains(body, "written against: c0ffee1") {
+		t.Fatalf("explored detail section = %q, want the report's path and recorded tree", body)
+	}
+
+	never := containerByID(got, "never")
+	if never.ExploreMark != tasks.ExploreMarkNone || section(never) != "" || strings.Contains(tasks.WorkRowStatusCell(*never), "explore") {
+		t.Fatalf("a set that never asked carries an Explore mark: %+v", never)
+	}
+}
