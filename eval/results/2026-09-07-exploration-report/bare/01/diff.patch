diff --git a/tasks/explore.go b/tasks/explore.go
new file mode 100644
index 00000000..cdb83617
--- /dev/null
+++ b/tasks/explore.go
@@ -0,0 +1,383 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/prompt"
+	"github.com/glebglazov/pop/project"
+)
+
+// DefaultExploreEffort is the model-strength tier the Explorer runs at when
+// neither a CLI flag, the set's `explorer` object nor [work.explore].effort
+// names one (ADR-0262). Reading code and writing down where things are is
+// everyday work, so it does not default to the strongest tier the way the two
+// judging roles do.
+const DefaultExploreEffort = DefaultTaskEffort
+
+// exploreReport is the Explore phase on the shared pass-report machinery
+// (ADR-0245), and only on half of it: the header of facts and the render. The
+// report is flat — one exploration.md in the set directory, rewritten in place —
+// because the pass runs once per set rather than once per quiescence, and a
+// directory of timestamped documents would be supersede machinery with nothing
+// to supersede (ADR-0262 decision 1). So the DirName and FilePrefix the two
+// rerunning families file by stay empty here.
+var exploreReport = passReport{
+	ArtifactType: ArtifactTypeExploration,
+	Title:        "Exploration report",
+	WrittenLabel: "Explored",
+	AgentLabel:   "Explorer",
+	Noun:         "explore",
+	PointerLabel: "Exploration",
+}
+
+// ExploreOptions configures a `pop tasks explore <set>` run.
+type ExploreOptions struct {
+	ResolveInput ResolveInput
+	// TaskSetID is the bare Task-set identifier to explore.
+	TaskSetID string
+	// Agents is the ordered CLI Explorer fallback list (`--agent`, repeatable).
+	// Empty ⇒ the set's `explorer` object, then [work.explore].agents, then
+	// [work.implement].agents.
+	Agents []string
+	// Effort is the CLI Explorer effort override (`--effort`). Empty ⇒ the
+	// set's `explorer` object, then config, then DefaultExploreEffort.
+	Effort string
+	// Timeout bounds each Explorer attempt. Zero uses DefaultAttemptTimeout.
+	Timeout time.Duration
+	// Output receives the live agent stream and the run's chrome.
+	Output io.Writer
+	// Wait is the `--wait` / `--no-wait` tri-state for admission to the checkout
+	// (ADR-0239).
+	Wait AdmissionWaitChoice
+	// ConfirmIn is the invocation's input, read only to tell a human at a
+	// terminal from a script when resolving Wait.
+	ConfirmIn io.Reader
+}
+
+// ExploreResult is the outcome of one explore pass.
+type ExploreResult struct {
+	SetID   string
+	WorkSHA string
+	// Path is the Exploration report written.
+	Path string
+	// Body is the document itself.
+	Body string
+}
+
+// exploreCoreOptions carries the already-resolved inputs to the core explore
+// routine, so tests can drive it without real path resolution. runExplorer
+// replaces the real agent spawn in tests.
+type exploreCoreOptions struct {
+	DefPath     string
+	RuntimePath string
+	SetID       string
+	Agents      []string
+	Effort      string
+	Timeout     time.Duration
+	Output      io.Writer
+	// runExplorer returns the Explorer's document and the agent that wrote it.
+	runExplorer func(prompt string) (string, string, error)
+	probeMemo   *agentAvailabilityProbeMemo
+	admission   AdmissionPolicy
+	// checkoutHeld says the caller is already inside a claim on this checkout —
+	// the drain's own Explore step, which runs under the drain's running Drain
+	// row and would be refused by its own Set claim if it asked again.
+	checkoutHeld bool
+}
+
+// ExploreTaskSet explores a set using default dependencies.
+func ExploreTaskSet(opts ExploreOptions) (*ExploreResult, error) {
+	return ExploreTaskSetWith(defaultDeps, project.DefaultDeps(), config.Load, opts)
+}
+
+// ExploreTaskSetWith is `pop tasks explore <set>` (ADR-0262): a human
+// re-opening the question. It runs on any set, whatever the set's `explore`
+// key says, and rewrites the report the set already has.
+func ExploreTaskSetWith(d *Deps, pd *project.Deps, loadConfig func(string) (*config.Config, error), opts ExploreOptions) (*ExploreResult, error) {
+	resolved, err := ResolvePathsWith(d, pd, loadConfig, opts.ResolveInput)
+	if err != nil {
+		return nil, err
+	}
+	runtimePath, err := ResolveRuntimePathWith(d, resolved.ProjectPath, opts.ResolveInput.RuntimeOverride)
+	if err != nil {
+		return nil, err
+	}
+	cfg, _ := loadConfig(d.defaultConfigPath())
+	return exploreResolvedSet(d, cfg, exploreCoreOptions{
+		DefPath:     resolved.DefinitionPath,
+		RuntimePath: runtimePath,
+		SetID:       strings.TrimSpace(opts.TaskSetID),
+		Agents:      opts.Agents,
+		Effort:      opts.Effort,
+		Timeout:     opts.Timeout,
+		Output:      opts.Output,
+		admission:   opts.Wait.Policy(opts.ConfirmIn),
+	})
+}
+
+// exploreResolvedSet is the resolved-path core of every explore pass, the
+// hand-run verb's and the drain's alike. It hands a fresh Explorer the set's
+// own tasks and spec, and writes what comes back as the set's Exploration
+// report. Nothing is written until the Explorer has answered: an interrupted
+// or failed pass leaves the report the set already had, or none.
+func exploreResolvedSet(d *Deps, cfg *config.Config, opts exploreCoreOptions) (*ExploreResult, error) {
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{SetID: opts.SetID, DefPath: opts.DefPath})
+	if err != nil {
+		return nil, err
+	}
+	// The Explorer reads the checkout, so it takes it for its duration: a map
+	// drawn while another drain rewrites the files describes a tree that never
+	// existed (ADR-0238).
+	if !opts.checkoutHeld {
+		hold, err := AcquireTreeStable(d, opts.RuntimePath, opts.SetID, opts.Output, opts.admission)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = hold.Release() }()
+	}
+	// Read before the Explorer runs: it is the tree the report describes, and
+	// pop stamps it rather than asking the agent to copy it back.
+	workSHA := verifyWorkSHA(d, opts.RuntimePath)
+	body, agent, err := runExplorer(d, cfg, opts, m, workSHA)
+	if err != nil {
+		if !isInterrupted(err) {
+			recordExploreGiveUp(d, m, err)
+		}
+		return nil, err
+	}
+	doc := exploreReport.renderDocument(d.Now().UTC(), opts.SetID, workSHA, "", agent, body)
+	path, replaced, err := writeExplorationReport(d, m.Dir, doc)
+	if err != nil {
+		return nil, err
+	}
+	printExploreWritten(opts.Output, opts.SetID, path, replaced)
+	return &ExploreResult{SetID: opts.SetID, WorkSHA: workSHA, Path: path, Body: doc}, nil
+}
+
+// writeExplorationReport puts the document at the set's one Exploration report
+// path, replacing whatever was there. The write is atomic, so a reader — a
+// builder handed the path mid-write — sees the old report or the new one and
+// never half of either.
+func writeExplorationReport(d *Deps, setDir, doc string) (string, bool, error) {
+	path := filepath.Join(setDir, ExplorationFileName)
+	_, statErr := d.FS.Stat(path)
+	replaced := statErr == nil
+	if err := WriteAtomicWith(d, path, []byte(ensureTrailingNewline(doc)), 0o644); err != nil {
+		return "", false, exitErr(ExitOperational, "write exploration report: %v", err)
+	}
+	return path, replaced, nil
+}
+
+// recordExploreGiveUp appends the one set-level Progress record a park owes
+// (ADR-0262 decision 6), so why the work stopped is readable without opening a
+// Captured run. It is written only when the pass that just gave up has in fact
+// parked the set — a set that never declared exploration has nothing parked,
+// and a pass that failed before any agent ran filed no run to park on.
+func recordExploreGiveUp(d *Deps, m *Manifest, cause error) {
+	if !ResolveExploreMark(d, m).Parked() {
+		return
+	}
+	summary := fmt.Sprintf("explore: %v\n%s", cause, exploreParkDoors(m.Stem))
+	_ = AppendSetProgress(d, m.Dir, string(StatusExploreFailed), summary)
+}
+
+// exploreParkDoors names the three ways out of an EXPLORE-FAILED park, in the
+// one wording the progress record and the drain's stop line share.
+func exploreParkDoors(setID string) string {
+	return fmt.Sprintf("leave the park: pop tasks explore %s · pop tasks implement %s --skip-explore · \"%s\": false",
+		setID, setID, manifestExploreKey)
+}
+
+// runExplorer builds the prompt and invokes the Explorer, returning the
+// document and the agent that wrote it.
+func runExplorer(d *Deps, cfg *config.Config, opts exploreCoreOptions, m *Manifest, workSHA string) (string, string, error) {
+	text := buildExplorerPrompt(d, m, opts.RuntimePath, workSHA)
+	run := opts.runExplorer
+	if run == nil {
+		sel, err := resolveExplorer(opts.Agents, opts.Effort, m, cfg)
+		if err != nil {
+			return "", "", err
+		}
+		run = func(prompt string) (string, string, error) {
+			return runConfiguredExplorer(d, cfg, sel, m.Dir, opts.SetID, workSHA, opts.RuntimePath, prompt, opts.Output, opts.Timeout, opts.probeMemo)
+		}
+	}
+	body, agent, err := run(text)
+	if err != nil {
+		return "", "", err
+	}
+	if strings.TrimSpace(body) == "" {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", opts.SetID)
+	}
+	return body, agent, nil
+}
+
+// resolveExplorer applies the Explorer precedence chain (ADR-0262), highest
+// first: CLI flags → the set's `explorer` object → [work.explore] →
+// [work.implement].agents / DefaultExploreEffort. It is the Refiner's chain with
+// the Explore group's keys, including the refusal an override of `agents = []`
+// gets instead of a fallthrough (ADR-0202 decision 6).
+func resolveExplorer(cliAgents []string, cliEffort string, m *Manifest, cfg *config.Config) (verifierSelection, error) {
+	agents := nonEmptyStrings(cliAgents)
+	effort := strings.TrimSpace(cliEffort)
+
+	if over := m.ExplorerOverride(); over != nil {
+		if len(agents) == 0 {
+			agents = nonEmptyStrings(over.Agents)
+		}
+		if effort == "" {
+			effort = strings.TrimSpace(over.Effort)
+		}
+	}
+	if e := cfg.ExploreSettings(); e != nil && effort == "" {
+		effort = strings.TrimSpace(e.Effort)
+	}
+	if len(agents) == 0 {
+		resolved, err := ResolveAgentGroupPresets(cfg.ExploreAgentList(), cfg)
+		if err != nil {
+			return verifierSelection{}, err
+		}
+		agents = resolved
+	}
+	if effort == "" {
+		effort = DefaultExploreEffort
+	}
+	return verifierSelection{Agents: agents, Effort: effort}, nil
+}
+
+// runConfiguredExplorer walks the resolved Explorer agent list through the
+// shared fallback walk at the standard per-phase cap, and returns the report
+// beside the agent that wrote it. The cap is what stops one flake from parking
+// a set: a pass gives up only after every preset has spent it.
+func runConfiguredExplorer(d *Deps, cfg *config.Config, sel verifierSelection, taskSetDir, setID, workSHA, runtimePath, prompt string, out io.Writer, timeout time.Duration, probeMemo *agentAvailabilityProbeMemo) (string, string, error) {
+	if timeout <= 0 {
+		timeout = DefaultAttemptTimeout
+	}
+	quotaRetryAfter, err := resolveAgentQuotaRetryAfter(cfg)
+	if err != nil {
+		return "", "", exitErr(ExitSetup, "%v", err)
+	}
+	walked, err := runAgentFallbackWalk(d, agentFallbackWalk{
+		role:            explorerRole(d, out, taskSetDir, setID, workSHA),
+		sel:             sel,
+		setID:           setID,
+		runtimePath:     runtimePath,
+		prompt:          prompt,
+		out:             out,
+		errOut:          out,
+		timeout:         timeout,
+		maxTries:        config.DefaultTaskMaxTries,
+		retryDelays:     append([]time.Duration(nil), config.DefaultTaskAttemptRetryDelays...),
+		quotaRetryAfter: quotaRetryAfter,
+		cfg:             cfg,
+		probeMemo:       probeMemo,
+	})
+	if err != nil {
+		return "", "", err
+	}
+	// Prose from an attempt that timed out or died is half a map, and every
+	// builder after it would read it as the whole one.
+	if strings.TrimSpace(walked.Answer) != "" && !walked.AnswerRetryEligible {
+		return walked.Answer, walked.Agent, nil
+	}
+	if len(walked.Unavailable) == 0 {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report")
+	}
+	return "", "", exitErr(ExitSetup, "%s", formatHumanHealingExhaustionMessage(walked.Unavailable))
+}
+
+// explorerRole is what the shared fallback walk calls the Explorer: its name in
+// the operator's output, the Captured run each invocation is filed as under the
+// `explore` phase, and the Refiner's rule for which attempts are worth
+// retrying, since an Explorer's answer is likewise prose with no format.
+//
+// It is the one role spawned under the read-only posture (ADR-0221). An
+// Explorer describes the code and changes none of it, so the presets that can
+// withhold their editing tools do, and the prompt says the same to the rest.
+func explorerRole(d *Deps, errOut io.Writer, taskSetDir, setID, workSHA string) agentRole {
+	persist := func(rec *streamRecorder, invocation *AgentInvocation, model string, try int, outcome, reason string, exitCode int) {
+		_ = persistExploreRun(d, errOut, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, model, try, outcome, reason, exitCode)
+	}
+	return agentRole{
+		Noun:   "Explorer agent",
+		Gerund: "Exploring",
+		Phase:  spendPhaseExplore,
+		Persist: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int) {
+			persist(rec, invocation, "", try, outcome, reason, exitCode)
+		},
+		PersistAnswer: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int, _ string) {
+			persist(rec, invocation, "", try, outcome, reason, exitCode)
+		},
+		PersistSkipped: func(rec *streamRecorder, invocation *AgentInvocation, model string, try int, reason string, exitCode int) {
+			persist(rec, invocation, model, try, streamOutcomeModelSkipped, reason, exitCode)
+		},
+		RetryEligible: refineAttemptRetryEligible,
+		ReadOnly:      true,
+	}
+}
+
+// printExploreWritten tells the operator where the report went. Like the
+// Refine pass it says nothing about what the report found: the report is the
+// whole output.
+func printExploreWritten(w io.Writer, setID, path string, replaced bool) {
+	if w == nil {
+		return
+	}
+	out := outputFor(w)
+	out.line(ansiBold, "━━ Explore for %s", setID)
+	out.line(ansiDim, "   Report: %s", path)
+	if replaced {
+		out.line(ansiDim, "   Replaces the set's previous report.")
+	}
+}
+
+// buildExplorerPrompt assembles the Explorer's prompt: pop's role framing and
+// output expectation around the set's own manifest listing, every task body and
+// the spec when there is one. The bodies are inlined, unlike a builder's, because
+// the Explorer's job is the area all of them touch at once, and it must not
+// spend its turns opening the set's own files to learn what that area is.
+func buildExplorerPrompt(d *Deps, m *Manifest, runtimePath, workSHA string) string {
+	view := explorerPromptView{
+		TaskSet:             m.Stem,
+		RuntimeCheckoutLine: runtimeCheckoutLine(runtimePath),
+		Tasks:               gateTaskRows(m),
+	}
+	if workSHA != "" {
+		view.TreeLine = "Tree: " + workSHA
+	}
+	for _, task := range m.Tasks {
+		view.Bodies = append(view.Bodies, explorerTaskBody{
+			ID:   taskHeading(task),
+			Body: readTaskBody(d, filepath.Join(m.Dir, task.File)),
+		})
+	}
+	if spec, ok := readSpec(d, m); ok {
+		view.SpecRecorded = true
+		view.Spec = spec
+	}
+	return prompt.MustRender(promptTemplates, "explorer.tmpl.md", view)
+}
+
+// explorerPromptView is what the Explorer's template renders against.
+type explorerPromptView struct {
+	TaskSet             string
+	RuntimeCheckoutLine string
+	// TreeLine names the commit the checkout stood at when the pass began,
+	// empty when pop could not read it.
+	TreeLine     string
+	Tasks        []taskRow
+	Bodies       []explorerTaskBody
+	SpecRecorded bool
+	Spec         string
+}
+
+// explorerTaskBody is one task's heading and inlined body.
+type explorerTaskBody struct {
+	ID   string
+	Body taskBodyRow
+}
diff --git a/tasks/explore_mark.go b/tasks/explore_mark.go
new file mode 100644
index 00000000..cdb5f75e
--- /dev/null
+++ b/tasks/explore_mark.go
@@ -0,0 +1,197 @@
+package tasks
+
+import (
+	"path/filepath"
+	"strings"
+
+	"github.com/glebglazov/pop/work"
+)
+
+// ExploreMark is whether a Task set that declared exploration got its
+// Exploration report, carried beside its status the way the Verification and
+// Refine marks are (ADR-0262). It answers one question — explored or not — and
+// a set that never declared `"explore": true` carries none at all.
+//
+// It is an alias of work.ExploreMark so a Work container can carry the field
+// without `work` importing this package. ResolveExploreMark is the one place
+// that derives it.
+type ExploreMark = work.ExploreMark
+
+const (
+	// ExploreMarkNone is the absent mark: the set never declared exploration.
+	ExploreMarkNone ExploreMark = ""
+	// ExploreMarkExplored is a declared set whose report exists.
+	ExploreMarkExplored ExploreMark = "explored"
+	// ExploreMarkUnexplored is a declared set with no report. Why rides beside
+	// it as an UnexploredReason.
+	ExploreMarkUnexplored ExploreMark = "unexplored"
+)
+
+// UnexploredReason is why a declared set has no report — the detail beside the
+// mark, never a second mark.
+type UnexploredReason string
+
+const (
+	// UnexploredReasonNone is the absent reason: the set is explored, or carries
+	// no mark.
+	UnexploredReasonNone UnexploredReason = ""
+	// UnexploredNotYetRun is a set no pass has given up on: none ran, or the last
+	// one was interrupted by a human before it reached an ending.
+	UnexploredNotYetRun UnexploredReason = "not yet run"
+	// UnexploredFailed is a set whose last pass ran to an ending and still left
+	// no report — the cap was spent, every agent was unavailable, or the answer
+	// was unusable. It is what parks a set at EXPLORE-FAILED.
+	UnexploredFailed UnexploredReason = "the pass failed"
+)
+
+// ExploreResolution is what the read-side resolution answers for one set: the
+// mark, the reason beside it, and — when the report exists — the pointer every
+// surface carries it by (path plus the tree it records, never the body).
+type ExploreResolution struct {
+	Mark   ExploreMark
+	Reason UnexploredReason
+	// Pointer is the report's pointer, set only when Mark is
+	// ExploreMarkExplored.
+	Pointer ReportPointer
+}
+
+// Parked reports whether the resolution parks the set: it asked for
+// exploration, a pass gave up, and there is still no report.
+func (r ExploreResolution) Parked() bool {
+	return r.Mark == ExploreMarkUnexplored && r.Reason == UnexploredFailed
+}
+
+// ResolveExploreMark is the single read-side Explore resolution (ADR-0262
+// decision 6): every surface, and the status derivation that turns a park into
+// EXPLORE-FAILED, reads a set through here.
+//
+// It stores nothing. It reads the set's `explore` key, whether exploration.md
+// exists, and the set's latest Captured run of phase `explore` — a run is filed
+// for every invocation, so its presence says a pass was attempted and its
+// outcome says whether a human cut it short. Nothing compares the report's
+// recorded tree to the checkout: absent means write it, present means reuse it
+// (decision 3).
+func ResolveExploreMark(d *Deps, m *Manifest) ExploreResolution {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || !m.Valid || !m.ExploreDeclared() || strings.TrimSpace(m.Dir) == "" {
+		return ExploreResolution{}
+	}
+	if p, ok := latestExplorePointer(d, m); ok {
+		return ExploreResolution{Mark: ExploreMarkExplored, Pointer: p}
+	}
+	run, ok := latestExploreRun(d, m)
+	if !ok || run.Outcome == streamOutcomeInterrupted {
+		return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredNotYetRun}
+	}
+	return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredFailed}
+}
+
+// latestExplorePointer resolves the pointer to the set's Exploration report,
+// and false when the set has none. The report is flat, so its instant is the
+// file's own modification time rather than a stamp in its name.
+func latestExplorePointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	path := filepath.Join(m.Dir, ExplorationFileName)
+	info, err := d.FS.Stat(path)
+	if err != nil || info.IsDir() {
+		return ReportPointer{}, false
+	}
+	p := ReportPointer{Label: exploreReport.PointerLabel, Path: path, Written: info.ModTime().UTC().Format("2006-01-02 15:04Z")}
+	if body, err := d.FS.ReadFile(path); err == nil {
+		p.WorkSHA = reportHeaderField(string(body), "Work SHA")
+	}
+	return p, true
+}
+
+// explorationReportPath is the path a builder is handed for the set's
+// Exploration report, empty when the set has none. It is read per attempt
+// rather than once per run, because the report the drain's own Explore step
+// writes must reach the very first task.
+func explorationReportPath(d *Deps, m *Manifest) string {
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ""
+	}
+	p, ok := latestExplorePointer(d, m)
+	if !ok {
+		return ""
+	}
+	return p.Path
+}
+
+// explorationBlockView is the report as an attended prompt names it: the path
+// and the tree its header records, never the body.
+type explorationBlockView struct {
+	HasReport bool
+	Path      string
+	Tree      string
+}
+
+// explorationBlock resolves that view, and the empty view — which renders
+// nothing — for a set with no report.
+func explorationBlock(d *Deps, m *Manifest) explorationBlockView {
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return explorationBlockView{}
+	}
+	p, ok := latestExplorePointer(d, m)
+	if !ok {
+		return explorationBlockView{}
+	}
+	return explorationBlockView{HasReport: true, Path: p.Path, Tree: p.WorkSHA}
+}
+
+// latestExploreRun is the set's most recent Captured run of phase `explore`,
+// read from the index halves only.
+func latestExploreRun(d *Deps, m *Manifest) (capturedRunMeta, bool) {
+	metas, err := listCapturedRunMetas(d, m.Dir)
+	if err != nil {
+		return capturedRunMeta{}, false
+	}
+	var latest capturedRunMeta
+	found := false
+	// The list is chronological, so the last explore run in it is the newest.
+	for _, meta := range metas {
+		if meta.Phase == spendPhaseExplore {
+			latest, found = meta, true
+		}
+	}
+	return latest, found
+}
+
+// ExploreSectionTitle names the detail-view section the Explore resolution
+// renders as.
+const ExploreSectionTitle = "Exploration"
+
+// ExploreMarkDetail is the mark with its reason as the detail beside it, in the
+// one wording every detail surface prints: "explored", or "unexplored (the pass
+// failed)". Empty for a set that carries no mark.
+func ExploreMarkDetail(res ExploreResolution) string {
+	if res.Mark == ExploreMarkNone {
+		return ""
+	}
+	if res.Reason == UnexploredReasonNone {
+		return string(res.Mark)
+	}
+	return string(res.Mark) + " (" + string(res.Reason) + ")"
+}
+
+// applyExploreResolution stamps each row with its set's Explore resolution and
+// turns a parked READY row into EXPLORE-FAILED. It runs inside every refresh,
+// because a park is only safe if nothing that picks READY sets can miss it: the
+// interactive picker, the Work daemon and every read surface all read rows a
+// refresh built (ADR-0262 decision 6).
+//
+// Only READY is demoted. A parked set still has an eligible AFK task, which is
+// exactly why it would otherwise read READY and be re-explored forever; any
+// other status already stops automatic selection on its own.
+func applyExploreResolution(d *Deps, rows []Row, manifests map[string]*Manifest) {
+	for i := range rows {
+		m := manifests[rows[i].ID]
+		res := ResolveExploreMark(d, m)
+		rows[i].Explore = res
+		if rows[i].Status == StatusReady && res.Parked() {
+			rows[i].Status = StatusExploreFailed
+			rows[i].Progress = BuildProgress(m, StatusExploreFailed)
+		}
+	}
+}
diff --git a/tasks/explore_phase.go b/tasks/explore_phase.go
new file mode 100644
index 00000000..b47f0b34
--- /dev/null
+++ b/tasks/explore_phase.go
@@ -0,0 +1,107 @@
+package tasks
+
+// exploreDirective is what explorePhase hands back to the drain loop. It has the
+// two values a step that can stop a drain needs: go on into task selection, or
+// return the run's result and error as they stand.
+type exploreDirective int
+
+const (
+	// exploreProceed goes on to the loop: the set needed no pass, reused its
+	// report, or has one now.
+	exploreProceed exploreDirective = iota
+	// exploreReturn ends the drain — a human interrupted the Explorer, or the set
+	// is parked at EXPLORE-FAILED.
+	exploreReturn
+)
+
+// explorePhase runs the drain's Explore step (ADR-0262) at the head of the
+// drain, before the loop selects its first task, so that every builder in the
+// set is handed the same report — including the first.
+//
+// It runs only for a set that asked: `"explore": true`, no report yet, and AFK
+// work still to build. A set with a report reuses it and spends nothing here;
+// nothing compares the tree the report records to the checkout. [work.explore]
+// gates the step for the machine and defaults on, and --skip-explore declines
+// it for this one drain.
+//
+// Unlike Refine, this step gates. Exploration exists so builders do not start
+// from separate maps, so a declared set whose pass gives up — after the walk has
+// spent the standard cap on every agent — parks at EXPLORE-FAILED rather than
+// building blind. A set already parked is not explored again here; the ways out
+// are the hand-run verb, --skip-explore, and retracting the declaration.
+//
+// A human-completed set is skipped, as Refine skips it: there is nothing left
+// for a builder to be handed a map for.
+func (r *implementRun) explorePhase() (exploreDirective, error) {
+	refresh, err := RefreshWith(r.d, r.resolved.DefinitionPath, r.statePath)
+	if err != nil {
+		return exploreReturn, exitErr(ExitOperational, "refresh before exploring: %v", err)
+	}
+	m := refresh.Manifests[r.taskSetID]
+	if m == nil || !m.Valid || !m.ExploreDeclared() || m.HumanCompleted {
+		return exploreProceed, nil
+	}
+	res := ResolveExploreMark(r.d, m)
+	if res.Mark == ExploreMarkExplored {
+		return exploreProceed, nil
+	}
+	// Only a set with AFK work left has a builder to hand the map to.
+	if _, selErr := SelectTaskInSet(refresh, r.taskSetID); selErr != nil {
+		return exploreProceed, nil
+	}
+	if r.opts.SkipExplore {
+		outputFor(r.out).line(ansiDim, "━━ Explore skipped for %s (--skip-explore): draining once without a report", r.taskSetID)
+		return exploreProceed, nil
+	}
+	if !r.plan.cfg.ExploreEnabled() {
+		return exploreProceed, nil
+	}
+	if res.Parked() {
+		return r.parkUnexplored(refresh, "an earlier explore pass gave up")
+	}
+
+	_, err = exploreResolvedSet(r.d, r.plan.cfg, exploreCoreOptions{
+		DefPath:     r.resolved.DefinitionPath,
+		RuntimePath: r.runtimePath,
+		SetID:       r.taskSetID,
+		Agents:      r.opts.ExploreAgents,
+		Effort:      r.opts.ExploreEffort,
+		Timeout:     r.timeout,
+		Output:      r.out,
+		runExplorer: r.opts.exploreRunner,
+		probeMemo:   r.agentProbeMemo,
+		// The drain already holds this checkout for this set (ADR-0238).
+		checkoutHeld: true,
+	})
+	if err == nil {
+		return exploreProceed, nil
+	}
+	if isInterrupted(err) {
+		return exploreReturn, err
+	}
+	refresh, refreshErr := RefreshWith(r.d, r.resolved.DefinitionPath, r.statePath)
+	if refreshErr != nil {
+		return exploreReturn, exitErr(ExitOperational, "refresh after exploring: %v", refreshErr)
+	}
+	if !ResolveExploreMark(r.d, refresh.Manifests[r.taskSetID]).Parked() {
+		// No run was filed — the pass failed before any agent ran (an agent list
+		// that resolves to nothing, say). That is a setup error to report, not a
+		// pass that gave up, so it does not park.
+		return exploreReturn, err
+	}
+	return r.parkUnexplored(refresh, err.Error())
+}
+
+// parkUnexplored ends the drain at EXPLORE-FAILED: the result says so, the
+// operator is told why and how out, and the table is rendered as it now reads.
+func (r *implementRun) parkUnexplored(refresh *RefreshResult, reason string) (exploreDirective, error) {
+	result := r.result
+	result.Refresh = refresh
+	result.TaskSetExploreFailed = true
+	result.BlockedReason = reason
+	out := outputFor(r.out)
+	out.line(ansiRed, "━━ Explore failed for %s: %s", r.taskSetID, reason)
+	out.line(ansiDim, "   %s", exploreParkDoors(r.taskSetID))
+	finishRunTaskSet(r.out, r.opts.Yes, result)
+	return exploreReturn, nil
+}
diff --git a/tasks/explore_test.go b/tasks/explore_test.go
new file mode 100644
index 00000000..0fee4908
--- /dev/null
+++ b/tasks/explore_test.go
@@ -0,0 +1,403 @@
+package tasks
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/prompt/prompttest"
+)
+
+// setupExploreFixture writes a "demo" set of two open AFK tasks and a spec,
+// declaring exploration when declared is set, behind a scripted claude runner
+// that replays runs in order.
+func setupExploreFixture(t *testing.T, declared bool, runs ...scriptedRefineRun) (*Deps, string, string) {
+	t.Helper()
+	d, _ := refineRunnerDeps(t, runs...)
+	defPath := filepath.Join(t.TempDir(), "tasks")
+	setDir := filepath.Join(defPath, "demo")
+	tasks := []Task{
+		{ID: "01-a", File: "01-a.md", Title: "Shape the seam", Type: "AFK", Status: TaskOpen},
+		{ID: "02-b", File: "02-b.md", Title: "Build on the seam", Type: "AFK", Status: TaskOpen, BlockedBy: []string{"01-a"}},
+	}
+	for _, task := range tasks {
+		writeTaskMD(t, setDir, task.File, "## What to build\n\nBODY-OF-"+task.ID+"\n\n## Acceptance criteria\n\n- [ ] ok\n")
+	}
+	var keys map[string]any
+	if declared {
+		keys = map[string]any{manifestExploreKey: true}
+	}
+	writeManifestWithSetKeys(t, setDir, tasks, keys)
+	if err := os.WriteFile(filepath.Join(setDir, SpecFileName), []byte("# Spec\n\nSPEC-BODY\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return d, defPath, setDir
+}
+
+func exploreOpts(defPath string, out *bytes.Buffer) exploreCoreOptions {
+	return exploreCoreOptions{DefPath: defPath, RuntimePath: "/rt", SetID: "demo", Output: out}
+}
+
+// TestExplorePassWritesTheReportAndFilesItsOwnRun drives one hand-run pass end
+// to end through the real agent walk: the Explorer's reply becomes
+// exploration.md flat in the set directory, its invocation is a Captured run of
+// phase `explore`, and the spend and stream lenses give that run a row of its
+// own. A set that never declared exploration is explored all the same — a hand
+// run is a human asking.
+func TestExplorePassWritesTheReportAndFilesItsOwnRun(t *testing.T) {
+	t.Parallel()
+	d, defPath, setDir := setupExploreFixture(t, false,
+		scriptedRefineRun{output: claudeRefineStream(`## Where things live\n\nObserved at sha1 on main. The seam is tasks/seam.go:Seam.`)})
+
+	var out bytes.Buffer
+	res, err := exploreResolvedSet(d, nil, exploreOpts(defPath, &out))
+	if err != nil {
+		t.Fatalf("exploreResolvedSet: %v\n%s", err, out.String())
+	}
+
+	wantPath := filepath.Join(setDir, ExplorationFileName)
+	if res.Path != wantPath {
+		t.Fatalf("report path = %q, want %q", res.Path, wantPath)
+	}
+	body, err := os.ReadFile(wantPath)
+	if err != nil {
+		t.Fatalf("read report: %v", err)
+	}
+	for _, want := range []string{
+		"# Exploration report — demo",
+		"- Work SHA: sha1",
+		"- Explorer: claude",
+		"The seam is tasks/seam.go:Seam.",
+	} {
+		if !strings.Contains(string(body), want) {
+			t.Fatalf("report missing %q:\n%s", want, body)
+		}
+	}
+	if !strings.Contains(out.String(), wantPath) {
+		t.Fatalf("output does not name the report:\n%s", out.String())
+	}
+
+	m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+	if !m.Valid {
+		t.Fatalf("an explored set reads malformed: %v", m.Errors)
+	}
+	runs, err := listSetRuns(d, setDir)
+	if err != nil {
+		t.Fatalf("listSetRuns: %v", err)
+	}
+	if len(runs) != 1 || runs[0].meta.Phase != spendPhaseExplore || runs[0].meta.TaskFile != "" || runs[0].meta.WorkSHA != "sha1" {
+		t.Fatalf("captured runs = %+v, want one set-level explore run at sha1", runs)
+	}
+	breakdown, err := buildSpendSetBreakdown(d, "demo", m, loadRateTableForSpend(d), nil)
+	if err != nil {
+		t.Fatalf("buildSpendSetBreakdown: %v", err)
+	}
+	if breakdown.ExploreRunCount != 1 || breakdown.ImplementRunCount != 0 || len(breakdown.Rows) != 1 || breakdown.Rows[0].TaskID != "explore" {
+		t.Fatalf("spend = explore %d / implement %d rows %+v, want one explore row", breakdown.ExploreRunCount, breakdown.ImplementRunCount, breakdown.Rows)
+	}
+	streams, err := readSetAttemptStreams(d, m, true)
+	if err != nil {
+		t.Fatalf("readSetAttemptStreams: %v", err)
+	}
+	if len(streams) != 1 || streams[0].TaskID != "explore" {
+		t.Fatalf("streams = %+v, want the explore pass's own stream", streams)
+	}
+}
+
+// TestExplorePassRewritesAnExistingReport: a hand run is the human re-opening
+// the question, so it replaces the report rather than keeping the old one.
+func TestExplorePassRewritesAnExistingReport(t *testing.T) {
+	t.Parallel()
+	d, defPath, setDir := setupExploreFixture(t, true,
+		scriptedRefineRun{output: claudeRefineStream(`## Map\n\nNEW-MAP`)})
+	path := filepath.Join(setDir, ExplorationFileName)
+	if err := os.WriteFile(path, []byte("OLD-MAP\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	var out bytes.Buffer
+	if _, err := exploreResolvedSet(d, nil, exploreOpts(defPath, &out)); err != nil {
+		t.Fatalf("exploreResolvedSet: %v", err)
+	}
+	body, _ := os.ReadFile(path)
+	if strings.Contains(string(body), "OLD-MAP") || !strings.Contains(string(body), "NEW-MAP") {
+		t.Fatalf("report = %q, want the new map in place of the old", body)
+	}
+	if !strings.Contains(out.String(), "Replaces the set's previous report") {
+		t.Fatalf("output does not say the report was replaced:\n%s", out.String())
+	}
+}
+
+// TestFailedExplorePassWritesNothingAndParksADeclaredSet: every attempt of the
+// cap crashes, so the pass gives up. An existing report is untouched; with no
+// report, a declared set reads parked and carries exactly one set-level
+// progress record naming the phase and the reason.
+func TestFailedExplorePassWritesNothingAndParksADeclaredSet(t *testing.T) {
+	t.Parallel()
+	crash := scriptedRefineRun{output: claudeRefineStream(`half a ma`), exitCode: 1}
+
+	t.Run("an existing report is left untouched", func(t *testing.T) {
+		t.Parallel()
+		d, defPath, setDir := setupExploreFixture(t, true, crash, crash, crash)
+		path := filepath.Join(setDir, ExplorationFileName)
+		if err := os.WriteFile(path, []byte("OLD-MAP\n"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		var out bytes.Buffer
+		if _, err := exploreResolvedSet(d, nil, exploreOpts(defPath, &out)); err == nil {
+			t.Fatal("a pass whose every attempt crashed succeeded")
+		}
+		if body, _ := os.ReadFile(path); string(body) != "OLD-MAP\n" {
+			t.Fatalf("report = %q, want it untouched", body)
+		}
+	})
+
+	t.Run("no report parks the declared set", func(t *testing.T) {
+		t.Parallel()
+		d, defPath, setDir := setupExploreFixture(t, true, crash, crash, crash)
+		var out bytes.Buffer
+		if _, err := exploreResolvedSet(d, nil, exploreOpts(defPath, &out)); err == nil {
+			t.Fatal("a pass whose every attempt crashed succeeded")
+		}
+		if _, err := os.Stat(filepath.Join(setDir, ExplorationFileName)); !os.IsNotExist(err) {
+			t.Fatalf("a failed pass wrote a report (stat err %v)", err)
+		}
+		runs, _ := listSetRuns(d, setDir)
+		if len(runs) != 3 {
+			t.Fatalf("captured runs = %d, want the cap's three attempts", len(runs))
+		}
+		m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+		if res := ResolveExploreMark(d, m); !res.Parked() {
+			t.Fatalf("resolution = %+v, want a park", res)
+		}
+		progress, _ := os.ReadFile(filepath.Join(setDir, ProgressFileName))
+		if got := strings.Count(string(progress), "[set] "+string(StatusExploreFailed)); got != 1 {
+			t.Fatalf("progress has %d explore-failed records, want 1:\n%s", got, progress)
+		}
+		if !strings.Contains(string(progress), "explore:") || !strings.Contains(string(progress), "--skip-explore") {
+			t.Fatalf("progress record does not name the phase and the way out:\n%s", progress)
+		}
+	})
+}
+
+// TestInterruptedExplorePassWritesNothing: a human's interrupt is not a pass
+// giving up — no report, no park, no progress record.
+func TestInterruptedExplorePassWritesNothing(t *testing.T) {
+	t.Parallel()
+	d, defPath, setDir := setupExploreFixture(t, true)
+	var out bytes.Buffer
+	opts := exploreOpts(defPath, &out)
+	opts.runExplorer = func(string) (string, string, error) {
+		return "", "", exitErr(ExitInterrupted, "interrupted")
+	}
