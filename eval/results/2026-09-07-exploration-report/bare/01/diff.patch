+// priorArtBlock is the frame's prior-art section, heading to the next blank-line
+// paragraph that is not its own.
+func priorArtBlock(t *testing.T, prompt string) string {
+	t.Helper()
+	const heading = "## Before you hand-write mechanism"
+	start := strings.Index(prompt, heading)
+	if start < 0 {
+		t.Fatalf("prompt has no prior-art block:\n%s", prompt)
+	}
+	rest := prompt[start:]
+	end := strings.Index(rest, "Write the plumbing by hand only when the ladder ends empty.")
+	if end < 0 {
+		t.Fatalf("prior-art block has no closing line:\n%s", rest)
+	}
+	return rest[:end]
+}
