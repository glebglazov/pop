+// TestExplorerPromptAsksForTheCodeAsFound pins what the Explorer is handed and
+// asked: the set's listing, every task body and the spec; the code as found,
+// on a page, every claim naming a path or a symbol, opening with the tree. It
+// asks nothing about prior art.
+func TestExplorerPromptAsksForTheCodeAsFound(t *testing.T) {
