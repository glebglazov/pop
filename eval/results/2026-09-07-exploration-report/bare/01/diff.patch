diff --git a/config/explore_config_test.go b/config/explore_config_test.go
new file mode 100644
index 00000000..aba6b797
--- /dev/null
+++ b/config/explore_config_test.go
@@ -0,0 +1,47 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// TestWorkExploreDefaultsOn pins the [work.explore] group (ADR-0262): the one
+// agent phase that defaults on, so absent configuration explores and only an
+// explicit `enabled = false` turns the drain's step off.
+func TestWorkExploreDefaultsOn(t *testing.T) {
+	load := func(t *testing.T, body string) *Config {
+		t.Helper()
+		path := filepath.Join(t.TempDir(), "config.toml")
+		if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		cfg, err := LoadWith(isolatedDeps(t), path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return cfg
+	}
+
+	if cfg := load(t, "\n"); !cfg.ExploreEnabled() || cfg.ExploreSettings() != nil {
+		t.Fatalf("absent [work.explore]: enabled=%v settings=%+v, want enabled with no section", cfg.ExploreEnabled(), cfg.ExploreSettings())
+	}
+	if !(*Config)(nil).ExploreEnabled() {
+		t.Fatal("a nil config must read as explore enabled")
+	}
+	if cfg := load(t, "[work.explore]\neffort = \"light\"\n"); !cfg.ExploreEnabled() {
+		t.Fatal("a section without enabled must still read as enabled")
+	}
+
+	cfg := load(t, "[work.explore]\nenabled = false\neffort = \"heavy\"\nagents = [\"codex\"]\n")
+	if cfg.ExploreEnabled() {
+		t.Fatal("enabled = false must switch the step off")
+	}
+	if e := cfg.ExploreSettings(); e == nil || e.Effort != "heavy" {
+		t.Fatalf("explore settings = %+v, want effort heavy", e)
+	}
+	if got := strings.Join(cfg.ExploreAgentList().Commands, ","); got != "codex" {
+		t.Fatalf("explore agents = %q, want codex", got)
+	}
+}
