+// exploreSections carries a declared set's Explore resolution into the detail
+// view: the mark with its reason beside it, and the report as a pointer — the
+// path and the tree it records, never its body (ADR-0262). A set that never
+// asked for exploration has no section.
+func exploreSections(res tasks.ExploreResolution) []work.Section {
+	detail := tasks.ExploreMarkDetail(res)
+	if detail == "" {
+		return nil
+	}
+	body := detail
+	if res.Mark == tasks.ExploreMarkExplored {
+		body += "\nreport: " + res.Pointer.Path
+		if phrase := res.Pointer.CommitPhrase(); phrase != "" {
+			body += "\ntree: " + phrase
+		}
+	}
+	return []work.Section{{Title: tasks.ExploreSectionTitle, Body: body}}
+}
