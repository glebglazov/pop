diff --git a/tasks/drain/explore_park_dispatch_test.go b/tasks/drain/explore_park_dispatch_test.go
new file mode 100644
index 00000000..d7dc65bc
--- /dev/null
+++ b/tasks/drain/explore_park_dispatch_test.go
@@ -0,0 +1,22 @@
+package drain
+
+import (
+	"testing"
+
+	"github.com/glebglazov/pop/tasks"
+)
+
+// TestSelectReadySetsPassesOverAnExploreFailedSet: the Work daemon dispatches
+// only READY rows, and a refresh demotes a parked set to EXPLORE-FAILED, so an
+// auto-drain set whose Explore pass gave up is never re-picked — nothing
+// re-explores it in a loop (ADR-0262).
+func TestSelectReadySetsPassesOverAnExploreFailedSet(t *testing.T) {
+	refresh := &tasks.RefreshResult{Rows: []tasks.Row{
+		{ID: "parked", Status: tasks.StatusExploreFailed, AutoDrain: true, Priority: 100, RegIndex: 0},
+		{ID: "ready", Status: tasks.StatusReady, AutoDrain: true, Priority: 1, RegIndex: 1},
+	}}
+	ids, _, ok := selectReadySets(refresh, nil, nil, nil)
+	if !ok || len(ids) != 1 || ids[0] != "ready" {
+		t.Fatalf("dispatchable = %v (ok %v), want only the READY set", ids, ok)
+	}
+}
diff --git a/tasks/drain_explore_test.go b/tasks/drain_explore_test.go
new file mode 100644
index 00000000..15048e4f
--- /dev/null
+++ b/tasks/drain_explore_test.go
@@ -0,0 +1,346 @@
+package tasks
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// exploreSet is two AFK tasks where the second builds on the first — the shape
+// the Explore directive is for.
+func exploreSet() []Task {
+	return []Task{
+		{ID: "01-a", File: "01-a.md", Title: "Shape the seam", Type: "AFK", Status: "open"},
+		{ID: "02-b", File: "02-b.md", Title: "Build on it", Type: "AFK", Status: "open", BlockedBy: []string{"01-a"}},
+	}
+}
+
+func exploreConfig(enabled *bool) *config.Config {
+	return &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Enabled: enabled}}}
+}
+
+// exploreDrain is one whole drain of the "demo" set: it records every pass the
+// Explore step asked for and every prompt the implementing agent was handed.
+type exploreDrain struct {
+	env      *runTaskSetFixture
+	setDir   string
+	agent    string
+	explored int
+	out      bytes.Buffer
+	opts     RunTaskSetOptions
+}
+
+func newExploreDrain(t *testing.T, keys map[string]any) *exploreDrain {
+	t.Helper()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreSet(), keys)
+	e := &exploreDrain{env: env, setDir: filepath.Join(env.tasksDir, "demo")}
+	e.agent = writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "built"})
+	e.opts = env.runTaskSetOpts(true, e.agent, &e.out)
+	e.opts.TaskSetOverride = "demo"
+	e.opts.exploreRunner = func(string) (string, string, error) {
+		e.explored++
+		return "## Where things live\n\nObserved at HEAD on main. The seam is seam.go:Seam.", "claude", nil
+	}
+	return e
+}
+
+func (e *exploreDrain) run(t *testing.T, cfg *config.Config) (*RunTaskSetResult, error) {
+	t.Helper()
+	e.out.Reset()
+	return RunTaskSetWith(e.env.deps(), nil, func(string) (*config.Config, error) { return cfg, nil }, e.opts)
+}
+
+func (e *exploreDrain) reportPath() string { return filepath.Join(e.setDir, ExplorationFileName) }
+
+func (e *exploreDrain) row(t *testing.T) Row {
+	t.Helper()
+	refresh, err := RefreshWith(e.env.deps(), e.env.tasksDir, DefaultStatePathWith(e.env.deps()))
+	if err != nil {
+		t.Fatalf("refresh: %v", err)
+	}
+	row := findRow(refresh, "demo")
+	if row == nil {
+		t.Fatal("no demo row")
+	}
+	return *row
+}
+
+// TestDrainExploresAtItsHeadOnlyWhenTheSetAsked drives whole drains both ways
+// round and asserts on what ran: a declared set with no report is explored
+// before its first task — the first builder is already handed the report — and
+// a declared set with a report, an undeclared set, a machine with the step off
+// and a --skip-explore drain all explore nothing.
+func TestDrainExploresAtItsHeadOnlyWhenTheSetAsked(t *testing.T) {
+	declared := map[string]any{manifestExploreKey: true}
+	off := false
+	tests := []struct {
+		name         string
+		keys         map[string]any
+		cfg          *config.Config
+		seedReport   bool
+		skip         bool
+		wantExplored int
+		wantPointer  bool
+	}{
+		{name: "declared, no report: explores first", keys: declared, cfg: nil, wantExplored: 1, wantPointer: true},
+		{name: "declared, report already there: reuses it", keys: declared, cfg: nil, seedReport: true, wantExplored: 0, wantPointer: true},
+		{name: "never declared: untouched", keys: nil, cfg: nil, wantExplored: 0},
+		{name: "explicitly declared false: untouched", keys: map[string]any{manifestExploreKey: false}, wantExplored: 0},
+		{name: "config off: no pass in any drain", keys: declared, cfg: exploreConfig(&off), wantExplored: 0},
+		{name: "--skip-explore: drains once unexplored", keys: declared, skip: true, wantExplored: 0},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			e := newExploreDrain(t, tc.keys)
+			if tc.seedReport {
+				if err := os.WriteFile(e.reportPath(), []byte("# Exploration report — demo\n\n- Work SHA: abc\n\nOLD-MAP\n"), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			}
+			e.opts.SkipExplore = tc.skip
+			result, err := e.run(t, tc.cfg)
+			if err != nil {
+				t.Fatalf("RunTaskSetWith: %v\n%s", err, e.out.String())
+			}
+			if e.explored != tc.wantExplored {
+				t.Fatalf("explore passes = %d, want %d", e.explored, tc.wantExplored)
+			}
+			if !result.TaskSetDone || result.TaskSetExploreFailed {
+				t.Fatalf("result = %+v, want the set drained to DONE", result)
+			}
+			prompts := fakeAgentPrompts(e.agent)
+			if len(prompts) != 2 {
+				t.Fatalf("implement attempts = %d, want 2", len(prompts))
+			}
+			for i, p := range prompts {
+				if got := strings.Contains(p, e.reportPath()); got != tc.wantPointer {
+					t.Fatalf("attempt %d names the report = %v, want %v:\n%s", i+1, got, tc.wantPointer, p)
+				}
+			}
+			if tc.seedReport {
+				if body, _ := os.ReadFile(e.reportPath()); !strings.Contains(string(body), "OLD-MAP") {
+					t.Fatalf("a present report was regenerated:\n%s", body)
+				}
+			}
+			if tc.skip {
+				if _, err := os.Stat(e.reportPath()); !os.IsNotExist(err) {
+					t.Fatal("a --skip-explore drain wrote a report")
+				}
+				if row := e.row(t); row.Explore.Parked() {
+					t.Fatalf("a --skip-explore drain parked the set: %+v", row.Explore)
+				}
+			}
+		})
+	}
+}
+
+// failingExplorer stands in for a walk whose every agent gave up: it files the
+// Captured run the walk files for each invocation, then answers nothing.
+func failingExplorer(t *testing.T, e *exploreDrain) func(string) (string, string, error) {
+	return func(string) (string, string, error) {
+		e.explored++
+		invocation, err := ResolveAgentInvocationWithMode("claude", "", "prompt", e.env.root, AgentOutputAuto)
+		if err != nil {
+			t.Fatalf("resolve invocation: %v", err)
+		}
+		rec := newStreamRecorder(io.Discard, fakeClock(time.Date(2026, 10, 4, 12, 0, 0, 0, time.UTC), time.Millisecond))
+		explorerRole(e.env.deps(), io.Discard, e.setDir, "demo", "").persist(rec, invocation, 3, streamOutcomeFailed, "crashed", 1)
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report")
+	}
+}
+
+// TestUnexplorableSetParksAndEachDoorLeavesThePark: a declared set whose pass
+// gives up parks at EXPLORE-FAILED before any task runs, with one progress
+// record; automatic selection passes over it and a second drain does not
+// re-explore it. Each of the three doors leaves the park.
+func TestUnexplorableSetParksAndEachDoorLeavesThePark(t *testing.T) {
+	e := newExploreDrain(t, map[string]any{manifestExploreKey: true})
+	e.opts.exploreRunner = failingExplorer(t, e)
+
+	result, err := e.run(t, nil)
+	if err != nil {
+		t.Fatalf("RunTaskSetWith: %v\n%s", err, e.out.String())
+	}
+	if !result.TaskSetExploreFailed || len(result.Completed) != 0 || len(fakeAgentPrompts(e.agent)) != 0 {
+		t.Fatalf("result = %+v (prompts %d), want a park before any task", result, len(fakeAgentPrompts(e.agent)))
+	}
+	if !strings.Contains(e.out.String(), "--skip-explore") {
+		t.Fatalf("the park does not say how out:\n%s", e.out.String())
+	}
+	row := e.row(t)
+	if row.Status != StatusExploreFailed || row.Explore.Reason != UnexploredFailed {
+		t.Fatalf("row = %s %+v, want EXPLORE-FAILED with the pass-failed reason", row.Status, row.Explore)
+	}
+	refresh, _ := RefreshWith(e.env.deps(), e.env.tasksDir, DefaultStatePathWith(e.env.deps()))
+	if id, _, err := SelectTaskSet(refresh, ""); err == nil {
+		t.Fatalf("automatic selection picked %q, a parked set", id)
+	}
+
+	// A second drain stops at the park without re-exploring and without a
+	// second record.
+	if result, err := e.run(t, nil); err != nil || !result.TaskSetExploreFailed {
+		t.Fatalf("second drain = %+v, %v; want it parked again", result, err)
+	}
+	if e.explored != 1 {
+		t.Fatalf("explore passes = %d, want the parked set left alone", e.explored)
+	}
+	progress, _ := os.ReadFile(filepath.Join(e.setDir, ProgressFileName))
+	if n := strings.Count(string(progress), "[set] "+string(StatusExploreFailed)); n != 1 {
+		t.Fatalf("progress carries %d park records, want 1:\n%s", n, progress)
+	}
+
+	t.Run("a successful hand-run pass clears it", func(t *testing.T) {
+		_, err := exploreResolvedSet(e.env.deps(), nil, exploreCoreOptions{
+			DefPath: e.env.tasksDir, RuntimePath: e.env.root, SetID: "demo", Output: io.Discard,
+			runExplorer: func(string) (string, string, error) { return "## Map", "claude", nil },
+		})
+		if err != nil {
+			t.Fatalf("hand-run explore: %v", err)
+		}
+		if row := e.row(t); row.Status != StatusReady || row.Explore.Mark != ExploreMarkExplored {
+			t.Fatalf("row = %s %+v, want READY and explored", row.Status, row.Explore)
+		}
+		if err := os.Remove(e.reportPath()); err != nil {
+			t.Fatal(err)
+		}
+	})
+
+	t.Run("retracting the declaration clears it", func(t *testing.T) {
+		writeManifestWithSetKeys(t, e.setDir, exploreSet(), map[string]any{manifestExploreKey: false})
+		if row := e.row(t); row.Status != StatusReady || row.Explore.Mark != ExploreMarkNone {
+			t.Fatalf("row = %s %+v, want READY with no mark", row.Status, row.Explore)
+		}
+		writeManifestWithSetKeys(t, e.setDir, exploreSet(), map[string]any{manifestExploreKey: true})
+	})
+
+	t.Run("--skip-explore drains it once", func(t *testing.T) {
+		if row := e.row(t); row.Status != StatusExploreFailed {
+			t.Fatalf("row = %s, want the park back once the declaration is", row.Status)
+		}
+		e.opts.SkipExplore = true
+		result, err := e.run(t, nil)
+		if err != nil || !result.TaskSetDone {
+			t.Fatalf("skip drain = %+v, %v; want DONE", result, err)
+		}
+		if e.explored != 1 {
+			t.Fatalf("explore passes = %d, want none under --skip-explore", e.explored)
+		}
+	})
+}
+
+// TestResolveExplorerPrecedence: CLI flags beat the set's `explorer` object,
+// which beats [work.explore], which beats the built-in effort.
+func TestResolveExplorerPrecedence(t *testing.T) {
+	m := &Manifest{Unknown: map[string]json.RawMessage{
+		manifestExplorerKey: json.RawMessage(`{"agents": ["codex"], "effort": "light"}`),
+	}}
+	cfg := &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{
+		Agents: config.AgentEntries{{Cmd: "pi"}}, Effort: "heavy",
+	}}}
+
+	sel, err := resolveExplorer(nil, "", m, cfg)
+	if err != nil || strings.Join(sel.Agents, ",") != "codex" || sel.Effort != "light" {
+		t.Fatalf("manifest over config = %+v, %v; want codex at light", sel, err)
+	}
+	sel, err = resolveExplorer([]string{"claude"}, "standard", m, cfg)
+	if err != nil || strings.Join(sel.Agents, ",") != "claude" || sel.Effort != "standard" {
+		t.Fatalf("CLI over manifest = %+v, %v; want claude at standard", sel, err)
+	}
+	sel, err = resolveExplorer(nil, "", &Manifest{}, cfg)
+	if err != nil || strings.Join(sel.Agents, ",") != "pi" || sel.Effort != "heavy" {
+		t.Fatalf("config alone = %+v, %v; want pi at heavy", sel, err)
+	}
+	sel, err = resolveExplorer([]string{"claude"}, "", &Manifest{}, nil)
+	if err != nil || sel.Effort != DefaultExploreEffort {
+		t.Fatalf("nothing configured = %+v, %v; want the default effort", sel, err)
+	}
+}
+
+// exploreSurfaces renders every tasks-side surface for the demo set: the
+// `pop tasks status` table, the per-set detail, and the HITL sign-off gate's
+// preamble and menu.
+func exploreSurfaces(t *testing.T, e *exploreDrain) (table, detail, gate string) {
+	t.Helper()
+	d := e.env.deps()
+	refresh, err := RefreshWith(d, e.env.tasksDir, DefaultStatePathWith(d))
+	if err != nil {
+		t.Fatalf("refresh: %v", err)
+	}
+	var tb, db bytes.Buffer
+	Render(&tb, refresh)
+	row := findRow(refresh, "demo")
+	m := refresh.Manifests["demo"]
+	RenderTaskSetDetail(d, nil, &db, "demo", row, m)
+
+	var gb strings.Builder
+	in := strings.NewReader("0\n")
+	gateM := *m
+	gateM.Tasks = append(append([]Task(nil), m.Tasks...), Task{ID: "03-h", File: "03-h.md", Type: "HITL", Status: "open"})
+	if _, err := promptHITLGateAction(&gb, in, d, nil, e.env.root, newPromptReader(in), "demo", &gateM, &gateM.Tasks[2],
+		"", nil, false, gateRefineState{}, ReportPointer{}, false, row.Explore); err != nil {
+		t.Fatalf("gate: %v", err)
+	}
+	return tb.String(), db.String(), gb.String()
+}
+
+// TestExploreMarkReachesEveryTasksSurface: one resolution, rendered by the
+// status table, the per-set detail and the sign-off gate. Parked, the mark and
+// its reason show; explored, the report reaches a human as a pointer — path
+// and recorded tree — and never its body; never declared, nothing shows.
+func TestExploreMarkReachesEveryTasksSurface(t *testing.T) {
+	e := newExploreDrain(t, map[string]any{manifestExploreKey: true})
+	e.opts.exploreRunner = failingExplorer(t, e)
+	if _, err := e.run(t, nil); err != nil {
+		t.Fatalf("drain: %v", err)
+	}
+	table, detail, gate := exploreSurfaces(t, e)
+	for surface, text := range map[string]string{"table": table, "detail": detail, "gate": gate} {
+		if !strings.Contains(text, "unexplored") {
+			t.Fatalf("%s does not carry the unexplored mark:\n%s", surface, text)
+		}
+		if !strings.Contains(text, string(UnexploredFailed)) && surface != "table" {
+			t.Fatalf("%s does not carry the reason beside the mark:\n%s", surface, text)
+		}
+	}
+	if !strings.Contains(table, "EXPLORE-FAILED · unexplored") || !strings.Contains(table, "pop tasks explore demo") {
+		t.Fatalf("status table does not show the park and the way out:\n%s", table)
+	}
+
+	const body = "REPORT-BODY-NEVER-SHOWN"
+	doc := exploreReport.renderDocument(time.Date(2026, 10, 4, 12, 0, 0, 0, time.UTC), "demo", "abc1234def", "", "claude", "## Map\n\n"+body)
+	if err := os.WriteFile(e.reportPath(), []byte(doc), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	table, detail, gate = exploreSurfaces(t, e)
+	for surface, text := range map[string]string{"table": table, "detail": detail, "gate": gate} {
+		if strings.Contains(text, body) {
+			t.Fatalf("%s printed the report body:\n%s", surface, text)
+		}
+		if !strings.Contains(text, "explored") {
+			t.Fatalf("%s does not carry the explored mark:\n%s", surface, text)
+		}
+	}
+	for surface, text := range map[string]string{"detail": detail, "gate": gate} {
+		if !strings.Contains(text, e.reportPath()) || !strings.Contains(text, "abc1234") {
+			t.Fatalf("%s does not point at the report and its tree:\n%s", surface, text)
+		}
+	}
+	if !strings.Contains(gate, "Read the exploration report") {
+		t.Fatalf("the gate offers no way to page the report:\n%s", gate)
+	}
+
+	writeManifestWithSetKeys(t, e.setDir, exploreSet(), nil)
+	table, detail, gate = exploreSurfaces(t, e)
+	for surface, text := range map[string]string{"table": table, "detail": detail, "gate": gate} {
+		if strings.Contains(text, "explored") || strings.Contains(text, "Exploration") {
+			t.Fatalf("%s carries an explore mark for a set that never asked:\n%s", surface, text)
+		}
+	}
+}
