+// TestTaskGuideTeachesTheExploreKeysTheValidatorReads holds the Explore
+// directive's guide text to the keys the manifest reader uses (ADR-0262): the
+// printed key names come from the reader's own constants, the opt-in rule is
+// stated in words, and a set written with both keys and an Exploration report
+// beside it still registers — while a stray markdown file is still refused.
+func TestTaskGuideTeachesTheExploreKeysTheValidatorReads(t *testing.T) {
+	t.Parallel()
+	guide := AuthoringGuide()
+	for name, want := range map[string]string{
+		"explore key":            "- `" + manifestExploreKey + "` — optional boolean, and opt-**in**",
+		"opt-in against opt-out": "where `verify` and\n  `refine` are opt-out: absent or `false` means the set never\n  explores",
+		"when to set it":         "Set it\n  when two or more AFK tasks touch the same seam and a later one depends on how\n  an earlier one shapes it.",
+		"explorer key":           "- `" + manifestExplorerKey + "` — optional object",
+		"report in the layout":   "├── " + ExplorationFileName,
+		"report has no entry":    SpecFileName + " and " + ExplorationFileName + " are the only markdown",
+	} {
+		if !strings.Contains(guide, want) {
+			t.Fatalf("guide is missing the %s text (%q):\n%s", name, want, guide)
+		}
+	}
+
+	setDir := filepath.Join(t.TempDir(), "2026-10-04-explored")
+	if err := os.MkdirAll(setDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	template := fencedBlock(t, guide, "markdown", 0)
+	for _, name := range []string{"01-login-form.md", "02-sign-off.md"} {
+		if err := os.WriteFile(filepath.Join(setDir, name), []byte(template+"\n"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.WriteFile(filepath.Join(setDir, ExplorationFileName), []byte("# Exploration\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	example := fencedBlock(t, guide, "json", 0)
+	declared := strings.Replace(example, "{", `{"`+manifestExploreKey+`": true, "`+manifestExplorerKey+`": {"agents": ["codex"], "effort": "light"},`, 1)
+	manifestPath := filepath.Join(setDir, ManifestFileName)
+	if err := os.WriteFile(manifestPath, []byte(declared+"\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	d := &Deps{FS: deps.NewRealFileSystem()}
+	m := LoadManifest(d, "2026-10-04-explored", manifestPath)
+	if !m.Valid {
+		t.Fatalf("a set declaring exploration with its report beside it does not validate: %v", m.Errors)
+	}
+	if !m.ExploreDeclared() {
+		t.Fatal("explore: true does not read back as declared")
+	}
+	over := m.ExplorerOverride()
+	if over == nil || strings.Join(over.Agents, ",") != "codex" || over.Effort != "light" {
+		t.Fatalf("explorer override = %+v, want codex at light", over)
