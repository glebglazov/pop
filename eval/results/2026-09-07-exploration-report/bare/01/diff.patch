+package setkind
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/tasks"
+	"github.com/glebglazov/pop/work"
+)
+
+// containerForExploreRow builds the container one row produces, with the
+// Explore resolution the refresh stamped on it.
+func containerForExploreRow(t *testing.T, res tasks.ExploreResolution) work.Container {
+	t.Helper()
+	m, _ := seedRefinedSet(t, false)
+	rows := []tasks.Row{{ID: "demo", Status: tasks.StatusReady, Explore: res}}
+	d := testDeps(t, rows)
+	d.Refresh = func(string) (*tasks.RefreshResult, error) {
+		return &tasks.RefreshResult{Rows: rows, Manifests: map[string]*tasks.Manifest{"demo": m}}, nil
+	}
+	scan := scanFixture{Name: "pop", ProjectPath: "/repo/main", RuntimePath: "/repo/main", DefinitionPath: "/def", RepoKey: "repo-key"}
+	got, err := rowsForStatic(d, &config.Config{}, staticForScan(scan, "main", false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 {
+		t.Fatalf("containers = %+v, want one", got)
+	}
+	return got[0]
+}
+
+// TestExploreMarkRidesTheRowAndTheDetailView: the dashboard row and `pop work
+// status` print the STATUS cell the kind composes, and the detail view prints
+// the kind's sections — both render the one resolution the refresh stamped.
+func TestExploreMarkRidesTheRowAndTheDetailView(t *testing.T) {
+	k := New(&Deps{})
+
+	unexplored := containerForExploreRow(t, tasks.ExploreResolution{Mark: tasks.ExploreMarkUnexplored, Reason: tasks.UnexploredNotYetRun})
+	if cell := work.StatusCellText(k.StatusCell(unexplored)); !strings.Contains(cell, "unexplored") {
+		t.Fatalf("status cell = %q, want the unexplored mark", cell)
+	}
+	section := exploreSection(t, unexplored)
+	if !strings.Contains(section, "unexplored (not yet run)") {
+		t.Fatalf("detail section = %q, want the mark with its reason", section)
+	}
+
+	explored := containerForExploreRow(t, tasks.ExploreResolution{Mark: tasks.ExploreMarkExplored, Pointer: tasks.ReportPointer{
+		Label: "Exploration", Path: "/def/demo/exploration.md", WorkSHA: "abc1234",
+	}})
+	if cell := work.StatusCellText(k.StatusCell(explored)); !strings.Contains(cell, "explored") {
+		t.Fatalf("status cell = %q, want the explored mark", cell)
+	}
+	section = exploreSection(t, explored)
+	for _, want := range []string{"/def/demo/exploration.md", "abc1234"} {
+		if !strings.Contains(section, want) {
+			t.Fatalf("detail section = %q, want %q", section, want)
+		}
+	}
+
+	never := containerForExploreRow(t, tasks.ExploreResolution{})
+	if cell := work.StatusCellText(k.StatusCell(never)); strings.Contains(cell, "explored") {
+		t.Fatalf("status cell = %q for a set that never asked", cell)
+	}
+	for _, s := range never.DetailSections {
+		if s.Title == tasks.ExploreSectionTitle {
+			t.Fatalf("a set that never asked has an exploration section: %+v", s)
+		}
+	}
+}
+
+func exploreSection(t *testing.T, c work.Container) string {
+	t.Helper()
+	for _, s := range c.DetailSections {
+		if s.Title == tasks.ExploreSectionTitle {
+			return s.Body
+		}
+	}
+	t.Fatalf("no exploration section in %+v", c.DetailSections)
+	return ""
+}
