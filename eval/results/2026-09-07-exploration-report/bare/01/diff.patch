+// TestExploreTaskSetWithResolvesTheSetAndWritesItsReport enters where
+// `pop tasks explore <set>` does — path resolution, the checkout, the real agent
+// walk — and ends at the report on disk and the Captured run beside it.
+func TestExploreTaskSetWithResolvesTheSetAndWritesItsReport(t *testing.T) {
+	env := setupRunTaskSetFixture(t, "demo", exploreSet())
+	d := env.deps()
+	d.LookPath = func(string) (string, error) { return "/bin/claude", nil }
+	d.Runner = &probeNeutralRunner{inner: &scriptedRefineRunner{runs: []scriptedRefineRun{
+		{output: claudeRefineStream(`## Where things live\n\nObserved at HEAD on main. seam.go:Seam owns it.`)},
+	}}}
+
+	var out bytes.Buffer
+	res, err := ExploreTaskSetWith(d, nil, func(string) (*config.Config, error) { return nil, nil }, ExploreOptions{
+		ResolveInput: ResolveInput{CWD: env.root},
+		TaskSetID:    "demo",
+		Agents:       []string{"claude"},
+		Output:       &out,
+		Wait:         AdmissionWaitNever,
+	})
+	if err != nil {
+		t.Fatalf("ExploreTaskSetWith: %v\n%s", err, out.String())
+	}
