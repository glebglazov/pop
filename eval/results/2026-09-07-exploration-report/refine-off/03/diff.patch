+package tasks
+
+import (
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/prompt"
+	"github.com/glebglazov/pop/project"
+)
+
+// DefaultExploreEffort is the model-strength tier the Explorer runs at when
+// neither a CLI flag nor the set's `explorer` directive names one: every builder
+// in the set builds against the map it draws, so a wrong line costs once per
+// task, and the strongest tier is where that is cheapest to avoid.
+const DefaultExploreEffort = "heavy"
+
+// exploreReport is the Exploration report's header and render on the shared
+// pass-report machinery (ADR-0262). The report is flat — one `exploration.md`
+// beside the spec — so it carries no directory or file prefix, and nothing
+// reads it through the timestamped filing or the newest-by-timestamp scan.
+var exploreReport = passReport{
+	ArtifactType: ArtifactTypeExploration,
+	Title:        "Exploration report",
+	WrittenLabel: "Explored",
+	AgentLabel:   "Explorer",
+	Noun:         "explore",
+	PointerLabel: "Exploration",
+}
+
+// ExploreOptions configures a `pop tasks explore <set>` run.
+type ExploreOptions struct {
+	ResolveInput ResolveInput
+	// TaskSetID is the bare Task-set identifier to explore.
+	TaskSetID string
+	// Agents is the ordered CLI Explorer fallback list (`--agent`, repeatable).
+	// Empty ⇒ the set's `explorer` directive, then [work.implement].agents.
+	Agents []string
+	// Effort is the CLI Explorer effort override (`--effort`). Empty ⇒ the
+	// set's `explorer` directive, then DefaultExploreEffort.
+	Effort string
+	// Timeout bounds the single Explorer attempt. Zero uses DefaultAttemptTimeout.
+	Timeout time.Duration
+	// Output receives the live agent stream and the run's chrome.
+	Output io.Writer
+	// Wait is the `--wait` / `--no-wait` tri-state for admission to the checkout
+	// (ADR-0239). The unset default waits at a terminal and refuses elsewhere.
+	Wait AdmissionWaitChoice
+	// ConfirmIn is the invocation's input, read only to tell a human at a
+	// terminal from a script when resolving Wait.
+	ConfirmIn io.Reader
+}
+
+// ExploreResult is the outcome of one explore pass.
+type ExploreResult struct {
+	SetID   string
+	WorkSHA string
+	// Path is the Exploration report written.
+	Path string
+	// Body is the document itself.
+	Body string
+}
+
+// exploreCoreOptions carries the already-resolved inputs to the core explore
+// routine, so tests can drive it without real path-resolution git calls.
+type exploreCoreOptions struct {
+	DefPath     string
+	RuntimePath string
+	SetID       string
+	Agents      []string
+	Effort      string
+	Timeout     time.Duration
+	Output      io.Writer
+	probeMemo   *agentAvailabilityProbeMemo
+	// admission is the policy the Explorer acquires the checkout under
+	// (ADR-0238/0239).
+	admission AdmissionPolicy
+	// checkoutHeld says the caller already holds a claim on this checkout — the
+	// drain's explore step — so the pass takes no Tree-stable hold of its own.
+	checkoutHeld bool
+	// runExplorer replaces the real agent spawn in tests and returns the
+	// Explorer's document and the agent that wrote it.
+	runExplorer func(prompt string) (string, string, error)
+}
+
+// ExploreTaskSet explores a set using default dependencies.
+func ExploreTaskSet(opts ExploreOptions) (*ExploreResult, error) {
+	return ExploreTaskSetWith(defaultDeps, project.DefaultDeps(), config.Load, opts)
+}
+
+// ExploreTaskSetWith is `pop tasks explore <set>` (ADR-0262): it resolves the
+// set, hands a fresh Explorer the set's tasks and its spec, and writes what
+// comes back as the set's Exploration report. A hand run is the human
+// re-opening the question, so it runs whatever the set's `explore` key says and
+// replaces a report that is already there.
+func ExploreTaskSetWith(d *Deps, pd *project.Deps, loadConfig func(string) (*config.Config, error), opts ExploreOptions) (*ExploreResult, error) {
+	resolved, err := ResolvePathsWith(d, pd, loadConfig, opts.ResolveInput)
+	if err != nil {
+		return nil, err
+	}
+	runtimePath, err := ResolveRuntimePathWith(d, resolved.ProjectPath, opts.ResolveInput.RuntimeOverride)
+	if err != nil {
+		return nil, err
+	}
+	cfg, _ := loadConfig(d.defaultConfigPath())
+	return exploreResolvedSet(d, cfg, exploreCoreOptions{
+		DefPath:     resolved.DefinitionPath,
+		RuntimePath: runtimePath,
+		SetID:       strings.TrimSpace(opts.TaskSetID),
+		Agents:      opts.Agents,
+		Effort:      opts.Effort,
+		Timeout:     opts.Timeout,
+		Output:      opts.Output,
+		admission:   opts.Wait.Policy(opts.ConfirmIn),
+	})
+}
+
+// exploreResolvedSet is the resolved-path core of `pop tasks explore`. The
+// report is written only once the Explorer has answered whole: an interrupted or
+// failed pass returns before the write, so the set keeps the report it had.
+func exploreResolvedSet(d *Deps, cfg *config.Config, opts exploreCoreOptions) (*ExploreResult, error) {
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{SetID: opts.SetID, DefPath: opts.DefPath})
+	if err != nil {
+		return nil, err
+	}
+	// The Explorer maps the checkout, and a map drawn while another drain
+	// rewrites the files describes a tree that never existed, so it is a
+	// Tree-stable operation like Refine (ADR-0238).
+	if !opts.checkoutHeld {
+		hold, err := AcquireTreeStable(d, opts.RuntimePath, opts.SetID, opts.Output, opts.admission)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = hold.Release() }()
+	}
+	// The work SHA is read before the Explorer runs: it is the tree the report
+	// describes, and the header states it so the report's age is readable.
+	workSHA := verifyWorkSHA(d, opts.RuntimePath)
+	body, agent, err := runExplorer(d, cfg, opts, m, workSHA)
+	if err != nil {
+		return nil, err
+	}
+	at := d.Now().UTC()
+	doc := exploreReport.renderDocument(at, opts.SetID, workSHA, "", agent, body)
+	path := filepath.Join(m.Dir, ExplorationFileName)
+	_, replaced := d.FS.Stat(path)
+	// Atomic, so a write cut short cannot leave half a map where a whole one was.
+	if err := WriteAtomicWith(d, path, []byte(doc), 0o644); err != nil {
+		return nil, exitErr(ExitOperational, "write exploration report: %v", err)
+	}
+	printExploreWritten(opts.Output, opts.SetID, path, replaced == nil)
+	return &ExploreResult{SetID: opts.SetID, WorkSHA: workSHA, Path: path, Body: doc}, nil
+}
+
+// explorationReportPath is where a set's Exploration report sits, and false when
+// the set has never been explored. Prompts carry only this path, never the body.
+func explorationReportPath(d *Deps, setDir string) (string, bool) {
+	path := filepath.Join(setDir, ExplorationFileName)
+	if _, err := d.FS.Stat(path); err != nil {
+		return "", false
+	}
+	return path, true
+}
+
+// runExplorer builds the prompt and invokes the Explorer, returning the
+// document and the agent that wrote it.
+func runExplorer(d *Deps, cfg *config.Config, opts exploreCoreOptions, m *Manifest, workSHA string) (string, string, error) {
+	text := buildExplorerPrompt(d, m, workSHA)
+	run := opts.runExplorer
+	if run == nil {
+		sel, err := resolveExplorer(opts.Agents, opts.Effort, m, cfg)
+		if err != nil {
+			return "", "", err
+		}
+		run = func(prompt string) (string, string, error) {
+			return runConfiguredExplorer(d, cfg, sel, m.Dir, opts.SetID, workSHA, opts.RuntimePath, prompt, opts.Output, opts.Timeout, opts.probeMemo)
+		}
+	}
+	body, agent, err := run(text)
+	if err != nil {
+		return "", "", err
+	}
+	if strings.TrimSpace(body) == "" {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", opts.SetID)
+	}
+	return body, agent, nil
+}
+
+// resolveExplorer applies the Explorer precedence chain, highest first: CLI
+// flags → the set's `explorer` directive → [work.implement].agents /
+// DefaultExploreEffort. Agents and effort resolve independently, the way the
+// Refiner's do. The Explorer has no Work group of its own, so the implement
+// list is its fallthrough.
+func resolveExplorer(cliAgents []string, cliEffort string, m *Manifest, cfg *config.Config) (verifierSelection, error) {
+	agents := nonEmptyStrings(cliAgents)
+	effort := strings.TrimSpace(cliEffort)
+	if over := m.ExplorerOverride(); over != nil {
+		if len(agents) == 0 {
+			agents = nonEmptyStrings(over.Agents)
+		}
+		if effort == "" {
+			effort = strings.TrimSpace(over.Effort)
+		}
+	}
+	if len(agents) == 0 {
+		agents = ResolveDefaultAgentPresets(nil, "", false, cfg)
+	}
+	if effort == "" {
+		effort = DefaultExploreEffort
+	}
+	return verifierSelection{Agents: agents, Effort: effort}, nil
+}
+
+// runConfiguredExplorer walks the resolved Explorer agent list through the
+// shared fallback walk and returns the report beside the agent that wrote it.
+// Its cap and retry schedule are the built-in task defaults, the Refiner's
+// own: a pass that cannot produce a report this time costs nothing to ask for
+// again.
+func runConfiguredExplorer(d *Deps, cfg *config.Config, sel verifierSelection, taskSetDir, setID, workSHA, runtimePath, prompt string, out io.Writer, timeout time.Duration, probeMemo *agentAvailabilityProbeMemo) (string, string, error) {
+	if timeout <= 0 {
+		timeout = DefaultAttemptTimeout
+	}
+	quotaRetryAfter, err := resolveAgentQuotaRetryAfter(cfg)
+	if err != nil {
+		return "", "", exitErr(ExitSetup, "%v", err)
+	}
+	walked, err := runAgentFallbackWalk(d, agentFallbackWalk{
+		role:            explorerRole(d, out, taskSetDir, setID, workSHA),
+		sel:             sel,
+		setID:           setID,
+		runtimePath:     runtimePath,
+		prompt:          prompt,
+		out:             out,
+		errOut:          out,
+		timeout:         timeout,
+		maxTries:        config.DefaultTaskMaxTries,
+		retryDelays:     append([]time.Duration(nil), config.DefaultTaskAttemptRetryDelays...),
+		quotaRetryAfter: quotaRetryAfter,
+		cfg:             cfg,
+		probeMemo:       probeMemo,
+	})
+	if err != nil {
+		return "", "", err
+	}
+	// Prose from an attempt that timed out or died is half a map, and writing it
+	// would replace a whole earlier report with it.
+	if strings.TrimSpace(walked.Answer) != "" && !walked.AnswerRetryEligible {
+		return walked.Answer, walked.Agent, nil
+	}
+	if len(walked.Unavailable) == 0 {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report")
+	}
+	return "", "", exitErr(ExitSetup, "%s", formatHumanHealingExhaustionMessage(walked.Unavailable))
+}
+
+// explorerRole is what the shared fallback walk calls the Explorer: its name
+// in the operator's output, the Captured run each invocation is filed as under
+// the `explore` phase, and the Refiner's retry rule, since a report has no
+// format to parse either. It is the one role spawned read-only (ADR-0221): the
+// Explorer describes the checkout and never changes it.
+func explorerRole(d *Deps, errOut io.Writer, taskSetDir, setID, workSHA string) agentRole {
+	return agentRole{
+		Noun:   "Explorer agent",
+		Gerund: "Exploring",
+		Phase:  spendPhaseExplore,
+		Persist: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int) {
+			_ = persistSetLevelRun(d, errOut, taskSetDir, spendPhaseExplore, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode, "")
+		},
+		PersistAnswer: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int, answer string) {
+			_ = persistSetLevelRun(d, errOut, taskSetDir, spendPhaseExplore, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode, "")
+		},
+		PersistSkipped: func(rec *streamRecorder, invocation *AgentInvocation, model string, try int, reason string, exitCode int) {
+			_ = persistSetLevelRun(d, errOut, taskSetDir, spendPhaseExplore, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, model, try, streamOutcomeModelSkipped, reason, exitCode, "")
+		},
+		RetryEligible: refineAttemptRetryEligible,
+		ReadOnly:      true,
+	}
+}
+
+// printExploreWritten tells the operator where the report went and how to
+// read it.
+func printExploreWritten(w io.Writer, setID, path string, replaced bool) {
+	if w == nil {
+		return
+	}
+	out := outputFor(w)
+	out.line(ansiBold, "━━ Explore for %s", setID)
+	out.line(ansiDim, "   Document: %s", path)
+	if replaced {
+		out.line(ansiDim, "   Replaces the previous report.")
+	}
+	out.line(ansiDim, "   Read it: pop tasks artifacts %s --show %s", setID, ExplorationFileName)
+}
+
+// buildExplorerPrompt assembles the Explorer's prompt: the set's manifest
+// listing, every task body and the spec when there is one, then the shape of
+// the report. It hands over no diff — nothing is built yet — and the Explorer
+// reads the code in the checkout it stands in.
+func buildExplorerPrompt(d *Deps, m *Manifest, workSHA string) string {
+	view := explorerPromptView{
+		TaskSet: m.Stem,
+		WorkSHA: ShortSHA(workSHA),
+		Tasks:   gateTaskRows(m),
+	}
+	for _, task := range m.Tasks {
+		view.Bodies = append(view.Bodies, explorerTaskBody{
+			ID:   task.ID,
+			Body: readTaskBody(d, filepath.Join(m.Dir, task.File)),
+		})
+	}
+	if spec, ok := readSpec(d, m); ok {
+		view.SpecRecorded = true
+		view.Spec = spec
+	}
+	return prompt.MustRender(promptTemplates, "explorer.tmpl.md", view)
+}
+
+// explorerPromptView is what the Explorer's template renders against. An empty
+// WorkSHA means pop could not read the checkout's HEAD, and the template then
+// asks the Explorer to name the tree itself.
+type explorerPromptView struct {
+	TaskSet      string
+	WorkSHA      string
+	Tasks        []taskRow
+	Bodies       []explorerTaskBody
+	SpecRecorded bool
+	Spec         string
+}
+
+// explorerTaskBody is one task's body under its id. The Explorer reads every
+// task, whatever its status: the map is for the whole set.
+type explorerTaskBody struct {
+	ID   string
+	Body taskBodyRow
+}
diff --git a/tasks/explore_mark.go b/tasks/explore_mark.go
new file mode 100644
index 00000000..2522f6e0
--- /dev/null
+++ b/tasks/explore_mark.go
@@ -0,0 +1,183 @@
+package tasks
+
+import (
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/work"
+)
+
+// ExploreMark is whether a set that asked for exploration got its Exploration
+// report, carried beside its status and its Verification mark rather than inside
+// either (ADR-0262). A set the Explore phase has not mapped can still be READY,
+// DONE or anything else, so the status slot cannot also hold this answer.
+//
+// It is an alias of work.ExploreMark so a Work container can carry the cell
+// without `work` importing this package, exactly as VerifyMark is.
+// ResolveExploreMark is the one place that derives it.
+type ExploreMark = work.ExploreMark
+
+const (
+	// ExploreMarkNone is the absent mark: the set never asked to be explored.
+	ExploreMarkNone ExploreMark = ""
+	// ExploreMarkExplored is a set whose Exploration report is on disk.
+	ExploreMarkExplored ExploreMark = "explored"
+	// ExploreMarkUnexplored is a set that asked and has no report. The reason
+	// beside it says where the work stopped.
+	ExploreMarkUnexplored ExploreMark = "unexplored"
+)
+
+// UnexploredReason is why an unexplored set has no report — the detail beside
+// the mark, never a second mark.
+type UnexploredReason = work.UnexploredReason
+
+const (
+	// UnexploredReasonNone is the absent reason: the set is explored, or carries
+	// no mark at all.
+	UnexploredReasonNone UnexploredReason = ""
+	// UnexploredNotYetRun is a set no Explore pass has ended for: none ran, or a
+	// human interrupted the last one, which says nothing about whether it can
+	// succeed.
+	UnexploredNotYetRun UnexploredReason = "not-yet-run"
+	// UnexploredFailed is a set whose last Explore pass ended without writing the
+	// report. On a READY set this is also the Explore park.
+	UnexploredFailed UnexploredReason = "failed"
+)
+
+// ExploreResolution is what the read-side resolution answers for one set: the
+// mark every surface displays and, when the mark is unexplored, the reason
+// riding beside it.
+type ExploreResolution struct {
+	Mark ExploreMark
+	// Reason is why the set has no report, blank unless Mark is
+	// ExploreMarkUnexplored.
+	Reason UnexploredReason
+}
+
+// ResolveExploreMark is the single read-side Explore mark resolution.
+// buildRefreshResult stamps it on every row beside the Explore park it also
+// decides, so the Work dashboard, `pop work status` and `pop tasks status` read
+// one answer; the set detail and the sign-off gate ask here directly.
+func ResolveExploreMark(d *Deps, m *Manifest) ExploreResolution {
+	res, _ := resolveExplore(d, m)
+	return res
+}
+
+// resolveExplore is ResolveExploreMark plus the last explore run behind an
+// UnexploredFailed answer, which the park words its reason from. It stores
+// nothing: the report on disk and the set's Captured runs of phase `explore`
+// are the whole input.
+func resolveExplore(d *Deps, m *Manifest) (ExploreResolution, capturedRunMeta) {
+	if m == nil || !m.ExploreRequested() {
+		return ExploreResolution{}, capturedRunMeta{}
+	}
+	if d == nil {
+		d = defaultDeps
+	}
+	if _, ok := explorationReportPath(d, m.Dir); ok {
+		return ExploreResolution{Mark: ExploreMarkExplored}, capturedRunMeta{}
+	}
+	run, ok := latestSetLevelRun(d, m, spendPhaseExplore)
+	if !ok || run.Outcome == streamOutcomeInterrupted {
+		return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredNotYetRun}, capturedRunMeta{}
+	}
+	return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredFailed}, run
+}
+
+// applyExploreResolution stamps each row's Explore mark and turns each parked
+// READY row into EXPLORE-FAILED, from one resolution per set.
+func applyExploreResolution(d *Deps, rows []Row, manifests map[string]*Manifest) {
+	for i := range rows {
+		res, run := resolveExplore(d, manifests[rows[i].ID])
+		rows[i].ExploreMark = res.Mark
+		rows[i].UnexploredReason = res.Reason
+		if park := explorePark(rows[i].Status, res, run); park.Parked {
+			rows[i].Status = StatusExploreFailed
+			rows[i].ExploreFailedReason = park.Reason
+		}
+	}
+}
+
+// exploreMarkCellText is the mark as a status cell carries it: lower-case, the
+// reason after a colon. A row whose status is EXPLORE-FAILED gets nothing,
+// because the status already says it and a second phrase would read as a second
+// fact.
+func exploreMarkCellText(status TaskSetStatus, res ExploreResolution) string {
+	if status == StatusExploreFailed {
+		return ""
+	}
+	return strings.ToLower(exploreMarkPhrase(res))
+}
+
+// exploreMarkTone is the attention the mark asks for: a report is good, a pass
+// that has not run yet waits, and a pass that failed is bad.
+func exploreMarkTone(res ExploreResolution) work.StatusTone {
+	switch {
+	case res.Mark == ExploreMarkExplored:
+		return work.ToneGood
+	case res.Reason == UnexploredFailed:
+		return work.ToneBad
+	default:
+		return work.ToneWarn
+	}
+}
+
+// exploreMarkPhrase is the mark as a human reads it, in the one wording every
+// surface uses.
+func exploreMarkPhrase(res ExploreResolution) string {
+	switch {
+	case res.Mark == ExploreMarkExplored:
+		return "Explored"
+	case res.Mark != ExploreMarkUnexplored:
+		return ""
+	case res.Reason == UnexploredFailed:
+		return "Unexplored: the pass failed"
+	}
+	return "Unexplored: not yet run"
+}
+
+// ExploreSectionTitle heads the exploration lines in a set's detail view.
+const ExploreSectionTitle = "Exploration"
+
+// ExploreDetailLines is what a set's detail view says about exploration: the
+// mark, and the report as a pointer — its path and the tree it records, never
+// its body. `pop tasks status <set>` and the Work dashboard's detail section
+// both print these lines. A set that never asked carries no mark, but a report
+// a hand run wrote for it is still pointed at.
+func ExploreDetailLines(d *Deps, m *Manifest, res ExploreResolution) []string {
+	var lines []string
+	if phrase := exploreMarkPhrase(res); phrase != "" {
+		lines = append(lines, phrase)
+	}
+	if p, ok := explorationPointer(d, m); ok {
+		lines = append(lines, p.Summary())
+	}
+	return lines
+}
+
+// explorationPointer is the set's Exploration report on the shared pointer
+// shape. The report is flat, so the instant comes from its own header rather
+// than a timestamped file name; false when the set has no report.
+func explorationPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ReportPointer{}, false
+	}
+	path, ok := explorationReportPath(d, m.Dir)
+	if !ok {
+		return ReportPointer{}, false
+	}
+	p := ReportPointer{Label: exploreReport.PointerLabel, Path: path}
+	// An unreadable report still has a path worth pointing at.
+	if data, err := d.FS.ReadFile(path); err == nil {
+		body := string(data)
+		p.WorkSHA = reportHeaderField(body, "Work SHA")
+		p.Written = reportHeaderField(body, exploreReport.WrittenLabel)
+		if at, err := time.Parse(time.RFC3339, p.Written); err == nil {
+			p.Written = at.UTC().Format("2006-01-02 15:04Z")
+		}
+	}
+	return p, true
+}
diff --git a/tasks/explore_mark_test.go b/tasks/explore_mark_test.go
new file mode 100644
index 00000000..6e8e7495
--- /dev/null
+++ b/tasks/explore_mark_test.go
@@ -0,0 +1,137 @@
+package tasks
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// exploreProse is the one string no surface may print: the report's body.
+const exploreProse = "SECRET-EXPLORE-PROSE"
+
+// seedExplorationReport writes the set's Exploration report as the Explorer
+// would have, and returns its path.
+func seedExplorationReport(t *testing.T, setDir string) string {
+	t.Helper()
+	at := time.Date(2026, 9, 7, 9, 30, 0, 0, time.UTC)
+	body := exploreReport.renderDocument(at, "demo", "abc123abc123", "", "claude", "## Where things live\n\n"+exploreProse)
+	path := filepath.Join(setDir, ExplorationFileName)
+	if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+// statusTable is `pop tasks status` as a human reads it.
+func (f *parkFixture) statusTable() string {
+	f.t.Helper()
+	d := f.env.deps()
+	refresh, err := RefreshWith(d, f.env.tasksDir, DefaultStatePathWith(d))
+	if err != nil {
+		f.t.Fatalf("refresh: %v", err)
+	}
+	var out bytes.Buffer
+	Render(&out, refresh)
+	return out.String()
+}
+
+// TestExploreMarkSaysWhereTheWorkStopped walks one declared set through every
+// state the mark can name, reading the row the refresh resolves and the
+// `pop tasks status` table that renders it.
+func TestExploreMarkSaysWhereTheWorkStopped(t *testing.T) {
+	t.Parallel()
+	f := newParkFixture(t)
+
+	if row := f.row(); row.ExploreMark != ExploreMarkUnexplored || row.UnexploredReason != UnexploredNotYetRun {
+		t.Fatalf("fresh row mark = %q/%q, want unexplored/not-yet-run", row.ExploreMark, row.UnexploredReason)
+	}
+	if table := f.statusTable(); !strings.Contains(table, "unexplored: not yet run") {
+		t.Fatalf("status table does not mark the unexplored set:\n%s", table)
+	}
+
+	// Parked: the status says it, so the mark adds no second phrase.
+	f.drain(false)
+	if row := f.row(); row.Status != StatusExploreFailed || row.UnexploredReason != UnexploredFailed {
+		t.Fatalf("parked row = %s %q, want EXPLORE-FAILED with the failed reason", row.Status, row.UnexploredReason)
+	}
+	if table := f.statusTable(); strings.Contains(table, "unexplored") {
+		t.Fatalf("status table repeats the park as a mark:\n%s", table)
+	}
+
+	// Drained once unexplored: the status moved on, and the mark keeps the reason.
+	f.drain(true)
+	if table := f.statusTable(); !strings.Contains(table, "unexplored: the pass failed") {
+		t.Fatalf("status table lost the failed pass once the set was DONE:\n%s", table)
+	}
+
+	path := seedExplorationReport(t, f.setDir)
+	if row := f.row(); row.ExploreMark != ExploreMarkExplored || row.UnexploredReason != UnexploredReasonNone {
+		t.Fatalf("row with a report = %q/%q, want explored", row.ExploreMark, row.UnexploredReason)
+	}
+	if table := f.statusTable(); !strings.Contains(table, "explored") || strings.Contains(table, "unexplored") {
+		t.Fatalf("status table does not mark the explored set:\n%s", table)
+	}
+
+	var detail bytes.Buffer
+	RenderTaskSetDetail(f.env.deps(), nil, &detail, "demo", nil, LoadManifest(f.env.deps(), "demo", filepath.Join(f.setDir, "index.json")))
+	for _, want := range []string{"Explored", path, "abc123a", "2026-09-07 09:30Z"} {
+		if !strings.Contains(detail.String(), want) {
+			t.Fatalf("detail view missing %q:\n%s", want, detail.String())
+		}
+	}
+	if strings.Contains(detail.String(), exploreProse) {
+		t.Fatalf("detail view printed the report body:\n%s", detail.String())
+	}
+}
+
+// TestSetThatNeverAskedCarriesNoExploreMark: no mark appears for a set without
+// the directive, even with a report a hand run wrote on disk. That report is
+// still pointed at, so only the mark's own words are refused.
+func TestSetThatNeverAskedCarriesNoExploreMark(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	seedExplorationReport(t, m.Dir)
+
+	if res := ResolveExploreMark(d, m); res != (ExploreResolution{}) {
+		t.Fatalf("resolution = %+v, want none", res)
+	}
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, nil, &detail, "demo", nil, m)
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	for surface, text := range map[string]string{"detail view": detail.String(), "gate": gate} {
+		if strings.Contains(text, "Explored") || strings.Contains(text, "nexplored") {
+			t.Fatalf("%s marked a set that never asked:\n%s", surface, text)
+		}
+	}
+}
+
+// TestGateNamesTheExplorationReport: the sign-off gate names the report beside
+// the refine one, as a pointer, and pages it without running an agent.
+func TestGateNamesTheExplorationReport(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	m.Unknown = map[string]json.RawMessage{ExploreKey: json.RawMessage("true")}
+
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	if !strings.Contains(gate, "🧭 Unexplored: not yet run") || strings.Contains(gate, "Read the exploration report") {
+		t.Fatalf("gate for an unexplored set:\n%s", gate)
+	}
+
+	path := seedExplorationReport(t, m.Dir)
+	gate, _ = hitlGateOutput(t, d, m, "0\n")
+	for _, want := range []string{"🧭 Explored · Exploration of abc123a", path, "Read the exploration report (no agent runs)"} {
+		if !strings.Contains(gate, want) {
+			t.Fatalf("gate missing %q:\n%s", want, gate)
+		}
+	}
+	if strings.Contains(gate, exploreProse) {
+		t.Fatalf("gate printed the report body:\n%s", gate)
+	}
+	if _, action := hitlGateOutput(t, d, m, "5\n"); action != hitlGateReadExplore {
+		t.Fatalf("menu entry 5 = %v, want hitlGateReadExplore", action)
+	}
+}
diff --git a/tasks/explore_park.go b/tasks/explore_park.go
new file mode 100644
index 00000000..92e6fe83
--- /dev/null
+++ b/tasks/explore_park.go
@@ -0,0 +1,64 @@
+package tasks
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ExplorePark is whether a set sits at EXPLORE-FAILED, and why (ADR-0262
+// decision 6). It is derived, never stored: a Captured run of phase `explore`
+// says a pass ran, and the absence of the Exploration report says it did not
+// produce one.
+type ExplorePark struct {
+	Parked bool
+	// Reason is how the pass's last attempt ended, blank unless Parked.
+	Reason string
+}
+
+// ResolveExplorePark is the single read-side Explore park resolution. Every
+// surface reads a set's status from Refresh rows, and buildRefreshResult decides
+// each row's park by the same explorePark rule, so `pop tasks status`, the Work
+// dashboard, the daemon scan and the drain's own Explore step cannot disagree
+// about a park.
+//
+// The park is the Explore mark's failed reason on a READY set. Only a READY set
+// parks: the park exists because a set that could not be explored still has an
+// eligible AFK task and would otherwise derive READY, be re-selected and
+// re-explored forever; a set with no eligible task stops on its own status. So a
+// set that `--skip-explore` drained to DONE has left the park behind.
+//
+// Each door out of the park is one of the mark's inputs: a pass that writes the
+// report (`pop tasks explore`) and a retracted declaration (`"explore": false`)
+// both clear it. An interrupted last attempt does not park: the human stopped
+// the pass, which says nothing about whether it can succeed.
+func ResolveExplorePark(d *Deps, m *Manifest) ExplorePark {
+	res, run := resolveExplore(d, m)
+	return explorePark(DeriveStatus(m), res, run)
+}
+
+// explorePark decides the park from a set's status and its Explore mark.
+func explorePark(status TaskSetStatus, res ExploreResolution, run capturedRunMeta) ExplorePark {
+	if status != StatusReady || res.Reason != UnexploredFailed {
+		return ExplorePark{}
+	}
+	return ExplorePark{Parked: true, Reason: exploreParkReason(run)}
+}
+
+// exploreParkReason is the last attempt's ending in words. A run that ended
+// cleanly and still parked the set is one whose answer was empty.
+func exploreParkReason(run capturedRunMeta) string {
+	if run.Outcome == streamOutcomeCompleted {
+		return "the Explorer produced no report"
+	}
+	ending := strings.ReplaceAll(run.Outcome, "_", " ")
+	if reason := strings.TrimSpace(run.Reason); reason != "" {
+		return fmt.Sprintf("the Explorer's last attempt %s: %s", ending, reason)
+	}
+	return fmt.Sprintf("the Explorer's last attempt %s", ending)
+}
+
+// exploreParkDoors is the three ways out of the park, in the words every
+// surface prints them with.
+func exploreParkDoors(setID string) string {
+	return fmt.Sprintf("explore: pop tasks explore %s · drain once unexplored: pop tasks implement %s --skip-explore · or set \"%s\": false", setID, setID, ExploreKey)
+}
diff --git a/tasks/explore_phase.go b/tasks/explore_phase.go
new file mode 100644
index 00000000..0d599409
--- /dev/null
+++ b/tasks/explore_phase.go
@@ -0,0 +1,111 @@
+package tasks
+
+import "fmt"
+
+// exploreDirective is the instruction explorePhase hands back to the drain
+// loop, in the shape of the loop's other phase directives.
+type exploreDirective int
+
+const (
+	// exploreProceed goes on to the loop's first task selection: the set needed
+	// no pass, already had its report, or the pass has just written one.
+	exploreProceed exploreDirective = iota
+	// exploreReturn hands the run's result and the returned error back to the
+	// caller: the human interrupted the Explorer, the set is parked at
+	// EXPLORE-FAILED, or the pass failed before any attempt could park it.
+	exploreReturn
+)
+
+// explorePhase runs the drain's Explore step (ADR-0262): a set that declared
+// `"explore": true` and has no Exploration report gets one from a fresh
+// Explorer before its first task is selected, so every builder in the set
+// starts from the same map.
+//
+// It runs at most once per drain, and only on a declared set — the declaration
+// is what makes [work.explore] safe to default on. Presence is the whole test:
+// a report already there is reused whatever commit it describes, because an
+// implement attempt commits and a SHA-exact rule would re-explore after every
+// task. The SHA the report records is for a human to read, never for pop.
+//
+// A human-completed set is skipped, as the refine step skips it: the drain does
+// not open new agent work on a set a human declared done. `pop tasks explore`
+// still explores one on request.
+//
+// It is the one agent phase that gates (ADR-0262 decision 5). A pass that spends
+// its retry cap without a report parks the set at EXPLORE-FAILED and stops the
+// drain, since building on would hand the builders separate maps. A set already
+// parked is not explored again — that is what keeps the daemon from looping on
+// it — and `--skip-explore` drains it this once with no pass at all.
+func (r *implementRun) explorePhase() (exploreDirective, error) {
+	if r.opts.SkipExplore {
+		return exploreProceed, nil
+	}
+	cfg := r.plan.cfg
+	if !cfg.ExploreEnabled() {
+		return exploreProceed, nil
+	}
+	m, err := loadVerifiableManifest(r.d, verifyCoreOptions{SetID: r.taskSetID, DefPath: r.resolved.DefinitionPath})
+	if err != nil {
+		// The loop's own Refresh reports a set it cannot read; this step has
+		// nothing to add to that.
+		return exploreProceed, nil
+	}
+	if m.HumanCompleted || !m.ExploreRequested() {
+		return exploreProceed, nil
+	}
+	if _, ok := explorationReportPath(r.d, m.Dir); ok {
+		return exploreProceed, nil
+	}
+	if park := ResolveExplorePark(r.d, m); park.Parked {
+		return exploreReturn, r.stopAtExplorePark(park)
+	}
+
+	_, err = exploreResolvedSet(r.d, cfg, exploreCoreOptions{
+		DefPath:     r.resolved.DefinitionPath,
+		RuntimePath: r.runtimePath,
+		SetID:       r.taskSetID,
+		Timeout:     r.timeout,
+		Output:      r.out,
+		probeMemo:   r.agentProbeMemo,
+		runExplorer: r.opts.exploreRunner,
+		// The drain is already holding this checkout for this set, so the pass
+		// runs inside that claim rather than asking for it again (ADR-0238).
+		checkoutHeld: true,
+	})
+	if err == nil {
+		return exploreProceed, nil
+	}
+	if isInterrupted(err) {
+		return exploreReturn, err
+	}
+	park := ResolveExplorePark(r.d, m)
+	if !park.Parked {
+		// No attempt was filed — no Explorer could start — so there is no run to
+		// park on, but the set still must not be built unexplored.
+		outputFor(r.out).line(ansiYellow, "━━ Explore did not run for %s: %v", r.taskSetID, err)
+		return exploreReturn, err
+	}
+	// The park itself is derived; this record is only so the why is readable in
+	// the set's progress without opening the Captured run. It is written here,
+	// where the park begins, and never by a drain that finds the set parked.
+	summary := fmt.Sprintf("Explore phase gave up: %s. Parked at %s; %s.", park.Reason, StatusExploreFailed, exploreParkDoors(r.taskSetID))
+	if err := AppendSetProgress(r.d, m.Dir, string(StatusExploreFailed), summary); err != nil {
+		return exploreReturn, exitErr(ExitOperational, "record explore park for task set %s: %v", r.taskSetID, err)
+	}
+	return exploreReturn, r.stopAtExplorePark(park)
+}
+
+// stopAtExplorePark ends the drain at the park the way the terminal-status
+// switch ends one at any other stop: the result says why, and the operator sees
+// the refreshed table or the one-line summary.
+func (r *implementRun) stopAtExplorePark(park ExplorePark) error {
+	r.result.TaskSetExploreFailed = true
+	r.result.ExploreFailedReason = park.Reason
+	refresh, err := RefreshWith(r.d, r.resolved.DefinitionPath, r.statePath)
+	if err != nil {
+		return exitErr(ExitOperational, "refresh after explore park: %v", err)
+	}
+	r.result.Refresh = refresh
+	finishRunTaskSet(r.out, r.opts.Yes, r.result)
+	return nil
+}
