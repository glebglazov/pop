+++ b/tasks/drain_explore_test.go
@@ -0,0 +1,378 @@
+package tasks
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// exploreSet is one open AFK task: the drain's first selection is a task to
+// build, which is what the Explore step has to come before.
+func exploreSet() []Task {
+	return []Task{{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"}}
+}
+
+// drainExplore drains a "demo" set written with setKeys under cfg, and returns
+// the order in which the Explorer and the builder ran beside the set directory.
+// preReport, when non-empty, is an Exploration report already on disk.
+func drainExplore(t *testing.T, setKeys map[string]any, cfg *config.Config, preReport string) (ran []string, setDir string) {
+	t.Helper()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreSet(), setKeys)
+	setDir = filepath.Join(env.tasksDir, "demo")
+	if preReport != "" {
+		writeTaskMD(t, setDir, ExplorationFileName, preReport)
+	}
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "built"})
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.exploreRunner = func(prompt string) (string, string, error) {
+		m := LoadManifest(env.deps(), "demo", filepath.Join(setDir, ManifestFileName))
+		ran = append(ran, "explore:"+string(m.Tasks[0].Status))
+		if !strings.Contains(prompt, "01-a") {
+			t.Errorf("explorer prompt does not list the set's task:\n%s", prompt)
+		}
+		return "## Where things live\n\n- `parser.go`", "claude", nil
+	}
+	result, err := RunTaskSetWith(env.deps(), nil, func(string) (*config.Config, error) { return cfg, nil }, opts)
+	if err != nil {
+		t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+	}
+	for _, c := range result.Completed {
+		ran = append(ran, "implement:"+c.Selection.TaskID)
+	}
+	return ran, setDir
+}
+
+// TestDrainExploresADeclaredSetOnceBeforeItsFirstTask drives a whole drain both
+// ways (ADR-0262): a declared set with no report is explored before its first
+// task is selected and keeps the report the pass wrote, and a declared set that
+// already has one reuses it — whatever commit it describes — and explores
+// nothing.
+func TestDrainExploresADeclaredSetOnceBeforeItsFirstTask(t *testing.T) {
+	t.Parallel()
+	declared := map[string]any{ExploreKey: true}
+
+	t.Run("no report", func(t *testing.T) {
+		t.Parallel()
+		ran, setDir := drainExplore(t, declared, nil, "")
+		if got := strings.Join(ran, ","); got != "explore:open,implement:01-a" {
+			t.Fatalf("ran = %s, want one explore pass before the task was built", got)
+		}
+		report, err := os.ReadFile(filepath.Join(setDir, ExplorationFileName))
+		if err != nil {
+			t.Fatalf("exploration report not written: %v", err)
+		}
+		if !strings.Contains(string(report), "`parser.go`") {
+			t.Fatalf("report does not carry the Explorer's answer:\n%s", report)
+		}
+	})
+
+	t.Run("report already there", func(t *testing.T) {
+		t.Parallel()
+		existing := "# Exploration report — demo\n\n- Work SHA: 000000000000\n\nthe old map\n"
+		ran, setDir := drainExplore(t, declared, nil, existing)
+		if got := strings.Join(ran, ","); got != "implement:01-a" {
+			t.Fatalf("ran = %s, want the task built with no explore pass", got)
+		}
+		report, err := os.ReadFile(filepath.Join(setDir, ExplorationFileName))
+		if err != nil || string(report) != existing {
+			t.Fatalf("report = %q (%v), want the existing one untouched", report, err)
+		}
+	})
+}
