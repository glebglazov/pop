new file mode 100644
index 00000000..1cab7655
--- /dev/null
+++ b/tasks/setkind/explore_section_test.go
@@ -0,0 +1,97 @@
+package setkind
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/deps"
+	"github.com/glebglazov/pop/tasks"
+	"github.com/glebglazov/pop/work"
+)
+
+const exploreSectionProse = "SECRET-EXPLORE-PROSE"
+
+// containerForExploredSet builds the container a refreshed row produces over
+// a real filesystem, the set directory holding report as exploration.md when
+// report is non-empty.
+func containerForExploredSet(t *testing.T, row tasks.Row, report string) (work.Container, string) {
+	t.Helper()
+	setDir := t.TempDir()
+	path := filepath.Join(setDir, tasks.ExplorationFileName)
+	if report != "" {
+		if err := os.WriteFile(path, []byte(report), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	m := &tasks.Manifest{Valid: true, Dir: setDir, Tasks: []tasks.Task{{ID: "01-a", File: "01-a.md", Type: "AFK", Status: "open"}}}
+	rows := []tasks.Row{row}
+	d := testDeps(t, rows)
+	real := deps.NewRealFileSystem()
+	d.Tasks.FS = &deps.MockFileSystem{
+		EvalSymlinksFunc: func(path string) (string, error) { return path, nil },
+		ReadDirFunc:      real.ReadDir,
+		ReadFileFunc:     real.ReadFile,
+		StatFunc:         real.Stat,
+	}
+	d.Refresh = func(string) (*tasks.RefreshResult, error) {
+		return &tasks.RefreshResult{Rows: rows, Manifests: map[string]*tasks.Manifest{"demo": m}}, nil
+	}
+	scan := scanFixture{Name: "pop", ProjectPath: "/repo/main", RuntimePath: "/repo/main", DefinitionPath: "/def", RepoKey: "repo-key"}
+	got, err := rowsForStatic(d, &config.Config{}, staticForScan(scan, "main", false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 {
+		t.Fatalf("containers = %+v, want one", got)
+	}
+	return got[0], path
+}
+
+func detailExploreSection(c work.Container) (work.Section, bool) {
+	for _, s := range c.DetailSections {
+		if s.Title == tasks.ExploreSectionTitle {
+			return s, true
+		}
+	}
+	return work.Section{}, false
+}
+
+// TestExploreMarkReachesTheDashboard: the row's one resolution becomes the
+// STATUS cell suffix the dashboard and `pop work status` print, and the detail
+// section carries the report as a pointer, never its body.
+func TestExploreMarkReachesTheDashboard(t *testing.T) {
+	report := "# Exploration report — demo\n\n- Explored: 2026-09-07T09:30:00Z\n- Work SHA: abc123a\n\n## Where things live\n\n" + exploreSectionProse + "\n"
+
+	explored, path := containerForExploredSet(t, tasks.Row{ID: "demo", Status: tasks.StatusReady, ExploreMark: tasks.ExploreMarkExplored}, report)
+	if cell := tasks.WorkRowStatusCell(explored); !strings.Contains(cell, "explored") || strings.Contains(cell, "unexplored") {
+		t.Fatalf("status cell = %q, want the explored mark", cell)
+	}
+	section, ok := detailExploreSection(explored)
+	if !ok {
+		t.Fatalf("detail sections = %+v, want an exploration section", explored.DetailSections)
+	}
+	for _, want := range []string{"Explored", path, "abc123a", "2026-09-07 09:30Z"} {
+		if !strings.Contains(section.Body, want) {
+			t.Fatalf("section missing %q:\n%s", want, section.Body)
+		}
+	}
+	if strings.Contains(section.Body, exploreSectionProse) {
+		t.Fatalf("section carries the report body:\n%s", section.Body)
+	}
+
+	unexplored, _ := containerForExploredSet(t, tasks.Row{ID: "demo", Status: tasks.StatusReady, ExploreMark: tasks.ExploreMarkUnexplored, UnexploredReason: tasks.UnexploredFailed}, "")
+	if cell := tasks.WorkRowStatusCell(unexplored); !strings.Contains(cell, "unexplored: the pass failed") {
+		t.Fatalf("status cell = %q, want the failed reason beside the mark", cell)
+	}
+
+	never, _ := containerForExploredSet(t, tasks.Row{ID: "demo", Status: tasks.StatusReady}, "")
+	if cell := tasks.WorkRowStatusCell(never); strings.Contains(cell, "xplored") {
+		t.Fatalf("status cell = %q, want no mark on a set that never asked", cell)
+	}
+	if _, ok := detailExploreSection(never); ok {
+		t.Fatalf("detail sections = %+v, want none for a set that never asked", never.DetailSections)
+	}
+}
