+// TestResolveExplorerPrecedence covers the Explorer chain, highest first: CLI
+// flags → the set's `explorer` directive → [work.implement].agents /
+// DefaultExploreEffort, with agents and effort resolving independently.
+func TestResolveExplorerPrecedence(t *testing.T) {
+	t.Parallel()
+	cfg := &config.Config{Work: &config.WorkConfig{
+		Implement: &config.ImplementConfig{Agents: config.AgentEntriesFromCommands("codex")},
+	}}
+	withExplorer := func(agents []string, effort string) *Manifest {
+		raw, err := json.Marshal(AgentDirective{Agents: agents, Effort: effort})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return &Manifest{Unknown: map[string]json.RawMessage{ExplorerKey: raw}}
+	}
+	tests := []struct {
+		name       string
+		cliAgents  []string
+		cliEffort  string
+		manifest   *Manifest
+		wantAgents []string
+		wantEffort string
+	}{
+		{name: "configured agents and default effort", manifest: &Manifest{}, wantAgents: []string{"codex"}, wantEffort: DefaultExploreEffort},
+		{name: "explorer directive overrides config", manifest: withExplorer([]string{"pi"}, "light"), wantAgents: []string{"pi"}, wantEffort: "light"},
+		{name: "CLI overrides the explorer directive", cliAgents: []string{"opencode"}, cliEffort: "standard", manifest: withExplorer([]string{"pi"}, "light"), wantAgents: []string{"opencode"}, wantEffort: "standard"},
+		{name: "agents and effort resolve independently", cliAgents: []string{"opencode"}, manifest: withExplorer(nil, "light"), wantAgents: []string{"opencode"}, wantEffort: "light"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			sel, err := resolveExplorer(tt.cliAgents, tt.cliEffort, tt.manifest, cfg)
+			if err != nil {
+				t.Fatalf("resolveExplorer: %v", err)
+			}
+			if strings.Join(sel.Agents, ",") != strings.Join(tt.wantAgents, ",") {
+				t.Fatalf("agents = %v, want %v", sel.Agents, tt.wantAgents)
+			}
+			if sel.Effort != tt.wantEffort {
+				t.Fatalf("effort = %q, want %q", sel.Effort, tt.wantEffort)
+			}
+		})
+	}
+}
+
+// scriptedExplorerRunner answers every Explorer invocation the same way — with
+// answer as its report, or with a failed exit when answer is empty — and plays
+// every registered fake builder, so a drain runs the real retry walk for the
+// pass and the real builder for the task.
+type scriptedExplorerRunner struct {
+	mu     sync.Mutex
+	answer string
+	calls  int
+}
+
+func (r *scriptedExplorerRunner) Run(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (int, error) {
+	proc, err := r.Start(ctx, dir, stdout, stderr, name, args...)
+	if err != nil {
+		return 1, err
+	}
+	return proc.Wait()
+}
+
+func (r *scriptedExplorerRunner) Start(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (*ManagedProcess, error) {
+	if _, _, ok := lookupFakeAgent(args); ok {
+		return fakeAwareRunner{}.Start(ctx, dir, stdout, stderr, name, args...)
+	}
+	proc := &ManagedProcess{done: make(chan waitResult, 1)}
+	if IsAgentAvailabilityProbeCommand(name, args) {
+		proc.done <- waitResult{}
+		return proc, nil
+	}
+	r.mu.Lock()
+	r.calls++
+	answer := r.answer
+	r.mu.Unlock()
+	if answer == "" {
+		proc.done <- waitResult{exitCode: 1}
+		return proc, nil
+	}
+	_, _ = io.WriteString(stdout, claudeRefineStream(answer)+"\n")
+	proc.done <- waitResult{}
+	return proc, nil
+}
+
+func (r *scriptedExplorerRunner) StartWithEnv(ctx context.Context, dir string, env []string, stdout, stderr io.Writer, name string, args ...string) (*ManagedProcess, error) {
+	return r.Start(ctx, dir, stdout, stderr, name, args...)
+}
+
+func (r *scriptedExplorerRunner) explorerCalls() int {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.calls
+}
+
+// parkFixture is a declared "demo" set whose Explorer always fails.
+type parkFixture struct {
+	t      *testing.T
+	env    *runTaskSetFixture
+	runner *scriptedExplorerRunner
+	agent  string
+	setDir string
+}
+
+func newParkFixture(t *testing.T) *parkFixture {
+	t.Helper()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreSet(), map[string]any{ExploreKey: true})
+	runner := &scriptedExplorerRunner{}
+	env.d.Runner = runner
+	env.d.LookPath = func(name string) (string, error) {
+		if name == "claude" {
+			return "/bin/claude", nil
+		}
+		return exec.LookPath(name)
+	}
+	return &parkFixture{
+		t:      t,
+		env:    env,
+		runner: runner,
+		agent:  writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "built"}),
+		setDir: filepath.Join(env.tasksDir, "demo"),
+	}
+}
+
+func (f *parkFixture) drain(skipExplore bool) *RunTaskSetResult {
+	f.t.Helper()
+	var buf bytes.Buffer
+	opts := f.env.runTaskSetOpts(true, f.agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.SkipExplore = skipExplore
+	result, err := RunTaskSetWith(f.env.deps(), nil, func(string) (*config.Config, error) { return nil, nil }, opts)
+	if err != nil {
+		f.t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+	}
+	return result
+}
+
+func (f *parkFixture) row() Row {
+	f.t.Helper()
+	d := f.env.deps()
+	refresh, err := RefreshWith(d, f.env.tasksDir, DefaultStatePathWith(d))
+	if err != nil {
+		f.t.Fatalf("refresh: %v", err)
+	}
+	row := findRow(refresh, "demo")
+	if row == nil {
+		f.t.Fatal("no demo row")
+	}
+	if id, _, err := SelectTaskSet(refresh, ""); err == nil && id == "demo" && row.Status != StatusReady {
+		f.t.Fatalf("automatic selection picked the %s set", row.Status)
+	}
+	return *row
+}
+
+func (f *parkFixture) parkRecords() int {
+	f.t.Helper()
+	data, _ := os.ReadFile(filepath.Join(f.setDir, ProgressFileName))
+	return strings.Count(string(data), "[set] "+string(StatusExploreFailed))
+}
+
+// TestDrainParksASetItCannotExplore drives the park end to end (ADR-0262
+// decisions 5 and 6): a pass that spends its retry cap parks the set at its own
+// status with one progress record and builds nothing, a parked set is neither
+// re-picked nor re-explored, and `--skip-explore` drains it once.
+func TestDrainParksASetItCannotExplore(t *testing.T) {
+	t.Parallel()
+	f := newParkFixture(t)
+
+	result := f.drain(false)
+	if !result.TaskSetExploreFailed || len(result.Completed) != 0 {
+		t.Fatalf("result = %+v, want a park with nothing built", result)
+	}
+	if got := f.runner.explorerCalls(); got != config.DefaultTaskMaxTries {
+		t.Fatalf("explorer attempts = %d, want the retry cap %d", got, config.DefaultTaskMaxTries)
+	}
+	row := f.row()
+	if row.Status != StatusExploreFailed || row.NextPick || row.ExploreFailedReason == "" {
+		t.Fatalf("row = %+v, want EXPLORE-FAILED with a reason and no NEXT pick", row)
+	}
+	data, _ := os.ReadFile(filepath.Join(f.setDir, ProgressFileName))
+	if f.parkRecords() != 1 || !strings.Contains(string(data), "Explore phase gave up: "+row.ExploreFailedReason) {
+		t.Fatalf("progress = %q, want one set-level record naming the phase and the reason", data)
+	}
+
+	// A drain that finds the set parked stops there and explores nothing.
+	result = f.drain(false)
+	if !result.TaskSetExploreFailed || len(result.Completed) != 0 {
+		t.Fatalf("second drain = %+v, want it stopped at the park", result)
+	}
+	if got := f.runner.explorerCalls(); got != config.DefaultTaskMaxTries {
+		t.Fatalf("explorer attempts after a second drain = %d, want no new pass", got)
+	}
+	if f.parkRecords() != 1 {
+		t.Fatalf("park records = %d, want still one", f.parkRecords())
+	}
+
+	// --skip-explore drains it once, unexplored and without parking again.
+	result = f.drain(true)
+	if result.TaskSetExploreFailed || len(result.Completed) != 1 {
+		t.Fatalf("skip-explore drain = %+v, want the task built", result)
+	}
+	if got := f.runner.explorerCalls(); got != config.DefaultTaskMaxTries || f.parkRecords() != 1 {
+		t.Fatalf("skip-explore drain explored (%d attempts) or parked (%d records)", got, f.parkRecords())
+	}
+	if _, err := os.Stat(filepath.Join(f.setDir, ExplorationFileName)); !os.IsNotExist(err) {
+		t.Fatalf("skip-explore drain wrote a report (stat err %v)", err)
+	}
+	if row := f.row(); row.Status != StatusDone {
+		t.Fatalf("status after the skip-explore drain = %s, want DONE", row.Status)
+	}
+}
+
+// TestExploreParkDoors pins the two doors that clear the park itself: a hand-run
+// pass that writes the report, and the author retracting the declaration.
+func TestExploreParkDoors(t *testing.T) {
+	t.Parallel()
+	parked := func(t *testing.T) *parkFixture {
+		f := newParkFixture(t)
+		f.drain(false)
+		if row := f.row(); row.Status != StatusExploreFailed {
+			t.Fatalf("status = %s, want EXPLORE-FAILED before the door", row.Status)
+		}
+		return f
+	}
+
+	t.Run("hand-run explore", func(t *testing.T) {
+		t.Parallel()
+		f := parked(t)
+		f.runner.answer = "the map"
+		_, err := ExploreTaskSetWith(f.env.deps(), nil, func(string) (*config.Config, error) { return nil, nil }, ExploreOptions{
+			ResolveInput: ResolveInput{CWD: f.env.root},
+			TaskSetID:    "demo",
+			Output:       io.Discard,
+		})
+		if err != nil {
+			t.Fatalf("explore: %v", err)
+		}
+		if row := f.row(); row.Status != StatusReady {
+			t.Fatalf("status = %s, want READY once the report is written", row.Status)
+		}
+	})
+
+	t.Run("retracted declaration", func(t *testing.T) {
+		t.Parallel()
+		f := parked(t)
+		writeManifestWithSetKeys(t, f.setDir, exploreSet(), map[string]any{ExploreKey: false})
+		if row := f.row(); row.Status != StatusReady {
+			t.Fatalf("status = %s, want READY once the set no longer asks to be explored", row.Status)
+		}
+	})
+}
