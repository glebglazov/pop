+// detailSections are the prose blocks above a set's item list: what exploration
+// left behind, then the Artifact summary.
+func detailSections(td *tasks.Deps, m *tasks.Manifest, row tasks.Row) []work.Section {
+	sections := exploreSection(td, m, row)
+	return append(sections, artifactSections(td, m)...)
+}
+
+// exploreSection carries the row's Explore mark and the report as a pointer —
+// the same lines `pop tasks status <set>` prints, from the resolution the row
+// already holds.
+func exploreSection(td *tasks.Deps, m *tasks.Manifest, row tasks.Row) []work.Section {
+	res := tasks.ExploreResolution{Mark: row.ExploreMark, Reason: row.UnexploredReason}
+	lines := tasks.ExploreDetailLines(td, m, res)
+	if len(lines) == 0 {
+		return nil
+	}
+	return []work.Section{{Title: tasks.ExploreSectionTitle, Body: strings.Join(lines, "\n")}}
+}
