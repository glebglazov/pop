+package cmd
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/glebglazov/pop/tasks"
+)
+
+// scriptedAgentRunner stands in for the agent binary: every command pop starts
+// runs the test's shell script instead, with pop's own argv after it, so the
+// whole spawn path — prompt spill, read-only argv, stream capture — is real up
+// to the process boundary. Availability probes answer healthy without
+// reaching the script.
+type scriptedAgentRunner struct {
+	script string
+}
+
+func (r scriptedAgentRunner) Run(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (int, error) {
+	proc, err := r.Start(ctx, dir, stdout, stderr, name, args...)
+	if err != nil {
+		return 1, err
+	}
+	return proc.Wait()
+}
+
+func (r scriptedAgentRunner) Start(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (*tasks.ManagedProcess, error) {
+	if tasks.IsAgentAvailabilityProbeCommand(name, args) {
+		return tasks.RealCommandRunner{}.Start(ctx, dir, stdout, stderr, "true")
+	}
+	return tasks.RealCommandRunner{}.Start(ctx, dir, stdout, stderr, "/bin/sh", append([]string{r.script, name}, args...)...)
+}
+
+// writeExplorerScript writes an agent that copies the prompt pop spilled for
+// it and its own argv beside the script, then answers with report as a claude
+// result stream and exits with exitCode.
+func writeExplorerScript(t *testing.T, dir, report string, exitCode int) string {
+	t.Helper()
+	result, err := json.Marshal(map[string]string{"type": "result", "subtype": "success", "result": report})
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "explorer.sh")
+	script := "#!/bin/sh\n" +
+		"printf '%s\\n' \"$*\" > " + filepath.Join(dir, "argv") + "\n" +
+		"PROMPT=$(printf '%s' \"$*\" | sed -n 's|.*Read the file \\([^ ]*\\) in full:.*|\\1|p' | head -1)\n" +
+		"cp \"$PROMPT\" " + filepath.Join(dir, "prompt") + "\n" +
+		"printf '%s\\n' '{\"type\":\"system\",\"subtype\":\"init\"}'\n" +
+		"printf '%s\\n' '" + string(result) + "'\n" +
+		"exit " + strconv.Itoa(exitCode) + "\n"
+	writeFileCmd(t, path, script)
+	return path
+}
+
+// setupExploreCmdFixture is a registered "demo" set with two tasks and a spec,
+// whose manifest declines exploration: a hand run explores it anyway.
+func setupExploreCmdFixture(t *testing.T) (td *tasks.Deps, setDir, agentDir string) {
+	t.Helper()
+	root, td := setupRunTaskCmdFixture(t)
+	resetTaskFlags()
+	t.Cleanup(resetTaskFlags)
+	setDir = runTaskCmdDemoDir(t, td, root)
+	writeFileCmd(t, filepath.Join(setDir, "01-a.md"), "## What to build\n\nTeach the parser the explore key.\n\n## Acceptance criteria\n\n- [ ] parsed\n")
+	writeFileCmd(t, filepath.Join(setDir, "02-b.md"), "## What to build\n\nRead the explore key in the drain.\n\n## Acceptance criteria\n\n- [ ] read\n")
+	writeFileCmd(t, filepath.Join(setDir, tasks.SpecFileName), "# Explore\n\nA set maps its code once.\n")
+	writeFileCmd(t, filepath.Join(setDir, tasks.ManifestFileName), `{"explore":false,"tasks":[`+
+		`{"id":"01-a","file":"01-a.md","title":"Parse","type":"AFK","status":"open"},`+
+		`{"id":"02-b","file":"02-b.md","title":"Drain","type":"AFK","status":"open","blocked_by":["01-a"]}]}`)
+	td.LookPath = func(file string) (string, error) { return "/mock/bin/" + file, nil }
+	td.RetryDelayWait = func(io.Writer, time.Duration) bool { return false }
+	agentDir = t.TempDir()
+	return td, setDir, agentDir
+}
+
+// `pop tasks explore` end to end: the command spawns a read-only Explorer on
+// the set's tasks and spec, the reply becomes exploration.md under a header
+// of facts, and the invocation is a Captured run on the set's own explore row
+// — on a set whose own key says it never explores.
+func TestTaskExploreWritesTheReportAndFilesItsRun(t *testing.T) {
+	td, setDir, agentDir := setupExploreCmdFixture(t)
+	td.Runner = scriptedAgentRunner{script: writeExplorerScript(t, agentDir, "## The code as found\n\n`tasks/manifest.go` parses keys.", 0)}
+
+	var out bytes.Buffer
+	if err := runTaskExploreWith(td, &out, "demo"); err != nil {
+		t.Fatalf("explore: %v\n%s", err, out.String())
+	}
+
+	prompt := readCmdFile(t, filepath.Join(agentDir, "prompt"))
+	for _, want := range []string{
+		"01-a [AFK open] Parse", "02-b [AFK open] Drain", "blocked_by: 01-a",
+		"Teach the parser the explore key.", "Read the explore key in the drain.",
+		"A set maps its code once.",
+		"names a path or a symbol", "about one page", "names the tree you observed",
+	} {
+		if !strings.Contains(prompt, want) {
+			t.Errorf("Explorer prompt lacks %q:\n%s", want, prompt)
+		}
+	}
+	if strings.Contains(strings.ToLower(prompt), "prior art") {
+		t.Errorf("the Explorer is asked nothing about prior art:\n%s", prompt)
+	}
+	if argv := readCmdFile(t, filepath.Join(agentDir, "argv")); !strings.Contains(argv, "--disallowedTools=Edit,Write,NotebookEdit") {
+		t.Errorf("the Explorer is spawned read-only, argv = %s", argv)
+	}
+
+	report := readCmdFile(t, filepath.Join(setDir, tasks.ExplorationFileName))
+	for _, want := range []string{
+		"# Exploration report — demo\n", "- Explored: ", "- Work SHA: ", "- Explorer: claude",
+		"## The code as found\n\n`tasks/manifest.go` parses keys.",
+	} {
+		if !strings.Contains(report, want) {
+			t.Errorf("report lacks %q:\n%s", want, report)
+		}
+	}
+	if entries, _ := os.ReadDir(filepath.Join(setDir, "explore")); len(entries) != 0 {
+		t.Errorf("the report is flat, yet an explore/ directory holds %d entries", len(entries))
+	}
+
+	explore := exploreStreamRow(t, td)
+	if len(explore.Attempts) != 1 || explore.Attempts[0].Timing.Outcome != "completed" {
+		t.Fatalf("explore row = %+v, want one completed attempt", explore)
+	}
+}
+
+// A second pass replaces the report; a pass that fails leaves the one there
+// untouched, though its spent attempts are still filed on the explore row.
+func TestTaskExploreReplacesTheReportAndAFailedPassKeepsIt(t *testing.T) {
+	td, setDir, agentDir := setupExploreCmdFixture(t)
+	path := filepath.Join(setDir, tasks.ExplorationFileName)
+	writeFileCmd(t, path, "# Exploration report — demo\n\nthe old map\n")
+
+	td.Runner = scriptedAgentRunner{script: writeExplorerScript(t, agentDir, "## The new map", 0)}
+	if err := runTaskExploreWith(td, &bytes.Buffer{}, "demo"); err != nil {
+		t.Fatalf("explore: %v", err)
+	}
+	replaced := readCmdFile(t, path)
+	if !strings.Contains(replaced, "## The new map") || strings.Contains(replaced, "the old map") {
+		t.Fatalf("a hand run replaces the report, got:\n%s", replaced)
+	}
+
+	td.Runner = scriptedAgentRunner{script: writeExplorerScript(t, agentDir, "## Half a ma", 1)}
+	if err := runTaskExploreWith(td, &bytes.Buffer{}, "demo"); err == nil {
+		t.Fatal("a pass whose every attempt failed reports an error")
+	}
+	if got := readCmdFile(t, path); got != replaced {
+		t.Fatalf("a failed pass changed the report:\n%s", got)
+	}
+	if explore := exploreStreamRow(t, td); len(explore.Attempts) != 4 {
+		t.Fatalf("explore attempts = %d, want the 1 completed plus the 3 failed", len(explore.Attempts))
+	}
+}
+
+func exploreStreamRow(t *testing.T, td *tasks.Deps) tasks.TaskStream {
+	t.Helper()
+	result, err := tasks.StreamWith(td, taskProjectDeps(), taskConfigLoad, tasks.StreamOptions{ResolveInput: taskResolveInput(), Target: "demo"})
+	if err != nil {
+		t.Fatalf("stream: %v", err)
+	}
+	for _, stream := range result.Tasks {
+		if stream.TaskID == "explore" {
+			return stream
+		}
+	}
+	t.Fatalf("no explore row among %+v", result.Tasks)
+	return tasks.TaskStream{}
+}
+
+func readCmdFile(t *testing.T, path string) string {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(data)
+}
