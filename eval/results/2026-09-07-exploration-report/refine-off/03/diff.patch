+// TestDrainExploresNothingUnasked: the step defaults on, so every way a drain
+// declines it is pinned — a set that never declared, a machine that switched
+// the group off, and a set a human completed.
+func TestDrainExploresNothingUnasked(t *testing.T) {
+	t.Parallel()
+	off := false
+	tests := []struct {
+		name    string
+		setKeys map[string]any
+		cfg     *config.Config
+	}{
+		{name: "never declared"},
+		{name: "declared false", setKeys: map[string]any{ExploreKey: false}},
+		{
+			name:    "config off",
+			setKeys: map[string]any{ExploreKey: true},
+			cfg:     &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Enabled: &off}}},
+		},
+		{name: "human completed", setKeys: map[string]any{ExploreKey: true, "human_completed": true}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			ran, setDir := drainExplore(t, tt.setKeys, tt.cfg, "")
+			if got := strings.Join(ran, ","); got != "implement:01-a" {
+				t.Fatalf("ran = %s, want the task built with no explore pass", got)
+			}
+			if _, err := os.Stat(filepath.Join(setDir, ExplorationFileName)); !os.IsNotExist(err) {
+				t.Fatalf("exploration report written for a set that was not to be explored (stat err %v)", err)
+			}
+		})
+	}
+}
