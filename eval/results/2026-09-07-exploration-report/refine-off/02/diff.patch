+// setupExploreFixture writes a "demo" set into a real checkout's task storage:
+// two tasks with bodies, a spec, a manifest carrying the given set keys, and an
+// earlier Exploration report the pass may replace.
+func setupExploreFixture(t *testing.T, setKeys map[string]any, runs ...scriptedRefineRun) (*Deps, *explorerRunner, exploreCoreOptions, string) {
+	t.Helper()
+	d := newTestDeps(t)
+	runner := &explorerRunner{scripted: scriptedRefineRunner{runs: runs}}
+	d.Runner = &probeNeutralRunner{inner: runner}
+	d.LookPath = func(string) (string, error) { return "/bin/claude", nil }
+
+	runtime := t.TempDir()
+	initExecutorGitRepo(t, runtime)
+	defPath := filepath.Join(t.TempDir(), "tasks")
+	setDir := filepath.Join(defPath, "demo")
+	tasks := []Task{
+		{ID: "01-a", File: "01-a.md", Title: "Report is an artifact", Type: "AFK", Status: TaskDone},
+		{ID: "02-b", File: "02-b.md", Title: "Explore by hand", Type: "AFK", Status: TaskOpen, BlockedBy: []string{"01-a"}},
+	}
+	writeManifestWithSetKeys(t, setDir, tasks, setKeys)
+	writeTaskMD(t, setDir, "01-a.md", "## What to build\n\nBODY-OF-TASK-ONE\n\n## Acceptance criteria\n\n- [x] ok\n")
+	writeTaskMD(t, setDir, "02-b.md", "## What to build\n\nBODY-OF-TASK-TWO\n\n## Acceptance criteria\n\n- [ ] ok\n")
+	writeTaskMD(t, setDir, SpecFileName, "# Spec\n\nSPEC-BODY\n")
+	writeTaskMD(t, setDir, ExplorationFileName, "OLD MAP\n")
+
+	opts := exploreCoreOptions{
+		DefPath:     defPath,
+		RuntimePath: runtime,
+		SetID:       "demo",
+		Agents:      []string{"claude"},
+		Output:      &bytes.Buffer{},
+	}
+	return d, runner, opts, setDir
+}
+
+func readExplorationReport(t *testing.T, setDir string) string {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(setDir, ExplorationFileName))
+	if err != nil {
+		t.Fatalf("read exploration report: %v", err)
+	}
+	return string(data)
+}
+
+// TestExploreByHandWritesTheReportAndFilesItsRun drives one hand-run pass end
+// to end on a set that declined exploration: what the Explorer is handed, the
+// report that replaces the old one, and the captured run it spent.
+func TestExploreByHandWritesTheReportAndFilesItsRun(t *testing.T) {
+	t.Parallel()
+	d, runner, opts, setDir := setupExploreFixture(t, map[string]any{"explore": false},
+		scriptedRefineRun{output: claudeRefineStream(`Observed at the work SHA with a clean checkout.\n\n## Where things live\n\n- tasks/explore.go: the pass.`)})
+
+	res, err := exploreResolvedSet(d, nil, opts)
+	if err != nil {
+		t.Fatalf("exploreResolvedSet: %v", err)
+	}
+
+	if len(runner.prompts) != 1 {
+		t.Fatalf("Explorer prompts = %d, want one fresh agent", len(runner.prompts))
+	}
+	prompt := runner.prompts[0]
+	for _, want := range []string{
+		"You are an Explorer",
+		"- 01-a [AFK done] Report is an artifact (" + filepath.Join(setDir, "01-a.md") + ")",
+		"- 02-b [AFK open] Explore by hand (" + filepath.Join(setDir, "02-b.md") + "); blocked_by: 01-a",
+		"BODY-OF-TASK-ONE",
+		"BODY-OF-TASK-TWO",
+		"SPEC-BODY",
+		"in the area these tasks touch",
+		"Every claim names a path or a symbol",
+		"about one page",
+		"states the tree you observed",
+	} {
+		if !strings.Contains(prompt, want) {
+			t.Fatalf("prompt missing %q:\n%s", want, prompt)
+		}
+	}
+	// The prior-art check stays in the builder's frame (ADR-0262 decision 7).
+	for _, forbidden := range []string{"prior art", "Before you hand-write mechanism", "composed form"} {
+		if strings.Contains(strings.ToLower(prompt), strings.ToLower(forbidden)) {
+			t.Fatalf("prompt asks about prior art (%q):\n%s", forbidden, prompt)
+		}
+	}
+	if !strings.Contains(strings.Join(runner.args[0], " "), "--disallowedTools=Edit,Write,NotebookEdit") {
+		t.Fatalf("Explorer spawned with its editing tools: %q", runner.args[0])
+	}
+
+	wantPath := filepath.Join(setDir, ExplorationFileName)
+	if res.Path != wantPath {
+		t.Fatalf("path = %q, want the flat %q", res.Path, wantPath)
+	}
+	body := readExplorationReport(t, setDir)
+	for _, want := range []string{
+		"# Exploration report — demo",
+		"- Explored: 2026-08-17T18:00:00Z",
+		"- Work SHA: " + ShortSHA(res.WorkSHA),
+		"- Explorer: claude",
+		"Observed at the work SHA with a clean checkout.",
+		"- tasks/explore.go: the pass.",
+	} {
+		if !strings.Contains(body, want) {
+			t.Fatalf("report missing %q:\n%s", want, body)
+		}
+	}
+	if strings.Contains(body, "OLD MAP") || res.WorkSHA == "" {
+		t.Fatalf("report did not replace the old one at a known tree (sha %q):\n%s", res.WorkSHA, body)
+	}
+	if _, err := os.Stat(filepath.Join(setDir, "explore")); !os.IsNotExist(err) {
+		t.Fatalf("a flat report grew a directory: %v", err)
+	}
+	if m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName)); !m.Valid {
+		t.Fatalf("an explored set reads malformed: %v", m.Errors)
+	}
+
+	runs, err := listSetRuns(d, setDir)
+	if err != nil {
+		t.Fatalf("listSetRuns: %v", err)
+	}
+	if len(runs) != 1 {
+		t.Fatalf("captured runs = %d, want the Explorer's one", len(runs))
+	}
+	meta := runs[0].meta
+	if meta.Phase != "explore" || meta.TaskFile != "" || meta.WorkSHA != res.WorkSHA || meta.Outcome != streamOutcomeCompleted {
+		t.Fatalf("run meta = %+v, want a completed set-level explore run at %s", meta, res.WorkSHA)
+	}
+	m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+	breakdown, err := buildSpendSetBreakdown(d, "demo", m, loadRateTableForSpend(d), nil)
+	if err != nil {
+		t.Fatalf("buildSpendSetBreakdown: %v", err)
+	}
+	if breakdown.ExploreRunCount != 1 || breakdown.ImplementRunCount != 0 || len(breakdown.Rows) != 1 || breakdown.Rows[0].TaskID != "explore" {
+		t.Fatalf("spend = explore %d / implement %d, rows %+v; want one explore row", breakdown.ExploreRunCount, breakdown.ImplementRunCount, breakdown.Rows)
+	}
+}
