diff --git a/cmd/tasks_explore_test.go b/cmd/tasks_explore_test.go
new file mode 100644
index 00000000..9ee993d2
--- /dev/null
+++ b/cmd/tasks_explore_test.go
@@ -0,0 +1,106 @@
+package cmd
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/tasks"
+)
+
+// writeFakeClaude puts a `claude` on PATH that answers every invocation with a
+// claude JSON stream carrying result, and records the instructions it was given.
+func writeFakeClaude(t *testing.T, dir, result string) string {
+	t.Helper()
+	argsLog := filepath.Join(dir, "args.log")
+	stream := `{"type":"system","subtype":"init"}` + "\n" +
+		`{"type":"result","subtype":"success","result":` + string(mustJSON(t, result)) + `}`
+	script := "#!/bin/sh\nprintf '%s\\n' \"$*\" >> '" + argsLog + "'\ncat <<'EOF'\n" + stream + "\nEOF\n"
+	if err := os.WriteFile(filepath.Join(dir, "claude"), []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	return argsLog
+}
+
+func mustJSON(t *testing.T, v any) []byte {
+	t.Helper()
+	data, err := json.Marshal(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+// TestTaskExploreWritesTheReportForAnySet drives `pop tasks explore` from the
+// command down: a set whose author declined exploration is still explored on
+// request, its report replaces the one there, and the run is filed under its
+// own phase.
+func TestTaskExploreWritesTheReportForAnySet(t *testing.T) {
+	// PATH stub — stays serial deliberately.
+	root, _, td := setupCmdRepoTest(t)
+	resetTaskFlags()
+	t.Cleanup(resetTaskFlags)
+	taskDefPath = cmdTasksDir(t, td, root)
+	taskRuntimePath = root
+	taskExploreTimeout = "1m"
+	taskExploreAgents = []string{"claude"}
+	t.Cleanup(func() { taskExploreTimeout, taskExploreAgents = "45m", nil })
+
+	bin := t.TempDir()
+	argsLog := writeFakeClaude(t, bin, "The checkout was clean.\n\n## Where things live\n\n- `cmd/tasks.go`: the verb.")
+	t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+
+	setDir := filepath.Join(taskDefPath, "demo")
+	if err := os.MkdirAll(setDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for name, body := range map[string]string{
+		tasks.ManifestFileName:    `{"explore":false,"tasks":[{"id":"01-a","file":"01-a.md","title":"A","type":"AFK","status":"open"}]}`,
+		"01-a.md":                 "## What to build\n\nTASK-BODY\n\n## Acceptance criteria\n\n- [ ] ok\n",
+		tasks.ExplorationFileName: "OLD MAP\n",
+	} {
+		if err := os.WriteFile(filepath.Join(setDir, name), []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	var out bytes.Buffer
+	if err := runTaskExploreWith(td, &out, "demo"); err != nil {
+		t.Fatalf("tasks explore: %v\n%s", err, out.String())
+	}
+
+	report, err := os.ReadFile(filepath.Join(setDir, tasks.ExplorationFileName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{"# Exploration report — demo", "- Work SHA: ", "- Explorer: claude", "- `cmd/tasks.go`: the verb."} {
+		if !strings.Contains(string(report), want) {
+			t.Fatalf("report missing %q:\n%s", want, report)
+		}
+	}
+	if strings.Contains(string(report), "OLD MAP") {
+		t.Fatalf("report was not replaced:\n%s", report)
+	}
+	if args, _ := os.ReadFile(argsLog); !strings.Contains(string(args), "--disallowedTools=Edit,Write,NotebookEdit") {
+		t.Fatalf("Explorer spawned with its editing tools:\n%s", args)
+	}
+
+	metas, err := filepath.Glob(filepath.Join(setDir, "streams", "runs", "*.meta.json"))
+	if err != nil || len(metas) != 1 {
+		t.Fatalf("captured runs = %v (%v), want the Explorer's one", metas, err)
+	}
+	var meta struct {
+		Phase   string `json:"phase"`
+		Outcome string `json:"outcome"`
+	}
+	data, err := os.ReadFile(metas[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(data, &meta); err != nil || meta.Phase != "explore" || meta.Outcome != "completed" {
+		t.Fatalf("captured run = %s (%v), want a completed explore run", data, err)
+	}
+}
