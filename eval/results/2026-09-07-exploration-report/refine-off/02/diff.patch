+package tasks
+
+import (
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/prompt"
+	"github.com/glebglazov/pop/project"
+)
+
+// DefaultExploreEffort is the model-strength tier the Explorer runs at when
+// neither a CLI flag nor the set's `explorer` directive names one: telling which
+// seam owns what and which invariants hold is judgment over code nobody has
+// summarised yet, the strongest tier's work, as refine and verification are.
+const DefaultExploreEffort = "heavy"
+
+// explorationReport is the Exploration report's header and render on the shared
+// pass-report machinery (ADR-0262). The report is flat — one exploration.md in
+// the set directory, rewritten whole — so it takes only the document render and
+// leaves the timestamped filing and newest-by-timestamp scan to the passes that
+// rerun.
+var explorationReport = passReport{
+	ArtifactType: ArtifactTypeExploration,
+	Title:        "Exploration report",
+	WrittenLabel: "Explored",
+	AgentLabel:   "Explorer",
+	Noun:         "explore",
+	PointerLabel: "Exploration",
+}
+
+// ExploreOptions configures a `pop tasks explore <set>` run.
+type ExploreOptions struct {
+	ResolveInput ResolveInput
+	// TaskSetID is the bare Task-set identifier to explore.
+	TaskSetID string
+	// Agents is the ordered CLI Explorer fallback list (`--agent`, repeatable).
+	// Empty ⇒ the set's `explorer` directive, then [work.explore].agents, then
+	// [work.implement].agents.
+	Agents []string
+	// Effort is the CLI Explorer effort override (`--effort`). Empty ⇒ the set's
+	// `explorer` directive, then [work.explore].effort, then DefaultExploreEffort.
+	Effort string
+	// Timeout bounds one Explorer attempt. Zero uses DefaultAttemptTimeout.
+	Timeout time.Duration
+	// Output receives the live agent stream and the run's chrome.
+	Output io.Writer
+	// Wait is the `--wait` / `--no-wait` tri-state for admission to the checkout
+	// (ADR-0239). The unset default waits at a terminal and refuses elsewhere.
+	Wait AdmissionWaitChoice
+	// ConfirmIn is the invocation's input, read only to tell a human at a
+	// terminal from a script when resolving Wait.
+	ConfirmIn io.Reader
+}
+
+// ExploreResult is the outcome of one explore pass.
+type ExploreResult struct {
+	SetID   string
+	WorkSHA string
+	// Path is the Exploration report written.
+	Path string
+	// Body is the document itself.
+	Body string
+}
+
+// exploreCoreOptions carries the already-resolved inputs to the core explore
+// routine, so tests can drive it without real path-resolution git calls.
+type exploreCoreOptions struct {
+	DefPath     string
+	RuntimePath string
+	SetID       string
+	Agents      []string
+	Effort      string
+	Timeout     time.Duration
+	Output      io.Writer
+	probeMemo   *agentAvailabilityProbeMemo
+	// admission is the policy the standalone Explorer acquires the checkout
+	// under (ADR-0238/0239).
+	admission AdmissionPolicy
+	// checkoutHeld says the caller already holds a claim on this checkout, so
+	// the pass takes nothing of its own.
+	checkoutHeld bool
+	// runExplorer returns the Explorer's report and the agent that wrote it. It
+	// replaces the real agent spawn in tests; nil runs the configured Explorer.
+	runExplorer func(prompt string) (string, string, error)
+}
+
+// ExploreTaskSet explores a set using default dependencies.
+func ExploreTaskSet(opts ExploreOptions) (*ExploreResult, error) {
+	return ExploreTaskSetWith(defaultDeps, project.DefaultDeps(), config.Load, opts)
+}
+
+// ExploreTaskSetWith is `pop tasks explore <set>` (ADR-0262): it resolves the
+// set, hands a fresh Explorer the set's manifest listing, its task bodies and
+// its spec, and writes what comes back as the set's Exploration report. A hand
+// run is the human re-opening the question, so it runs whatever the set's
+// `explore` key says and replaces a report already there.
+func ExploreTaskSetWith(d *Deps, pd *project.Deps, loadConfig func(string) (*config.Config, error), opts ExploreOptions) (*ExploreResult, error) {
+	resolved, err := ResolvePathsWith(d, pd, loadConfig, opts.ResolveInput)
+	if err != nil {
+		return nil, err
+	}
+	runtimePath, err := ResolveRuntimePathWith(d, resolved.ProjectPath, opts.ResolveInput.RuntimeOverride)
+	if err != nil {
+		return nil, err
+	}
+	cfg, _ := loadConfig(d.defaultConfigPath())
+	return exploreResolvedSet(d, cfg, exploreCoreOptions{
+		DefPath:     resolved.DefinitionPath,
+		RuntimePath: runtimePath,
+		SetID:       strings.TrimSpace(opts.TaskSetID),
+		Agents:      opts.Agents,
+		Effort:      opts.Effort,
+		Timeout:     opts.Timeout,
+		Output:      opts.Output,
+		admission:   opts.Wait.Policy(opts.ConfirmIn),
+	})
+}
+
+// exploreResolvedSet is the resolved-path core of `pop tasks explore`. The
+// report is written only once a whole one came back, so a pass that fails or is
+// interrupted leaves the set's existing report as it was.
+func exploreResolvedSet(d *Deps, cfg *config.Config, opts exploreCoreOptions) (*ExploreResult, error) {
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{SetID: opts.SetID, DefPath: opts.DefPath})
+	if err != nil {
+		return nil, err
+	}
+	// The Explorer reads the checkout, and a map of files another drain is
+	// rewriting describes a tree that never existed, so the pass takes the
+	// checkout for its duration (ADR-0238).
+	if !opts.checkoutHeld {
+		hold, err := AcquireTreeStable(d, opts.RuntimePath, opts.SetID, opts.Output, opts.admission)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = hold.Release() }()
+	}
+	// The work SHA is read before the Explorer runs: it is the tree the report
+	// describes, and pop stamps it rather than asking the agent to copy it back.
+	workSHA := verifyWorkSHA(d, opts.RuntimePath)
+	run := opts.runExplorer
+	if run == nil {
+		sel, err := resolveExplorer(opts.Agents, opts.Effort, m, cfg)
+		if err != nil {
+			return nil, err
+		}
+		run = func(prompt string) (string, string, error) {
+			return runConfiguredExplorer(d, cfg, sel, m.Dir, opts.SetID, workSHA, opts.RuntimePath, prompt, opts.Output, opts.Timeout, opts.probeMemo)
+		}
+	}
+	body, agent, err := run(buildExplorerPrompt(d, m, workSHA))
+	if err != nil {
+		// A pass that gave up leaves the set parked if it declared exploration,
+		// and the park is reported where it happens, by hand or in a drain.
+		if run, parked := ResolveExplorePark(d, cfg, m); parked {
+			park := explorePark{SetID: opts.SetID, Run: run}
+			if perr := park.record(d, m); perr != nil {
+				outputFor(opts.Output).line(ansiYellow, "warning: record explore park for %s: %v", opts.SetID, perr)
+			}
+			park.print(opts.Output)
+		}
+		return nil, err
+	}
+	doc := explorationReport.renderDocument(d.Now().UTC(), opts.SetID, workSHA, "", agent, body)
+	path := filepath.Join(m.Dir, ExplorationFileName)
+	if err := WriteAtomicWith(d, path, []byte(doc), 0o644); err != nil {
+		return nil, exitErr(ExitOperational, "write exploration report: %v", err)
+	}
+	printExploreWritten(opts.Output, opts.SetID, path)
+	return &ExploreResult{SetID: opts.SetID, WorkSHA: workSHA, Path: path, Body: doc}, nil
+}
+
+// resolveExplorer applies the Explorer precedence chain, highest first: CLI
+// flags → the set's `explorer` directive → [work.explore] →
+// [work.implement].agents / DefaultExploreEffort. Agents and effort resolve
+// independently, as the Refiner's do, and the chain never consults who
+// implemented anything: the Explorer is a fresh agent by construction. An
+// override of `[work.explore] agents = []` refuses the fallthrough to
+// [work.implement].agents, as the Refiner's does (ADR-0202 decision 6).
+func resolveExplorer(cliAgents []string, cliEffort string, m *Manifest, cfg *config.Config) (verifierSelection, error) {
+	agents := nonEmptyStrings(cliAgents)
+	effort := strings.TrimSpace(cliEffort)
+	if over := m.ExplorerOverride(); over != nil {
+		if len(agents) == 0 {
+			agents = nonEmptyStrings(over.Agents)
+		}
+		if effort == "" {
+			effort = strings.TrimSpace(over.Effort)
+		}
+	}
+	if e := cfg.ExploreSettings(); e != nil && effort == "" {
+		effort = strings.TrimSpace(e.Effort)
+	}
+	if len(agents) == 0 {
+		resolved, err := ResolveAgentGroupPresets(cfg.ExploreAgentList(), cfg)
+		if err != nil {
+			return verifierSelection{}, err
+		}
+		agents = resolved
+	}
+	if effort == "" {
+		effort = DefaultExploreEffort
+	}
+	return verifierSelection{Agents: agents, Effort: effort}, nil
+}
+
+// runConfiguredExplorer walks the resolved Explorer agent list through the
+// shared fallback walk at the built-in task cap and retry schedule, and returns
+// the report beside the agent that wrote it. Prose from an attempt that timed
+// out or died is half a map, so it is refused once the cap is spent rather than
+// written over a whole one.
+func runConfiguredExplorer(d *Deps, cfg *config.Config, sel verifierSelection, taskSetDir, setID, workSHA, runtimePath, prompt string, out io.Writer, timeout time.Duration, probeMemo *agentAvailabilityProbeMemo) (string, string, error) {
+	if timeout <= 0 {
+		timeout = DefaultAttemptTimeout
+	}
+	quotaRetryAfter, err := resolveAgentQuotaRetryAfter(cfg)
+	if err != nil {
+		return "", "", exitErr(ExitSetup, "%v", err)
+	}
+	walked, err := runAgentFallbackWalk(d, agentFallbackWalk{
+		role:            explorerRole(d, out, taskSetDir, setID, workSHA),
+		sel:             sel,
+		setID:           setID,
+		runtimePath:     runtimePath,
+		prompt:          prompt,
+		out:             out,
+		errOut:          out,
+		timeout:         timeout,
+		maxTries:        config.DefaultTaskMaxTries,
+		retryDelays:     append([]time.Duration(nil), config.DefaultTaskAttemptRetryDelays...),
+		quotaRetryAfter: quotaRetryAfter,
+		cfg:             cfg,
+		probeMemo:       probeMemo,
+	})
+	if err != nil {
+		return "", "", err
+	}
+	if strings.TrimSpace(walked.Answer) != "" && !walked.AnswerRetryEligible {
+		return strings.TrimSpace(walked.Answer), walked.Agent, nil
+	}
+	if len(walked.Unavailable) == 0 {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", setID)
+	}
+	return "", "", exitErr(ExitSetup, "%s", formatHumanHealingExhaustionMessage(walked.Unavailable))
+}
+
+// explorerRole is what the shared fallback walk calls the Explorer: its name in
+// the operator's output, the Captured run each invocation is filed as under the
+// `explore` phase — marked reported when it came back with a report, which is
+// what ResolveExplorePark reads — and the Refiner's retry rule, because a report with no format
+// to parse is judged by how the run ended, exactly as a Refine report is.
+//
+// It is the one read-only role. The Explorer maps the checkout and pop files
+// what it answers, so it is spawned without its editing tools where the preset
+// can be told so.
+func explorerRole(d *Deps, errOut io.Writer, taskSetDir, setID, workSHA string) agentRole {
+	return agentRole{
+		Noun:   "Explorer agent",
+		Gerund: "Exploring",
+		Phase:  spendPhaseExplore,
+		Persist: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int) {
+			_ = persistExploreRun(d, errOut, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode, "")
+		},
+		PersistAnswer: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int, answer string) {
+			_ = persistExploreRun(d, errOut, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode, exploreRunOutcome(outcome, exitCode, answer))
+		},
+		PersistSkipped: func(rec *streamRecorder, invocation *AgentInvocation, model string, try int, reason string, exitCode int) {
+			_ = persistExploreRun(d, errOut, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, model, try, streamOutcomeModelSkipped, reason, exitCode, "")
+		},
+		RetryEligible: refineAttemptRetryEligible,
+		ReadOnly:      true,
+	}
+}
+
+// printExploreWritten tells the operator where the report went and how to read
+// it, and nothing about what it says: the report is the whole output.
+func printExploreWritten(w io.Writer, setID, path string) {
+	if w == nil {
+		return
+	}
+	out := outputFor(w)
+	out.line(ansiBold, "━━ Explore for %s", setID)
+	out.line(ansiDim, "   Document: %s", path)
+	out.line(ansiDim, "   Read it: pop tasks artifacts %s --show %s", setID, ExplorationFileName)
+}
+
+// buildExplorerPrompt assembles the Explorer's prompt: pop's role framing, the
+// set's manifest listing, every task body and the spec where one exists, and
+// the shape of the report it wants back. The Explorer stands in the checkout and
+// reads the code itself; nothing of the code is inlined.
+func buildExplorerPrompt(d *Deps, m *Manifest, workSHA string) string {
+	view := explorerPromptView{
+		TaskSet: m.Stem,
+		WorkSHA: ShortSHA(workSHA),
+		Tasks:   manifestTaskRows(m, false),
+	}
+	for _, row := range view.Tasks {
+		view.Bodies = append(view.Bodies, explorerTaskBody{ID: row.ID, Body: readTaskBody(d, row.Path)})
+	}
+	if spec, ok := readSpec(d, m); ok {
+		view.SpecRecorded = true
+		view.Spec = spec
+	}
+	return prompt.MustRender(promptTemplates, "explorer.tmpl.md", view)
+}
+
+// explorerPromptView is what the Explorer's template renders against. Every
+// optional section is a named boolean beside the text it guards.
+type explorerPromptView struct {
+	TaskSet string
+	// WorkSHA is the commit the report will be stamped with, empty when the
+	// checkout's HEAD could not be read.
+	WorkSHA      string
+	Tasks        []taskRow
+	Bodies       []explorerTaskBody
+	SpecRecorded bool
+	Spec         string
+}
+
+// explorerTaskBody is one task's body as the Explorer reads it: the whole set,
+// whatever each task's status, because the map is for every builder to come.
+type explorerTaskBody struct {
+	ID   string
+	Body taskBodyRow
+}
diff --git a/tasks/explore_mark.go b/tasks/explore_mark.go
new file mode 100644
index 00000000..0631defe
--- /dev/null
+++ b/tasks/explore_mark.go
@@ -0,0 +1,168 @@
+package tasks
+
+import (
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/work"
+)
+
+// ExploreMark is whether a Task set that asked to be explored got its
+// Exploration report, carried beside its status as the Verification and Refine
+// marks are (ADR-0262). A set that never declared `"explore": true` carries no
+// mark at all: exploration is opt-in, so its absence says nothing about such a
+// set. It is an alias of work.ExploreMark so a Work container can carry it
+// without `work` importing this package.
+type ExploreMark = work.ExploreMark
+
+const (
+	// ExploreMarkNone is the absent mark: the set never asked to be explored.
+	ExploreMarkNone ExploreMark = ""
+	// ExploreMarkExplored is a set that asked and has its Exploration report.
+	ExploreMarkExplored ExploreMark = "explored"
+	// ExploreMarkUnexplored is a set that asked and has no report. The reason
+	// beside it says why.
+	ExploreMarkUnexplored ExploreMark = "unexplored"
+)
+
+// UnexploredReason is why an unexplored set has no report — the detail beside
+// the mark, never a second mark.
+type UnexploredReason = work.UnexploredReason
+
+const (
+	// UnexploredReasonNone is the absent reason: the set is explored, or it
+	// carries no mark at all.
+	UnexploredReasonNone UnexploredReason = ""
+	// UnexploredNotYetRun is a set no Explore pass has finished for: none has
+	// run, or the latest was cut short by the human or a quota pause, which is
+	// not the pass failing.
+	UnexploredNotYetRun UnexploredReason = "not-yet-run"
+	// UnexploredFailed is a set whose latest Explore pass gave up with no report.
+	UnexploredFailed UnexploredReason = "failed"
+)
+
+// ExploreResolution is what the read-side resolution answers for one set: the
+// mark every surface displays and, when the set is unexplored, the reason
+// riding beside it.
+type ExploreResolution struct {
+	Mark ExploreMark
+	// Reason is why the set has no report, blank unless Mark is
+	// ExploreMarkUnexplored.
+	Reason UnexploredReason
+}
+
+// ResolveExploreMark is the single read-side Explore mark resolution: whether a
+// set that asked to be explored has its report, and why not when it has none.
+// The refresh stamps it on every row beside the Verification mark, so the
+// dashboard, `pop work status` and `pop tasks status` read one answer.
+//
+// It stores nothing. The report on disk is the whole answer for an explored
+// set; for an unexplored one the latest Captured run of phase `explore` says
+// whether a pass gave up, by the same rule the EXPLORE-FAILED park reads.
+func ResolveExploreMark(d *Deps, m *Manifest) ExploreResolution {
+	if m == nil || !m.ExploreRequested() {
+		return ExploreResolution{}
+	}
+	if explorationBlock(d, m.Dir).HasExploration {
+		return ExploreResolution{Mark: ExploreMarkExplored}
+	}
+	if run, ok := latestExploreRun(d, m); ok && exploreRunGaveUp(run) {
+		return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredFailed}
+	}
+	return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredNotYetRun}
+}
+
+// applyExploreMarks stamps each row with its set's Explore mark. A set that
+// never asked costs nothing beyond reading its manifest's key.
+func applyExploreMarks(d *Deps, result *RefreshResult) {
+	for i := range result.Rows {
+		row := &result.Rows[i]
+		res := ResolveExploreMark(d, result.Manifests[row.ID])
+		row.ExploreMark, row.UnexploredReason = res.Mark, res.Reason
+	}
+}
+
+// exploreResolutionOf reads the resolution back off a row, so a surface that
+// holds the row renders what the refresh resolved instead of resolving again.
+func exploreResolutionOf(row Row) ExploreResolution {
+	return ExploreResolution{Mark: row.ExploreMark, Reason: row.UnexploredReason}
+}
+
+// exploreMarkCellText is the mark as a status cell carries it: the mark, with
+// the reason in brackets when the set is unexplored.
+func exploreMarkCellText(res ExploreResolution) string {
+	switch res.Mark {
+	case ExploreMarkExplored:
+		return string(ExploreMarkExplored)
+	case ExploreMarkUnexplored:
+		return string(ExploreMarkUnexplored) + " (" + unexploredReasonWords(res.Reason) + ")"
+	}
+	return ""
+}
+
+// exploreMarkPhrase is the mark as a human reads it in a detail view or at a
+// gate, in the one wording those surfaces share.
+func exploreMarkPhrase(res ExploreResolution) string {
+	switch res.Mark {
+	case ExploreMarkExplored:
+		return "Explored"
+	case ExploreMarkUnexplored:
+		return "Not explored: " + unexploredReasonWords(res.Reason)
+	}
+	return ""
+}
+
+func unexploredReasonWords(reason UnexploredReason) string {
+	if reason == UnexploredFailed {
+		return "the pass failed"
+	}
+	return "not yet run"
+}
+
+// latestExplorationPointer resolves the set's Exploration report as the shared
+// report pointer: its path and the tree its header records, never its body.
+// The report is flat, so the instant is the one its own header records rather
+// than one read from a timestamped name.
+func latestExplorationPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if m == nil {
+		return ReportPointer{}, false
+	}
+	block := explorationBlock(d, m.Dir)
+	if !block.HasExploration {
+		return ReportPointer{}, false
+	}
+	p := ReportPointer{Label: explorationReport.PointerLabel, Path: block.Path}
+	data, err := d.FS.ReadFile(block.Path)
+	if err != nil {
+		return p, true
+	}
+	body := string(data)
+	p.WorkSHA = reportHeaderField(body, "Work SHA")
+	if at, err := time.Parse(time.RFC3339, reportHeaderField(body, explorationReport.WrittenLabel)); err == nil {
+		p.Written = at.UTC().Format("2006-01-02 15:04Z")
+	}
+	return p, true
+}
+
+// ExplorationSectionTitle titles the dashboard detail section the Explore mark
+// and the report pointer are carried in.
+const ExplorationSectionTitle = "Exploration"
+
+// ExplorationSection is the dashboard detail view's account of a set's
+// exploration: the mark the refresh resolved and, when the report exists, its
+// pointer. A set that never asked has no section.
+func ExplorationSection(d *Deps, c work.Container, m *Manifest) (work.Section, bool) {
+	res := ExploreResolution{Mark: c.ExploreMark, Reason: c.UnexploredReason}
+	phrase := exploreMarkPhrase(res)
+	if phrase == "" {
+		return work.Section{}, false
+	}
+	lines := []string{phrase}
+	if p, ok := latestExplorationPointer(d, m); ok {
+		lines = append(lines, p.Summary())
+	}
+	return work.Section{Title: ExplorationSectionTitle, Body: strings.Join(lines, "\n")}, true
+}
diff --git a/tasks/explore_mark_test.go b/tasks/explore_mark_test.go
new file mode 100644
index 00000000..0c3e8909
--- /dev/null
+++ b/tasks/explore_mark_test.go
@@ -0,0 +1,154 @@
+package tasks
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// explorationProse is the one string no surface may print: the report's body.
+const explorationProse = "SECRET-EXPLORATION-PROSE"
+
+// exploreMarkSet is a registered one-task "demo" set with the given set-level
+// keys, read back through the refresh every status surface starts from.
+type exploreMarkSet struct {
+	env    *runTaskSetFixture
+	setDir string
+}
+
+func newExploreMarkSet(t *testing.T, keys map[string]any) *exploreMarkSet {
+	t.Helper()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", openAFKSet(), keys)
+	return &exploreMarkSet{env: env, setDir: filepath.Join(env.tasksDir, "demo")}
+}
+
+// surfaces renders the set the way `pop tasks status` and `pop tasks status
+// demo` print it, from one refresh.
+func (s *exploreMarkSet) surfaces(t *testing.T) (Row, string, string) {
+	t.Helper()
+	refresh, err := RefreshWith(s.env.deps(), s.env.tasksDir, DefaultStatePathWith(s.env.deps()))
+	if err != nil {
+		t.Fatalf("RefreshWith: %v", err)
+	}
+	row := FindRow(refresh, "demo")
+	if row == nil {
+		t.Fatal("no demo row")
+	}
+	var table, detail bytes.Buffer
+	Render(&table, refresh)
+	RenderTaskSetDetail(s.env.deps(), nil, &detail, "demo", row, refresh.Manifests["demo"])
+	return *row, table.String(), detail.String()
+}
+
+// TestExploreMarkFollowsTheSetFromAskedToExplored drives one declared set
+// through the three answers the mark gives — not yet run, the pass failed,
+// explored — and reads each from the refreshed row and from both `pop tasks
+// status` surfaces. The explored set's detail points at the report by path and
+// the tree it records, and never prints its body.
+func TestExploreMarkFollowsTheSetFromAskedToExplored(t *testing.T) {
+	t.Parallel()
+	s := newExploreMarkSet(t, map[string]any{"explore": true})
+
+	row, table, detail := s.surfaces(t)
+	if row.ExploreMark != ExploreMarkUnexplored || row.UnexploredReason != UnexploredNotYetRun {
+		t.Fatalf("fresh set mark = %q/%q, want unexplored/not-yet-run", row.ExploreMark, row.UnexploredReason)
+	}
+	if !strings.Contains(table, "unexplored (not yet run)") {
+		t.Fatalf("status table lacks the mark:\n%s", table)
+	}
+	if !strings.Contains(detail, "Not explored: not yet run") {
+		t.Fatalf("detail lacks the mark:\n%s", detail)
+	}
+
+	rec := newStreamRecorder(io.Discard, time.Now)
+	persistExploreRun(s.env.deps(), io.Discard, s.setDir, "demo", "", rec, "claude", "claude", "", config.DefaultTaskMaxTries, streamOutcomeFailed, "exit status 2", 2, "")
+	row, table, detail = s.surfaces(t)
+	if row.ExploreMark != ExploreMarkUnexplored || row.UnexploredReason != UnexploredFailed {
+		t.Fatalf("failed pass mark = %q/%q, want unexplored/failed", row.ExploreMark, row.UnexploredReason)
+	}
+	if !strings.Contains(table, "unexplored (the pass failed)") || !strings.Contains(detail, "Not explored: the pass failed") {
+		t.Fatalf("surfaces lack the failed reason:\n%s\n%s", table, detail)
+	}
+
+	at := time.Date(2026, 10, 10, 7, 55, 0, 0, time.UTC)
+	path := filepath.Join(s.setDir, ExplorationFileName)
+	body := explorationReport.renderDocument(at, "demo", "abc123abc123", "", "claude", "## Where things live\n\n"+explorationProse)
+	if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	row, table, detail = s.surfaces(t)
+	if row.ExploreMark != ExploreMarkExplored || row.UnexploredReason != UnexploredReasonNone {
+		t.Fatalf("reported set mark = %q/%q, want explored", row.ExploreMark, row.UnexploredReason)
+	}
+	if !strings.Contains(table, "explored") || strings.Contains(table, "unexplored") {
+		t.Fatalf("status table mark wrong:\n%s", table)
+	}
+	for _, want := range []string{"Explored", path, "abc123a", "2026-10-10 07:55Z"} {
+		if !strings.Contains(detail, want) {
+			t.Fatalf("detail lacks %q:\n%s", want, detail)
+		}
+	}
+	if strings.Contains(table+detail, explorationProse) {
+		t.Fatalf("a surface printed the report's body:\n%s\n%s", table, detail)
+	}
+}
+
+// TestSetThatNeverAskedCarriesNoExploreMark: a set with no `explore` key — even
+// one with an exploration.md beside it — carries no mark on any surface.
+func TestSetThatNeverAskedCarriesNoExploreMark(t *testing.T) {
+	t.Parallel()
+	for _, keys := range []map[string]any{nil, {"explore": false}} {
+		s := newExploreMarkSet(t, keys)
+		if err := os.WriteFile(filepath.Join(s.setDir, ExplorationFileName), []byte("# Exploration report — demo\n"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		row, table, detail := s.surfaces(t)
+		if row.ExploreMark != ExploreMarkNone || row.UnexploredReason != UnexploredReasonNone {
+			t.Fatalf("keys %v: mark = %q/%q, want none", keys, row.ExploreMark, row.UnexploredReason)
+		}
+		if strings.Contains(table, "explored") || strings.Contains(detail, "xplored") {
+			t.Fatalf("keys %v: a surface carries a mark:\n%s\n%s", keys, table, detail)
+		}
+	}
+}
+
+// TestSignOffGateNamesTheExplorationReport: the gate names the report where it
+// names the refine report — the mark and the pointer, never the body — and
+// says nothing for a set that never asked.
+func TestSignOffGateNamesTheExplorationReport(t *testing.T) {
+	t.Parallel()
+	hitlSet := []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "done"},
+		{ID: "02-hitl", File: "02-hitl.md", Title: "Sign off", Type: "HITL", Status: "open"},
+	}
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), hitlSet, map[string]any{"explore": true})
+	path := filepath.Join(m.Dir, ExplorationFileName)
+	body := explorationReport.renderDocument(time.Date(2026, 10, 10, 7, 55, 0, 0, time.UTC), "demo", "abc123abc123", "", "claude", explorationProse)
+	if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	seedRefineReport(t, d, m)
+
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	explored := strings.Index(gate, "🗺 Explored · Exploration of abc123a")
+	if explored < 0 || !strings.Contains(gate, path) {
+		t.Fatalf("gate lacks the exploration pointer:\n%s", gate)
+	}
+	if refine := strings.Index(gate, "📝 Refine of"); refine < 0 || explored > refine {
+		t.Fatalf("exploration line is not beside the refine one:\n%s", gate)
+	}
+	if strings.Contains(gate, explorationProse) {
+		t.Fatalf("gate printed the report's body:\n%s", gate)
+	}
+
+	d, m = setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), hitlSet, nil)
+	if gate, _ := hitlGateOutput(t, d, m, "0\n"); strings.Contains(gate, "🗺") {
+		t.Fatalf("gate names exploration for a set that never asked:\n%s", gate)
+	}
+}
diff --git a/tasks/explore_park.go b/tasks/explore_park.go
new file mode 100644
index 00000000..99203900
--- /dev/null
+++ b/tasks/explore_park.go
@@ -0,0 +1,168 @@
+package tasks
+
+import (
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// exploreOutcomeReported is filed in an Explorer run's outcome slot when the
+// run ended clean with a report in hand — the one fact the park needs from a
+// run beyond how it ended, because a set whose report a human later deleted
+// must read as unexplored rather than as parked.
+const exploreOutcomeReported = "reported"
+
+// exploreRunOutcome is the outcome filed on one Explorer invocation's Captured
+// run: reported for a clean ending with prose, nothing otherwise. It mirrors
+// what runConfiguredExplorer accepts, so a run marked reported is a run whose
+// answer pop would write.
+func exploreRunOutcome(outcome string, exitCode int, answer string) string {
+	if outcome != streamOutcomeCompleted || exitCode != 0 || strings.TrimSpace(answer) == "" {
+		return ""
+	}
+	return exploreOutcomeReported
+}
+
+// ResolveExplorePark is the single read-side answer to whether a Task set is
+// parked at EXPLORE-FAILED (ADR-0262 decision 6), and the latest explore run
+// behind the park when it is.
+//
+// It stores nothing. A set is parked when everything that would make the drain
+// explore it holds — [work.explore] on, the set declared `"explore": true`, no
+// human completion, no Exploration report, a task left to build — and its
+// latest Captured run of phase `explore` gave up: it ended without a report and
+// was not cut short by the human or a quota pause, neither of which is the pass
+// failing. The park therefore clears on its own the moment any of those stops
+// holding: a hand-run pass writes the report, the author retracts the
+// declaration, the set runs out of buildable tasks.
+//
+// While a drain is between two Explorer tries the latest run is the failed
+// first one, so the set reads parked until the retry reports. The drain holds
+// the checkout for the whole pass, so nothing acts on that reading.
+func ResolveExplorePark(d *Deps, cfg *config.Config, m *Manifest) (capturedRunMeta, bool) {
+	if !exploreParkCandidate(d, m) || !cfg.ExploreEnabled() {
+		return capturedRunMeta{}, false
+	}
+	run, ok := latestExploreRun(d, m)
+	if !ok || !exploreRunGaveUp(run) {
+		return capturedRunMeta{}, false
+	}
+	return run, true
+}
+
+// exploreRunGaveUp is whether one explore run is a pass that failed: it ended
+// without a report, and neither the human nor a quota pause cut it short.
+func exploreRunGaveUp(run capturedRunMeta) bool {
+	if run.Verdict == exploreOutcomeReported {
+		return false
+	}
+	switch run.Outcome {
+	case streamOutcomeInterrupted, streamOutcomeQuotaPaused:
+		return false
+	}
+	return true
+}
+
+// exploreParkCandidate is the part of the park that needs neither config nor
+// the run directory: a READY set that asked to be explored and has no report.
+// It lets a refresh decide most rows without loading either.
+func exploreParkCandidate(d *Deps, m *Manifest) bool {
+	if m == nil || m.HumanCompleted || !m.ExploreRequested() {
+		return false
+	}
+	if DeriveStatus(m) != StatusReady {
+		return false
+	}
+	return !explorationBlock(d, m.Dir).HasExploration
+}
+
+// latestExploreRun is the set's most recent Captured run of phase `explore`,
+// read from the index halves only, as latestRefineRun reads refine runs.
+func latestExploreRun(d *Deps, m *Manifest) (capturedRunMeta, bool) {
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return capturedRunMeta{}, false
+	}
+	metas, err := listCapturedRunMetas(d, m.Dir)
+	if err != nil {
+		return capturedRunMeta{}, false
+	}
+	var latest capturedRunMeta
+	found := false
+	for _, meta := range metas {
+		if meta.Phase == spendPhaseExplore {
+			latest, found = meta, true
+		}
+	}
+	return latest, found
+}
+
+// applyExploreParks overlays EXPLORE-FAILED onto every READY row the park
+// resolution says is parked, so automatic selection, the Work daemon and every
+// status surface pass over the set by reading its row like any other stop.
+// Config is loaded only when a row is a candidate, which a set that never
+// declared `explore` never is.
+func applyExploreParks(d *Deps, result *RefreshResult) {
+	var cfg *config.Config
+	loaded := false
+	for i := range result.Rows {
+		row := &result.Rows[i]
+		if row.Status != StatusReady || row.Archived {
+			continue
+		}
+		m := result.Manifests[row.ID]
+		if !exploreParkCandidate(d, m) {
+			continue
+		}
+		if !loaded {
+			cfg, _ = config.LoadDefaultWith(d.ConfigDeps())
+			loaded = true
+		}
+		if run, parked := ResolveExplorePark(d, cfg, m); parked {
+			row.Status = StatusExploreFailed
+			row.BlockedReason = explorePark{SetID: row.ID, Run: run}.Reason()
+		}
+	}
+}
+
+// explorePark is one set parked at EXPLORE-FAILED and the run that parked it,
+// carrying the words every place that reports the park uses.
+type explorePark struct {
+	SetID string
+	Run   capturedRunMeta
+}
+
+// Reason is why the pass gave up, as its latest run recorded it.
+func (p explorePark) Reason() string {
+	reason := strings.TrimSpace(p.Run.Reason)
+	if reason == "" {
+		reason = strings.ReplaceAll(p.Run.Outcome, "_", " ")
+	}
+	if reason == "" {
+		reason = "no report"
+	}
+	return "explore gave up: " + reason
+}
+
+// Doors names the three ways out of the park (ADR-0262 decision 6).
+func (p explorePark) Doors() string {
+	return fmt.Sprintf("explore by hand: pop tasks explore %s; drain once unexplored: pop tasks implement %s --skip-explore; or set \"explore\": false", p.SetID, p.SetID)
+}
+
+// record appends the park's one set-level Progress record, so why the drain
+// stopped is readable without opening the captured run.
+func (p explorePark) record(d *Deps, m *Manifest) error {
+	summary := fmt.Sprintf("Explore phase parked the set with no Exploration report — %s. Ways out — %s.", p.Reason(), p.Doors())
+	return AppendSetProgress(d, m.Dir, string(StatusExploreFailed), summary)
+}
+
+// print tells the operator the set is parked, why, and the ways out.
+func (p explorePark) print(w io.Writer) {
+	if w == nil {
+		return
+	}
+	out := outputFor(w)
+	out.line(ansiRed, "━━ %s parked at %s: %s", p.SetID, StatusExploreFailed, p.Reason())
+	out.line(ansiDim, "   Ways out: %s", p.Doors())
+}
diff --git a/tasks/explore_park_test.go b/tasks/explore_park_test.go
new file mode 100644
index 00000000..de93a723
--- /dev/null
+++ b/tasks/explore_park_test.go
@@ -0,0 +1,209 @@
+package tasks
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// exploreParkRecords is how many EXPLORE-FAILED Progress records the set's
+// progress.txt holds.
+func exploreParkRecords(t *testing.T, setDir string) int {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(setDir, "progress.txt"))
+	if os.IsNotExist(err) {
+		return 0
+	}
+	if err != nil {
+		t.Fatalf("read progress: %v", err)
+	}
+	return strings.Count(string(data), "[set] "+string(StatusExploreFailed))
+}
+
+// TestExploreThatGivesUpParksADeclaredSetUntilAHandRunReports drives the real
+// fallback walk: an Explorer that dies on every try spends the standard per-phase
+// cap, parks the declared set with one Progress record naming the phase and the
+// reason, and a later hand run that reports clears the park.
+func TestExploreThatGivesUpParksADeclaredSetUntilAHandRunReports(t *testing.T) {
+	t.Parallel()
+	dying := scriptedRefineRun{output: claudeRefineStream(`## Where things live\n\n- tasks/explore.go: the pa`), exitCode: 2}
+	var runs []scriptedRefineRun
+	for i := 0; i < config.DefaultTaskMaxTries; i++ {
+		runs = append(runs, dying)
+	}
+	runs = append(runs, scriptedRefineRun{output: claudeRefineStream(`## Where things live\n\n- tasks/explore.go: the pass.`)})
+	d, _, opts, setDir := setupExploreFixture(t, map[string]any{"explore": true}, runs...)
+	if err := os.Remove(filepath.Join(setDir, ExplorationFileName)); err != nil {
+		t.Fatal(err)
+	}
+	manifest := func() *Manifest { return LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName)) }
+
+	if _, err := exploreResolvedSet(d, nil, opts); err == nil {
+		t.Fatal("a pass whose every attempt died succeeded")
+	}
+	filed, err := listSetRuns(d, setDir)
+	if err != nil {
+		t.Fatalf("listSetRuns: %v", err)
+	}
+	if len(filed) != config.DefaultTaskMaxTries {
+		t.Fatalf("explore runs = %d, want the standard cap of %d", len(filed), config.DefaultTaskMaxTries)
+	}
+	if _, parked := ResolveExplorePark(d, nil, manifest()); !parked {
+		t.Fatal("a declared set whose pass gave up is not parked")
+	}
+	if got := exploreParkRecords(t, setDir); got != 1 {
+		t.Fatalf("park records = %d, want 1", got)
+	}
+	progress, _ := os.ReadFile(filepath.Join(setDir, "progress.txt"))
+	for _, want := range []string{"Explore phase", "explore gave up", "pop tasks explore demo", "--skip-explore", `"explore": false`} {
+		if !strings.Contains(string(progress), want) {
+			t.Fatalf("park record missing %q:\n%s", want, progress)
+		}
+	}
+
+	if _, err := exploreResolvedSet(d, nil, opts); err != nil {
+		t.Fatalf("hand run: %v", err)
+	}
+	if _, parked := ResolveExplorePark(d, nil, manifest()); parked {
+		t.Fatal("a hand run that wrote the report left the park")
+	}
+	if got := exploreParkRecords(t, setDir); got != 1 {
+		t.Fatalf("park records = %d after the hand run, want still 1", got)
+	}
+}
+
+// TestUndeclaredSetNeverParks: a pass that gives up on a set that never asked to
+// be explored leaves no park and no record — there is nothing to protect.
+func TestUndeclaredSetNeverParks(t *testing.T) {
+	t.Parallel()
+	dying := scriptedRefineRun{output: claudeRefineStream(`half`), exitCode: 2}
+	var runs []scriptedRefineRun
+	for i := 0; i < config.DefaultTaskMaxTries; i++ {
+		runs = append(runs, dying)
+	}
+	d, _, opts, setDir := setupExploreFixture(t, nil, runs...)
+	if err := os.Remove(filepath.Join(setDir, ExplorationFileName)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := exploreResolvedSet(d, nil, opts); err == nil {
+		t.Fatal("a pass whose every attempt died succeeded")
+	}
+	if _, parked := ResolveExplorePark(d, nil, LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))); parked {
+		t.Fatal("an undeclared set parked")
+	}
+	if got := exploreParkRecords(t, setDir); got != 0 {
+		t.Fatalf("park records = %d, want none", got)
+	}
+}
+
+// exploreParkDrain is a registered one-task "demo" set declaring exploration,
+// whose Explorer gives up the way the walk does: it files a failed explore run
+// and returns no report.
+type exploreParkDrain struct {
+	env    *runTaskSetFixture
+	setDir string
+	agent  string
+	passes int
+}
+
+func newExploreParkDrain(t *testing.T) *exploreParkDrain {
+	t.Helper()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", openAFKSet(), map[string]any{"explore": true})
+	return &exploreParkDrain{
+		env:    env,
+		setDir: filepath.Join(env.tasksDir, "demo"),
+		agent:  writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "done"}),
+	}
+}
+
+func (p *exploreParkDrain) drain(t *testing.T, skipExplore bool) *RunTaskSetResult {
+	t.Helper()
+	var buf bytes.Buffer
+	opts := p.env.runTaskSetOpts(true, p.agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.SkipExplore = skipExplore
+	opts.exploreRunner = func(string) (string, string, error) {
+		p.passes++
+		rec := newStreamRecorder(io.Discard, time.Now)
+		persistExploreRun(p.env.deps(), io.Discard, p.setDir, "demo", "", rec, "claude", "claude", "", config.DefaultTaskMaxTries, streamOutcomeFailed, "exit status 2", 2, "")
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", "demo")
+	}
+	result, err := RunTaskSetWith(p.env.deps(), nil, func(string) (*config.Config, error) { return nil, nil }, opts)
+	if err != nil {
+		t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+	}
+	return result
+}
+
+func (p *exploreParkDrain) refresh(t *testing.T) *RefreshResult {
+	t.Helper()
+	refresh, err := RefreshWith(p.env.deps(), p.env.tasksDir, DefaultStatePathWith(p.env.deps()))
+	if err != nil {
+		t.Fatalf("RefreshWith: %v", err)
+	}
+	return refresh
+}
+
+// TestDrainStopsAtAnExploreParkAndNothingRepicksIt: the drain parks the set at
+// its own status before any task runs, automatic selection passes over it, a
+// second drain stops at the park without exploring again, and --skip-explore
+// drains it once unexplored without parking anew.
+func TestDrainStopsAtAnExploreParkAndNothingRepicksIt(t *testing.T) {
+	t.Parallel()
+	p := newExploreParkDrain(t)
+
+	result := p.drain(t, false)
+	if !result.TaskSetExploreFailed || result.TaskSetDone || len(result.Completed) != 0 {
+		t.Fatalf("result = %+v, want a park before any task", result)
+	}
+	refresh := p.refresh(t)
+	if row := FindRow(refresh, "demo"); row == nil || row.Status != StatusExploreFailed {
+		t.Fatalf("row = %+v, want EXPLORE-FAILED", row)
+	}
+	if _, err := SelectTask(refresh, "", ""); err == nil {
+		t.Fatal("automatic selection picked a parked set")
+	}
+	if got := exploreParkRecords(t, p.setDir); got != 1 {
+		t.Fatalf("park records = %d, want 1", got)
+	}
+
+	if result := p.drain(t, false); !result.TaskSetExploreFailed || p.passes != 1 {
+		t.Fatalf("second drain: result %+v after %d passes, want a stop at the park with no new pass", result, p.passes)
+	}
+	if got := exploreParkRecords(t, p.setDir); got != 1 {
+		t.Fatalf("park records = %d after a second drain, want still 1", got)
+	}
+
+	if result := p.drain(t, true); !result.TaskSetDone || result.TaskSetExploreFailed || p.passes != 1 {
+		t.Fatalf("--skip-explore: result %+v after %d passes, want the set built unexplored", result, p.passes)
+	}
+	if _, err := os.Stat(filepath.Join(p.setDir, ExplorationFileName)); !os.IsNotExist(err) {
+		t.Fatalf("exploration.md exists (err=%v), want none", err)
+	}
+	if got := exploreParkRecords(t, p.setDir); got != 1 {
+		t.Fatalf("park records = %d after --skip-explore, want still 1", got)
+	}
+}
+
+// TestRetractingTheDeclarationClearsTheExplorePark: `"explore": false` puts a
+// parked set back at READY, where automatic selection takes it.
+func TestRetractingTheDeclarationClearsTheExplorePark(t *testing.T) {
+	t.Parallel()
+	p := newExploreParkDrain(t)
+	p.drain(t, false)
+
+	writeManifestWithSetKeys(t, p.setDir, openAFKSet(), map[string]any{"explore": false})
+	refresh := p.refresh(t)
+	if row := FindRow(refresh, "demo"); row == nil || row.Status != StatusReady {
+		t.Fatalf("row = %+v, want READY once the declaration is retracted", row)
+	}
+	if _, err := SelectTask(refresh, "", ""); err != nil {
+		t.Fatalf("automatic selection: %v", err)
+	}
+}
diff --git a/tasks/explore_phase.go b/tasks/explore_phase.go
new file mode 100644
index 00000000..9648d757
--- /dev/null
+++ b/tasks/explore_phase.go
@@ -0,0 +1,107 @@
+package tasks
+
+import "fmt"
+
+// exploreDirective is the small instruction explorePhase hands back to the drain
+// loop: proceed to task selection, or return the error that ended the drain.
+type exploreDirective int
+
+const (
+	// exploreProceed enters the drain's task loop: explore skipped, a report
+	// reused, or a report written.
+	exploreProceed exploreDirective = iota
+	// exploreReturn ends the drain with the returned error: the set parked at
+	// EXPLORE-FAILED (nil), the human interrupted the Explorer, the pass failed
+	// without parking, or the set could not be read.
+	exploreReturn
+)
+
+// explorePhase runs the drain's Explore step (ADR-0262): with [work.explore]
+// enabled — the default — a set whose `explore` key asks for it and that has no
+// Exploration report yet gets one from a fresh Explorer before its first task
+// is selected.
+//
+// It sits at the head of the drain because the report is for the builders: a
+// task that runs before it builds against a map of its own. The set's own
+// declaration is what triggers the pass, which is why the machine-wide switch
+// may default on. A report already there is reused whatever its Work SHA says:
+// absent means write it, present means reuse it, and nothing here compares the
+// recorded tree to the checkout.
+//
+// It is the one agent phase that gates. The author said the tasks are
+// interrelated, so building them unexplored is the inconsistency the phase
+// exists to prevent: a pass that gives up after its retries parks the set at
+// EXPLORE-FAILED and the drain stops, and a set already parked stops here
+// without a second pass, so nothing loops on it. A failure that leaves no park
+// behind — no Explorer could be started at all — stops the drain too.
+// `--skip-explore` passes over all of this once.
+//
+// A human-completed set is skipped, as refinePhase skips it, and so is a set
+// with no task left to build: the report has no reader there. `pop tasks
+// explore` still runs on any set on request.
+func (r *implementRun) explorePhase() (exploreDirective, error) {
+	cfg := r.plan.cfg
+	if r.opts.SkipExplore || !cfg.ExploreEnabled() {
+		return exploreProceed, nil
+	}
+	refresh, err := RefreshWith(r.d, r.resolved.DefinitionPath, r.statePath)
+	if err != nil {
+		return exploreReturn, exitErr(ExitOperational, "refresh before exploring: %v", err)
+	}
+	m := refresh.Manifests[r.taskSetID]
+	if m == nil || m.HumanCompleted || !m.ExploreRequested() {
+		return exploreProceed, nil
+	}
+	if explorationBlock(r.d, m.Dir).HasExploration {
+		return exploreProceed, nil
+	}
+	if _, selErr := SelectTaskInSet(refresh, r.taskSetID); selErr != nil {
+		return exploreProceed, nil
+	}
+	if run, parked := ResolveExplorePark(r.d, cfg, m); parked {
+		explorePark{SetID: r.taskSetID, Run: run}.print(r.out)
+		return r.stopAtExplorePark()
+	}
+
+	_, err = exploreResolvedSet(r.d, cfg, exploreCoreOptions{
+		DefPath:     r.resolved.DefinitionPath,
+		RuntimePath: r.runtimePath,
+		SetID:       r.taskSetID,
+		Timeout:     r.timeout,
+		Output:      r.out,
+		probeMemo:   r.agentProbeMemo,
+		runExplorer: r.opts.exploreRunner,
+		// The drain is already holding this checkout for this set, so the pass
+		// runs inside that claim rather than asking for it again (ADR-0238).
+		checkoutHeld: true,
+	})
+	if err == nil {
+		return exploreProceed, nil
+	}
+	if isInterrupted(err) {
+		return exploreReturn, err
+	}
+	// exploreResolvedSet has already recorded and printed a park it left.
+	if _, parked := ResolveExplorePark(r.d, cfg, m); parked {
+		return r.stopAtExplorePark()
+	}
+	outputFor(r.out).line(ansiYellow, "━━ Explore did not run for %s: %v", r.taskSetID, err)
+	return exploreReturn, err
+}
+
+// stopAtExplorePark ends the drain at an EXPLORE-FAILED park the way the
+// Verifier's park ends it: the result says so and the table shows the set at
+// its new status.
+func (r *implementRun) stopAtExplorePark() (exploreDirective, error) {
+	r.result.TaskSetExploreFailed = true
+	if refresh, err := RefreshWith(r.d, r.resolved.DefinitionPath, r.statePath); err == nil {
+		r.result.Refresh = refresh
+	}
+	if r.opts.Yes || r.result.Refresh == nil {
+		printTaskSetSummary(r.out, r.result)
+	} else {
+		fmt.Fprintln(r.out)
+		Render(r.out, r.result.Refresh)
+	}
+	return exploreReturn, nil
+}
diff --git a/tasks/explore_test.go b/tasks/explore_test.go
new file mode 100644
index 00000000..fe7ca3c1
--- /dev/null
+++ b/tasks/explore_test.go
@@ -0,0 +1,214 @@
+package tasks
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// explorerRunner replays scripted Explorer runs and keeps what each one was
+// spawned with: its argv and the prompt it was told to read.
+type explorerRunner struct {
+	scripted scriptedRefineRunner
+	args     [][]string
+	prompts  []string
+}
+
+func (r *explorerRunner) Run(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (int, error) {
+	proc, err := r.Start(ctx, dir, stdout, stderr, name, args...)
+	if err != nil {
+		return 1, err
+	}
+	return proc.Wait()
+}
+
+func (r *explorerRunner) Start(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (*ManagedProcess, error) {
+	r.args = append(r.args, append([]string(nil), args...))
+	for _, arg := range args {
+		rest, ok := strings.CutPrefix(arg, "Read the file ")
+		if !ok {
+			continue
+		}
+		path, _, _ := strings.Cut(rest, " in full")
+		data, err := os.ReadFile(path)
