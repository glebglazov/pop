+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// drainExplore drains a one-task "demo" set carrying setKeys, with an earlier
+// Exploration report written first when report is non-empty, and returns how
+// many Explorer passes ran, the set directory, and the drain's output.
+func drainExplore(t *testing.T, setKeys map[string]any, report string, cfg *config.Config) (int, string, string) {
+	t.Helper()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", openAFKSet(), setKeys)
+	setDir := filepath.Join(env.tasksDir, "demo")
+	if report != "" {
+		writeTaskMD(t, setDir, ExplorationFileName, report)
+	}
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "done"})
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	passes := 0
+	opts.exploreRunner = func(string) (string, string, error) {
+		passes++
+		// The pass runs at the head of the drain: no task has been built yet.
+		m := LoadManifest(env.deps(), "demo", filepath.Join(setDir, ManifestFileName))
+		if m.Tasks[0].Status != TaskOpen {
+			t.Fatalf("Explorer ran after task %s reached %q", m.Tasks[0].ID, m.Tasks[0].Status)
+		}
+		return "## Where things live\n\nNEW MAP", "claude", nil
+	}
+
+	result, err := RunTaskSetWith(env.deps(), nil, func(string) (*config.Config, error) { return cfg, nil }, opts)
+	if err != nil {
+		t.Fatalf("RunTaskSetWith: %v", err)
+	}
+	if !result.TaskSetDone {
+		t.Fatalf("result = %+v, want the set's one task built to DONE", result)
+	}
+	return passes, setDir, buf.String()
+}
+
+func readExplorationFile(t *testing.T, setDir string) string {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(setDir, ExplorationFileName))
+	if err != nil {
+		t.Fatalf("read exploration report: %v", err)
+	}
+	return string(data)
+}
+
+// TestDrainExploresADeclaredSetOnceBeforeItBuilds drives a whole drain both
+// ways: a declared set with no report is explored before its task runs and
+// keeps the report the pass wrote, and one whose report is already there is
+// built against that report with no pass spent.
+func TestDrainExploresADeclaredSetOnceBeforeItBuilds(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no report", func(t *testing.T) {
+		t.Parallel()
+		passes, setDir, out := drainExplore(t, map[string]any{"explore": true}, "", nil)
+		if passes != 1 {
+			t.Fatalf("Explorer passes = %d, want 1", passes)
+		}
+		if doc := readExplorationFile(t, setDir); !strings.Contains(doc, "NEW MAP") {
+			t.Fatalf("exploration.md = %q, want the pass's report", doc)
+		}
+		if !strings.Contains(out, "━━ Explore for demo") {
+			t.Fatalf("output does not name the pass:\n%s", out)
+		}
+	})
+
+	t.Run("report present", func(t *testing.T) {
+		t.Parallel()
+		passes, setDir, _ := drainExplore(t, map[string]any{"explore": true}, "OLD MAP\n", nil)
+		if passes != 0 {
+			t.Fatalf("Explorer passes = %d, want the existing report reused", passes)
+		}
+		if doc := readExplorationFile(t, setDir); doc != "OLD MAP\n" {
+			t.Fatalf("exploration.md = %q, want the existing report untouched", doc)
+		}
+	})
+}
+
+// TestDrainSpendsNoExploreWhereNothingAsks: a set that never declared
+// exploration, a configuration that switched the step off, and a set a human
+// completed all drain to DONE without an Explorer.
+func TestDrainSpendsNoExploreWhereNothingAsks(t *testing.T) {
+	t.Parallel()
+	off := false
+	tests := []struct {
+		name    string
+		setKeys map[string]any
+		cfg     *config.Config
+	}{
+		{"undeclared", nil, nil},
+		{"declared false", map[string]any{"explore": false}, nil},
+		{"config off", map[string]any{"explore": true},
+			&config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Enabled: &off}}}},
+		{"human completed", map[string]any{"explore": true, "human_completed": true}, nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			passes, setDir, _ := drainExplore(t, tt.setKeys, "", tt.cfg)
+			if passes != 0 {
+				t.Fatalf("Explorer passes = %d, want none", passes)
+			}
+			if _, err := os.Stat(filepath.Join(setDir, ExplorationFileName)); !os.IsNotExist(err) {
+				t.Fatalf("exploration.md exists (err=%v), want none written", err)
+			}
+		})
+	}
+}
+
+// TestExplorerPrecedence: CLI flags beat the set's `explorer` object, which
+// beats [work.explore], which beats the implement list and the default effort.
+func TestExplorerPrecedence(t *testing.T) {
+	t.Parallel()
+	cfg := &config.Config{Work: &config.WorkConfig{
+		Implement: &config.ImplementConfig{Agents: config.AgentEntriesFromCommands("claude")},
