+// TestExploreThatFailsKeepsTheExistingReport: an Explorer that dies on every
+// try spends its own cap, files every run, and writes nothing — the half map
+// its last attempt left is not written over the whole one already there.
+func TestExploreThatFailsKeepsTheExistingReport(t *testing.T) {
+	t.Parallel()
+	dying := scriptedRefineRun{output: claudeRefineStream(`## Where things live\n\n- tasks/explore.go: the pa`), exitCode: 2}
+	d, _, opts, setDir := setupExploreFixture(t, nil, dying, dying, dying, dying, dying)
+
+	if _, err := exploreResolvedSet(d, nil, opts); err == nil {
+		t.Fatal("a pass whose every attempt died succeeded")
+	}
+	if got := readExplorationReport(t, setDir); got != "OLD MAP\n" {
+		t.Fatalf("existing report changed by a failed pass:\n%s", got)
+	}
+
+	runs, err := listSetRuns(d, setDir)
+	if err != nil {
+		t.Fatalf("listSetRuns: %v", err)
+	}
+	if len(runs) == 0 {
+		t.Fatal("a failed pass filed no captured run")
+	}
+	for _, run := range runs {
+		if run.meta.Phase != "explore" || run.meta.Outcome == streamOutcomeCompleted {
+			t.Fatalf("run meta = %+v, want a failed explore run", run.meta)
+		}
+	}
+	caps, err := AllSpentRetryCaps(d)
+	if err != nil {
+		t.Fatalf("AllSpentRetryCaps: %v", err)
+	}
+	if len(caps) != 1 || caps[0].Phase != "explore" || caps[0].SetID != "demo" || caps[0].Attempts != len(runs) {
+		t.Fatalf("spent caps = %+v, want one explore cap of %d attempts", caps, len(runs))
+	}
+}
