diff --git a/tasks/setkind/explore_section_test.go b/tasks/setkind/explore_section_test.go
new file mode 100644
index 00000000..839ef83a
--- /dev/null
+++ b/tasks/setkind/explore_section_test.go
@@ -0,0 +1,97 @@
+package setkind
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/deps"
+	"github.com/glebglazov/pop/tasks"
+	"github.com/glebglazov/pop/work"
+)
+
+const explorationSectionProse = "SECRET-EXPLORATION-PROSE"
+
+// containerForExploreMark builds the container a set produces when the refresh
+// resolved row's Explore mark, over a filesystem that holds the set directory.
+func containerForExploreMark(t *testing.T, row tasks.Row, setDir string) work.Container {
+	t.Helper()
+	rows := []tasks.Row{row}
+	d := testDeps(t, rows)
+	real := deps.NewRealFileSystem()
+	d.Tasks.FS = &deps.MockFileSystem{
+		EvalSymlinksFunc: func(path string) (string, error) { return path, nil },
+		ReadDirFunc:      real.ReadDir,
+		ReadFileFunc:     real.ReadFile,
+		StatFunc:         real.Stat,
+	}
+	m := &tasks.Manifest{Valid: true, Dir: setDir, Tasks: []tasks.Task{{ID: "01-a", File: "01-a.md", Type: "AFK", Status: "open"}}}
+	d.Refresh = func(string) (*tasks.RefreshResult, error) {
+		return &tasks.RefreshResult{Rows: rows, Manifests: map[string]*tasks.Manifest{row.ID: m}}, nil
+	}
+	scan := scanFixture{Name: "pop", ProjectPath: "/repo/main", RuntimePath: "/repo/main", DefinitionPath: "/def", RepoKey: "repo-key"}
+	got, err := rowsForStatic(d, &config.Config{}, staticForScan(scan, "main", false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 {
+		t.Fatalf("containers = %+v, want one", got)
+	}
+	return got[0]
+}
+
+func explorationSection(c work.Container) (work.Section, bool) {
+	for _, s := range c.DetailSections {
+		if s.Title == tasks.ExplorationSectionTitle {
+			return s, true
+		}
+	}
+	return work.Section{}, false
+}
+
+// TestDashboardCarriesTheExploreMark: the row's STATUS cell — which `pop work
+// status` prints too — and the detail view render the mark the refresh
+// resolved. An explored set's detail points at the report by path and the tree
+// it records, never its body; a set with no mark has neither.
+func TestDashboardCarriesTheExploreMark(t *testing.T) {
+	setDir := t.TempDir()
+	unexplored := containerForExploreMark(t, tasks.Row{ID: "demo", Status: tasks.StatusExploreFailed, ExploreMark: tasks.ExploreMarkUnexplored, UnexploredReason: tasks.UnexploredFailed}, setDir)
+	if cell := tasks.WorkRowStatusCell(unexplored); !strings.Contains(cell, "unexplored (the pass failed)") {
+		t.Fatalf("status cell = %q, want the mark with its reason", cell)
+	}
+	if s, ok := explorationSection(unexplored); !ok || s.Body != "Not explored: the pass failed" {
+		t.Fatalf("detail section = %+v, want the mark alone", s)
+	}
+
+	path := filepath.Join(setDir, tasks.ExplorationFileName)
+	body := "# Exploration report — demo\n\n- Explored: 2026-10-10T07:55:45Z\n- Work SHA: 647143bb0a85\n\n## Where things live\n\n" + explorationSectionProse + "\n"
+	if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	explored := containerForExploreMark(t, tasks.Row{ID: "demo", Status: tasks.StatusReady, ExploreMark: tasks.ExploreMarkExplored}, setDir)
+	if cell := tasks.WorkRowStatusCell(explored); !strings.Contains(cell, "explored") || strings.Contains(cell, "unexplored") {
+		t.Fatalf("status cell = %q, want explored", cell)
+	}
+	s, ok := explorationSection(explored)
+	if !ok {
+		t.Fatalf("no exploration section in %+v", explored.DetailSections)
+	}
+	for _, want := range []string{"Explored", path, "647143bb0a85", "2026-10-10 07:55Z"} {
+		if !strings.Contains(s.Body, want) {
+			t.Fatalf("section lacks %q:\n%s", want, s.Body)
+		}
+	}
+	if strings.Contains(s.Body, explorationSectionProse) {
+		t.Fatalf("section carries the report's body:\n%s", s.Body)
+	}
+
+	unasked := containerForExploreMark(t, tasks.Row{ID: "demo", Status: tasks.StatusReady}, setDir)
+	if cell := tasks.WorkRowStatusCell(unasked); strings.Contains(cell, "explored") {
+		t.Fatalf("status cell = %q, want no mark", cell)
+	}
+	if s, ok := explorationSection(unasked); ok {
+		t.Fatalf("set that never asked has a section: %+v", s)
+	}
