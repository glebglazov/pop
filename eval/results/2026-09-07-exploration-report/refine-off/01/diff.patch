--- /dev/null
+++ b/tasks/exploration_pointer.go
@@ -0,0 +1,62 @@
+package tasks
+
+import (
+	"path/filepath"
+	"time"
+)
+
+// ExplorationSectionTitle titles the Exploration report's block in the
+// dashboard detail view.
+const ExplorationSectionTitle = "Exploration"
+
+// explorationBlockView is the set's Exploration report as the implement and
+// Assist prompts name it: a path, never the body, so a long report costs the
+// prompt one line and every builder in the set reads the same map (ADR-0262).
+type explorationBlockView struct {
+	HasExploration bool
+	Path           string
+}
+
+// explorationBlock resolves that view for the set in setDir, and the empty view
+// — which renders nothing at all — for a set that has never been explored.
+func explorationBlock(d *Deps, setDir string) explorationBlockView {
+	if d == nil {
+		d = defaultDeps
+	}
+	path := filepath.Join(setDir, ExplorationFileName)
+	if _, err := d.FS.Stat(path); err != nil {
+		return explorationBlockView{}
+	}
+	return explorationBlockView{HasExploration: true, Path: path}
+}
+
+// ExplorationPointer is the set's Exploration report as a human surface carries
+// it — the sign-off gate, the dashboard detail view, `pop tasks status <set>`:
+// its path and the tree the header records, on the shared ReportPointer shape,
+// and false for a set that has never been explored. The body is read only for
+// that header.
+func ExplorationPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil {
+		return ReportPointer{}, false
+	}
+	block := explorationBlock(d, m.Dir)
+	if !block.HasExploration {
+		return ReportPointer{}, false
+	}
+	body, err := d.FS.ReadFile(block.Path)
+	if err != nil {
+		return ReportPointer{}, false
+	}
+	doc := string(body)
+	p := ReportPointer{Label: explorationReport.PointerLabel, Path: block.Path, WorkSHA: reportHeaderField(doc, "Work SHA")}
+	// The report is flat, so the instant comes from its header rather than its
+	// name; a header pop cannot parse still shows as written.
+	p.Written = reportHeaderField(doc, explorationReport.WrittenLabel)
+	if at, err := time.Parse(time.RFC3339, p.Written); err == nil {
+		p.Written = at.UTC().Format("2006-01-02 15:04Z")
+	}
+	return p, true
+}
