+}
+
+// TestResolveExplorerPrecedence covers the Explorer chain, highest first: CLI
+// flags → the per-set `explorer` object → [work.explore] →
+// [work.implement].agents / heavy, agents and effort resolving independently.
+func TestResolveExplorerPrecedence(t *testing.T) {
+	t.Parallel()
+	exploreCfg := func(agents []string, effort string) *config.Config {
+		return &config.Config{Work: &config.WorkConfig{
+			Explore: &config.ExploreConfig{Agents: config.AgentEntriesFromCommands(agents...), Effort: effort},
+		}}
+	}
+	withExplorer := func(agents []string, effort string) *Manifest {
+		raw, err := json.Marshal(AgentDirective{Agents: agents, Effort: effort})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return &Manifest{Unknown: map[string]json.RawMessage{ManifestKeyExplorer: raw}}
+	}
+
+	tests := []struct {
+		name       string
+		cliAgents  []string
+		cliEffort  string
+		manifest   *Manifest
+		cfg        *config.Config
+		wantAgents []string
+		wantEffort string
+	}{
+		{
+			name:       "default when nothing configured",
+			wantAgents: []string{DefaultAgentPreset},
+			wantEffort: DefaultExploreEffort,
+		},
+		{
+			name:       "config drives agents and effort",
+			cfg:        exploreCfg([]string{"codex", "claude"}, "standard"),
+			wantAgents: []string{"codex", "claude"},
+			wantEffort: "standard",
+		},
+		{
+			name: "omitted explore agents fall back to the implement list",
+			cfg: &config.Config{Work: &config.WorkConfig{
+				Implement: &config.ImplementConfig{Agents: config.AgentEntriesFromCommands("cursor")},
+			}},
+			wantAgents: []string{"cursor"},
+			wantEffort: DefaultExploreEffort,
+		},
+		{
+			name:       "per-set explorer overrides config",
+			manifest:   withExplorer([]string{"pi"}, "light"),
+			cfg:        exploreCfg([]string{"codex"}, "standard"),
+			wantAgents: []string{"pi"},
+			wantEffort: "light",
+		},
+		{
+			name:       "CLI overrides the per-set explorer",
+			cliAgents:  []string{"opencode"},
+			cliEffort:  "heavy",
+			manifest:   withExplorer([]string{"pi"}, "light"),
+			cfg:        exploreCfg([]string{"codex"}, "standard"),
+			wantAgents: []string{"opencode"},
+			wantEffort: "heavy",
+		},
+		{
+			name:       "per-set agents and effort resolve independently",
+			manifest:   withExplorer(nil, "light"),
+			cfg:        exploreCfg([]string{"codex"}, "standard"),
+			wantAgents: []string{"codex"},
+			wantEffort: "light",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			sel, err := resolveExplorer(tt.cliAgents, tt.cliEffort, tt.manifest, tt.cfg)
+			if err != nil {
+				t.Fatalf("resolveExplorer: %v", err)
+			}
+			if strings.Join(sel.Agents, ",") != strings.Join(tt.wantAgents, ",") {
+				t.Fatalf("agents = %v, want %v", sel.Agents, tt.wantAgents)
+			}
+			if sel.Effort != tt.wantEffort {
+				t.Fatalf("effort = %q, want %q", sel.Effort, tt.wantEffort)
+			}
+		})
+	}
+}
