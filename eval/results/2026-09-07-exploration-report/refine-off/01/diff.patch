index 00000000..b1c467fc
--- /dev/null
+++ b/tasks/explore_phase.go
@@ -0,0 +1,87 @@
+package tasks
+
+import "strings"
+
+// exploreDirective is what explorePhase hands back to the drain loop: proceed to
+// task selection, or end the run with the returned error.
+type exploreDirective int
+
+const (
+	// exploreProceed goes on to the loop's first task selection: the set needed
+	// no report, already had one, or has one now.
+	exploreProceed exploreDirective = iota
+	// exploreReturn hands the run's result and the returned error back to the
+	// caller: the human interrupted the Explorer, which interrupts the drain, or
+	// the set is parked at EXPLORE-FAILED.
+	exploreReturn
+)
+
+// explorePhase runs the drain's Explore step (ADR-0262): a set carrying
+// `"explore": true` that has no Exploration report gets one from a fresh
+// Explorer before its first task is selected, so every builder in the set
+// starts from the same map.
+//
+// It runs once, at the head of the drain, and only on absence. Nothing compares
+// the report's recorded work SHA to the checkout: every implement attempt
+// commits, so a freshness rule would re-explore after each task. A set that
+// already has a report reuses it and spends nothing here.
+//
+// [work.explore].enabled defaults on, the one agent step that runs unasked. That
+// is safe because the set's own declaration is the trigger: a set that never
+// asked is untouched. A human-completed set is skipped, as the Refine step skips
+// one; `pop tasks explore` still explores it on request.
+//
+// It is the one agent step that can stop a drain: a pass that gives up parks
+// the set at EXPLORE-FAILED rather than letting builders start blind, and
+// `--skip-explore` is the human's way to drain it once regardless.
+func (r *implementRun) explorePhase() (exploreDirective, error) {
+	cfg := r.plan.cfg
+	m := r.refresh.Manifests[r.taskSetID]
+	if m == nil || m.HumanCompleted || !m.ExploreRequested() {
+		return exploreProceed, nil
+	}
+	if r.opts.SkipExplore {
+		// The human chose to build this one drain without a map; nothing is
+		// explored and nothing parks, so the next drain asks again.
+		outputFor(r.out).line(ansiDim, "━━ Skipping exploration for %s (--skip-explore)", r.taskSetID)
+		return exploreProceed, nil
+	}
+	if ResolveExplorePark(r.d, m) {
+		// A parked set leaves through a door a human opens, never by a drain
+		// retrying the pass that already spent its cap.
+		return exploreReturn, exitErr(ExitNoRunnable, "Task set %q is %s: %s", r.taskSetID, strings.ToLower(string(StatusExploreFailed)), exploreParkWaysOut(r.taskSetID))
+	}
+	if !cfg.ExploreEnabled() {
+		return exploreProceed, nil
+	}
+	if explorationBlock(r.d, m.Dir).HasExploration {
+		return exploreProceed, nil
+	}
+
+	_, err := exploreResolvedSet(r.d, cfg, exploreCoreOptions{
+		DefPath:     r.resolved.DefinitionPath,
+		RuntimePath: r.runtimePath,
+		SetID:       r.taskSetID,
+		Timeout:     r.timeout,
+		Output:      r.out,
+		runExplorer: r.opts.exploreRunner,
+		probeMemo:   r.agentProbeMemo,
+		// The drain already holds this checkout for this set, so the Explorer
+		// runs inside that claim rather than asking for it again (ADR-0238).
+		checkoutHeld: true,
+	})
+	if err == nil {
+		return exploreProceed, nil
+	}
+	if isInterrupted(err) {
+		return exploreReturn, err
+	}
+	// The pass spent its retry cap without a report. Building on would hand the
+	// set's builders separate maps, which is what the author declared it must not
+	// have, so the drain stops here and the set reads EXPLORE-FAILED.
+	r.result.TaskSetExploreFailed = true
+	r.result.BlockedReason = exploreParkWaysOut(r.taskSetID)
+	outputFor(r.out).line(ansiRed, "━━ Exploration did not produce a report for %s: %v", r.taskSetID, err)
+	printTaskSetSummary(r.out, r.result)
+	return exploreReturn, nil
+}
