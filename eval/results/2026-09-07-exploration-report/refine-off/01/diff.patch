@@ -0,0 +1,191 @@
+package tasks
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+)
+
+// promptCapturingRunner keeps the prompt each agent invocation was handed. The
+// prompt reaches the agent as a spilled file named in argv, removed once the
+// attempt ends, so it is read while the invocation is starting.
+type promptCapturingRunner struct {
+	inner   CommandRunner
+	prompts []string
+}
+
+var spilledPromptPath = regexp.MustCompile(`\S*pop-agent-prompt-\S*\.md`)
+
+func (r *promptCapturingRunner) Run(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (int, error) {
+	return r.inner.Run(ctx, dir, stdout, stderr, name, args...)
+}
+
+func (r *promptCapturingRunner) Start(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (*ManagedProcess, error) {
+	for _, arg := range args {
+		if path := spilledPromptPath.FindString(arg); path != "" {
+			if data, err := os.ReadFile(path); err == nil {
+				r.prompts = append(r.prompts, string(data))
+			}
+		}
+	}
+	return r.inner.Start(ctx, dir, stdout, stderr, name, args...)
+}
+
+func (r *promptCapturingRunner) StartWithEnv(ctx context.Context, dir string, env []string, stdout, stderr io.Writer, name string, args ...string) (*ManagedProcess, error) {
+	return r.Start(ctx, dir, stdout, stderr, name, args...)
+}
+
+// setupExploreFixture writes a "demo" set of two tasks and a spec, with no
+// `explore` key in its manifest, and an agent runner that replays runs.
+func setupExploreFixture(t *testing.T, runs ...scriptedRefineRun) (*Deps, *promptCapturingRunner, string, string) {
+	t.Helper()
+	d, _ := refineRunnerDeps(t, runs...)
+	runner := &promptCapturingRunner{inner: d.Runner}
+	d.Runner = runner
+	defPath := filepath.Join(t.TempDir(), "tasks")
+	setDir := filepath.Join(defPath, "demo")
+	writeManifest(t, setDir, []Task{
+		{ID: "01-a", File: "01-a.md", Title: "Report is an artifact", Type: "AFK", Status: "done"},
+		{ID: "02-b", File: "02-b.md", Title: "Explore by hand", Type: "AFK", Status: "open", BlockedBy: []string{"01-a"}},
+	})
+	writeTaskMD(t, setDir, "01-a.md", "## What to build\n\nList exploration.md beside the spec.\n\n## Acceptance criteria\n\n- [x] listed\n")
+	writeTaskMD(t, setDir, "02-b.md", "## What to build\n\nAdd `pop tasks explore`.\n\n## Acceptance criteria\n\n- [ ] explored\n")
+	writeTaskMD(t, setDir, SpecFileName, "# Exploration\n\nExplore once before implementing.\n")
+	return d, runner, defPath, setDir
+}
+
+func exploreOpts(defPath string, out *bytes.Buffer) exploreCoreOptions {
+	return exploreCoreOptions{
+		DefPath:     defPath,
+		RuntimePath: "/rt",
+		SetID:       "demo",
+		Agents:      []string{"claude"},
+		Timeout:     time.Minute,
+		Output:      out,
+	}
+}
+
+// TestExploreWritesTheReportFromAFreshAgent drives one hand-run pass through the
+// real agent walk: what the Explorer is handed, the report it leaves flat in the
+// set directory over the one already there, and the Captured run it is filed as.
+func TestExploreWritesTheReportFromAFreshAgent(t *testing.T) {
+	t.Parallel()
+	d, runner, defPath, setDir := setupExploreFixture(t,
+		scriptedRefineRun{output: claudeRefineStream("## Where things live\\n- `tasks/explore.go`: the pass.")},
+	)
+	reportPath := filepath.Join(setDir, ExplorationFileName)
+	writeTaskMD(t, setDir, ExplorationFileName, "an older map\n")
+
+	var out bytes.Buffer
+	result, err := exploreResolvedSet(d, nil, exploreOpts(defPath, &out))
+	if err != nil {
+		t.Fatalf("exploreResolvedSet: %v\n%s", err, out.String())
+	}
+
+	// The set never asked for exploration; a hand run explores it anyway.
+	if LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName)).ExploreRequested() {
+		t.Fatal("fixture set must not request exploration")
+	}
+
+	if len(runner.prompts) != 1 {
+		t.Fatalf("prompts handed to an agent = %d, want one", len(runner.prompts))
+	}
+	prompt := runner.prompts[0]
+	for _, want := range []string{
+		"## Manifest listing",
+		"- 01-a [AFK done] Report is an artifact (" + filepath.Join(setDir, "01-a.md") + ")",
+		"- 02-b [AFK open] Explore by hand (" + filepath.Join(setDir, "02-b.md") + "); blocked_by: 01-a",
+		"List exploration.md beside the spec.",
+		"Add `pop tasks explore`.",
+		"Explore once before implementing.",
+		"Every claim names a path or a symbol",
+		"about one page",
+		"the branch and the commit",
+	} {
+		if !strings.Contains(prompt, want) {
+			t.Errorf("Explorer prompt missing %q:\n%s", want, prompt)
+		}
+	}
+	if strings.Contains(strings.ToLower(prompt), "prior art") || strings.Contains(strings.ToLower(prompt), "prior-art") {
+		t.Errorf("Explorer prompt asks about prior art:\n%s", prompt)
+	}
+
+	data, err := os.ReadFile(reportPath)
+	if err != nil {
+		t.Fatalf("read report: %v", err)
+	}
+	report := string(data)
+	if result.Path != reportPath || strings.Contains(report, "an older map") {
+		t.Fatalf("report at %s = %q, want the new pass's report written over the old one at %s", result.Path, report, reportPath)
+	}
+	for _, want := range []string{
+		"# Exploration report — demo",
+		"- Explored: 2026-08-17T18:00:00Z",
+		"- Work SHA: sha1",
+		"- Explorer: claude",
+		"- `tasks/explore.go`: the pass.",
+	} {
+		if !strings.Contains(report, want) {
+			t.Errorf("report missing %q:\n%s", want, report)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(setDir, "explore")); !os.IsNotExist(err) {
+		t.Errorf("an explore/ directory exists; the report is flat")
+	}
+
+	runs, err := listSetRuns(d, setDir)
+	if err != nil {
+		t.Fatalf("listSetRuns: %v", err)
+	}
+	if len(runs) != 1 || runs[0].meta.Phase != "explore" || runs[0].meta.TaskFile != "" || runs[0].meta.WorkSHA != "sha1" {
+		t.Fatalf("captured runs = %+v, want one set-level explore run at sha1", runs)
+	}
+	m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+	breakdown, err := buildSpendSetBreakdown(d, "demo", m, loadRateTableForSpend(d), nil)
+	if err != nil {
+		t.Fatalf("buildSpendSetBreakdown: %v", err)
+	}
+	if breakdown.ExploreRunCount != 1 || breakdown.ImplementRunCount != 0 || len(breakdown.Rows) != 1 || breakdown.Rows[0].TaskID != "explore" {
+		t.Fatalf("spend = explore %d / implement %d, rows %+v, want one explore row", breakdown.ExploreRunCount, breakdown.ImplementRunCount, breakdown.Rows)
+	}
+}
+
+// TestFailedExploreLeavesTheReportUntouched: a pass whose every attempt dies
+// writes nothing, so the set keeps the report it had, and the spent attempts are
+// still filed under the explore phase.
+func TestFailedExploreLeavesTheReportUntouched(t *testing.T) {
+	t.Parallel()
+	d, _, defPath, setDir := setupExploreFixture(t,
+		scriptedRefineRun{output: claudeRefineStream("## Where things live"), exitCode: 1},
+		scriptedRefineRun{output: claudeRefineStream("## Where things live"), exitCode: 1},
+		scriptedRefineRun{output: claudeRefineStream("## Where things live"), exitCode: 1},
+	)
+	writeTaskMD(t, setDir, ExplorationFileName, "an older map\n")
+
+	var out bytes.Buffer
+	if _, err := exploreResolvedSet(d, nil, exploreOpts(defPath, &out)); err == nil {
+		t.Fatal("a pass with no complete answer must fail")
+	}
+	data, err := os.ReadFile(filepath.Join(setDir, ExplorationFileName))
+	if err != nil || string(data) != "an older map\n" {
+		t.Fatalf("report = %q, %v; want the old report untouched", data, err)
+	}
+	runs, err := listSetRuns(d, setDir)
+	if err != nil {
+		t.Fatalf("listSetRuns: %v", err)
+	}
+	if len(runs) != 3 {
+		t.Fatalf("captured runs = %d, want each spent attempt filed", len(runs))
+	}
+	for _, run := range runs {
+		if run.meta.Phase != "explore" {
+			t.Fatalf("run phase = %q, want explore", run.meta.Phase)
+		}
+	}
+}
