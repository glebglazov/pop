+// interrelatedSet is two AFK tasks where the second builds on the first: the
+// shape a set's author declares `"explore": true` for.
+func interrelatedSet() []Task {
+	return []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+		{ID: "02-b", File: "02-b.md", Title: "B", Type: "AFK", Status: "open", BlockedBy: []string{"01-a"}},
+	}
+}
+
+// drainWithExplorer drains the "demo" set to completion and returns how many
+// times an Explorer was spawned, the open-task count each spawn saw, and the
+// drain's output.
+func drainWithExplorer(t *testing.T, env *runTaskSetFixture, cfg *config.Config) (int, []int, string) {
+	t.Helper()
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	var openAtSpawn []int
+	opts.exploreRunner = func(string) (string, string, error) {
+		m := LoadManifest(env.deps(), "demo", filepath.Join(env.tasksDir, "demo", ManifestFileName))
+		open := 0
+		for _, task := range m.Tasks {
+			if task.Status == "open" {
+				open++
+			}
+		}
+		openAtSpawn = append(openAtSpawn, open)
+		return "## Where things live\n\n- `tasks/a.go`: the seam.", "claude", nil
+	}
+	result, err := RunTaskSetWith(env.deps(), nil, func(string) (*config.Config, error) { return cfg, nil }, opts)
+	if err != nil {
+		t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+	}
+	if len(result.Completed) != 2 {
+		t.Fatalf("completed = %d, want both tasks drained whatever exploration did\n%s", len(result.Completed), buf.String())
+	}
+	return len(openAtSpawn), openAtSpawn, buf.String()
+}
+
+// TestDrainExploresADeclaredSetOnlyWhenItHasNoReport drives a whole drain of a
+// set that asked for exploration, both ways: with no report the Explorer runs
+// once, before any task, and leaves the report; with a report already there the
+// drain reuses it and spawns no Explorer at all.
+func TestDrainExploresADeclaredSetOnlyWhenItHasNoReport(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no report", func(t *testing.T) {
+		t.Parallel()
+		env := setupRunTaskSetFixtureWithKeys(t, "demo", interrelatedSet(), map[string]any{ManifestKeyExplore: true})
+
+		spawns, openAtSpawn, out := drainWithExplorer(t, env, nil)
+
+		if spawns != 1 || openAtSpawn[0] != 2 {
+			t.Fatalf("Explorer spawns = %d seeing %v open tasks, want one spawn before either task ran\n%s", spawns, openAtSpawn, out)
+		}
+		if !strings.Contains(out, "━━ Exploration for demo") {
+			t.Fatalf("output names no exploration:\n%s", out)
+		}
+		data, err := os.ReadFile(filepath.Join(env.tasksDir, "demo", ExplorationFileName))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		if !strings.Contains(string(data), "- `tasks/a.go`: the seam.") {
+			t.Fatalf("report = %q, want the Explorer's map", data)
+		}
+	})
+
+	t.Run("report already there", func(t *testing.T) {
+		t.Parallel()
+		env := setupRunTaskSetFixtureWithKeys(t, "demo", interrelatedSet(), map[string]any{ManifestKeyExplore: true})
+		reportPath := filepath.Join(env.tasksDir, "demo", ExplorationFileName)
+		// Its recorded SHA describes no commit in this checkout; nothing reads it.
+		writeTaskMD(t, filepath.Join(env.tasksDir, "demo"), ExplorationFileName, "# Exploration report — demo\n\n- Work SHA: 0000000\n\nthe first map\n")
+
+		spawns, _, out := drainWithExplorer(t, env, nil)
+
+		if spawns != 0 {
+			t.Fatalf("Explorer spawns = %d, want the existing report reused\n%s", spawns, out)
+		}
+		data, err := os.ReadFile(reportPath)
+		if err != nil || !strings.Contains(string(data), "the first map") {
+			t.Fatalf("report = %q (%v), want the existing one untouched", data, err)
+		}
+	})
+}
+
+// TestDrainExploresNothingItWasNotAskedTo: the step is triggered by the set's
+// own declaration, so a set that never declared, a machine that switched the
+// step off, and a set a human already completed all drain with no Explorer.
+func TestDrainExploresNothingItWasNotAskedTo(t *testing.T) {
+	t.Parallel()
+	off := false
+	tests := []struct {
+		name    string
+		setKeys map[string]any
+		cfg     *config.Config
+	}{
+		{name: "set never declared", setKeys: map[string]any{}},
+		{name: "declared as false", setKeys: map[string]any{ManifestKeyExplore: false}},
+		{
+			name:    "config off",
+			setKeys: map[string]any{ManifestKeyExplore: true},
+			cfg:     &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Enabled: &off}}},
+		},
+		{name: "human-completed set", setKeys: map[string]any{ManifestKeyExplore: true, "human_completed": true}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			env := setupRunTaskSetFixtureWithKeys(t, "demo", interrelatedSet(), tt.setKeys)
+
+			spawns, _, out := drainWithExplorer(t, env, tt.cfg)
+
+			if spawns != 0 {
+				t.Fatalf("Explorer spawns = %d, want none\n%s", spawns, out)
+			}
+			if _, err := os.Stat(filepath.Join(env.tasksDir, "demo", ExplorationFileName)); !os.IsNotExist(err) {
+				t.Fatalf("an Exploration report exists (%v), want none", err)
+			}
+		})
+	}
+}
+
+// TestHandExploreIgnoresTheConfigSwitch: switching the drain step off leaves
+// `pop tasks explore` working, as a human asking is not the drain asking.
+func TestHandExploreIgnoresTheConfigSwitch(t *testing.T) {
+	t.Parallel()
+	d, _, defPath, setDir := setupExploreFixture(t,
+		scriptedRefineRun{output: claudeRefineStream("## Where things live\\n- `tasks/explore.go`: the pass.")},
+	)
+	off := false
+	cfg := &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Enabled: &off}}}
+
+	var out bytes.Buffer
+	if _, err := exploreResolvedSet(d, cfg, exploreOpts(defPath, &out)); err != nil {
+		t.Fatalf("exploreResolvedSet: %v\n%s", err, out.String())
