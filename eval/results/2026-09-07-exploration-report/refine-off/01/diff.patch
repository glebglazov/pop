+// TestTaskGuideExploreKeysAreTheOnesTheManifestReads takes the explore and
+// explorer key names out of the printed guide, not from the constants, writes
+// them into a set that also holds an Exploration report, and reads them back
+// through the manifest's accessors. A key the guide teaches but the manifest
+// does not honour fails here.
+func TestTaskGuideExploreKeysAreTheOnesTheManifestReads(t *testing.T) {
+	t.Parallel()
+	guide := AuthoringGuide()
+
+	printedKey := func(pattern string) string {
+		t.Helper()
+		match := regexp.MustCompile(pattern).FindStringSubmatch(guide)
+		if match == nil {
+			t.Fatalf("guide has no line matching %q", pattern)
+		}
+		return match[1]
+	}
+	exploreKey := printedKey("(?m)^- `([a-z_]+)` — optional boolean, and opt-\\*\\*in\\*\\*")
+	explorerKey := printedKey("(?m)^- `([a-z_]+)` — optional `\\{\"agents\"[^\n]*\n\\s*object steering \\*how\\* this set is explored")
+
+	for name, want := range map[string]string{
+		"absent or false never explores": "absent or `false` means the set never\n  explores",
+		"the rule for setting it":        "two or more AFK tasks touch the same\n  seam and a later one depends on how an earlier one shapes it",
+		"the report is exempt":           ExplorationFileName + " aside",
+	} {
+		if !strings.Contains(guide, want) {
+			t.Fatalf("guide is missing the %s text (%q)", name, want)
+		}
+	}
+
+	setDir := filepath.Join(t.TempDir(), "2026-09-07-demo")
+	if err := os.MkdirAll(setDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(setDir, "01-login-form.md"), []byte(fencedBlock(t, guide, "markdown", 0)+"\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(setDir, ExplorationFileName), []byte("# Exploration report\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	manifest := `{
+  "` + exploreKey + `": true,
+  "` + explorerKey + `": {"agents": ["claude --model opus"], "effort": "heavy"},
+  "tasks": [{"id": "01-login-form", "file": "01-login-form.md", "title": "Login", "type": "AFK", "status": "open", "blocked_by": []}]
+}`
+	manifestPath := filepath.Join(setDir, ManifestFileName)
+	if err := os.WriteFile(manifestPath, []byte(manifest), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	m := LoadManifest(&Deps{FS: deps.NewRealFileSystem()}, "2026-09-07-demo", manifestPath)
+	if !m.Valid {
+		t.Fatalf("a set asking for exploration does not validate: %v", m.Errors)
+	}
+	if !m.ExploreRequested() {
