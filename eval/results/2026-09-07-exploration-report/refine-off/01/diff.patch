+package tasks
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// recordExplorePass files one Explorer invocation the way the shared fallback
+// walk files it, through the role's own persist seam.
+func recordExplorePass(t *testing.T, d *Deps, setDir, streamOutcome string) {
+	t.Helper()
+	invocation, err := ResolveAgentInvocationWithMode("claude", "", "prompt", "/rt", AgentOutputAuto)
+	if err != nil {
+		t.Fatalf("resolve invocation: %v", err)
+	}
+	rec := newStreamRecorder(io.Discard, fakeClock(time.Date(2026, 9, 7, 12, 0, 0, 0, time.UTC), 100*time.Millisecond))
+	explorerRole(d, io.Discard, setDir, "demo", "sha1").persist(rec, invocation, 1, streamOutcome, "exit status 1", 1)
+}
+
+// exploreParkRecords is how many EXPLORE-FAILED records the set's progress holds.
+func exploreParkRecords(t *testing.T, setDir string) int {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(setDir, "progress.txt"))
+	if err != nil && !os.IsNotExist(err) {
+		t.Fatalf("read progress: %v", err)
+	}
+	return strings.Count(string(data), "[set] "+string(StatusExploreFailed))
+}
+
+// TestExploreParkDerivesFromTheLatestRun asks the read-side resolution about
+// every way the set and its last explore run can stand: only a declared, READY
+// set with no report whose pass ended other than by an interrupt is parked.
+func TestExploreParkDerivesFromTheLatestRun(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name    string
+		keys    map[string]any
+		outcome string
+		report  bool
+		want    bool
+	}{
+		{name: "no pass has run yet", keys: map[string]any{ManifestKeyExplore: true}},
+		{name: "the pass failed", keys: map[string]any{ManifestKeyExplore: true}, outcome: streamOutcomeFailed, want: true},
+		{name: "the pass ran clean and wrote nothing", keys: map[string]any{ManifestKeyExplore: true}, outcome: streamOutcomeCompleted, want: true},
+		{name: "the human interrupted it", keys: map[string]any{ManifestKeyExplore: true}, outcome: streamOutcomeInterrupted},
+		{name: "a report exists", keys: map[string]any{ManifestKeyExplore: true}, outcome: streamOutcomeFailed, report: true},
+		{name: "the declaration was retracted", keys: map[string]any{ManifestKeyExplore: false}, outcome: streamOutcomeFailed},
+		{name: "a human completed the set", keys: map[string]any{ManifestKeyExplore: true, "human_completed": true}, outcome: streamOutcomeFailed},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			d, _, _, setDir := setupExploreFixture(t)
+			m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+			writeManifestWithSetKeys(t, setDir, m.Tasks, tc.keys)
+			if tc.outcome != "" {
+				recordExplorePass(t, d, setDir, tc.outcome)
+			}
+			if tc.report {
+				writeTaskMD(t, setDir, ExplorationFileName, "a map\n")
+			}
+			m = LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+			if got := ResolveExplorePark(d, m); got != tc.want {
+				t.Fatalf("parked = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+// TestHandExploreParksAndAHandPassClearsIt drives the pass through the real
+// agent walk: it retries up to the cap, parks the declared set with one
+// progress record, and the next pass that writes a report clears the park.
+func TestHandExploreParksAndAHandPassClearsIt(t *testing.T) {
+	t.Parallel()
+	failed := scriptedRefineRun{output: claudeRefineStream("## Where things live"), exitCode: 1}
+	d, runner, defPath, setDir := setupExploreFixture(t, failed, failed, failed,
+		scriptedRefineRun{output: claudeRefineStream("## Where things live\\n- `tasks/explore.go`: the pass.")},
+	)
+	m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+	writeManifestWithSetKeys(t, setDir, m.Tasks, map[string]any{ManifestKeyExplore: true})
+
+	var out bytes.Buffer
+	if _, err := exploreResolvedSet(d, nil, exploreOpts(defPath, &out)); err == nil {
+		t.Fatal("a pass with no complete answer must fail")
+	}
+	if len(runner.prompts) != config.DefaultTaskMaxTries {
+		t.Fatalf("attempts = %d, want the pass to spend its cap of %d", len(runner.prompts), config.DefaultTaskMaxTries)
+	}
+	m = LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+	if !ResolveExplorePark(d, m) {
+		t.Fatal("the set is not parked after its pass gave up")
+	}
+	if n := exploreParkRecords(t, setDir); n != 1 {
+		t.Fatalf("park records = %d, want exactly one", n)
+	}
+	data, _ := os.ReadFile(filepath.Join(setDir, "progress.txt"))
+	if !strings.Contains(string(data), "phase explore gave up") {
+		t.Fatalf("progress = %q, want the phase and the reason", data)
+	}
+
+	if _, err := exploreResolvedSet(d, nil, exploreOpts(defPath, &out)); err != nil {
+		t.Fatalf("second pass: %v\n%s", err, out.String())
+	}
+	if ResolveExplorePark(d, m) {
+		t.Fatal("a pass that wrote the report left the set parked")
+	}
+}
+
+// failingExploreDrain drains "demo" once with an Explorer that files a failed
+// run and gives up, the way a walk that spent its cap ends.
+func failingExploreDrain(t *testing.T, env *runTaskSetFixture, skip bool) (*RunTaskSetResult, int, string, error) {
+	t.Helper()
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.SkipExplore = skip
+	spawns := 0
+	opts.exploreRunner = func(string) (string, string, error) {
+		spawns++
+		recordExplorePass(t, env.deps(), filepath.Join(env.tasksDir, "demo"), streamOutcomeFailed)
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", "demo")
+	}
+	result, err := RunTaskSetWith(env.deps(), nil, func(string) (*config.Config, error) { return nil, nil }, opts)
+	return result, spawns, buf.String(), err
+}
+
+// TestDrainParksASetItCannotExplore: a drain whose Explore pass gives up builds
+// nothing and leaves the set at EXPLORE-FAILED, which automatic selection passes
+// over and a second drain refuses rather than re-exploring. --skip-explore then
+// drains it once with no Explorer and no further park.
+func TestDrainParksASetItCannotExplore(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", interrelatedSet(), map[string]any{ManifestKeyExplore: true})
+	setDir := filepath.Join(env.tasksDir, "demo")
+
+	result, spawns, out, err := failingExploreDrain(t, env, false)
+	if err != nil {
+		t.Fatalf("parking drain: %v\n%s", err, out)
+	}
+	if spawns != 1 || len(result.Completed) != 0 || !result.TaskSetExploreFailed {
+		t.Fatalf("spawns = %d, completed = %d, explore-failed = %v; want one pass, no task, a park\n%s", spawns, len(result.Completed), result.TaskSetExploreFailed, out)
+	}
+	refresh, err := RefreshWith(env.deps(), env.tasksDir, DefaultStatePathWith(env.deps()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if row := findRow(refresh, "demo"); row == nil || row.Status != StatusExploreFailed {
+		t.Fatalf("row = %+v, want EXPLORE-FAILED", row)
+	}
+	if _, err := SelectTask(refresh, "", ""); err == nil {
+		t.Fatal("automatic selection picked a parked set")
+	}
+	if n := exploreParkRecords(t, setDir); n != 1 {
+		t.Fatalf("park records = %d, want exactly one", n)
+	}
+
+	_, spawns, out, err = failingExploreDrain(t, env, false)
+	if err == nil || spawns != 0 {
+		t.Fatalf("second drain: err = %v, spawns = %d; want a refusal with no pass\n%s", err, spawns, out)
+	}
+
+	result, spawns, out, err = failingExploreDrain(t, env, true)
+	if err != nil {
+		t.Fatalf("--skip-explore drain: %v\n%s", err, out)
+	}
+	if spawns != 0 || len(result.Completed) != 2 {
+		t.Fatalf("spawns = %d, completed = %d; want both tasks drained unexplored\n%s", spawns, len(result.Completed), out)
+	}
+	if n := exploreParkRecords(t, setDir); n != 1 {
+		t.Fatalf("park records = %d, want the skip to add none", n)
+	}
+}
