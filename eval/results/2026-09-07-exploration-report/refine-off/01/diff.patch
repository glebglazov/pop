+// TestLoadWorkExploreSettings pins the [work.explore] group (ADR-0262): the one
+// Work step that defaults on, since a set's own `explore` key is its trigger,
+// with an explicit false switching it off and agents and effort beside it.
+func TestLoadWorkExploreSettings(t *testing.T) {
+	load := func(t *testing.T, body string) *Config {
+		t.Helper()
+		configPath := filepath.Join(t.TempDir(), "config.toml")
+		if err := os.WriteFile(configPath, []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		cfg, err := LoadWith(isolatedDeps(t), configPath)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return cfg
+	}
+
+	var nilCfg *Config
+	if !nilCfg.ExploreEnabled() {
+		t.Error("nil config: ExploreEnabled() = false, want the default on")
+	}
+	if !load(t, "\n").ExploreEnabled() {
+		t.Error("undeclared [work.explore]: ExploreEnabled() = false, want the default on")
+	}
+	if !load(t, "[work.explore]\neffort = \"light\"\n").ExploreEnabled() {
+		t.Error("[work.explore] without enabled: ExploreEnabled() = false, want the default on")
+	}
+
+	cfg := load(t, `
+[work.explore]
+enabled = false
+effort = "standard"
+agents = ["codex", "claude"]
+`)
+	if cfg.ExploreEnabled() {
+		t.Error("[work.explore] enabled = false: ExploreEnabled() = true")
+	}
+	if e := cfg.ExploreSettings(); e == nil || e.Effort != "standard" {
+		t.Fatalf("explore settings = %+v, want effort standard", e)
+	}
+	if got := strings.Join(cfg.ExploreAgentList().Commands, ","); got != "codex,claude" {
+		t.Fatalf("explore agents = %q, want codex,claude", got)
+	}
+}
