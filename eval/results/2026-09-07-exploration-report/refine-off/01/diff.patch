+)
+
+// DefaultExploreEffort is the model-strength tier the Explorer runs at when
+// neither a CLI flag nor the set's `explorer` object names one: every builder in
+// the set reads the map it draws, so a wrong line costs each attempt after it.
+const DefaultExploreEffort = "heavy"
+
+// explorationReport is the Exploration report's header and render on the shared
+// pass-report machinery (ADR-0262). It is flat — one `exploration.md` beside the
+// spec, rewritten in place — so it carries no directory or file prefix, and the
+// timestamped filing and newest-by-timestamp scan stay with the two families
+// that rerun.
+var explorationReport = passReport{
+	ArtifactType: ArtifactTypeExploration,
+	Title:        "Exploration report",
+	WrittenLabel: "Explored",
+	AgentLabel:   "Explorer",
+	Noun:         "exploration",
+	PointerLabel: "Exploration",
+}
+
+// ExploreOptions configures a `pop tasks explore <set>` run.
+type ExploreOptions struct {
+	ResolveInput ResolveInput
+	// TaskSetID is the bare Task-set identifier to explore.
+	TaskSetID string
+	// Agents is the ordered CLI Explorer fallback list (`--agent`, repeatable).
+	// Empty ⇒ resolution falls through to the set's `explorer` object, then
+	// [work.explore].agents, then [work.implement].agents.
+	Agents []string
+	// Effort is the CLI Explorer effort override (`--effort`). Empty ⇒ the set's
+	// `explorer` object, then [work.explore].effort, then DefaultExploreEffort.
+	Effort string
+	// Timeout bounds the single Explorer attempt. Zero uses DefaultAttemptTimeout.
+	Timeout time.Duration
+	// Output receives the live agent stream and the run's chrome.
+	Output io.Writer
+	// Wait is the `--wait` / `--no-wait` tri-state for admission to the checkout
+	// (ADR-0239). The unset default waits at a terminal and refuses elsewhere.
+	Wait AdmissionWaitChoice
+	// ConfirmIn is the invocation's input, read only to tell a human at a
+	// terminal from a script when resolving Wait.
+	ConfirmIn io.Reader
+}
+
+// ExploreResult is the outcome of one explore pass.
+type ExploreResult struct {
+	SetID   string
+	WorkSHA string
+	// Path is the Exploration report written.
+	Path string
+	// Body is the document itself.
+	Body string
+}
+
+// exploreCoreOptions carries the already-resolved inputs to the core explore
+// routine, so tests can drive it without real path-resolution git calls. The
+// runExplorer seam replaces the real agent spawn in tests.
+type exploreCoreOptions struct {
+	DefPath     string
+	RuntimePath string
+	SetID       string
+	Agents      []string
+	Effort      string
+	Timeout     time.Duration
+	Output      io.Writer
+	// runExplorer returns the Explorer's report and the agent that wrote it.
+	runExplorer func(prompt string) (string, string, error)
+	probeMemo   *agentAvailabilityProbeMemo
+	// admission is the policy the Explorer acquires the checkout under
+	// (ADR-0238/0239).
+	admission AdmissionPolicy
+	// checkoutHeld says the caller is already inside a claim on this checkout —
+	// the drain's own explore step, under the drain's running Drain row — so the
+	// Explorer takes nothing, as the drain's Refiner does not.
+	checkoutHeld bool
+}
+
+// ExploreTaskSet explores a set using default dependencies.
+func ExploreTaskSet(opts ExploreOptions) (*ExploreResult, error) {
+	return ExploreTaskSetWith(defaultDeps, project.DefaultDeps(), config.Load, opts)
+}
+
+// ExploreTaskSetWith is `pop tasks explore <set>` (ADR-0262): it resolves the
+// set, hands a fresh Explorer the set's manifest listing, task bodies and spec,
+// and writes what comes back as the set's Exploration report. A hand run is the
+// human re-opening the question, so it runs whatever the set's `explore` key
+// says and rewrites a report that already exists.
+func ExploreTaskSetWith(d *Deps, pd *project.Deps, loadConfig func(string) (*config.Config, error), opts ExploreOptions) (*ExploreResult, error) {
+	resolved, err := ResolvePathsWith(d, pd, loadConfig, opts.ResolveInput)
+	if err != nil {
+		return nil, err
+	}
+	runtimePath, err := ResolveRuntimePathWith(d, resolved.ProjectPath, opts.ResolveInput.RuntimeOverride)
+	if err != nil {
+		return nil, err
+	}
+	cfg, _ := loadConfig(d.defaultConfigPath())
+	return exploreResolvedSet(d, cfg, exploreCoreOptions{
+		DefPath:     resolved.DefinitionPath,
+		RuntimePath: runtimePath,
+		SetID:       strings.TrimSpace(opts.TaskSetID),
+		Agents:      opts.Agents,
+		Effort:      opts.Effort,
+		Timeout:     opts.Timeout,
+		Output:      opts.Output,
+		admission:   opts.Wait.Policy(opts.ConfirmIn),
+	})
+}
+
+// exploreResolvedSet is the resolved-path core of `pop tasks explore`. Only a
+// complete answer reaches the disk: a pass that fails or is interrupted returns
+// before the write, so the set keeps whatever report it already had.
+func exploreResolvedSet(d *Deps, cfg *config.Config, opts exploreCoreOptions) (*ExploreResult, error) {
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{SetID: opts.SetID, DefPath: opts.DefPath})
+	if err != nil {
+		return nil, err
+	}
+	// The Explorer describes the files in the checkout, so it is a Tree-stable
+	// operation: a map drawn while a drain rewrites those files describes a tree
+	// that never existed (ADR-0238).
+	if !opts.checkoutHeld {
+		hold, err := AcquireTreeStable(d, opts.RuntimePath, opts.SetID, opts.Output, opts.admission)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = hold.Release() }()
+	}
+	// The work SHA is read before the Explorer runs: it is the tree the report
+	// describes, and pop stamps it rather than asking the agent to copy it back.
+	workSHA := verifyWorkSHA(d, opts.RuntimePath)
+	run := opts.runExplorer
+	if run == nil {
+		sel, err := resolveExplorer(opts.Agents, opts.Effort, m, cfg)
+		if err != nil {
+			return nil, err
+		}
+		run = func(prompt string) (string, string, error) {
+			return runConfiguredExplorer(d, cfg, sel, m.Dir, opts.SetID, workSHA, opts.RuntimePath, prompt, opts.Output, opts.Timeout, opts.probeMemo)
+		}
+	}
+	body, agent, err := run(buildExplorerPrompt(d, m, opts.RuntimePath, workSHA))
+	if err != nil {
+		// A pass that gave up on a set waiting for its map parks that set, by hand
+		// or in a drain alike; an interrupt is the human stopping, not the pass.
+		if !isInterrupted(err) && exploreParkable(d, m) {
+			recordExplorePark(d, m, opts.SetID, err)
+		}
+		return nil, err
+	}
+	doc := explorationReport.renderDocument(d.Now().UTC(), opts.SetID, workSHA, "", agent, body)
+	path := filepath.Join(m.Dir, ExplorationFileName)
+	// Written through a same-directory rename, so a reader never meets half a
+	// report and a failed write leaves the previous one whole.
+	if err := WriteAtomicWith(d, path, []byte(doc), 0o644); err != nil {
+		return nil, exitErr(ExitOperational, "write %s report: %v", explorationReport.Noun, err)
+	}
+	printExploreWritten(opts.Output, opts.SetID, path)
+	return &ExploreResult{SetID: opts.SetID, WorkSHA: workSHA, Path: path, Body: doc}, nil
+}
+
+// resolveExplorer applies the Explorer precedence chain, highest first: CLI
+// flags → the per-set manifest `explorer` override → [work.explore] →
+// [work.implement].agents / DefaultExploreEffort. Agents and effort resolve independently, the way the
+// Refiner's do, and like the Refiner the Explorer is resolved from configuration
+// alone, so it is a fresh agent by construction.
+func resolveExplorer(cliAgents []string, cliEffort string, m *Manifest, cfg *config.Config) (verifierSelection, error) {
+	agents := nonEmptyStrings(cliAgents)
+	effort := strings.TrimSpace(cliEffort)
+
+	if over := m.ExplorerOverride(); over != nil {
+		if len(agents) == 0 {
+			agents = nonEmptyStrings(over.Agents)
+		}
+		if effort == "" {
+			effort = strings.TrimSpace(over.Effort)
+		}
+	}
+	if e := cfg.ExploreSettings(); e != nil && effort == "" {
+		effort = strings.TrimSpace(e.Effort)
+	}
+	if len(agents) == 0 {
+		resolved, err := ResolveAgentGroupPresets(cfg.ExploreAgentList(), cfg)
+		if err != nil {
+			return verifierSelection{}, err
+		}
+		agents = resolved
+	}
+	if effort == "" {
+		effort = DefaultExploreEffort
+	}
+	return verifierSelection{Agents: agents, Effort: effort}, nil
+}
+
+// runConfiguredExplorer walks the resolved Explorer agent list at the resolved
+// effort through the shared fallback walk, and returns the report beside the
+// agent that wrote it. The cap and retry schedule are the built-in task
+// defaults, as the Refiner's are.
+func runConfiguredExplorer(d *Deps, cfg *config.Config, sel verifierSelection, taskSetDir, setID, workSHA, runtimePath, prompt string, out io.Writer, timeout time.Duration, probeMemo *agentAvailabilityProbeMemo) (string, string, error) {
+	if timeout <= 0 {
+		timeout = DefaultAttemptTimeout
+	}
+	quotaRetryAfter, err := resolveAgentQuotaRetryAfter(cfg)
+	if err != nil {
+		return "", "", exitErr(ExitSetup, "%v", err)
+	}
+	walked, err := runAgentFallbackWalk(d, agentFallbackWalk{
+		role:            explorerRole(d, out, taskSetDir, setID, workSHA),
+		sel:             sel,
+		setID:           setID,
+		runtimePath:     runtimePath,
+		prompt:          prompt,
+		out:             out,
+		errOut:          out,
+		timeout:         timeout,
+		maxTries:        config.DefaultTaskMaxTries,
+		retryDelays:     append([]time.Duration(nil), config.DefaultTaskAttemptRetryDelays...),
+		quotaRetryAfter: quotaRetryAfter,
+		cfg:             cfg,
+		probeMemo:       probeMemo,
+	})
+	if err != nil {
+		return "", "", err
+	}
+	// Prose from an attempt that timed out or died is half a map, and writing it
+	// would replace a complete earlier report with it.
+	if strings.TrimSpace(walked.Answer) != "" && !walked.AnswerRetryEligible {
+		return walked.Answer, walked.Agent, nil
+	}
+	if len(walked.Unavailable) == 0 {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", setID)
+	}
+	return "", "", exitErr(ExitSetup, "%s", formatHumanHealingExhaustionMessage(walked.Unavailable))
+}
+
+// explorerRole is what the shared fallback walk calls the Explorer: its name in
+// the operator's output, the Captured run each invocation is filed as under the
+// `explore` phase — so its spend and its spent cap are its own — and the rule
+// for which attempts are worth retrying. An exploration has no format to parse,
+// so the Refiner's rule is its rule: any prose from a run that reached its own
+// ending is the answer.
+//
+// It is the read-only role the posture was kept for (ADR-0221): the Explorer
+// records the code as found, and a map whose author could edit the territory
+// is not a record of it.
+func explorerRole(d *Deps, errOut io.Writer, taskSetDir, setID, workSHA string) agentRole {
+	return agentRole{
+		Noun:   "Explorer agent",
+		Gerund: "Exploring",
+		Phase:  spendPhaseExplore,
+		Persist: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int) {
+			_ = persistSetLevelRun(d, errOut, taskSetDir, spendPhaseExplore, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode, "")
+		},
+		PersistAnswer: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int, answer string) {
+			_ = persistSetLevelRun(d, errOut, taskSetDir, spendPhaseExplore, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode, "")
+		},
+		PersistSkipped: func(rec *streamRecorder, invocation *AgentInvocation, model string, try int, reason string, exitCode int) {
+			_ = persistSetLevelRun(d, errOut, taskSetDir, spendPhaseExplore, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, model, try, streamOutcomeModelSkipped, reason, exitCode, "")
+		},
+		RetryEligible: refineAttemptRetryEligible,
+		ReadOnly:      true,
+	}
+}
+
+// printExploreWritten tells the operator where the report went and how to read
+// it. The report is the whole output, so nothing here summarises it.
+func printExploreWritten(w io.Writer, setID, path string) {
+	if w == nil {
+		return
+	}
+	out := outputFor(w)
+	out.line(ansiBold, "━━ Exploration for %s", setID)
+	out.line(ansiDim, "   Document: %s", path)
+	out.line(ansiDim, "   Read it: pop tasks artifacts %s --show %s", setID, ExplorationFileName)
+}
+
+// buildExplorerPrompt assembles the Explorer's prompt: pop's role framing, the
+// set's spec when it has one, its manifest listing and every task body, and the
+// report's shape. The Explorer stands in the checkout and reads the code
+// itself; the tasks tell it which area to map.
+func buildExplorerPrompt(d *Deps, m *Manifest, runtimePath, workSHA string) string {
+	view := explorerPromptView{
+		TaskSet:             m.Stem,
+		RuntimeCheckoutLine: runtimeCheckoutLine(runtimePath),
+		WorkSHALine:         optionalLine("Work SHA: ", workSHA),
+		Listing:             gateTaskRows(m),
+	}
+	for _, task := range m.Tasks {
+		view.Tasks = append(view.Tasks, explorerTaskRow{
+			Heading: taskHeading(task),
+			Body:    readTaskBody(d, filepath.Join(m.Dir, task.File)),
+		})
+	}
+	if spec, ok := readSpec(d, m); ok {
+		view.SpecRecorded = true
+		view.Spec = spec
+	}
+	return prompt.MustRender(promptTemplates, "explorer.tmpl.md", view)
+}
+
+// explorerPromptView is what the Explorer's template renders against. Every
+// task is listed, done or not: the map is of the area the whole set touches.
+type explorerPromptView struct {
+	TaskSet             string
+	RuntimeCheckoutLine string
+	WorkSHALine         string
+	SpecRecorded        bool
+	Spec                string
+	Listing             []taskRow
+	Tasks               []explorerTaskRow
+}
+
+// explorerTaskRow is one task's body under its heading.
+type explorerTaskRow struct {
+	Heading string
+	Body    taskBodyRow
+}
diff --git a/tasks/explore_mark.go b/tasks/explore_mark.go
new file mode 100644
index 00000000..3351be28
--- /dev/null
+++ b/tasks/explore_mark.go
@@ -0,0 +1,88 @@
+package tasks
+
+import "github.com/glebglazov/pop/work"
+
+// ExploreMark is whether a set that asked for exploration got it, carried beside
+// its status the way the Verification and Refine marks are (ADR-0262). It is an
+// alias of work.ExploreMark so a Work container can carry the field without
+// `work` importing this package. ResolveExploreMark is the one place that
+// derives it.
+type ExploreMark = work.ExploreMark
+
+const (
+	// ExploreMarkNone is the absent mark: the set never declared
+	// `"explore": true`, so there is nothing it could have missed.
+	ExploreMarkNone ExploreMark = ""
+	// ExploreMarkExplored is a set whose Exploration report exists.
+	ExploreMarkExplored ExploreMark = "explored"
+	// ExploreMarkUnexplored is a set that asked and has no report; the reason
+	// beside it says where the work stopped.
+	ExploreMarkUnexplored ExploreMark = "unexplored"
+)
+
+// UnexploredReason is why an unexplored set has no report — the detail beside
+// the mark, never a second mark.
+type UnexploredReason = work.UnexploredReason
+
+const (
+	// UnexploredReasonNone is the absent reason: the set is explored, or carries
+	// no mark at all.
+	UnexploredReasonNone UnexploredReason = ""
+	// UnexploredNotYetRun is a set no Explore pass has finished on: none ran, or
+	// the latest one was a human's interrupt.
+	UnexploredNotYetRun UnexploredReason = "not-yet-run"
+	// UnexploredFailed is a set whose latest Explore pass ended any other way
+	// without writing the report — the cap spent, the agents exhausted, or a
+	// clean run that handed back nothing.
+	UnexploredFailed UnexploredReason = "failed"
+)
+
+// ExploreResolution is what the read-side resolution answers for one set: the
+// mark, and the reason beside it when the mark is unexplored.
+type ExploreResolution struct {
+	Mark ExploreMark
+	// Reason is blank unless Mark is ExploreMarkUnexplored.
+	Reason UnexploredReason
+}
+
+// ResolveExploreMark is the single read-side Explore mark resolution. It stores
+// nothing: the report's presence and the set's latest Captured run of phase
+// `explore` are the whole answer, the same two facts the EXPLORE-FAILED park
+// derives from (ResolveExplorePark reads this). It is resolved once when a status
+// row is built; every surface renders what the row carries.
+func ResolveExploreMark(d *Deps, m *Manifest) ExploreResolution {
+	if m == nil || !m.ExploreRequested() {
+		return ExploreResolution{}
+	}
+	if explorationBlock(d, m.Dir).HasExploration {
+		return ExploreResolution{Mark: ExploreMarkExplored}
+	}
+	if run, ok := latestSetLevelRun(d, m, spendPhaseExplore); ok && run.Outcome != streamOutcomeInterrupted {
+		return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredFailed}
+	}
+	return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredNotYetRun}
+}
+
+// ExploreResolution is the mark this row was built with.
+func (r Row) ExploreResolution() ExploreResolution {
+	return ExploreResolution{Mark: r.ExploreMark, Reason: r.UnexploredReason}
+}
+
+// ExploreMarkText is the mark as every status surface prints it, with its reason
+// beside it. Empty for a set that carries no mark, and for an EXPLORE-FAILED row,
+// whose status already says the pass failed — the mark repeating it in other
+// words would read as a second fact.
+func ExploreMarkText(status TaskSetStatus, res ExploreResolution) string {
+	if status == StatusExploreFailed {
+		return ""
+	}
+	switch {
+	case res.Mark == ExploreMarkExplored:
+		return string(ExploreMarkExplored)
+	case res.Mark != ExploreMarkUnexplored:
+		return ""
+	case res.Reason == UnexploredFailed:
+		return string(ExploreMarkUnexplored) + ": pass failed"
+	}
+	return string(ExploreMarkUnexplored) + ": not yet run"
+}
diff --git a/tasks/explore_mark_test.go b/tasks/explore_mark_test.go
new file mode 100644
index 00000000..8b02d075
--- /dev/null
+++ b/tasks/explore_mark_test.go
@@ -0,0 +1,92 @@
+package tasks
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// TestExploreMarkRidesTheStatusRow reads each way a set can stand on
+// exploration through the refresh every surface reads, and the table
+// `pop tasks status` prints from it: the mark is resolved once onto the row, and
+// a set that never asked carries none.
+func TestExploreMarkRidesTheStatusRow(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name     string
+		keys     map[string]any
+		outcome  string
+		report   bool
+		wantMark ExploreMark
+		wantText string
+	}{
+		{name: "never asked", keys: map[string]any{}, outcome: streamOutcomeFailed},
+		{name: "asked and no pass has run", keys: map[string]any{ManifestKeyExplore: true}, wantMark: ExploreMarkUnexplored, wantText: "unexplored: not yet run"},
+		{name: "asked and the human interrupted the pass", keys: map[string]any{ManifestKeyExplore: true}, outcome: streamOutcomeInterrupted, wantMark: ExploreMarkUnexplored, wantText: "unexplored: not yet run"},
+		{name: "asked and the pass failed on a completed set", keys: map[string]any{ManifestKeyExplore: true, "human_completed": true}, outcome: streamOutcomeFailed, wantMark: ExploreMarkUnexplored, wantText: "unexplored: pass failed"},
+		{name: "asked and the pass failed on a READY set, which parks", keys: map[string]any{ManifestKeyExplore: true}, outcome: streamOutcomeFailed, wantMark: ExploreMarkUnexplored},
+		{name: "asked and explored", keys: map[string]any{ManifestKeyExplore: true}, outcome: streamOutcomeFailed, report: true, wantMark: ExploreMarkExplored, wantText: "explored"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			env := setupRunTaskSetFixtureWithKeys(t, "demo", interrelatedSet(), tc.keys)
+			setDir := filepath.Join(env.tasksDir, "demo")
+			if tc.outcome != "" {
+				recordExplorePass(t, env.deps(), setDir, tc.outcome)
+			}
+			if tc.report {
+				writeTaskMD(t, setDir, ExplorationFileName, "a map\n")
+			}
+			refresh, err := RefreshWith(env.deps(), env.tasksDir, DefaultStatePathWith(env.deps()))
+			if err != nil {
+				t.Fatal(err)
+			}
+			row := findRow(refresh, "demo")
+			if row == nil || row.ExploreMark != tc.wantMark {
+				t.Fatalf("row = %+v, want explore mark %q", row, tc.wantMark)
+			}
+			table := formatTable(refresh.Rows)
+			if tc.wantText == "" {
+				if strings.Contains(table, "explored") {
+					t.Fatalf("table carries an explore mark it should not:\n%s", table)
+				}
+				return
+			}
+			if !strings.Contains(table, tc.wantText) {
+				t.Fatalf("table missing %q:\n%s", tc.wantText, table)
+			}
+		})
+	}
+}
+
+// TestExplorationPointerNamesTheTreeNotTheBody: a human surface gets the
+// report's path and the work SHA its header records, never what it says, and
+// the sign-off gate names it beside the refine report only when it exists.
+func TestExplorationPointerNamesTheTreeNotTheBody(t *testing.T) {
+	t.Parallel()
+	d, _, _, setDir := setupExploreFixture(t)
+	m := LoadManifest(d, "demo", filepath.Join(setDir, ManifestFileName))
+	if _, ok := ExplorationPointer(d, m); ok {
+		t.Fatal("a set never explored has a pointer")
+	}
+	if lines := gateExplorePreamble(ExplorationPointer(d, m)); lines != nil {
+		t.Fatalf("gate preamble = %q, want nothing for a set never explored", lines)
+	}
+
+	at := time.Date(2026, 10, 4, 9, 4, 44, 0, time.UTC)
+	writeTaskMD(t, setDir, ExplorationFileName, explorationReport.renderDocument(at, "demo", "647143bb0a85deadbeef", "", "claude", "SECRET-EXPLORATION-BODY"))
+	p, ok := ExplorationPointer(d, m)
+	if !ok {
+		t.Fatal("an explored set has no pointer")
+	}
+	gate := strings.Join(gateExplorePreamble(p, ok), "\n")
+	for _, want := range []string{filepath.Join(setDir, ExplorationFileName), ShortSHA("647143bb0a85deadbeef"), "2026-10-04 09:04Z"} {
+		if !strings.Contains(gate, want) {
+			t.Fatalf("gate preamble missing %q: %s", want, gate)
+		}
+	}
+	if strings.Contains(gate, "SECRET-EXPLORATION-BODY") {
+		t.Fatalf("gate preamble carries the report body: %s", gate)
+	}
+}
diff --git a/tasks/explore_park.go b/tasks/explore_park.go
new file mode 100644
index 00000000..43800d8e
--- /dev/null
+++ b/tasks/explore_park.go
@@ -0,0 +1,69 @@
+package tasks
+
+import (
+	"fmt"
+	"strings"
+)
+
+// exploreParkable reports whether a set is one an Explore pass that gave up
+// would park (ADR-0262): its author declared the tasks interrelated, it has no
+// Exploration report, and it is READY — about to start building blind.
+func exploreParkable(d *Deps, m *Manifest) bool {
+	return exploreParkCandidate(m) && ResolveExploreMark(d, m).Mark == ExploreMarkUnexplored
+}
+
+// exploreParkCandidate is the status half of the park. A human-completed set is
+// exempt, as the drain's Explore step skips one, and a set with no eligible work
+// has no builder left to send out without a map.
+func exploreParkCandidate(m *Manifest) bool {
+	return m != nil && !m.HumanCompleted && DeriveStatus(m) == StatusReady
+}
+
+// exploreParks is the park rule over an Explore mark already resolved.
+func exploreParks(m *Manifest, res ExploreResolution) bool {
+	return exploreParkCandidate(m) && res.Reason == UnexploredFailed
+}
+
+// ResolveExplorePark is the read-side answer to whether a set is parked at
+// EXPLORE-FAILED: a parkable set whose Explore mark says the pass failed. Like
+// the mark it stores nothing, so the park needs no store column. An interrupt
+// is the human stopping the drain, not the pass failing, and a set no pass has
+// run on yet is simply waiting for its first.
+//
+// The three ways out all fall out of the derivation: a successful pass writes
+// the report, `"explore": false` withdraws the declaration, and
+// `implement --skip-explore` drains past the park without clearing it.
+func ResolveExplorePark(d *Deps, m *Manifest) bool {
+	return exploreParks(m, ResolveExploreMark(d, m))
+}
+
+// applyExploreMark resolves the set's Explore mark onto its row and overlays the
+// park onto a READY row, so every surface that reads rows — the status table,
+// the dashboard, automatic selection and the Work daemon's scan — shows the
+// same mark and passes over a parked set the same way.
+func applyExploreMark(d *Deps, row *Row, m *Manifest) {
+	res := ResolveExploreMark(d, m)
+	row.ExploreMark, row.UnexploredReason = res.Mark, res.Reason
+	if row.Status != StatusReady || !exploreParks(m, res) {
+		return
+	}
+	row.Status = StatusExploreFailed
+	row.Progress = BuildProgress(m, StatusExploreFailed)
+	row.BlockedReason = exploreParkWaysOut(row.ID)
+}
+
+// exploreParkWaysOut names the three doors out of the park, in the order a
+// human reaches for them.
+func exploreParkWaysOut(setID string) string {
+	return fmt.Sprintf("exploration produced no report; explore it (pop tasks explore %s), drain it once unexplored (pop tasks implement %s --skip-explore), or set %q to false",
+		setID, setID, ManifestKeyExplore)
+}
+
+// recordExplorePark appends the park's one set-level Progress record, naming
+// the phase and why the pass gave up, so the reason is readable without opening
+// the captured run. Best-effort: the park itself is derived, not this line.
+func recordExplorePark(d *Deps, m *Manifest, setID string, cause error) {
+	summary := fmt.Sprintf("phase %s gave up with no Exploration report: %s\n%s",
+		spendPhaseExplore, strings.TrimSpace(cause.Error()), exploreParkWaysOut(setID))
+	_ = AppendSetProgress(d, m.Dir, string(StatusExploreFailed), summary)
+}
