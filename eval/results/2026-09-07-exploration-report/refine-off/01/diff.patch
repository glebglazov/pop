+
+// containerForExploredSet builds the container a row with this Explore mark
+// produces for a set in setDir.
+func containerForExploredSet(t *testing.T, setDir string, row tasks.Row) work.Container {
+	t.Helper()
+	rows := []tasks.Row{row}
+	m := &tasks.Manifest{Valid: true, Dir: setDir, Tasks: []tasks.Task{{ID: "01-a", File: "01-a.md", Type: "AFK", Status: "open"}}}
+	d := testDeps(t, rows)
+	real := deps.NewRealFileSystem()
+	// Only the set directory is real: a Stat that found the pop store would open it.
+	d.Tasks.FS = &deps.MockFileSystem{
+		EvalSymlinksFunc: func(path string) (string, error) { return path, nil },
+		ReadDirFunc:      real.ReadDir,
+		ReadFileFunc:     real.ReadFile,
+		StatFunc: func(path string) (os.FileInfo, error) {
+			if strings.HasPrefix(path, setDir) {
+				return real.Stat(path)
+			}
+			return nil, os.ErrNotExist
+		},
+	}
+	d.Refresh = func(string) (*tasks.RefreshResult, error) {
+		return &tasks.RefreshResult{Rows: rows, Manifests: map[string]*tasks.Manifest{"demo": m}}, nil
+	}
+	scan := scanFixture{Name: "pop", ProjectPath: "/repo/main", RuntimePath: "/repo/main", DefinitionPath: "/def", RepoKey: "repo-key"}
+	got, err := rowsForStatic(d, &config.Config{}, staticForScan(scan, "main", false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 {
+		t.Fatalf("containers = %+v, want one", got)
+	}
+	return got[0]
+}
+
+// TestExploreMarkReachesTheDashboard: the row's one resolution is what the
+// dashboard row and `pop work status` print beside the status, and the detail
+// view points at the report — path and tree — without its body.
+func TestExploreMarkReachesTheDashboard(t *testing.T) {
+	unexplored := containerForExploredSet(t, t.TempDir(), tasks.Row{ID: "demo", Status: tasks.StatusReady,
+		ExploreMark: tasks.ExploreMarkUnexplored, UnexploredReason: tasks.UnexploredNotYetRun})
+	if cell := tasks.WorkRowStatusCell(unexplored); !strings.Contains(cell, "unexplored: not yet run") {
+		t.Fatalf("status cell = %q, want the mark with its reason", cell)
+	}
+	if len(unexplored.DetailSections) != 0 {
+		t.Fatalf("detail sections = %+v, want none for a set with no report", unexplored.DetailSections)
+	}
+
+	never := containerForExploredSet(t, t.TempDir(), tasks.Row{ID: "demo", Status: tasks.StatusReady})
+	if cell := tasks.WorkRowStatusCell(never); strings.Contains(cell, "explored") {
+		t.Fatalf("status cell = %q, want no mark on a set that never asked", cell)
+	}
+
+	setDir := t.TempDir()
+	report := filepath.Join(setDir, tasks.ExplorationFileName)
+	body := "# Exploration report — demo\n\n- Explored: 2026-10-04T09:04:44Z\n- Work SHA: 647143bb0a85\n\n## Where things live\n\nSECRET-EXPLORATION-BODY\n"
+	if err := os.WriteFile(report, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	explored := containerForExploredSet(t, setDir, tasks.Row{ID: "demo", Status: tasks.StatusReady, ExploreMark: tasks.ExploreMarkExplored})
+	if cell := tasks.WorkRowStatusCell(explored); !strings.Contains(cell, "explored") {
+		t.Fatalf("status cell = %q, want the explored mark", cell)
+	}
+	if len(explored.DetailSections) == 0 || explored.DetailSections[0].Title != tasks.ExplorationSectionTitle {
+		t.Fatalf("detail sections = %+v, want the exploration pointer first", explored.DetailSections)
+	}
+	section := explored.DetailSections[0].Body
+	for _, want := range []string{report, "647143bb0a85"} {
+		if !strings.Contains(section, want) {
+			t.Fatalf("section missing %q: %s", want, section)
+		}
+	}
+	if strings.Contains(section, "SECRET-EXPLORATION-BODY") {
+		t.Fatalf("section carries the report body: %s", section)
+	}
+}
