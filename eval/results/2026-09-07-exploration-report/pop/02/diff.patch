@@ -0,0 +1,172 @@
+package tasks
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// parkedExploreFixture is a one-task set that declared `"explore": true`, whose
+// drain has just run an Explorer that gave up: the fake runner files a failed
+// Captured run of the explore phase the way the agent walk does, then reports
+// no report.
+func parkedExploreFixture(t *testing.T) (*runTaskSetFixture, string, string) {
+	t.Helper()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	}, map[string]any{ExploreKey: true})
+	setDir := filepath.Join(env.tasksDir, "demo")
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{summary: "built", checkTask: true})
+
+	opts := env.runTaskSetOpts(true, agent, &bytes.Buffer{})
+	opts.TaskSetOverride = "demo"
+	opts.exploreRunner = func(string) (string, string, error) {
+		writeCapturedRunDirect(t, setDir, "", "", "explore", 3, time.Now(), streamOutcomeFailed)
+		return "", "", errors.New("the Explorer produced no report")
+	}
+	if _, err := RunTaskSetWith(env.deps(), nil, nil, opts); err == nil {
+		t.Fatal("a drain whose explore pass gave up reported success")
+	}
+	return env, setDir, agent
+}
+
+func demoRow(t *testing.T, env *runTaskSetFixture) Row {
+	t.Helper()
+	refresh, err := RefreshWith(env.deps(), env.tasksDir, DefaultStatePathWith(env.d))
+	if err != nil {
+		t.Fatal(err)
+	}
+	row := findRow(refresh, "demo")
+	if row == nil {
+		t.Fatal("no demo row")
+	}
+	return *row
+}
+
+func exploreParkRecords(t *testing.T, setDir string) int {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(setDir, "progress.txt"))
+	if err != nil {
+		return 0
+	}
+	return strings.Count(string(data), "[set] "+string(StatusExploreFailed))
+}
+
+// TestAnExploreThatGivesUpParksTheSet: the set reads EXPLORE-FAILED rather than
+// READY or BLOCKED, automatic selection passes over it, one set-level progress
+// record says why, and draining it again explores nothing and builds nothing.
+func TestAnExploreThatGivesUpParksTheSet(t *testing.T) {
+	t.Parallel()
+	env, setDir, agent := parkedExploreFixture(t)
+
+	row := demoRow(t, env)
+	if row.Status != StatusExploreFailed || row.NextPick {
+		t.Fatalf("row = %+v, want EXPLORE-FAILED and not the next pick", row)
+	}
+	refresh, err := RefreshWith(env.deps(), env.tasksDir, DefaultStatePathWith(env.d))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if id, _, err := SelectTaskSet(refresh, ""); err == nil {
+		t.Fatalf("automatic selection picked %q, a parked set", id)
+	}
+
+	if got := exploreParkRecords(t, setDir); got != 1 {
+		t.Fatalf("park records = %d, want 1", got)
+	}
+	progress, _ := os.ReadFile(filepath.Join(setDir, "progress.txt"))
+	for _, want := range []string{"Explore phase", "the Explorer produced no report", "--skip-explore"} {
+		if !strings.Contains(string(progress), want) {
+			t.Fatalf("progress record missing %q:\n%s", want, progress)
+		}
+	}
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.exploreRunner = func(string) (string, string, error) {
+		t.Error("a parked set was explored again")
+		return "map", "claude", nil
+	}
+	if _, err := RunTaskSetWith(env.deps(), nil, nil, opts); err == nil {
+		t.Fatalf("draining a parked set reported success:\n%s", buf.String())
+	}
+	if prompts := fakeAgentPrompts(agent); len(prompts) != 0 {
+		t.Fatalf("builder ran %d time(s) on a parked set", len(prompts))
+	}
+	if got := exploreParkRecords(t, setDir); got != 1 {
+		t.Fatalf("park records = %d after a second drain, want still 1", got)
+	}
+}
+
+// TestSkipExploreDrainsAParkedSetOnce: `--skip-explore` builds the set without
+// exploring it and without writing another park.
+func TestSkipExploreDrainsAParkedSetOnce(t *testing.T) {
+	t.Parallel()
+	env, setDir, agent := parkedExploreFixture(t)
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.SkipExplore = true
+	opts.exploreRunner = func(string) (string, string, error) {
+		t.Error("--skip-explore explored the set")
+		return "map", "claude", nil
+	}
+	result, err := RunTaskSetWith(env.deps(), nil, nil, opts)
+	if err != nil {
+		t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+	}
+	if !result.TaskSetDone {
+		t.Fatalf("result = %+v, want the set built", result)
+	}
+	if got := exploreParkRecords(t, setDir); got != 1 {
+		t.Fatalf("park records = %d, want only the first park", got)
+	}
+}
+
+// TestTheParkClearsThroughItsDoors: a hand-run pass that writes the report, and
+// retracting the declaration, each bring the set back to READY with nothing
+// stored to undo; a pass a human interrupted never parks.
+func TestTheParkClearsThroughItsDoors(t *testing.T) {
+	t.Parallel()
+	t.Run("a successful hand-run pass", func(t *testing.T) {
+		t.Parallel()
+		env, _, _ := parkedExploreFixture(t)
+		runtimePath, err := ResolveRuntimePathWith(env.d, env.root, "")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := exploreResolvedSet(env.deps(), nil, exploreCoreOptions{
+			DefPath: env.tasksDir, RuntimePath: runtimePath, SetID: "demo", Output: &bytes.Buffer{},
+			runExplorer: func(string) (string, string, error) { return "## Where things live", "claude", nil },
+		}); err != nil {
+			t.Fatal(err)
