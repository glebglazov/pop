@@ -0,0 +1,88 @@
+package tasks
+
+import (
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// explorationReportView is a set's Exploration report as the implement and
+// Assist prompts name it: a path the agent opens itself, never the body, the
+// way the Refine report reaches a human (ADR-0262). Recorded guards the block
+// so the template never asks why the path is empty.
+type explorationReportView struct {
+	Recorded bool
+	Path     string
+}
+
+func newExplorationReportView(path string) explorationReportView {
+	if path == "" {
+		return explorationReportView{}
+	}
+	return explorationReportView{Recorded: true, Path: path}
+}
+
+// explorationReportPath stats <setDir>/exploration.md through the Deps seam and
+// returns its path, or empty when the set has never been explored.
+func explorationReportPath(d *Deps, setDir string) string {
+	if d == nil {
+		d = defaultDeps
+	}
+	path := filepath.Join(setDir, ExplorationFileName)
+	if _, err := d.FS.Stat(path); err != nil {
+		return ""
+	}
+	return path
+}
+
+// latestExplorationPointer is the set's Exploration report as the detail views
+// and the sign-off gate carry it: the shared ReportPointer, so it prints its
+// path and the work SHA its header records the way the Refine report's pointer
+// does, and never the body. False for a set that has no report.
+func latestExplorationPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ReportPointer{}, false
+	}
+	path := explorationReportPath(d, m.Dir)
+	if path == "" {
+		return ReportPointer{}, false
+	}
+	p := ReportPointer{Label: explorationReport.PointerLabel, Path: path}
+	// The report is one flat file rewritten in place, so its instant is the
+	// header's rather than its name's, as the timestamped reports carry it.
+	if body, err := d.FS.ReadFile(path); err == nil {
+		p.WorkSHA = reportHeaderField(string(body), "Work SHA")
+		if at, err := time.Parse(time.RFC3339, reportHeaderField(string(body), explorationReport.WrittenLabel)); err == nil {
+			p.Written = at.UTC().Format("2006-01-02 15:04Z")
+		}
+	}
+	return p, true
+}
+
+// ExplorationSectionTitle heads the dashboard detail section that carries a
+// set's Explore mark and the pointer to its report.
+const ExplorationSectionTitle = "Exploration"
+
+// ExplorationDetail is that section's body for a set: the mark and its reason
+// as the row's resolution answered them, and the report's pointer when there is
+// one, one per line. Empty for a set that carries no mark.
+func ExplorationDetail(d *Deps, m *Manifest, res ExploreResolution) string {
+	return strings.Join(explorationParts(d, m, res), "\n")
+}
+
+// explorationParts are the facts every exploration surface prints, in order:
+// the mark phrase, then the report's pointer when the set has a report.
+func explorationParts(d *Deps, m *Manifest, res ExploreResolution) []string {
+	phrase := exploreMarkPhrase(res)
+	if phrase == "" {
+		return nil
+	}
+	parts := []string{phrase}
+	if p, ok := latestExplorationPointer(d, m); ok {
+		parts = append(parts, p.Summary())
+	}
+	return parts
+}
diff --git a/tasks/explore.go b/tasks/explore.go
new file mode 100644
index 00000000..1b6dbbf5
--- /dev/null
+++ b/tasks/explore.go
@@ -0,0 +1,347 @@
+package tasks
+
+import (
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/prompt"
+	"github.com/glebglazov/pop/project"
+)
+
+// DefaultExploreEffort is the model-strength tier the Explorer runs at when
+// neither a CLI flag, the set's `explorer` object nor [work.explore].effort
+// names one. Every builder
+// in the set works from the map it writes, so a wrong line costs as many
+// attempts as the set has tasks; mapping is the strongest tier's work, as
+// judging is.
+const DefaultExploreEffort = "heavy"
+
+// explorationReport is the Exploration report's header and render on the
+// shared pass-report machinery (ADR-0262). Only the render is borrowed: the
+// report is flat — one `exploration.md` beside the spec, rewritten in place —
+// so it has no directory, no file prefix, and is never filed through
+// writeDocument or read back through latestDocument.
+var explorationReport = passReport{
+	ArtifactType: ArtifactTypeExploration,
+	Title:        "Exploration report",
+	WrittenLabel: "Explored",
+	AgentLabel:   "Explorer",
+	Noun:         "explore",
+	PointerLabel: "Exploration",
+}
+
+// ExploreOptions configures a `pop tasks explore <set>` run.
+type ExploreOptions struct {
+	ResolveInput ResolveInput
+	// TaskSetID is the bare Task-set identifier to explore.
+	TaskSetID string
+	// Agents is the ordered CLI Explorer fallback list (`--agent`, repeatable).
+	// Empty ⇒ the set's `explorer` object, then [work.explore].agents, then
+	// [work.implement].agents.
+	Agents []string
+	// Effort is the CLI Explorer effort override (`--effort`). Empty ⇒ the
+	// set's `explorer` object, then [work.explore].effort, then
+	// DefaultExploreEffort.
+	Effort string
+	// Timeout bounds the single Explorer attempt. Zero uses DefaultAttemptTimeout.
+	Timeout time.Duration
+	// Output receives the live agent stream and the run's chrome.
+	Output io.Writer
+	// Wait is the `--wait` / `--no-wait` tri-state for admission to the checkout
+	// (ADR-0239). The unset default waits at a terminal and refuses elsewhere.
+	Wait AdmissionWaitChoice
+	// ConfirmIn is the invocation's input, read only to tell a human at a
+	// terminal from a script when resolving Wait.
+	ConfirmIn io.Reader
+}
+
+// ExploreResult is the outcome of one explore pass.
+type ExploreResult struct {
+	SetID   string
+	WorkSHA string
+	// Path is the Exploration report written.
+	Path string
+	// Body is the document itself.
+	Body string
+}
+
+// exploreCoreOptions carries the already-resolved inputs to the core explore
+// routine, so tests can drive it without real path-resolution git calls. The
+// runExplorer seam replaces the real agent spawn in tests.
+type exploreCoreOptions struct {
+	DefPath     string
+	RuntimePath string
+	SetID       string
+	Agents      []string
+	Effort      string
+	Timeout     time.Duration
+	Output      io.Writer
+	probeMemo   *agentAvailabilityProbeMemo
+	// runExplorer returns the Explorer's report and the agent that wrote it.
+	runExplorer func(prompt string) (string, string, error)
+	// admission is the policy the Explorer acquires the checkout under
+	// (ADR-0238/0239).
+	admission AdmissionPolicy
+	// checkoutHeld says the caller is already inside a claim on this checkout —
+	// the drain's own explore step, which runs under the drain's running Drain
+	// row. Explore then takes nothing: a second acquisition for the same set
+	// would be refused by the Set claim the caller itself holds.
+	checkoutHeld bool
+}
+
+// ExploreTaskSet explores a set using default dependencies.
+func ExploreTaskSet(opts ExploreOptions) (*ExploreResult, error) {
+	return ExploreTaskSetWith(defaultDeps, project.DefaultDeps(), config.Load, opts)
+}
+
+// ExploreTaskSetWith is `pop tasks explore <set>` (ADR-0262): it resolves the
+// set, hands a fresh Explorer the set's tasks and spec, and writes what comes
+// back as the set's Exploration report. A hand run is a human re-opening the
+// question, so it runs whatever the set's `explore` key says and replaces any
+// report already there.
+func ExploreTaskSetWith(d *Deps, pd *project.Deps, loadConfig func(string) (*config.Config, error), opts ExploreOptions) (*ExploreResult, error) {
+	resolved, err := ResolvePathsWith(d, pd, loadConfig, opts.ResolveInput)
+	if err != nil {
+		return nil, err
+	}
+	runtimePath, err := ResolveRuntimePathWith(d, resolved.ProjectPath, opts.ResolveInput.RuntimeOverride)
+	if err != nil {
+		return nil, err
+	}
+	cfg, _ := loadConfig(d.defaultConfigPath())
+	return exploreResolvedSet(d, cfg, exploreCoreOptions{
+		DefPath:     resolved.DefinitionPath,
+		RuntimePath: runtimePath,
+		SetID:       strings.TrimSpace(opts.TaskSetID),
+		Agents:      opts.Agents,
+		Effort:      opts.Effort,
+		Timeout:     opts.Timeout,
+		Output:      opts.Output,
+		admission:   opts.Wait.Policy(opts.ConfirmIn),
+	})
+}
+
+// exploreResolvedSet is the resolved-path core of `pop tasks explore`. The
+// report is written only from a finished answer, so a pass that is interrupted
+// or fails leaves the set's existing report as it was.
+func exploreResolvedSet(d *Deps, cfg *config.Config, opts exploreCoreOptions) (*ExploreResult, error) {
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{SetID: opts.SetID, DefPath: opts.DefPath})
+	if err != nil {
+		return nil, err
+	}
+	// The Explorer maps the files in the checkout, so it is a Tree-stable
+	// operation: a map drawn while another drain rewrites those files describes a
+	// tree that never existed (ADR-0238).
+	if !opts.checkoutHeld {
+		hold, err := AcquireTreeStable(d, opts.RuntimePath, opts.SetID, opts.Output, opts.admission)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = hold.Release() }()
+	}
+	// The work SHA is read before the Explorer runs: it is the tree the report
+	// describes, and the header states it so a reader can see how old the map is.
+	workSHA := verifyWorkSHA(d, opts.RuntimePath)
+	run := opts.runExplorer
+	if run == nil {
+		sel, err := resolveExplorer(opts.Agents, opts.Effort, m, cfg)
+		if err != nil {
+			return nil, err
+		}
+		run = func(prompt string) (string, string, error) {
+			return runConfiguredExplorer(d, cfg, sel, m.Dir, opts.SetID, workSHA, opts.RuntimePath, prompt, opts.Output, opts.Timeout, opts.probeMemo)
+		}
+	}
+	body, agent, err := run(buildExplorerPrompt(d, m, workSHA))
+	if err != nil {
+		return nil, err
+	}
+	at := d.Now().UTC()
+	doc := explorationReport.renderDocument(at, opts.SetID, workSHA, "", agent, body)
+	path := filepath.Join(m.Dir, ExplorationFileName)
+	_, statErr := d.FS.Stat(path)
+	replaced := statErr == nil
+	if err := WriteAtomicWith(d, path, []byte(doc), 0o644); err != nil {
+		return nil, exitErr(ExitOperational, "write exploration report: %v", err)
+	}
+	printExploreWritten(opts.Output, opts.SetID, path, replaced)
+	return &ExploreResult{SetID: opts.SetID, WorkSHA: workSHA, Path: path, Body: doc}, nil
+}
+
+// resolveExplorer applies the Explorer precedence chain (ADR-0262), highest
+// first: CLI flags → the per-set manifest `explorer` object → [work.explore] →
+// [work.implement].agents / DefaultExploreEffort. Agents and effort resolve
+// independently, and an override of `agents = []` disables the fallthrough, the
+// way the Refiner's do.
+func resolveExplorer(cliAgents []string, cliEffort string, m *Manifest, cfg *config.Config) (verifierSelection, error) {
+	agents := nonEmptyStrings(cliAgents)
+	effort := strings.TrimSpace(cliEffort)
+
+	if over := m.ExplorerOverride(); over != nil {
+		if len(agents) == 0 {
+			agents = nonEmptyStrings(over.Agents)
+		}
+		if effort == "" {
+			effort = strings.TrimSpace(over.Effort)
+		}
+	}
+	if e := cfg.ExploreSettings(); e != nil && effort == "" {
+		effort = strings.TrimSpace(e.Effort)
+	}
+	if len(agents) == 0 {
+		resolved, err := ResolveAgentGroupPresets(cfg.ExploreAgentList(), cfg)
+		if err != nil {
+			return verifierSelection{}, err
+		}
+		agents = resolved
+	}
+	if effort == "" {
+		effort = DefaultExploreEffort
+	}
+	return verifierSelection{Agents: agents, Effort: effort}, nil
+}
+
+// runConfiguredExplorer walks the resolved Explorer agent list through the
+// shared fallback walk and returns the report beside the agent that wrote it.
+// The cap and retry schedule are the built-in task defaults.
+func runConfiguredExplorer(d *Deps, cfg *config.Config, sel verifierSelection, taskSetDir, setID, workSHA, runtimePath, prompt string, out io.Writer, timeout time.Duration, probeMemo *agentAvailabilityProbeMemo) (string, string, error) {
+	if timeout <= 0 {
+		timeout = DefaultAttemptTimeout
+	}
+	quotaRetryAfter, err := resolveAgentQuotaRetryAfter(cfg)
+	if err != nil {
+		return "", "", exitErr(ExitSetup, "%v", err)
+	}
+	walked, err := runAgentFallbackWalk(d, agentFallbackWalk{
+		role:            explorerRole(d, out, taskSetDir, setID, workSHA),
+		sel:             sel,
+		setID:           setID,
+		runtimePath:     runtimePath,
+		prompt:          prompt,
+		out:             out,
+		errOut:          out,
+		timeout:         timeout,
+		maxTries:        config.DefaultTaskMaxTries,
+		retryDelays:     append([]time.Duration(nil), config.DefaultTaskAttemptRetryDelays...),
+		quotaRetryAfter: quotaRetryAfter,
+		cfg:             cfg,
+		probeMemo:       probeMemo,
+	})
+	if err != nil {
+		return "", "", err
+	}
+	// Prose from an attempt that timed out or died is half a map, and writing it
+	// would replace a complete report with it.
+	if strings.TrimSpace(walked.Answer) != "" && !walked.AnswerRetryEligible {
+		return strings.TrimSpace(walked.Answer), walked.Agent, nil
+	}
+	if len(walked.Unavailable) == 0 {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", setID)
+	}
+	return "", "", exitErr(ExitSetup, "%s", formatHumanHealingExhaustionMessage(walked.Unavailable))
+}
+
+// explorerRole is what the shared fallback walk calls the Explorer: its name in
+// the operator's output, the Captured run each invocation is filed as under the
+// `explore` phase, and the retry rule. An Explorer's reply, like a Refiner's,
+// has no format to parse, so the Refiner's rule is its rule.
+//
+// It is the first role to run read-only: the Explorer maps the checkout and
+// changes nothing in it, and pop writes the report from its reply.
+func explorerRole(d *Deps, errOut io.Writer, taskSetDir, setID, workSHA string) agentRole {
+	return agentRole{
+		Noun:   "Explorer agent",
+		Gerund: "Exploring",
+		Phase:  spendPhaseExplore,
+		Persist: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int) {
+			_ = persistSetLevelRun(d, errOut, taskSetDir, spendPhaseExplore, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode, "")
+		},
+		PersistAnswer: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int, answer string) {
+			_ = persistSetLevelRun(d, errOut, taskSetDir, spendPhaseExplore, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode, "")
+		},
+		PersistSkipped: func(rec *streamRecorder, invocation *AgentInvocation, model string, try int, reason string, exitCode int) {
+			_ = persistSetLevelRun(d, errOut, taskSetDir, spendPhaseExplore, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, model, try, streamOutcomeModelSkipped, reason, exitCode, "")
+		},
+		RetryEligible: refineAttemptRetryEligible,
+		ReadOnly:      true,
+	}
+}
+
+// printExploreWritten tells the operator where the report went and how to
+// read it.
+func printExploreWritten(w io.Writer, setID, path string, replaced bool) {
+	if w == nil {
+		return
+	}
+	out := outputFor(w)
+	out.line(ansiBold, "━━ Explore for %s", setID)
+	out.line(ansiDim, "   Document: %s", path)
+	if replaced {
+		out.line(ansiDim, "   Replaces the previous report.")
+	}
+	out.line(ansiDim, "   Read it: pop tasks artifacts %s --show %s", setID, ExplorationFileName)
+}
+
+// buildExplorerPrompt assembles the Explorer's prompt: pop's role framing and
+// report shape, the set's manifest listing with every task's body, and the spec
+// when the set has one. The Explorer stands in the checkout and reads the code
+// itself; the tasks tell it which area to map.
+func buildExplorerPrompt(d *Deps, m *Manifest, workSHA string) string {
+	view := explorerPromptView{
+		TaskSet: m.Stem,
+		WorkSHA: workSHA,
+		Tasks:   explorerTaskRows(d, m),
+	}
+	if spec, ok := readSpec(d, m); ok {
+		view.SpecRecorded = true
+		view.Spec = spec
+	}
+	return prompt.MustRender(promptTemplates, "explorer.tmpl.md", view)
+}
+
+// explorerPromptView is what the Explorer's template renders against. Like the
+// other pass views, every optional section is a named boolean beside the text
+// it guards.
+type explorerPromptView struct {
+	TaskSet      string
+	WorkSHA      string
+	SpecRecorded bool
+	Spec         string
+	Tasks        []explorerTaskRow
+}
+
+// explorerTaskRow is one manifest entry with its body. Every task is listed,
+// whatever its status: the map is for the builders still to come, and the area
+// it covers is the area the whole set touches.
+type explorerTaskRow struct {
+	ID         string
+	Type       string
+	Status     TaskStatus
+	Title      string
+	BlockedBy  string
+	Readable   bool
+	Unreadable bool
+	Body       string
+	Error      string
+}
+
+// explorerTaskRows lists the set's manifest in order, each task with its body.
+func explorerTaskRows(d *Deps, m *Manifest) []explorerTaskRow {
+	rows := make([]explorerTaskRow, 0, len(m.Tasks))
+	for _, task := range m.Tasks {
+		row := explorerTaskRow{ID: task.ID, Type: task.Type, Status: task.Status, Title: task.Title, BlockedBy: strings.Join(task.BlockedBy, ", ")}
+		body, err := d.FS.ReadFile(filepath.Join(m.Dir, task.File))
+		if err != nil {
+			row.Unreadable = true
+			row.Error = err.Error()
+		} else {
+			row.Readable = true
+			row.Body = strings.TrimSpace(string(body))
+		}
+		rows = append(rows, row)
+	}
+	return rows
+}
