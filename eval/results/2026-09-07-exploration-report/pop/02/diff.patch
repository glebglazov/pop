new file mode 100644
index 00000000..534d5f4d
--- /dev/null
+++ b/tasks/drain_explore_test.go
@@ -0,0 +1,204 @@
+package tasks
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// exploreOffConfig switches the machine-wide [work.explore] group off.
+func exploreOffConfig() *config.Config {
+	off := false
+	return &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Enabled: &off}}}
+}
+
+// TestDrainExploresADeclaredSetOnceBeforeItsFirstTask drives whole drains of a
+// one-task set and asserts on what ran: a set that declared `"explore": true`
+// and has no report is explored before its builder starts, and every other
+// shape — a report already there, no declaration, the group off — spends
+// nothing on exploring and still builds.
+func TestDrainExploresADeclaredSetOnceBeforeItsFirstTask(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name        string
+		setKeys     map[string]any
+		report      bool
+		cfg         *config.Config
+		wantExplore bool
+	}{
+		{name: "declared with no report", setKeys: map[string]any{ExploreKey: true}, wantExplore: true},
+		{name: "declared with a report already there", setKeys: map[string]any{ExploreKey: true}, report: true},
+		{name: "never declared", setKeys: map[string]any{}},
+		{name: "declared but the group is off", setKeys: map[string]any{ExploreKey: true}, cfg: exploreOffConfig()},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			env := setupRunTaskSetFixtureWithKeys(t, "demo", []Task{
+				{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+			}, tt.setKeys)
+			reportPath := filepath.Join(env.tasksDir, "demo", ExplorationFileName)
+			if tt.report {
+				if err := os.WriteFile(reportPath, []byte("PREVIOUS-MAP\n"), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			}
+			agent := writeFakeAgent(t, env.root, fakeAgentConfig{summary: "built", checkTask: true})
+
+			var ran []string
+			var buf bytes.Buffer
+			opts := env.runTaskSetOpts(true, agent, &buf)
+			opts.TaskSetOverride = "demo"
+			opts.exploreRunner = func(string) (string, string, error) {
+				ran = append(ran, "explore")
+				return "## Where things live\n\n- `a.go`: the seam", "claude", nil
+			}
+			result, err := RunTaskSetWith(env.deps(), nil, func(string) (*config.Config, error) { return tt.cfg, nil }, opts)
+			if err != nil {
+				t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+			}
+			if !result.TaskSetDone {
+				t.Fatalf("result = %+v, want the task built", result)
+			}
+			for range fakeAgentPrompts(agent) {
+				ran = append(ran, "build")
+			}
+
+			want := []string{"build"}
+			if tt.wantExplore {
+				want = []string{"explore", "build"}
+			}
+			if !reflect.DeepEqual(ran, want) {
+				t.Fatalf("ran = %v, want %v", ran, want)
+			}
+			body, readErr := os.ReadFile(reportPath)
+			switch {
+			case tt.wantExplore:
+				if readErr != nil || !strings.Contains(string(body), "the seam") {
+					t.Fatalf("report = %q (%v), want the Explorer's map written", body, readErr)
+				}
+				// The builder reads the map the pass just wrote.
+				if prompts := fakeAgentPrompts(agent); !strings.Contains(prompts[0], reportPath) {
+					t.Fatalf("builder prompt does not name the report %s:\n%s", reportPath, prompts[0])
+				}
+			case tt.report:
+				if string(body) != "PREVIOUS-MAP\n" {
+					t.Fatalf("report = %q, want the existing report reused untouched", body)
+				}
+			default:
+				if readErr == nil {
+					t.Fatalf("report written for a drain that must not explore: %q", body)
+				}
+			}
+		})
+	}
+}
+
+// TestDrainThatCannotExploreBuildsNothing: the step gates. A pass that writes
+// no report ends the drain before any builder starts, so no task in a set its
+// author called interrelated is built without the map.
+func TestDrainThatCannotExploreBuildsNothing(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	}, map[string]any{ExploreKey: true})
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{summary: "built", checkTask: true})
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.exploreRunner = func(string) (string, string, error) {
+		return "", "", errors.New("every Explorer agent is out of quota")
+	}
+	if _, err := RunTaskSetWith(env.deps(), nil, nil, opts); err == nil {
+		t.Fatal("a drain whose explore pass failed reported success")
+	}
+	if prompts := fakeAgentPrompts(agent); len(prompts) != 0 {
+		t.Fatalf("builder ran %d time(s) on an unexplored set", len(prompts))
+	}
+	if _, err := os.Stat(filepath.Join(env.tasksDir, "demo", ExplorationFileName)); err == nil {
+		t.Fatal("a failed pass wrote a report")
+	}
+}
+
+// TestDrainDoesNotExploreAHumanCompletedSet: the drain leaves a set a human
+// declared done alone, as its refine step does.
+func TestDrainDoesNotExploreAHumanCompletedSet(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	}, map[string]any{ExploreKey: true, "human_completed": true})
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{summary: "built", checkTask: true})
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.exploreRunner = func(string) (string, string, error) {
+		t.Error("explored a human-completed set")
+		return "map", "claude", nil
+	}
+	_, _ = RunTaskSetWith(env.deps(), nil, nil, opts)
+}
+
+// TestResolveExplorerPrecedence covers the Explorer chain (ADR-0262), highest
+// first: CLI flags → the per-set `explorer` object → [work.explore] →
+// [work.implement].agents / heavy, with agents and effort resolving
+// independently of one another.
+func TestResolveExplorerPrecedence(t *testing.T) {
+	t.Parallel()
+	exploreCfg := func(agents []string, effort string) *config.Config {
+		return &config.Config{Work: &config.WorkConfig{
+			Explore: &config.ExploreConfig{Agents: config.AgentEntriesFromCommands(agents...), Effort: effort},
+		}}
+	}
+	withExplorer := func(agents []string, effort string) *Manifest {
+		raw, err := json.Marshal(AgentDirective{Agents: agents, Effort: effort})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return &Manifest{Unknown: map[string]json.RawMessage{ExplorerKey: raw}}
+	}
+
+	tests := []struct {
+		name       string
+		cliAgents  []string
+		cliEffort  string
+		manifest   *Manifest
+		cfg        *config.Config
+		wantAgents []string
+		wantEffort string
+	}{
+		{name: "default when nothing configured", wantAgents: []string{DefaultAgentPreset}, wantEffort: DefaultExploreEffort},
+		{name: "config drives agents and effort", cfg: exploreCfg([]string{"codex", "claude"}, "standard"), wantAgents: []string{"codex", "claude"}, wantEffort: "standard"},
+		{
+			name: "omitted explore agents fall back to the implement list",
+			cfg: &config.Config{Work: &config.WorkConfig{
+				Implement: &config.ImplementConfig{Agents: config.AgentEntriesFromCommands("cursor")},
+			}},
+			wantAgents: []string{"cursor"},
+			wantEffort: DefaultExploreEffort,
+		},
+		{name: "per-set explorer overrides config", manifest: withExplorer([]string{"pi"}, "light"), cfg: exploreCfg([]string{"codex"}, "standard"), wantAgents: []string{"pi"}, wantEffort: "light"},
+		{name: "per-set explorer agents only keep the configured effort", manifest: withExplorer([]string{"pi"}, ""), cfg: exploreCfg([]string{"codex"}, "standard"), wantAgents: []string{"pi"}, wantEffort: "standard"},
+		{name: "CLI overrides the per-set explorer", cliAgents: []string{"opencode"}, cliEffort: "heavy", manifest: withExplorer([]string{"pi"}, "light"), cfg: exploreCfg([]string{"codex"}, "standard"), wantAgents: []string{"opencode"}, wantEffort: "heavy"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			sel, err := resolveExplorer(tt.cliAgents, tt.cliEffort, tt.manifest, tt.cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(sel.Agents, tt.wantAgents) || sel.Effort != tt.wantEffort {
+				t.Fatalf("resolveExplorer = %+v, want agents %v effort %s", sel, tt.wantAgents, tt.wantEffort)
+			}
+		})
+	}
+}
