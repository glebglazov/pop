+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/work"
+)
+
+const exploreMarkReportProse = "SECRET-EXPLORATION-PROSE"
+
+func exploreMarkTasks() []Task {
+	return []Task{{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"}}
+}
+
+// statusSurfaces renders a set the three ways a human reads it from the Task
+// side: the `pop tasks status` table, its per-set detail, and the STATUS cell
+// the Work dashboard and `pop work status` compose from the container.
+func statusSurfaces(t *testing.T, env *runTaskSetFixture) (table, detail, cell string) {
+	t.Helper()
+	refresh, err := RefreshWith(env.deps(), env.tasksDir, DefaultStatePathWith(env.d))
+	if err != nil {
+		t.Fatal(err)
+	}
+	row := findRow(refresh, "demo")
+	if row == nil {
+		t.Fatal("no demo row")
+	}
+	var buf bytes.Buffer
+	RenderTaskSetDetail(env.deps(), nil, &buf, "demo", row, refresh.Manifests["demo"])
+	container := work.Container{RawStatus: row.Status, ExploreMark: row.Explore.Mark, UnexploredReason: row.Explore.Reason}
+	return formatTable(refresh.Rows), buf.String(), WorkRowStatusCell(container)
+}
+
+// TestAnUnexploredSetCarriesItsMarkOnEverySurface: a set that asked for
+// exploration and has none carries the mark beside its status, and the reason
+// as detail beside the mark — not yet run before any pass, the pass failed once
+// one gave up.
+func TestAnUnexploredSetCarriesItsMarkOnEverySurface(t *testing.T) {
+	t.Parallel()
+	t.Run("not yet run", func(t *testing.T) {
+		t.Parallel()
+		env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreMarkTasks(), map[string]any{ExploreKey: true})
+		table, detail, cell := statusSurfaces(t, env)
+		for name, got := range map[string]string{"table": table, "detail": detail, "cell": cell} {
+			if !strings.Contains(got, "unexplored") || !strings.Contains(got, "explore not yet run") {
+				t.Errorf("%s does not carry the mark and its reason:\n%s", name, got)
+			}
+		}
+		if !strings.Contains(table, "READY · unexplored") {
+			t.Errorf("table does not put the mark beside the status:\n%s", table)
+		}
+		if cell != "READY · unexplored · explore not yet run" {
+			t.Errorf("cell = %q", cell)
+		}
+	})
+	t.Run("the pass failed", func(t *testing.T) {
+		t.Parallel()
+		env, _, _ := parkedExploreFixture(t)
+		table, detail, cell := statusSurfaces(t, env)
+		for name, got := range map[string]string{"table": table, "detail": detail, "cell": cell} {
+			if !strings.Contains(got, "unexplored") || !strings.Contains(got, "explore pass failed") {
+				t.Errorf("%s does not carry the mark and its reason:\n%s", name, got)
+			}
+		}
+	})
+}
+
+// TestASetThatNeverAskedCarriesNoExploreMark: no surface says anything about
+// exploration for a set whose author never declared it.
+func TestASetThatNeverAskedCarriesNoExploreMark(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixture(t, "demo", exploreMarkTasks())
+	table, detail, cell := statusSurfaces(t, env)
+	for name, got := range map[string]string{"table": table, "detail": detail, "cell": cell} {
+		if strings.Contains(got, "explor") {
+			t.Errorf("%s mentions exploration for a set that never asked:\n%s", name, got)
+		}
+	}
+}
+
+// TestAnExploredSetPointsAtItsReport: the detail view and the sign-off gate
+// carry the report's path and the tree it records, and never its body.
+func TestAnExploredSetPointsAtItsReport(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreMarkTasks(), map[string]any{ExploreKey: true})
+	setDir := filepath.Join(env.tasksDir, "demo")
+	path := filepath.Join(setDir, ExplorationFileName)
+	body := "# Exploration report — demo\n\n- Explored: 2026-10-10T06:39:53Z\n- Work SHA: 647143bb0a85\n- Explorer: claude\n\n## Where things live\n\n" + exploreMarkReportProse + "\n"
+	if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	table, detail, cell := statusSurfaces(t, env)
+	if !strings.Contains(table, "READY · explored") || cell != "READY · explored" {
+		t.Errorf("table/cell do not carry the explored mark:\n%s\n%s", table, cell)
+	}
+
+	m := LoadManifest(env.deps(), "demo", filepath.Join(setDir, "index.json"))
+	gate := strings.Join(gateExplorePreamble(resolveGateExploreState(env.deps(), m)), "\n")
+	section := ExplorationDetail(env.deps(), m, ResolveExploreMark(env.deps(), m))
+	for name, got := range map[string]string{"detail": detail, "gate": gate, "dashboard section": section} {
+		if !strings.Contains(got, path) || !strings.Contains(got, "647143bb0a85") {
+			t.Errorf("%s does not point at the report and its tree:\n%s", name, got)
+		}
+		if strings.Contains(got, exploreMarkReportProse) {
+			t.Errorf("%s carries the report body:\n%s", name, got)
+		}
+	}
+}
