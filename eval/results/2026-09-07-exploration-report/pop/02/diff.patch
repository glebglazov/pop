@@ -0,0 +1,54 @@
+package tasks
+
+import "fmt"
+
+// exploreParked reports whether a set reads EXPLORE-FAILED (ADR-0262 decision
+// 6): it has a task the drain would otherwise build, and its Explore mark says
+// the latest pass gave up without writing the report — a pass a human stopped
+// is not a failure, and the next drain runs it again.
+//
+// Nothing is stored for the park. It is read back from what the pass left
+// behind, so each of its doors clears it with no write of its own: a hand-run
+// pass that succeeds writes the report, and `"explore": false` withdraws the
+// declaration.
+func exploreParked(d *Deps, m *Manifest) bool {
+	return exploreParkedAt(m, ResolveExploreMark(d, m))
+}
+
+// exploreParkedAt is the park read from a mark already resolved for the set.
+func exploreParkedAt(m *Manifest, res ExploreResolution) bool {
+	if m == nil || m.HumanCompleted || DeriveStatus(m) != StatusReady {
+		return false
+	}
+	return res.Reason == UnexploredPassFailed
+}
+
+// applyExploreResolutions stamps each row with its Explore mark and moves each
+// parked READY row to EXPLORE-FAILED. It runs in the refresh, before the NEXT
+// pick, so every reader of a row — automatic selection, the Work daemon's scan,
+// the status table and the dashboard — sees the same mark and the same park, and
+// none of them picks the set to explore it again.
+func applyExploreResolutions(d *Deps, rows []Row, manifests map[string]*Manifest) {
+	for i := range rows {
+		m := manifests[rows[i].ID]
+		rows[i].Explore = ResolveExploreMark(d, m)
+		if rows[i].Status != StatusReady || !exploreParkedAt(m, rows[i].Explore) {
+			continue
+		}
+		rows[i].Status = StatusExploreFailed
+		rows[i].Progress = BuildProgress(m, StatusExploreFailed)
+	}
+}
+
+// exploreParkDoors names the three ways out of the park, in the one wording the
+// progress record, the drain's refusal and the status table share.
+func exploreParkDoors(setID string) string {
+	return fmt.Sprintf("explore by hand: pop tasks explore %s; drain once unexplored: pop tasks implement %s --skip-explore; or set %q: false in its index.json", setID, setID, ExploreKey)
+}
+
+// recordExplorePark appends the park's one set-level Progress record, so the
+// reason the drain stopped is readable without opening the Captured run.
+func recordExplorePark(d *Deps, m *Manifest, setID string, cause error) error {
+	summary := fmt.Sprintf("Explore phase gave up without writing %s: %v\nThe set is parked. To go on, %s.", ExplorationFileName, cause, exploreParkDoors(setID))
+	return AppendSetProgress(d, m.Dir, string(StatusExploreFailed), summary)
+}
diff --git a/tasks/explore_park_test.go b/tasks/explore_park_test.go
