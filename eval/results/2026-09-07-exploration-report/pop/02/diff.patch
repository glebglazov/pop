+// fakeAgentBinaryRunner runs every command it is asked for through the real
+// runner, with the binary swapped for a script: the walk resolves, spawns and
+// reads a real process, and only the agent on the other end is fake.
+type fakeAgentBinaryRunner struct {
+	script string
+}
+
+func (r fakeAgentBinaryRunner) Run(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (int, error) {
+	return tasks.RealCommandRunner{}.Run(ctx, dir, stdout, stderr, r.script, args...)
+}
+
+func (r fakeAgentBinaryRunner) Start(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (*tasks.ManagedProcess, error) {
+	return tasks.RealCommandRunner{}.Start(ctx, dir, stdout, stderr, r.script, args...)
+}
+
+func (r fakeAgentBinaryRunner) StartWithEnv(ctx context.Context, dir string, env []string, stdout, stderr io.Writer, name string, args ...string) (*tasks.ManagedProcess, error) {
+	return tasks.RealCommandRunner{}.StartWithEnv(ctx, dir, env, stdout, stderr, r.script, args...)
+}
+
+// writeFakeExplorer writes a claude stand-in that records every argv it is
+// given — and the prompt file an argv points at — then answers with report as
+// the run's result.
+func writeFakeExplorer(t *testing.T, root, capture, report string) string {
+	t.Helper()
+	path := filepath.Join(root, ".agent", "fake-explorer.sh")
+	script := "#!/bin/sh\n" +
+		"printf '%s\\n' \"$*\" >> " + capture + "\n" +
+		"FILE=$(printf '%s' \"$*\" | sed -n 's|.*Read the file \\([^ ]*\\) in full:.*|\\1|p' | head -1)\n" +
+		"if [ -n \"$FILE\" ] && [ -f \"$FILE\" ]; then cat \"$FILE\" >> " + capture + "; fi\n" +
+		"printf '%s\\n' '{\"type\":\"system\",\"subtype\":\"init\"}'\n" +
+		"printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"result\":\"" + report + "\"}'\n"
+	writeFileCmd(t, path, script)
+	if err := os.Chmod(path, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+// TestTaskExploreWritesTheReportAndFilesAnExploreRun drives `pop tasks explore`
+// end to end: the command resolves the set, a spawned Explorer is handed the
+// set's tasks and spec, its reply replaces the report on disk, and the run is
+// filed under the explore phase — on a set whose own `explore` key says no.
+func TestTaskExploreWritesTheReportAndFilesAnExploreRun(t *testing.T) {
+	root, td := setupRunTaskCmdFixture(t)
+	resetTaskFlags()
+	t.Cleanup(resetTaskFlags)
+	setDir := runTaskCmdDemoDir(t, td, root)
+
+	writeFileCmd(t, filepath.Join(setDir, tasks.ManifestFileName),
+		`{"explore":false,"tasks":[{"id":"01-a","file":"01-a.md","title":"A","type":"AFK","status":"open"}]}`)
+	writeFileCmd(t, filepath.Join(setDir, "01-a.md"), "## What to build\n\nTEASE-THE-SEAM-APART\n\n## Acceptance criteria\n\n- [ ] ok\n")
+	writeFileCmd(t, filepath.Join(setDir, tasks.SpecFileName), "SPEC-INTENT-LINE\n")
+	reportPath := filepath.Join(setDir, tasks.ExplorationFileName)
+	writeFileCmd(t, reportPath, "OLD-MAP\n")
+
+	capture := filepath.Join(root, ".agent", "explorer-argv.txt")
+	td.LookPath = func(string) (string, error) { return "/bin/claude", nil }
+	td.Runner = fakeAgentBinaryRunner{script: writeFakeExplorer(t, root, capture,
+		`The tree is master at its first commit.\n\n## Where things live\n\n- README.md: the readme.`)}
+
+	var out bytes.Buffer
+	if err := runTaskExploreWith(td, &out, "demo"); err != nil {
+		t.Fatalf("tasks explore: %v\n%s", err, out.String())
+	}
+
+	sent, err := os.ReadFile(capture)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{
+		"independent Explorer",
+		"### 01-a [AFK] (open): A",
+		"TEASE-THE-SEAM-APART",
+		"SPEC-INTENT-LINE",
+		// The Explorer maps; it is spawned unable to edit.
+		"--disallowedTools=Edit,Write,NotebookEdit",
+	} {
+		if !strings.Contains(string(sent), want) {
+			t.Fatalf("explorer was not handed %q:\n%s", want, sent)
+		}
+	}
+
+	body, err := os.ReadFile(reportPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	report := string(body)
+	if strings.Contains(report, "OLD-MAP") {
+		t.Fatalf("the hand run kept the old report:\n%s", report)
+	}
+	for _, want := range []string{
+		"# Exploration report — demo",
+		"- Explored: ",
+		"- Work SHA: ",
+		"- Explorer: claude",
+		"The tree is master at its first commit.",
+		"- README.md: the readme.",
+	} {
+		if !strings.Contains(report, want) {
+			t.Fatalf("report missing %q:\n%s", want, report)
+		}
+	}
+	if !strings.Contains(out.String(), reportPath) {
+		t.Fatalf("output does not name the report:\n%s", out.String())
+	}
+
+	var streams bytes.Buffer
+	if err := runTaskStreamWith(td, &streams, "demo"); err != nil {
+		t.Fatalf("tasks stream: %v", err)
+	}
+	if !strings.Contains(streams.String(), "Explore") {
+		t.Fatalf("no explore run is filed for the set:\n%s", streams.String())
+	}
+}
