+	explorerKey := printedKey("`\\{")
+
+	m := &Manifest{Unknown: map[string]json.RawMessage{
+		exploreKey:  json.RawMessage("true"),
+		explorerKey: json.RawMessage(`{"agents": ["pi"], "effort": "light"}`),
