diff --git a/tasks/explore_phase.go b/tasks/explore_phase.go
new file mode 100644
index 00000000..f5fa84ff
--- /dev/null
+++ b/tasks/explore_phase.go
@@ -0,0 +1,90 @@
+package tasks
+
+import "strings"
+
+// exploreDirective is what explorePhase hands back to the drain: carry on into
+// task selection, or return the run's result with the error the pass ended on.
+type exploreDirective int
+
+const (
+	// exploreProceed goes on to the drain loop. It is what every decline
+	// returns, and what a written report returns.
+	exploreProceed exploreDirective = iota
+	// exploreReturn ends the drain before any task runs: the pass was
+	// interrupted, or could not produce the report the set's builders need.
+	exploreReturn
+)
+
+// explorePhase runs the drain's Explore step (ADR-0262): a set whose author
+// declared `"explore": true`, and that has no Exploration report yet, gets one
+// written by a fresh Explorer before the first task is selected, so every
+// builder in the set starts from the same map.
+//
+// It sits at the head of the drain, not at quiescence where refine and verify
+// sit, because its reader is the next builder rather than the work already
+// done. Absent means write it and present means reuse it: nothing compares the
+// report's recorded tree to the checkout, so a set drained a second time spends
+// nothing here.
+//
+// [work.explore] defaults on — the first agent phase that runs unasked — which
+// is safe only because the set's own declaration is the trigger. A
+// human-completed set is skipped as refine skips it. `pop tasks explore` still
+// runs on request with the group switched off.
+//
+// Unlike refine, this step gates: proceeding unexplored on a set whose author
+// said its tasks are interrelated is the inconsistency the phase exists to
+// prevent, so a pass that produces no report ends the drain before any task
+// runs and parks the set at EXPLORE-FAILED. The walk has already spent the
+// per-phase retry cap by then, so a park is never one flake. A set already
+// parked is not explored again here: the drain stops and names the doors out,
+// and `--skip-explore` is the one that drains it now.
+func (r *implementRun) explorePhase() (exploreDirective, error) {
+	cfg := r.plan.cfg
+	if r.opts.SkipExplore || !cfg.ExploreEnabled() {
+		return exploreProceed, nil
+	}
+	m := r.refresh.Manifests[r.taskSetID]
+	if m == nil || m.HumanCompleted || !m.Explores() {
+		return exploreProceed, nil
+	}
+	// A finished set has no builder left to read the map.
+	if row := findRow(r.refresh, r.taskSetID); row == nil || row.Status == StatusDone {
+		return exploreProceed, nil
+	}
+	if explorationReportPath(r.d, m.Dir) != "" {
+		return exploreProceed, nil
+	}
+	if exploreParked(r.d, m) {
+		outputFor(r.out).line(ansiYellow, "━━ Task set %s is parked at %s: its explore pass gave up with no report", r.taskSetID, StatusExploreFailed)
+		outputFor(r.out).line(ansiDim, "   To go on, %s", exploreParkDoors(r.taskSetID))
+		return exploreReturn, exitErr(ExitNoRunnable, "Task set %q is %s", r.taskSetID, strings.ToLower(string(StatusExploreFailed)))
+	}
+
+	_, err := exploreResolvedSet(r.d, cfg, exploreCoreOptions{
+		DefPath:     r.resolved.DefinitionPath,
+		RuntimePath: r.runtimePath,
+		SetID:       r.taskSetID,
+		Timeout:     r.timeout,
+		Output:      r.out,
+		probeMemo:   r.agentProbeMemo,
+		runExplorer: r.opts.exploreRunner,
+		// The drain is already holding this checkout for this set, so the
+		// explore step runs inside that claim rather than asking for it again
+		// (ADR-0238).
+		checkoutHeld: true,
+	})
+	if err == nil {
+		return exploreProceed, nil
+	}
+	if isInterrupted(err) {
+		return exploreReturn, err
+	}
+	outputFor(r.out).line(ansiYellow, "━━ Explore did not produce a report for %s: %v", r.taskSetID, err)
+	if exploreParked(r.d, m) {
+		if recErr := recordExplorePark(r.d, m, r.taskSetID, err); recErr != nil {
+			return exploreReturn, exitErr(ExitOperational, "record explore park for task set %s: %v", r.taskSetID, recErr)
+		}
+		outputFor(r.out).line(ansiDim, "   Parked at %s. To go on, %s", StatusExploreFailed, exploreParkDoors(r.taskSetID))
+	}
+	return exploreReturn, err
+}
