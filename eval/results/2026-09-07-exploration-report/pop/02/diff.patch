@@ -0,0 +1,93 @@
+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// setupExploreFixture writes a "demo" set with an Exploration report already in
+// it, behind a scripted agent runner that replays runs.
+func setupExploreFixture(t *testing.T, runs ...scriptedRefineRun) (*Deps, string, string) {
+	t.Helper()
+	d, _ := refineRunnerDeps(t, runs...)
+	defPath := filepath.Join(t.TempDir(), "tasks")
+	setupManifest(t, defPath, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "Map once", Type: "AFK", Status: TaskOpen},
+	})
+	report := filepath.Join(defPath, "demo", ExplorationFileName)
+	if err := os.WriteFile(report, []byte("PREVIOUS-MAP\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return d, defPath, report
+}
+
+// TestExplorePassThatCannotFinishLeavesTheReportUntouched: an Explorer that
+// fails every try, or is cut off by the timeout each time, writes nothing — the
+// set keeps the report it had — and every attempt is still filed as a run of the
+// explore phase.
+func TestExplorePassThatCannotFinishLeavesTheReportUntouched(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name    string
+		run     scriptedRefineRun
+		timeout time.Duration
+	}{
+		{"failed", scriptedRefineRun{output: claudeRefineStream("## Where things live"), exitCode: 2}, time.Minute},
+		{"interrupted", scriptedRefineRun{output: claudeRefineStream("## Where things li"), hang: 150 * time.Millisecond}, 20 * time.Millisecond},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			d, defPath, report := setupExploreFixture(t, tt.run, tt.run, tt.run)
+
+			_, err := exploreResolvedSet(d, nil, exploreCoreOptions{
+				DefPath: defPath, RuntimePath: "/rt", SetID: "demo",
+				Agents: []string{"claude"}, Timeout: tt.timeout, Output: &bytes.Buffer{},
+			})
+			if err == nil {
+				t.Fatal("a pass with no finished answer reported success")
+			}
+			body, readErr := os.ReadFile(report)
+			if readErr != nil || string(body) != "PREVIOUS-MAP\n" {
+				t.Fatalf("report = %q (%v), want the previous report untouched", body, readErr)
+			}
+			pairs := listRunFilePairs(t, capturedRunsDir(filepath.Dir(report)))
+			if len(pairs) != 3 {
+				t.Fatalf("captured runs = %d, want each of the 3 tries filed", len(pairs))
+			}
+			for _, pair := range pairs {
+				if pair.metaData.Phase != "explore" {
+					t.Fatalf("run filed under phase %q, want explore", pair.metaData.Phase)
+				}
+			}
+		})
+	}
+}
+
+// TestExplorerPromptAsksForTheMapAndNothingAboutPriorArt: the prompt asks for
+// the code as found, every claim checkable, on one page, with the tree it
+// describes — and the prior-art check stays in the builder's own frame.
+func TestExplorerPromptAsksForTheMapAndNothingAboutPriorArt(t *testing.T) {
+	t.Parallel()
+	text := buildExplorerPrompt(goldenFixtureDeps(t), goldenFullManifest(), "shaHEAD")
+	for _, want := range []string{
+		"code as found",
+		"names a path or a symbol",
+		"about one page",
+		"states the tree you observed",
+		"Work SHA: shaHEAD",
+	} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("prompt missing %q:\n%s", want, text)
+		}
+	}
+	for _, forbidden := range []string{"prior art", "prior-art", "hand-write mechanism", "composed form"} {
+		if strings.Contains(strings.ToLower(text), forbidden) {
+			t.Fatalf("prompt asks about prior art (%q):\n%s", forbidden, text)
+		}
+	}
+}
