index 00000000..ed649487
--- /dev/null
+++ b/tasks/explore_mark.go
@@ -0,0 +1,95 @@
+package tasks
+
+import "github.com/glebglazov/pop/work"
+
+// ExploreMark is whether a Task set that asked for exploration has its
+// Exploration report, carried beside its status as the Verification and Refine
+// marks are (ADR-0262). A set whose author never declared `"explore": true`
+// carries no mark at all: nothing was owed to it.
+//
+// It is an alias of work.ExploreMark so a Work container can carry the field
+// without `work` importing this package. ResolveExploreMark is the one place
+// that derives it.
+type ExploreMark = work.ExploreMark
+
+const (
+	// ExploreMarkNone is the absent mark: the set never asked for exploration.
+	ExploreMarkNone ExploreMark = ""
+	// ExploreMarkExplored is a set whose Exploration report is on disk.
+	ExploreMarkExplored ExploreMark = "explored"
+	// ExploreMarkUnexplored is a set that asked and has no report. The reason
+	// beside it says where the work stopped.
+	ExploreMarkUnexplored ExploreMark = "unexplored"
+)
+
+// UnexploredReason is why an unexplored set has no report — the detail beside
+// the mark, never a second mark.
+type UnexploredReason = work.UnexploredReason
+
+const (
+	// UnexploredReasonNone is the absent reason: the set is explored, or carries
+	// no mark.
+	UnexploredReasonNone UnexploredReason = ""
+	// UnexploredNotYetRun is a set no Explore pass has finished for: none has
+	// been recorded, or the latest was one a human stopped, which the next drain
+	// runs again.
+	UnexploredNotYetRun UnexploredReason = "not-yet-run"
+	// UnexploredPassFailed is a set whose latest Explore pass gave up without
+	// writing the report. On a READY set this is the EXPLORE-FAILED park.
+	UnexploredPassFailed UnexploredReason = "pass-failed"
+)
+
+// ExploreResolution is what the read-side resolution answers for one set: the
+// mark every surface displays and, when the set is unexplored, the reason riding
+// beside it.
+type ExploreResolution struct {
+	Mark ExploreMark
+	// Reason is why the set has no report, blank unless Mark is
+	// ExploreMarkUnexplored.
+	Reason UnexploredReason
+}
+
+// ResolveExploreMark is the single read-side Explore mark resolution. The
+// status refresh stamps its answer on every row, and the EXPLORE-FAILED park is
+// read from the same answer, so the status table, the Work dashboard, `pop work
+// status` and the drain cannot disagree about a set.
+//
+// It stores nothing. The report on disk is the whole answer for an explored set;
+// for the rest, the latest Captured run of phase `explore` says whether a pass
+// gave up.
+func ResolveExploreMark(d *Deps, m *Manifest) ExploreResolution {
+	if m == nil || !m.Explores() {
+		return ExploreResolution{}
+	}
+	if explorationReportPath(d, m.Dir) != "" {
+		return ExploreResolution{Mark: ExploreMarkExplored}
+	}
+	run, ok := latestPhaseRun(d, m, spendPhaseExplore)
+	if !ok || run.Outcome == streamOutcomeInterrupted {
+		return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredNotYetRun}
+	}
+	return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredPassFailed}
+}
+
+// UnexploredReasonText is the reason in the one wording every surface prints
+// beside the mark, empty when there is none.
+func UnexploredReasonText(reason UnexploredReason) string {
+	switch reason {
+	case UnexploredNotYetRun:
+		return "explore not yet run"
+	case UnexploredPassFailed:
+		return "explore pass failed"
+	}
+	return ""
+}
+
+// exploreMarkPhrase is the mark and its reason as one line, for the surfaces
+// that say it in prose: the set detail, the dashboard detail and the sign-off
+// gate. Empty for a set that carries no mark.
+func exploreMarkPhrase(res ExploreResolution) string {
+	text := string(res.Mark)
+	if reason := UnexploredReasonText(res.Reason); reason != "" {
+		text += ": " + reason
+	}
+	return text
+}
