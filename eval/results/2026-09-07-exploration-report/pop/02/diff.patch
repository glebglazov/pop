+// containerForRow builds the single container a refreshed row produces.
+func containerForRow(t *testing.T, row tasks.Row) work.Container {
+	t.Helper()
+	rows := []tasks.Row{row}
+	d := testDeps(t, rows)
+	real := deps.NewRealFileSystem()
+	d.Tasks.FS = &deps.MockFileSystem{
+		EvalSymlinksFunc: func(path string) (string, error) { return path, nil },
+		ReadDirFunc:      real.ReadDir,
+		ReadFileFunc:     real.ReadFile,
+		StatFunc:         func(string) (os.FileInfo, error) { return nil, os.ErrNotExist },
+	}
+	m := &tasks.Manifest{Valid: true, Dir: t.TempDir(), Tasks: []tasks.Task{{ID: "01-a", File: "01-a.md", Type: "AFK", Status: "open"}}}
+	d.Refresh = func(string) (*tasks.RefreshResult, error) {
+		return &tasks.RefreshResult{Rows: rows, Manifests: map[string]*tasks.Manifest{row.ID: m}}, nil
+	}
+	scan := scanFixture{Name: "pop", ProjectPath: "/repo/main", RuntimePath: "/repo/main", DefinitionPath: "/def", RepoKey: "repo-key"}
+	got, err := rowsForStatic(d, &config.Config{}, staticForScan(scan, "main", false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 {
+		t.Fatalf("containers = %+v, want one", got)
+	}
+	return got[0]
+}
+
+// TestTheContainerCarriesTheRowsExploreMark: the dashboard row and its detail
+// view render the mark the refresh resolved, and a set that never asked gets
+// neither the mark nor the section.
+func TestTheContainerCarriesTheRowsExploreMark(t *testing.T) {
+	unexplored := tasks.ExploreResolution{Mark: tasks.ExploreMarkUnexplored, Reason: tasks.UnexploredPassFailed}
+	c := containerForRow(t, tasks.Row{ID: "demo", Status: tasks.StatusExploreFailed, Explore: unexplored})
+	if got, want := tasks.WorkRowStatusCell(c), "EXPLORE-FAILED · unexplored · explore pass failed"; got != want {
+		t.Fatalf("status cell = %q, want %q", got, want)
+	}
+	if len(c.DetailSections) != 1 || c.DetailSections[0].Title != tasks.ExplorationSectionTitle || c.DetailSections[0].Body != "unexplored: explore pass failed" {
+		t.Fatalf("detail sections = %+v, want the exploration section", c.DetailSections)
+	}
+
+	never := containerForRow(t, tasks.Row{ID: "demo", Status: tasks.StatusReady})
+	if never.ExploreMark != tasks.ExploreMarkNone || len(never.DetailSections) != 0 {
+		t.Fatalf("container = %+v, want no mark and no section", never)
+	}
+}
