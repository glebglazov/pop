+package tasks
+
+import (
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+// TestExploreDirectiveIsOptIn reads the Explore directive from a manifest on
+// disk: only an explicit `true` asks for exploration, where `verify` and
+// `refine` take part unless they read `false` (ADR-0262).
+func TestExploreDirectiveIsOptIn(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name    string
+		setKeys map[string]any
+		want    bool
+	}{
+		{"absent never explores", nil, false},
+		{"false never explores", map[string]any{"explore": false}, false},
+		{"malformed never explores", map[string]any{"explore": "yes"}, false},
+		{"true explores", map[string]any{"explore": true}, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			d := newTestDeps(t)
+			taskDir := filepath.Join(t.TempDir(), "demo")
+			writeTaskMD(t, taskDir, "01-a.md", "## Acceptance criteria\n\n- [ ] a\n")
+			writeManifestWithSetKeys(t, taskDir, []Task{
+				{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+			}, tt.setKeys)
+
+			m := LoadManifest(d, "demo", filepath.Join(taskDir, ManifestFileName))
+			if !m.Valid {
+				t.Fatalf("manifest invalid: %v", m.Errors)
+			}
+			if got := m.ExploreRequested(); got != tt.want {
+				t.Fatalf("ExploreRequested() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+// TestExplorerDirectiveSteersThroughTheAgentDirective reads an `explorer`
+// object through the same shape as `verifier` and `refiner`.
+func TestExplorerDirectiveSteersThroughTheAgentDirective(t *testing.T) {
+	t.Parallel()
+	d := newTestDeps(t)
+	taskDir := filepath.Join(t.TempDir(), "demo")
+	writeTaskMD(t, taskDir, "01-a.md", "## Acceptance criteria\n\n- [ ] a\n")
+	writeManifestWithSetKeys(t, taskDir, []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	}, map[string]any{"explorer": map[string]any{"agents": []string{"codex", "claude"}, "effort": "light"}})
+
+	m := LoadManifest(d, "demo", filepath.Join(taskDir, ManifestFileName))
+	if !m.Valid {
+		t.Fatalf("manifest invalid: %v", m.Errors)
+	}
+	want := &AgentDirective{Agents: []string{"codex", "claude"}, Effort: "light"}
+	if got := m.ExplorerOverride(); !reflect.DeepEqual(got, want) {
+		t.Fatalf("ExplorerOverride() = %+v, want %+v", got, want)
+	}
+	if m.ExploreRequested() {
+		t.Fatal("an explorer object opted the set in; only explore does")
+	}
+}
+
+// TestExploredSetRegistersAndStillRefusesAnOrphan registers a set carrying
+// both keys and an Exploration report: it reads READY, and a slice nobody
+// listed beside it is still MALFORMED.
+func TestExploredSetRegistersAndStillRefusesAnOrphan(t *testing.T) {
+	t.Parallel()
+	d := newTestDeps(t)
+	root := t.TempDir()
+	taskDir := filepath.Join(root, "explored")
+	writeTaskMD(t, taskDir, "01-a.md", "## Acceptance criteria\n\n- [ ] a\n")
+	writeTaskMD(t, taskDir, ExplorationFileName, "# Exploration report\n")
+	writeManifestWithSetKeys(t, taskDir, []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	}, map[string]any{
+		"explore":  true,
+		"explorer": map[string]any{"agents": []string{"claude"}, "effort": "heavy"},
+	})
+
+	result, err := RegisterWith(d, root, filepath.Join(root, "state.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(result.Rows) != 1 || result.Rows[0].Status != StatusReady {
+		t.Fatalf("rows = %#v, want one READY row", result.Rows)
+	}
+
+	writeTaskMD(t, taskDir, "02-forgotten.md", "## Acceptance criteria\n\n- [ ] b\n")
+	result, err = RegisterWith(d, root, filepath.Join(root, "state.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(result.Rows) != 1 || result.Rows[0].Status != StatusMalformed {
+		t.Fatalf("rows = %#v, want one MALFORMED row for the unlisted slice", result.Rows)
+	}
+	if errs := strings.Join(result.Rows[0].DetailErrors, "\n"); !strings.Contains(errs, "02-forgotten.md") || strings.Contains(errs, ExplorationFileName+":") {
+		t.Fatalf("diagnostics = %q, want only the unlisted slice named", errs)
+	}
+}
diff --git a/tasks/explore_mark.go b/tasks/explore_mark.go
new file mode 100644
index 00000000..1c131893
--- /dev/null
+++ b/tasks/explore_mark.go
@@ -0,0 +1,94 @@
+package tasks
+
+import "github.com/glebglazov/pop/work"
+
+// ExploreMark is whether a Task set that declared `"explore": true` got its
+// Exploration report, carried beside its status as the Verification and Refine
+// marks are (ADR-0262). It is a separate fact from the status: a set can be
+// READY, DONE or parked and still have been built with or without a map.
+//
+// It is an alias of work.ExploreMark so a Work container can carry the field
+// without `work` importing this package, as VerifyMark is.
+type ExploreMark = work.ExploreMark
+
+const (
+	// ExploreMarkNone is the absent mark: the set never asked for exploration.
+	ExploreMarkNone ExploreMark = ""
+	// ExploreMarkExplored is a declared set whose Exploration report is on disk.
+	ExploreMarkExplored ExploreMark = "explored"
+	// ExploreMarkUnexplored is a declared set with no Exploration report. The
+	// reason beside it says whether a pass has yet to run or gave up.
+	ExploreMarkUnexplored ExploreMark = "unexplored"
+)
+
+// UnexploredReason is why an unexplored set has no report — the detail beside
+// the mark, never a second mark.
+type UnexploredReason string
+
+const (
+	// UnexploredReasonNone is the absent reason: the set is explored, or it
+	// carries no mark.
+	UnexploredReasonNone UnexploredReason = ""
+	// UnexploredNotYetRun is a set no Explore pass has ended for on its own: none
+	// was recorded, or the latest was a human's interrupt.
+	UnexploredNotYetRun UnexploredReason = "not-yet-run"
+	// UnexploredPassFailed is a set whose latest Explore pass ended without
+	// writing the report.
+	UnexploredPassFailed UnexploredReason = "pass-failed"
+)
+
+// ExploreResolution is what the read-side resolution answers for one set: the
+// mark every surface displays, and the reason beside it when the set is
+// unexplored.
+type ExploreResolution struct {
+	Mark   ExploreMark
+	Reason UnexploredReason
+	// Failure is the last pass's ending in words, blank unless Reason is
+	// UnexploredPassFailed.
+	Failure string
+}
+
+// ResolveExploreMark is the single read-side Explore mark resolution. The
+// refresh lays it over every row beside the Explore park, which is derived from
+// it, so the status table, the Work dashboard, `pop work status` and the
+// sign-off gate cannot disagree about a set.
+//
+// It stores nothing. The report on disk is the whole answer to "explored"; when
+// it is absent, the set's latest Captured run of phase `explore` says why. The
+// [work.explore] switch is not read: it decides whether a drain runs the pass,
+// not whether the set the author declared got its map.
+func ResolveExploreMark(d *Deps, m *Manifest) ExploreResolution {
+	if m == nil || !m.ExploreRequested() {
+		return ExploreResolution{}
+	}
+	if explorationBlock(d, m.Dir).HasExploration {
+		return ExploreResolution{Mark: ExploreMarkExplored}
+	}
+	run, ok := latestSetLevelRun(d, m, spendPhaseExplore)
+	if !ok || run.Outcome == streamOutcomeInterrupted {
+		return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredNotYetRun}
+	}
+	return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: UnexploredPassFailed, Failure: exploreGaveUpReason(run)}
+}
+
+// exploreResolution is the resolution the refresh laid over this row, read
+// back for a surface that words it.
+func (r Row) exploreResolution() ExploreResolution {
+	return ExploreResolution{Mark: r.ExploreMark, Reason: r.UnexploredReason, Failure: r.ExploreFailure}
+}
+
+// exploreMarkPhrase is the mark as a human reads it, in the one wording every
+// detail surface uses. A set carrying no mark has no phrase.
+func exploreMarkPhrase(res ExploreResolution) string {
+	switch {
+	case res.Mark == ExploreMarkExplored:
+		return "Explored"
+	case res.Mark != ExploreMarkUnexplored:
+		return ""
+	case res.Reason == UnexploredPassFailed && res.Failure != "":
+		return "Unexplored: the Explore pass failed (" + res.Failure + ")"
+	case res.Reason == UnexploredPassFailed:
+		return "Unexplored: the Explore pass failed"
+	}
+	return "Unexplored: not yet run"
+}
diff --git a/tasks/explore_mark_test.go b/tasks/explore_mark_test.go
new file mode 100644
index 00000000..ffcfae8f
