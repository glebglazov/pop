+package tasks
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// exploreTestSet is one open AFK task: the drain's first selection would run it,
+// so an Explorer that sees it still open ran before any task did.
+func exploreTestSet() []Task {
+	return []Task{{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"}}
+}
+
+// drainExploredSet drains the set at env through to DONE with a fake builder
+// and a recorded Explorer, and returns what the Explorer was asked each time it
+// ran beside the drain's output.
+func drainExploredSet(t *testing.T, env *runTaskSetFixture, cfg *config.Config) (explorerSawOpen []bool, out string) {
+	t.Helper()
+	agent := writeSequentialFakeAgent(t, env.root, []fakeAgentStep{{summary: "built"}})
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.exploreRunner = func(string) (string, string, error) {
+		m := LoadManifest(env.deps(), "demo", filepath.Join(env.tasksDir, "demo", ManifestFileName))
+		explorerSawOpen = append(explorerSawOpen, m.Tasks[0].Status == "open")
+		return "## Where things live\n\n- `main.go` holds everything.", "claude", nil
+	}
+	result, err := RunTaskSetWith(env.deps(), nil, func(string) (*config.Config, error) { return cfg, nil }, opts)
+	if err != nil {
+		t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+	}
+	if !result.TaskSetDone {
+		t.Fatalf("result = %+v, want the set drained to DONE\n%s", result, buf.String())
+	}
+	return explorerSawOpen, buf.String()
+}
+
+func explorationReportPath(env *runTaskSetFixture) string {
+	return filepath.Join(env.tasksDir, "demo", ExplorationFileName)
+}
+
+// TestDrainExploresADeclaredSetOnlyWhenItHasNoReport drives a whole drain of a
+// declared set both ways: with no report the Explorer runs once, before the
+// first task, and its report is on disk; with a report already there the drain
+// reuses it, spends nothing on exploring, and leaves it byte for byte.
+func TestDrainExploresADeclaredSetOnlyWhenItHasNoReport(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no report", func(t *testing.T) {
+		t.Parallel()
+		env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreTestSet(), map[string]any{"explore": true})
+
+		sawOpen, out := drainExploredSet(t, env, nil)
+
+		if len(sawOpen) != 1 || !sawOpen[0] {
+			t.Fatalf("explorer runs = %v, want exactly one, before the task ran", sawOpen)
+		}
+		body, err := os.ReadFile(explorationReportPath(env))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		if !strings.Contains(string(body), "`main.go` holds everything.") {
+			t.Fatalf("report = %q, want the Explorer's answer", body)
+		}
+		if !strings.Contains(out, "━━ Explore for demo") {
+			t.Fatalf("output does not report the pass:\n%s", out)
+		}
+	})
+
+	t.Run("report already there", func(t *testing.T) {
+		t.Parallel()
+		env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreTestSet(), map[string]any{"explore": true})
+		const existing = "# Exploration report — demo\n\n- Work SHA: 0000000\n"
+		if err := os.WriteFile(explorationReportPath(env), []byte(existing), 0o644); err != nil {
+			t.Fatal(err)
+		}
+
+		sawOpen, _ := drainExploredSet(t, env, nil)
+
+		if len(sawOpen) != 0 {
+			t.Fatalf("explorer runs = %v, want none for a set that has its report", sawOpen)
+		}
+		body, err := os.ReadFile(explorationReportPath(env))
+		if err != nil {
+			t.Fatalf("read report: %v", err)
+		}
+		if string(body) != existing {
+			t.Fatalf("report = %q, want the existing one reused as it was", body)
+		}
+	})
+}
+
+// TestDrainDoesNotExploreASetThatDidNotAskOrMayNot: the set's directive is the
+// trigger and [work.explore].enabled the machine's veto, so a set that never
+// declared exploration, or a machine that turned the step off, spends nothing.
+func TestDrainDoesNotExploreASetThatDidNotAskOrMayNot(t *testing.T) {
+	t.Parallel()
+	off := false
+	tests := []struct {
+		name    string
+		setKeys map[string]any
+		cfg     *config.Config
+	}{
+		{"never declared", nil, nil},
+		{"declared but config off", map[string]any{"explore": true},
+			&config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Enabled: &off}}}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreTestSet(), tt.setKeys)
+
+			sawOpen, _ := drainExploredSet(t, env, tt.cfg)
+
+			if len(sawOpen) != 0 {
+				t.Fatalf("explorer runs = %v, want none", sawOpen)
+			}
+			if _, err := os.Stat(explorationReportPath(env)); !os.IsNotExist(err) {
+				t.Fatalf("stat report = %v, want no report written", err)
+			}
+		})
+	}
+}
+
+// TestDrainDoesNotExploreAHumanCompletedSet: the drain spends no agent on a set
+// a human declared done, as its refine step does not. A whole drain refuses an
+// explicitly targeted DONE set before its loop, so the step is driven directly.
+func TestDrainDoesNotExploreAHumanCompletedSet(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", doneAFKSet(), map[string]any{"explore": true, "human_completed": true})
+	d := env.deps()
+	refresh, err := RefreshWith(d, env.tasksDir, DefaultStatePathWith(d))
+	if err != nil {
+		t.Fatalf("RefreshWith: %v", err)
+	}
+	run := &implementRun{
+		d:         d,
+		plan:      &runPlan{},
+		resolved:  &ResolvedPaths{DefinitionPath: env.tasksDir},
+		refresh:   refresh,
+		taskSetID: "demo",
+		opts: RunTaskSetOptions{exploreRunner: func(string) (string, string, error) {
+			t.Fatal("the drain must not explore a set a human completed")
+			return "", "", nil
+		}},
+	}
+
+	if directive, err := run.explorePhase(); directive != exploreFallThrough || err != nil {
+		t.Fatalf("explorePhase = %v, %v; want a fall-through", directive, err)
+	}
+	if _, err := os.Stat(explorationReportPath(env)); !os.IsNotExist(err) {
+		t.Fatalf("stat report = %v, want no report written", err)
+	}
+}
+
+// TestExplorerPrecedence: CLI flags beat the set's `explorer` object, which
+// beats [work.explore], which beats the implement list and the built-in effort.
+func TestExplorerPrecedence(t *testing.T) {
+	t.Parallel()
+	cfg := &config.Config{Work: &config.WorkConfig{
+		Implement: &config.ImplementConfig{Agents: config.AgentEntries{{Cmd: "implement-agent"}}},
+		Explore:   &config.ExploreConfig{Agents: config.AgentEntries{{Cmd: "config-agent"}}, Effort: "standard"},
+	}}
+	declared := &Manifest{Unknown: map[string]json.RawMessage{"explorer": json.RawMessage(`{"agents": ["set-agent"], "effort": "light"}`)}}
+	bare := &Manifest{}
+
+	tests := []struct {
+		name       string
+		cliAgents  []string
+		cliEffort  string
+		m          *Manifest
+		cfg        *config.Config
+		wantAgents string
+		wantEffort string
+	}{
+		{"cli wins", []string{"cli-agent"}, "heavy", declared, cfg, "cli-agent", "heavy"},
+		{"explorer object beats config", nil, "", declared, cfg, "set-agent", "light"},
+		{"config beats implement list", nil, "", bare, cfg, "config-agent", "standard"},
+		{"implement list and built-in effort last", nil, "", bare,
+			&config.Config{Work: &config.WorkConfig{Implement: cfg.Work.Implement}}, "implement-agent", DefaultExploreEffort},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			sel, err := resolveExplorer(tt.cliAgents, tt.cliEffort, tt.m, tt.cfg)
+			if err != nil {
+				t.Fatalf("resolveExplorer: %v", err)
+			}
+			if got := strings.Join(sel.Agents, ","); got != tt.wantAgents || sel.Effort != tt.wantEffort {
+				t.Fatalf("selection = %s @ %s, want %s @ %s", got, sel.Effort, tt.wantAgents, tt.wantEffort)
+			}
+		})
+	}
+}
