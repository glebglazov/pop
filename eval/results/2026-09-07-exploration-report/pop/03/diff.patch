@@ -0,0 +1,144 @@
+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// explorationProse is the one string no surface may print: the report's body.
+// Every surface carries a pointer to it and nothing else.
+const explorationProse = "SECRET-EXPLORATION-PROSE"
+
+// seedExplorationReport writes the set's Exploration report as the Explorer
+// would have, and returns its path.
+func seedExplorationReport(t *testing.T, setDir string) string {
+	t.Helper()
+	at := time.Date(2026, 9, 7, 12, 0, 0, 0, time.UTC)
+	doc := exploreReport.renderDocument(at, "demo", "647143bb0a85ffff", "", "claude", "## Where things live\n\n"+explorationProse)
+	path := filepath.Join(setDir, ExplorationFileName)
+	if err := os.WriteFile(path, []byte(doc), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+// TestExploreMarkSaysWhetherASetWasExplored drives a declared set through each
+// state the mark tells apart — never explored, parked by a pass that gave up,
+// explored — and reads it back off the refreshed row the way `pop tasks status`
+// prints it: the mark beside the status, its reason in the detail.
+func TestExploreMarkSaysWhetherASetWasExplored(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreTestSet(), map[string]any{"explore": true})
+
+	row := demoRow(t, env)
+	if row.ExploreMark != ExploreMarkUnexplored || row.UnexploredReason != UnexploredNotYetRun {
+		t.Fatalf("fresh set: mark %q (%q), want unexplored, not yet run", row.ExploreMark, row.UnexploredReason)
+	}
+	if got := statusColumnText(row); got != "READY · unexplored" {
+		t.Fatalf("fresh set status cell = %q, want the mark beside READY", got)
+	}
+	if got := rowDetail(outputFor(nil), row); !strings.Contains(got, "Unexplored: not yet run") {
+		t.Fatalf("fresh set detail = %q, want the reason beside the mark", got)
+	}
+
+	parkDeclaredSet(t, env)
+	row = demoRow(t, env)
+	if row.ExploreMark != ExploreMarkUnexplored || row.UnexploredReason != UnexploredPassFailed || row.ExploreFailure == "" {
+		t.Fatalf("parked set: mark %q (%q, %q), want unexplored because the pass failed", row.ExploreMark, row.UnexploredReason, row.ExploreFailure)
+	}
+	if got := statusColumnText(row); got != "EXPLORE-FAILED · unexplored" {
+		t.Fatalf("parked set status cell = %q", got)
+	}
+
+	seedExplorationReport(t, filepath.Join(env.tasksDir, "demo"))
+	row = demoRow(t, env)
+	if row.ExploreMark != ExploreMarkExplored || row.UnexploredReason != UnexploredReasonNone {
+		t.Fatalf("explored set: mark %q (%q), want explored", row.ExploreMark, row.UnexploredReason)
+	}
+	if got := statusColumnText(row); got != "READY · explored" {
+		t.Fatalf("explored set status cell = %q", got)
+	}
+	if got := rowDetail(outputFor(nil), row); strings.Contains(got, "Unexplored") {
+		t.Fatalf("explored set detail = %q, still says unexplored", got)
+	}
+}
+
+// TestASetThatNeverAskedCarriesNoExploreMark: no row field, no status-cell word,
+// no detail, and no mark on the set view or the sign-off gate — even with a
+// report from a hand run sitting in the folder, which is still pointed at.
+func TestASetThatNeverAskedCarriesNoExploreMark(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreTestSet(), nil)
+	row := demoRow(t, env)
+	if row.ExploreMark != ExploreMarkNone {
+		t.Fatalf("mark = %q, want none", row.ExploreMark)
+	}
+	if text := statusColumnText(row) + rowDetail(outputFor(nil), row); strings.Contains(strings.ToLower(text), "explored") {
+		t.Fatalf("row mentions exploration: %q", text)
+	}
+	if _, ok := ExplorationSection(env.deps(), row, nil); ok {
+		t.Fatal("a set that never asked and has no report has an Exploration detail section")
+	}
+
+	d, m := hitlFixture(t)
+	path := seedExplorationReport(t, m.Dir)
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, nil, &detail, "demo", nil, m)
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	for surface, text := range map[string]string{"set view": detail.String(), "gate preamble": gate} {
+		if strings.Contains(strings.ToLower(text), "explored") {
+			t.Fatalf("%s marks a set that never asked:\n%s", surface, text)
+		}
+		if !strings.Contains(text, path) {
+			t.Fatalf("%s does not point at the hand-run report:\n%s", surface, text)
+		}
+	}
+}
+
+// TestExplorationReachesAHumanAsAPointer: the detail section, the set view and
+// the sign-off gate each carry the mark and the report's path and tree, and none
+// of them its body; the gate pages the report from an entry beside the refine
+// one.
+func TestExplorationReachesAHumanAsAPointer(t *testing.T) {
+	t.Parallel()
+	d, m := setupDrainVerifyFixture(t, stubGit("sha1\n", "", ""), []Task{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "done"},
+		{ID: "02-hitl", File: "02-hitl.md", Title: "Sign off", Type: "HITL", Status: "open"},
+	}, map[string]any{"explore": true})
+	path := seedExplorationReport(t, m.Dir)
+
+	res := ResolveExploreMark(d, m)
+	section, ok := ExplorationSection(d, Row{ExploreMark: res.Mark, UnexploredReason: res.Reason, ExploreFailure: res.Failure}, m)
+	if !ok || section.Title != ExplorationSectionTitle {
+		t.Fatalf("section = %+v, %v; want the Exploration section", section, ok)
+	}
+	var detail bytes.Buffer
+	RenderTaskSetDetail(d, nil, &detail, "demo", nil, m)
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	_, entry, found := strings.Cut(gate, "Read the exploration report")
+	if !found {
+		t.Fatalf("gate offered no paging entry for the report:\n%s", gate)
+	}
+
+	for surface, text := range map[string]string{
+		"detail section": section.Body,
+		"set view":       detail.String(),
+		"gate preamble":  gate,
+	} {
+		for _, want := range []string{"Explored", path, "647143bb0a85"} {
+			if !strings.Contains(text, want) {
+				t.Fatalf("%s does not carry %q:\n%s", surface, want, text)
+			}
+		}
+		if strings.Contains(text, explorationProse) {
+			t.Fatalf("%s carries the report's body:\n%s", surface, text)
+		}
+	}
+	if !strings.Contains(entry, path) {
+		t.Fatalf("paging entry does not name the report:\n%s", entry)
+	}
+}
diff --git a/tasks/explore_park.go b/tasks/explore_park.go
new file mode 100644
index 00000000..7691cb52
--- /dev/null
+++ b/tasks/explore_park.go
@@ -0,0 +1,86 @@
+package tasks
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ExplorePark is whether a set that declared it needs exploration is parked
+// because its Explore pass gave up, and why (ADR-0262 decisions 5 and 6).
+type ExplorePark struct {
+	Parked bool
+	// Reason is why the last pass gave up, as its Captured run recorded it.
+	// Blank unless Parked.
+	Reason string
+}
+
+// ResolveExplorePark is the single read-side Explore park resolution. Every
+// surface reads the park through the refresh, which lays it over the row here,
+// so the status table, the Work dashboard and the daemon scan cannot disagree.
+//
+// It stores nothing. A parked set still has an eligible AFK task, so the
+// manifest alone derives READY and the daemon would re-select it and explore it
+// forever; the park is therefore derived from the Explore mark, which reads
+// what the pass already left behind. A READY set whose mark is unexplored
+// because its pass failed is parked: a pass that wrote the report would have
+// left one, so a run with no report is a pass that gave up.
+//
+// The three doors out are each a change to one of those inputs: a hand-run pass
+// writes the report, `"explore": false` retracts the declaration, and a drain
+// with --skip-explore runs the set's tasks, after which it is no longer READY or
+// no longer needs a map.
+func ResolveExplorePark(d *Deps, m *Manifest) ExplorePark {
+	if m == nil || DeriveStatus(m) != StatusReady {
+		return ExplorePark{}
+	}
+	return exploreParkFrom(ResolveExploreMark(d, m))
+}
+
+// exploreParkFrom is the park a READY set's Explore mark implies: an unexplored
+// set whose last pass gave up.
+func exploreParkFrom(res ExploreResolution) ExplorePark {
+	if res.Reason != UnexploredPassFailed {
+		return ExplorePark{}
+	}
+	return ExplorePark{Parked: true, Reason: res.Failure}
+}
+
+// exploreGaveUpReason is the last explore run's ending in words. A run that
+// ended clean recorded no reason, because ending clean was not its failure:
+// the Explorer answered with nothing pop could write.
+func exploreGaveUpReason(run capturedRunMeta) string {
+	if reason := strings.TrimSpace(run.Reason); reason != "" {
+		return fmt.Sprintf("%s: %s", run.Outcome, reason)
+	}
+	if run.Outcome == streamOutcomeCompleted {
+		return "the Explorer produced no report"
+	}
+	return run.Outcome
+}
+
+// applyExploreMark lays the Explore mark over the refreshed rows, and the
+// Explore park over the READY ones it parks. Only a set that declared
+// exploration costs a read.
+func applyExploreMark(d *Deps, rows []Row, manifests map[string]*Manifest) {
+	for i := range rows {
+		row := &rows[i]
+		m := manifests[row.ID]
+		res := ResolveExploreMark(d, m)
+		row.ExploreMark, row.UnexploredReason, row.ExploreFailure = res.Mark, res.Reason, res.Failure
+		if row.Status != StatusReady || !exploreParkFrom(res).Parked {
+			continue
+		}
+		row.Status = StatusExploreFailed
+		row.Progress = BuildProgress(m, StatusExploreFailed)
+	}
+}
+
+// exploreParkDoors names the three ways out of the park, in the order a human
+// most often wants them.
+func exploreParkDoors(setID string) []string {
+	return []string{
+		"explore by hand: pop tasks explore " + setID,
+		"drain once unexplored: pop tasks implement " + setID + " --skip-explore",
+		`or set "explore": false in its index.json`,
+	}
+}
diff --git a/tasks/explore_phase.go b/tasks/explore_phase.go
new file mode 100644
index 00000000..23dca016
--- /dev/null
+++ b/tasks/explore_phase.go
@@ -0,0 +1,92 @@
+package tasks
+
+// exploreDirective is the small instruction explorePhase hands back to the
+// drain loop, so the loop skeleton keeps reading as orchestration.
+type exploreDirective int
+
+const (
+	// exploreFallThrough proceeds to task selection: the step was skipped, the
+	// set already had its report, or the pass has just written it.
+	exploreFallThrough exploreDirective = iota
+	// exploreReturn hands the run's result and the returned error back to the
+	// caller: the human interrupted the Explorer, which interrupts the drain, or
+	// the set is parked at EXPLORE-FAILED.
+	exploreReturn
+)
+
+// explorePhase runs the drain's Explore step (ADR-0262): a set whose author
+// declared `"explore": true` and that has no Exploration report yet gets one
+// before its first task is selected, so every builder in the set reads one map.
+//
+// It runs once, at the head of the drain, and the rule is presence alone:
+// absent means write it, present means reuse it. Nothing compares the SHA the
+// report records to the checkout — an implement attempt commits, so any
+// freshness rule would regenerate the report per task.
+//
+// It is the one agent step that stops a drain. A pass that gives up after its
+// retries parks the set at EXPLORE-FAILED rather than letting builders start
+// from separate maps, and a set already parked is not explored again here: the
+// park is what stops a daemon re-exploring it in a loop. --skip-explore passes
+// the step by, which is how a human drains a parked set once unexplored.
+//
+// [work.explore].enabled defaults on, which is safe because the set's own
+// directive is the trigger: a set that never asked never explores. Like the
+// refine step, it declines for a Human completion — the drain does not spend an
+// agent on a set a human declared done — while `pop tasks explore` still runs
+// for one on request.
+func (r *implementRun) explorePhase() (exploreDirective, error) {
+	cfg := r.plan.cfg
+	if r.opts.SkipExplore || !cfg.ExploreEnabled() {
+		return exploreFallThrough, nil
+	}
+	m := r.refresh.Manifests[r.taskSetID]
+	if m == nil || !m.ExploreRequested() || m.HumanCompleted {
+		return exploreFallThrough, nil
+	}
+	if explorationBlock(r.d, m.Dir).HasExploration {
+		return exploreFallThrough, nil
+	}
+	// The park's Progress record was written when the pass gave up; this
+	// stop only repeats the doors.
+	if park := ResolveExplorePark(r.d, m); park.Parked {
+		return r.exploreParked(park.Reason), nil
+	}
+
+	_, err := exploreResolvedSet(r.d, cfg, exploreCoreOptions{
+		DefPath:     r.resolved.DefinitionPath,
+		RuntimePath: r.runtimePath,
+		SetID:       r.taskSetID,
+		Timeout:     r.timeout,
+		Output:      r.out,
+		runExplorer: r.opts.exploreRunner,
+		probeMemo:   r.agentProbeMemo,
+		// The drain is already holding this checkout for this set, so the pass
+		// runs inside that claim rather than asking for it again (ADR-0238).
+		checkoutHeld: true,
+	})
+	if err == nil {
+		return exploreFallThrough, nil
+	}
+	if isInterrupted(err) {
+		return exploreReturn, err
+	}
+	reason := err.Error()
+	if perr := AppendSetProgress(r.d, m.Dir, string(StatusExploreFailed), "Explore phase gave up with no Exploration report: "+reason); perr != nil {
+		return exploreReturn, exitErr(ExitOperational, "record explore park for task set %s: %v", r.taskSetID, perr)
+	}
+	return r.exploreParked(reason), nil
+}
+
+// exploreParked ends the drain at the Explore park: it fills the run's result
+// and tells the operator why the set stopped and the three ways out.
+func (r *implementRun) exploreParked(reason string) exploreDirective {
+	r.result.TaskSetExploreFailed = true
+	r.result.ExploreFailure = reason
+	out := outputFor(r.out)
+	out.line(ansiRed, "Explore failed: task set %s is parked with no Exploration report", r.taskSetID)
+	out.line(ansiDim, "  %s", reason)
+	for _, door := range exploreParkDoors(r.taskSetID) {
+		out.line(ansiDim, "  %s", door)
+	}
+	return exploreReturn
+}
