--- /dev/null
+++ b/tasks/exploration_pointer.go
@@ -0,0 +1,78 @@
+package tasks
+
+import (
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/work"
+)
+
+// explorationBlockView is the set's Exploration report as the implement and
+// Assist prompts name it: a path, never the body, so the whole set builds
+// against one map at no cost to the prompt however long the map grows
+// (ADR-0262). The empty view renders nothing.
+type explorationBlockView struct {
+	HasExploration bool
+	Path           string
+}
+
+// explorationBlock resolves that view for the set at setDir, and the empty view
+// for a set with no report — one never explored, or explored by a pass that
+// did not finish.
+func explorationBlock(d *Deps, setDir string) explorationBlockView {
+	if d == nil {
+		d = defaultDeps
+	}
+	path := filepath.Join(setDir, ExplorationFileName)
+	if _, err := d.FS.Stat(path); err != nil {
+		return explorationBlockView{}
+	}
+	return explorationBlockView{HasExploration: true, Path: path}
+}
+
+// latestExplorationPointer is the set's Exploration report on the shared pointer
+// shape every pass's report is carried by (ADR-0245): its path and the tree its
+// header records, and false when the set has none. The report is flat rather
+// than a timestamped family, so the instant comes from the header, not the name.
+func latestExplorationPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || strings.TrimSpace(m.Dir) == "" {
+		return ReportPointer{}, false
+	}
+	path := filepath.Join(m.Dir, ExplorationFileName)
+	data, err := d.FS.ReadFile(path)
+	if err != nil {
+		return ReportPointer{}, false
+	}
+	body := string(data)
+	p := ReportPointer{Label: exploreReport.PointerLabel, Path: path, WorkSHA: reportHeaderField(body, "Work SHA")}
+	if at, err := time.Parse(time.RFC3339, reportHeaderField(body, exploreReport.WrittenLabel)); err == nil {
+		p.Written = at.UTC().Format("2006-01-02 15:04Z")
+	}
+	return p, true
+}
+
+// ExplorationSectionTitle heads the Exploration section of a set's detail view.
+const ExplorationSectionTitle = "Exploration"
+
+// ExplorationSection is a set's Explore mark as its detail view carries it: the
+// mark the refresh resolved onto the row, with its reason, and the report as a
+// pointer — never its body, which is long enough to bury the items below it.
+// A report on a set that never asked (a hand run) is still pointed at, as a
+// refine report is, but carries no mark; with neither there is no section.
+func ExplorationSection(d *Deps, row Row, m *Manifest) (work.Section, bool) {
+	var lines []string
+	if phrase := exploreMarkPhrase(row.exploreResolution()); phrase != "" {
+		lines = append(lines, phrase)
+	}
+	if p, ok := latestExplorationPointer(d, m); ok {
+		lines = append(lines, p.Summary())
+	}
+	if len(lines) == 0 {
+		return work.Section{}, false
+	}
+	return work.Section{Title: ExplorationSectionTitle, Body: strings.Join(lines, "\n")}, true
+}
