+func TestTaskExploreThatDoesNotFinishLeavesTheReportUntouched(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		interrupted bool
+		wantCode    int
+	}{
+		{name: "every attempt fails", wantCode: tasks.ExitOperational},
+		{name: "interrupted between attempts", interrupted: true, wantCode: tasks.ExitInterrupted},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			explorer := &scriptedExplorer{reply: "## Half a map", exitCode: 1}
+			_, td, setDir := setupExploreCmdFixture(t, explorer)
+			td.RetryDelayWait = func(io.Writer, time.Duration) bool { return tc.interrupted }
+			resetTaskFlags()
+			t.Cleanup(resetTaskFlags)
+
+			err := runTaskExploreWith(td, io.Discard, "demo")
+			var exit *tasks.ExitError
+			if !errors.As(err, &exit) || exit.Code != tc.wantCode {
+				t.Fatalf("explore error = %v, want exit code %d", err, tc.wantCode)
+			}
+			body, readErr := os.ReadFile(filepath.Join(setDir, tasks.ExplorationFileName))
+			if readErr != nil || string(body) != "OLD-MAP\n" {
+				t.Fatalf("report = %q (%v), want it untouched", body, readErr)
+			}
+		})
+	}
+}
