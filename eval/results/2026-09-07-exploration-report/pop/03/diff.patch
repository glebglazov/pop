+// setupExploreCmdFixture registers a "demo" set whose author declined
+// exploration, carrying a spec, two task bodies and an exploration report from
+// an earlier pass.
+func setupExploreCmdFixture(t *testing.T, explorer *scriptedExplorer) (root string, td *tasks.Deps, setDir string) {
+	t.Helper()
+	root, _, td = setupCmdRepoTest(t)
+	td.Runner = explorer
+	td.LookPath = func(string) (string, error) { return "/bin/claude", nil }
+
+	tasksDir := cmdTasksDir(t, td, root)
+	setDir = filepath.Join(tasksDir, "demo")
+	if err := os.MkdirAll(setDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for name, body := range map[string]string{
+		tasks.ManifestFileName: `{"explore":false,"tasks":[` +
+			`{"id":"01-a","file":"01-a.md","title":"Report is an artifact","type":"AFK","effort":"standard","status":"open"},` +
+			`{"id":"02-b","file":"02-b.md","title":"Explore by hand","type":"AFK","effort":"standard","status":"open","blocked_by":["01-a"]}]}`,
+		"01-a.md":                 "## What to build\n\nTASK-ONE-BODY in tasks/artifacts.go.\n\n## Acceptance criteria\n\n- [ ] ok\n",
+		"02-b.md":                 "## What to build\n\nTASK-TWO-BODY in tasks/refine.go.\n\n## Acceptance criteria\n\n- [ ] ok\n",
+		tasks.SpecFileName:        "# SPEC-BODY\n",
+		tasks.ExplorationFileName: "OLD-MAP\n",
+	} {
+		if err := os.WriteFile(filepath.Join(setDir, name), []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := tasks.RegisterWith(td, tasksDir, tasks.StatePathFor(tasksDir)); err != nil {
+		t.Fatal(err)
+	}
+	return root, td, setDir
+}
