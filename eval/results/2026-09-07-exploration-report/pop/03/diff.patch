+	guide := AuthoringGuide()
+
+	printedKey := func(suffix string) string {
+		t.Helper()
+		m := regexp.MustCompile("(?m)^- `([a-z_]+)` — " + regexp.QuoteMeta(suffix)).FindStringSubmatch(guide)
+		if m == nil {
+			t.Fatalf("guide has no set-level key bullet starting %q", suffix)
