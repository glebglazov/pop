+
+// TestExploreRunIsSpentInItsOwnBucket: an Explorer invocation is filed under the
+// `explore` phase, and the spend lens counts it as exploration rather than
+// folding a set-level run into implement spend.
+func TestExploreRunIsSpentInItsOwnBucket(t *testing.T) {
+	t.Parallel()
+	at := time.Date(2026, 8, 16, 12, 0, 0, 0, time.UTC)
+	d, _, setDir := setupRefineFixture(t, at)
+	m := LoadManifest(d, "demo", filepath.Join(setDir, "index.json"))
+
+	invocation, err := ResolveAgentInvocationWithMode("claude", "", "prompt", "/rt", AgentOutputAuto)
+	if err != nil {
+		t.Fatalf("resolve invocation: %v", err)
+	}
+	rec := newStreamRecorder(io.Discard, fakeClock(at, 100*time.Millisecond))
+	explorerRole(d, io.Discard, setDir, "demo", "sha1").persistAnswer(rec, invocation, 1, streamOutcomeCompleted, "", 0, "## Where things live")
+
+	breakdown, err := buildSpendSetBreakdown(d, "demo", m, loadRateTableForSpend(d), nil)
+	if err != nil {
+		t.Fatalf("buildSpendSetBreakdown: %v", err)
+	}
+	if breakdown.ExploreRunCount != 1 || breakdown.ImplementRunCount != 0 {
+		t.Fatalf("buckets = explore %d / implement %d, want the run counted as explore",
+			breakdown.ExploreRunCount, breakdown.ImplementRunCount)
+	}
+	if len(breakdown.Rows) != 1 || breakdown.Rows[0].TaskID != "explore" {
+		t.Fatalf("rows = %+v, want one explore row", breakdown.Rows)
+	}
+}
