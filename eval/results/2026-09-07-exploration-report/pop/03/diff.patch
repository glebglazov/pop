+// TestTaskGuideExploreKeysAreTheOnesTheManifestReads takes the two explore
+// keys as the guide prints them, writes them into a set, and reads them back
+// through the manifest accessors: a renamed key fails here, not at a drain.
+func TestTaskGuideExploreKeysAreTheOnesTheManifestReads(t *testing.T) {
