new file mode 100644
index 00000000..7b41d08e
--- /dev/null
+++ b/tasks/exploration_pointer_test.go
@@ -0,0 +1,102 @@
+package tasks
+
+import (
+	"bytes"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// explorationLine is one line of a report body long enough that inlining it
+// anywhere would show.
+const explorationLine = "- `tasks/prompt.go` owns BuildAgentPrompt; every claim names a path.\n"
+
+// priorArtBlock cuts the `## Before you hand-write mechanism` block out of an
+// implement prompt: from its heading to the close-out paragraph that follows it.
+func priorArtBlock(t *testing.T, prompt string) string {
+	t.Helper()
+	start := strings.Index(prompt, "## Before you hand-write mechanism")
+	end := strings.Index(prompt, "This attempt is a single non-interactive session.")
+	if start < 0 || end < start {
+		t.Fatalf("prompt carries no prior-art block:\n%s", prompt)
+	}
+	return prompt[start:end]
+}
+
+// TestImplementAttemptIsHandedTheExplorationReport drains a set that has a
+// report and reads the prompt the agent was actually handed: it names the
+// report by path with the correction duty, never its body however long, and
+// its prior-art block is the one a set without a report gets, byte for byte.
+func TestImplementAttemptIsHandedTheExplorationReport(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixture(t, "demo", plannedAndRemediationSet()[:1])
+	reportPath := filepath.Join(env.tasksDir, "demo", ExplorationFileName)
+	writeTaskMD(t, filepath.Dir(reportPath), ExplorationFileName, "# Exploration report\n\n"+strings.Repeat(explorationLine, 400))
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{changeFile: "work.txt", changeData: "x\n", checkTask: true, summary: "done"})
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.TaskSetOverride = "demo"
+	if _, err := RunTaskSetWith(env.deps(), nil, func(string) (*config.Config, error) {
+		return &config.Config{}, nil
+	}, opts); err != nil {
+		t.Fatalf("RunTaskSetWith: %v", err)
+	}
+
+	prompts := fakeAgentPrompts(agent)
+	if len(prompts) != 1 {
+		t.Fatalf("agent saw %d prompts, want one", len(prompts))
+	}
+	prompt := prompts[0]
+	// The drain names the set by its resolved directory, so the report's path is
+	// read off the task path the prompt carries.
+	reportPath = filepath.Join(filepath.Dir(parseFakeAgentTaskPath(prompt)), ExplorationFileName)
+	for _, want := range []string{
+		"## This set's Exploration report (NOT inlined — read the file yourself)",
+		"- Document: " + reportPath,
+		"Correct it only where this attempt falsified a line of it",
+		"change nothing else in it",
+		"Two files\noutside it are also yours: the task file above",
+	} {
+		if !strings.Contains(prompt, want) {
+			t.Fatalf("prompt missing %q:\n%s", want, prompt)
+		}
+	}
+	if strings.Contains(prompt, explorationLine) {
+		t.Fatalf("prompt inlined the report:\n%s", prompt)
+	}
+	if strings.Contains(prompt, "The task file\nabove is the one file you also edit") {
+		t.Fatalf("prompt still names the task file as the only edit outside the checkout:\n%s", prompt)
+	}
+
+	unexplored := BuildAgentPrompt(bareDeps(), filepath.Join(goldenSetDir, "01-afk.md"), goldenRuntimePath, "")
+	if got, want := priorArtBlock(t, prompt), priorArtBlock(t, unexplored); got != want {
+		t.Fatalf("prior-art block changed with a report:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+// TestAttendedSessionNamesTheExplorationReport: an Assist session on a set that
+// has a report is told its path, never its body; on a set without one it is
+// told nothing about it.
+func TestAttendedSessionNamesTheExplorationReport(t *testing.T) {
+	t.Parallel()
+	m := goldenBareManifest()
+	reportPath := filepath.Join(goldenSetDir, ExplorationFileName)
+	explored := &Deps{FS: &promptFixtureFS{files: map[string]string{
+		reportPath: "# Exploration report\n\n" + strings.Repeat(explorationLine, 400),
+	}}, Git: stubGit("", "", "")}
+
+	prompt := BuildAssistPrompt(explored, nil, goldenSetID, m, StatusReady, "", "")
+	if !strings.Contains(prompt, "## Exploration report (NOT inlined — read the file yourself)\n- Document: "+reportPath) {
+		t.Fatalf("assist prompt does not name the report:\n%s", prompt)
+	}
+	if strings.Contains(prompt, explorationLine) {
+		t.Fatalf("assist prompt inlined the report:\n%s", prompt)
+	}
+
+	if unexplored := BuildAssistPrompt(bareDeps(), nil, goldenSetID, m, StatusReady, "", ""); strings.Contains(unexplored, ExplorationFileName) {
+		t.Fatalf("assist prompt names a report the set does not have:\n%s", unexplored)
+	}
+}
diff --git a/tasks/explore.go b/tasks/explore.go
new file mode 100644
index 00000000..75355575
--- /dev/null
+++ b/tasks/explore.go
@@ -0,0 +1,371 @@
+package tasks
+
+import (
+	"errors"
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/prompt"
+	"github.com/glebglazov/pop/project"
+)
+
+// DefaultExploreEffort is the model-strength tier the Explorer runs at when no
+// CLI flag or manifest `explorer` override names one. Every builder in the set
+// reads what it writes, so a wrong map costs every attempt after it; exploration
+// defaults where verification and refine do.
+const DefaultExploreEffort = "heavy"
+
+// exploreReport is the Exploration report's header on the shared pass-report
+// machinery (ADR-0245). Only the render is borrowed: the report is flat at
+// ExplorationFileName rather than a timestamped family under a sub-directory,
+// because the pass runs once and has nothing to supersede (ADR-0262 decision 1).
+var exploreReport = passReport{
+	ArtifactType: ArtifactTypeExploration,
+	Title:        "Exploration report",
+	WrittenLabel: "Explored",
+	AgentLabel:   "Explorer",
+	Noun:         "explore",
+	PointerLabel: "Exploration",
+}
+
+// ExploreOptions configures a `pop tasks explore <set>` run.
+type ExploreOptions struct {
+	ResolveInput ResolveInput
+	// TaskSetID is the bare Task-set identifier to explore.
+	TaskSetID string
+	// Agents is the ordered CLI Explorer fallback list (`--agent`, repeatable).
+	// Empty ⇒ the manifest `explorer` override, then [work.explore].agents, then
+	// [work.implement].agents.
+	Agents []string
+	// Effort is the CLI Explorer effort override (`--effort`). Empty ⇒ the
+	// manifest `explorer` override, then [work.explore].effort, then
+	// DefaultExploreEffort.
+	Effort string
+	// Timeout bounds one Explorer attempt. Zero uses DefaultAttemptTimeout.
+	Timeout time.Duration
+	// Output receives the live agent stream and the run's chrome.
+	Output io.Writer
+	// Wait is the `--wait` / `--no-wait` tri-state for admission to the checkout
+	// (ADR-0239). The unset default waits at a terminal and refuses elsewhere.
+	Wait AdmissionWaitChoice
+	// ConfirmIn is the invocation's input, read only to tell a human at a
+	// terminal from a script when resolving Wait.
+	ConfirmIn io.Reader
+}
+
+// ExploreResult is the outcome of one explore pass.
+type ExploreResult struct {
+	SetID   string
+	WorkSHA string
+	// Path is the Exploration report written.
+	Path string
+	// Body is the document itself.
+	Body string
+}
+
+// exploreCoreOptions carries the already-resolved inputs to the core explore
+// routine, so tests can drive it without real path-resolution git calls, and so
+// the drain's Explore step can run the same pass as the hand-run verb.
+type exploreCoreOptions struct {
+	DefPath     string
+	RuntimePath string
+	SetID       string
+	Agents      []string
+	Effort      string
+	Timeout     time.Duration
+	Output      io.Writer
+	// admission is the policy the Explorer acquires the checkout under
+	// (ADR-0238/0239).
+	admission AdmissionPolicy
+	// checkoutHeld says the caller is already inside a claim on this checkout —
+	// the drain's own Explore step, which runs under the drain's running Drain
+	// row. The pass then takes nothing, as the drain's refine step takes nothing.
+	checkoutHeld bool
+	// runExplorer returns the Explorer's report and the agent that wrote it. Nil
+	// ⇒ the configured Explorer runs; tests replace the agent spawn here.
+	runExplorer func(prompt string) (string, string, error)
+	probeMemo   *agentAvailabilityProbeMemo
+}
+
+// ExploreTaskSet explores a set using default dependencies.
+func ExploreTaskSet(opts ExploreOptions) (*ExploreResult, error) {
+	return ExploreTaskSetWith(defaultDeps, project.DefaultDeps(), config.Load, opts)
+}
+
+// ExploreTaskSetWith is `pop tasks explore <set>` (ADR-0262): it resolves the
+// set, hands a fresh Explorer the set's manifest listing, task bodies and spec,
+// and writes what comes back as the set's Exploration report. A hand run is the
+// human re-opening the question, so it ignores the set's `explore` key and
+// replaces a report already there.
+func ExploreTaskSetWith(d *Deps, pd *project.Deps, loadConfig func(string) (*config.Config, error), opts ExploreOptions) (*ExploreResult, error) {
+	resolved, err := ResolvePathsWith(d, pd, loadConfig, opts.ResolveInput)
+	if err != nil {
+		return nil, err
+	}
+	runtimePath, err := ResolveRuntimePathWith(d, resolved.ProjectPath, opts.ResolveInput.RuntimeOverride)
+	if err != nil {
+		return nil, err
+	}
+	cfg, _ := loadConfig(d.defaultConfigPath())
+	return exploreResolvedSet(d, cfg, exploreCoreOptions{
+		DefPath:     resolved.DefinitionPath,
+		RuntimePath: runtimePath,
+		SetID:       strings.TrimSpace(opts.TaskSetID),
+		Agents:      opts.Agents,
+		Effort:      opts.Effort,
+		Timeout:     opts.Timeout,
+		Output:      opts.Output,
+		admission:   opts.Wait.Policy(opts.ConfirmIn),
+	})
+}
+
+// exploreResolvedSet is the resolved-path core of `pop tasks explore`: it runs
+// the Explorer and writes its report flat in the set directory. The report is
+// written only after the Explorer has answered in full, so an interrupted or
+// failed pass leaves the set's existing report as it was.
+func exploreResolvedSet(d *Deps, cfg *config.Config, opts exploreCoreOptions) (*ExploreResult, error) {
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{SetID: opts.SetID, DefPath: opts.DefPath})
+	if err != nil {
+		return nil, err
+	}
+	// The Explorer reads the checkout, and a map drawn while another drain
+	// rewrites the files describes a tree that never existed (ADR-0238).
+	if !opts.checkoutHeld {
+		hold, err := AcquireTreeStable(d, opts.RuntimePath, opts.SetID, opts.Output, opts.admission)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = hold.Release() }()
+	}
+
+	// Read before the Explorer runs: it is the tree the report describes.
+	workSHA := verifyWorkSHA(d, opts.RuntimePath)
+	priorRun, _ := latestSetLevelRun(d, m, spendPhaseExplore)
+	body, agent, err := explorerAnswer(d, cfg, m, opts, workSHA)
+	if err != nil {
+		fileUnrecordedExploreFailure(d, m, opts, workSHA, priorRun, err)
+		return nil, err
+	}
+	path := filepath.Join(m.Dir, ExplorationFileName)
+	_, statErr := d.FS.Stat(path)
+	replaced := statErr == nil
+	doc := exploreReport.renderDocument(d.Now().UTC(), opts.SetID, workSHA, "", agent, body)
+	if err := d.FS.WriteFile(path, []byte(doc), 0o644); err != nil {
+		return nil, exitErr(ExitOperational, "write exploration report: %v", err)
+	}
+	printExploreWritten(opts.Output, opts.SetID, path, replaced)
+	return &ExploreResult{SetID: opts.SetID, WorkSHA: workSHA, Path: path, Body: doc}, nil
+}
+
+// explorerAnswer runs the Explorer — the configured one, or the test's — on the
+// set's prompt, and returns its report beside the agent that wrote it. An empty
+// report is a failed pass.
+func explorerAnswer(d *Deps, cfg *config.Config, m *Manifest, opts exploreCoreOptions, workSHA string) (string, string, error) {
+	run := opts.runExplorer
+	if run == nil {
+		sel, err := resolveExplorer(opts.Agents, opts.Effort, m, cfg)
+		if err != nil {
+			return "", "", err
+		}
+		run = func(prompt string) (string, string, error) {
+			return runConfiguredExplorer(d, cfg, sel, m.Dir, opts.SetID, workSHA, opts.RuntimePath, prompt, opts.Output, opts.Timeout, opts.probeMemo)
+		}
+	}
+	body, agent, err := run(buildExplorerPrompt(d, m, workSHA))
+	if err != nil {
+		return "", "", err
+	}
+	if strings.TrimSpace(body) == "" {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", opts.SetID)
+	}
+	return body, agent, nil
+}
+
+// fileUnrecordedExploreFailure files one `explore` Captured run for a pass that
+// gave up without the walk filing any — every preset unavailable, or the
+// Explorer unresolvable — with the error as its reason. The Explore mark, and
+// the park derived from it, read only the latest explore run, so without this a
+// set whose agents are all missing would read "not yet run", stay READY, and be
+// re-selected and re-explored by every drain and the daemon. A human's
+// interrupt is not a pass that gave up, and files nothing.
+func fileUnrecordedExploreFailure(d *Deps, m *Manifest, opts exploreCoreOptions, workSHA string, priorRun capturedRunMeta, err error) {
+	if isInterrupted(err) {
+		return
+	}
+	if latest, ok := latestSetLevelRun(d, m, spendPhaseExplore); ok && latest.RunID != priorRun.RunID {
+		return
+	}
+	exitCode := ExitOperational
+	var ee *ExitError
+	if errors.As(err, &ee) {
+		exitCode = ee.Code
+	}
+	rec := newStreamRecorder(io.Discard, d.Now)
+	_ = persistSetLevelRun(d, opts.Output, spendPhaseExplore, m.Dir, opts.SetID, workSHA, rec, "", "", 0, streamOutcomeFailed, err.Error(), exitCode, "")
+}
+
+// resolveExplorer applies the Explorer precedence chain, highest first: CLI
+// flags → the per-set manifest `explorer` override → [work.explore] →
+// [work.implement].agents / DefaultExploreEffort. Agents and effort resolve
+// independently, as the Refiner's do.
+func resolveExplorer(cliAgents []string, cliEffort string, m *Manifest, cfg *config.Config) (verifierSelection, error) {
+	agents := nonEmptyStrings(cliAgents)
+	effort := strings.TrimSpace(cliEffort)
+	if over := m.ExplorerOverride(); over != nil {
+		if len(agents) == 0 {
+			agents = nonEmptyStrings(over.Agents)
+		}
+		if effort == "" {
+			effort = strings.TrimSpace(over.Effort)
+		}
+	}
+	if e := cfg.ExploreSettings(); e != nil && effort == "" {
+		effort = strings.TrimSpace(e.Effort)
+	}
+	if len(agents) == 0 {
+		resolved, err := ResolveAgentGroupPresets(cfg.ExploreAgentList(), cfg)
+		if err != nil {
+			return verifierSelection{}, err
+		}
+		agents = resolved
+	}
+	if effort == "" {
+		effort = DefaultExploreEffort
+	}
+	return verifierSelection{Agents: agents, Effort: effort}, nil
+}
+
+// runConfiguredExplorer walks the resolved Explorer agent list through the
+// shared fallback walk at the built-in task retry defaults, and returns the
+// report beside the agent that wrote it.
+func runConfiguredExplorer(d *Deps, cfg *config.Config, sel verifierSelection, taskSetDir, setID, workSHA, runtimePath, prompt string, out io.Writer, timeout time.Duration, probeMemo *agentAvailabilityProbeMemo) (string, string, error) {
+	if timeout <= 0 {
+		timeout = DefaultAttemptTimeout
+	}
+	quotaRetryAfter, err := resolveAgentQuotaRetryAfter(cfg)
+	if err != nil {
+		return "", "", exitErr(ExitSetup, "%v", err)
+	}
+	walked, err := runAgentFallbackWalk(d, agentFallbackWalk{
+		role:            explorerRole(d, out, taskSetDir, setID, workSHA),
+		sel:             sel,
+		setID:           setID,
+		runtimePath:     runtimePath,
+		prompt:          prompt,
+		out:             out,
+		errOut:          out,
+		timeout:         timeout,
+		maxTries:        config.DefaultTaskMaxTries,
+		retryDelays:     append([]time.Duration(nil), config.DefaultTaskAttemptRetryDelays...),
+		quotaRetryAfter: quotaRetryAfter,
+		probeMemo:       probeMemo,
+		cfg:             cfg,
+	})
+	if err != nil {
+		return "", "", err
+	}
+	// Prose from an attempt that timed out or died is half a map, and writing it
+	// would replace a complete report with it.
+	if strings.TrimSpace(walked.Answer) != "" && !walked.AnswerRetryEligible {
+		return walked.Answer, walked.Agent, nil
+	}
+	if len(walked.Unavailable) == 0 {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", setID)
+	}
+	return "", "", exitErr(ExitSetup, "%s", formatHumanHealingExhaustionMessage(walked.Unavailable))
+}
+
+// explorerRole is what the shared fallback walk calls the Explorer. Its runs
+// are filed under the `explore` phase so a set's spend shows what mapping it
+// cost. It is the read-only role: the Explorer records the code as it found it,
+// so it is spawned without its editing tools. Like the Refiner it answers in
+// prose with no format, so the Refiner's retry rule is its rule too.
+func explorerRole(d *Deps, errOut io.Writer, taskSetDir, setID, workSHA string) agentRole {
+	return agentRole{
+		Noun:   "Explorer agent",
+		Gerund: "Exploring",
+		Phase:  spendPhaseExplore,
+		Persist: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int) {
+			_ = persistSetLevelRun(d, errOut, spendPhaseExplore, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, try, outcome, reason, exitCode, "")
+		},
+		PersistAnswer: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int, answer string) {
+			_ = persistSetLevelRun(d, errOut, spendPhaseExplore, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, try, outcome, reason, exitCode, "")
+		},
+		PersistSkipped: func(rec *streamRecorder, invocation *AgentInvocation, model string, try int, reason string, exitCode int) {
+			_ = persistSkippedSetLevelRun(d, errOut, spendPhaseExplore, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, model, try, reason, exitCode)
+		},
+		RetryEligible: refineAttemptRetryEligible,
+		ReadOnly:      true,
+	}
+}
+
+// printExploreWritten tells the operator where the report went and how to read
+// it.
+func printExploreWritten(w io.Writer, setID, path string, replaced bool) {
+	if w == nil {
+		return
+	}
+	out := outputFor(w)
+	out.line(ansiBold, "━━ Explore for %s", setID)
+	out.line(ansiDim, "   Document: %s", path)
+	if replaced {
+		out.line(ansiDim, "   Replaces the previous report.")
+	}
+	out.line(ansiDim, "   Read it: pop tasks artifacts %s --show %s", setID, ExplorationFileName)
+}
+
+// buildExplorerPrompt assembles the Explorer's prompt: pop's role framing and
+// report shape around the set's manifest listing, every task body, and the spec
+// where one exists. It asks for the code as found and nothing else — in
+// particular nothing about prior art, which stays in the builder's own frame
+// (ADR-0262 decision 7).
+func buildExplorerPrompt(d *Deps, m *Manifest, workSHA string) string {
+	view := explorerPromptView{
+		TaskSet:  m.Stem,
+		WorkSHA:  workSHA,
+		Listing:  gateTaskRows(m),
+		Tasks:    explorerTaskBodies(d, m),
+		Recorded: workSHA != "",
+	}
+	if spec, ok := readSpec(d, m); ok {
+		view.SpecRecorded = true
+		view.Spec = spec
+	}
+	return prompt.MustRender(promptTemplates, "explorer.tmpl.md", view)
+}
+
+// explorerPromptView is what the Explorer's template renders against. Every
+// optional section is a named boolean beside the text it guards.
+type explorerPromptView struct {
+	TaskSet string
+	// Recorded says the checkout has a HEAD, which WorkSHA then names.
+	Recorded     bool
+	WorkSHA      string
+	SpecRecorded bool
+	Spec         string
+	Listing      []taskRow
+	Tasks        []explorerTaskBody
+}
+
+// explorerTaskBody is one task as the Explorer reads it: its heading and its
+// body, or the read failure that stands in for the body.
+type explorerTaskBody struct {
+	Heading string
+	Body    taskBodyRow
+}
+
+// explorerTaskBodies reads every task in the manifest, whatever its type and
+// status: the Explorer maps the area the whole set touches.
+func explorerTaskBodies(d *Deps, m *Manifest) []explorerTaskBody {
+	rows := make([]explorerTaskBody, 0, len(m.Tasks))
+	for _, task := range m.Tasks {
+		rows = append(rows, explorerTaskBody{
+			Heading: taskHeading(task),
+			Body:    readTaskBody(d, filepath.Join(m.Dir, task.File)),
+		})
+	}
+	return rows
+}
