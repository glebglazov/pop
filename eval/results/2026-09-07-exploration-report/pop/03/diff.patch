+	}, map[string]any{
+		explore:  true,
+		explorer: map[string]any{"agents": []string{"claude"}, "effort": "heavy"},
+	})
+	m := LoadManifest(&Deps{FS: deps.NewRealFileSystem()}, "demo", filepath.Join(taskDir, ManifestFileName))
+	if !m.Valid {
+		t.Fatalf("a set written from the guide's keys does not validate: %v", m.Errors)
+	}
+	if !m.ExploreRequested() {
+		t.Fatalf("guide prints %q as the explore key, but the manifest does not read it", explore)
+	}
+	if over := m.ExplorerOverride(); over == nil || over.Effort != "heavy" {
