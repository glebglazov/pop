+func TestTaskExploreWritesTheReportAndFilesAnExploreRun(t *testing.T) {
+	explorer := &scriptedExplorer{reply: "## Where things live\n\n- `tasks/artifacts.go` owns NEW-MAP."}
+	root, td, setDir := setupExploreCmdFixture(t, explorer)
+	resetTaskFlags()
+	t.Cleanup(resetTaskFlags)
+	head, err := exec.Command("git", "-C", root, "rev-parse", "HEAD").Output()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sha := strings.TrimSpace(string(head))
+
+	var out bytes.Buffer
+	if err := runTaskExploreWith(td, &out, "demo"); err != nil {
+		t.Fatalf("explore: %v\n%s", err, out.String())
+	}
+
+	// The Explorer was handed the whole set and asked for the code as found.
+	if len(explorer.prompts) != 1 {
+		t.Fatalf("explorer prompts = %d, want 1", len(explorer.prompts))
+	}
+	prompt := explorer.prompts[0]
+	for _, want := range []string{
+		"- 01-a [AFK open] Report is an artifact",
+		"- 02-b [AFK open] Explore by hand",
+		"TASK-ONE-BODY", "TASK-TWO-BODY", "SPEC-BODY",
+		"names a path or a symbol",
+		"about one page",
+		"the tree at commit " + sha,
+	} {
+		if !strings.Contains(prompt, want) {
+			t.Fatalf("prompt missing %q:\n%s", want, prompt)
+		}
+	}
+	if strings.Contains(strings.ToLower(prompt), "prior art") {
+		t.Fatalf("prompt asks about prior art:\n%s", prompt)
+	}
+	// It looks without touching.
+	if !strings.Contains(strings.Join(explorer.argv[0], " "), "--disallowedTools=Edit,Write,NotebookEdit") {
+		t.Fatalf("explorer spawned with its editing tools: %q", explorer.argv[0])
+	}
+
+	// The report replaces the old one, flat in the set directory.
+	body, err := os.ReadFile(filepath.Join(setDir, tasks.ExplorationFileName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	report := string(body)
+	for _, want := range []string{
+		"# Exploration report — demo",
+		"- Work SHA: " + tasks.ShortSHA(sha),
+		"- Explorer: claude",
+		"`tasks/artifacts.go` owns NEW-MAP.",
+	} {
+		if !strings.Contains(report, want) {
+			t.Fatalf("report missing %q:\n%s", want, report)
+		}
+	}
+	if strings.Contains(report, "OLD-MAP") {
+		t.Fatalf("old report survived:\n%s", report)
+	}
+
+	// The pass filed a run of its own phase.
+	var stream bytes.Buffer
+	if err := runTaskStreamWith(td, &stream, "demo"); err != nil {
+		t.Fatal(err)
+	}
+	if !regexp.MustCompile(`(?m)^demo\s+Explore\s*$`).MatchString(stream.String()) {
+		t.Fatalf("stream has no Explore row:\n%s", stream.String())
+	}
+}
