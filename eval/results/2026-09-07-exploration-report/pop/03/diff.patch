+
+// scriptedExplorer stands in for the agent CLI at the process seam: the
+// availability probe answers logged in, and each headless run prints the claude
+// stream script returns for it and exits as told. Every process is a real one,
+// started by the real runner, so the walk, the recorder and the Captured run
+// beneath it are the production path.
+type scriptedExplorer struct {
+	reply    string
+	exitCode int
+	prompts  []string
+	argv     [][]string
+}
+
+var promptFilePattern = regexp.MustCompile(`\S*pop-agent-prompt-\S*\.md`)
+
+func (r *scriptedExplorer) Run(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (int, error) {
+	proc, err := r.Start(ctx, dir, stdout, stderr, name, args...)
+	if err != nil {
+		return 1, err
+	}
+	return proc.Wait()
+}
+
+func (r *scriptedExplorer) Start(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (*tasks.ManagedProcess, error) {
+	if tasks.IsAgentAvailabilityProbeCommand(name, args) {
+		return tasks.RealCommandRunner{}.Start(ctx, dir, stdout, stderr, "sh", "-c", `echo '{"loggedIn":true}'`)
+	}
+	r.argv = append(r.argv, append([]string{name}, args...))
+	if path := promptFilePattern.FindString(strings.Join(args, " ")); path != "" {
+		if body, err := os.ReadFile(path); err == nil {
+			r.prompts = append(r.prompts, string(body))
+		}
+	}
+	result, _ := json.Marshal(r.reply)
+	stream := `{"type":"system","subtype":"init"}` + "\n" + `{"type":"result","subtype":"success","result":` + string(result) + `}`
+	return tasks.RealCommandRunner{}.Start(ctx, dir, stdout, stderr, "sh", "-c", `printf '%s\n' "$1"; exit "$2"`, "sh", stream, strconv.Itoa(r.exitCode))
+}
