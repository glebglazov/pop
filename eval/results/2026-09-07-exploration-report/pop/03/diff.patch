diff --git a/tasks/drain_explore_park_test.go b/tasks/drain_explore_park_test.go
new file mode 100644
index 00000000..9b718126
--- /dev/null
+++ b/tasks/drain_explore_park_test.go
@@ -0,0 +1,222 @@
+package tasks
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// exploreParkConfig points the Explorer at one agent, so the scripted runner
+// below is the only process every attempt reaches.
+func exploreParkConfig() *config.Config {
+	return &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Agents: config.AgentEntries{{Cmd: "claude"}}}}}
+}
+
+// parkDeclaredSet drains a declared set whose Explorer fails every attempt
+// through the real fallback walk, and returns the drain's result, its output
+// and how many times the Explorer was started.
+func parkDeclaredSet(t *testing.T, env *runTaskSetFixture) (*RunTaskSetResult, string, int) {
+	t.Helper()
+	failing := &scriptedRefineRunner{}
+	for i := 0; i < config.DefaultTaskMaxTries+2; i++ {
+		failing.runs = append(failing.runs, scriptedRefineRun{output: claudeRefineStream("## Where"), exitCode: 2})
+	}
+	d := env.deps()
+	d.LookPath = func(string) (string, error) { return "/bin/claude", nil }
+	d.Runner = &probeNeutralRunner{inner: failing}
+
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, "", &buf)
+	opts.TaskSetOverride = "demo"
+	result, err := RunTaskSetWith(d, nil, func(string) (*config.Config, error) { return exploreParkConfig(), nil }, opts)
+	if err != nil {
+		t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+	}
+	return result, buf.String(), failing.calls
+}
+
+func demoRow(t *testing.T, env *runTaskSetFixture) Row {
+	t.Helper()
+	d := env.deps()
+	refresh, err := RefreshWith(d, env.tasksDir, DefaultStatePathWith(d))
+	if err != nil {
+		t.Fatalf("RefreshWith: %v", err)
+	}
+	row := findRow(refresh, "demo")
+	if row == nil {
+		t.Fatal("no row for demo")
+	}
+	return *row
+}
+
+func exploreParkRecords(t *testing.T, env *runTaskSetFixture) int {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(env.tasksDir, "demo", ProgressFileName))
+	if err != nil && !os.IsNotExist(err) {
+		t.Fatal(err)
+	}
+	return strings.Count(string(data), "[set] "+string(StatusExploreFailed))
+}
+
+// TestAnExplorePassThatGivesUpParksTheSet drives a declared set whose Explorer
+// never answers: the pass spends the standard retry cap, the drain stops with
+// the task untouched, the set reads EXPLORE-FAILED rather than BLOCKED, one
+// set-level record names the phase and the reason, and neither automatic
+// selection nor a second drain explores it again.
+func TestAnExplorePassThatGivesUpParksTheSet(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreTestSet(), map[string]any{"explore": true})
+
+	result, out, calls := parkDeclaredSet(t, env)
+
+	if calls != config.DefaultTaskMaxTries {
+		t.Fatalf("Explorer started %d times, want the standard cap of %d", calls, config.DefaultTaskMaxTries)
+	}
+	if !result.TaskSetExploreFailed || len(result.Completed) != 0 {
+		t.Fatalf("result = %+v, want the drain parked before any task ran", result)
+	}
+	if !strings.Contains(out, "pop tasks implement demo --skip-explore") {
+		t.Fatalf("output does not name the doors out:\n%s", out)
+	}
+	row := demoRow(t, env)
+	if row.Status != StatusExploreFailed || row.ExploreFailure == "" {
+		t.Fatalf("row = %s (%q), want EXPLORE-FAILED with a reason", row.Status, row.ExploreFailure)
+	}
+	if n := exploreParkRecords(t, env); n != 1 {
+		t.Fatalf("progress has %d park records, want exactly one", n)
+	}
+	data, _ := os.ReadFile(filepath.Join(env.tasksDir, "demo", ProgressFileName))
+	if !strings.Contains(string(data), "Explore phase gave up") || !strings.Contains(string(data), "produced no report") {
+		t.Fatalf("progress record does not name the phase and the reason:\n%s", data)
+	}
+
+	d := env.deps()
+	refresh, err := RefreshWith(d, env.tasksDir, DefaultStatePathWith(d))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if id, _, err := SelectTaskSet(refresh, ""); err == nil {
+		t.Fatalf("automatic selection picked %q, want the parked set passed over", id)
+	}
+
+	again, _, calls := parkDeclaredSet(t, env)
+	if calls != 0 || !again.TaskSetExploreFailed {
+		t.Fatalf("second drain started the Explorer %d times (parked=%v), want none and still parked", calls, again.TaskSetExploreFailed)
+	}
+	if n := exploreParkRecords(t, env); n != 1 {
+		t.Fatalf("progress has %d park records after a second drain, want still one", n)
+	}
+}
+
+// TestAnExplorePassWithNoAgentToRunParksTheSet: when every Explorer preset is
+// missing, the walk starts no agent and so files no run of its own. The pass
+// still parks the set on the first drain, and later drains and automatic
+// selection pass over it rather than re-exploring it in a loop.
+func TestAnExplorePassWithNoAgentToRunParksTheSet(t *testing.T) {
+	t.Parallel()
+	env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreTestSet(), map[string]any{"explore": true})
+	d := env.deps()
+	d.LookPath = func(string) (string, error) { return "", errors.New("not on PATH") }
+	drain := func() *RunTaskSetResult {
+		var buf bytes.Buffer
+		opts := env.runTaskSetOpts(true, "", &buf)
+		opts.TaskSetOverride = "demo"
+		result, err := RunTaskSetWith(d, nil, func(string) (*config.Config, error) { return exploreParkConfig(), nil }, opts)
+		if err != nil {
+			t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+		}
+		return result
+	}
+
+	for i := 0; i < 3; i++ {
+		if result := drain(); !result.TaskSetExploreFailed || len(result.Completed) != 0 {
+			t.Fatalf("drain %d: result = %+v, want parked before any task ran", i+1, result)
+		}
+	}
+	row := demoRow(t, env)
+	if row.Status != StatusExploreFailed || !strings.Contains(row.ExploreFailure, "not found") {
+		t.Fatalf("row = %s (%q), want EXPLORE-FAILED naming the missing agent", row.Status, row.ExploreFailure)
+	}
+	if n := exploreParkRecords(t, env); n != 1 {
+		t.Fatalf("progress has %d park records after three drains, want exactly one", n)
+	}
+	refresh, err := RefreshWith(d, env.tasksDir, DefaultStatePathWith(d))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if id, _, err := SelectTaskSet(refresh, ""); err == nil {
+		t.Fatalf("automatic selection picked %q, want the parked set passed over", id)
+	}
+}
+
+// TestAParkedSetHasThreeDoorsOut: --skip-explore drains it once without
+// exploring and without parking, a hand-run pass that writes the report clears
+// the park, and so does retracting the declaration.
+func TestAParkedSetHasThreeDoorsOut(t *testing.T) {
+	t.Parallel()
+
+	t.Run("skip explore", func(t *testing.T) {
+		t.Parallel()
+		env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreTestSet(), map[string]any{"explore": true})
+		parkDeclaredSet(t, env)
+
+		agent := writeSequentialFakeAgent(t, env.root, []fakeAgentStep{{summary: "built"}})
+		var buf bytes.Buffer
+		opts := env.runTaskSetOpts(true, agent, &buf)
+		opts.TaskSetOverride = "demo"
+		opts.SkipExplore = true
+		opts.exploreRunner = func(string) (string, string, error) {
+			t.Fatal("a drain with --skip-explore must not explore")
+			return "", "", nil
+		}
+		result, err := RunTaskSetWith(env.deps(), nil, func(string) (*config.Config, error) { return exploreParkConfig(), nil }, opts)
+		if err != nil {
+			t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+		}
+		if !result.TaskSetDone || result.TaskSetExploreFailed {
+			t.Fatalf("result = %+v, want the set drained to DONE unexplored\n%s", result, buf.String())
+		}
+		if n := exploreParkRecords(t, env); n != 1 {
+			t.Fatalf("progress has %d park records, want only the original one", n)
+		}
+	})
+
+	t.Run("hand-run pass", func(t *testing.T) {
+		t.Parallel()
+		env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreTestSet(), map[string]any{"explore": true})
+		parkDeclaredSet(t, env)
+
+		d := env.deps()
+		_, err := exploreResolvedSet(d, nil, exploreCoreOptions{
+			DefPath:      env.tasksDir,
+			RuntimePath:  env.root,
+			SetID:        "demo",
+			checkoutHeld: true,
+			runExplorer: func(string) (string, string, error) {
+				return "## Where things live\n\n- `main.go`.", "claude", nil
+			},
+		})
+		if err != nil {
+			t.Fatalf("explore by hand: %v", err)
+		}
+		if row := demoRow(t, env); row.Status != StatusReady {
+			t.Fatalf("status = %s, want READY once the report exists", row.Status)
+		}
+	})
+
+	t.Run("retract the declaration", func(t *testing.T) {
+		t.Parallel()
+		env := setupRunTaskSetFixtureWithKeys(t, "demo", exploreTestSet(), map[string]any{"explore": true})
+		parkDeclaredSet(t, env)
+
+		writeManifestWithSetKeys(t, filepath.Join(env.tasksDir, "demo"), exploreTestSet(), map[string]any{"explore": false})
+		if row := demoRow(t, env); row.Status != StatusReady {
+			t.Fatalf("status = %s, want READY once the set no longer asks", row.Status)
+		}
+	})
+}
