@@ -0,0 +1,97 @@
+package setkind
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/deps"
+	"github.com/glebglazov/pop/tasks"
+	"github.com/glebglazov/pop/work"
+)
+
+const explorationSectionProse = "SECRET-EXPLORATION-PROSE"
+
+// containerForExploreRow builds the one container a refreshed row produces,
+// over a filesystem that reads the set's folder for real.
+func containerForExploreRow(t *testing.T, row tasks.Row, setDir string) work.Container {
+	t.Helper()
+	rows := []tasks.Row{row}
+	m := &tasks.Manifest{Valid: true, Dir: setDir, Tasks: []tasks.Task{{ID: "01-a", File: "01-a.md", Type: "AFK", Status: "open"}}}
+	d := testDeps(t, rows)
+	real := deps.NewRealFileSystem()
+	d.Tasks.FS = &deps.MockFileSystem{
+		EvalSymlinksFunc: func(path string) (string, error) { return path, nil },
+		ReadDirFunc:      real.ReadDir,
+		ReadFileFunc:     real.ReadFile,
+		StatFunc:         real.Stat,
+	}
+	d.Refresh = func(string) (*tasks.RefreshResult, error) {
+		return &tasks.RefreshResult{Rows: rows, Manifests: map[string]*tasks.Manifest{"demo": m}}, nil
+	}
+	scan := scanFixture{Name: "pop", ProjectPath: "/repo/main", RuntimePath: "/repo/main", DefinitionPath: "/def", RepoKey: "repo-key"}
+	got, err := rowsForStatic(d, &config.Config{}, staticForScan(scan, "main", false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 {
+		t.Fatalf("containers = %+v, want one", got)
+	}
+	return got[0]
+}
+
+// TestExploreMarkReachesTheWorkRowAndDetail: the mark the refresh resolved rides
+// onto the container, so the STATUS cell the dashboard and `pop work status`
+// print carries it, and the detail view leads with it, its reason, and the
+// report as a pointer — never the body.
+func TestExploreMarkReachesTheWorkRowAndDetail(t *testing.T) {
+	t.Run("unexplored", func(t *testing.T) {
+		c := containerForExploreRow(t, tasks.Row{ID: "demo", Status: tasks.StatusReady,
+			ExploreMark: tasks.ExploreMarkUnexplored, UnexploredReason: tasks.UnexploredNotYetRun}, t.TempDir())
+		if cell := tasks.WorkRowStatusCell(c); !strings.Contains(cell, "READY · unexplored") {
+			t.Fatalf("status cell = %q, want the mark beside READY", cell)
+		}
+		if len(c.DetailSections) == 0 || c.DetailSections[0].Title != tasks.ExplorationSectionTitle {
+			t.Fatalf("detail sections = %+v, want the Exploration section first", c.DetailSections)
+		}
+		if body := c.DetailSections[0].Body; !strings.Contains(body, "Unexplored: not yet run") {
+			t.Fatalf("section = %q, want the reason beside the mark", body)
+		}
+	})
+
+	t.Run("explored", func(t *testing.T) {
+		setDir := t.TempDir()
+		path := filepath.Join(setDir, tasks.ExplorationFileName)
+		doc := "# Exploration report — demo\n\n- Explored: 2026-09-07T12:00:00Z\n- Work SHA: 647143bb0a85\n\n## Where\n\n" + explorationSectionProse + "\n"
+		if err := os.WriteFile(path, []byte(doc), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		c := containerForExploreRow(t, tasks.Row{ID: "demo", Status: tasks.StatusReady, ExploreMark: tasks.ExploreMarkExplored}, setDir)
+		if cell := tasks.WorkRowStatusCell(c); !strings.Contains(cell, "explored") || strings.Contains(cell, "unexplored") {
+			t.Fatalf("status cell = %q, want explored", cell)
+		}
+		body := c.DetailSections[0].Body
+		for _, want := range []string{"Explored", path, "647143bb0a85"} {
+			if !strings.Contains(body, want) {
+				t.Fatalf("section = %q, want %q", body, want)
+			}
