@@ -0,0 +1,116 @@
+package tasks
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// drainExploreSet drains a one-task set through the explore step. setKeys are
+// written onto the manifest; a non-empty report is placed as the set's
+// Exploration report first. It returns how many times the Explorer ran, the
+// report as the drain left it, and the drain's result.
+func drainExploreSet(t *testing.T, cfg *config.Config, setKeys map[string]any, report string) (int, string, *RunTaskSetResult) {
+	t.Helper()
+	tasks := []Task{{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"}}
+	env := setupRunTaskSetFixture(t, "demo", tasks)
+	setDir := filepath.Join(env.tasksDir, "demo")
+	writeManifestWithSetKeys(t, setDir, tasks, setKeys)
+	reportPath := filepath.Join(setDir, ExplorationFileName)
+	if report != "" {
+		if err := os.WriteFile(reportPath, []byte(report), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	agent := writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"})
+
+	explored := 0
+	var buf bytes.Buffer
+	opts := env.runTaskSetOpts(true, agent, &buf)
+	opts.exploreRunner = func(string) (string, string, error) {
+		explored++
+		// The pass runs at the head of the drain: no task has been built yet.
+		m := LoadManifest(env.deps(), "demo", filepath.Join(setDir, ManifestFileName))
+		if m.Tasks[0].Status != "open" {
+			t.Errorf("Explorer ran after task %s reached %q; want it before any task", m.Tasks[0].ID, m.Tasks[0].Status)
+		}
+		return "## Where things live\n`tasks/seam.go` owns `Seam`.", "claude", nil
+	}
+	result, err := RunTaskSetWith(env.deps(), nil, func(string) (*config.Config, error) { return cfg, nil }, opts)
+	if err != nil {
+		t.Fatalf("RunTaskSetWith: %v\n%s", err, buf.String())
+	}
+	body, _ := os.ReadFile(reportPath)
+	return explored, string(body), result
+}
+
+func exploreConfig(enabled bool) *config.Config {
+	return &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{Enabled: &enabled}}}
+}
+
+// TestDrainExploresADeclaredSetOnceBeforeItsFirstTask drives a whole drain both
+// ways: a declared set with no report is explored before its first task, and
+// one whose report is already there reuses it and spends nothing on exploring.
+// Either way the set's work is built.
+func TestDrainExploresADeclaredSetOnceBeforeItsFirstTask(t *testing.T) {
+	t.Parallel()
+	declared := map[string]any{manifestExploreKey: true}
+
+	t.Run("no report", func(t *testing.T) {
+		t.Parallel()
+		// Absent configuration explores: the group defaults on.
+		explored, report, result := drainExploreSet(t, nil, declared, "")
+		if explored != 1 {
+			t.Fatalf("Explorer ran %d times, want once", explored)
+		}
+		if !strings.Contains(report, "`tasks/seam.go` owns `Seam`.") {
+			t.Fatalf("report = %q, want the Explorer's map", report)
+		}
+		if !result.TaskSetDone {
+			t.Fatalf("result = %+v, want the set built to DONE", result)
+		}
+	})
+
+	t.Run("report already there", func(t *testing.T) {
+		t.Parallel()
+		explored, report, result := drainExploreSet(t, nil, declared, "OLD-MAP\n")
+		if explored != 0 {
+			t.Fatalf("Explorer ran %d times, want the existing report reused", explored)
+		}
+		if report != "OLD-MAP\n" {
+			t.Fatalf("report = %q, want it untouched", report)
+		}
+		if !result.TaskSetDone {
+			t.Fatalf("result = %+v, want the set built to DONE", result)
+		}
+	})
+}
+
+// TestDrainExploresNothingUnlessTheSetAsksAndTheMachineAllows: a set that never
+// declared exploration, a set that declared it while [work.explore] is off, and
+// a human-completed set are all drained without a pass.
+func TestDrainExploresNothingUnlessTheSetAsksAndTheMachineAllows(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name    string
+		cfg     *config.Config
+		setKeys map[string]any
+	}{
+		{name: "never declared", cfg: exploreConfig(true)},
+		{name: "declared false", setKeys: map[string]any{manifestExploreKey: false}},
+		{name: "config off", cfg: exploreConfig(false), setKeys: map[string]any{manifestExploreKey: true}},
+		{name: "human completed", setKeys: map[string]any{manifestExploreKey: true, "human_completed": true}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			explored, report, _ := drainExploreSet(t, tc.cfg, tc.setKeys, "")
+			if explored != 0 || report != "" {
+				t.Fatalf("Explorer ran %d times and left report %q, want no pass", explored, report)
+			}
+		})
+	}
+}
