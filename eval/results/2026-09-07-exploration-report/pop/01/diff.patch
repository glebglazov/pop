+// TestLoadWorkExploreSettings pins the [work.explore] group (ADR-0262): the one
+// agent phase that is on unless the human says otherwise, with agents and effort
+// of its own.
+func TestLoadWorkExploreSettings(t *testing.T) {
+	load := func(t *testing.T, body string) *Config {
+		t.Helper()
+		configPath := filepath.Join(t.TempDir(), "config.toml")
+		if err := os.WriteFile(configPath, []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		cfg, err := LoadWith(isolatedDeps(t), configPath)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return cfg
+	}
+
+	if !load(t, "\n").ExploreEnabled() {
+		t.Fatal("an undeclared [work.explore] must explore")
+	}
+	if !load(t, "[work.explore]\neffort = \"light\"\n").ExploreEnabled() {
+		t.Fatal("a [work.explore] without enabled must explore")
+	}
+	off := load(t, "[work.explore]\nenabled = false\neffort = \"standard\"\nagents = [\"codex\"]\n")
+	if off.ExploreEnabled() {
+		t.Fatal("expected [work.explore] enabled = false to switch the step off")
+	}
+	if e := off.ExploreSettings(); e == nil || e.Effort != "standard" {
+		t.Fatalf("explore settings = %+v, want effort standard", e)
+	}
+	if got := strings.Join(off.ExploreAgentList().Commands, ","); got != "codex" {
+		t.Fatalf("explore agents = %q, want codex", got)
+	}
+}
