+package tasks
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// tasksStatusSurfaces renders the set as `pop tasks status` lists it and as
+// `pop tasks status <set>` shows it, both from the refreshed row.
+func tasksStatusSurfaces(t *testing.T, f *exploreParkFixture) (Row, string, string) {
+	t.Helper()
+	row := f.row()
+	var detail bytes.Buffer
+	m := LoadManifest(f.env.deps(), "demo", filepath.Join(f.setDir, ManifestFileName))
+	RenderTaskSetDetail(f.env.deps(), nil, &detail, "demo", &row, m)
+	return row, statusColumnText(row), detail.String()
+}
+
+// TestADeclaredSetCarriesTheExploreMarkWithItsReason: a set that asked for
+// exploration and has no report carries the mark beside its status, with
+// where the work stopped as the reason beside it — not yet run, then the pass
+// failed.
+func TestADeclaredSetCarriesTheExploreMarkWithItsReason(t *testing.T) {
+	t.Parallel()
+	f := newExploreParkFixture(t)
+
+	row, column, detail := tasksStatusSurfaces(t, f)
+	if row.Explore.Mark != ExploreMarkUnexplored || row.Explore.Reason != ExploreReasonNotYetRun {
+		t.Fatalf("resolution = %+v, want unexplored, not yet run", row.Explore)
+	}
+	if column != "READY · unexplored: not yet run" {
+		t.Fatalf("status column = %q", column)
+	}
+	if !strings.Contains(detail, "unexplored: not yet run") {
+		t.Fatalf("detail view lacks the mark:\n%s", detail)
+	}
+
+	f.parkedSet()
+	row, column, detail = tasksStatusSurfaces(t, f)
+	if row.Explore.Mark != ExploreMarkUnexplored || row.Explore.Reason != ExploreReasonFailed {
+		t.Fatalf("resolution = %+v, want unexplored, pass failed", row.Explore)
+	}
+	if column != "EXPLORE-FAILED · unexplored: pass failed" {
+		t.Fatalf("status column = %q", column)
+	}
+	if !strings.Contains(detail, "unexplored: pass failed") {
+		t.Fatalf("detail view lacks the reason:\n%s", detail)
+	}
+}
+
+// TestAnExploredSetShowsTheReportAsAPointer: once the report is written the
+// mark says so, and the detail view names the report's path and the tree it
+// records, never its body.
+func TestAnExploredSetShowsTheReportAsAPointer(t *testing.T) {
+	t.Parallel()
+	f := newExploreParkFixture(t)
+	const prose = "`tasks/seam.go` owns `Seam`."
+	res, err := exploreResolvedSet(f.env.deps(), nil, exploreCoreOptions{
+		DefPath:     f.env.tasksDir,
+		RuntimePath: f.env.root,
+		SetID:       "demo",
+		Output:      io.Discard,
+		runExplorer: func(string) (string, string, error) { return "## Where things live\n" + prose, "claude", nil },
+	})
+	if err != nil {
+		t.Fatalf("explore: %v", err)
+	}
+
+	row, column, detail := tasksStatusSurfaces(t, f)
+	if row.Explore.Mark != ExploreMarkExplored || !sameFile(t, row.Explore.Report.Path, res.Path) {
+		t.Fatalf("resolution = %+v, want explored at %s", row.Explore, res.Path)
+	}
+	if column != "READY · explored" {
+		t.Fatalf("status column = %q", column)
+	}
+	if !strings.Contains(detail, row.Explore.Report.Path) || !strings.Contains(detail, ShortSHA(res.WorkSHA)) {
+		t.Fatalf("detail view lacks the pointer (%s at %s):\n%s", row.Explore.Report.Path, ShortSHA(res.WorkSHA), detail)
+	}
+	if strings.Contains(detail, prose) {
+		t.Fatalf("detail view inlined the report body:\n%s", detail)
+	}
+}
+
+// TestASetThatNeverAskedCarriesNoExploreMark: no key, or `"explore": false`,
+// is no mark anywhere — even with a report left on disk.
+func TestASetThatNeverAskedCarriesNoExploreMark(t *testing.T) {
+	t.Parallel()
+	f := newExploreParkFixture(t)
+	tasks := []Task{{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"}}
+	writeManifestWithSetKeys(t, f.setDir, tasks, map[string]any{manifestExploreKey: false})
+	if err := os.WriteFile(filepath.Join(f.setDir, ExplorationFileName), []byte("# Exploration report — demo\n\n- Work SHA: abc123a\n\nbody\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	row, column, detail := tasksStatusSurfaces(t, f)
+	if row.Explore != (ExploreResolution{}) {
+		t.Fatalf("resolution = %+v, want none", row.Explore)
+	}
+	if column != "READY" || strings.Contains(detail, "explored") || strings.Contains(detail, "Exploration report") {
+		t.Fatalf("a set that never asked carries a mark:\n%s\n%s", column, detail)
+	}
+}
+
+// TestTheSignOffGateNamesTheExplorationReport: the gate names the report
+// beside the refine report — a pointer in the preamble and a paging entry —
+// and a set that never asked gets neither.
+func TestTheSignOffGateNamesTheExplorationReport(t *testing.T) {
+	t.Parallel()
+	d, m := hitlFixture(t)
+	path := filepath.Join(m.Dir, ExplorationFileName)
+	if err := os.WriteFile(path, []byte("# Exploration report — demo\n\n- Explored: 2026-10-04T07:38:19Z\n- Work SHA: abc123a\n\nSECRET-EXPLORE-PROSE\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	gate, _ := hitlGateOutput(t, d, m, "0\n")
+	if strings.Contains(gate, "Exploration report") || strings.Contains(gate, "Read the exploration report") {
+		t.Fatalf("a set that never asked has the report named at the gate:\n%s", gate)
+	}
+
+	m.Unknown = map[string]json.RawMessage{manifestExploreKey: json.RawMessage("true")}
+	gate, _ = hitlGateOutput(t, d, m, "0\n")
+	for _, want := range []string{"Exploration report of abc123a, written 2026-10-04 07:38Z: " + path, "Read the exploration report"} {
+		if !strings.Contains(gate, want) {
+			t.Fatalf("gate lacks %q:\n%s", want, gate)
+		}
+	}
+	if strings.Contains(gate, "SECRET-EXPLORE-PROSE") {
+		t.Fatalf("gate inlined the report body:\n%s", gate)
+	}
+}
+
+// sameFile compares two paths through their symlinks, since a temp directory
+// may be reached by more than one name.
+func sameFile(t *testing.T, a, b string) bool {
+	t.Helper()
+	ra, errA := filepath.EvalSymlinks(a)
+	rb, errB := filepath.EvalSymlinks(b)
+	return errA == nil && errB == nil && ra == rb
+}
diff --git a/tasks/explore_park.go b/tasks/explore_park.go
new file mode 100644
index 00000000..b71b5c75
--- /dev/null
+++ b/tasks/explore_park.go
@@ -0,0 +1,68 @@
+package tasks
+
+import (
+	"fmt"
+	"strings"
+)
+
+// exploreParkProgressOutcome is the outcome word of the one set-level Progress
+// record a drain appends when its Explore phase parks the set.
+const exploreParkProgressOutcome = "EXPLORE-FAILED"
+
+// ResolveExplorePark is the single read-side Explore park resolution
+// (ADR-0262 decision 6): whether a set that declared its tasks interrelated is
+// parked because its Explore phase gave up without a report.
+//
+// The park is the Explore mark's failed reason on a set that would otherwise be
+// picked and re-explored: a READY set no human completed. A pass that wrote the
+// report clears it, and so does `"explore": false`, since both change the mark.
+func ResolveExplorePark(d *Deps, m *Manifest) bool {
+	return exploreParks(m, ResolveExploreMark(d, m))
+}
+
+// exploreParks is the park rule over a mark already resolved for m.
+func exploreParks(m *Manifest, res ExploreResolution) bool {
+	if m == nil || m.HumanCompleted || res.Reason != ExploreReasonFailed {
+		return false
+	}
+	return DeriveStatus(m) == StatusReady
+}
+
+// applyExploreResolutions stamps each row with its Explore mark and overlays
+// the Explore park onto rows built from the manifest alone, so every surface
+// that reads a Refresh — `pop tasks status`, automatic selection, the Work
+// dashboard and the daemon's scan — sees the same mark and the same
+// EXPLORE-FAILED, and none of them picks a parked set.
+func applyExploreResolutions(d *Deps, rows []Row, manifests map[string]*Manifest) {
+	for i := range rows {
+		row := &rows[i]
+		m := manifests[row.ID]
+		row.Explore = ResolveExploreMark(d, m)
+		if row.Status != StatusReady || !exploreParks(m, row.Explore) {
+			continue
+		}
+		row.Status = StatusExploreFailed
+		row.Progress = BuildProgress(m, StatusExploreFailed)
+	}
+}
+
+// exploreParkDoors names the three ways out of the park, in the order a human
+// most likely wants them: map the set, build it unmapped once, or retract the
+// declaration.
+func exploreParkDoors(setID string) []string {
+	return []string{
+		"explore by hand: pop tasks explore " + setID,
+		"drain once unexplored: pop tasks implement " + setID + " --skip-explore",
+		fmt.Sprintf(`retract the declaration: set "%s": false in the set's index.json`, manifestExploreKey),
+	}
+}
+
+// exploreParkSummary is the Progress record's text: the phase and why it gave
+// up, readable without opening the captured run.
+func exploreParkSummary(reason string) string {
+	reason = strings.TrimSpace(reason)
+	if reason == "" {
+		return "Explore phase gave up without writing the Exploration report; the set is parked."
+	}
+	return fmt.Sprintf("Explore phase gave up without writing the Exploration report: %s; the set is parked.", reason)
+}
diff --git a/tasks/explore_phase.go b/tasks/explore_phase.go
new file mode 100644
index 00000000..d30dd93a
--- /dev/null
+++ b/tasks/explore_phase.go
@@ -0,0 +1,104 @@
+package tasks
+
+// exploreDirective is the instruction explorePhase hands back to the drain
+// loop, in the shape of refineDirective: fall through to task selection, or
+// return because the human interrupted the Explorer.
+type exploreDirective int
+
+const (
+	// exploreFallThrough proceeds to the loop's first task selection — explore
+	// skipped, the set's report reused, or written.
+	exploreFallThrough exploreDirective = iota
+	// exploreReturn hands the run's result and the returned error back to the
+	// caller: the human interrupted the Explorer, which interrupts the drain.
+	exploreReturn
+)
+
+// explorePhase runs the drain's Explore step (ADR-0262): with [work.explore]
+// enabled — its default — and a set that asked for exploration, a fresh
+// Explorer writes the set's Exploration report before any task is selected.
+//
+// It is the one agent phase that runs unasked, which is safe only because the
+// set's own `"explore": true` is the trigger: a set that never declared it
+// costs nothing. A report already there is reused as it is. Nothing compares
+// the tree the report records to the checkout; absent means write, present
+// means reuse, and a drain that has nothing left to build has nothing to map
+// for.
+//
+// A human-completed set is skipped, as the refine step skips one; `pop tasks
+// explore` still maps it on request.
+//
+// It is also the one agent phase that can stop a drain (decision 5). A pass
+// that gives up after its retry cap parks the set at EXPLORE-FAILED rather than
+// letting builders start from separate maps, and a set already parked stops
+// here without exploring again. `--skip-explore` drains past both, once.
+func (r *implementRun) explorePhase() (exploreDirective, error) {
+	if r.opts.SkipExplore {
+		return exploreFallThrough, nil
+	}
+	refresh, err := RefreshWith(r.d, r.resolved.DefinitionPath, r.statePath)
+	if err != nil {
+		// The loop's own Refresh reports the failure the drain stops on.
+		return exploreFallThrough, nil
+	}
+	m := refresh.Manifests[r.taskSetID]
+	// The park stands whatever [work.explore] says: turning the drain's step off
+	// does not make the map the set's author asked for any less missing.
+	if ResolveExplorePark(r.d, m) {
+		r.stopAtExplorePark(refresh, "")
+		return exploreReturn, nil
+	}
+	cfg := r.plan.cfg
+	if !cfg.ExploreEnabled() {
+		return exploreFallThrough, nil
+	}
+	if m == nil || !m.Valid || m.HumanCompleted || !m.ExploreRequested() {
+		return exploreFallThrough, nil
+	}
+	if explorationBlock(r.d, m.Dir).HasExploration {
+		return exploreFallThrough, nil
+	}
+	if _, selErr := SelectTaskInSet(refresh, r.taskSetID); selErr != nil {
+		return exploreFallThrough, nil
+	}
+
+	_, err = exploreResolvedSet(r.d, cfg, exploreCoreOptions{
+		DefPath:     r.resolved.DefinitionPath,
+		RuntimePath: r.runtimePath,
+		SetID:       r.taskSetID,
+		Timeout:     r.timeout,
+		Output:      r.out,
+		runExplorer: r.opts.exploreRunner,
+		probeMemo:   r.agentProbeMemo,
+		// The drain is already holding this checkout for this set (ADR-0238).
+		checkoutHeld: true,
+	})
+	if err == nil {
+		return exploreFallThrough, nil
+	}
+	if isInterrupted(err) {
+		return exploreReturn, err
+	}
+	if ResolveExplorePark(r.d, m) {
+		// The park is recorded once, by the drain that parked the set; a later
+		// drain that finds it parked only says so.
+		if perr := AppendSetProgress(r.d, m.Dir, exploreParkProgressOutcome, exploreParkSummary(err.Error())); perr != nil {
+			return exploreReturn, exitErr(ExitOperational, "append explore park progress: %v", perr)
+		}
+		r.stopAtExplorePark(refresh, err.Error())
+		return exploreReturn, nil
+	}
+	// No attempt was spent — no agent could start, or the pass never reached
+	// one — so the set is not parked, and it is not built unmapped either: the
+	// drain stops on the error and the next one explores again.
+	return exploreReturn, err
+}
+
+// stopAtExplorePark ends the drain at a parked set: the result says so, and
+// the summary names the ways out.
+func (r *implementRun) stopAtExplorePark(refresh *RefreshResult, reason string) {
+	r.result.Refresh = refresh
+	r.result.TaskSetExploreFailed = true
+	r.result.ExploreFailedReason = reason
+	printTaskSetSummary(r.out, r.result)
+}
