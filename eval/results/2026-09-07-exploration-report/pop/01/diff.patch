diff --git a/cmd/tasks_explore_test.go b/cmd/tasks_explore_test.go
new file mode 100644
index 00000000..f0575c95
--- /dev/null
+++ b/cmd/tasks_explore_test.go
@@ -0,0 +1,164 @@
+package cmd
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/tasks"
+)
+
+// explorerReplayRunner stands in for the agent binary: it records the argv pop
+// spawned the Explorer with and the prompt file that argv names, and prints a
+// claude stream whose result is report. Availability probes succeed without
+// being recorded.
+type explorerReplayRunner struct {
+	report string
+	args   []string
+	prompt string
+}
+
+var promptFileArg = regexp.MustCompile(`Read the file (\S+) in full`)
+
+func (r *explorerReplayRunner) Run(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (int, error) {
+	proc, err := r.Start(ctx, dir, stdout, stderr, name, args...)
+	if err != nil {
+		return 1, err
+	}
+	return proc.Wait()
+}
+
+func (r *explorerReplayRunner) Start(ctx context.Context, dir string, stdout, stderr io.Writer, name string, args ...string) (*tasks.ManagedProcess, error) {
+	if tasks.IsAgentAvailabilityProbeCommand(name, args) {
+		return tasks.RealCommandRunner{}.Start(ctx, dir, stdout, stderr, "true")
+	}
+	r.args = args
+	if match := promptFileArg.FindStringSubmatch(strings.Join(args, " ")); match != nil {
+		data, _ := os.ReadFile(match[1])
+		r.prompt = string(data)
+	}
+	result, _ := json.Marshal(r.report)
+	stream := `{"type":"system","subtype":"init"}` + "\n" + `{"type":"result","subtype":"success","result":` + string(result) + `}`
+	return tasks.RealCommandRunner{}.Start(ctx, dir, stdout, stderr, "printf", "%s\n", stream)
+}
+
+func (r *explorerReplayRunner) StartWithEnv(ctx context.Context, dir string, env []string, stdout, stderr io.Writer, name string, args ...string) (*tasks.ManagedProcess, error) {
+	return r.Start(ctx, dir, stdout, stderr, name, args...)
+}
+
+// TestTaskExploreWritesTheReportAndFilesItsRun drives `pop tasks explore` end to
+// end on a set whose `explore` key declines exploration: what the Explorer is
+// handed, the report pop writes in place of the one already there, and the
+// captured run `pop tasks stream` replays.
+func TestTaskExploreWritesTheReportAndFilesItsRun(t *testing.T) {
+	root, _, td := setupCmdRepoTest(t)
+	resetTaskFlags()
+	t.Cleanup(resetTaskFlags)
+	taskDefPath = cmdTasksDir(t, td, root)
+	taskExploreAgents = []string{"claude"}
+	t.Cleanup(func() { taskExploreAgents = nil })
+
+	setDir := filepath.Join(taskDefPath, "demo")
+	if err := os.MkdirAll(setDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	manifest := `{"explore": false, "tasks": [
+		{"id": "01-seam", "file": "01-seam.md", "title": "Shape the seam", "type": "AFK", "status": "done"},
+		{"id": "02-use", "file": "02-use.md", "title": "Use the seam", "type": "AFK", "status": "open", "blocked_by": ["01-seam"]}
+	]}`
+	for name, body := range map[string]string{
+		tasks.ManifestFileName:    manifest,
+		"01-seam.md":              "SEAM-TASK-BODY\n\n## Acceptance criteria\n\n- [x] ok\n",
+		"02-use.md":               "USE-TASK-BODY\n\n## Acceptance criteria\n\n- [ ] ok\n",
+		tasks.SpecFileName:        "SPEC-BODY\n",
+		tasks.ExplorationFileName: "# Exploration report — demo\n\nOLD-MAP\n",
+	} {
+		if err := os.WriteFile(filepath.Join(setDir, name), []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	runner := &explorerReplayRunner{report: "## Exploration\n\nThe tree at HEAD. `tasks/seam.go` owns `Seam`."}
+	td.Runner = runner
+	td.LookPath = func(string) (string, error) { return "/bin/claude", nil }
+
+	var out bytes.Buffer
+	if err := runTaskExploreWith(td, &out, "demo"); err != nil {
+		t.Fatalf("explore: %v\n%s", err, out.String())
+	}
+
+	for _, want := range []string{
+		"- 01-seam [AFK done] Shape the seam (",
+		filepath.Join("demo", "01-seam.md") + ")",
+		"- 02-use [AFK open] Use the seam (",
+		filepath.Join("demo", "02-use.md") + "); blocked_by: 01-seam",
+		"SEAM-TASK-BODY",
+		"USE-TASK-BODY",
+		"SPEC-BODY",
+		"Every claim names a path or a symbol",
+		"about one page",
+		"states the tree you describe",
+		"Work SHA: ",
+	} {
+		if !strings.Contains(runner.prompt, want) {
+			t.Fatalf("explorer prompt missing %q:\n%s", want, runner.prompt)
+		}
+	}
+	if strings.Contains(strings.ToLower(runner.prompt), "prior art") {
+		t.Fatalf("the Explorer was asked about prior art:\n%s", runner.prompt)
+	}
+	// The Explorer looks and changes nothing, so it runs read-only.
+	if !slices.Contains(runner.args, "--disallowedTools=Edit,Write,NotebookEdit") {
+		t.Fatalf("the Explorer was not spawned read-only: %q", runner.args)
+	}
+
+	body, err := os.ReadFile(filepath.Join(setDir, tasks.ExplorationFileName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{
+		"# Exploration report — demo",
+		"- Explored: ",
+		"- Work SHA: ",
+		"- Explorer: claude",
+		"`tasks/seam.go` owns `Seam`.",
+	} {
+		if !strings.Contains(string(body), want) {
+			t.Fatalf("report missing %q:\n%s", want, body)
+		}
+	}
+	if strings.Contains(string(body), "OLD-MAP") {
+		t.Fatalf("the hand run kept the old report:\n%s", body)
+	}
+	if !strings.Contains(out.String(), "Replaces the previous report.") {
+		t.Fatalf("output does not say the report was replaced:\n%s", out.String())
+	}
+
+	var replay bytes.Buffer
+	if err := runTaskStreamWith(td, &replay, "demo"); err != nil {
+		t.Fatalf("stream: %v", err)
+	}
+	if !strings.Contains(replay.String(), "demo  Explore\n") {
+		t.Fatalf("the explore run is not in the set's captured runs:\n%s", replay.String())
+	}
+}
+
+// TestExplorerSteeringFlagsRegistered pins `pop tasks explore`'s surface: the
+// checkout, agent and effort steering the Refiner takes. It has no --show,
+// because `pop tasks artifacts --show` already prints the report.
+func TestExplorerSteeringFlagsRegistered(t *testing.T) {
+	for _, name := range []string{"task-runtime-path", "timeout", "agent", "effort", "wait", "no-wait"} {
+		if taskExploreCmd.Flags().Lookup(name) == nil {
+			t.Fatalf("tasks explore --%s flag not registered", name)
+		}
+	}
+	if got := taskExploreCmd.Flags().Lookup("agent").Value.Type(); got != "stringArray" {
+		t.Fatalf("tasks explore --agent type = %q, want stringArray (repeatable)", got)
+	}
+}
