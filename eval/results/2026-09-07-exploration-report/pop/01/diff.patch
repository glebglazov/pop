diff --git a/tasks/explore.go b/tasks/explore.go
new file mode 100644
index 00000000..974c1f9a
--- /dev/null
+++ b/tasks/explore.go
@@ -0,0 +1,350 @@
+package tasks
+
+import (
+	"io"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/prompt"
+	"github.com/glebglazov/pop/project"
+)
+
+// DefaultExploreEffort is the model-strength tier the Explorer runs at when
+// neither a CLI flag nor the set's `explorer` directive names one. Every builder
+// in the set works from the one map it writes, so a wrong line costs every task
+// after it: exploration defaults where verification and refine do.
+const DefaultExploreEffort = "heavy"
+
+// exploreReport is the Exploration report's header and render on the shared
+// pass-report machinery (ADR-0262). It borrows only those: the report is one
+// flat `exploration.md` that each pass replaces, so it has no directory, no
+// timestamped file names and no newest-by-name scan.
+var exploreReport = passReport{
+	ArtifactType: ArtifactTypeExploration,
+	Title:        "Exploration report",
+	WrittenLabel: "Explored",
+	AgentLabel:   "Explorer",
+	PointerLabel: "Exploration report",
+}
+
+// ExploreOptions configures a `pop tasks explore <set>` run.
+type ExploreOptions struct {
+	ResolveInput ResolveInput
+	// TaskSetID is the bare Task-set identifier to explore.
+	TaskSetID string
+	// Agents is the ordered CLI Explorer fallback list (`--agent`, repeatable).
+	// Empty ⇒ the set's `explorer` directive, then [work.implement].agents.
+	Agents []string
+	// Effort is the CLI Explorer effort override (`--effort`). Empty ⇒ the
+	// set's `explorer` directive, then DefaultExploreEffort.
+	Effort string
+	// Timeout bounds one Explorer attempt. Zero uses DefaultAttemptTimeout.
+	Timeout time.Duration
+	// Output receives the live agent stream and the run's chrome.
+	Output io.Writer
+	// Wait is the `--wait` / `--no-wait` tri-state for admission to the checkout
+	// (ADR-0239). The unset default waits at a terminal and refuses elsewhere.
+	Wait AdmissionWaitChoice
+	// ConfirmIn is the invocation's input, read only to tell a human at a
+	// terminal from a script when resolving Wait.
+	ConfirmIn io.Reader
+}
+
+// ExploreResult is the outcome of one explore pass.
+type ExploreResult struct {
+	SetID   string
+	WorkSHA string
+	// Path is the Exploration report written.
+	Path string
+	// Body is the document itself.
+	Body string
+}
+
+// exploreCoreOptions carries the already-resolved inputs to the core explore
+// routine, so tests can drive it without real path-resolution git calls. The
+// runExplorer seam replaces the real agent spawn in tests.
+type exploreCoreOptions struct {
+	DefPath     string
+	RuntimePath string
+	SetID       string
+	Agents      []string
+	Effort      string
+	Timeout     time.Duration
+	Output      io.Writer
+	probeMemo   *agentAvailabilityProbeMemo
+	// admission is the policy the Explorer acquires the checkout under
+	// (ADR-0238/0239).
+	admission AdmissionPolicy
+	// runExplorer returns the Explorer's report and the agent that wrote it.
+	runExplorer func(prompt string) (string, string, error)
+	// checkoutHeld says the caller is already inside a claim on this checkout —
+	// the drain's own explore step, which runs under the drain's running Drain
+	// row. Explore then takes nothing, as the drain's refine step does.
+	checkoutHeld bool
+}
+
+// ExploreTaskSet explores a set using default dependencies.
+func ExploreTaskSet(opts ExploreOptions) (*ExploreResult, error) {
+	return ExploreTaskSetWith(defaultDeps, project.DefaultDeps(), config.Load, opts)
+}
+
+// ExploreTaskSetWith is `pop tasks explore <set>` (ADR-0262): it resolves the
+// set, hands a fresh Explorer the set's tasks and spec, and writes what comes
+// back as the set's Exploration report. A hand run is the human re-opening the
+// question, so it runs whatever the set's `explore` key says and replaces any
+// report already there.
+func ExploreTaskSetWith(d *Deps, pd *project.Deps, loadConfig func(string) (*config.Config, error), opts ExploreOptions) (*ExploreResult, error) {
+	resolved, err := ResolvePathsWith(d, pd, loadConfig, opts.ResolveInput)
+	if err != nil {
+		return nil, err
+	}
+	runtimePath, err := ResolveRuntimePathWith(d, resolved.ProjectPath, opts.ResolveInput.RuntimeOverride)
+	if err != nil {
+		return nil, err
+	}
+	cfg, _ := loadConfig(d.defaultConfigPath())
+	return exploreResolvedSet(d, cfg, exploreCoreOptions{
+		DefPath:     resolved.DefinitionPath,
+		RuntimePath: runtimePath,
+		SetID:       strings.TrimSpace(opts.TaskSetID),
+		Agents:      opts.Agents,
+		Effort:      opts.Effort,
+		Timeout:     opts.Timeout,
+		Output:      opts.Output,
+		admission:   opts.Wait.Policy(opts.ConfirmIn),
+	})
+}
+
+// exploreResolvedSet is the resolved-path core of `pop tasks explore`. It
+// writes nothing until the Explorer has answered: a pass that is interrupted or
+// fails leaves the set's existing report exactly as it was.
+func exploreResolvedSet(d *Deps, cfg *config.Config, opts exploreCoreOptions) (*ExploreResult, error) {
+	m, err := loadVerifiableManifest(d, verifyCoreOptions{SetID: opts.SetID, DefPath: opts.DefPath})
+	if err != nil {
+		return nil, err
+	}
+	// The Explorer reads the checkout, and a map drawn while another drain
+	// rewrites the files describes a tree that never existed (ADR-0238).
+	if !opts.checkoutHeld {
+		hold, err := AcquireTreeStable(d, opts.RuntimePath, opts.SetID, opts.Output, opts.admission)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = hold.Release() }()
+	}
+	// The report states the tree it describes; pop reads it before the
+	// Explorer starts rather than asking the agent to copy it back.
+	workSHA := verifyWorkSHA(d, opts.RuntimePath)
+	run := opts.runExplorer
+	if run == nil {
+		sel, err := resolveExplorer(opts.Agents, opts.Effort, m, cfg)
+		if err != nil {
+			return nil, err
+		}
+		run = func(prompt string) (string, string, error) {
+			return runConfiguredExplorer(d, cfg, sel, m.Dir, opts.SetID, workSHA, opts.RuntimePath, prompt, opts.Output, opts.Timeout, opts.probeMemo)
+		}
+	}
+	body, agent, err := run(buildExplorerPrompt(d, m, workSHA))
+	if err != nil {
+		return nil, err
+	}
+	path := explorationPath(m)
+	_, statErr := d.FS.Stat(path)
+	doc := exploreReport.renderDocument(d.Now().UTC(), opts.SetID, workSHA, "", agent, body)
+	if err := WriteAtomicWith(d, path, []byte(doc), 0o644); err != nil {
+		return nil, exitErr(ExitOperational, "write exploration report: %v", err)
+	}
+	printExploreWritten(opts.Output, opts.SetID, path, statErr == nil)
+	return &ExploreResult{SetID: opts.SetID, WorkSHA: workSHA, Path: path, Body: doc}, nil
+}
+
+// explorationPath is where a set's one Exploration report lives: flat in the
+// set directory, beside the spec and the progress record.
+func explorationPath(m *Manifest) string {
+	return explorationPathIn(m.Dir)
+}
+
+func explorationPathIn(setDir string) string {
+	return filepath.Join(setDir, ExplorationFileName)
+}
+
+// explorationBlockView is the Exploration report as a builder's frame and the
+// Assist prompt name it: the document to read, never its body, whatever its
+// length (ADR-0262). The empty view renders nothing at all.
+type explorationBlockView struct {
+	HasExploration bool
+	Path           string
+}
+
+// explorationBlock resolves that view for the set in setDir, and the empty
+// view for a set that has never been explored. A report the filesystem cannot
+// stat is treated as absent: naming a path the agent cannot open helps nobody.
+func explorationBlock(d *Deps, setDir string) explorationBlockView {
+	if d == nil {
+		d = defaultDeps
+	}
+	path := explorationPathIn(setDir)
+	if _, err := d.FS.Stat(path); err != nil {
+		return explorationBlockView{}
+	}
+	return explorationBlockView{HasExploration: true, Path: path}
+}
+
+// resolveExplorer applies the Explorer precedence chain, highest first: CLI
+// flags → the set's `explorer` directive → [work.explore] → [work.implement].agents
+// / DefaultExploreEffort. Agents and effort resolve independently, and an
+// override of `[work.explore].agents = []` refuses the fallthrough, as the
+// Refiner's do.
+func resolveExplorer(cliAgents []string, cliEffort string, m *Manifest, cfg *config.Config) (verifierSelection, error) {
+	agents := nonEmptyStrings(cliAgents)
+	effort := strings.TrimSpace(cliEffort)
+	if over := m.ExplorerOverride(); over != nil {
+		if len(agents) == 0 {
+			agents = nonEmptyStrings(over.Agents)
+		}
+		if effort == "" {
+			effort = strings.TrimSpace(over.Effort)
+		}
+	}
+	if e := cfg.ExploreSettings(); e != nil && effort == "" {
+		effort = strings.TrimSpace(e.Effort)
+	}
+	if len(agents) == 0 {
+		resolved, err := ResolveAgentGroupPresets(cfg.ExploreAgentList(), cfg)
+		if err != nil {
+			return verifierSelection{}, err
+		}
+		agents = resolved
+	}
+	if effort == "" {
+		effort = DefaultExploreEffort
+	}
+	return verifierSelection{Agents: agents, Effort: effort}, nil
+}
+
+// runConfiguredExplorer walks the resolved Explorer agent list through the
+// shared fallback walk and returns the report beside the agent that wrote it.
+// The cap and retry schedule are the built-in task defaults, as the Refiner's
+// are.
+func runConfiguredExplorer(d *Deps, cfg *config.Config, sel verifierSelection, taskSetDir, setID, workSHA, runtimePath, prompt string, out io.Writer, timeout time.Duration, probeMemo *agentAvailabilityProbeMemo) (string, string, error) {
+	if timeout <= 0 {
+		timeout = DefaultAttemptTimeout
+	}
+	quotaRetryAfter, err := resolveAgentQuotaRetryAfter(cfg)
+	if err != nil {
+		return "", "", exitErr(ExitSetup, "%v", err)
+	}
+	walked, err := runAgentFallbackWalk(d, agentFallbackWalk{
+		role:            explorerRole(d, out, taskSetDir, setID, workSHA),
+		sel:             sel,
+		setID:           setID,
+		runtimePath:     runtimePath,
+		prompt:          prompt,
+		out:             out,
+		errOut:          out,
+		timeout:         timeout,
+		maxTries:        config.DefaultTaskMaxTries,
+		retryDelays:     append([]time.Duration(nil), config.DefaultTaskAttemptRetryDelays...),
+		quotaRetryAfter: quotaRetryAfter,
+		cfg:             cfg,
+		probeMemo:       probeMemo,
+	})
+	if err != nil {
+		return "", "", err
+	}
+	// Prose from an attempt that timed out or died is half a map, and writing it
+	// would replace a complete earlier report with it.
+	if strings.TrimSpace(walked.Answer) != "" && !walked.AnswerRetryEligible {
+		return strings.TrimSpace(walked.Answer), walked.Agent, nil
+	}
+	if len(walked.Unavailable) == 0 {
+		return "", "", exitErr(ExitOperational, "the Explorer produced no report for %q", setID)
+	}
+	return "", "", exitErr(ExitSetup, "%s", formatHumanHealingExhaustionMessage(walked.Unavailable))
+}
+
+// explorerRole is what the shared fallback walk calls the Explorer. Its runs
+// are filed under the `explore` phase so `pop tasks spend` counts what mapping
+// a set cost, and they carry no verdict because the Explorer reaches none. It
+// judges an ending as the Refiner does — any prose from a run that reached its
+// own ending is the answer — and it is the role the read-only posture was kept
+// for: it looks at the checkout and changes nothing.
+func explorerRole(d *Deps, errOut io.Writer, taskSetDir, setID, workSHA string) agentRole {
+	persist := func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int) {
+		_ = persistSetLevelRun(d, errOut, spendPhaseExplore, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, "", try, outcome, reason, exitCode, "")
+	}
+	return agentRole{
+		Noun:    "Explorer agent",
+		Gerund:  "Exploring",
+		Phase:   spendPhaseExplore,
+		Persist: persist,
+		PersistAnswer: func(rec *streamRecorder, invocation *AgentInvocation, try int, outcome, reason string, exitCode int, _ string) {
+			persist(rec, invocation, try, outcome, reason, exitCode)
+		},
+		PersistSkipped: func(rec *streamRecorder, invocation *AgentInvocation, model string, try int, reason string, exitCode int) {
+			_ = persistSetLevelRun(d, errOut, spendPhaseExplore, taskSetDir, setID, workSHA, rec, invocation.AgentPreset(), invocation.RequestedAgent, model, try, streamOutcomeModelSkipped, reason, exitCode, "")
+		},
+		RetryEligible: refineAttemptRetryEligible,
+		ReadOnly:      true,
+	}
+}
+
+// printExploreWritten tells the operator where the report went and how to read
+// it.
+func printExploreWritten(w io.Writer, setID, path string, replaced bool) {
+	if w == nil {
+		return
+	}
+	out := outputFor(w)
+	out.line(ansiBold, "━━ Exploration for %s", setID)
+	out.line(ansiDim, "   Document: %s", path)
+	if replaced {
+		out.line(ansiDim, "   Replaces the previous report.")
+	}
+	out.line(ansiDim, "   Read it: pop tasks artifacts %s --show %s", setID, ExplorationFileName)
+}
+
+// buildExplorerPrompt assembles the Explorer's prompt: pop's role framing and
+// report shape around the set's manifest listing, every task body and the spec
+// when one exists. It names the commit the Explorer stands at so the report can
+// state the tree it describes. It asks for nothing about prior art (ADR-0262
+// decision 7).
+func buildExplorerPrompt(d *Deps, m *Manifest, workSHA string) string {
+	view := explorerPromptView{
+		TaskSet:     m.Stem,
+		WorkSHALine: optionalLine("Work SHA: ", workSHA),
+		Tasks:       gateTaskRows(m),
+	}
+	for _, task := range m.Tasks {
+		view.Bodies = append(view.Bodies, explorerTaskBody{
+			Heading: taskHeading(task),
+			Body:    readTaskBody(d, filepath.Join(m.Dir, task.File)),
+		})
+	}
+	if spec, ok := readSpec(d, m); ok {
+		view.SpecRecorded = true
+		view.Spec = spec
+	}
+	return prompt.MustRender(promptTemplates, "explorer.tmpl.md", view)
+}
+
+// explorerPromptView is what the Explorer's template renders against. Like the
+// other roles' views, the optional spec is a named boolean beside its text.
+type explorerPromptView struct {
+	TaskSet      string
+	WorkSHALine  string
+	Tasks        []taskRow
+	Bodies       []explorerTaskBody
+	SpecRecorded bool
+	Spec         string
+}
+
+// explorerTaskBody is one task the Explorer maps the code for: its heading and
+// its inlined body, or the read failure standing in for it.
+type explorerTaskBody struct {
+	Heading string
+	Body    taskBodyRow
+}
diff --git a/tasks/explore_mark.go b/tasks/explore_mark.go
new file mode 100644
index 00000000..5736b8cd
--- /dev/null
+++ b/tasks/explore_mark.go
@@ -0,0 +1,138 @@
+package tasks
+
+import (
+	"time"
+
+	"github.com/glebglazov/pop/work"
+)
+
+// ExploreMark is whether a Task set that asked for exploration has its
+// Exploration report, carried beside its status the way the Verification mark
+// and the Refine mark are (ADR-0262). A set that never asked carries no mark at
+// all: exploration is opt-in, so its absence there says nothing.
+//
+// It answers one question — was this set explored, yes or no. Why it was not
+// rides beside it as an ExploreReason. ResolveExploreMark is the one place that
+// derives both.
+type ExploreMark = work.ExploreMark
+
+const (
+	// ExploreMarkNone is the absent mark: the set never asked for exploration,
+	// or its manifest cannot be read.
+	ExploreMarkNone ExploreMark = ""
+	// ExploreMarkExplored is a set whose Exploration report is on disk.
+	ExploreMarkExplored ExploreMark = "explored"
+	// ExploreMarkUnexplored is a set that asked for exploration and has no
+	// report. The reason beside it says where the work stopped.
+	ExploreMarkUnexplored ExploreMark = "unexplored"
+)
+
+// ExploreReason is why an unexplored set has no report — the detail beside the
+// mark, never a second mark.
+type ExploreReason = work.ExploreReason
+
+const (
+	// ExploreReasonNone is the absent reason: the set is explored, or it
+	// carries no mark.
+	ExploreReasonNone ExploreReason = ""
+	// ExploreReasonNotYetRun is a set no Explore pass has spent an attempt on:
+	// none ran, or the last one was interrupted or could not start an agent.
+	ExploreReasonNotYetRun ExploreReason = "not-yet-run"
+	// ExploreReasonFailed is a set whose last Explore pass spent its attempts
+	// and wrote no report. On a READY set this is the Explore park.
+	ExploreReasonFailed ExploreReason = "failed"
+)
+
+// ExploreResolution is what the read-side resolution answers for one set: the
+// mark, the reason beside an unexplored mark, and the report as a pointer when
+// the set is explored — its path and the tree it records, never its body.
+type ExploreResolution struct {
+	Mark   ExploreMark
+	Reason ExploreReason
+	// Report is the pointer to exploration.md, zero unless Mark is
+	// ExploreMarkExplored.
+	Report ReportPointer
+}
+
+// ResolveExploreMark is the single read-side Explore mark resolution. The
+// refresh stamps it on every row, and the park, the status cells, the detail
+// views and the sign-off gate all read that answer, so no two surfaces can
+// disagree about a set.
+//
+// It stores nothing. The report on disk is the whole answer for an explored
+// set; for an unexplored one the latest Captured run of phase `explore` says
+// whether a pass spent an attempt and failed.
+func ResolveExploreMark(d *Deps, m *Manifest) ExploreResolution {
+	if m == nil || !m.Valid || !m.ExploreRequested() {
+		return ExploreResolution{}
+	}
+	if p, ok := explorationPointer(d, m); ok {
+		return ExploreResolution{Mark: ExploreMarkExplored, Report: p}
+	}
+	run, ok := latestPhaseRun(d, m, spendPhaseExplore)
+	if !ok {
+		return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: ExploreReasonNotYetRun}
+	}
+	// A run the human interrupted, or one no agent could start, says nothing
+	// about whether exploration can succeed.
+	switch run.Outcome {
+	case streamOutcomeInterrupted, streamOutcomeQuotaPaused, streamOutcomeAgentUnusable, streamOutcomeModelSkipped:
+		return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: ExploreReasonNotYetRun}
+	}
+	return ExploreResolution{Mark: ExploreMarkUnexplored, Reason: ExploreReasonFailed}
+}
+
+// ExploreSectionTitle names the detail-view section that carries the mark.
+const ExploreSectionTitle = "Exploration"
+
+// ExploreMarkText is the mark as every surface words it, with the reason as
+// detail after it. Empty for a set that carries no mark.
+func ExploreMarkText(mark ExploreMark, reason ExploreReason) string {
+	switch mark {
+	case ExploreMarkExplored:
+		return "explored"
+	case ExploreMarkUnexplored:
+		if reason == ExploreReasonFailed {
+			return "unexplored: pass failed"
+		}
+		return "unexplored: not yet run"
+	}
+	return ""
+}
+
+// Text is ExploreMarkText for this resolution.
+func (r ExploreResolution) Text() string {
+	return ExploreMarkText(r.Mark, r.Reason)
+}
+
+// Line is the resolution as one line of a detail view or gate preamble: the
+// report's pointer when the set is explored, else the mark with its reason.
+func (r ExploreResolution) Line() string {
+	if r.Mark == ExploreMarkExplored {
+		return r.Report.Summary()
+	}
+	return r.Text()
+}
+
+// explorationPointer reads exploration.md's header into the shared pointer
+// shape: the tree is the header's Work SHA and the instant its Explored line.
+func explorationPointer(d *Deps, m *Manifest) (ReportPointer, bool) {
+	if d == nil {
+		d = defaultDeps
+	}
+	if d == nil || d.FS == nil || m == nil || m.Dir == "" {
+		return ReportPointer{}, false
+	}
+	path := explorationPath(m)
+	data, err := d.FS.ReadFile(path)
+	if err != nil {
+		return ReportPointer{}, false
+	}
+	body := string(data)
+	p := ReportPointer{Label: exploreReport.PointerLabel, Path: path, WorkSHA: reportHeaderField(body, "Work SHA")}
+	p.Written = reportHeaderField(body, exploreReport.WrittenLabel)
+	if at, err := time.Parse(time.RFC3339, p.Written); err == nil {
+		p.Written = at.UTC().Format("2006-01-02 15:04Z")
+	}
+	return p, true
+}
