--- /dev/null
+++ b/tasks/drain_explore_park_test.go
@@ -0,0 +1,259 @@
+package tasks
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// exploreParkFixture is a declared one-task set, drained with an Explorer
+// stand-in that files each attempt through the Explorer's own role — so the
+// park is read back from the runs a real pass leaves behind.
+type exploreParkFixture struct {
+	t      *testing.T
+	env    *runTaskSetFixture
+	setDir string
+	agent  string
+	// explored counts how many times a drain asked the Explorer for a pass.
+	explored int
+}
+
+func newExploreParkFixture(t *testing.T) *exploreParkFixture {
+	t.Helper()
+	tasks := []Task{{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"}}
+	env := setupRunTaskSetFixture(t, "demo", tasks)
+	setDir := filepath.Join(env.tasksDir, "demo")
+	writeManifestWithSetKeys(t, setDir, tasks, map[string]any{manifestExploreKey: true})
+	return &exploreParkFixture{
+		t:      t,
+		env:    env,
+		setDir: setDir,
+		agent:  writeFakeAgent(t, env.root, fakeAgentConfig{checkTask: true, summary: "ok"}),
+	}
+}
+
+// recordExploreAttempt files one Explorer attempt that ended on outcome.
+func (f *exploreParkFixture) recordExploreAttempt(try int, outcome string) {
+	f.t.Helper()
+	invocation, err := ResolveAgentInvocationWithMode("claude", "", "prompt", "/rt", AgentOutputAuto)
+	if err != nil {
+		f.t.Fatalf("resolve invocation: %v", err)
+	}
+	rec := newStreamRecorder(io.Discard, fakeClock(time.Now(), 100*time.Millisecond))
+	explorerRole(f.env.deps(), io.Discard, f.setDir, "demo", "sha1").persist(rec, invocation, try, outcome, "", 1)
+}
+
+// drain runs one whole drain. A pass the Explorer is asked for spends the
+// standard cap on outcome and gives up; an empty outcome files nothing, the
+// way a walk with no agent to start ends.
+func (f *exploreParkFixture) drain(outcome string, skipExplore bool) (*RunTaskSetResult, string, error) {
+	f.t.Helper()
+	var buf bytes.Buffer
+	opts := f.env.runTaskSetOpts(true, f.agent, &buf)
+	opts.TaskSetOverride = "demo"
+	opts.SkipExplore = skipExplore
+	opts.exploreRunner = func(string) (string, string, error) {
+		f.explored++
+		if outcome == "" {
+			return "", "", errors.New("no Explorer agent could start")
+		}
+		for try := 1; try <= config.DefaultTaskMaxTries; try++ {
+			f.recordExploreAttempt(try, outcome)
+		}
+		return "", "", errors.New("the Explorer produced no report")
+	}
+	result, err := RunTaskSetWith(f.env.deps(), nil, func(string) (*config.Config, error) { return nil, nil }, opts)
+	return result, buf.String(), err
+}
+
+func (f *exploreParkFixture) row() Row {
+	f.t.Helper()
+	refresh, err := RefreshWith(f.env.deps(), f.env.tasksDir, DefaultStatePathWith(f.env.deps()))
+	if err != nil {
+		f.t.Fatalf("refresh: %v", err)
+	}
+	row := findRow(refresh, "demo")
+	if row == nil {
+		f.t.Fatal("no row for demo")
+	}
+	return *row
+}
+
+func (f *exploreParkFixture) parkRecords() []string {
+	body, _ := os.ReadFile(filepath.Join(f.setDir, ProgressFileName))
+	var records []string
+	for _, record := range strings.Split(string(body), "---\n") {
+		if strings.Contains(record, "[set] "+exploreParkProgressOutcome) {
+			records = append(records, record)
+		}
+	}
+	return records
+}
+
+func (f *exploreParkFixture) parkedSet() {
+	f.t.Helper()
+	result, out, err := f.drain(streamOutcomeFailed, false)
+	if err != nil || !result.TaskSetExploreFailed {
+		f.t.Fatalf("drain = %+v (%v), want it parked\n%s", result, err, out)
+	}
+}
+
+// TestAnExplorePassThatGivesUpParksTheSet: a declared set whose pass spent its
+// cap without a report reads EXPLORE-FAILED, not BLOCKED, and its task is not
+// built. One progress record says why. A later drain, and automatic selection,
+// pass over it rather than exploring again.
+func TestAnExplorePassThatGivesUpParksTheSet(t *testing.T) {
+	t.Parallel()
+	f := newExploreParkFixture(t)
+
+	result, out, err := f.drain(streamOutcomeFailed, false)
+	if err != nil {
+		t.Fatalf("drain: %v\n%s", err, out)
+	}
+	if !result.TaskSetExploreFailed || result.TaskSetDone {
+		t.Fatalf("result = %+v, want the drain stopped at the park", result)
+	}
+	if !strings.Contains(out, "pop tasks implement demo --skip-explore") {
+		t.Fatalf("summary does not name the ways out:\n%s", out)
+	}
+	if row := f.row(); row.Status != StatusExploreFailed {
+		t.Fatalf("status = %s, want %s", row.Status, StatusExploreFailed)
+	}
+	m := LoadManifest(f.env.deps(), "demo", filepath.Join(f.setDir, ManifestFileName))
+	if m.Tasks[0].Status != TaskOpen {
+		t.Fatalf("task = %q, want it left unbuilt", m.Tasks[0].Status)
+	}
+	records := f.parkRecords()
+	if len(records) != 1 || !strings.Contains(records[0], "Explore phase") || !strings.Contains(records[0], "the Explorer produced no report") {
+		t.Fatalf("park records = %q, want one naming the phase and the reason", records)
+	}
+
+	result, out, err = f.drain(streamOutcomeFailed, false)
+	if err != nil || !result.TaskSetExploreFailed {
+		t.Fatalf("second drain = %+v (%v), want it stopped at the park\n%s", result, err, out)
+	}
+	if f.explored != 1 {
+		t.Fatalf("Explorer asked %d times, want a parked set never re-explored", f.explored)
+	}
+	if records := f.parkRecords(); len(records) != 1 {
+		t.Fatalf("park records = %d after a second drain, want exactly one", len(records))
+	}
+
+	refresh, err := RefreshWith(f.env.deps(), f.env.tasksDir, DefaultStatePathWith(f.env.deps()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if id, _, err := SelectTaskSet(refresh, ""); err == nil {
+		t.Fatalf("automatic selection picked %q, want a parked set passed over", id)
+	}
+}
+
+// TestAnExploreRunThatSpentNoAttemptDoesNotPark: a pass the human interrupted,
+// or one that hit a quota or no agent at all, says nothing about whether the set
+// can be mapped. The set is not parked and no progress record is written.
+func TestAnExploreRunThatSpentNoAttemptDoesNotPark(t *testing.T) {
+	t.Parallel()
+	for _, outcome := range []string{"", streamOutcomeQuotaPaused, streamOutcomeAgentUnusable} {
+		t.Run("outcome "+outcome, func(t *testing.T) {
+			t.Parallel()
+			f := newExploreParkFixture(t)
+			result, out, err := f.drain(outcome, false)
+			if err == nil {
+				t.Fatalf("drain = %+v, want it stopped on the Explorer's error\n%s", result, out)
+			}
+			if row := f.row(); row.Status != StatusReady {
+				t.Fatalf("status = %s, want READY", row.Status)
+			}
+			if records := f.parkRecords(); len(records) != 0 {
+				t.Fatalf("park records = %q, want none", records)
+			}
+		})
+	}
+
+	f := newExploreParkFixture(t)
+	f.recordExploreAttempt(1, streamOutcomeFailed)
+	f.recordExploreAttempt(2, streamOutcomeInterrupted)
+	if row := f.row(); row.Status != StatusReady {
+		t.Fatalf("status after an interrupted pass = %s, want READY", row.Status)
+	}
+}
+
+// TestSkipExploreDrainsADeclaredSetOnce: --skip-explore builds a declared set
+// without a pass and without parking it, whether it was never explored or is
+// already parked.
+func TestSkipExploreDrainsADeclaredSetOnce(t *testing.T) {
+	t.Parallel()
+	for _, parked := range []bool{false, true} {
+		name := "never explored"
+		if parked {
+			name = "parked"
+		}
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			f := newExploreParkFixture(t)
+			if parked {
+				f.parkedSet()
+			}
+			asked := f.explored
+			result, out, err := f.drain(streamOutcomeFailed, true)
+			if err != nil || !result.TaskSetDone {
+				t.Fatalf("drain = %+v (%v), want the set built to DONE\n%s", result, err, out)
+			}
+			if f.explored != asked {
+				t.Fatal("--skip-explore asked the Explorer for a pass")
+			}
+			want := 0
+			if parked {
+				want = 1
+			}
+			if records := f.parkRecords(); len(records) != want {
+				t.Fatalf("park records = %q, want only the earlier park's", records)
+			}
+		})
+	}
+}
+
+// TestTheExploreParkHasTwoDoorsBesidesTheSkipFlag: a hand-run pass that writes
+// the report clears the park, and so does retracting the declaration.
+func TestTheExploreParkHasTwoDoorsBesidesTheSkipFlag(t *testing.T) {
+	t.Parallel()
+
+	t.Run("explored by hand", func(t *testing.T) {
+		t.Parallel()
+		f := newExploreParkFixture(t)
+		f.parkedSet()
+		_, err := exploreResolvedSet(f.env.deps(), nil, exploreCoreOptions{
+			DefPath:     f.env.tasksDir,
+			RuntimePath: f.env.root,
+			SetID:       "demo",
+			Output:      io.Discard,
+			runExplorer: func(string) (string, string, error) {
+				return "## Where things live\n`tasks/seam.go` owns `Seam`.", "claude", nil
+			},
+		})
+		if err != nil {
+			t.Fatalf("explore: %v", err)
+		}
+		if row := f.row(); row.Status != StatusReady {
+			t.Fatalf("status = %s, want READY once the report is written", row.Status)
+		}
+	})
+
+	t.Run("declaration retracted", func(t *testing.T) {
+		t.Parallel()
+		f := newExploreParkFixture(t)
+		f.parkedSet()
+		tasks := []Task{{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"}}
+		writeManifestWithSetKeys(t, f.setDir, tasks, map[string]any{manifestExploreKey: false})
+		if row := f.row(); row.Status != StatusReady {
+			t.Fatalf("status = %s, want READY once the set no longer asks", row.Status)
+		}
+	})
+}
