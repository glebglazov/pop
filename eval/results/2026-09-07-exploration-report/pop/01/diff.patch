+// TestExploreThatProducesNoReportLeavesTheLastOne: an Explorer that only ever
+// times out or fails spends its cap, files every attempt under the explore
+// phase, and writes nothing — the report from the earlier pass is untouched.
+func TestExploreThatProducesNoReportLeavesTheLastOne(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name string
+		run  scriptedRefineRun
+	}{
+		{name: "timed out", run: scriptedRefineRun{output: claudeRefineStream("## Where things live\\n`tasks/se"), hang: 150 * time.Millisecond}},
+		{name: "failed", run: scriptedRefineRun{output: claudeRefineStream("## Where things live"), runErr: errors.New("agent crashed")}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			d, opts, report, _ := setupExploreFixture(t, tc.run, tc.run, tc.run)
+
+			if _, err := exploreResolvedSet(d, nil, opts); err == nil {
+				t.Fatal("an Explorer that never answered completed the pass")
+			}
+			body, err := os.ReadFile(report)
+			if err != nil || string(body) != "OLD-MAP\n" {
+				t.Fatalf("existing report = %q (%v), want it untouched", body, err)
+			}
+			pairs := listRunFilePairs(t, capturedRunsDir(filepath.Dir(report)))
+			if len(pairs) != 3 {
+				t.Fatalf("captured runs = %d, want each of the 3 attempts filed", len(pairs))
+			}
+			for _, pair := range pairs {
+				if pair.metaData.Phase != "explore" {
+					t.Fatalf("run filed under phase %q, want explore", pair.metaData.Phase)
+				}
+			}
+		})
+	}
+}
+
+// TestExploreReplacesTheReportWithTheNextCleanAnswer: a failed attempt is
+// retried, and the first clean answer replaces the earlier report flat in the
+// set directory rather than beside it.
+func TestExploreReplacesTheReportWithTheNextCleanAnswer(t *testing.T) {
+	t.Parallel()
+	d, opts, report, out := setupExploreFixture(t,
+		scriptedRefineRun{output: claudeRefineStream("## Where"), exitCode: 2},
+		scriptedRefineRun{output: claudeRefineStream("## Where things live\\n`tasks/seam.go` owns `Seam`.")},
+	)
+
+	res, err := exploreResolvedSet(d, nil, opts)
+	if err != nil {
+		t.Fatalf("explore: %v", err)
+	}
+	if res.Path != report {
+		t.Fatalf("path = %q, want %q", res.Path, report)
+	}
+	body, _ := os.ReadFile(report)
+	if strings.Contains(string(body), "OLD-MAP") || !strings.Contains(string(body), "`tasks/seam.go` owns `Seam`.") {
+		t.Fatalf("report was not replaced by the clean answer:\n%s", body)
+	}
+	if !strings.Contains(out.String(), "Replaces the previous report.") {
+		t.Fatalf("output does not say the report was replaced:\n%s", out.String())
+	}
+	entries, _ := os.ReadDir(filepath.Dir(report))
+	for _, e := range entries {
+		if e.IsDir() && e.Name() != "streams" {
+			t.Fatalf("explore created a report directory %q; the report is flat", e.Name())
+		}
+	}
+	if m := LoadManifest(d, "demo", filepath.Join(filepath.Dir(report), ManifestFileName)); !m.Valid {
+		t.Fatalf("an explored set reads malformed: %v", m.Errors)
+	}
+}
+
+// TestResolveExplorerPrecedence: CLI flags beat the set's `explorer` directive,
+// which beats [work.explore], which beats the defaults.
+func TestResolveExplorerPrecedence(t *testing.T) {
+	t.Parallel()
+	m := &Manifest{Unknown: map[string]json.RawMessage{
+		manifestExplorerKey: json.RawMessage(`{"agents": ["codex"], "effort": "light"}`),
+	}}
+	sel, err := resolveExplorer(nil, "", m, nil)
+	if err != nil || strings.Join(sel.Agents, ",") != "codex" || sel.Effort != "light" {
+		t.Fatalf("directive selection = %+v (%v), want codex at light", sel, err)
+	}
+	sel, err = resolveExplorer([]string{"claude"}, "standard", m, nil)
+	if err != nil || strings.Join(sel.Agents, ",") != "claude" || sel.Effort != "standard" {
+		t.Fatalf("CLI selection = %+v (%v), want claude at standard", sel, err)
+	}
+	cfg := &config.Config{Work: &config.WorkConfig{Explore: &config.ExploreConfig{
+		Agents: config.AgentEntries{{Cmd: "opencode"}},
+		Effort: "standard",
+	}}}
+	sel, err = resolveExplorer(nil, "", m, cfg)
+	if err != nil || strings.Join(sel.Agents, ",") != "codex" || sel.Effort != "light" {
+		t.Fatalf("directive over config selection = %+v (%v), want codex at light", sel, err)
+	}
+	sel, err = resolveExplorer(nil, "", &Manifest{}, cfg)
+	if err != nil || strings.Join(sel.Agents, ",") != "opencode" || sel.Effort != "standard" {
+		t.Fatalf("config selection = %+v (%v), want opencode at standard", sel, err)
+	}
+	sel, err = resolveExplorer(nil, "", &Manifest{}, nil)
+	if err != nil || len(sel.Agents) == 0 || sel.Effort != DefaultExploreEffort {
+		t.Fatalf("default selection = %+v (%v), want the implement default at %s", sel, err, DefaultExploreEffort)
+	}
+}
