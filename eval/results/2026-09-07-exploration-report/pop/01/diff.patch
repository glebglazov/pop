+	"strings"
+	"testing"
+	"time"
+
+	"github.com/glebglazov/pop/config"
+)
+
+// setupExploreFixture writes a "demo" set holding one open AFK task and an
+// Exploration report from an earlier pass, on the scripted-agent seam the
+// Refiner's retry tests use.
+func setupExploreFixture(t *testing.T, runs ...scriptedRefineRun) (*Deps, exploreCoreOptions, string, *bytes.Buffer) {
+	t.Helper()
+	d, _ := refineRunnerDeps(t, runs...)
+	defPath := filepath.Join(t.TempDir(), "tasks")
+	setupManifest(t, defPath, "demo", []Task{
+		{ID: "01-a", File: "01-a.md", Title: "Shape the seam", Type: "AFK", Status: "open"},
+	})
+	report := filepath.Join(defPath, "demo", ExplorationFileName)
+	if err := os.WriteFile(report, []byte("OLD-MAP\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	out := &bytes.Buffer{}
+	return d, exploreCoreOptions{
+		DefPath:     defPath,
+		RuntimePath: "/rt",
+		SetID:       "demo",
