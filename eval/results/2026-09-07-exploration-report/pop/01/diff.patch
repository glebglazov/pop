--- /dev/null
+++ b/tasks/setkind/explore_mark_test.go
@@ -0,0 +1,69 @@
+package setkind
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/tasks"
+	"github.com/glebglazov/pop/work"
+)
+
+// containerForExploreRow builds the one container a refreshed row produces. The
+// row already carries its Explore resolution, as every refresh stamps it, so
+// what the container shows can only have come from that one answer.
+func containerForExploreRow(t *testing.T, res tasks.ExploreResolution) work.Container {
+	t.Helper()
+	rows := []tasks.Row{{ID: "demo", Status: tasks.StatusReady, Explore: res}}
+	d := testDeps(t, rows)
+	m := &tasks.Manifest{Valid: true, Dir: t.TempDir(), Tasks: []tasks.Task{{ID: "01-a", File: "01-a.md", Type: "AFK", Status: "open"}}}
+	d.Refresh = func(string) (*tasks.RefreshResult, error) {
+		return &tasks.RefreshResult{Rows: rows, Manifests: map[string]*tasks.Manifest{"demo": m}}, nil
+	}
+	scan := scanFixture{Name: "pop", ProjectPath: "/repo/main", RuntimePath: "/repo/main", DefinitionPath: "/def", RepoKey: "repo-key"}
+	got, err := rowsForStatic(d, &config.Config{}, staticForScan(scan, "main", false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 {
+		t.Fatalf("containers = %+v, want one", got)
+	}
+	return got[0]
+}
+
+// TestTheExploreMarkReachesTheRowAndTheDetailView: the status cell `pop work
+// status` and the dashboard row both print carries the mark with its reason,
+// and the detail view carries the report as a pointer — path and tree. A set
+// that never asked carries neither.
+func TestTheExploreMarkReachesTheRowAndTheDetailView(t *testing.T) {
+	unexplored := containerForExploreRow(t, tasks.ExploreResolution{Mark: tasks.ExploreMarkUnexplored, Reason: tasks.ExploreReasonFailed})
+	if cell := tasks.WorkRowStatusCell(unexplored); cell != "READY · unexplored: pass failed" {
+		t.Fatalf("status cell = %q", cell)
+	}
+	if len(unexplored.DetailSections) == 0 || unexplored.DetailSections[0].Title != tasks.ExploreSectionTitle ||
+		unexplored.DetailSections[0].Body != "unexplored: pass failed" {
+		t.Fatalf("detail sections = %+v, want the mark and its reason", unexplored.DetailSections)
+	}
+
+	report := tasks.ReportPointer{Label: "Exploration report", Path: "/def/demo/exploration.md", WorkSHA: "abc123a", Written: "2026-10-04 07:38Z"}
+	explored := containerForExploreRow(t, tasks.ExploreResolution{Mark: tasks.ExploreMarkExplored, Report: report})
+	if cell := tasks.WorkRowStatusCell(explored); cell != "READY · explored" {
+		t.Fatalf("status cell = %q", cell)
+	}
+	body := explored.DetailSections[0].Body
+	for _, want := range []string{report.Path, "abc123a"} {
+		if !strings.Contains(body, want) {
+			t.Fatalf("detail section %q is missing %q", body, want)
+		}
+	}
+
+	never := containerForExploreRow(t, tasks.ExploreResolution{})
+	if cell := tasks.WorkRowStatusCell(never); strings.Contains(cell, "explored") {
+		t.Fatalf("a set that never asked carries a mark: %q", cell)
+	}
+	for _, s := range never.DetailSections {
+		if s.Title == tasks.ExploreSectionTitle {
+			t.Fatalf("a set that never asked has an exploration section: %+v", s)
+		}
+	}
+}
