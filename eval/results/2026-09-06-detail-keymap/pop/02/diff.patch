+// containerVerbKind is itemVerbKind with a container keyboard: one status write,
+// one copy entry, a mute and an `I` verb, each recorded when the kind performs
+// it over the container.
+type containerVerbKind struct {
+	*itemVerbKind
+	performed []string
+}
+
+func (k *containerVerbKind) Actions(work.Container) []work.Action {
+	return []work.Action{{Verb: work.Verb("go"), Key: "I", Label: "go now"}}
+}
+func (k *containerVerbKind) StatusActions(work.Container) []work.Action {
+	return []work.Action{{Verb: work.Verb("finish"), Key: "x", Label: "finish"}}
+}
+func (k *containerVerbKind) CopyActions(work.Container) []work.Action {
+	return []work.Action{{Verb: work.VerbCopyName, Key: "n", Label: "copy name"}}
+}
+func (k *containerVerbKind) Perform(c work.Container, item *work.Item, verb work.Verb) (work.Outcome, error) {
+	if item != nil {
+		return k.itemVerbKind.Perform(c, item, verb)
+	}
+	k.performed = append(k.performed, c.ID+" "+string(verb))
+	return work.Outcome{Kind: work.OutcomeMessage, Message: string(verb) + " done"}, nil
+}
+func (k *containerVerbKind) Mute(c work.Container, _ time.Time, _ bool) (work.Outcome, error) {
+	k.performed = append(k.performed, c.ID+" mute")
+	return work.Outcome{}, nil
+}
+func (k *containerVerbKind) Unmute(c work.Container) (work.Outcome, error) {
+	k.performed = append(k.performed, c.ID+" unmute")
+	return work.Outcome{}, nil
+}
+
+// TestDetailOpenersActOnTheContainer drives `s`, `y` and `m` from inside a detail
+// view: each opens the menu the same key opens over the container's row, renders
+// it as the detail's block, stays singular under a Selection marked above, and
+// esc leaves the detail standing (ADR-0261 decision 1).
+func TestDetailOpenersActOnTheContainer(t *testing.T) {
+	for _, key := range []string{"s", "y", "m"} {
+		t.Run(key, func(t *testing.T) {
+			kind := &containerVerbKind{itemVerbKind: &itemVerbKind{}}
+			m := genericDetailDashboard(kind)
+			above := pressKeys(t, m, key)
+			if above.menu == nil {
+				t.Fatalf("%s opened no menu over the row", key)
+			}
+			want := dashboardMenuLines(above.menu, above.width, above.liveCache())
+
+			m = pressKeys(t, m, "l")
+			m.selection.Toggle(m.detail.row.CursorKey)
+			m = pressKeys(t, m, key)
+			if m.menu == nil || m.menu.row.ID != "thing" || m.menu.plural {
+				t.Fatalf("%s in detail opened %+v, want a singular menu over thing", key, m.menu)
+			}
+			if got := dashboardMenuLines(m.menu, m.width, m.liveCache()); strings.Join(got, "\n") != strings.Join(want, "\n") {
+				t.Fatalf("detail %s menu =\n%s\nwant the row's\n%s", key, strings.Join(got, "\n"), strings.Join(want, "\n"))
+			}
+			// The block sits directly above the hint line, as the item menu's does.
+			view := ui.StripANSI(m.View().Content)
+			lines := strings.Split(view, "\n")
+			bottom := lines[len(lines)-1-len(want) : len(lines)-1]
+			if strings.Join(bottom, "\n") != ui.StripANSI(strings.Join(want, "\n")) {
+				t.Fatalf("detail %s menu is not the block above the hint line:\n%s", key, view)
+			}
+
+			m = pressKeys(t, m, "esc")
+			if m.menu != nil || m.detail == nil {
+				t.Fatalf("esc left menu=%+v detail=%v, want the detail alone", m.menu, m.detail != nil)
+			}
+		})
+	}
+}
+
+// TestDetailContainerMenusDispatchTheRowsVerbs pins that an entry chosen in a
+// detail-opened menu, and the flat `I`, run over the container through the same
+// path the row list takes (ADR-0261 decisions 1 and 4).
+func TestDetailContainerMenusDispatchTheRowsVerbs(t *testing.T) {
+	kind := &containerVerbKind{itemVerbKind: &itemVerbKind{}}
+	m := pressKeys(t, genericDetailDashboard(kind), "I", "s", "x")
+	fromRow := strings.Join(kind.performed, ", ")
+	kind.performed = nil
+
+	m = pressKeys(t, genericDetailDashboard(kind), "l", "I", "s", "x")
+	if got := strings.Join(kind.performed, ", "); got != fromRow || got != "thing go, thing finish" {
+		t.Fatalf("detail performed %q, row performed %q, want thing go then thing finish", got, fromRow)
+	}
+	if m.detail == nil || !strings.Contains(m.View().Content, "finish done") {
+		t.Fatalf("detail did not report the container verb:\n%s", m.View().Content)
+	}
+
+	var copied string
+	m.copyFunc = func(s string) error { copied = s; return nil }
+	m = pressKeys(t, m, "y", "n")
+	if copied != "thing" || !strings.Contains(m.View().Content, "copied thing") {
+		t.Fatalf("detail y n copied %q:\n%s", copied, m.View().Content)
+	}
+	m = pressKeys(t, m, "m", "1")
+	if last := kind.performed[len(kind.performed)-1]; last != "thing mute" {
+		t.Fatalf("detail m 1 performed %q, want thing mute", last)
+	}
+}
+
+// TestDetailOpenersRefuseLikeTheRowList covers a container whose kind offers no
+// status, nothing to copy and no mute: the detail flashes the refusal the row
+// list flashes, and opens no menu.
+func TestDetailOpenersRefuseLikeTheRowList(t *testing.T) {
+	for _, key := range []string{"s", "y", "m"} {
+		m := genericDetailDashboard(&itemVerbKind{})
+		want := pressKeys(t, m, key).flash.Text()
+		if want == "" {
+			t.Fatalf("%s on the row flashed nothing", key)
+		}
+		m = pressKeys(t, m, "l", key)
+		if m.menu != nil || m.detail == nil || !strings.Contains(m.View().Content, want) {
+			t.Fatalf("%s in detail: menu=%+v, want the refusal %q on screen:\n%s", key, m.menu, want, m.View().Content)
+		}
+	}
+}
+
+// TestDetailHintsAndHelpNameTheOpeners pins that the detail's hint line and help
+// overlay name the four openers the row list names.
+func TestDetailHintsAndHelpNameTheOpeners(t *testing.T) {
+	m := pressKeys(t, genericDetailDashboard(&containerVerbKind{itemVerbKind: &itemVerbKind{}}), "l")
+	if hint := detailHints(m.detail); !strings.Contains(hint, "r run ▸ · s status ▸ · y copy ▸ · m mute ▸") {
+		t.Fatalf("detail hint = %q, want the four openers", hint)
+	}
+	keys := map[string]string{}
+	for _, entry := range m.helpEntries() {
+		keys[entry.Key] = entry.Desc
+	}
+	for _, key := range []string{"r", "s", "y", "m"} {
+		if keys[key] == "" {
+			t.Fatalf("detail help has no %s: %+v", key, keys)
+		}
+	}
+	if keys["I"] != "go now" || keys["p"] != "" {
+		t.Fatalf("detail help I=%q p=%q, want the kind's I and no p", keys["I"], keys["p"])
+	}
+}
