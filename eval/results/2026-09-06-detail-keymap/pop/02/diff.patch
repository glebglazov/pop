@@ -0,0 +1,173 @@
+package dashboard
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// searchDetailRow is a container whose items differ by id, title, type and
+// status, so each test can tell which field a term matched on.
+func searchDetailRow() DashboardRow {
+	row := genericDetailRow()
+	row.Items = []work.Item{
+		{ID: "01", Title: "Wire the parser", Type: "AFK", Status: "open"},
+		{ID: "02", Title: "Render parser output", Type: "HITL", Status: "done"},
+		{ID: "03", Title: "Docs", Type: "AFK", Status: "done"},
+	}
+	return row
+}
+
+// detailSearch types query into an open detail's search and applies it with
+// Enter, the way a reader does.
+func detailSearch(t *testing.T, m QueueDashboard, query string) QueueDashboard {
+	t.Helper()
+	m = pressKeys(t, m, "/")
+	for _, ch := range query {
+		m = pressKeys(t, m, string(ch))
+	}
+	updated, _ := m.update(tea.KeyPressMsg{Code: tea.KeyEnter})
+	return updated.(QueueDashboard)
+}
+
+func openSearchDetail(t *testing.T) QueueDashboard {
+	t.Helper()
+	m := artifactDetailDashboard(&itemVerbKind{}, searchDetailRow())
+	m.height = 30
+	return pressKeys(t, m, "l")
+}
+
+func assertShows(t *testing.T, view string, want, hidden []string) {
+	t.Helper()
+	for _, s := range want {
+		if !strings.Contains(view, s) {
+			t.Fatalf("view is missing %q:\n%s", s, view)
+		}
+	}
+	for _, s := range hidden {
+		if strings.Contains(view, s) {
+			t.Fatalf("view still shows %q:\n%s", s, view)
+		}
+	}
+}
+
+func TestDetailSearchNarrowsItemsByIDTitleAndType(t *testing.T) {
+	m := detailSearch(t, openSearchDetail(t), "PARSER hitl")
+	if m.detail.searchTyping {
+		t.Fatal("Enter left the detail search typing")
+	}
+	assertShows(t, m.View().Content,
+		[]string{"Render parser output", "search: PARSER hitl", "/ search"},
+		[]string{"Wire the parser", "Docs"})
+
+	// The full keymap is back over the narrowed list: `r` opens the run menu
+	// over the one item the search left.
+	m = pressKeys(t, m, "r")
+	if m.itemMenu == nil || m.itemMenu.item.ID != "02" {
+		t.Fatalf("r over the narrowed list opened %+v, want item 02's menu", m.itemMenu)
+	}
+
+	m = detailSearch(t, openSearchDetail(t), "03")
+	assertShows(t, m.View().Content, []string{"Docs"}, []string{"Wire the parser", "Render parser output"})
+}
+
+func TestDetailSearchDoesNotReadStatus(t *testing.T) {
+	m := detailSearch(t, openSearchDetail(t), "done")
+	assertShows(t, m.View().Content,
+		[]string{`No items match search "done" — / then enter to clear.`},
+		[]string{"Render parser output", "Docs"})
+}
+
+func TestDetailSearchTypingOwnsTheKeyboard(t *testing.T) {
+	m := detailSearch(t, openSearchDetail(t), "afk")
+	cursor := m.detail.list.Cursor()
+
+	m = pressKeys(t, m, "/", "j", "k", "v", "r")
+	if got := m.detail.searchInput.Value(); got != "jkvr" {
+		t.Fatalf("typed buffer = %q, want jkvr", got)
+	}
+	if m.itemMenu != nil || m.detail.artifacts || m.detail.list.Cursor() != cursor {
+		t.Fatal("a letter acted instead of typing")
+	}
+	assertShows(t, m.View().Content, []string{"enter apply search · esc cancel · C-h help"}, nil)
+
+	// Esc puts back the term in force before `/`.
+	updated, _ := m.update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	m = updated.(QueueDashboard)
+	if m.detail == nil || m.detail.searchTyping || m.detail.searchTerm != "afk" {
+		t.Fatalf("esc did not restore the applied term: %+v", m.detail)
+	}
+	assertShows(t, m.View().Content, []string{"Wire the parser", "Docs"}, []string{"Render parser output"})
+
+	// Reopening starts empty, and applying that empty buffer clears the search.
+	m = detailSearch(t, m, "")
+	if m.detail.searchTerm != "" {
+		t.Fatalf("empty query left term %q", m.detail.searchTerm)
+	}
+	assertShows(t, m.View().Content, []string{"Wire the parser", "Render parser output", "Docs"}, []string{"search:"})
+}
+
+func TestDetailSearchSurvivesThePoll(t *testing.T) {
+	m := detailSearch(t, openSearchDetail(t), "parser")
+
+	refreshed := searchDetailRow()
+	refreshed.Items = append(refreshed.Items,
+		work.Item{ID: "04", Title: "Test the parser", Type: "AFK"},
+		work.Item{ID: "05", Title: "Release", Type: "AFK"})
+	updated, _ := m.Update(dashboardRowsMsg{snap: DashboardSnapshot{Containers: []DashboardRow{refreshed}}})
+	m = updated.(QueueDashboard)
+
+	assertShows(t, m.View().Content,
+		[]string{"search: parser", "Wire the parser", "Render parser output", "Test the parser"},
+		[]string{"Docs", "Release"})
+}
+
+func TestDetailSearchNarrowsTheArtifactList(t *testing.T) {
+	root := t.TempDir()
+	row := searchDetailRow()
+	row.DefPath = root
+	kind := &artifactDetailKind{id: ref.KindTaskSet, artifacts: []work.Artifact{
+		{Type: "refine", Name: "refine-20260817T120000Z.md", Path: filepath.Join(root, row.ID, "refine", "refine-20260817T120000Z.md")},
+		{Type: "spec", Name: "spec.md", Path: filepath.Join(root, row.ID, "spec.md")},
+	}}
+	m := openArtifactDetail(t, artifactDetailDashboard(kind, row))
+	m = pressKeys(t, m, "v")
+
+	m = detailSearch(t, m, "SPEC")
+	assertShows(t, m.View().Content, []string{"spec.md", "search: SPEC"}, []string{"refine-20260817T120000Z.md"})
+
+	m = detailSearch(t, m, "nothing")
+	assertShows(t, m.View().Content,
+		[]string{`No artifacts match search "nothing" — / then enter to clear.`, "v tasks"},
+		[]string{"spec.md"})
+}
+
+func TestDetailSearchAndRowSearchKeepTheirOwnTerms(t *testing.T) {
+	m := artifactDetailDashboard(&itemVerbKind{}, searchDetailRow())
+	m = pressKeys(t, m, "/", "t", "h", "i", "n", "g")
+	updated, _ := m.update(tea.KeyPressMsg{Code: tea.KeyEnter})
+	m = updated.(QueueDashboard)
+
+	m = pressKeys(t, m, "l", "/")
+	if got := m.detail.searchInput.Value(); got != "" {
+		t.Fatalf("detail search opened with the row list's buffer %q", got)
+	}
+	m = detailSearch(t, m, "docs")
+	if m.searchTerm != "thing" {
+		t.Fatalf("detail search changed the row list's term to %q", m.searchTerm)
+	}
+
+	updated, _ = m.update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	m = updated.(QueueDashboard)
+	if m.detail != nil || m.searchTerm != "thing" || len(m.snap.Containers) != 1 {
+		t.Fatalf("leaving the detail disturbed the row search: term %q, rows %d", m.searchTerm, len(m.snap.Containers))
+	}
+	if m = pressKeys(t, m, "l"); m.detail.searchTerm != "" {
+		t.Fatalf("a reopened detail kept the old detail term %q", m.detail.searchTerm)
+	}
+}
