+// TestDetailContainerOpenersMatchTheRowList pins decision 1 as the equality it
+// is: `s`, `y` and `m` inside a detail open the same menu over the same
+// container the row above opens, and a kind that offers nothing refuses with the
+// same words — on the detail's own hint line, where the reader is looking.
+func TestDetailContainerOpenersMatchTheRowList(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		row   DashboardRow
+		kinds func() workKinds
+	}{
+		{
+			name: "task set",
+			row: DashboardRow{
+				Project: "pop", CursorKey: "pop\x00my-set", ID: "my-set",
+				RawStatus: tasks.StatusReady, DefPath: "/repo/tasks", StatePath: "/repo/state.json",
+			},
+		},
+		{
+			name:  "routine",
+			row:   DashboardRow{Project: "pop", CursorKey: "pop\x00nightly", Kind: ref.KindRoutine, ID: "nightly"},
+			kinds: testRoutineKinds,
+		},
+	} {
+		for _, key := range []rune{'s', 'y', 'm'} {
+			t.Run(fmt.Sprintf("%s/%c", tc.name, key), func(t *testing.T) {
+				m := newQueueDashboard(&drain.Deps{}, &config.Config{}, DashboardSnapshot{Containers: []DashboardRow{tc.row}})
+				m.width, m.height = 120, 24
+				if tc.kinds != nil {
+					m.kinds = tc.kinds()
+				}
+				press := tea.KeyPressMsg{Code: key, Text: string(key)}
+
+				above, _ := m.Update(press)
+				fromRow := above.(QueueDashboard)
+
+				opened, _ := m.Update(tea.KeyPressMsg{Code: 'l', Text: "l"})
+				below, _ := opened.(QueueDashboard).Update(press)
+				fromDetail := below.(QueueDashboard)
+				if fromDetail.detail == nil {
+					t.Fatalf("%c closed the detail view", key)
+				}
+
+				if fromRow.menu == nil {
+					if fromDetail.menu != nil {
+						t.Fatalf("%c opened a menu the row list refuses to open", key)
+					}
+					if got, want := fromDetail.detail.flash.Text(), fromRow.flash.Text(); got != want {
+						t.Fatalf("detail refusal = %q, want the row list's %q", got, want)
+					}
+					if fromDetail.flash.Text() != "" {
+						t.Fatalf("refusal also landed on the table's line, behind the detail: %q", fromDetail.flash.Text())
+					}
+					return
+				}
+				if fromDetail.menu == nil {
+					t.Fatalf("%c in the detail opened no menu", key)
+				}
+				if fromDetail.menu.row.ID != tc.row.ID {
+					t.Fatalf("menu opened over %q, want the detail's container %q", fromDetail.menu.row.ID, tc.row.ID)
+				}
+				if got, want := containerMenuEntries(t, fromDetail), containerMenuEntries(t, fromRow); !reflect.DeepEqual(got, want) {
+					t.Fatalf("detail menu = %v, want the row list's %v", got, want)
+				}
+
+				closed, _ := fromDetail.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+				after := closed.(QueueDashboard)
+				if after.menu != nil {
+					t.Fatalf("esc did not close the %c menu", key)
+				}
+				if after.detail == nil {
+					t.Fatalf("esc closed the detail along with the %c menu", key)
+				}
+			})
+		}
+	}
+}
