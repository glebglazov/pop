+// The detail view answers to the row list's container openers (ADR-0261). These
+// tests drive them from the same keypresses an operator makes, one level down.
+
+// containerMenuEntries is the open container menu's entries as "key label",
+// whichever of the three is open. The keys and their labels are what an
+// operator's fingers depend on, so that is what a menu is pinned on.
+func containerMenuEntries(t *testing.T, m QueueDashboard) []string {
+	t.Helper()
+	var entries []string
+	switch {
+	case m.menu == nil:
+		t.Fatal("no container menu is open")
+	case m.menu.status != nil:
+		for _, action := range m.menu.status.list.Items() {
+			entries = append(entries, action.Key+" "+action.Label)
+		}
+	case m.menu.copy != nil:
+		for _, action := range m.menu.copy.list.Items() {
+			entries = append(entries, action.Key+" "+action.Label)
+		}
+	case m.menu.mute != nil:
+		for _, entry := range m.menu.mute.list.Items() {
+			entries = append(entries, entry.key+" "+entry.label)
+		}
+	default:
+		t.Fatal("the open menu is the run menu, not a container menu")
+	}
+	return entries
+}
