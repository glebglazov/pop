+	block := blockLines(t, m)
+	ruleAt := dashboardTestLineIndex(strings.Split(ui.StripANSI(view), "\n"), "status · my-set")
+	if ruleAt < 0 {
+		t.Fatalf("no menu rule naming the container on screen:\n%s", ui.StripANSI(view))
+	}
+	if got, want := ruleAt, len(lines)-1-block; got != want {
+		t.Fatalf("menu rule at line %d, want %d so its block ends above the hint line:\n%s", got, want, ui.StripANSI(view))
+	}
+	if got, want := beforeRows-len(m.detail.list.VisibleRows()), block; got != want {
+		t.Fatalf("detail body lost %d rows, want the menu block's %d lines", got, want)
+	}
+
+	closed, _ := m.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	m = closed.(QueueDashboard)
+	if m.detail == nil {
+		t.Fatal("esc closed the detail instead of the menu")
+	}
+	m.View()
+	if got := len(m.detail.list.VisibleRows()); got != beforeRows {
+		t.Fatalf("detail body restored to %d rows, want %d", got, beforeRows)
+	}
+}
