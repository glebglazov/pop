+// operator who learnt them on the row list is told they still answer here.
+func TestDetailNamesItsOpeners(t *testing.T) {
+	m := genericDetailDashboard(&itemVerbKind{})
+	updated, _ := m.Update(tea.KeyPressMsg{Code: 'l', Text: "l"})
+	got := updated.(QueueDashboard)
+
+	hint := detailHints(got.detail)
+	for _, want := range []string{"r run ▸", "s status ▸", "y copy ▸", "m mute ▸"} {
+		if !strings.Contains(hint, want) {
+			t.Fatalf("detail hint = %q, want it to name %q", hint, want)
+		}
+	}
+	if strings.Contains(hint, "copy name") || strings.Contains(hint, "copy path") {
+		t.Fatalf("detail hint still advertises a flat copy: %q", hint)
+	}
+
+	var help []string
+	for _, entry := range got.helpEntries() {
+		help = append(help, entry.Key+" "+entry.Desc)
+	}
+	for _, want := range []string{"r item run menu", "s status menu", "y copy menu", "m mute menu"} {
+		if !containsString(help, want) {
+			t.Fatalf("detail help = %v, want an entry %q", help, want)
+		}
+	}
+}
+
+func containsString(haystack []string, want string) bool {
+	for _, got := range haystack {
+		if got == want {
+			return true
+		}
+	}
+	return false
+}
