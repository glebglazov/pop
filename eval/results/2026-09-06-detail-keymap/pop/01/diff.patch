@@ -0,0 +1,162 @@
+package dashboard
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/routine"
+	"github.com/glebglazov/pop/tasks/drain"
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// ADR-0261: inside a detail view `s`, `y` and `m` open the container's own
+// menus and `I` runs its own flat verb — the row list's keyboard, one level down.
+
+// detailOverFirstRow is a dashboard over two task sets with the detail open on
+// the first, entered the way a human enters it.
+func detailOverFirstRow(t *testing.T) QueueDashboard {
+	t.Helper()
+	m := selDashboard(selRows("alpha", "beta"))
+	m = selPress(t, m, tea.KeyPressMsg{Code: tea.KeyEnter})
+	if m.detail == nil || m.detail.row.ID != "alpha" {
+		t.Fatal("enter did not open alpha's detail")
+	}
+	return m
+}
+
+func TestDetailOpenersOpenTheContainersMenus(t *testing.T) {
+	cases := []struct {
+		key    rune
+		opened func(*dashboardMenu) bool
+		want   []string
+	}{
+		{'s', func(menu *dashboardMenu) bool { return menu.status != nil }, actionKeys(testKinds().statusActionsFor(selRows("alpha")[0]))},
+		{'y', func(menu *dashboardMenu) bool { return menu.copy != nil }, actionKeys(testKinds().copyActionsFor(selRows("alpha")[0]))},
+		{'m', func(menu *dashboardMenu) bool { return menu.mute != nil }, nil},
+	}
+	for _, tc := range cases {
+		t.Run(string(tc.key), func(t *testing.T) {
+			m := detailOverFirstRow(t)
+			m = selPress(t, m, selKeyRune(tc.key))
+			if m.menu == nil || !tc.opened(m.menu) || m.menu.row.ID != "alpha" {
+				t.Fatalf("%c did not open alpha's own menu: %+v", tc.key, m.menu)
+			}
+			if tc.want != nil {
+				var got []string
+				if m.menu.status != nil {
+					got = actionKeys(m.menu.status.list.Items())
+				} else {
+					got = actionKeys(m.menu.copy.list.Items())
+				}
+				if strings.Join(got, ",") != strings.Join(tc.want, ",") {
+					t.Fatalf("%c menu = %v, want the row list's %v", tc.key, got, tc.want)
+				}
+			}
+
+			// The menu is the detail's reserved block, under the detail's header.
+			view := m.View().Content
+			if !strings.Contains(view, "esc close") || !strings.Contains(view, "alpha") {
+				t.Fatalf("detail did not render the menu block:\n%s", view)
+			}
+			if blockLines := dashboardMenuLines(m.menu, m.width, m.liveCache()); !strings.Contains(view, strings.TrimSpace(blockLines[len(blockLines)-1])) {
+				t.Fatalf("menu block missing from detail view:\n%s", view)
+			}
+
+			// J/K have no row list on screen to move.
+			m = selPress(t, m, selKeyRune('J'))
+			if m.list.Cursor() != 0 || m.menu == nil {
+				t.Fatal("J under a detail-opened menu moved the hidden row list")
+			}
+
+			m = selPress(t, m, selKeyEsc())
+			if m.menu != nil || m.detail == nil {
+				t.Fatalf("esc: menu=%v detail=%v, want the menu closed and the detail standing", m.menu, m.detail)
+			}
+		})
+	}
+}
+
+func actionKeys(actions []work.Action) []string {
+	keys := make([]string, 0, len(actions))
+	for _, action := range actions {
+		keys = append(keys, action.Key+" "+action.Label)
+	}
+	return keys
+}
+
+// A Selection is a row-list mark: the detail is about its one container.
+func TestDetailMenuIgnoresTheRowListSelection(t *testing.T) {
+	m := selDashboard(selRows("alpha", "beta"))
+	m = selPress(t, m, selKeyTab())
+	m = selPress(t, m, selKeyTab())
+	if !m.selection.Active() {
+		t.Fatal("tab did not mark rows")
+	}
+	m.detail = m.openDetailView(m.snap.Containers[0])
+	for _, key := range []rune{'s', 'y', 'm'} {
+		got := selPress(t, m, selKeyRune(key))
+		if got.menu == nil || got.menu.plural || got.menu.row.ID != m.detail.row.ID {
+			t.Fatalf("%c over a marked row list opened %+v, want a singular menu over %s", key, got.menu, m.detail.row.ID)
+		}
+	}
+}
+
+func TestDetailOpenerOverAKindWithNothingFlashesTheRowListsRefusal(t *testing.T) {
+	row := DashboardRow{Project: "pop", CursorKey: "pop\x00nightly", Kind: ref.KindRoutine, ID: "nightly"}
+	m := newQueueDashboard(&drain.Deps{}, &config.Config{}, DashboardSnapshot{Containers: []DashboardRow{row}})
+	m.kinds = testRoutineKinds()
+	m.width, m.height = 120, 24
+	m.detail = newDetailView(row)
+
+	updated, _ := m.Update(tea.KeyPressMsg{Code: 's', Text: "s"})
+	got := updated.(QueueDashboard)
+	want := "a Routine has no status to write"
+	if got.menu != nil || got.flash.Text() != want {
+		t.Fatalf("menu=%v flash=%q, want no menu and %q", got.menu, got.flash.Text(), want)
+	}
+	if view := got.View().Content; !strings.Contains(view, want) {
+		t.Fatalf("detail did not show the refusal:\n%s", view)
+	}
+}
+
+func TestDetailIRunsTheContainersFlatVerb(t *testing.T) {
+	spy := &verbSpyKind{Kind: routine.NewKind(nil)}
+	kinds := func(*drain.Deps, *config.Config) []work.Kind { return []work.Kind{spy} }
+	m := openPage(t, &drain.Deps{Kinds: kinds, RoutineKinds: kinds}, PageRoutines)
+	m.detail = newDetailView(m.snap.Containers[0])
+
+	m = pressKeys(t, m, "I")
+
+	if fmt.Sprint(spy.performed) != fmt.Sprint([]work.Verb{routine.VerbFire}) {
+		t.Fatalf("I in a routine's detail performed %v, want the kind's own fire verb", spy.performed)
+	}
+	if m.detail == nil {
+		t.Fatal("I closed the detail")
+	}
+}
+
+func TestDetailHintsAndHelpNameTheOpeners(t *testing.T) {
+	m := detailOverFirstRow(t)
+	view := m.View().Content
+	for _, opener := range []string{"r run ▸", "s status ▸", "y copy ▸", "m mute ▸"} {
+		if !strings.Contains(view, opener) {
+			t.Fatalf("detail hint line missing %q:\n%s", opener, view)
+		}
+	}
+	keys := map[string]bool{}
+	for _, entry := range m.helpEntries() {
+		keys[entry.Key] = true
+	}
+	for _, key := range []string{"r", "s", "y", "m", "I"} {
+		if !keys[key] {
+			t.Fatalf("detail help missing %s: %+v", key, m.helpEntries())
+		}
+	}
+	if keys["p"] {
+		t.Fatal("detail help still names the retired p copy")
+	}
+}
