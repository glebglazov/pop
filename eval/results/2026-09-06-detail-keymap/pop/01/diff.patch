diff --git a/dashboard/dashboard_detail_openers_test.go b/dashboard/dashboard_detail_openers_test.go
new file mode 100644
index 00000000..be625cae
--- /dev/null
+++ b/dashboard/dashboard_detail_openers_test.go
@@ -0,0 +1,144 @@
+package dashboard
+
+import (
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/glebglazov/pop/work"
+)
+
+// A detail view answers s, y, m and I over the container it is open over, with
+// the same menus and verbs the row list gives that container (ADR-0261). These
+// tests hold the detail to the row list: each asks the row list first and
+// expects the detail to give the same answer.
+
+func pressKey(m QueueDashboard, key string) QueueDashboard {
+	updated, _ := m.update(tea.KeyPressMsg{Code: rune(key[0]), Text: key})
+	return updated.(QueueDashboard)
+}
+
+func TestDetailOpenersOpenTheContainersMenus(t *testing.T) {
+	for _, key := range []string{"s", "y", "m"} {
+		t.Run(key, func(t *testing.T) {
+			rowList := pressKey(selDashboard(selRows("alpha", "beta")), key)
+			if rowList.menu == nil {
+				t.Fatalf("%s opened no menu over the row", key)
+			}
+			want := dashboardMenuLines(rowList.menu, rowList.width, rowList.liveCache())
+
+			m := pressKey(selDashboard(selRows("alpha", "beta")), "l")
+			m = pressKey(m, key)
+			if m.menu == nil || m.detail == nil {
+				t.Fatalf("%s in the detail: menu %v, detail %v", key, m.menu, m.detail)
+			}
+			if m.menu.row.ID != "alpha" {
+				t.Fatalf("%s opened a menu over %q, want the detail's container alpha", key, m.menu.row.ID)
+			}
+			view := m.View().Content
+			for _, line := range want {
+				if !strings.Contains(view, line) {
+					t.Fatalf("detail menu is missing the row list's line %q:\n%s", line, view)
+				}
+			}
+
+			// J/K have no rows to move under a detail-opened menu.
+			m = pressKey(m, "J")
+			if row, _ := m.list.Selected(); row.ID != "alpha" || m.menu == nil {
+				t.Fatalf("J under the detail's menu moved the row list to %q", row.ID)
+			}
+
+			updated, _ := m.update(tea.KeyPressMsg{Code: tea.KeyEscape})
+			m = updated.(QueueDashboard)
+			if m.menu != nil || m.detail == nil {
+				t.Fatalf("esc: menu %v, detail %v; want the menu closed and the detail standing", m.menu, m.detail)
+			}
+		})
+	}
+}
+
+func TestDetailOpenersRefuseAsTheRowListDoes(t *testing.T) {
+	for _, key := range []string{"s", "y", "m"} {
+		t.Run(key, func(t *testing.T) {
+			rowList := pressKey(genericDetailDashboard(&itemVerbKind{}), key)
+			want := rowList.flash.Text()
+			if rowList.menu != nil || want == "" {
+				t.Fatalf("row list %s: menu %v, flash %q; want a refusal", key, rowList.menu, want)
+			}
+
+			m := pressKey(genericDetailDashboard(&itemVerbKind{}), "l")
+			m = pressKey(m, key)
+			if m.menu != nil {
+				t.Fatalf("%s opened a menu in the detail over a kind that offers nothing", key)
+			}
+			if view := m.View().Content; !strings.Contains(view, want) {
+				t.Fatalf("detail does not show the refusal %q:\n%s", want, view)
+			}
+		})
+	}
+}
+
+func TestDetailOpenersIgnoreTheSelection(t *testing.T) {
+	m := selDashboard(selRows("alpha", "beta"))
+	m = pressKey(m, "tab")
+	m = pressKey(m, "tab")
+	if m.selection.Len() != 2 {
+		t.Fatalf("marked %d rows, want 2", m.selection.Len())
+	}
+	// A detail does not open over a Selection from the keyboard; a kind's
+	// OutcomeDetail opens one all the same, and the marks stay on the row list.
+	alpha := m.list.Items()[0]
+	m.detail = m.openDetailView(alpha)
+
+	m = pressKey(m, "s")
+	if m.menu == nil || m.menu.plural || m.menu.row.ID != "alpha" {
+		t.Fatalf("s in the detail over a Selection opened %+v, want a singular menu over alpha", m.menu)
+	}
+}
+
+func TestDetailIRunsTheContainersOwnVerb(t *testing.T) {
+	kind := &itemVerbKind{actions: []work.Action{{Verb: "thing-run", Key: "I", Label: "run the thing"}}}
+
+	rowList := pressKeys(t, genericDetailDashboard(kind), "I")
+	want := rowList.flash.Text()
+	if want != "ran thing-run" {
+		t.Fatalf("row list I flashed %q, want the kind's own verb to run", want)
+	}
+
+	m := pressKeys(t, genericDetailDashboard(kind), "l", "I")
+	if m.detail == nil {
+		t.Fatal("I closed the detail")
+	}
+	if view := m.View().Content; !strings.Contains(view, want) {
+		t.Fatalf("detail I does not show %q:\n%s", want, view)
+	}
+}
+
+func TestDetailHintsAndHelpNameTheOpeners(t *testing.T) {
+	kind := &itemVerbKind{actions: []work.Action{{Verb: "thing-run", Key: "I", Label: "run the thing"}}}
+	m := pressKey(genericDetailDashboard(kind), "l")
+
+	lines := strings.Split(m.View().Content, "\n")
+	bottom := lines[len(lines)-1]
+	for _, want := range []string{"r run ▸", "s status ▸", "y copy ▸", "m mute ▸"} {
+		if !strings.Contains(bottom, want) {
+			t.Fatalf("detail hint line %q is missing %q", bottom, want)
+		}
+	}
+
+	keys := map[string]string{}
+	for _, entry := range m.helpEntries() {
+		keys[entry.Key] = entry.Desc
+	}
+	for _, key := range []string{"r", "s", "y", "m"} {
+		if keys[key] == "" {
+			t.Fatalf("detail help does not name %s: %v", key, keys)
+		}
+	}
+	if keys["I"] != "run the thing" {
+		t.Fatalf("detail help names I as %q, want the container's own verb", keys["I"])
+	}
+	if _, ok := keys["p"]; ok {
+		t.Fatal("detail help still names p")
+	}
+}
diff --git a/dashboard/dashboard_detail_search_test.go b/dashboard/dashboard_detail_search_test.go
new file mode 100644
index 00000000..6c627a65
--- /dev/null
+++ b/dashboard/dashboard_detail_search_test.go
@@ -0,0 +1,220 @@
+package dashboard
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// The detail's `/` narrows its item list with the row list's grammar, over its
+// own buffer and term (ADR-0261 decision 5). These tests drive it from the keys
+// a reader presses and assert what the detail then holds and shows.
+
+func searchDetailRow() DashboardRow {
+	row := genericDetailRow()
+	row.Items = []work.Item{
+		{ID: "01-alpha", Title: "Wire the parser", Type: "AFK", Status: "open"},
+		{ID: "02-beta", Title: "Render the table", Type: "HITL", Status: "done"},
+		{ID: "03-gamma", Title: "Parser docs", Type: "HITL", Status: "open"},
+	}
+	return row
+}
+
+func openSearchDetail(t *testing.T) QueueDashboard {
+	t.Helper()
+	m := genericDetailDashboard(&itemVerbKind{})
+	m.allRows = []DashboardRow{searchDetailRow()}
+	m.applySearch("")
+	return pressDetail(t, m, "l")
+}
+
+// pressDetail sends each key as its own press; "enter" and "esc" are the named
+// keys, anything else is typed character by character.
+func pressDetail(t *testing.T, m QueueDashboard, keys ...string) QueueDashboard {
+	t.Helper()
+	for _, key := range keys {
+		var msgs []tea.KeyPressMsg
+		switch key {
+		case "enter":
+			msgs = []tea.KeyPressMsg{{Code: tea.KeyEnter}}
+		case "esc":
+			msgs = []tea.KeyPressMsg{{Code: tea.KeyEscape}}
+		default:
+			for _, ch := range key {
+				msgs = append(msgs, tea.KeyPressMsg{Code: ch, Text: string(ch)})
+			}
+		}
+		for _, msg := range msgs {
+			updated, _ := m.update(msg)
+			m = updated.(QueueDashboard)
+		}
+	}
+	return m
+}
+
+func detailItemIDs(m QueueDashboard) []string {
+	var ids []string
+	for _, item := range m.detail.list.Items() {
+		ids = append(ids, item.ID)
+	}
+	return ids
+}
+
+func assertDetailItems(t *testing.T, m QueueDashboard, want ...string) {
+	t.Helper()
+	if got := strings.Join(detailItemIDs(m), ","); got != strings.Join(want, ",") {
+		t.Fatalf("detail items = %q, want %q", got, strings.Join(want, ","))
+	}
+}
+
+func TestDetailSearchAppliesAndReturnsTheKeymap(t *testing.T) {
+	m := pressDetail(t, openSearchDetail(t), "/", "parser", "enter")
+	if m.detail == nil || m.detail.searchTyping {
+		t.Fatal("enter should apply the search and stay in the detail")
+	}
+	assertDetailItems(t, m, "01-alpha", "03-gamma")
+
+	// The whole keymap is back, over the narrowed items.
+	m = pressDetail(t, m, "j")
+	if item, _ := m.detail.list.Selected(); item.ID != "03-gamma" {
+		t.Fatalf("j after apply selected %q, want 03-gamma", item.ID)
+	}
+	m = pressDetail(t, m, "r")
+	if m.itemMenu == nil || m.itemMenu.item.ID != "03-gamma" {
+		t.Fatalf("r after apply should open the narrowed item's menu, got %+v", m.itemMenu)
+	}
+}
+
+func TestDetailSearchMatchesIDTitleAndTypeButNotStatus(t *testing.T) {
+	cases := []struct {
+		query string
+		want  []string
+	}{
+		{"BETA", []string{"02-beta"}},
+		{"render", []string{"02-beta"}},
+		{"hitl", []string{"02-beta", "03-gamma"}},
+		// Terms are AND-ed, and each may land in a different field.
+		{"hitl parser", []string{"03-gamma"}},
+		{"afk gamma", nil},
+		// Status is not a field: "done" names no id, title or type.
+		{"done", nil},
+		{"open", nil},
+	}
+	for _, tc := range cases {
+		m := pressDetail(t, openSearchDetail(t), "/", tc.query, "enter")
+		assertDetailItems(t, m, tc.want...)
+	}
+}
+
+func TestDetailSearchEscRestoresTheTermAndAnEmptyApplyClearsIt(t *testing.T) {
+	m := pressDetail(t, openSearchDetail(t), "/", "beta", "enter")
+	assertDetailItems(t, m, "02-beta")
+
+	// Reopening starts from an empty buffer; esc abandons the edit and puts the
+	// applied term back.
+	m = pressDetail(t, m, "/")
+	if m.detail.searchInput.Value() != "" {
+		t.Fatalf("buffer on reopen = %q, want empty", m.detail.searchInput.Value())
+	}
+	m = pressDetail(t, m, "gamma", "esc")
+	if m.detail == nil || m.detail.searchTyping || m.detail.searchTerm != "beta" {
+		t.Fatalf("esc should restore the term in force, detail = %+v", m.detail)
+	}
+	assertDetailItems(t, m, "02-beta")
+
+	m = pressDetail(t, m, "/", "enter")
+	if m.detail.searchTerm != "" {
+		t.Fatalf("applying an empty query left term %q", m.detail.searchTerm)
+	}
+	assertDetailItems(t, m, "01-alpha", "02-beta", "03-gamma")
+}
+
+func TestDetailSearchTypesEveryKeyButTheReservedThree(t *testing.T) {
+	m := pressDetail(t, openSearchDetail(t), "/", "jkvrsym")
+	if m.detail == nil || !m.detail.searchTyping {
+		t.Fatal("typing should keep the detail in its typing phase")
+	}
+	if got := m.detail.searchInput.Value(); got != "jkvrsym" {
+		t.Fatalf("buffer = %q, want every key typed", got)
+	}
+	if m.itemMenu != nil || m.menu != nil || m.detail.artifacts {
+		t.Fatal("a typed letter acted instead of being typed")
+	}
+	if !strings.Contains(m.View().Content, "enter apply search · esc cancel") {
+		t.Fatalf("typing hint missing:\n%s", m.View().Content)
+	}
+}
+
+func TestDetailSearchSurvivesThePollAndIsShown(t *testing.T) {
+	m := pressDetail(t, openSearchDetail(t), "/", "parser", "enter")
+
+	refreshed := searchDetailRow()
+	refreshed.Items = append(refreshed.Items, work.Item{ID: "04-delta", Title: "Parser tests", Type: "AFK"})
+	updated, _ := m.update(dashboardRowsMsg{snap: DashboardSnapshot{Containers: []DashboardRow{refreshed}}})
+	m = updated.(QueueDashboard)
+
+	assertDetailItems(t, m, "01-alpha", "03-gamma", "04-delta")
+	if !strings.Contains(m.View().Content, "search: parser") {
+		t.Fatalf("the applied term is not on screen:\n%s", m.View().Content)
+	}
+}
+
+func TestDetailSearchEmptyStateNamesTheTermAndTheWayOut(t *testing.T) {
+	m := pressDetail(t, openSearchDetail(t), "/", "zzz", "enter")
+	view := m.View().Content
+	if !strings.Contains(view, `No items match search "zzz" — / then enter to clear.`) {
+		t.Fatalf("empty state does not name the term and the way out:\n%s", view)
+	}
+	if strings.Contains(view, "STATUS") {
+		t.Fatalf("an emptied search should not read as an empty item table:\n%s", view)
+	}
+}
+
+func TestDetailSearchNarrowsTheArtifactList(t *testing.T) {
+	root := t.TempDir()
+	row := genericDetailRow()
+	row.DefPath = root
+	at := time.Date(2026, 8, 17, 12, 0, 0, 0, time.UTC)
+	kind := &artifactDetailKind{id: ref.KindTaskSet, artifacts: []work.Artifact{
+		{Type: "refine", Name: "refine-20260817T120000Z.md", Path: filepath.Join(root, row.ID, "refine", "refine-20260817T120000Z.md"), At: at},
+		{Type: "spec", Name: "spec.md", Path: filepath.Join(root, row.ID, "spec.md"), At: at.Add(-time.Hour)},
+	}}
+	m := pressDetail(t, openArtifactDetail(t, artifactDetailDashboard(kind, row)), "v", "/", "SPEC", "enter")
+
+	artifacts := m.detail.artifactList.Items()
+	if len(artifacts) != 1 || artifacts[0].Name != "spec.md" {
+		t.Fatalf("artifact list after search = %+v, want spec.md alone", artifacts)
+	}
+
+	m = pressDetail(t, m, "/", "nothing", "enter")
+	view := m.View().Content
+	if !strings.Contains(view, `No artifacts match search "nothing"`) {
+		t.Fatalf("artifact empty state missing:\n%s", view)
+	}
+	if !m.detail.artifacts || !strings.Contains(view, "v tasks") {
+		t.Fatalf("an emptied artifact search should keep the Artifact view and its switch:\n%s", view)
+	}
+}
+
+func TestDetailSearchDoesNotShareTheRowListSearch(t *testing.T) {
+	m := typeSearch(genericDetailDashboard(&itemVerbKind{}), "thing", true)
+	m = pressDetail(t, m, "l", "/", "first", "enter")
+	if m.searchTerm != "thing" || m.detail.searchTerm != "first" {
+		t.Fatalf("row term = %q, detail term = %q; want thing and first", m.searchTerm, m.detail.searchTerm)
+	}
+	assertDetailItems(t, m, "01")
+
+	m = pressDetail(t, m, "esc", "/")
+	if !m.searchTyping || m.searchInput.Value() != "" {
+		t.Fatal("the row list's / should open its own empty buffer")
+	}
+	m = pressDetail(t, m, "esc")
+	if m.searchTerm != "thing" || len(m.snap.Containers) != 1 {
+		t.Fatalf("the detail's search moved the row list's term to %q", m.searchTerm)
+	}
+}
