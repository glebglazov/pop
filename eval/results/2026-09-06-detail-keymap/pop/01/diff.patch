diff --git a/dashboard/dashboard_detail_search_test.go b/dashboard/dashboard_detail_search_test.go
new file mode 100644
index 00000000..a87e1239
--- /dev/null
+++ b/dashboard/dashboard_detail_search_test.go
@@ -0,0 +1,207 @@
+package dashboard
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// ADR-0261 decision 5: `/` inside a detail narrows its list with the row list's
+// grammar, on a term of the detail's own.
+
+func searchDetailRow() DashboardRow {
+	row := genericDetailRow()
+	row.Items = []work.Item{
+		{ID: "01", Title: "Wire the parser", Type: "AFK", Status: "open"},
+		{ID: "02", Title: "Render the parser output", Type: "HITL", Status: "done"},
+		{ID: "03", Title: "Docs", Type: "AFK", Status: "done"},
+	}
+	return row
+}
+
+// openSearchDetail is a dashboard with the detail open on searchDetailRow,
+// entered the way a human enters it.
+func openSearchDetail(t *testing.T) QueueDashboard {
+	t.Helper()
+	m := genericDetailDashboard(&itemVerbKind{})
+	updated, _ := m.Update(dashboardRowsMsg{snap: DashboardSnapshot{Containers: []DashboardRow{searchDetailRow()}}})
+	m = selPress(t, updated.(QueueDashboard), selKeyRune('l'))
+	if m.detail == nil {
+		t.Fatal("l did not open the detail")
+	}
+	return m
+}
+
+// typeKeys presses each rune of text as its own key.
+func typeKeys(t *testing.T, m QueueDashboard, text string) QueueDashboard {
+	t.Helper()
+	for _, r := range text {
+		m = selPress(t, m, selKeyRune(r))
+	}
+	return m
+}
+
+// searchDetail opens the detail's search, types query and applies it.
+func searchDetail(t *testing.T, m QueueDashboard, query string) QueueDashboard {
+	t.Helper()
+	m = typeKeys(t, m, "/"+query)
+	return selPress(t, m, tea.KeyPressMsg{Code: tea.KeyEnter})
+}
+
+func detailItemIDs(m QueueDashboard) []string {
+	var ids []string
+	for _, item := range m.detail.list.Items() {
+		ids = append(ids, item.ID)
+	}
+	return ids
+}
+
+func TestDetailSearchMatchesIDTitleAndTypeWithTermsAndedAcrossFields(t *testing.T) {
+	cases := []struct {
+		query string
+		want  string
+	}{
+		{"PARSER", "01,02"},
+		{"03", "03"},
+		{"hitl", "02"},
+		{"parser afk", "01"},
+		{"afk docs", "03"},
+		{"parser docs", ""},
+	}
+	for _, tc := range cases {
+		t.Run(tc.query, func(t *testing.T) {
+			m := searchDetail(t, openSearchDetail(t), tc.query)
+			if got := strings.Join(detailItemIDs(m), ","); got != tc.want {
+				t.Fatalf("%q left items %q, want %q", tc.query, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestDetailSearchAppliedReturnsTheFullKeymapOverTheNarrowedItems(t *testing.T) {
+	m := searchDetail(t, openSearchDetail(t), "hitl")
+	if m.detail.searchTyping {
+		t.Fatal("enter left the detail search typing")
+	}
+	m = selPress(t, m, selKeyRune('r'))
+	if m.itemMenu == nil || m.itemMenu.item.ID != "02" {
+		t.Fatalf("r after the search did not open the run menu over the one item left: %+v", m.itemMenu)
+	}
+}
+
+func TestDetailSearchDoesNotReadStatus(t *testing.T) {
+	m := searchDetail(t, openSearchDetail(t), "done")
+	if ids := detailItemIDs(m); len(ids) != 0 {
+		t.Fatalf("a status word found items %v", ids)
+	}
+	view := m.View().Content
+	if want := `No items match search "done" — / then enter to clear.`; !strings.Contains(view, want) {
+		t.Fatalf("an emptied list does not name the term and the way out:\n%s", view)
+	}
+	if strings.Contains(view, "TITLE") {
+		t.Fatalf("an emptied list still reads as an empty table:\n%s", view)
+	}
+}
+
+func TestDetailSearchEscRestoresTheTermAndAnEmptyQueryClearsIt(t *testing.T) {
+	m := searchDetail(t, openSearchDetail(t), "parser")
+	m = typeKeys(t, m, "/docs")
+	if got := strings.Join(detailItemIDs(m), ","); got != "03" {
+		t.Fatalf("typing did not narrow from an empty buffer: %q", got)
+	}
+	m = selPress(t, m, selKeyEsc())
+	if m.detail == nil || m.detail.searchTerm != "parser" || strings.Join(detailItemIDs(m), ",") != "01,02" {
+		t.Fatalf("esc did not put back the term in force: detail=%v", m.detail)
+	}
+
+	m = selPress(t, selPress(t, m, selKeyRune('/')), tea.KeyPressMsg{Code: tea.KeyEnter})
+	if m.detail.searchTerm != "" || strings.Join(detailItemIDs(m), ",") != "01,02,03" {
+		t.Fatalf("an empty query did not clear the search: term %q, items %v", m.detail.searchTerm, detailItemIDs(m))
+	}
+}
+
+func TestDetailSearchTypingTakesEveryKeyButTheReservedThreeAsText(t *testing.T) {
+	m := typeKeys(t, openSearchDetail(t), "/jkvrsym")
+	d := m.detail
+	if d == nil || !d.searchTyping || d.searchInput.Value() != "jkvrsym" {
+		t.Fatalf("keys acted instead of typing: detail=%v", d)
+	}
+	if d.artifacts || m.itemMenu != nil || m.menu != nil || d.list.Cursor() != 0 {
+		t.Fatal("a typed letter moved, switched lists or opened a menu")
+	}
+	view := m.View().Content
+	if !strings.Contains(view, "enter apply search · esc cancel") {
+		t.Fatalf("typing hints do not name the reserved keys:\n%s", view)
+	}
+}
+
+func TestDetailSearchSurvivesThePollAndIsShown(t *testing.T) {
+	m := searchDetail(t, openSearchDetail(t), "parser")
+	if view := m.View().Content; !strings.Contains(view, "search: parser") {
+		t.Fatalf("the term in force is not shown:\n%s", view)
+	}
+
+	rebuilt := searchDetailRow()
+	rebuilt.Items = append(rebuilt.Items, work.Item{ID: "04", Title: "Parser tests", Type: "AFK", Status: "open"})
+	updated, _ := m.Update(dashboardRowsMsg{snap: DashboardSnapshot{Containers: []DashboardRow{rebuilt}}})
+	m = updated.(QueueDashboard)
+	if got := strings.Join(detailItemIDs(m), ","); got != "01,02,04" {
+		t.Fatalf("the poll widened or lost the search: items %q", got)
+	}
+	if view := m.View().Content; !strings.Contains(view, "search: parser") {
+		t.Fatalf("the term is no longer shown after the poll:\n%s", view)
+	}
+}
+
+func TestDetailSearchNarrowsTheArtifactListOnScreen(t *testing.T) {
+	root := t.TempDir()
+	row := genericDetailRow()
+	row.DefPath = root
+	kind := &artifactDetailKind{id: ref.KindTaskSet, artifacts: []work.Artifact{
+		{Type: "refine", Name: "refine-20260817T120000Z.md", Path: filepath.Join(root, row.ID, "refine", "refine-20260817T120000Z.md")},
+		{Type: "spec", Name: "spec.md", Path: filepath.Join(root, row.ID, "spec.md")},
+	}}
+	m := selPress(t, openArtifactDetail(t, artifactDetailDashboard(kind, row)), selKeyRune('v'))
+
+	m = searchDetail(t, m, "SPEC")
+	if got := m.detail.artifactList.Items(); len(got) != 1 || got[0].Name != "spec.md" {
+		t.Fatalf("artifact search left %v, want spec.md alone", got)
+	}
+
+	m = searchDetail(t, m, "nothing")
+	view := m.View().Content
+	if want := `No artifacts match search "nothing" — / then enter to clear.`; !strings.Contains(view, want) {
+		t.Fatalf("an emptied artifact list does not say why:\n%s", view)
+	}
+	if !m.detail.artifacts || !m.detail.hasArtifacts() {
+		t.Fatal("a search that emptied the artifact list took away the Artifact view")
+	}
+}
+
+func TestDetailSearchAndRowSearchKeepTheirOwnTerms(t *testing.T) {
+	m := genericDetailDashboard(&itemVerbKind{})
+	m = typeKeys(t, m, "/thing")
+	m = selPress(t, m, tea.KeyPressMsg{Code: tea.KeyEnter})
+	m = selPress(t, m, selKeyRune('l'))
+	if m.detail == nil {
+		t.Fatal("l did not open the detail")
+	}
+
+	m = typeKeys(t, m, "/first")
+	if m.searchTyping || m.searchInput.Value() != "" {
+		t.Fatal("the detail's typing went into the row list's buffer")
+	}
+	m = selPress(t, m, tea.KeyPressMsg{Code: tea.KeyEnter})
+	if m.searchTerm != "thing" || m.detail.searchTerm != "first" {
+		t.Fatalf("terms shared: row list %q, detail %q", m.searchTerm, m.detail.searchTerm)
+	}
+
+	m = selPress(t, m, selKeyEsc())
+	if m.detail != nil || m.searchTerm != "thing" || m.list.Len() != 1 {
+		t.Fatalf("leaving the detail disturbed the row list's search: term %q, rows %d", m.searchTerm, m.list.Len())
+	}
+}
