+// TestDetailMenuIgnoresARowListSelection pins the boundary the openers keep: a
+// Selection is a mark on the row list, so a menu opened one level down acts on
+// the one container the detail is open over and nothing else (ADR-0254
+// decision 5).
+func TestDetailMenuIgnoresARowListSelection(t *testing.T) {
+	rows := []DashboardRow{
+		{Project: "pop", CursorKey: "pop\x00set-a", ID: "set-a", RawStatus: tasks.StatusReady, DefPath: "/repo/tasks"},
+		{Project: "pop", CursorKey: "pop\x00set-b", ID: "set-b", RawStatus: tasks.StatusReady, DefPath: "/repo/tasks"},
+	}
+	m := newQueueDashboard(&drain.Deps{}, &config.Config{}, DashboardSnapshot{Containers: rows})
+	m.width, m.height = 120, 24
+	marked, _ := m.Update(tea.KeyPressMsg{Code: tea.KeyTab})
+	m = marked.(QueueDashboard)
+	if !m.selection.Active() {
