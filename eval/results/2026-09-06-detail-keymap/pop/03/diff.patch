+// taskSetDetailModel is a dashboard over one Task set with that set's detail open.
+func taskSetDetailModel() QueueDashboard {
+	row := DashboardRow{Project: "pop", CursorKey: "pop\x00my-set", ID: "my-set", DefPath: "/def", Kind: ref.KindTaskSet}
+	manifest := &tasks.Manifest{Valid: true, Tasks: []tasks.Task{{ID: "01-a", File: "01-a.md", Status: "open"}}}
+	m := newQueueDashboard(&drain.Deps{}, &config.Config{}, DashboardSnapshot{Containers: []DashboardRow{row}})
+	m.width, m.height = 120, 24
+	m.detail = newTaskDetailView(row, manifest, nil)
+	return m
+}
