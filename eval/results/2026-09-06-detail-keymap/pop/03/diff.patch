+// containerMenuEntries is what the open container menu offers, key and label,
+// whichever of the three it is.
+func containerMenuEntries(menu *dashboardMenu) []string {
+	var out []string
+	switch {
+	case menu == nil:
+	case menu.status != nil:
+		for _, a := range menu.status.list.Items() {
+			out = append(out, a.Key+" "+a.Label)
+		}
+	case menu.copy != nil:
+		for _, a := range menu.copy.list.Items() {
+			out = append(out, a.Key+" "+a.Label)
+		}
+	case menu.mute != nil:
+		for _, e := range menu.mute.list.Items() {
+			out = append(out, e.key+" "+e.label)
+		}
+	}
+	return out
+}
