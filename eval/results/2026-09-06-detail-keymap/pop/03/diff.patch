+// TestDetailOpenersOpenTheContainersMenus pins ADR-0261 decision 1: s, y and m in
+// a detail open the same Status, Copy and Mute menus, over the same container,
+// that they open over its row — rendered as the detail's reserved block, and
+// closed by esc back to the detail.
+func TestDetailOpenersOpenTheContainersMenus(t *testing.T) {
+	for _, key := range []string{"s", "y", "m"} {
+		t.Run(key, func(t *testing.T) {
+			above := taskSetDetailModel()
+			above.detail = nil
+			above = pressKeys(t, above, key)
+			want := containerMenuEntries(above.menu)
+			if len(want) == 0 {
+				t.Fatalf("%s on the row opened no menu", key)
+			}
+
+			m := pressKeys(t, taskSetDetailModel(), key)
+			if m.menu == nil || m.menu.row.ID != "my-set" {
+				t.Fatalf("%s in the detail opened %+v, want a menu over my-set", key, m.menu)
+			}
+			if got := containerMenuEntries(m.menu); fmt.Sprint(got) != fmt.Sprint(want) {
+				t.Fatalf("%s in the detail offers %v, the row offers %v", key, got, want)
+			}
+			view := m.View().Content
+			for _, line := range dashboardMenuLines(m.menu, m.width, m.liveCache()) {
+				if !strings.Contains(view, line) {
+					t.Fatalf("detail view missing menu block line %q:\n%s", line, view)
+				}
+			}
+			if !strings.Contains(view, "esc close") {
+				t.Fatalf("detail hint does not name the open menu's keys:\n%s", view)
+			}
+
+			m = pressKeys(t, m, "J")
+			if m.menu == nil {
+				t.Fatal("J closed the container menu")
+			}
+			updated, _ := m.update(tea.KeyPressMsg{Code: tea.KeyEscape})
+			m = updated.(QueueDashboard)
+			if m.menu != nil || m.detail == nil {
+				t.Fatalf("esc left menu=%v detail=%v, want the detail alone", m.menu != nil, m.detail != nil)
+			}
+		})
+	}
+}
