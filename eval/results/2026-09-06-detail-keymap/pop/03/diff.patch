+		help[e.Key] = e.Desc
+	}
+	for key, want := range map[string]string{"r": "item run menu", "s": "status menu", "y": "copy menu", "m": "mute menu"} {
+		if help[key] != want {
+			t.Fatalf("detail help %s = %q, want %q", key, help[key], want)
+		}
+	}
+	if _, ok := help["p"]; ok {
+		t.Fatal("detail help still names the retired p")
+	}
+}
diff --git a/dashboard/dashboard_detail_search_test.go b/dashboard/dashboard_detail_search_test.go
new file mode 100644
index 00000000..2bb80043
--- /dev/null
+++ b/dashboard/dashboard_detail_search_test.go
@@ -0,0 +1,214 @@
+package dashboard
+
+import (
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/tasks/drain"
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// The detail's `/` narrows its own list with the row list's grammar (ADR-0261
+// decision 5). These tests drive it from the keyboard of an open detail.
+
+func searchDetailRow() DashboardRow {
+	row := genericDetailRow()
+	row.Items = []work.Item{
+		{ID: "01-parser", Title: "Build the parser", Type: "AFK", Status: "open"},
+		{ID: "02-cli", Title: "Wire the command", Type: "HITL", Status: "done"},
+		{ID: "03-docs", Title: "Document the PARSER", Type: "AFK", Status: "done"},
+	}
+	return row
+}
+
+// searchDetailDashboard is the dashboard over searchDetailRow with its detail open.
+func searchDetailDashboard(t *testing.T, kind work.Kind) QueueDashboard {
+	t.Helper()
+	d := &drain.Deps{Kinds: func(*drain.Deps, *config.Config) []work.Kind { return []work.Kind{kind} }}
+	m := newQueueDashboard(d, &config.Config{}, DashboardSnapshot{Containers: []DashboardRow{searchDetailRow()}})
+	m.width, m.height = 140, 30
+	m = pressKeys(t, m, "l")
+	if m.detail == nil {
+		t.Fatal("l opened no detail")
+	}
+	return m
+}
+
+func pressSpecial(t *testing.T, m QueueDashboard, code rune) QueueDashboard {
+	t.Helper()
+	updated, _ := m.update(tea.KeyPressMsg{Code: code})
+	return updated.(QueueDashboard)
+}
+
+// searchDetail types query after `/` and applies it with enter.
+func searchDetail(t *testing.T, m QueueDashboard, query string) QueueDashboard {
+	t.Helper()
+	m = pressKeys(t, m, "/")
+	for _, r := range query {
+		m = pressKeys(t, m, string(r))
+	}
+	return pressSpecial(t, m, tea.KeyEnter)
+}
+
+func detailItemIDs(m QueueDashboard) []string {
+	var ids []string
+	for _, item := range m.detail.list.Items() {
+		ids = append(ids, item.ID)
+	}
+	return ids
+}
+
+func TestDetailSearchMatchesIDTitleAndTypeButNotStatus(t *testing.T) {
+	tests := []struct {
+		query string
+		want  []string
+	}{
+		{"parser", []string{"01-parser", "03-docs"}},     // title, any case
+		{"PARSER afk", []string{"01-parser", "03-docs"}}, // terms AND-ed across fields
+		{"parser build", []string{"01-parser"}},          // both terms must match
+		{"02-cl", []string{"02-cli"}},                    // id
+		{"hitl", []string{"02-cli"}},                     // type
+		{"done", nil},                                    // status is not searched
+	}
+	for _, tt := range tests {
+		t.Run(tt.query, func(t *testing.T) {
+			m := searchDetail(t, searchDetailDashboard(t, &itemVerbKind{}), tt.query)
+			if m.detail.searchTyping {
+				t.Fatal("enter left the search typing")
+			}
+			if got := detailItemIDs(m); !reflect.DeepEqual(got, tt.want) {
+				t.Fatalf("items for %q = %v, want %v", tt.query, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestDetailSearchTypesEveryKeyButTheReservedThree(t *testing.T) {
+	m := searchDetailDashboard(t, &itemVerbKind{})
+	m = pressKeys(t, m, "/", "j", "k", "v", "r", "s", "h")
+	if !m.detail.searchTyping || m.detail.searchInput.Value() != "jkvrsh" {
+		t.Fatalf("typing = %v, buffer = %q; want every letter typed", m.detail.searchTyping, m.detail.searchInput.Value())
+	}
+	if m.detail.artifacts || m.itemMenu != nil || m.menu != nil {
+		t.Fatal("a letter typed into the search acted as a key")
+	}
+	if view := m.View().Content; !strings.Contains(view, "enter apply search · esc cancel") {
+		t.Fatalf("typing hint missing:\n%s", view)
+	}
+}
+
+func TestDetailSearchEnterReturnsTheKeymapOverTheNarrowedItems(t *testing.T) {
+	m := searchDetail(t, searchDetailDashboard(t, &itemVerbKind{}), "afk")
+	m = pressKeys(t, m, "j")
+	if item, ok := m.detail.list.Selected(); !ok || item.ID != "03-docs" {
+		t.Fatalf("j after the search selected %+v, want 03-docs", item)
+	}
+	m = pressKeys(t, m, "r")
+	if m.itemMenu == nil || m.itemMenu.item.ID != "03-docs" {
+		t.Fatal("r after the search did not open the item menu over the narrowed cursor")
+	}
+}
+
+func TestDetailSearchEscRestoresTheTermAndEmptyEnterClears(t *testing.T) {
+	m := searchDetail(t, searchDetailDashboard(t, &itemVerbKind{}), "parser")
+
+	m = pressKeys(t, m, "/", "c", "l", "i")
+	if got := detailItemIDs(m); !reflect.DeepEqual(got, []string{"02-cli"}) {
+		t.Fatalf("live buffer narrowed to %v, want [02-cli]", got)
+	}
+	m = pressSpecial(t, m, tea.KeyEscape)
+	if m.detail == nil || m.detail.searchTyping || m.detail.searchTerm != "parser" {
+		t.Fatalf("esc did not restore the term in force: detail=%v", m.detail != nil)
+	}
+	if got := detailItemIDs(m); !reflect.DeepEqual(got, []string{"01-parser", "03-docs"}) {
+		t.Fatalf("items after esc = %v, want the parser match", got)
+	}
+
+	m = searchDetail(t, m, "")
+	if m.detail.searchTerm != "" || len(detailItemIDs(m)) != 3 {
+		t.Fatalf("empty query left term %q over %v", m.detail.searchTerm, detailItemIDs(m))
+	}
+}
+
+func TestDetailSearchSurvivesThePollAndIsShown(t *testing.T) {
+	m := searchDetail(t, searchDetailDashboard(t, &itemVerbKind{}), "parser")
+
+	refreshed := searchDetailRow()
+	refreshed.Items = append(refreshed.Items, work.Item{ID: "04-lexer", Title: "Feed the parser", Type: "AFK", Status: "open"})
+	updated, _ := m.Update(dashboardRowsMsg{snap: DashboardSnapshot{Containers: []DashboardRow{refreshed}}})
+	m = updated.(QueueDashboard)
+
+	if got := detailItemIDs(m); !reflect.DeepEqual(got, []string{"01-parser", "03-docs", "04-lexer"}) {
+		t.Fatalf("items after the poll = %v, want the rebuilt container narrowed by parser", got)
+	}
+	if view := m.View().Content; !strings.Contains(view, "search: parser") {
+		t.Fatalf("the term in force is not shown:\n%s", view)
+	}
+}
+
+func TestDetailSearchMatchingNothingNamesTheTerm(t *testing.T) {
+	m := searchDetail(t, searchDetailDashboard(t, &itemVerbKind{}), "zzz")
+	view := m.View().Content
+	if !strings.Contains(view, `No items match search "zzz" — / then enter to clear.`) {
+		t.Fatalf("empty search line missing:\n%s", view)
+	}
+}
+
+func TestDetailSearchNarrowsTheArtifactList(t *testing.T) {
+	root := t.TempDir()
+	row := searchDetailRow()
+	kind := &artifactDetailKind{id: ref.KindTaskSet, artifacts: []work.Artifact{
+		{Type: "refine", Name: "refine-20260817T120000Z.md", Path: filepath.Join(root, "refine.md")},
+		{Type: "spec", Name: "spec.md", Path: filepath.Join(root, "spec.md")},
+	}}
+	m := openArtifactDetail(t, artifactDetailDashboard(kind, row))
+	m = pressKeys(t, m, "v")
+	m = searchDetail(t, m, "SPEC")
+
+	if got := m.detail.artifactList.Items(); len(got) != 1 || got[0].Name != "spec.md" {
+		t.Fatalf("artifacts after the search = %+v, want spec.md alone", got)
+	}
+	if !m.detail.artifacts {
+		t.Fatal("the search left the Artifact view")
+	}
+
+	m = searchDetail(t, m, "nothing-here")
+	if view := m.View().Content; !strings.Contains(view, `No artifacts match search "nothing-here"`) {
+		t.Fatalf("empty artifact search line missing:\n%s", view)
+	}
+	m = pressKeys(t, m, "v")
+	m = pressKeys(t, m, "v")
+	if !m.detail.artifacts {
+		t.Fatal("v could not return to an Artifact view the search had emptied")
+	}
+}
+
+func TestDetailSearchSharesNothingWithTheRowSearch(t *testing.T) {
+	d := &drain.Deps{Kinds: func(*drain.Deps, *config.Config) []work.Kind { return []work.Kind{&itemVerbKind{}} }}
+	m := newQueueDashboard(d, &config.Config{}, DashboardSnapshot{Containers: []DashboardRow{searchDetailRow()}})
+	m.width, m.height = 140, 30
+	m = pressKeys(t, m, "/", "p", "o", "p")
+	m = pressSpecial(t, m, tea.KeyEnter)
+	m = pressKeys(t, m, "l")
+
+	if m.detail.searchTerm != "" || len(detailItemIDs(m)) != 3 {
+		t.Fatalf("the row search reached the detail: term %q, items %v", m.detail.searchTerm, detailItemIDs(m))
+	}
+	m = pressKeys(t, m, "/", "a")
+	if m.searchTyping || m.searchInput.Value() != "" {
+		t.Fatal("the detail's typing went into the row search's buffer")
+	}
+	m = pressSpecial(t, m, tea.KeyEnter)
+	if m.searchTerm != "pop" {
+		t.Fatalf("row search term = %q after a detail search, want pop", m.searchTerm)
+	}
+	m = pressSpecial(t, m, tea.KeyEscape)
+	if m.detail != nil || m.searchTerm != "pop" {
+		t.Fatalf("esc left detail=%v, row term %q", m.detail != nil, m.searchTerm)
+	}
+}
