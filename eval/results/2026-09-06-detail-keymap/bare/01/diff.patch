+// TestDetailHintsAndHelpNameTheOpeners pins the detail's bottom line and help
+// overlay on the row list's four openers, with the retired copy keys gone.
+func TestDetailHintsAndHelpNameTheOpeners(t *testing.T) {
+	m := genericDetailDashboard(&flatVerbKind{})
+	m, _ = pressKey(t, m, "l")
+	view := m.View().Content
+	for _, want := range []string{"r run ▸", "s status ▸", "y copy ▸", "m mute ▸", "/ search"} {
+		if !strings.Contains(view, want) {
+			t.Fatalf("detail hint line missing %q:\n%s", want, view)
+		}
+	}
+	if strings.Contains(view, "copy name") || strings.Contains(view, "copy path") {
+		t.Fatalf("detail hint line still advertises a flat copy key:\n%s", view)
+	}
+	help := map[string]string{}
+	for _, entry := range m.helpEntries() {
+		help[entry.Key] = entry.Desc
+	}
+	for key, want := range map[string]string{"r": "item run menu", "s": "status menu", "y": "copy menu", "m": "mute menu", "I": "poke", "/": "search"} {
+		if help[key] != want {
+			t.Fatalf("help %s = %q, want %q (all: %v)", key, help[key], want, help)
+		}
+	}
+	if _, ok := help["p"]; ok {
+		t.Fatalf("help still names the retired p: %v", help)
+	}
+}
