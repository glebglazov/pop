+// flatVerbKind is itemVerbKind with a container verb under `I`, whose Perform
+// reports what it ran on, so the row list's I and the detail's I can be compared.
+type flatVerbKind struct {
+	itemVerbKind
+	ran []string
+}
+
+func (k *flatVerbKind) Actions(work.Container) []work.Action {
+	return []work.Action{{Verb: "poke", Key: "I", Label: "poke"}}
+}
+
+func (k *flatVerbKind) Perform(c work.Container, item *work.Item, verb work.Verb) (work.Outcome, error) {
+	if item == nil && verb == "poke" {
+		k.ran = append(k.ran, c.ID)
+		return work.Outcome{Kind: work.OutcomeMessage, Message: "poked " + c.ID}, nil
+	}
+	return k.itemVerbKind.Perform(c, item, verb)
+}
+
+func pressKey(t *testing.T, m QueueDashboard, key string) (QueueDashboard, tea.Cmd) {
+	t.Helper()
+	msg := tea.KeyPressMsg{Code: []rune(key)[0], Text: key}
+	switch key {
+	case "esc":
+		msg = tea.KeyPressMsg{Code: tea.KeyEscape}
+	case "enter":
+		msg = tea.KeyPressMsg{Code: tea.KeyEnter}
+	}
+	updated, cmd := m.Update(msg)
+	return updated.(QueueDashboard), cmd
+}
+
+// TestDetailOpenersActOnTheContainer covers ADR-0261 decisions 1 and 2 on a
+// Task set: s, y and m open that set's own Status, Copy and Mute menus with the
+// entries its row opens, as the detail's reserved block; esc closes the menu and
+// leaves the detail standing; r is still the cursored task's menu.
+func TestDetailOpenersActOnTheContainer(t *testing.T) {
+	task := tasks.Task{ID: "01-a", File: "01-a.md", Status: "open"}
+	base := detailCopyModel("my-set", task)
+	row := base.detail.row
+
+	entries := func(m QueueDashboard) []string {
+		var keys []string
+		switch {
+		case m.menu == nil:
+		case m.menu.status != nil:
+			for _, a := range m.menu.status.list.Items() {
+				keys = append(keys, a.Key)
+			}
+		case m.menu.copy != nil:
+			for _, a := range m.menu.copy.list.Items() {
+				keys = append(keys, a.Key)
+			}
+		case m.menu.mute != nil:
+			for _, e := range m.menu.mute.list.Items() {
+				keys = append(keys, e.key)
+			}
+		}
+		return keys
+	}
+
+	for _, tc := range []struct{ key, noun string }{{"s", "status"}, {"y", "copy"}, {"m", "mute"}} {
+		t.Run(tc.key, func(t *testing.T) {
+			// The row list's own answer to the key over the same container.
+			rowList := base
+			rowList.detail = nil
+			rowList, _ = pressKey(t, rowList, tc.key)
+			want := entries(rowList)
+			if len(want) == 0 {
+				t.Fatalf("row list %s opened no menu over %s", tc.key, row.ID)
+			}
+
+			m, cmd := pressKey(t, base, tc.key)
+			if cmd != nil {
+				t.Fatalf("%s scheduled a command, want a menu", tc.key)
+			}
+			if m.menu == nil || m.menu.row.ID != row.ID || m.menu.plural {
+				t.Fatalf("%s did not open a singular menu over %s: %+v", tc.key, row.ID, m.menu)
+			}
+			if got := entries(m); !slices.Equal(got, want) {
+				t.Fatalf("detail %s menu = %v, want the row's %v", tc.key, got, want)
+			}
+			view := m.View().Content
+			if !strings.Contains(view, tc.noun+" · "+row.ID) || !strings.Contains(view, "01-a") {
+				t.Fatalf("%s menu is not the detail's block over the item list:\n%s", tc.key, view)
+			}
+
+			m, _ = pressKey(t, m, "esc")
+			if m.menu != nil || m.detail == nil {
+				t.Fatalf("esc left menu=%v detail=%v, want the detail standing", m.menu, m.detail)
+			}
+		})
+	}
+
+	m, _ := pressKey(t, base, "r")
+	if m.menu != nil || m.itemMenu == nil || m.itemMenu.item.ID != "01-a" {
+		t.Fatalf("r did not open the cursored task's own menu: menu=%v item=%v", m.menu, m.itemMenu)
+	}
+}
