+
+			lines := strings.Split(m.View().Content, "\n")
+			ruleAt := dashboardTestLineIndex(lines, tc.noun+" · thing")
+			if want := len(lines) - 1 - len(want); ruleAt != want {
+				t.Fatalf("%s menu rule at line %d, want %d so the block ends above the hint line:\n%s", tc.noun, ruleAt, want, strings.Join(lines, "\n"))
+			}
+			if !strings.Contains(m.View().Content, "First") {
+				t.Fatal("the detail's item list left the screen under its menu")
+			}
+
+			m = pressKeys(t, m, "esc")
+			if m.menu != nil || m.detail == nil {
+				t.Fatalf("esc: menu %+v, detail open %v; want the menu closed over a standing detail", m.menu, m.detail != nil)
+			}
+		})
+	}
+}
+
+// TestDetailContainerMenusDispatchTheRowsVerbs covers the other half of the same
+// menus: an entry dispatches the row's own verb over the container, and its
+// report is visible in the detail it was run from.
+func TestDetailContainerMenusDispatchTheRowsVerbs(t *testing.T) {
+	kind := &containerVerbKind{itemVerbKind: &itemVerbKind{}}
+	m := openGenericDetail(t, genericDetailDashboard(kind))
+	var copied string
+	m.copyFunc = func(s string) error { copied = s; return nil }
+
+	m = pressKeys(t, m, "s", "x")
+	if !reflect.DeepEqual(kind.performed, []string{"thing:shelve"}) {
+		t.Fatalf("performed %v, want the status verb over the container", kind.performed)
+	}
+	if m.detail == nil || !strings.Contains(m.View().Content, "shelve thing") {
+		t.Fatalf("status verb report missing from the detail:\n%s", m.View().Content)
+	}
+
+	m = pressKeys(t, m, "y", "n")
+	if copied != "thing" || !strings.Contains(m.View().Content, "copied thing") {
+		t.Fatalf("copy menu copied %q; view:\n%s", copied, m.View().Content)
+	}
+
+	m = pressKeys(t, m, "m", "1")
+	if !strings.Contains(m.View().Content, "muted thing") {
+		t.Fatalf("mute report missing from the detail:\n%s", m.View().Content)
+	}
+}
+
+// TestDetailOpenersRefuseAsTheRowListDoes covers a kind that offers nothing: the
+// detail flashes the refusal the row list flashes, where the reader can see it.
+func TestDetailOpenersRefuseAsTheRowListDoes(t *testing.T) {
+	for _, key := range []string{"s", "y", "m"} {
+		above := pressKeys(t, genericDetailDashboard(&itemVerbKind{}), key)
+		refusal := above.flash.Text()
+		if refusal == "" || above.menu != nil {
+			t.Fatalf("%s on the row list: flash %q, menu %+v; want a refusal", key, refusal, above.menu)
+		}
+		m := pressKeys(t, openGenericDetail(t, genericDetailDashboard(&itemVerbKind{})), key)
+		if m.menu != nil {
+			t.Fatalf("%s in the detail opened a menu over a kind that offers none", key)
+		}
+		if view := m.View().Content; !strings.Contains(view, refusal) {
+			t.Fatalf("%s in the detail did not flash %q:\n%s", key, refusal, view)
+		}
+	}
+}
+
+// TestDetailMenuIgnoresTheRowListSelection pins that a Selection is a row-list
+// concept: marks made above do not turn a detail-opened menu plural, and they do
+// not refuse the container's own flat verb.
+func TestDetailMenuIgnoresTheRowListSelection(t *testing.T) {
+	kind := &containerVerbKind{itemVerbKind: &itemVerbKind{}}
+	m := genericDetailDashboard(kind)
+	m.toggleSelected()
+	if !m.selection.Active() {
+		t.Fatal("tab did not mark the row")
+	}
+	row, _ := m.rowByCursorKey("pop\x00thing")
+	m.detail = m.openDetailView(row)
+
+	got := pressKeys(t, m, "s")
+	if got.menu == nil || got.menu.plural || got.menu.pluralCount() != 0 {
+		t.Fatalf("detail status menu = %+v, want a singular menu over the container", got.menu)
+	}
+	got = pressKeys(t, m, "I")
+	if !reflect.DeepEqual(kind.performed, []string{"thing:poke"}) {
+		t.Fatalf("I under a Selection performed %v, want the container's own verb", kind.performed)
+	}
+}
+
+// TestDetailIRunsTheContainersFlatVerb pins ADR-0261 decision 4: `I` in a detail
+// runs the verb `I` runs over the row, through the same dispatch.
+func TestDetailIRunsTheContainersFlatVerb(t *testing.T) {
+	kind := &containerVerbKind{itemVerbKind: &itemVerbKind{}}
+	pressKeys(t, genericDetailDashboard(kind), "I")
+	m := pressKeys(t, openGenericDetail(t, genericDetailDashboard(kind)), "I")
+	if !reflect.DeepEqual(kind.performed, []string{"thing:poke", "thing:poke"}) {
+		t.Fatalf("performed %v, want the row's I verb from both levels", kind.performed)
+	}
+	if m.detail == nil || !strings.Contains(m.View().Content, "poke thing") {
+		t.Fatalf("I report missing from the detail:\n%s", m.View().Content)
+	}
+}
+
+// TestDetailHintAndHelpNameTheOpeners covers the discoverability half: the hint
+// line leads with the four openers in the row list's wording, and the help
+// overlay names them with the container's I verb and the search.
+func TestDetailHintAndHelpNameTheOpeners(t *testing.T) {
+	m := openGenericDetail(t, genericDetailDashboard(&containerVerbKind{itemVerbKind: &itemVerbKind{}}))
+	if view := m.View().Content; !strings.Contains(view, "r run ▸ · s status ▸ · y copy ▸ · m mute ▸") {
+		t.Fatalf("detail hint line does not name the four openers:\n%s", view)
+	}
+	help := map[string]string{}
+	for _, entry := range m.helpEntries() {
+		help[entry.Key] = entry.Desc
+	}
+	for key, want := range map[string]string{"r": "item run menu", "s": "status menu", "y": "copy menu", "m": "mute menu", "I": "poke it", "/": "search"} {
+		if help[key] != want {
+			t.Fatalf("help %s = %q, want %q (all: %v)", key, help[key], want, help)
+		}
+	}
+	if _, ok := help["p"]; ok {
+		t.Fatal("help still advertises the retired p copy-path key")
+	}
+}
+
+// searchDetailRow is a container whose items differ in id, title, type and status,
+// so a test can tell which field a term matched.
+func searchDetailRow() DashboardRow {
+	row := genericDetailRow()
+	row.DetailSections = nil
+	row.Items = []work.Item{
+		{ID: "01-parser", Title: "Build the parser", Type: "AFK", Status: "open"},
+		{ID: "02-docs", Title: "Write docs", Type: "HITL", Status: "done"},
+		{ID: "03-tests", Title: "Parser tests", Type: "AFK", Status: "done"},
+	}
+	return row
+}
+
+func detailItemIDs(m QueueDashboard) []string {
+	var ids []string
+	for _, item := range m.detail.list.Items() {
+		ids = append(ids, item.ID)
+	}
+	return ids
+}
+
+func openSearchDetail(t *testing.T) QueueDashboard {
+	t.Helper()
+	d := &drain.Deps{Kinds: func(*drain.Deps, *config.Config) []work.Kind { return []work.Kind{&itemVerbKind{}} }}
+	m := newQueueDashboard(d, &config.Config{}, DashboardSnapshot{Containers: []DashboardRow{searchDetailRow()}})
+	m.width, m.height = 120, 24
+	return openGenericDetail(t, m)
+}
+
+// TestDetailSearchNarrowsItems pins ADR-0261 decision 5's grammar: terms are
+// case-insensitive substrings, AND-ed across an item's id, title and type, and
+// status is not among the fields.
+func TestDetailSearchNarrowsItems(t *testing.T) {
+	for _, tc := range []struct {
+		query string
+		want  []string
+	}{
+		{"PARSER", []string{"01-parser", "03-tests"}},
+		{"parser afk", []string{"01-parser", "03-tests"}},
+		{"hitl docs", []string{"02-docs"}},
+		{"build tests", nil},
+		{"done", nil},
+	} {
+		m := typeSearch(openSearchDetail(t), tc.query, true)
+		if got := detailItemIDs(m); !reflect.DeepEqual(got, tc.want) {
+			t.Fatalf("search %q = %v, want %v", tc.query, got, tc.want)
+		}
+		if m.detail.searchTyping {
+			t.Fatalf("enter did not apply %q", tc.query)
+		}
+	}
+}
+
+// TestDetailSearchTypingKeepsEveryKeyAsText covers the typing phase: j, k, v
+// and r type rather than move, toggle or open a menu, and Enter returns the full
+// keymap over the narrowed list.
+func TestDetailSearchTypingKeepsEveryKeyAsText(t *testing.T) {
+	m := typeSearch(openSearchDetail(t), "jkvr", false)
+	if !m.detail.searchTyping || m.detail.searchInput.Value() != "jkvr" {
+		t.Fatalf("typing phase buffer = %q (typing %v), want jkvr", m.detail.searchInput.Value(), m.detail.searchTyping)
+	}
+	if m.itemMenu != nil || m.detail.artifacts || m.detail.list.Cursor() != 0 {
+		t.Fatal("a key typed into the search acted on the detail")
+	}
+	if view := m.View().Content; !strings.Contains(view, "enter apply search · esc cancel · C-h help") {
+		t.Fatalf("typing hint missing:\n%s", view)
+	}
+
+	m = typeSearch(openSearchDetail(t), "afk", true)
+	m = pressKeys(t, m, "j")
+	if item, _ := m.detail.list.Selected(); item.ID != "03-tests" {
+		t.Fatalf("j after applying moved to %q, want 03-tests", item.ID)
+	}
+	if m = pressKeys(t, m, "r"); m.itemMenu == nil || m.itemMenu.item.ID != "03-tests" {
+		t.Fatal("r after applying did not open the narrowed item's menu")
+	}
+}
+
+// TestDetailSearchEscRestoresAndEmptyClears covers the edit's two exits: Esc puts
+// back the term in force, and reopening `/` then applying the empty buffer clears
+// the search.
+func TestDetailSearchEscRestoresAndEmptyClears(t *testing.T) {
+	m := typeSearch(openSearchDetail(t), "docs", true)
+	m = typeSearch(m, "parser", false)
+	m = pressKeys(t, m, "esc")
+	if m.detail == nil || m.detail.searchTerm != "docs" || !reflect.DeepEqual(detailItemIDs(m), []string{"02-docs"}) {
+		t.Fatalf("esc left term %q over %v, want docs restored", m.detail.searchTerm, detailItemIDs(m))
+	}
+	m = typeSearch(m, "", true)
+	if m.detail.searchTerm != "" || len(detailItemIDs(m)) != 3 {
+		t.Fatalf("empty apply left term %q over %v, want every item", m.detail.searchTerm, detailItemIDs(m))
+	}
+}
+
+// TestDetailSearchSurvivesThePollAndIsVisible covers the term's lifetime and
+// visibility: the rebuild that re-feeds the detail keeps the narrowing, the
+// header names the term, and a query that matches nothing says so and how to
+// clear it.
+func TestDetailSearchSurvivesThePollAndIsVisible(t *testing.T) {
+	m := typeSearch(openSearchDetail(t), "afk", true)
+	refreshed := searchDetailRow()
+	refreshed.Items = append(refreshed.Items, work.Item{ID: "04-lexer", Title: "Lexer", Type: "AFK", Status: "open"})
+	updated, _ := m.Update(dashboardRowsMsg{snap: DashboardSnapshot{Containers: []DashboardRow{refreshed}}})
+	m = updated.(QueueDashboard)
+	if got := detailItemIDs(m); !reflect.DeepEqual(got, []string{"01-parser", "03-tests", "04-lexer"}) {
+		t.Fatalf("after the poll items = %v, want the rebuilt container narrowed by afk", got)
+	}
+	if view := m.View().Content; !strings.Contains(view, "search: afk") {
+		t.Fatalf("applied term not visible:\n%s", view)
+	}
+
+	m = typeSearch(m, "nothing-here", true)
+	if view := m.View().Content; !strings.Contains(view, `No items match search "nothing-here" — / then enter to clear.`) {
+		t.Fatalf("empty search state missing:\n%s", view)
+	}
+}
+
+// TestDetailSearchIsNotTheRowListsSearch pins that the two searches keep their
+// own buffer and term: narrowing a detail leaves the rows behind it whole, and a
+// row-list term does not narrow the detail.
+func TestDetailSearchIsNotTheRowListsSearch(t *testing.T) {
+	m := typeSearch(openSearchDetail(t), "docs", true)
+	if m.searchTerm != "" || m.searchTyping {
+		t.Fatalf("detail search wrote the row list's term %q", m.searchTerm)
+	}
+	m = pressKeys(t, m, "esc")
+	if m.detail != nil || len(m.snap.Containers) != 1 {
+		t.Fatal("the row list behind the detail was narrowed")
+	}
+	m = typeSearch(m, "thing", true)
+	m = openGenericDetail(t, m)
+	if m.detail.searchTerm != "" || len(detailItemIDs(m)) != 3 {
+		t.Fatalf("row-list term narrowed the detail: term %q items %v", m.detail.searchTerm, detailItemIDs(m))
+	}
+}
