+// TestDetailIRunsTheContainersFlatVerb covers ADR-0261 decision 4: I in a detail
+// runs the verb the row list's I runs, over the same container, and its report
+// is shown in the detail.
+func TestDetailIRunsTheContainersFlatVerb(t *testing.T) {
+	kind := &flatVerbKind{}
+	m := genericDetailDashboard(kind)
+
+	// update rather than Update: the latter batches the flash timer in with the
+	// verb's own command.
+	I := tea.KeyPressMsg{Code: 'I', Text: "I"}
+	rowList, cmd := m.update(I)
+	if cmd == nil {
+		t.Fatal("row list I dispatched nothing")
+	}
+	rowList.(QueueDashboard).update(cmd())
+
+	m, _ = pressKey(t, m, "l")
+	updated, cmd := m.update(I)
+	if cmd == nil {
+		t.Fatal("detail I dispatched nothing")
+	}
+	updated, _ = updated.(QueueDashboard).update(cmd())
+	m = updated.(QueueDashboard)
+	if !slices.Equal(kind.ran, []string{"thing", "thing"}) {
+		t.Fatalf("I ran on %v, want the container from both levels", kind.ran)
+	}
+	if view := m.View().Content; m.detail == nil || !strings.Contains(view, "poked thing") {
+		t.Fatalf("detail does not show the container verb's report:\n%s", view)
+	}
+}
