+// TestDetailSearchNarrowsTheItemList covers ADR-0261 decision 5: `/` narrows the
+// items by id, title and type with the row list's grammar, never by status, and
+// Enter gives the whole keymap back over the narrowed list with the term shown.
+func TestDetailSearchNarrowsTheItemList(t *testing.T) {
+	base := genericDetailDashboard(&itemVerbKind{})
+	base, _ = pressKey(t, base, "l")
+
+	for _, tc := range []struct {
+		query string
+		want  []string
+	}{
+		{"FIRST", []string{"01"}},
+		{"02", []string{"02"}},
+		{"afk", []string{"01", "02"}},
+		{"afk sec", []string{"02"}},
+		{"first sec", nil},
+		{"open", nil},
+	} {
+		m, _ := pressKey(t, base, "/")
+		m = typeText(t, m, tc.query)
+		m, _ = pressKey(t, m, "enter")
+		if got := detailItemIDs(m); !slices.Equal(got, tc.want) {
+			t.Fatalf("search %q kept %v, want %v", tc.query, got, tc.want)
+		}
+		view := m.View().Content
+		if !strings.Contains(view, "search: "+tc.query) {
+			t.Fatalf("search %q is not shown while in force:\n%s", tc.query, view)
+		}
+		if tc.want == nil && !strings.Contains(view, `No items match search "`+tc.query+`" — / then enter to clear.`) {
+			t.Fatalf("empty search %q does not say what emptied the list:\n%s", tc.query, view)
+		}
+	}
+
+	// Enter returns the keymap: r opens the surviving item's own menu.
+	m, _ := pressKey(t, base, "/")
+	m = typeText(t, m, "sec")
+	m, _ = pressKey(t, m, "enter")
+	m, _ = pressKey(t, m, "r")
+	if m.itemMenu == nil || m.itemMenu.item.ID != "02" {
+		t.Fatalf("r after the search did not open 02's menu: %+v", m.itemMenu)
+	}
+}
