+// TestDetailSearchTypingOwnsTheKeyboard covers the typing phase: every key but
+// Enter, Esc and ctrl+c is a character, Esc restores the term in force, and an
+// applied empty query clears it.
+func TestDetailSearchTypingOwnsTheKeyboard(t *testing.T) {
+	m := genericDetailDashboard(&itemVerbKind{})
+	m, _ = pressKey(t, m, "l")
+	m, _ = pressKey(t, m, "/")
+	m = typeText(t, m, "sec")
+	m, _ = pressKey(t, m, "enter")
+
+	m, _ = pressKey(t, m, "/")
+	if got := detailItemIDs(m); !slices.Equal(got, []string{"01", "02"}) {
+		t.Fatalf("reopening / kept %v, want every item for an empty buffer", got)
+	}
+	m = typeText(t, m, "jkvrsym")
+	if m.detail == nil || !m.detail.searchTyping || m.menu != nil || m.itemMenu != nil || m.detail.artifacts {
+		t.Fatalf("a letter acted while typing: detail=%+v menu=%v item=%v", m.detail, m.menu, m.itemMenu)
+	}
+	if got := m.detail.searchInput.Value(); got != "jkvrsym" {
+		t.Fatalf("typed buffer = %q, want every letter", got)
+	}
+	m, _ = pressKey(t, m, "esc")
+	if m.detail == nil || m.detail.searchTyping || m.detail.searchTerm != "sec" {
+		t.Fatalf("esc did not restore the term in force: %+v", m.detail)
+	}
+	if got := detailItemIDs(m); !slices.Equal(got, []string{"02"}) {
+		t.Fatalf("after esc the list holds %v, want the applied term's 02", got)
+	}
+
+	m, _ = pressKey(t, m, "/")
+	m, _ = pressKey(t, m, "enter")
+	if m.detail.searchTerm != "" || !slices.Equal(detailItemIDs(m), []string{"01", "02"}) {
+		t.Fatalf("applying an empty query left term %q over %v", m.detail.searchTerm, detailItemIDs(m))
+	}
+	if strings.Contains(m.View().Content, "search:") {
+		t.Fatalf("a cleared search is still shown:\n%s", m.View().Content)
+	}
+}
