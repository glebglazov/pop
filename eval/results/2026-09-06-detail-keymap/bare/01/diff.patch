+// TestDetailSearchSurvivesThePollAndKeepsItsOwnTerm covers the term's lifetime:
+// a poll rebuilding the detail keeps it narrowed, and the row list's search and
+// the detail's never share a term.
+func TestDetailSearchSurvivesThePollAndKeepsItsOwnTerm(t *testing.T) {
+	m := genericDetailDashboard(&itemVerbKind{})
+	m, _ = pressKey(t, m, "/")
+	m = typeText(t, m, "thing")
+	m, _ = pressKey(t, m, "enter")
+	m, _ = pressKey(t, m, "l")
+	if m.detail == nil || m.detail.searchTerm != "" || len(detailItemIDs(m)) != 2 {
+		t.Fatalf("the row list's term reached the detail: %+v", m.detail)
+	}
+
+	m, _ = pressKey(t, m, "/")
+	m = typeText(t, m, "first")
+	m, _ = pressKey(t, m, "enter")
+	if m.searchTerm != "thing" {
+		t.Fatalf("the detail's search changed the row list's term to %q", m.searchTerm)
+	}
+
+	refreshed := genericDetailRow()
+	refreshed.Items = append(refreshed.Items, work.Item{ID: "03", Title: "First again", Type: "HITL", Status: "open"})
+	updated, _ := m.Update(dashboardRowsMsg{snap: DashboardSnapshot{Containers: []DashboardRow{refreshed}}})
+	m = updated.(QueueDashboard)
+	if got := detailItemIDs(m); !slices.Equal(got, []string{"01", "03"}) {
+		t.Fatalf("after the poll the list holds %v, want the term applied to the rebuilt items", got)
+	}
+	if !strings.Contains(m.View().Content, "search: first") {
+		t.Fatalf("the term is not shown after the poll:\n%s", m.View().Content)
+	}
+}
