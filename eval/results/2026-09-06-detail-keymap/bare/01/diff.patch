+// TestDetailOpenersRefuseAsTheRowListDoes covers a kind with no status, nothing
+// to copy and no mute: each opener flashes from the detail the refusal it
+// flashes from the row list, and opens nothing.
+func TestDetailOpenersRefuseAsTheRowListDoes(t *testing.T) {
+	base := genericDetailDashboard(&itemVerbKind{})
+	for _, key := range []string{"s", "y", "m"} {
+		rowList, _ := pressKey(t, base, key)
+		want := rowList.flash.Text()
+		if want == "" || rowList.menu != nil {
+			t.Fatalf("row list %s did not refuse: flash=%q menu=%v", key, want, rowList.menu)
+		}
+
+		m, _ := pressKey(t, base, "l")
+		m, _ = pressKey(t, m, key)
+		if m.menu != nil {
+			t.Fatalf("detail %s opened a menu over a kind that offers nothing", key)
+		}
+		if view := m.View().Content; !strings.Contains(view, want) {
+			t.Fatalf("detail %s does not show the row list's refusal %q:\n%s", key, want, view)
+		}
+	}
+}
