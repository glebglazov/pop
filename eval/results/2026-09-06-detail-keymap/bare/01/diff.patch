+// containerVerbKind is itemVerbKind with a container vocabulary: a flat `I` verb,
+// one status verb, one copy entry and a mute, so the detail's openers have
+// something of the container's to open. It records what it performed.
+type containerVerbKind struct {
+	*itemVerbKind
+	performed []string
+}
+
+func (k *containerVerbKind) Actions(work.Container) []work.Action {
+	return []work.Action{{Verb: work.Verb("poke"), Key: "I", Label: "poke it"}}
+}
+func (k *containerVerbKind) StatusActions(work.Container) []work.Action {
+	return []work.Action{{Verb: work.Verb("shelve"), Key: "x", Label: "shelve"}}
+}
+func (k *containerVerbKind) CopyActions(work.Container) []work.Action {
+	return []work.Action{{Verb: work.VerbCopyName, Key: "n", Label: "copy name"}}
+}
+func (k *containerVerbKind) Perform(c work.Container, item *work.Item, verb work.Verb) (work.Outcome, error) {
+	if item != nil {
+		return k.itemVerbKind.Perform(c, item, verb)
+	}
+	k.performed = append(k.performed, c.ID+":"+string(verb))
+	return work.Outcome{Kind: work.OutcomeMessage, Message: string(verb) + " " + c.ID}, nil
+}
+func (k *containerVerbKind) Mute(c work.Container, _ time.Time, _ bool) (work.Outcome, error) {
+	return work.Outcome{Kind: work.OutcomeMessage, Message: "muted " + c.ID}, nil
+}
+func (k *containerVerbKind) Unmute(c work.Container) (work.Outcome, error) {
+	return work.Outcome{Kind: work.OutcomeMessage, Message: "unmuted " + c.ID}, nil
+}
