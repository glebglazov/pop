+
+// The detail view answers to the row list's keyboard over the container it is
+// open on (ADR-0261): `s`, `y` and `m` open that container's menus, `I` runs its
+// flat verb, `r` stays the item's, and `/` narrows its own list.
+
+// openRowDetail opens the detail over the row with id from the row list, the
+// way a human does.
+func openRowDetail(t *testing.T, m QueueDashboard, id string) QueueDashboard {
+	t.Helper()
+	target := slices.Index(selIDs(m), id)
+	if target < 0 {
+		t.Fatalf("row %q is not on the list: %v", id, selIDs(m))
+	}
+	m.list.SetCursor(target)
+	m = selPress(t, m, selKeyRune('l'))
+	if m.detail == nil || m.detail.row.ID != id {
+		t.Fatalf("l did not open the detail over %q", id)
+	}
+	return m
+}
+
+func actionKeys(actions []work.Action) []string {
+	keys := make([]string, 0, len(actions))
+	for _, action := range actions {
+		keys = append(keys, action.Key)
+	}
+	return keys
+}
+
+func TestDetailOpenersOpenTheContainersOwnMenus(t *testing.T) {
+	cases := []struct {
+		key  rune
+		noun string
+		keys func(m QueueDashboard) []string
+		want func(m QueueDashboard, row DashboardRow) []string
+	}{
+		{'s', "status",
+			func(m QueueDashboard) []string { return actionKeys(m.menu.status.list.Items()) },
+			func(m QueueDashboard, row DashboardRow) []string { return actionKeys(m.kinds.statusActionsFor(row)) }},
+		{'y', "copy",
+			func(m QueueDashboard) []string { return actionKeys(m.menu.copy.list.Items()) },
+			func(m QueueDashboard, row DashboardRow) []string { return actionKeys(m.kinds.copyActionsFor(row)) }},
+		{'m', "mute",
+			func(m QueueDashboard) []string {
+				var keys []string
+				for _, entry := range m.menu.mute.list.Items() {
+					keys = append(keys, entry.key)
+				}
+				return keys
+			},
+			nil},
+	}
+	for _, tc := range cases {
+		t.Run(tc.noun, func(t *testing.T) {
+			m := openRowDetail(t, selDashboard(selRows("a", "b")), "b")
+
+			// The row list opens the same menu over the same container.
+			fromRow := selDashboard(selRows("a", "b"))
+			fromRow.list.SetCursor(1)
+			fromRow = selPress(t, fromRow, selKeyRune(tc.key))
+			if fromRow.menu == nil {
+				t.Fatalf("%c on the row did not open a menu", tc.key)
+			}
+
+			m = selPress(t, m, selKeyRune(tc.key))
+			if m.menu == nil || m.menu.row.ID != "b" || m.menu.plural {
+				t.Fatalf("%c in the detail opened %+v, want a singular menu over b", tc.key, m.menu)
+			}
+			if got, want := tc.keys(m), tc.keys(fromRow); !slices.Equal(got, want) || len(got) == 0 {
+				t.Fatalf("%c in the detail lists %v, want the row's %v", tc.key, got, want)
+			}
+			if tc.want != nil && !slices.Equal(tc.keys(m), tc.want(m, m.detail.row)) {
+				t.Fatalf("%c menu is not the kind's own list", tc.key)
+			}
+
+			// It renders as the detail's reserved block, above the detail's hints.
+			view := ui.StripANSI(m.View().Content)
+			if !strings.Contains(view, tc.noun+" · b") || !strings.Contains(view, "Task · b") {
+				t.Fatalf("detail view does not show the %s menu over b:\n%s", tc.noun, view)
+			}
+			if frame, _ := m.detailFrame(); len(frame.Block) != blockLines(t, m) {
+				t.Fatalf("detail frame reserves %d block lines, want the menu's %d", len(frame.Block), blockLines(t, m))
+			}
+
+			// esc closes the menu and leaves the detail standing.
+			m = selPress(t, m, selKeyEsc())
+			if m.menu != nil || m.detail == nil {
+				t.Fatalf("esc: menu=%v detail=%v, want the menu closed over a standing detail", m.menu, m.detail)
+			}
+		})
+	}
+}
+
+// TestDetailMenuIgnoresTheRowListsSelection pins that a Selection marked on the
+// row list does not make a menu opened from a detail plural: the detail acts on
+// its one container.
+func TestDetailMenuIgnoresTheRowListsSelection(t *testing.T) {
+	m := selDashboard(selRows("a", "b", "c"))
+	m = markRow(t, m, "a")
+	m = markRow(t, m, "c")
+	if !m.selection.Active() {
+		t.Fatal("setup: no Selection")
+	}
+	row, _ := m.rowByCursorKey(m.allRows[1].CursorKey)
+	m.detail = m.openDetailView(row)
+
+	for _, key := range []rune{'s', 'y', 'm'} {
+		got := selPress(t, m, selKeyRune(key))
+		if got.menu == nil || got.menu.plural || got.menu.row.ID != "b" {
+			t.Fatalf("%c with a Selection opened %+v, want a singular menu over b", key, got.menu)
+		}
+	}
+}
+
+// TestDetailOpenersRefuseLikeTheRowList pins the flash a kind with nothing to
+// offer answers with: the same words as from the row, shown in the detail.
+func TestDetailOpenersRefuseLikeTheRowList(t *testing.T) {
+	for _, tc := range []struct {
+		key  rune
+		want string
+	}{
+		{'s', "a Task has no status to write"},
+		{'y', "a Task has nothing to copy"},
+		{'m', "a Task cannot be muted"},
+	} {
+		fromRow := selPress(t, genericDetailDashboard(&itemVerbKind{}), selKeyRune(tc.key))
+		if fromRow.flash.Text() != tc.want {
+			t.Fatalf("%c on the row flashed %q, want %q", tc.key, fromRow.flash.Text(), tc.want)
+		}
+
+		m := selPress(t, genericDetailDashboard(&itemVerbKind{}), selKeyRune('l'))
+		m = selPress(t, m, selKeyRune(tc.key))
+		if m.menu != nil {
+			t.Fatalf("%c opened an empty menu", tc.key)
+		}
+		if view := ui.StripANSI(m.View().Content); !strings.Contains(view, tc.want) {
+			t.Fatalf("%c in the detail did not flash %q:\n%s", tc.key, tc.want, view)
+		}
+	}
+}
+
+// TestDetailIRunsTheContainersFlatVerb pins `I` in the detail: the verb the row
+// list's `I` runs over the same container.
+func TestDetailIRunsTheContainersFlatVerb(t *testing.T) {
+	spy := &verbSpyKind{Kind: routine.NewKind(nil)}
+	kinds := func(*drain.Deps, *config.Config) []work.Kind { return []work.Kind{spy} }
+	m := openPage(t, &drain.Deps{Kinds: kinds, RoutineKinds: kinds}, PageRoutines)
+
+	m = pressKeys(t, m, "l", "I")
+	if m.detail == nil {
+		t.Fatal("I closed the detail")
+	}
+	if fmt.Sprint(spy.performed) != fmt.Sprint([]work.Verb{routine.VerbFire}) {
+		t.Fatalf("I in the detail performed %v, want the kind's own fire verb", spy.performed)
+	}
+}
+
+// TestDetailHintAndHelpNameTheFourOpeners pins the discoverability half: the
+// hint line and the help overlay both name r, s, y and m, and neither names a
+// flat copy.
+func TestDetailHintAndHelpNameTheFourOpeners(t *testing.T) {
+	m := openRowDetail(t, selDashboard(selRows("a")), "a")
+	view := ui.StripANSI(m.View().Content)
+	if !strings.Contains(view, "r run ▸ · s status ▸ · y copy ▸ · m mute ▸") {
+		t.Fatalf("detail hint does not name the four openers:\n%s", view)
+	}
+	help := map[string]string{}
+	for _, entry := range m.helpEntries() {
+		help[entry.Key] = entry.Desc
+	}
+	for key, want := range map[string]string{"r": "item run menu", "s": "status menu", "y": "copy menu", "m": "mute menu", "/": "search"} {
+		if help[key] != want {
+			t.Fatalf("help %s = %q, want %q (all: %v)", key, help[key], want, help)
+		}
+	}
+	if _, ok := help["p"]; ok {
+		t.Fatal("help still lists the retired p copy path")
+	}
+}
+
+// searchDetailRow is a container whose items differ by id, title, type and
+// status, so each field's part in the search can be told apart.
+func searchDetailRow() DashboardRow {
+	row := genericDetailRow()
+	row.Items = []work.Item{
+		{ID: "01-wire", Title: "Wire the Parser", Type: "AFK", Status: "open"},
+		{ID: "02-render", Title: "Render header", Type: "HITL", Status: "done"},
+		{ID: "03-docs", Title: "Parser docs", Type: "AFK", Status: "open"},
+	}
+	return row
+}
+
+func searchDetailDashboard(t *testing.T) QueueDashboard {
+	t.Helper()
+	d := &drain.Deps{Kinds: func(*drain.Deps, *config.Config) []work.Kind { return []work.Kind{&itemVerbKind{}} }}
+	m := newQueueDashboard(d, &config.Config{}, DashboardSnapshot{Containers: []DashboardRow{searchDetailRow()}})
+	m.width, m.height = 120, 30
+	return selPress(t, m, selKeyRune('l'))
+}
+
+// typeKeys feeds every rune of text as a keypress.
+func typeKeys(t *testing.T, m QueueDashboard, text string) QueueDashboard {
+	t.Helper()
+	for _, r := range text {
+		m = selPress(t, m, selKeyRune(r))
+	}
+	return m
+}
+
+func detailItemIDs(m QueueDashboard) []string {
+	var ids []string
+	for _, item := range m.detail.list.Items() {
+		ids = append(ids, item.ID)
+	}
+	return ids
+}
+
+func searchDetail(t *testing.T, m QueueDashboard, query string) QueueDashboard {
+	t.Helper()
+	m = typeKeys(t, selPress(t, m, selKeyRune('/')), query)
+	return selPress(t, m, tea.KeyPressMsg{Code: tea.KeyEnter})
+}
+
+func TestDetailSearchNarrowsByIDTitleAndType(t *testing.T) {
+	for _, tc := range []struct {
+		query string
+		want  []string
+	}{
+		{"PARSER", []string{"01-wire", "03-docs"}},
+		{"afk wire", []string{"01-wire"}},
+		{"hitl", []string{"02-render"}},
+		{"03", []string{"03-docs"}},
+		{"parser hitl", nil},
+		// Status is not searched: "done" names only 02's status.
+		{"done", nil},
+	} {
+		m := searchDetail(t, searchDetailDashboard(t), tc.query)
+		if got := detailItemIDs(m); !slices.Equal(got, tc.want) {
+			t.Fatalf("search %q left %v, want %v", tc.query, got, tc.want)
+		}
+		if m.detail.searchTyping {
+			t.Fatal("enter did not apply the search")
+		}
+		if m.searchTerm != "" {
+			t.Fatalf("detail search wrote the row list's term %q", m.searchTerm)
+		}
+	}
+}
+
+func TestDetailSearchTypingTakesEveryKeyAsText(t *testing.T) {
+	m := selPress(t, searchDetailDashboard(t), selKeyRune('/'))
+	m = typeKeys(t, m, "jkvrsym")
+	if m.detail.searchInput.Value() != "jkvrsym" {
+		t.Fatalf("typed buffer = %q, want every key as text", m.detail.searchInput.Value())
+	}
+	if m.detail.artifacts || m.menu != nil || m.itemMenu != nil || m.detail.peek != nil {
+		t.Fatal("a key typed into the search acted instead")
+	}
+	if m.searchInput.Value() != "" || m.searchTyping {
+		t.Fatal("the detail's typing reached the row list's search buffer")
+	}
+}
+
+func TestDetailSearchEscRestoresAndEmptyApplyClears(t *testing.T) {
+	m := searchDetail(t, searchDetailDashboard(t), "parser")
+
+	// Esc abandons an edit and puts back the term in force.
+	m = typeKeys(t, selPress(t, m, selKeyRune('/')), "render")
+	m = selPress(t, m, selKeyEsc())
+	if m.detail == nil || m.detail.searchTerm != "parser" || !slices.Equal(detailItemIDs(m), []string{"01-wire", "03-docs"}) {
+		t.Fatalf("esc left term %q over %v, want parser restored", m.detail.searchTerm, detailItemIDs(m))
+	}
+
+	// Reopening starts empty, so applying it untouched clears the search.
+	m = searchDetail(t, m, "")
+	if m.detail.searchTerm != "" || len(detailItemIDs(m)) != 3 {
+		t.Fatalf("empty apply left term %q over %v, want every item", m.detail.searchTerm, detailItemIDs(m))
+	}
+}
+
+func TestDetailSearchSurvivesThePollAndIsShown(t *testing.T) {
+	m := searchDetail(t, searchDetailDashboard(t), "parser")
+
+	rebuilt := searchDetailRow()
+	rebuilt.Items = append(rebuilt.Items, work.Item{ID: "04-more", Title: "More parser work", Type: "AFK", Status: "open"})
+	updated, _ := m.Update(dashboardRowsMsg{page: m.page.id, snap: DashboardSnapshot{Containers: []DashboardRow{rebuilt}}})
+	m = updated.(QueueDashboard)
+	if got := detailItemIDs(m); !slices.Equal(got, []string{"01-wire", "03-docs", "04-more"}) {
+		t.Fatalf("after the poll the detail shows %v, want the term still narrowing", got)
+	}
+	if view := ui.StripANSI(m.View().Content); !strings.Contains(view, "search: parser") {
+		t.Fatalf("the term in force is not on screen:\n%s", view)
+	}
+}
+
+func TestDetailSearchMatchingNothingSaysSo(t *testing.T) {
+	m := searchDetail(t, searchDetailDashboard(t), "zebra")
+	view := ui.StripANSI(m.View().Content)
+	if !strings.Contains(view, `No items match search "zebra" — / then enter to clear.`) {
+		t.Fatalf("empty search result does not name its term:\n%s", view)
+	}
+}
+
+func TestDetailSearchNarrowsTheArtifactList(t *testing.T) {
+	kind := &artifactDetailKind{id: ref.KindTaskSet, artifacts: []work.Artifact{
+		{Type: "refine", Name: "refine-20260817T120000Z.md", Path: "/r/refine-20260817T120000Z.md"},
+		{Type: "verify", Name: "verify-20260818T120000Z.md", Path: "/r/verify-20260818T120000Z.md"},
+	}}
+	m := openArtifactDetail(t, artifactDetailDashboard(kind, genericDetailRow()))
+	m = selPress(t, m, selKeyRune('v'))
+	if !m.detail.artifacts {
+		t.Fatal("setup: v did not show the artifacts")
+	}
+
+	m = searchDetail(t, m, "verify")
+	var names []string
+	for _, a := range m.detail.artifactList.Items() {
+		names = append(names, a.Name)
+	}
+	if !slices.Equal(names, []string{"verify-20260818T120000Z.md"}) {
+		t.Fatalf("artifact search left %v", names)
+	}
+
+	// A search hiding every artifact is not a container without artifacts.
+	m = searchDetail(t, m, "zebra")
+	if !m.detail.artifacts || !m.detail.hasArtifacts() {
+		t.Fatal("a search that hid every artifact switched the view away")
+	}
+	if view := ui.StripANSI(m.View().Content); !strings.Contains(view, `No artifacts match search "zebra"`) {
+		t.Fatalf("empty artifact search does not say so:\n%s", view)
+	}
+}
