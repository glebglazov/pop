+
+// The detail view speaks the row list's keyboard over the container it is open
+// over (ADR-0261): `s`, `y` and `m` open that container's menus, `I` runs its
+// flat verb, `/` narrows its items, and `r` stays the cursored item's menu.
+
+// containerMenuKind is a kind whose container offers one entry in every menu the
+// row list opens, a flat `I` verb, and a mute — everything the detail now reaches.
+type containerMenuKind struct {
+	itemVerbKind
+	performed []work.Verb
+	mutedID   string
+}
+
+func (k *containerMenuKind) Actions(work.Container) []work.Action {
+	return []work.Action{{Verb: "poke", Key: "I", Label: "poke it"}}
+}
+func (k *containerMenuKind) StatusActions(work.Container) []work.Action {
+	return []work.Action{{Verb: "close", Key: "x", Label: "close it"}}
+}
+func (k *containerMenuKind) CopyActions(work.Container) []work.Action {
+	return []work.Action{{Verb: work.VerbCopyName, Key: "n", Label: "copy name"}}
+}
+
+func (k *containerMenuKind) Perform(c work.Container, item *work.Item, verb work.Verb) (work.Outcome, error) {
+	if item != nil {
+		return k.itemVerbKind.Perform(c, item, verb)
+	}
+	k.performed = append(k.performed, verb)
+	return work.Outcome{Kind: work.OutcomeMessage, Message: string(verb) + " " + c.ID}, nil
+}
+
+func (k *containerMenuKind) Mute(c work.Container, _ time.Time, _ bool) (work.Outcome, error) {
+	k.mutedID = c.ID
+	return work.Outcome{}, nil
+}
+func (k *containerMenuKind) Unmute(work.Container) (work.Outcome, error) { return work.Outcome{}, nil }
+
+// openersDashboard is a two-row dashboard over kind with the detail open over
+// the first row, "thing".
+func openersDashboard(t *testing.T, kind work.Kind) QueueDashboard {
+	t.Helper()
+	other := genericDetailRow()
+	other.ID, other.CursorKey = "zother", "pop\x00zother"
+	d := &drain.Deps{Kinds: func(*drain.Deps, *config.Config) []work.Kind { return []work.Kind{kind} }}
+	m := newQueueDashboard(d, &config.Config{}, DashboardSnapshot{Containers: []DashboardRow{genericDetailRow(), other}})
+	m.width, m.height = 120, 30
+	m = pressKeys(t, m, "l")
+	if m.detail == nil || m.detail.row.ID != "thing" {
+		t.Fatal("l did not open the detail over thing")
+	}
+	return m
+}
+
+// runCmd feeds a command's message back into the model, the way the program does.
+func runCmd(t *testing.T, m QueueDashboard, cmd tea.Cmd) QueueDashboard {
+	t.Helper()
+	if cmd == nil {
+		t.Fatal("expected a command")
+	}
+	updated, _ := m.update(cmd())
+	return updated.(QueueDashboard)
+}
+
+func TestDetailOpenersOpenTheContainersOwnMenus(t *testing.T) {
+	for _, tc := range []struct {
+		key, noun string
+		open      func(QueueDashboard) bool
+	}{
+		{"s", "status", func(m QueueDashboard) bool { return m.menu.status != nil }},
+		{"y", "copy", func(m QueueDashboard) bool { return m.menu.copy != nil }},
+		{"m", "mute", func(m QueueDashboard) bool { return m.menu.mute != nil }},
+	} {
+		t.Run(tc.key, func(t *testing.T) {
+			m := openersDashboard(t, &containerMenuKind{})
+			got := pressKeys(t, m, tc.key)
+			if got.menu == nil || !tc.open(got) || got.menu.row.ID != "thing" {
+				t.Fatalf("%s did not open the %s menu over the detail's container: %+v", tc.key, tc.noun, got.menu)
+			}
+			view := ui.StripANSI(got.View().Content)
+			if !strings.Contains(view, tc.noun+" · thing") || !strings.Contains(view, "First") {
+				t.Fatalf("%s menu did not render as the detail's block:\n%s", tc.noun, view)
+			}
+			if !strings.Contains(view, "esc close") || strings.Contains(view, "J/K") {
+				t.Fatalf("menu over a detail shows the wrong hint line:\n%s", view)
+			}
+
+			got = pressKeys(t, got, "esc")
+			if got.menu != nil || got.detail == nil {
+				t.Fatal("esc must close the menu and leave the detail standing")
+			}
+		})
+	}
+}
+
+// TestDetailMenusOfferAndRunWhatTheRowOffers pins the same entries and the same
+// verbs as the row: the status menu lists the kind's StatusActions for the
+// container and its entry runs through the kind's Perform, and the mute menu's
+// window mutes the detail's container.
+func TestDetailMenusOfferAndRunWhatTheRowOffers(t *testing.T) {
+	kind := &containerMenuKind{}
+	m := openersDashboard(t, kind)
+
+	got := pressKeys(t, m, "s")
+	var keys []string
+	for _, action := range got.menu.status.list.Items() {
+		keys = append(keys, action.Key)
+	}
+	if want := menuActionKeys(got.kinds.statusActionsFor(got.detail.row)); !reflect.DeepEqual(keys, want) {
+		t.Fatalf("detail status menu keys = %v, want the row's own %v", keys, want)
+	}
+	updated, cmd := got.update(tea.KeyPressMsg{Code: 'x', Text: "x"})
+	got = runCmd(t, updated.(QueueDashboard), cmd)
+	if !reflect.DeepEqual(kind.performed, []work.Verb{"close"}) {
+		t.Fatalf("status entry performed %v, want close", kind.performed)
+	}
+	if view := ui.StripANSI(got.View().Content); got.detail == nil || !strings.Contains(view, "close thing") {
+		t.Fatalf("the verb's report did not reach the detail:\n%s", view)
+	}
+
+	got = pressKeys(t, got, "m")
+	updated, cmd = got.update(tea.KeyPressMsg{Code: '1', Text: "1"})
+	_ = runCmd(t, updated.(QueueDashboard), cmd)
+	if kind.mutedID != "thing" {
+		t.Fatalf("mute window muted %q, want the detail's container", kind.mutedID)
+	}
+}
+
+func TestDetailIRunsTheContainersFlatVerb(t *testing.T) {
+	kind := &containerMenuKind{}
+	m := openersDashboard(t, kind)
+	updated, cmd := m.update(tea.KeyPressMsg{Code: 'I', Text: "I"})
+	got := runCmd(t, updated.(QueueDashboard), cmd)
+	if !reflect.DeepEqual(kind.performed, []work.Verb{"poke"}) {
+		t.Fatalf("I performed %v, want the row's own I verb", kind.performed)
+	}
+	if view := ui.StripANSI(got.View().Content); got.detail == nil || !strings.Contains(view, "poke thing") {
+		t.Fatalf("I's report did not reach the detail:\n%s", view)
+	}
+}
+
+// TestDetailOpenersRefuseWhatTheRowRefuses covers a kind that offers no status,
+// nothing to copy and no mute: each opener flashes, on the detail, the refusal
+// the row list flashes for the same container.
+func TestDetailOpenersRefuseWhatTheRowRefuses(t *testing.T) {
+	for _, key := range []string{"s", "y", "m"} {
+		row := pressKeys(t, genericDetailDashboard(&itemVerbKind{}), key)
+		want := row.flash.Text()
+		if want == "" {
+			t.Fatalf("%s on the row did not refuse", key)
+		}
+		got := pressKeys(t, openersDashboard(t, &itemVerbKind{}), key)
+		if got.menu != nil {
+			t.Fatalf("%s opened an empty menu", key)
+		}
+		if view := ui.StripANSI(got.View().Content); !strings.Contains(view, want) {
+			t.Fatalf("%s in the detail did not flash %q:\n%s", key, want, view)
+		}
+	}
+}
+
+// TestDetailMenusIgnoreTheSelection pins that rows marked on the row list do not
+// make a menu opened from a detail plural: it acts on the detail's container.
+func TestDetailMenusIgnoreTheSelection(t *testing.T) {
+	m := openersDashboard(t, &containerMenuKind{})
+	m.detail = nil
+	m = pressKeys(t, m, "tab", "tab")
+	if m.selection.Len() != 2 {
+		t.Fatalf("marked %d rows, want 2", m.selection.Len())
+	}
+	row, _ := m.rowByCursorKey("pop\x00thing")
+	m.detail = m.openDetailView(row)
+
+	for _, key := range []string{"s", "y", "m"} {
+		got := pressKeys(t, m, key)
+		if got.menu == nil || got.menu.plural || got.menu.row.ID != "thing" {
+			t.Fatalf("%s over a Selection opened %+v, want the detail's container alone", key, got.menu)
+		}
+	}
+}
+
+func TestDetailHintAndHelpNameTheFourOpeners(t *testing.T) {
+	m := openersDashboard(t, &containerMenuKind{})
+	view := ui.StripANSI(m.View().Content)
+	if !strings.Contains(view, "r run ▸ · s status ▸ · y copy ▸ · m mute ▸") {
+		t.Fatalf("detail hint line does not lead with the four openers:\n%s", view)
+	}
+	help := map[string]string{}
+	for _, entry := range m.helpEntries() {
+		help[entry.Key] = entry.Desc
+	}
+	for key, want := range map[string]string{"r": "item run menu", "s": "status menu", "y": "copy menu", "m": "mute menu", "I": "poke it", "/": "search"} {
+		if !strings.Contains(help[key], want) {
+			t.Fatalf("help entry for %s = %q, want it to mention %q", key, help[key], want)
+		}
+	}
+	if _, ok := help["p"]; ok {
+		t.Fatal("help still lists p, which copies nothing now")
+	}
+}
+
+// searchRow carries items whose ids, titles, types and statuses are told apart
+// so a term can be aimed at one field.
+func searchRow() DashboardRow {
+	row := genericDetailRow()
+	row.Items = []work.Item{
+		{ID: "01-parser", Title: "Write the parser", Type: "AFK", Status: "open"},
+		{ID: "02-lexer", Title: "Tokenise input", Type: "HITL", Status: "done"},
+		{ID: "03-docs", Title: "Document the parser", Type: "HITL", Status: "open"},
+	}
+	return row
+}
+
+func searchDashboard(t *testing.T) QueueDashboard {
+	t.Helper()
+	d := &drain.Deps{Kinds: func(*drain.Deps, *config.Config) []work.Kind { return []work.Kind{&itemVerbKind{}} }}
+	m := newQueueDashboard(d, &config.Config{}, DashboardSnapshot{Containers: []DashboardRow{searchRow()}})
+	m.width, m.height = 120, 30
+	return pressKeys(t, m, "l")
+}
+
+// typeText sends each rune of text as its own keypress.
+func typeText(t *testing.T, m QueueDashboard, text string) QueueDashboard {
+	t.Helper()
+	for _, r := range text {
+		updated, _ := m.update(tea.KeyPressMsg{Code: r, Text: string(r)})
+		m = updated.(QueueDashboard)
+	}
+	return m
+}
+
+func detailItemIDs(m QueueDashboard) []string {
+	var ids []string
+	for _, item := range m.detail.list.Items() {
+		ids = append(ids, item.ID)
+	}
+	return ids
+}
+
+func TestDetailSearchNarrowsItemsByIDTitleAndType(t *testing.T) {
+	for _, tc := range []struct {
+		query string
+		want  []string
+	}{
+		{"LEXER", []string{"02-lexer"}},              // id, case-insensitively
+		{"parser", []string{"01-parser", "03-docs"}}, // title
+		{"hitl", []string{"02-lexer", "03-docs"}},    // type
+		{"hitl parser", []string{"03-docs"}},         // terms AND-ed across fields
+		{"done", nil},                                // status is not searched
+	} {
+		t.Run(tc.query, func(t *testing.T) {
+			m := pressKeys(t, searchDashboard(t), "/")
+			m = typeText(t, m, tc.query)
+			m = pressKeys(t, m, "enter")
+			if m.detail.searchTyping || m.detail.searchTerm != tc.query {
+				t.Fatalf("enter did not apply %q: typing=%v term=%q", tc.query, m.detail.searchTyping, m.detail.searchTerm)
+			}
+			if got := detailItemIDs(m); !reflect.DeepEqual(got, tc.want) {
+				t.Fatalf("%q narrowed to %v, want %v", tc.query, got, tc.want)
+			}
+		})
+	}
+}
+
+// TestDetailSearchTypesEveryKeyButTheReservedThree pins the typing phase: j, k,
+// v and r are letters, and the full keymap returns on Enter.
+func TestDetailSearchTypesEveryKeyButTheReservedThree(t *testing.T) {
+	m := pressKeys(t, searchDashboard(t), "/")
+	m = typeText(t, m, "jkvr")
+	if m.detail.searchInput.Value() != "jkvr" || m.itemMenu != nil || m.detail.artifacts {
+		t.Fatalf("typing acted instead of typing: buffer=%q", m.detail.searchInput.Value())
+	}
+	if view := ui.StripANSI(m.View().Content); !strings.Contains(view, "enter apply search · esc cancel") {
+		t.Fatalf("typing phase hint missing:\n%s", view)
+	}
+	m = pressKeys(t, m, "esc", "j")
+	if m.detail.list.Cursor() != 1 {
+		t.Fatal("j did not move once the search closed")
+	}
+}
+
+func TestDetailSearchEscRestoresAndEmptyQueryClears(t *testing.T) {
+	m := pressKeys(t, searchDashboard(t), "/")
+	m = typeText(t, m, "lexer")
+	m = pressKeys(t, m, "enter", "/")
+	if got := detailItemIDs(m); len(got) != 3 {
+		t.Fatalf("reopening / did not start from an empty buffer: %v", got)
+	}
+	m = typeText(t, m, "docs")
+	m = pressKeys(t, m, "esc")
+	if m.detail.searchTerm != "lexer" || !reflect.DeepEqual(detailItemIDs(m), []string{"02-lexer"}) {
+		t.Fatalf("esc did not restore the term in force: term=%q items=%v", m.detail.searchTerm, detailItemIDs(m))
+	}
+	m = pressKeys(t, m, "/", "enter")
+	if m.detail.searchTerm != "" || len(detailItemIDs(m)) != 3 {
+		t.Fatalf("applying an empty query did not clear: term=%q items=%v", m.detail.searchTerm, detailItemIDs(m))
+	}
+}
+
+// TestDetailSearchSurvivesThePollAndShowsItsTerm covers the poll that rebuilds
+// the detail, the term on screen while it is in force, and the empty state that
+// names the term when nothing matches.
+func TestDetailSearchSurvivesThePollAndShowsItsTerm(t *testing.T) {
+	m := pressKeys(t, searchDashboard(t), "/")
+	m = typeText(t, m, "parser")
+	m = pressKeys(t, m, "enter")
+	updated, _ := m.update(dashboardRowsMsg{page: m.page.id, snap: DashboardSnapshot{Containers: []DashboardRow{searchRow()}}})
+	m = updated.(QueueDashboard)
+	if got := detailItemIDs(m); !reflect.DeepEqual(got, []string{"01-parser", "03-docs"}) {
+		t.Fatalf("poll widened the narrowed list to %v", got)
+	}
+	if view := ui.StripANSI(m.View().Content); !strings.Contains(view, "search: parser") {
+		t.Fatalf("the term in force is not on screen:\n%s", view)
+	}
+
+	m = pressKeys(t, m, "/")
+	m = typeText(t, m, "nothing")
+	m = pressKeys(t, m, "enter")
+	view := ui.StripANSI(m.View().Content)
+	if !strings.Contains(view, `No items match search "nothing" — / then enter to clear.`) {
+		t.Fatalf("empty search does not say what emptied it:\n%s", view)
+	}
+}
+
+// TestDetailSearchIsNotTheRowListSearch pins that the two searches share no
+// buffer and no term.
+func TestDetailSearchIsNotTheRowListSearch(t *testing.T) {
+	m := pressKeys(t, searchDashboard(t), "/")
+	m = typeText(t, m, "lexer")
+	m = pressKeys(t, m, "enter")
+	if m.searchTerm != "" || m.searchTyping {
+		t.Fatalf("detail search wrote the row list's search: term=%q", m.searchTerm)
+	}
+	m = pressKeys(t, m, "esc")
+	if m.list.Len() != 1 {
+		t.Fatal("the row list was narrowed by the detail's search")
+	}
+	m = pressKeys(t, m, "/")
+	m = typeText(t, m, "zzz")
+	m = pressKeys(t, m, "enter", "l")
+	if m.detail != nil {
+		t.Fatal("a row-list search hiding the only row still opened a detail")
+	}
+}
+
+func TestDetailSearchNarrowsTheArtifactList(t *testing.T) {
+	root := t.TempDir()
+	row := genericDetailRow()
+	row.DefPath = root
+	at := time.Date(2026, 8, 17, 12, 0, 0, 0, time.UTC)
+	kind := &artifactDetailKind{id: ref.KindTaskSet, artifacts: []work.Artifact{
+		{Type: "refine", Name: "refine-1.md", Path: root + "/refine-1.md", At: at},
+		{Type: "spec", Name: "spec.md", Path: root + "/spec.md", At: at},
+	}}
+	m := openArtifactDetail(t, artifactDetailDashboard(kind, row))
+	m = pressKeys(t, m, "v", "/")
+	m = typeText(t, m, "SPEC")
+	m = pressKeys(t, m, "enter")
+	if !m.detail.artifacts || m.detail.artifactList.Len() != 1 {
+		t.Fatalf("artifact list holds %d entries, want spec.md alone", m.detail.artifactList.Len())
+	}
+	if a, _ := m.detail.artifactList.Selected(); a.Name != "spec.md" {
+		t.Fatalf("narrowed artifact = %q, want spec.md", a.Name)
+	}
+	m = pressKeys(t, m, "/")
+	m = typeText(t, m, "nope")
+	m = pressKeys(t, m, "enter")
+	if view := ui.StripANSI(m.View().Content); !m.detail.artifacts || !strings.Contains(view, `No artifacts match search "nope"`) {
+		t.Fatalf("an artifact search matching nothing left the Artifact view or said nothing:\n%s", view)
+	}
+}
+
+// TestDetailShowsTheModalAContainerVerbOpens covers a verb run from the detail
+// that asks a question — `I` on an unbound set opens the drain picker — which
+// renders as the detail's block, and esc returns to the detail.
+func TestDetailShowsTheModalAContainerVerbOpens(t *testing.T) {
+	m := openersDashboard(t, &containerMenuKind{})
+	updated, _ := m.update(dashboardDrainListMsg{row: m.detail.row, entries: []drain.DrainEntry{{Label: "trunk checkout"}}})
+	m = updated.(QueueDashboard)
