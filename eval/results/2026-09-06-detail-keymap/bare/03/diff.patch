+		t.Fatalf("drain picker did not render inside the detail:\n%s", view)
+	}
+	m = pressKeys(t, m, "esc")
+	if m.drainPick != nil || m.detail == nil {
+		t.Fatal("esc must close the picker and leave the detail standing")
+	}
+}
