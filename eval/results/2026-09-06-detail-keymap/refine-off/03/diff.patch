+// (filterDashboardRows): every space-separated term a case-insensitive substring
+// of the item's id, title or type. Status stays out for the row search's reason —
+// narrowing by status is a filter's question, not a search's.
+func filterDetailItems(items []work.Item, query string) []work.Item {
+	terms := strings.Fields(strings.ToLower(query))
+	if len(terms) == 0 {
+		return items
+	}
+	var filtered []work.Item
+	for _, item := range items {
+		fields := []string{strings.ToLower(item.ID), strings.ToLower(item.Title), strings.ToLower(item.Type)}
