@@ -0,0 +1,206 @@
+package dashboard
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/internal/queuetest"
+	"github.com/glebglazov/pop/tasks"
+	"github.com/glebglazov/pop/tasks/drain"
+	"github.com/glebglazov/pop/ui"
+)
+
+// ADR-0261: inside a detail view the row list's openers act on the container the
+// detail is open over, and `r` stays the cursored item's.
+
+func keymapSetRow(id string) DashboardRow {
+	return DashboardRow{Project: "pop", CursorKey: "pop\x00" + id, ID: id, DefPath: "/def", RawStatus: tasks.StatusReady}
+}
+
+func keymapDashboard(rows ...DashboardRow) QueueDashboard {
+	m := newQueueDashboard(&drain.Deps{}, &config.Config{}, DashboardSnapshot{Containers: rows})
+	m.width, m.height = 120, 24
+	return m
+}
+
+func press(t *testing.T, m QueueDashboard, key string) QueueDashboard {
+	t.Helper()
+	updated, _ := m.update(tea.KeyPressMsg{Code: []rune(key)[0], Text: key})
+	return updated.(QueueDashboard)
+}
+
+// TestDetailOpenersOpenTheContainersMenus pins decision 1: `s`, `y` and `m` open
+// the very menu the row's own key opens, render it as the detail's reserved
+// block, and esc closes the menu while the detail stays standing.
+func TestDetailOpenersOpenTheContainersMenus(t *testing.T) {
+	m := keymapDashboard(keymapSetRow("my-set"))
+	for _, key := range []string{"s", "y", "m"} {
+		t.Run(key, func(t *testing.T) {
+			fromRow := press(t, m, key)
+			if fromRow.menu == nil {
+				t.Fatalf("%s on the row opened no menu", key)
+			}
+			want := dashboardMenuLines(fromRow.menu, m.width, m.liveCache())
+
+			got := press(t, press(t, m, "l"), key)
+			if got.detail == nil || got.menu == nil {
+				t.Fatalf("%s in the detail: detail=%v menu=%v", key, got.detail != nil, got.menu != nil)
+			}
+			lines := dashboardMenuLines(got.menu, got.width, got.liveCache())
+			if fmt.Sprint(lines) != fmt.Sprint(want) {
+				t.Fatalf("detail %s menu = %q, want the row's %q", key, lines, want)
+			}
+			view := got.View().Content
+			for _, line := range lines {
+				if !strings.Contains(view, line) {
+					t.Fatalf("detail view does not render the %s menu line %q:\n%s", key, line, view)
+				}
+			}
+			if !strings.Contains(view, "esc close") || !strings.Contains(view, "STATUS") {
+				t.Fatalf("the menu does not sit as a block over the item list:\n%s", view)
+			}
+
+			closed := press(t, got, "esc")
+			if closed.menu != nil || closed.detail == nil {
+				t.Fatalf("esc: menu=%v detail=%v, want the menu gone and the detail standing", closed.menu != nil, closed.detail != nil)
+			}
+		})
+	}
+}
+
+// TestDetailCopyMenuCopiesTheContainer drives `y` `n` from the detail: the
+// container's name lands on the clipboard and the confirmation on the detail.
+func TestDetailCopyMenuCopiesTheContainer(t *testing.T) {
+	m := press(t, keymapDashboard(keymapSetRow("my-set")), "l")
+	var captured string
+	m.copyFunc = func(s string) error { captured = s; return nil }
+
+	m = pressKeys(t, m, "y", "n")
+
+	if captured != "my-set" {
+		t.Fatalf("copied %q, want the set's name", captured)
+	}
+	if m.menu != nil || m.detail == nil {
+		t.Fatal("the entry did not close the menu back to the detail")
+	}
+	if view := m.View().Content; !strings.Contains(view, "my-set") || !strings.Contains(view, m.flash.Text()) || m.flash.Text() == "" {
+		t.Fatalf("the detail does not show the copy's confirmation %q:\n%s", m.flash.Text(), view)
+	}
+}
+
+// TestDetailOpenersRefuseAsTheRowListDoes pins that a kind offering nothing
+// flashes the row list's own refusal, on the detail's screen.
+func TestDetailOpenersRefuseAsTheRowListDoes(t *testing.T) {
+	m := genericDetailDashboard(&itemVerbKind{})
+	for _, key := range []string{"s", "y", "m"} {
+		fromRow := press(t, m, key)
+		want := fromRow.flash.Text()
+		if want == "" || fromRow.menu != nil {
+			t.Fatalf("%s on the row: flash %q menu %v, want a refusal", key, want, fromRow.menu != nil)
+		}
+		got := press(t, press(t, m, "l"), key)
+		if got.flash.Text() != want || got.menu != nil {
+			t.Fatalf("%s in the detail: flash %q menu %v, want %q", key, got.flash.Text(), got.menu != nil, want)
+		}
+		if view := got.View().Content; !strings.Contains(view, want) {
+			t.Fatalf("detail view does not show the refusal %q:\n%s", want, view)
+		}
+	}
+}
+
+// TestDetailMenusIgnoreTheRowListSelection pins that a Selection marked on the
+// row list leaves a detail-opened menu singular, over the detail's container.
+func TestDetailMenusIgnoreTheRowListSelection(t *testing.T) {
+	marked, open := keymapSetRow("marked"), keymapSetRow("open")
+	m := press(t, keymapDashboard(marked, open), "tab")
+	if !m.selection.Active() {
+		t.Fatal("tab did not mark the row")
+	}
+	m.detail = m.openDetailView(open)
+
+	for _, key := range []string{"s", "y", "m"} {
+		got := press(t, m, key)
+		if got.menu == nil || got.menu.plural || got.menu.row.ID != "open" {
+			t.Fatalf("%s in the detail opened %+v, want a singular menu over %q", key, got.menu, "open")
+		}
+	}
+}
+
+// TestDetailFlatIRunsTheContainersVerb pins decision 4: `I` drains the set the
+// detail is open over, through the row's own path — a marked Selection does not
+// refuse it — and the drain picker it opens renders and closes back to the
+// detail.
+func TestDetailFlatIRunsTheContainersVerb(t *testing.T) {
+	repo, setID, _ := queuetest.SetupSpawnRepo(t, "detail-i", []queuetest.SpawnTask{
+		{ID: "01-a", File: "01-a.md", Title: "A", Type: "AFK", Status: "open"},
+	})
+	d, cfg, row, _ := dashboardLaunchFixture(t, repo, setID)
+	repoKey, err := drain.ResolveRepoKey(d, repo)
+	if err != nil {
+		t.Fatal(err)
+	}
+	row.RepoKey = repoKey
+	row.CursorKey = "pop\x00" + setID
+	t.Chdir(repo)
+
+	m := newQueueDashboard(d, cfg, DashboardSnapshot{Containers: []DashboardRow{row}})
+	m.width, m.height = 120, 24
+	m = press(t, m, "tab")
+	m.detail = m.openDetailView(row)
+
+	updated, cmd := m.update(tea.KeyPressMsg{Code: 'I', Text: "I"})
+	got := updated.(QueueDashboard)
+	if cmd == nil {
+		t.Fatalf("I in the detail did not start a drain; flash %q", got.flash.Text())
+	}
+	msg, ok := cmd().(dashboardDrainListMsg)
+	if !ok {
+		t.Fatal("I on an unbound set's detail did not ask for the drain target list")
+	}
+	if got.flash.Text() != dashboardHandoffPending {
+		t.Fatalf("flash = %q, want the handoff reassurance", got.flash.Text())
+	}
+	updated, _ = got.update(msg)
+	got = updated.(QueueDashboard)
+	if got.drainPick == nil {
+		t.Fatal("the drain target list did not open the picker")
+	}
+	if view := got.View().Content; strings.Contains(view, "l/enter peek") {
+		t.Fatalf("the detail hides the drain picker it opened:\n%s", view)
+	}
+	got = press(t, got, "esc")
+	if got.drainPick != nil || got.detail == nil {
+		t.Fatal("esc on the picker did not return to the detail")
+	}
+}
+
+// TestDetailNamesTheFourOpeners covers the hint line and the help overlay.
+func TestDetailNamesTheFourOpeners(t *testing.T) {
+	m := press(t, keymapDashboard(keymapSetRow("my-set")), "l")
+	view := m.View().Content
+	if !strings.Contains(view, "r run ▸ · s status ▸ · y copy ▸ · m mute ▸") {
+		t.Fatalf("detail hint does not name the four openers:\n%s", view)
+	}
+	keys := map[string]bool{}
+	for _, entry := range m.helpEntries() {
+		keys[entry.Key] = true
+	}
+	for _, key := range []string{"r", "s", "y", "m", "I"} {
+		if !keys[key] {
+			t.Fatalf("detail help lacks %s: %v", key, m.helpEntries())
+		}
+	}
+	if keys["p"] {
+		t.Fatal("detail help still names the retired p")
+	}
+
+	menu := press(t, m, "s")
+	for _, entry := range menu.helpEntries() {
+		if entry == (ui.HelpEntry{Key: "J/K", Desc: "navigate rows"}) {
+			t.Fatal("a detail-opened menu's help offers J/K, which move rows the detail hides")
+		}
+	}
+}
diff --git a/dashboard/dashboard_detail_search_test.go b/dashboard/dashboard_detail_search_test.go
new file mode 100644
index 00000000..4ddaf1f1
--- /dev/null
+++ b/dashboard/dashboard_detail_search_test.go
@@ -0,0 +1,173 @@
+package dashboard
+
+import (
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// ADR-0261 decision 5: `/` inside a detail view narrows its list with the row
+// list's grammar, over an item's id, title and type and never its status.
+
+func searchDetailRow(root string) DashboardRow {
+	row := genericDetailRow()
+	row.DefPath = root
+	row.Items = []work.Item{
+		{ID: "01-alpha", Title: "First widget", Type: "AFK", Status: "open"},
+		{ID: "02-beta", Title: "Second gadget", Type: "HITL", Status: "done"},
+		{ID: "03-gamma", Title: "Third widget", Type: "HITL", Status: "done"},
+	}
+	return row
+}
+
+func searchDetailDashboard(t *testing.T) QueueDashboard {
+	t.Helper()
+	root := t.TempDir()
+	row := searchDetailRow(root)
+	kind := &artifactDetailKind{id: ref.KindTaskSet, artifacts: []work.Artifact{
+		{Type: "refine", Name: "refine-20260817T120000Z.md", Path: filepath.Join(root, row.ID, "refine.md")},
+		{Type: "spec", Name: "spec.md", Path: filepath.Join(root, row.ID, "spec.md")},
+	}}
+	return openArtifactDetail(t, artifactDetailDashboard(kind, row))
+}
+
+func typeKeys(t *testing.T, m QueueDashboard, text string) QueueDashboard {
+	t.Helper()
+	for _, r := range text {
+		m = press(t, m, string(r))
+	}
+	return m
+}
+
+func pressCode(t *testing.T, m QueueDashboard, code rune) QueueDashboard {
+	t.Helper()
+	updated, _ := m.update(tea.KeyPressMsg{Code: code})
+	return updated.(QueueDashboard)
+}
+
+func detailSearch(t *testing.T, m QueueDashboard, query string) QueueDashboard {
+	t.Helper()
+	return pressCode(t, typeKeys(t, press(t, m, "/"), query), tea.KeyEnter)
+}
+
+func detailItemIDs(m QueueDashboard) []string {
+	var ids []string
+	for _, item := range m.detail.list.Items() {
+		ids = append(ids, item.ID)
+	}
+	return ids
+}
+
+func TestDetailSearchNarrowsItemsAndReturnsTheKeymap(t *testing.T) {
+	m := detailSearch(t, searchDetailDashboard(t), "HITL WIDGET")
+	if got := detailItemIDs(m); !slices.Equal(got, []string{"03-gamma"}) {
+		t.Fatalf("terms on type and title AND-ed: items = %v, want [03-gamma]", got)
+	}
+	if got := detailItemIDs(detailSearch(t, m, "a widg")); !slices.Equal(got, []string{"01-alpha", "03-gamma"}) {
+		t.Fatalf("id and title terms: items = %v", got)
+	}
+
+	m = detailSearch(t, m, "widget")
+	if m.detail.searchTyping {
+		t.Fatal("enter left the detail search typing")
+	}
+	m = press(t, m, "j")
+	if item, _ := m.detail.list.Selected(); item.ID != "03-gamma" {
+		t.Fatalf("j after enter moves over the narrowed items: cursor on %q, want 03-gamma", item.ID)
+	}
+	view := m.View().Content
+	if !strings.Contains(view, "search: widget") || strings.Contains(view, "Second gadget") {
+		t.Fatalf("the applied term is not shown, or a hidden item renders:\n%s", view)
+	}
+}
+
+func TestDetailSearchDoesNotReadStatusAndSaysWhatEmptiedIt(t *testing.T) {
+	m := detailSearch(t, searchDetailDashboard(t), "done")
+	if got := detailItemIDs(m); len(got) != 0 {
+		t.Fatalf("a status word narrowed to %v, want nothing: status is not searched", got)
+	}
+	want := `No items match search "done" — / then enter to clear.`
+	if view := m.View().Content; !strings.Contains(view, want) {
+		t.Fatalf("empty detail does not name its term and the way out:\n%s", view)
+	}
+}
+
+func TestDetailSearchEscRestoresAndEmptyEnterClears(t *testing.T) {
+	m := detailSearch(t, searchDetailDashboard(t), "first")
+	m = pressCode(t, typeKeys(t, press(t, m, "/"), "sec"), tea.KeyEscape)
+	if m.detail == nil || m.detail.searchTerm != "first" || !slices.Equal(detailItemIDs(m), []string{"01-alpha"}) {
+		t.Fatalf("esc did not restore the term in force: term=%q items=%v", m.detail.searchTerm, detailItemIDs(m))
+	}
+	m = pressCode(t, press(t, m, "/"), tea.KeyEnter)
+	if m.detail.searchTerm != "" || len(detailItemIDs(m)) != 3 {
+		t.Fatalf("an empty apply did not clear: term=%q items=%v", m.detail.searchTerm, detailItemIDs(m))
+	}
+}
+
+func TestDetailSearchTypingOwnsTheKeyboard(t *testing.T) {
+	m := typeKeys(t, press(t, searchDetailDashboard(t), "/"), "jkvr")
+	if m.detail == nil || m.detail.artifacts || m.itemMenu != nil {
+		t.Fatalf("a typed key acted: detail=%v artifacts=%v itemMenu=%v", m.detail != nil, m.detail != nil && m.detail.artifacts, m.itemMenu != nil)
+	}
+	if got := m.detail.searchInput.Value(); got != "jkvr" {
+		t.Fatalf("buffer = %q, want jkvr", got)
+	}
+	if view := m.View().Content; !strings.Contains(view, "enter apply search · esc cancel") {
+		t.Fatalf("typing hint missing:\n%s", view)
+	}
+}
+
+func TestDetailSearchSurvivesThePoll(t *testing.T) {
+	m := detailSearch(t, searchDetailDashboard(t), "widget")
+	refreshed := m.detail.row
+	refreshed.Items = append(slices.Clone(refreshed.Items),
+		work.Item{ID: "04-delta", Title: "Fourth widget", Type: "AFK", Status: "open"},
+		work.Item{ID: "05-eps", Title: "Fifth gizmo", Type: "AFK", Status: "open"},
+	)
+	updated, _ := m.Update(dashboardRowsMsg{snap: DashboardSnapshot{Containers: []DashboardRow{refreshed}}})
+	m = updated.(QueueDashboard)
+	if got := detailItemIDs(m); !slices.Equal(got, []string{"01-alpha", "03-gamma", "04-delta"}) {
+		t.Fatalf("after the poll items = %v, want the narrowed rebuild", got)
+	}
+	if view := m.View().Content; !strings.Contains(view, "search: widget") {
+		t.Fatalf("the term is not visible after the poll:\n%s", view)
+	}
+}
+
+func TestDetailSearchNarrowsTheArtifactList(t *testing.T) {
+	m := detailSearch(t, press(t, searchDetailDashboard(t), "v"), "spec")
+	var names []string
+	for _, a := range m.detail.artifactList.Items() {
+		names = append(names, a.Name)
+	}
+	if !m.detail.artifacts || !slices.Equal(names, []string{"spec.md"}) {
+		t.Fatalf("artifact view=%v names=%v, want [spec.md]", m.detail.artifacts, names)
+	}
+	m = detailSearch(t, m, "nothing")
+	if view := m.View().Content; !strings.Contains(view, `No artifacts match search "nothing"`) {
+		t.Fatalf("empty artifact list does not name its term:\n%s", view)
+	}
+}
+
+func TestDetailSearchAndRowSearchKeepTheirOwnTerms(t *testing.T) {
+	m := searchDetailDashboard(t)
+	m = pressCode(t, m, tea.KeyEscape)
+	m = detailSearch(t, m, "pop")
+	if m.searchTerm != "pop" {
+		t.Fatalf("row search term = %q, want pop", m.searchTerm)
+	}
+	m = press(t, m, "l")
+	if m.detail.searchTerm != "" || len(detailItemIDs(m)) != 3 {
+		t.Fatalf("the detail inherited the row term: %q", m.detail.searchTerm)
+	}
+	m = detailSearch(t, m, "first")
+	m = pressCode(t, m, tea.KeyEscape)
+	if m.detail != nil || m.searchTerm != "pop" {
+		t.Fatalf("the detail search touched the row term: detail=%v term=%q", m.detail != nil, m.searchTerm)
+	}
+}
