+)
+
+// openedMenuKeys is the open container menu's entry keys, whichever of the three
+// openers opened it.
+func openedMenuKeys(t *testing.T, menu *dashboardMenu) string {
+	t.Helper()
+	var keys []string
+	switch {
+	case menu == nil:
+		t.Fatal("no menu is open")
+	case menu.status != nil:
+		for _, a := range menu.status.list.Items() {
+			keys = append(keys, a.Key)
+		}
+	case menu.copy != nil:
+		for _, a := range menu.copy.list.Items() {
+			keys = append(keys, a.Key)
+		}
+	case menu.mute != nil:
+		for _, e := range menu.mute.list.Items() {
+			keys = append(keys, e.key)
+		}
+	default:
+		t.Fatal("the open menu is not a status, copy or mute menu")
+	}
+	return strings.Join(keys, " ")
+}
+
+func press(m QueueDashboard, key string) QueueDashboard {
+	var msg tea.KeyPressMsg
+	switch key {
+	case "esc":
+		msg = tea.KeyPressMsg{Code: tea.KeyEscape}
+	case "tab":
+		msg = tea.KeyPressMsg{Code: tea.KeyTab}
+	default:
+		msg = tea.KeyPressMsg{Code: rune(key[0]), Text: key}
+	}
+	updated, _ := m.update(msg)
+	return updated.(QueueDashboard)
+}
+
+// TestDetailOpenersActOnTheContainer pins `s`, `y` and `m` in a Task set's
+// detail: each opens the menu that key opens over the set's row, with the same
+// entries, rendered as the detail's reserved block; esc closes the menu and
+// leaves the detail standing.
+func TestDetailOpenersActOnTheContainer(t *testing.T) {
+	task := tasks.Task{ID: "01-a", File: "01-a.md", Status: "open"}
+	for _, key := range []string{"s", "y", "m"} {
+		t.Run(key, func(t *testing.T) {
+			rowList := detailCopyModel("my-set", task)
+			rowList.detail = nil
+			above := press(rowList, key)
+			want := openedMenuKeys(t, above.menu)
+
+			m := press(detailCopyModel("my-set", task), key)
+			if m.detail == nil || m.menu == nil || m.menu.row.ID != "my-set" {
+				t.Fatalf("%s in detail: detail=%v menu=%+v, want the set's menu over the detail", key, m.detail != nil, m.menu)
+			}
+			if got := openedMenuKeys(t, m.menu); got != want {
+				t.Fatalf("%s in detail offers %q, the row offers %q", key, got, want)
+			}
+			view := m.View().Content
+			for _, line := range dashboardMenuLines(m.menu, m.width, m.liveCache()) {
+				if !strings.Contains(view, line) {
+					t.Fatalf("detail view missing menu line %q:\n%s", line, view)
+				}
+			}
+			if !strings.Contains(view, "01-a") || !strings.Contains(view, "esc close") {
+				t.Fatalf("menu did not render inside the detail:\n%s", view)
+			}
+
+			m = press(m, "esc")
+			if m.menu != nil || m.detail == nil {
+				t.Fatalf("esc: menu=%+v detail=%v, want the menu closed and the detail standing", m.menu, m.detail != nil)
+			}
+		})
+	}
+}
+
+// TestDetailOpenersRefuseLikeTheRowList pins that a kind offering no status,
+// nothing to copy and no mute answers each opener in the detail with the flash
+// the row list shows.
+func TestDetailOpenersRefuseLikeTheRowList(t *testing.T) {
+	for _, key := range []string{"s", "y", "m"} {
+		above := press(genericDetailDashboard(&itemVerbKind{}), key)
+		want := above.flash.Text()
+		if above.menu != nil || want == "" {
+			t.Fatalf("%s on the row list: menu=%+v flash=%q, want a refusal", key, above.menu, want)
+		}
+
+		m := press(genericDetailDashboard(&itemVerbKind{}), "l")
+		m = press(m, key)
+		if m.menu != nil || m.detail == nil {
+			t.Fatalf("%s in detail: menu=%+v detail=%v", key, m.menu, m.detail != nil)
+		}
+		if view := m.View().Content; !strings.Contains(view, want) {
+			t.Fatalf("%s in detail did not flash %q:\n%s", key, want, view)
+		}
+	}
+}
+
+// TestDetailMenusIgnoreTheSelection pins that rows marked on the row list do not
+// make a menu opened from a detail plural: it acts on the detail's container.
+func TestDetailMenusIgnoreTheSelection(t *testing.T) {
+	rows := []DashboardRow{
+		{Project: "pop", CursorKey: "pop\x00a", ID: "set-a", DefPath: "/def"},
+		{Project: "pop", CursorKey: "pop\x00b", ID: "set-b", DefPath: "/def"},
+	}
+	m := newQueueDashboard(&drain.Deps{}, &config.Config{}, DashboardSnapshot{Containers: rows})
+	m.width, m.height = 120, 24
+	m = press(press(m, "tab"), "tab")
+	if m.selection.Len() != 2 {
+		t.Fatalf("selection holds %d rows, want 2", m.selection.Len())
+	}
+	m.detail = m.openDetailView(rows[1])
+
+	for _, key := range []string{"s", "y", "m"} {
+		got := press(m, key)
+		if got.menu == nil || got.menu.plural || got.menu.row.ID != "set-b" {
+			t.Fatalf("%s in detail over a Selection opened %+v, want a singular menu over set-b", key, got.menu)
+		}
+		if strings.Contains(got.View().Content, "selected") {
+			t.Fatalf("%s in detail counted the Selection:\n%s", key, got.View().Content)
+		}
+	}
+}
+
+// TestDetailFlatIRunsTheContainersVerb pins `I` in a detail: it runs the verb `I`
+// runs on the container's row, through the same dispatch, and a Selection on the
+// row list does not refuse it.
+func TestDetailFlatIRunsTheContainersVerb(t *testing.T) {
+	spy := &verbSpyKind{Kind: routine.NewKind(nil)}
+	kinds := func(*drain.Deps, *config.Config) []work.Kind { return []work.Kind{spy} }
+	m := openPage(t, &drain.Deps{Kinds: kinds, RoutineKinds: kinds}, PageRoutines)
+	row, _ := m.list.Selected()
+	m = press(m, "tab")
+	if !m.selection.Active() {
+		t.Fatal("tab did not mark the routine row")
+	}
+	m.detail = m.openDetailView(row)
+
+	m = pressKeys(t, m, "I")
+
+	if fmt.Sprint(spy.performed) != fmt.Sprint([]work.Verb{routine.VerbFire}) {
+		t.Fatalf("I in a routine's detail performed %v, want the kind's own fire verb", spy.performed)
+	}
+	if m.detail == nil {
+		t.Fatal("I closed the detail")
+	}
+}
+
+// TestDetailNamesTheFourOpeners pins the detail's hint line and help overlay:
+// both name `r`, `s`, `y` and `m`, and neither names the retired flat copies.
+func TestDetailNamesTheFourOpeners(t *testing.T) {
+	task := tasks.Task{ID: "01-a", File: "01-a.md", Status: "open"}
+	m := detailCopyModel("my-set", task)
+
+	view := m.View().Content
+	if !strings.Contains(view, "r run ▸ · s status ▸ · y copy ▸ · m mute ▸") {
+		t.Fatalf("detail hint line does not name the four openers:\n%s", view)
+	}
+	if strings.Contains(view, "copy name") || strings.Contains(view, "copy path") {
+		t.Fatalf("detail hint line still names a flat copy:\n%s", view)
+	}
+
+	help := map[string]string{}
+	for _, entry := range m.helpEntries() {
+		help[entry.Key] = entry.Desc
+	}
+	for _, key := range []string{"r", "s", "y", "m", "I"} {
+		if help[key] == "" {
+			t.Fatalf("detail help has no entry for %s: %v", key, help)
+		}
+	}
+	if _, ok := help["p"]; ok || help["y"] == "copy name" {
+		t.Fatalf("detail help still lists a flat copy: %v", help)
+	}
+}
diff --git a/dashboard/dashboard_detail_search_test.go b/dashboard/dashboard_detail_search_test.go
new file mode 100644
index 00000000..9e0717d8
--- /dev/null
+++ b/dashboard/dashboard_detail_search_test.go
@@ -0,0 +1,219 @@
+package dashboard
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// searchDetailRow is a container whose items differ in id, title, type and
+// status, so each test can tell which field a term landed in.
+func searchDetailRow() DashboardRow {
+	row := genericDetailRow()
+	row.Items = []work.Item{
+		{ID: "01-parser", Title: "Read the grammar", Type: "AFK", Status: "done"},
+		{ID: "02-render", Title: "Paint the rows", Type: "HITL", Status: "open"},
+		{ID: "03-wiring", Title: "Route the keys", Type: "AFK", Status: "open"},
+	}
+	return row
+}
+
+func openSearchDetail(t *testing.T) QueueDashboard {
+	t.Helper()
+	m := press(artifactDetailDashboard(&itemVerbKind{}, searchDetailRow()), "l")
+	if m.detail == nil {
+		t.Fatal("l did not open the detail")
+	}
+	return m
+}
+
+// typeKeys presses each key of text in turn, a space included.
+func typeKeys(m QueueDashboard, text string) QueueDashboard {
+	for _, r := range text {
+		m = press(m, string(r))
+	}
+	return m
+}
+
+func pressEnter(m QueueDashboard) QueueDashboard {
+	updated, _ := m.update(tea.KeyPressMsg{Code: tea.KeyEnter})
+	return updated.(QueueDashboard)
+}
+
+func searchDetail(m QueueDashboard, query string) QueueDashboard {
+	return pressEnter(typeKeys(press(m, "/"), query))
+}
+
+func detailItemIDs(m QueueDashboard) []string {
+	var ids []string
+	for i := 0; i < m.detail.list.Len(); i++ {
+		m.detail.list.SetCursor(i)
+		item, _ := m.detail.list.Selected()
+		ids = append(ids, item.ID)
+	}
+	m.detail.list.SetCursor(0)
+	return ids
+}
+
+// TestDetailSearchNarrowsTheItemList covers the grammar: a case-insensitive
+// substring per term, every term matching some field of id, title and type, and
+// Enter handing the whole keymap back over the narrowed items.
+func TestDetailSearchNarrowsTheItemList(t *testing.T) {
+	cases := []struct {
+		query string
+		want  string
+	}{
+		{"PARSER", "01-parser"},
+		{"paint", "02-render"},
+		{"hitl", "02-render"},
+		{"afk keys", "03-wiring"},
+		{"afk the", "01-parser 03-wiring"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.query, func(t *testing.T) {
+			m := searchDetail(openSearchDetail(t), tc.query)
+			if got := strings.Join(detailItemIDs(m), " "); got != tc.want {
+				t.Fatalf("items for %q = %q, want %q", tc.query, got, tc.want)
+			}
+			view := m.View().Content
+			if !strings.Contains(view, "search: "+tc.query) {
+				t.Fatalf("the term in force is not shown:\n%s", view)
+			}
+			if !strings.Contains(view, "r run ▸") {
+				t.Fatalf("enter did not hand back the detail keymap:\n%s", view)
+			}
+		})
+	}
+
+	m := searchDetail(openSearchDetail(t), "afk")
+	m = press(m, "j")
+	if item, _ := m.detail.list.Selected(); item.ID != "03-wiring" {
+		t.Fatalf("j after applying the search is on %q, want 03-wiring", item.ID)
+	}
+}
+
+// TestDetailSearchDoesNotReadStatus pins status out of the search: a term only a
+// status carries empties the list, and the empty list names the term and the way
+// back instead of reading as a container with no items.
+func TestDetailSearchDoesNotReadStatus(t *testing.T) {
+	m := searchDetail(openSearchDetail(t), "done")
+	if m.detail.list.Len() != 0 {
+		t.Fatalf("a status-only term left %v", detailItemIDs(m))
+	}
+	view := m.View().Content
+	if !strings.Contains(view, `No items match search "done" — / then enter to clear.`) {
+		t.Fatalf("empty search shows no line naming the term:\n%s", view)
+	}
+}
+
+// TestDetailSearchTypingOwnsTheKeyboard pins the typing phase: every key but
+// Enter, Esc and ctrl+c is text, Esc abandons the edit for the term in force,
+// and applying an empty buffer clears the search.
+func TestDetailSearchTypingOwnsTheKeyboard(t *testing.T) {
+	m := searchDetail(openSearchDetail(t), "afk")
+
+	m = typeKeys(press(m, "/"), "jkvr")
+	if m.detail == nil || m.itemMenu != nil || m.detail.artifacts || m.detail.peek != nil {
+		t.Fatal("a key typed into the search acted instead")
+	}
+	if got := m.detail.searchInput.Value(); got != "jkvr" {
+		t.Fatalf("buffer = %q, want jkvr", got)
+	}
+	if view := m.View().Content; !strings.Contains(view, "enter apply search · esc cancel · C-h help") {
+		t.Fatalf("typing hint missing:\n%s", view)
+	}
+
+	m = press(m, "esc")
+	if m.detail == nil {
+		t.Fatal("esc while typing closed the detail")
+	}
+	if got := strings.Join(detailItemIDs(m), " "); m.detail.searchTerm != "afk" || got != "01-parser 03-wiring" {
+		t.Fatalf("esc left term %q over %q, want afk over 01-parser 03-wiring", m.detail.searchTerm, got)
+	}
+
+	m = pressEnter(press(m, "/"))
+	if m.detail.searchTerm != "" || m.detail.list.Len() != 3 {
+		t.Fatalf("an empty query left term %q over %d items", m.detail.searchTerm, m.detail.list.Len())
+	}
+	if strings.Contains(m.View().Content, "search:") {
+		t.Fatalf("a cleared search is still shown:\n%s", m.View().Content)
+	}
+}
+
+// TestDetailSearchSurvivesThePoll covers the rebuild: the poll that refreshes the
+// container keeps narrowing it by the term in force.
+func TestDetailSearchSurvivesThePoll(t *testing.T) {
+	m := searchDetail(openSearchDetail(t), "afk")
+
+	refreshed := searchDetailRow()
+	refreshed.Items = append(refreshed.Items, work.Item{ID: "04-docs", Title: "Write it up", Type: "HITL"}, work.Item{ID: "05-tests", Title: "Prove it", Type: "AFK"})
+	updated, _ := m.Update(dashboardRowsMsg{snap: DashboardSnapshot{Containers: []DashboardRow{refreshed}}})
+	m = updated.(QueueDashboard)
+
+	if got := strings.Join(detailItemIDs(m), " "); got != "01-parser 03-wiring 05-tests" {
+		t.Fatalf("items after the poll = %q, want the rebuilt container narrowed by afk", got)
+	}
+	if !strings.Contains(m.View().Content, "search: afk") {
+		t.Fatalf("the term is not shown after the poll:\n%s", m.View().Content)
+	}
+}
+
+// TestDetailSearchIsNotTheRowListSearch keeps the two levels apart: a row-list
+// term never seeds the detail's buffer, and the detail's term never narrows or
+// names itself on the row list.
+func TestDetailSearchIsNotTheRowListSearch(t *testing.T) {
+	m := genericDetailDashboard(&itemVerbKind{})
+	m = pressEnter(typeKeys(press(m, "/"), "thing"))
+	m = press(m, "l")
+	if m.detail == nil {
+		t.Fatal("l did not open the detail")
+	}
+	m = press(m, "/")
+	if got := m.detail.searchInput.Value(); got != "" {
+		t.Fatalf("detail buffer opened on %q", got)
+	}
+	m = pressEnter(typeKeys(m, "second"))
+	if m.searchTerm != "thing" || m.detail.searchTerm != "second" {
+		t.Fatalf("row term %q, detail term %q; want thing and second", m.searchTerm, m.detail.searchTerm)
+	}
+
+	m = press(m, "esc")
+	if m.detail != nil || len(m.snap.Containers) != 1 {
+		t.Fatalf("closing the detail left detail %v over %d rows", m.detail, len(m.snap.Containers))
+	}
+	if view := m.View().Content; strings.Contains(view, "second") {
+		t.Fatalf("the detail's term reached the row list:\n%s", view)
+	}
+}
+
+// TestDetailSearchNarrowsTheArtifactList covers the second list: on screen, it
+// narrows by an artifact's type and file name the same way, and its empty state
+// names artifacts.
+func TestDetailSearchNarrowsTheArtifactList(t *testing.T) {
+	root := t.TempDir()
+	row := genericDetailRow()
+	row.DefPath = root
+	kind := &artifactDetailKind{id: ref.KindTaskSet, artifacts: []work.Artifact{
+		{Type: "refine", Name: "refine-20260817T120000Z.md", Path: filepath.Join(root, row.ID, "refine", "refine-20260817T120000Z.md")},
+		{Type: "spec", Name: "spec.md", Path: filepath.Join(root, row.ID, "spec.md")},
+	}}
+	m := press(openArtifactDetail(t, artifactDetailDashboard(kind, row)), "v")
+
+	m = searchDetail(m, "SPEC")
+	view := m.View().Content
+	if m.detail.artifactList.Len() != 1 || !strings.Contains(view, "spec.md") || strings.Contains(view, "refine-20260817T120000Z.md") {
+		t.Fatalf("artifact list not narrowed to spec.md:\n%s", view)
+	}
+
+	m = searchDetail(m, "nothing")
+	if !m.detail.artifacts {
+		t.Fatal("a search that hides every artifact left the Artifact view")
+	}
+	if view := m.View().Content; !strings.Contains(view, `No artifacts match search "nothing" — / then enter to clear.`) {
+		t.Fatalf("empty artifact search shows no line naming the term:\n%s", view)
+	}
+}
