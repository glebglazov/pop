+// updateDetailSearchTyping is updateSearchTyping over the detail's own search
+// fields: Enter, Esc and ctrl+c are reserved and every other key is text, so `j`,
+// `k`, `v` and `r` are typed rather than run (ADR-0213). Esc abandons the edit and
+// leaves the detail open on the term in force.
+func (m QueueDashboard) updateDetailSearchTyping(msg tea.KeyMsg) (tea.Model, tea.Cmd) {
+	d := m.detail
+	switch msg.String() {
+	case "ctrl+c":
+		return m, tea.Quit
+	case "enter":
+		d.searchTerm = d.searchInput.Value()
+		d.searchTyping = false
+		d.searchInput = ui.TextField{}
+		d.applySearch(d.searchTerm)
+	case "esc":
+		d.searchTyping = false
+		d.searchInput = ui.TextField{}
+		d.applySearch(d.searchTerm)
+	default:
+		d.searchInput.Update(msg)
+		d.applySearch(d.searchInput.Value())
+	}
+	return m, nil
+}
