diff --git a/dashboard/dashboard_detail_openers_test.go b/dashboard/dashboard_detail_openers_test.go
new file mode 100644
index 00000000..90fab625
--- /dev/null
+++ b/dashboard/dashboard_detail_openers_test.go
@@ -0,0 +1,201 @@
+package dashboard
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/glebglazov/pop/tasks"
+	"github.com/glebglazov/pop/ui"
+	"github.com/glebglazov/pop/work"
+)
+
+// A detail view answers the row list's s, y, m and I over the container it is
+// open over (ADR-0261): the same menus, the same refusals, the same flat verb.
+// These tests drive each key on the row and then in the detail, and hold the two
+// answers equal.
+
+// containerVerbKind is itemVerbKind with a container that has a flat I verb.
+type containerVerbKind struct{ itemVerbKind }
+
+func (k *containerVerbKind) Actions(work.Container) []work.Action {
+	return []work.Action{{Verb: "poke", Key: "I", Label: "poke"}}
+}
+
+func (k *containerVerbKind) Perform(c work.Container, item *work.Item, verb work.Verb) (work.Outcome, error) {
+	if item == nil && verb == "poke" {
+		return work.Outcome{Kind: work.OutcomeMessage, Message: "poked " + c.ID}, nil
+	}
+	return k.itemVerbKind.Perform(c, item, verb)
+}
+
+// openContainerMenuKeys names what the open container menu offers, whichever of
+// the three it is.
+func openContainerMenuKeys(m QueueDashboard) []string {
+	var keys []string
+	switch {
+	case m.menu == nil:
+	case m.menu.status != nil:
+		for _, action := range m.menu.status.list.Items() {
+			keys = append(keys, action.Key)
+		}
+	case m.menu.copy != nil:
+		for _, action := range m.menu.copy.list.Items() {
+			keys = append(keys, action.Key)
+		}
+	case m.menu.mute != nil:
+		for _, entry := range m.menu.mute.list.Items() {
+			keys = append(keys, entry.key)
+		}
+	}
+	return keys
+}
+
+func TestDetailOpenersOpenTheContainersOwnMenus(t *testing.T) {
+	task := tasks.Task{ID: "01-a", File: "01-a.md", Status: "open"}
+	for _, key := range []string{"s", "y", "m"} {
+		t.Run(key, func(t *testing.T) {
+			rowList := detailCopyModel("my-set", task)
+			rowList.detail = nil
+			updated, _ := rowList.update(tea.KeyPressMsg{Code: rune(key[0]), Text: key})
+			want := openContainerMenuKeys(updated.(QueueDashboard))
+			if len(want) == 0 {
+				t.Fatalf("%s on the row opened nothing to compare against", key)
+			}
+
+			m := detailCopyModel("my-set", task)
+			updated, _ = m.update(tea.KeyPressMsg{Code: rune(key[0]), Text: key})
+			got := updated.(QueueDashboard)
+			if keys := openContainerMenuKeys(got); !reflect.DeepEqual(keys, want) {
+				t.Fatalf("%s in the detail offers %v, want the row's %v", key, keys, want)
+			}
+			if got.menu.row.ID != "my-set" || got.menu.plural {
+				t.Fatalf("%s in the detail opened over %q (plural=%v), want the set itself", key, got.menu.row.ID, got.menu.plural)
+			}
+
+			// The menu is the detail's reserved block: the item table stays on
+			// screen above it, and the whole view still fits the pane.
+			view := ui.StripANSI(got.View().Content)
+			if !strings.Contains(view, "· my-set") || !strings.Contains(view, "01-a") {
+				t.Fatalf("%s menu did not render as a block under the item list:\n%s", key, view)
+			}
+			if lines := strings.Count(view, "\n") + 1; lines > got.height {
+				t.Fatalf("detail with a menu rendered %d lines, want at most %d", lines, got.height)
+			}
+
+			// J/K would move a row list nobody can see; they leave the menu as it is.
+			updated, _ = got.update(tea.KeyPressMsg{Code: 'J', Text: "J"})
+			got = updated.(QueueDashboard)
+			if got.menu == nil {
+				t.Fatal("J closed the menu")
+			}
+
+			updated, _ = got.update(tea.KeyPressMsg{Code: tea.KeyEscape})
+			got = updated.(QueueDashboard)
+			if got.menu != nil || got.detail == nil {
+				t.Fatalf("esc should close the menu and leave the detail: menu=%+v detail=%v", got.menu, got.detail != nil)
+			}
+		})
+	}
+}
+
+func TestDetailCopyMenuEntryCopiesTheContainer(t *testing.T) {
+	m := detailCopyModel("my-set", tasks.Task{ID: "01-a", File: "01-a.md", Status: "open"})
+	var captured string
+	m.copyFunc = func(s string) error { captured = s; return nil }
+
+	got := pressKeys(t, m, "y", "n")
+	if captured != "my-set" {
+		t.Fatalf("y n in the detail copied %q, want the set's name", captured)
+	}
+	if got.menu != nil || got.detail == nil {
+		t.Fatal("choosing an entry should close the menu and leave the detail")
+	}
+	if view := ui.StripANSI(got.View().Content); !strings.Contains(view, "copied my-set") {
+		t.Fatalf("the container's confirmation is missing from the detail:\n%s", view)
+	}
+}
+
+func TestDetailOpenersIgnoreARowListSelection(t *testing.T) {
+	m := detailCopyModel("my-set", tasks.Task{ID: "01-a", File: "01-a.md", Status: "open"})
+	// A detail cannot be opened over marks, so the fixture marks the row the way
+	// the row list's tab does and then places the detail over it.
+	m.selection.Toggle("pop\x00my-set")
+	if !m.selection.Active() {
+		t.Fatal("fixture: the row should be marked")
+	}
+
+	for _, key := range []string{"s", "y", "m"} {
+		updated, _ := m.update(tea.KeyPressMsg{Code: rune(key[0]), Text: key})
+		got := updated.(QueueDashboard)
+		if got.menu == nil || got.menu.plural || got.menu.row.ID != "my-set" {
+			t.Fatalf("%s in the detail with a Selection opened %+v, want the singular menu over the set", key, got.menu)
+		}
+	}
+}
+
+func TestDetailOpenersRefuseAsTheRowListDoes(t *testing.T) {
+	for _, key := range []string{"s", "y", "m"} {
+		t.Run(key, func(t *testing.T) {
+			rowList := genericDetailDashboard(&itemVerbKind{})
+			updated, _ := rowList.update(tea.KeyPressMsg{Code: rune(key[0]), Text: key})
+			want := updated.(QueueDashboard).flash.Text()
+			if want == "" {
+				t.Fatalf("%s on the row gave no refusal to compare against", key)
+			}
+
+			m := genericDetailDashboard(&itemVerbKind{})
+			got := pressKeys(t, m, "l", key)
+			if got.menu != nil {
+				t.Fatalf("%s in the detail opened an empty menu", key)
+			}
+			if view := ui.StripANSI(got.View().Content); !strings.Contains(view, want) {
+				t.Fatalf("%s in the detail did not flash %q:\n%s", key, want, view)
+			}
+		})
+	}
+}
+
+func TestDetailIRunsTheContainersFlatVerb(t *testing.T) {
+	rowList := pressKeys(t, genericDetailDashboard(&containerVerbKind{}), "I")
+	if rowList.flash.Text() != "poked thing" {
+		t.Fatalf("I on the row flashed %q, want the kind's own verb", rowList.flash.Text())
+	}
+
+	got := pressKeys(t, genericDetailDashboard(&containerVerbKind{}), "l", "I")
+	if got.detail == nil {
+		t.Fatal("I closed the detail")
+	}
+	if view := ui.StripANSI(got.View().Content); !strings.Contains(view, "poked thing") {
+		t.Fatalf("I in the detail did not run the container's verb:\n%s", view)
+	}
+}
+
+func TestDetailHintsAndHelpNameTheFourOpeners(t *testing.T) {
+	m := pressKeys(t, genericDetailDashboard(&itemVerbKind{}), "l")
+	hints := detailHints(m.detail)
+	for _, want := range []string{"r run ▸", "s status ▸", "y copy ▸", "m mute ▸"} {
+		if !strings.Contains(hints, want) {
+			t.Fatalf("detail hint line %q is missing %q", hints, want)
+		}
+	}
+	for _, retired := range []string{"copy name", "copy path"} {
+		if strings.Contains(hints, retired) {
+			t.Fatalf("detail hint line %q still names the retired %q", hints, retired)
+		}
+	}
+
+	keys := map[string]string{}
+	for _, entry := range m.helpEntries() {
+		keys[entry.Key] = entry.Desc
+	}
+	for key, want := range map[string]string{"r": "item run menu", "s": "status menu", "y": "copy menu", "m": "mute menu"} {
+		if keys[key] != want {
+			t.Fatalf("detail help names %s as %q, want %q", key, keys[key], want)
+		}
+	}
+	if _, ok := keys["p"]; ok {
+		t.Fatal("detail help still names p")
+	}
+}
diff --git a/dashboard/dashboard_detail_search_test.go b/dashboard/dashboard_detail_search_test.go
new file mode 100644
index 00000000..19bddecb
--- /dev/null
+++ b/dashboard/dashboard_detail_search_test.go
@@ -0,0 +1,186 @@
+package dashboard
+
+import (
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/glebglazov/pop/config"
+	"github.com/glebglazov/pop/tasks/drain"
+	"github.com/glebglazov/pop/ui"
+	"github.com/glebglazov/pop/work"
+	"github.com/glebglazov/pop/work/ref"
+)
+
+// typeKeys presses each rune of text as its own key.
+func typeKeys(t *testing.T, m QueueDashboard, text string) QueueDashboard {
+	t.Helper()
+	for _, r := range text {
+		m = pressKeys(t, m, string(r))
+	}
+	return m
+}
+
+func pressSpecial(m QueueDashboard, code rune) QueueDashboard {
+	updated, _ := m.update(tea.KeyPressMsg{Code: code})
+	return updated.(QueueDashboard)
+}
+
+// detailSearch opens the detail's search, types query and applies it.
+func detailSearch(t *testing.T, m QueueDashboard, query string) QueueDashboard {
+	t.Helper()
+	return pressSpecial(typeKeys(t, pressKeys(t, m, "/"), query), tea.KeyEnter)
+}
+
+func detailItemIDs(m QueueDashboard) []string {
+	var ids []string
+	for _, item := range m.detail.list.Items() {
+		ids = append(ids, item.ID)
+	}
+	return ids
+}
+
+func searchDetailRow() DashboardRow {
+	row := genericDetailRow()
+	row.Items = []work.Item{
+		{ID: "01", Title: "Parse the config", Type: "AFK", Status: "open"},
+		{ID: "02", Title: "Render the view", Type: "HITL", Status: "done"},
+		{ID: "03", Title: "Parse the flags", Type: "HITL", Status: "open"},
+	}
+	return row
+}
+
+func searchDetailDashboard(t *testing.T) QueueDashboard {
+	d := &drain.Deps{Kinds: func(*drain.Deps, *config.Config) []work.Kind { return []work.Kind{&itemVerbKind{}} }}
+	m := newQueueDashboard(d, &config.Config{}, DashboardSnapshot{Containers: []DashboardRow{searchDetailRow()}})
+	m.width, m.height = 120, 24
+	return pressKeys(t, m, "l")
+}
+
+func TestDetailSearchNarrowsItemsByIDTitleAndType(t *testing.T) {
+	for _, tc := range []struct {
+		query string
+		want  []string
+	}{
+		{"02", []string{"02"}},
+		{"PARSE", []string{"01", "03"}},
+		{"hitl", []string{"02", "03"}},
+		{"parse hitl", []string{"03"}},
+		{"parse render", nil},
+		{"open", nil},
+		{"done", nil},
+	} {
+		m := detailSearch(t, searchDetailDashboard(t), tc.query)
+		if m.detail == nil || m.detail.searchTyping {
+			t.Fatalf("%q: enter did not apply the search inside the detail", tc.query)
+		}
+		if got := detailItemIDs(m); !slices.Equal(got, tc.want) {
+			t.Fatalf("%q narrowed the items to %v, want %v", tc.query, got, tc.want)
+		}
+	}
+}
+
+func TestDetailSearchTypesEveryKeyButTheReservedThree(t *testing.T) {
+	m := typeKeys(t, pressKeys(t, searchDetailDashboard(t), "/"), "jkvrgG")
+	if m.itemMenu != nil || m.detail == nil || m.detail.artifacts {
+		t.Fatal("a key typed into the detail search acted instead of typing")
+	}
+	if got := m.detail.searchInput.Value(); got != "jkvrgG" {
+		t.Fatalf("buffer = %q, want every key typed", got)
+	}
+	if hints := detailHints(m.detail); hints != "enter apply search · esc cancel · C-h help" {
+		t.Fatalf("typing-phase hints = %q", hints)
+	}
+
+	// Enter returns the full keymap over the narrowed items: j moves, r opens.
+	m = detailSearch(t, searchDetailDashboard(t), "parse")
+	m = pressKeys(t, m, "j", "r")
+	if m.itemMenu == nil || m.itemMenu.item.ID != "03" {
+		t.Fatalf("after enter, j/r did not act over the narrowed items: %+v", m.itemMenu)
+	}
+}
+
+func TestDetailSearchEscRestoresTheTermAndAnEmptyQueryClears(t *testing.T) {
+	m := detailSearch(t, searchDetailDashboard(t), "parse")
+	m = pressSpecial(typeKeys(t, pressKeys(t, m, "/"), "render"), tea.KeyEscape)
+	if m.detail == nil {
+		t.Fatal("esc while typing closed the detail")
+	}
+	if got := detailItemIDs(m); !slices.Equal(got, []string{"01", "03"}) {
+		t.Fatalf("esc left the items at %v, want the term in force restored", got)
+	}
+
+	m = pressSpecial(pressKeys(t, m, "/"), tea.KeyEnter)
+	if got := detailItemIDs(m); len(got) != 3 || m.detail.searchTerm != "" {
+		t.Fatalf("applying an empty query left %v under term %q", got, m.detail.searchTerm)
+	}
+}
+
+func TestDetailSearchSurvivesThePollAndIsVisible(t *testing.T) {
+	m := detailSearch(t, searchDetailDashboard(t), "parse")
+	refreshed := searchDetailRow()
+	refreshed.Items = append(refreshed.Items, work.Item{ID: "04", Title: "Parse the args", Type: "AFK", Status: "open"})
+	updated, _ := m.Update(dashboardRowsMsg{snap: DashboardSnapshot{Containers: []DashboardRow{refreshed}}})
+	m = updated.(QueueDashboard)
+
+	if got := detailItemIDs(m); !slices.Equal(got, []string{"01", "03", "04"}) {
+		t.Fatalf("after the poll the items are %v, want the term still applied", got)
+	}
+	if view := ui.StripANSI(m.View().Content); !strings.Contains(view, "search: parse") {
+		t.Fatalf("the term in force is not shown:\n%s", view)
+	}
+}
+
+func TestDetailSearchMatchingNothingSaysWhichTermAndHowToClear(t *testing.T) {
+	m := detailSearch(t, searchDetailDashboard(t), "zzz")
+	view := ui.StripANSI(m.View().Content)
+	if !strings.Contains(view, `No items match search "zzz" — / then enter to clear.`) {
+		t.Fatalf("empty search does not name its term:\n%s", view)
+	}
+}
+
+func TestDetailSearchNarrowsTheArtifactListOnScreen(t *testing.T) {
+	root := t.TempDir()
+	row := genericDetailRow()
+	row.DefPath = root
+	kind := &artifactDetailKind{id: ref.KindTaskSet, artifacts: []work.Artifact{
+		{Type: "refine", Name: "refine-1.md", Path: filepath.Join(root, row.ID, "refine-1.md")},
+		{Type: "spec", Name: "spec.md", Path: filepath.Join(root, row.ID, "spec.md")},
+	}}
+	m := pressKeys(t, openArtifactDetail(t, artifactDetailDashboard(kind, row)), "v")
+	m = detailSearch(t, m, "SPEC")
+
+	var names []string
+	for _, artifact := range m.detail.artifactList.Items() {
+		names = append(names, artifact.Name)
+	}
+	if !m.detail.artifacts || !slices.Equal(names, []string{"spec.md"}) {
+		t.Fatalf("artifact list narrowed to %v, want [spec.md]", names)
+	}
+
+	m = detailSearch(t, m, "zzz")
+	if view := ui.StripANSI(m.View().Content); !strings.Contains(view, `No artifacts match search "zzz"`) {
+		t.Fatalf("an emptied artifact list does not name its term:\n%s", view)
+	}
+	if m = pressKeys(t, m, "v"); m.detail.artifacts {
+		t.Fatal("v no longer switches lists once a search hides every artifact")
+	}
+}
+
+func TestDetailSearchDoesNotShareTheRowListSearch(t *testing.T) {
+	m := genericDetailDashboard(&itemVerbKind{})
+	m = pressSpecial(typeKeys(t, pressKeys(t, m, "/"), "thing"), tea.KeyEnter)
+	m = detailSearch(t, pressKeys(t, m, "l"), "first")
+
+	if m.searchTerm != "thing" || m.searchTyping {
+		t.Fatalf("the detail search touched the row list's: term %q typing %v", m.searchTerm, m.searchTyping)
+	}
+	if m.detail.searchTerm != "first" {
+		t.Fatalf("detail term = %q, want first", m.detail.searchTerm)
+	}
+	if m = pressKeys(t, pressSpecial(m, tea.KeyEscape), "l"); m.detail.searchTerm != "" || len(detailItemIDs(m)) != 2 {
+		t.Fatal("a reopened detail inherited the last detail's term")
+	}
+}
